{%- comment -%}
  Round 28: an enquiry, always to hand on a phone. A small dark pill in the corner, once the visitor
  has scrolled a little: it opens the enquiry sheet, as every "Request a proposal" does. Not on the
  enquiry page itself, nor while the menu or the sheet is open. Theme settings → Midsummer ·
  Social turns it on or off and names it.
{%- endcomment -%}
{%- if settings.ms_enquiry_bubble != false -%}
{%- unless template.suffix contains 'contact' or template.suffix contains 'enquire' -%}
{%- assign ms_eb_v = settings.ms_enquiry_bubble_label | default: 'Enquire' -%}
{%- capture ms_eb_label -%}{% render 'ms-t', v: ms_eb_v %}{%- endcapture -%}
<aside class="ms-wa-wrap" aria-label="{{ ms_eb_label | strip | escape }}"><a class="ms-wa" href="{% render 'ms-link', to: 'enquire' %}#enquire" data-ms-enquire data-ms-cta="corner" data-ms-wa>
  <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true" focusable="false"><path d="M2.75 5.25h14.5v9.5H2.75z" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linejoin="round"/><path d="m3 5.6 7 5.4 7-5.4" fill="none" stroke="currentColor" stroke-width="1.15" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <span class="ms-wa__label">{{ ms_eb_label | strip }}</span>
</a></aside>
<style>
  .ms-site .ms-wa { position: fixed; right: max(clamp(14px, 2vw, 28px), env(safe-area-inset-right)); bottom: max(clamp(14px, 2vw, 28px), calc(env(safe-area-inset-bottom) + 10px)); z-index: 80; display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 20px 0 17px; border-radius: 23px; background: #17140F; color: #FBF9F5; text-decoration: none; box-shadow: 0 14px 34px -14px rgba(23, 20, 15, .55); opacity: 0; transform: translateY(14px); pointer-events: none; transition: opacity .45s ease, transform .45s cubic-bezier(.2,.7,.2,1), background-color .3s ease; }
  .ms-site .ms-wa.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .ms-wa__label { white-space: nowrap; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; line-height: 1; }
  .ms-site .ms-wa:hover, .ms-site .ms-wa:focus-visible { background: #2B2620; color: #FBF9F5; }
  .ms-wa svg { flex: 0 0 auto; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-site .ms-wa:hover svg, .ms-site .ms-wa:focus-visible svg { transform: translateY(-1px); }
  body.ms-lock .ms-wa { opacity: 0 !important; pointer-events: none !important; }
  @media (max-width: 760px) { .ms-site .ms-wa { height: 44px; padding: 0 18px 0 15px; } }
  @media (prefers-reduced-motion: reduce) { .ms-site .ms-wa, .ms-wa svg { transition: none; } }
  @media print { .ms-wa-wrap { display: none; } }
  /* Round 29: on a wider screen the header's appointment button is always there; the corner is for phones */
  @media (min-width: 761px) { .ms-wa-wrap { display: none !important; } }
</style>
<script>
  (function () {
    var b = document.querySelector('[data-ms-wa]');
    if (!b) return;
    var on = function () { b.classList.toggle('is-on', (window.scrollY || 0) > 360); };
    window.addEventListener('scroll', on, { passive: true }); on();
  })();
</script>
{%- endunless -%}
{%- endif -%}
