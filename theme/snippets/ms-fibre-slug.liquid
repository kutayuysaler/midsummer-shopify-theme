{%- comment -%} A fibre's entry in the Natural materials atlas (#fibre-<slug>), from its name. Generated by bin/build_more.py. {%- endcomment -%}
{%- assign fname = name | downcase | strip -%}
{%- liquid
  case fname
    when 'альпака'
      assign fname = 'alpaca'
    when 'lana d’alpaca', 'шерсть альпаки'
      assign fname = 'alpaca wool'
    when 'бэби-альпака'
      assign fname = 'baby alpaca'
    when 'pelo di cammello', 'верблюжья шерсть'
      assign fname = 'camel hair'
    when 'кашемир'
      assign fname = 'cashmere'
    when 'lana cheviot', 'шерсть чевиот'
      assign fname = 'cheviot wool'
    when 'cotone', 'хлопок'
      assign fname = 'cotton'
    when 'lana falkland', 'фолклендская шерсть'
      assign fname = 'falkland wool'
    when 'canapa', 'конопля'
      assign fname = 'hemp'
    when 'crine di cavallo', 'конский волос'
      assign fname = 'horsehair'
    when 'lino', 'лен', 'лён'
      assign fname = 'linen'
    when 'мохер'
      assign fname = 'mohair'
    when 'cashmere della mongolia', 'монгольский кашемир'
      assign fname = 'mongolian cashmere'
    when 'cotone biologico', 'органический хлопок'
      assign fname = 'organic cotton'
    when 'seta', 'шелк', 'шёлк'
      assign fname = 'silk'
    when 'crine vegetale', 'растительный волос'
      assign fname = 'vegetable horsehair'
    when 'vigogna', 'викунья'
      assign fname = 'vicuña'
    when 'lana', 'шерсть'
      assign fname = 'wool'
    when 'як'
      assign fname = 'yak'
    when 'pelo di yak', 'шерсть яка'
      assign fname = 'yak hair'
  endcase
-%}
{%- case fname -%}
{%- when 'vicuña' -%}vicuna
{%- when 'cashmere', 'mongolian cashmere' -%}cashmere
{%- when 'camel hair' -%}camel
{%- when 'yak hair' -%}yak
{%- when 'baby alpaca', 'alpaca' -%}alpaca
{%- when 'mohair' -%}mohair
{%- when 'silk' -%}silk
{%- when 'wool', 'cheviot wool', 'falkland wool' -%}wool
{%- when 'horsehair' -%}horsehair
{%- when 'linen' -%}linen
{%- when 'cotton', 'organic cotton' -%}cotton
{%- when 'vegetable horsehair' -%}vegetable
{%- when 'ingeo' -%}ingeo
{%- when 'orange fiber' -%}orange
{%- endcase -%}
