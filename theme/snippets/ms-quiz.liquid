{%- comment -%} Find your Midsummer: five questions to a system, exactly as the preview asks them. The label is the page heading (tag: 'h1') only on the quiz page; in the overlay it is a plain line, so no page has two h1s. Used by the quiz page and, where the store has no quiz page, by the quiz overlay. {%- endcomment -%}
<script type="application/json" data-ms-quiz-urls>{"Raffaello": {% if all_products['raffaello'].url != blank %}{{ all_products['raffaello'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Raffaello' | json }}{% endif %}, "Dreamy": {% if all_products['dreamy'].url != blank %}{{ all_products['dreamy'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Dreamy' | json }}{% endif %}, "Paisley": {% if all_products['paisley'].url != blank %}{{ all_products['paisley'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Paisley' | json }}{% endif %}, "Amalfi": {% if all_products['amalfi'].url != blank %}{{ all_products['amalfi'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Amalfi' | json }}{% endif %}, "Vivaldi": {% if all_products['vivaldi'].url != blank %}{{ all_products['vivaldi'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Vivaldi' | json }}{% endif %}, "Bellini": {% if all_products['bellini'].url != blank %}{{ all_products['bellini'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Bellini' | json }}{% endif %}, "Capri": {% if all_products['capri'].url != blank %}{{ all_products['capri'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Capri' | json }}{% endif %}, "Brera": {% if all_products['brera'].url != blank %}{{ all_products['brera'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Brera' | json }}{% endif %}, "Top": {% if all_products['top'].url != blank %}{{ all_products['top'].url | json }}{% else %}{{ routes.search_url | append: '?type=product&q=Top' | json }}{% endif %}}</script>
<div data-ms-quiz class="ms-quiz" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); min-height: 78vh;">
  <div style="padding: clamp(40px, 6vw, 110px) clamp(18px, 5vw, 80px); display: flex; flex-direction: column; justify-content: center;">
    <div data-ms-quiz-run style="max-width: 540px;">
      <div style="display: flex; align-items: center; gap: 18px;">
        {%- assign qt = tag | default: 'p' -%}<{{ qt }} style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92); margin: 0; font-weight: 400;">{{ label | default: "Find your Midsummer" }}</{{ qt }}>
        <span style="flex: 1 1 0%; height: 1px; background: rgb(221, 214, 201);"></span>
        <span data-ms-quiz-step style="font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgb(126, 98, 59);">1 / 5</span>
      </div>
      <h2 data-ms-quiz-q aria-live="polite" style="font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 4.2vw, 54px); line-height: 1.08; letter-spacing: -0.025em; margin-top: 34px;">How do you sleep?</h2>
      <div data-ms-quiz-opts style="display: flex; flex-direction: column; margin-top: clamp(28px, 4vw, 48px);"></div>
      <div style="display: flex; gap: 26px; align-items: center; margin-top: 34px;">
        <button type="button" data-ms-quiz-back style="background: none; border: 0px; padding: 15px 0px; cursor: pointer; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(74, 68, 59);">← Back</button>
        <button type="button" data-ms-quiz-reset style="background: none; border: 0px; padding: 15px 0px; cursor: pointer; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">Start again</button>
      </div>
    </div>
    <div data-ms-quiz-done hidden style="max-width: 580px; animation: msRise .5s ease both;">
      <div style="font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C;">{{ result_label | default: "We would build you the" }}</div>
      <h2 data-ms-r="name" style="font-family: Newsreader, Georgia, serif; font-size: clamp(40px, 5.6vw, 76px); line-height: 1.0; letter-spacing: -.035em; margin-top: 16px;"></h2>
      <p data-ms-r="tagline" style="font-family: Newsreader, Georgia, serif; font-size: clamp(18px, 2.1vw, 24px); line-height: 1.5; color: #6E675C; margin-top: 16px; font-style: italic;"></p>
      <p data-ms-r="why" style="font-size: 15px; line-height: 1.95; color: #4A443B; margin-top: 26px;"></p>
      <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 32px; border-top: 1px solid #DDD6C9; padding-top: 26px; font-size: 14px; line-height: 1.7; color: #4A443B;">
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">Comfort</span><span data-ms-r="firm"></span></div>
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">Size</span><span data-ms-r="size"></span></div>
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">Fibres</span><span data-ms-r="fibre"></span></div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 26px; align-items: center; margin-top: 36px;">
        <a href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-cta="quiz-proposal" style="display: inline-block; background: #17140F; color: #FBF9F5; border: 0; padding: 20px 40px; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; cursor: pointer;">Request a proposal</a>
        <a data-ms="cta" data-ms-r="link" href="{{ routes.collections_url }}" style="font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 7px;">See the system</a>
        <button type="button" data-ms-quiz-reset style="background: none; border: 0; cursor: pointer; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C;">Start again</button>
      </div>
    </div>
  </div>
  <div style="position: relative; min-height: 360px; background: rgb(241, 236, 227); overflow: hidden;">
    <img data-ms-quiz-img alt="" loading="lazy" width="1400" height="1750" src="{{ 'ms-photo-my-dream-sleep.jpg' | asset_url }}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  </div>
</div>
<script>
(function () {
  var CDN = 'https://midsummer-milano.com/cdn/shop/';
  var QUESTIONS = [
    { q: 'How do you sleep?', img: {{ 'ms-photo-my-dream-sleep.jpg' | asset_url | json }},
      opts: [['On my side', 'Hips and shoulders need to sink a little.'], ['On my back', 'The lumbar curve needs to stay supported.'], ['On my front', 'A flatter, firmer surface keeps the neck neutral.'], ['It changes', 'A balanced surface that works in every position.']] },
    { q: 'What should the bed feel like?', img: CDN + 'files/Paisleydettaglio.jpg?v=1788246821&width=1400',
      opts: [['Enveloping', 'Softness first, with support underneath.'], ['Balanced', 'Neither soft nor firm — the most specified answer.'], ['Structured', 'Firm, resilient, close to the traditional Italian build.']] },
    { q: 'How warm is the room at night?', img: {{ 'ms-photo-drapes-fireplace.jpg' | asset_url | json }},
      opts: [['Warm', 'Coastal, southern, or a room that holds heat.'], ['Temperate', 'Four real seasons.'], ['Cold', 'Mountain, northern, or a house kept cool.']] },
    { q: 'What size are you working with?', img: CDN + 'files/Paisley.png?v=1777114994&width=1400',
      opts: [['Double', '160 × 200 cm'], ['Queen or King', '170–180 × 200 cm'], ['Made to measure', 'The wall decides, not the catalogue.']] },
    { q: 'How far should the bespoke go?', img: {{ 'ms-photo-teal-throw.jpg' | asset_url | json }},
      opts: [['The essentials, done properly', 'Natural fibres and honest construction.'], ['Loro Piana Interiors', 'Fabric chosen for the room, comfort chosen for you.'], ['Without limit', 'Six spring layers, vicuña, cashmere. No detail overlooked.']] }
  ];
  var RESULTS = {
    'Enveloping': { 'The essentials, done properly': ['Raffaello', 'Essentials', 'Baby alpaca over a hand-sewn spring core.'], 'Loro Piana Interiors': ['Dreamy', 'Signature', 'Capitonné surface, enveloping comfort.'], 'Without limit': ['Paisley', 'Icons', 'Loro Piana Interiors Shadan, in silk and linen.'] },
    'Balanced': { 'The essentials, done properly': ['Amalfi', 'Essentials', 'Coloured linen, summer weight.'], 'Loro Piana Interiors': ['Vivaldi', 'Signature', 'The balanced build, most specified of all.'], 'Without limit': ['Bellini', 'Icons', 'Slender boxspring, balcony proportions.'] },
    'Structured': { 'The essentials, done properly': ['Capri', 'Essentials', 'Boxspring and mattress, in one clean line.'], 'Loro Piana Interiors': ['Brera', 'Signature', 'Structured support, Milanese proportion.'], 'Without limit': ['Top', 'Icons', 'The most complete system in the house.'] }
  };
  var DONE_IMG = {{ 'ms-photo-atelier-pure.jpg' | asset_url | json }};
  var URLS = {};
  try { URLS = JSON.parse(document.querySelector('[data-ms-quiz-urls]').textContent); } catch (e) {}
  document.querySelectorAll('[data-ms-quiz]:not([data-ms-quiz-init])').forEach(function (root) {
  root.setAttribute('data-ms-quiz-init', '');
  var qi = 0, answers = [];
  var $ = function (s) { return root.querySelector(s); };
  var optStyle = 'text-align: left; background: transparent; border: 0; border-top: 1px solid #DDD6C9; padding: 22px 0; cursor: pointer; width: 100%; color: inherit;';
  function render() {
    var done = qi >= QUESTIONS.length;
    $('[data-ms-quiz-run]').hidden = done;
    $('[data-ms-quiz-done]').hidden = !done;
    $('[data-ms-quiz-img]').src = done ? DONE_IMG : QUESTIONS[qi].img;
    if (!done) {
      var q = QUESTIONS[qi];
      $('[data-ms-quiz-step]').textContent = (qi + 1) + ' / ' + QUESTIONS.length;
      $('[data-ms-quiz-q]').textContent = q.q;
      var box = $('[data-ms-quiz-opts]');
      box.innerHTML = '';
      q.opts.forEach(function (o) {
        var b = document.createElement('button');
        b.type = 'button';
        b.setAttribute('style', optStyle);
        b.innerHTML = '<span style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px);"></span><span style="display: block; font-size: 13.5px; line-height: 1.8; color: #6E675C; margin-top: 6px;"></span>';
        b.children[0].textContent = o[0];
        b.children[1].textContent = o[1];
        b.addEventListener('click', function () { answers = answers.slice(0, qi).concat([o[0]]); qi++; render(); });
        box.appendChild(b);
      });
      return;
    }
    var POSTURE = { 'On my side': 'on your side', 'On my back': 'on your back', 'On my front': 'on your front', 'It changes': 'in every position' };
    var SIZE_PHRASE = { 'Double': 'a double', 'Queen or King': 'a queen or king', 'Made to measure': 'a made-to-measure size' };
    var feel = answers[1] || 'Balanced', climate = answers[2] || 'Temperate', ambition = answers[4] || 'Loro Piana Interiors';
    var r = (RESULTS[feel] || RESULTS['Balanced'])[ambition] || RESULTS['Balanced']['Loro Piana Interiors'];
    var firm = feel === 'Enveloping' ? 'Soft' : (feel === 'Structured' ? 'Firm' : 'Medium');
    var fibre = climate === 'Warm' ? 'Linen, organic cotton and silk — breathable, for warm rooms'
      : climate === 'Cold' ? 'Baby alpaca, yak and Cheviot wool — warmth without weight'
      : 'Cheviot wool, horsehair and linen — warm in winter, fresh in summer';
    var why = 'You sleep ' + (POSTURE[answers[0]] || 'in every position') + ', and you want a surface that feels ' + feel.toLowerCase() +
      '. We would build the ' + r[0] + ' from the ' + r[1] + ' collection at ' + firm.toLowerCase() + ' comfort, in ' + (SIZE_PHRASE[answers[3]] || 'a double') + '.';
    $('[data-ms-r="name"]').textContent = r[0];
    $('[data-ms-r="tagline"]').textContent = r[2];
    $('[data-ms-r="why"]').textContent = why;
    $('[data-ms-r="firm"]').textContent = firm;
    $('[data-ms-r="size"]').textContent = answers[3] === 'Made to measure' ? 'Made to measure' : (answers[3] || 'Double');
    $('[data-ms-r="fibre"]').textContent = fibre;
    $('[data-ms-r="link"]').href = URLS[r[0]] || ('/search?type=product&q=' + encodeURIComponent(r[0]));
    document.dispatchEvent(new CustomEvent('ms:quiz-complete', { detail: { product: r[0], profile: feel + ' / ' + climate } }));
  }
  $('[data-ms-quiz-back]').addEventListener('click', function () { qi = Math.max(0, qi - 1); render(); });
  root.querySelectorAll('[data-ms-quiz-reset]').forEach(function (b) { b.addEventListener('click', function () { qi = 0; answers = []; render(); }); });
  render();
  });
})();
</script>
