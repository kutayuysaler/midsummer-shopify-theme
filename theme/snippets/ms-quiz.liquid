      <div style="display: flex; align-items: center; gap: 18px;">
        {%- assign qt = tag | default: 'p' -%}<{{ qt }} style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92); margin: 0; font-weight: 400;">{{ label | default: "Find your Midsummer" }}</{{ qt }}>
        <span style="flex: 1 1 0%; height: 1px; background: rgb(221, 214, 201);"></span>
        <span data-ms-quiz-step style="font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgb(126, 98, 59);">1 / 5</span>
      </div>
      <h2 data-ms-quiz-q aria-live="polite" style="font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 4.2vw, 54px); line-height: 1.08; letter-spacing: -0.025em; margin-top: 34px;">{% render 'ms-t', v: 'How do you sleep?' %}</h2>
      <div data-ms-quiz-opts style="display: flex; flex-direction: column; margin-top: clamp(28px, 4vw, 48px);"></div>
      <div style="display: flex; gap: 26px; align-items: center; margin-top: 34px;">
        <button type="button" data-ms-quiz-back style="background: none; border: 0px; padding: 15px 0px; cursor: pointer; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(74, 68, 59);">{% render 'ms-t', v: '← Back' %}</button>
        <button type="button" data-ms-quiz-reset style="background: none; border: 0px; padding: 15px 0px; cursor: pointer; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{% render 'ms-t', v: 'Start again' %}</button>
      </div>
    </div>
    <div data-ms-quiz-done hidden style="max-width: 580px; animation: msRise .5s ease both;">
      <div style="font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C;">{{ result_label | default: "We would build you the" }}</div>
      <h2 data-ms-r="name" style="font-family: Newsreader, Georgia, serif; font-size: clamp(40px, 5.6vw, 76px); line-height: 1.0; letter-spacing: -.035em; margin-top: 16px;"></h2>
      <p data-ms-r="tagline" style="font-family: Newsreader, Georgia, serif; font-size: clamp(18px, 2.1vw, 24px); line-height: 1.5; color: #6E675C; margin-top: 16px; font-style: italic;"></p>
      <p data-ms-r="why" style="font-size: 15px; line-height: 1.95; color: #4A443B; margin-top: 26px;"></p>
      <div style="display: flex; flex-direction: column; gap: 14px; margin-top: 32px; border-top: 1px solid #DDD6C9; padding-top: 26px; font-size: 14px; line-height: 1.7; color: #4A443B;">
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">{% render 'ms-t', v: 'Comfort' %}</span><span data-ms-r="firm"></span></div>
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">{% render 'ms-t', v: 'Size' %}</span><span data-ms-r="size"></span></div>
        <div style="display: flex; gap: 18px;"><span style="width: 130px; flex: none; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C; padding-top: 3px;">{% render 'ms-t', v: 'Fibres' %}</span><span data-ms-r="fibre"></span></div>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 26px; align-items: center; margin-top: 36px;">
        <a href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-cta="quiz-proposal" style="display: inline-block; background: #17140F; color: #FBF9F5; border: 0; padding: 20px 40px; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; cursor: pointer;">{% render 'ms-t', v: 'Request a proposal' %}</a>
        <a data-ms="cta" data-ms-r="link" href="{{ routes.collections_url }}" style="font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 7px;">{% render 'ms-t', v: 'See the system' %}</a>
        <button type="button" data-ms-quiz-reset style="background: none; border: 0; cursor: pointer; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #6E675C;">{% render 'ms-t', v: 'Start again' %}</button>
      </div>
    </div>
  </div>
  <div style="position: relative; min-height: 360px; background: rgb(241, 236, 227); overflow: hidden;">
    <img data-ms-quiz-img alt="{% render 'ms-t', v: 'A woman resting on a Midsummer mattress' %}" loading="lazy" width="1400" height="1750" src="{{ 'ms-photo-my-dream-sleep.jpg' | asset_url }}" {% render 'ms-srcset', fallback: 'ms-photo-my-dream-sleep.jpg', width: 1798, sizes: '(max-width: 760px) 100vw, 50vw' %} style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
  </div>
</div>
