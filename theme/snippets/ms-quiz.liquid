        b.children[0].textContent = T(o[0]);
        b.children[1].textContent = T(o[1]);
        b.addEventListener('click', function () { answers = answers.slice(0, qi).concat([o[0]]); qi++; render(); });
        box.appendChild(b);
      });
      return;
    }
    var POSTURE = { 'On my side': 'on your side', 'On my back': 'on your back', 'On my front': 'on your front', 'It changes': 'in every position' };
    var SIZE_PHRASE = { 'Double': 'a double', 'Queen or King': 'a queen or king', 'Made to measure': 'a made-to-measure size' };
    var feel = answers[1] || 'Balanced', climate = answers[2] || 'Temperate', ambition = answers[4] || 'Loro Piana Interiors';
    var r = (RESULTS[feel] || RESULTS['Balanced'])[ambition] || RESULTS['Balanced']['Loro Piana Interiors'];
    var firm = feel === 'Enveloping' ? 'Soft' : (feel === 'Structured' ? 'Firm' : 'Medium');
    var fibre = climate === 'Warm' ? 'Linen, organic cotton and silk — breathable, for warm rooms'
      : climate === 'Cold' ? 'Baby alpaca, yak and Cheviot wool — warmth without weight'
      : 'Cheviot wool, horsehair and linen — warm in winter, fresh in summer';
    var FEEL = { 'Enveloping': 'enveloping', 'Balanced': 'balanced', 'Structured': 'structured' };
    var why = T('You sleep {posture}, and you want a surface that feels {feel}. We would build the {name} from the {collection} collection at {firm} comfort, in {size}.')
      .replace('{posture}', T(POSTURE[answers[0]] || 'in every position')).replace('{feel}', T(FEEL[feel] || 'balanced'))
      .replace('{name}', r[0]).replace('{collection}', r[1]).replace('{firm}', T(firm.toLowerCase())).replace('{size}', T(SIZE_PHRASE[answers[3]] || 'a double'));
    $('[data-ms-r="name"]').textContent = r[0];
    $('[data-ms-r="tagline"]').textContent = T(r[2]);
    $('[data-ms-r="why"]').textContent = why;
    $('[data-ms-r="firm"]').textContent = T(firm);
    $('[data-ms-r="size"]').textContent = T(answers[3] === 'Made to measure' ? 'Made to measure' : (answers[3] || 'Double'));
    $('[data-ms-r="fibre"]').textContent = T(fibre);
    $('[data-ms-r="link"]').href = URLS[r[0]] || ('/search?type=product&q=' + encodeURIComponent(r[0]));
    document.dispatchEvent(new CustomEvent('ms:quiz-complete', { detail: { product: r[0], profile: feel + ' / ' + climate } }));
  }
  $('[data-ms-quiz-back]').addEventListener('click', function () { qi = Math.max(0, qi - 1); render(); });
  root.querySelectorAll('[data-ms-quiz-reset]').forEach(function (b) { b.addEventListener('click', function () { qi = 0; answers = []; render(); }); });
  render();
  });
})();
</script>
