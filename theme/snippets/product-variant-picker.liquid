{%- comment -%} ══ 3. Styles ══ {%- endcomment -%}
<style>
  #mm-size-panel-{{ section.id }},
  #mm-firmness-panel-{{ section.id }},
  #mm-opt-desc-panel-{{ section.id }},
  #mm-fabric-panel-{{ section.id }} { display: none; }
  #mm-size-panel-{{ section.id }}.mm-is-visible,
  #mm-firmness-panel-{{ section.id }}.mm-is-visible,
  #mm-opt-desc-panel-{{ section.id }}.mm-is-visible,
  #mm-fabric-panel-{{ section.id }}.mm-is-visible { display: block; }

  .mm-opt-desc-text { font-size: 1.4rem; line-height: 1.25; }

  .mm-firmness-panel__card { display: inline-flex; flex-direction: column; gap: 0.35rem; padding: 1rem 1.4rem; border: 1px solid rgba(0,0,0,.1); border-radius: 16px; background: rgba(0,0,0,.02); max-width: 100%; }
  .mm-firmness-panel__name { font-size: 1.4rem; font-weight: 600; line-height: 1.2; }
  .mm-firmness-panel__desc { font-size: 1.25rem; line-height: 1.55; opacity: 0.68; }

  .mm-extra-panels { margin-top: 2rem; display: flex; flex-direction: column; gap: 1.4rem; }
  .mm-extra-panels__label { margin: 0 0 0.55rem; font-size: 1rem; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; opacity: 0.72; }

  .mm-size-panel__card { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.9rem 1.4rem; border: 1px solid rgba(0,0,0,.1); border-radius: 999px; background: rgba(0,0,0,.02); font-size: 1.4rem; line-height: 1.25; }
  .mm-size-panel__name { font-weight: 600; }
  .mm-size-panel__divider { opacity: 0.4; }

  .mm-fabric-panel { padding: 1.4rem; border: 1px solid rgba(0,0,0,.1); border-radius: 16px; background: rgba(0,0,0,.02); }
  .mm-palette-title { margin: 0 0 1rem; font-size: 1.5rem; line-height: 1.25; }

  .mm-fabric-families { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-bottom: 1.4rem; }

  .mm-fabric-family {
    appearance: none;
    background: #fff;
    border: 1px solid rgba(0,0,0,.14);
    color: #111;
    border-radius: 999px;
    padding: 0.55rem 1.1rem;
    font: inherit;
    font-size: 1.2rem;
    line-height: 1.2;
    cursor: pointer;
    transition: background .15s, color .15s, border-color .15s;
  }
  .mm-fabric-family.is-active,
  .mm-fabric-family:hover { background: #111; color: #fff; border-color: #111; }

  .mm-fabric-swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 0.6rem; }
  .mm-fabric-swatches.mm-hidden { display: none; }

  .mm-fabric-swatch { display: flex; align-items: center; gap: 0.55rem; padding: 0.5rem 0.7rem; border: 1px solid rgba(0,0,0,.07); border-radius: 10px; background: #fff; }
  .mm-fabric-swatch--featured { border-color: rgba(160,112,78,.25); background: linear-gradient(135deg, #faf5ef 0%, #f5ede3 100%); }
  .mm-fabric-swatch__dot { width: 16px; height: 16px; border-radius: 50%; border: 1px solid rgba(0,0,0,.15); flex-shrink: 0; }
  .mm-fabric-swatch__dot--floral { background: radial-gradient(ellipse at 35% 35%, #e8c8b0 0%, #c9906e 55%, #a8704e 100%); border-color: rgba(169,112,78,.35); width: 20px; height: 20px; }
  .mm-fabric-swatch__name { font-size: 1.05rem; line-height: 1.3; color: #111; }

  @media (max-width: 749px) {
    .mm-size-panel__card { font-size: 1.3rem; padding: .8rem 1.2rem; }
    .mm-fabric-swatches { grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); }
  }
</style>

{%- comment -%} ══ 4. JavaScript ══ {%- endcomment -%}
<script>
(function () {
  var SID = '{{ section.id }}';
  if (window['_mmPicker_' + SID]) return;
  window['_mmPicker_' + SID] = true;

  var SIZE_MAP = {
    'single':       {{ section.settings.dim_single       | default: '100 × 200 cm' | json }},
    'queen':        {{ section.settings.dim_queen        | default: '153 × 203 cm' | json }},
    'small double': {{ section.settings.dim_small_double | default: '160 × 200 cm' | json }},
    'double':       {{ section.settings.dim_double       | default: '180 × 200 cm' | json }},
    'king':         {{ section.settings.dim_king         | default: '193 × 203 cm' | json }},
    'double extra': {{ section.settings.dim_double_extra | default: '200 × 200 cm' | json }}
  };

  /* Optional per-product option descriptions (e.g. White/Colored for Amalfi) */
  var OPT_DESC_MAP = {};
  {%- if section.settings.opt_desc_1_value != blank and section.settings.opt_desc_1_text != blank -%}
  OPT_DESC_MAP[{{ section.settings.opt_desc_1_value | downcase | strip | json }}] = {{ section.settings.opt_desc_1_text | json }};
  {%- endif -%}
  {%- if section.settings.opt_desc_2_value != blank and section.settings.opt_desc_2_text != blank -%}
  OPT_DESC_MAP[{{ section.settings.opt_desc_2_value | downcase | strip | json }}] = {{ section.settings.opt_desc_2_text | json }};
  {%- endif -%}

  var LP_TRIGGER = {{ section.settings.loro_trigger_value | default: 'Loro Piana Interiors' | downcase | json }};

  var FIRMNESS_MAP = {
    'firm':   {{ firm_desc   | json }},
    'medium': {{ medium_desc | json }},
    'soft':   {{ soft_desc   | json }}
  };

  var hasInteracted = false;

  function norm(v) { return (v || '').toString().trim().toLowerCase(); }
  function picker()        { return document.getElementById('variant-selects-'    + SID); }
  function sizePanel()     { return document.getElementById('mm-size-panel-'      + SID); }
  function sizeNameEl()    { return document.getElementById('mm-size-name-'       + SID); }
  function sizeDimsEl()    { return document.getElementById('mm-size-dims-'       + SID); }
  function firmPanel()     { return document.getElementById('mm-firmness-panel-'  + SID); }
  function firmNameEl()    { return document.getElementById('mm-firmness-name-'   + SID); }
  function firmDescEl()    { return document.getElementById('mm-firmness-desc-'   + SID); }
  function optDescPanel()  { return document.getElementById('mm-opt-desc-panel-'  + SID); }
  function optDescTextEl() { return document.getElementById('mm-opt-desc-text-'   + SID); }
  function optDescNameEl() { return document.getElementById('mm-opt-desc-name-'   + SID); }
  function fabPanel()      { return document.getElementById('mm-fabric-panel-'    + SID); }

  function getOpts() {
    var root = picker();
    var out  = {};
    if (!root) return out;
    root.querySelectorAll('[data-option-position]').forEach(function (g) {
      var name = norm(g.getAttribute('data-option-name') || '');
      var val  = '';
      /* 1. Checked radio — updates immediately on click, before any AJAX */
      var chk = g.querySelector('input[type="radio"]:checked');
      if (chk) val = chk.value || '';
      /* 2. Select dropdown */
      if (!val) { var sel = g.querySelector('select'); if (sel) val = sel.value || ''; }
      /* 3. data-selected-value span — server-rendered, may be stale mid-AJAX */
      if (!val) { var sv = g.querySelector('[data-selected-value]'); if (sv) val = (sv.textContent || '').trim(); }
      if (name) out[name] = norm(val);
    });
    return out;
  }

  function updateSize() {
    var panel = sizePanel();
    if (!panel) return;
    var opts = getOpts();
    var sizeKey = '';
    Object.keys(opts).forEach(function (k) {
      if (sizeKey) return;
      if (k.indexOf('size') > -1 || k.indexOf('misura') > -1 || k.indexOf('dimension') > -1) {
        if (SIZE_MAP[opts[k]]) sizeKey = opts[k];
      }
    });
    if (!sizeKey) {
      Object.keys(opts).forEach(function (k) {
        if (!sizeKey && SIZE_MAP[opts[k]]) sizeKey = opts[k];
      });
    }
    var dims   = sizeKey ? (SIZE_MAP[sizeKey] || '') : '';
    var nameEl = sizeNameEl();
    var dimsEl = sizeDimsEl();
    if (dims && nameEl && dimsEl) {
      nameEl.textContent = sizeKey.replace(/(^|\s)\S/g, function (c) { return c.toUpperCase(); });
      dimsEl.textContent = dims;
      panel.classList.add('mm-is-visible');
    } else {
      panel.classList.remove('mm-is-visible');
    }
  }

  function updateLP() {
    var panel = fabPanel();
    if (!panel) return;
    var opts = getOpts();
    var show = false;
    Object.keys(opts).forEach(function (k) {
      if (norm(opts[k]).indexOf(LP_TRIGGER) > -1) show = true;
    });
    if (show) panel.classList.add('mm-is-visible');
    else      panel.classList.remove('mm-is-visible');
  }

  function updateFirmness() {
    var panel = firmPanel();
    if (!panel) return;
    var opts = getOpts(); var key = ''; var desc = '';
    Object.keys(opts).forEach(function (k) {
      if (!key && FIRMNESS_MAP[opts[k]]) { key = opts[k]; desc = FIRMNESS_MAP[opts[k]]; }
    });
    var ne = firmNameEl(); var de = firmDescEl();
    if (desc && ne && de) {
      ne.textContent = key.replace(/(^|\s)\S/g, function (c) { return c.toUpperCase(); });
      de.textContent = desc;
      panel.classList.add('mm-is-visible');
    } else {
      panel.classList.remove('mm-is-visible');
    }
  }

  function updateOptDesc() {
    var panel = optDescPanel();
    if (!panel) return;
    var opts = getOpts(); var matchedKey = ''; var desc = '';
    Object.keys(opts).forEach(function (k) {
      if (!desc && OPT_DESC_MAP[opts[k]]) { matchedKey = opts[k]; desc = OPT_DESC_MAP[opts[k]]; }
    });
    var nameEl = document.getElementById('mm-opt-desc-name-' + SID);
    var textEl = optDescTextEl();
    if (nameEl) nameEl.textContent = matchedKey ? matchedKey.replace(/(^|\s)\S/g, function(c){ return c.toUpperCase(); }) : '';
    if (textEl) textEl.textContent = desc;
    if (desc) panel.classList.add('mm-is-visible');
    else      panel.classList.remove('mm-is-visible');
  }

  function refresh() { updateSize(); updateFirmness(); updateOptDesc(); updateLP(); }

  document.addEventListener('click', function (e) {
    var btn = e.target.closest('.mm-fabric-family[data-family]');
    if (!btn) return;
    var bar = document.getElementById('mm-fabric-families-' + SID);
    if (!bar || !bar.contains(btn)) return;
    var target = btn.getAttribute('data-family');
    bar.querySelectorAll('.mm-fabric-family').forEach(function (b) {
      var on = (b === btn);
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-selected', String(on));
    });
    document.querySelectorAll('[id^="mm-swatches-' + SID + '-"]').forEach(function (p) {
      p.classList.toggle('mm-hidden', p.getAttribute('data-family-panel') !== target);
    });
    try { sessionStorage.setItem('mm_fam_' + SID, target); } catch (ignore) {}
  });

  function restoreTab() {
    var saved;
    try { saved = sessionStorage.getItem('mm_fam_' + SID); } catch (ignore) {}
    if (!saved) return;
    var bar = document.getElementById('mm-fabric-families-' + SID);
    if (!bar) return;
    var btn = bar.querySelector('[data-family="' + saved + '"]');
    if (btn) btn.click();
  }

  document.addEventListener('shopify:section:load', function (e) {
    if (e.detail && e.detail.sectionId === SID) restoreTab();
  });
  restoreTab();

  /* Run once on load to sync panels with the URL-selected variant */
  refresh();

  document.addEventListener('change', function (e) {
    if (!e.target.matches('input[type="radio"], select')) return;
    var root = picker();
    if (!root || !root.contains(e.target)) return;
    refresh();
    setTimeout(refresh, 350);
  });

  document.addEventListener('variant:change', function (e) {
    if (e.detail && e.detail.sectionId && e.detail.sectionId !== SID) return;
    refresh();
  });

})();
</script>

{%- endunless -%}
