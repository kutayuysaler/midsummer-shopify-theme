{% comment %}
  Renders product variant picker with:
  – Size-dimension card  (values from section settings)
  – Loro Piana Interiors palette (families toggled via theme editor checkboxes)

  Fabric family visibility is controlled by section settings:
    lp_show_cardi, lp_show_altai, lp_show_connemara, lp_show_mystic_river
    lp_cardi_floral_only  — when true, Cardi panel shows only the Floral colourway

  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}

{%- unless product.has_only_default_variant -%}

{%- liquid
  assign loc = request.locale.iso_code | downcase | slice: 0, 2

  if loc == 'it'
    assign firmness_label  = 'Fermezza'
    assign firm_desc       = 'Supporto deciso e preciso. Per chi cerca un sostegno decido.'
    assign medium_desc     = 'Il comfort più versatile. Equilibrio naturale tra morbidezza e sostegno.'
    assign soft_desc       = 'Morbido e avvolgente. Ideale per chi dorme sul fianco o ama sentirsi accolto.'
  elsif loc == 'ru'
    assign firmness_label  = 'Жёсткость'
    assign firm_desc       = 'Точная и твёрдая поддержка. Для тех, кто предпочитает стабильность и чёткость.'
    assign medium_desc     = 'Наиболее универсальный комфорт. Естественный баланс между мягкостью и поддержкой.'
    assign soft_desc       = 'Мягкий и обволакивающий. Идеален для тех, кто спит на боку, или любит нежное объятие.'
  else
    assign firmness_label  = 'Firmness'
    assign firm_desc       = 'Precise, firm support. For those who prefer stability and definition.'
    assign medium_desc     = 'The most versatile comfort. A natural balance between softness and support.'
    assign soft_desc       = 'Soft and enveloping. Ideal for side sleepers and those who love a gentle embrace.'
  endif

  assign dim_label  = section.settings.dimensions_label   | default: 'Dimensions'
  assign lp_trigger = section.settings.loro_trigger_value | default: 'Loro Piana Interiors'
  assign lp_eyebrow = section.settings.lp_palette_eyebrow | default: 'Loro Piana Interiors'
  assign lp_title   = section.settings.lp_palette_title   | default: 'Available fabric palette'

  assign show_cardi        = section.settings.lp_show_cardi
  assign show_altai        = section.settings.lp_show_altai
  assign show_connemara    = section.settings.lp_show_connemara
  assign show_mystic_river = section.settings.lp_show_mystic_river
  assign show_wish         = section.settings.lp_show_wish
  assign show_paisley      = section.settings.lp_show_paisley
  assign cardi_floral_only = section.settings.lp_cardi_floral_only

  if show_cardi
    assign first_family = 'cardi'
  elsif show_altai
    assign first_family = 'altai'
  elsif show_connemara
    assign first_family = 'connemara'
  elsif show_wish
    assign first_family = 'wish'
  elsif show_paisley
    assign first_family = 'paisley'
  else
    assign first_family = 'mystic-river'
  endif

  assign lp_selected_on_load = false
  for opt_val in product.selected_or_first_available_variant.options
    assign opt_val_norm = opt_val | downcase | strip
    assign trigger_norm = lp_trigger | downcase | strip
    if opt_val_norm == trigger_norm
      assign lp_selected_on_load = true
    endif
  endfor

  assign default_firmness_key  = ''
  assign default_firmness_desc = ''
  for opt in product.options_with_values
    assign ov = opt.selected_value | downcase | strip
    case ov
      when 'firm'
        assign default_firmness_key  = opt.selected_value
        assign default_firmness_desc = firm_desc
      when 'medium'
        assign default_firmness_key  = opt.selected_value
        assign default_firmness_desc = medium_desc
      when 'soft'
        assign default_firmness_key  = opt.selected_value
        assign default_firmness_desc = soft_desc
    endcase
  endfor

  assign default_size_key  = ''
  assign default_size_dims = ''
  for opt in product.options_with_values
    assign sv = opt.selected_value | downcase | strip
    case sv
      when 'single'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_single | default: '100 × 200 cm'
      when 'queen'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_queen | default: '153 × 203 cm'
      when 'small double'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_small_double | default: '160 × 200 cm'
      when 'double'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_double | default: '180 × 200 cm'
      when 'king'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_king | default: '193 × 203 cm'
      when 'double extra'
        assign default_size_key  = opt.selected_value
        assign default_size_dims = section.settings.dim_double_extra | default: '200 × 200 cm'
    endcase
  endfor

  comment
    Optional per-product option description panel.
    Set opt_desc_1_value / opt_desc_1_text (and _2_) in section settings.
    Shows a small label beneath the variant picker when a matching option is selected.
  endcomment
  assign opt_desc_label  = section.settings.opt_desc_label  | default: ''
  assign opt_desc_1_val  = section.settings.opt_desc_1_value | downcase | strip
  assign opt_desc_1_text = section.settings.opt_desc_1_text | default: ''
  assign opt_desc_2_val  = section.settings.opt_desc_2_value | downcase | strip
  assign opt_desc_2_text = section.settings.opt_desc_2_text | default: ''
  assign show_opt_desc   = false
  if opt_desc_1_text != blank or opt_desc_2_text != blank
    assign show_opt_desc = true
  endif

  assign opt_desc_default_text = ''
  for opt_val in product.selected_or_first_available_variant.options
    assign ov = opt_val | downcase | strip
    if ov == opt_desc_1_val and opt_desc_1_text != blank
      assign opt_desc_default_text = opt_desc_1_text
    endif
    if ov == opt_desc_2_val and opt_desc_2_text != blank
      assign opt_desc_default_text = opt_desc_2_text
    endif
  endfor
-%}

{%- comment -%} ══ 1. Standard variant picker ══ {%- endcomment -%}
<variant-selects
  id="variant-selects-{{ section.id }}"
  class="mm-variant-selects"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-product-form-id="{{ product_form_id }}"
  {{ block.shopify_attributes }}
>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign swatch_count = option.values | map: 'swatch' | compact | size
      assign picker_type  = block.settings.picker_type
      if swatch_count > 0 and block.settings.swatch_shape != 'none'
        if block.settings.picker_type == 'dropdown'
          assign picker_type = 'swatch_dropdown'
        else
          assign picker_type = 'swatch'
        endif
      endif
    -%}

    {%- if picker_type == 'swatch' -%}
      <fieldset
        class="js product-form__input product-form__input--swatch"
        data-option-position="{{ option.position }}"
        data-option-name="{{ option.name | escape }}"
        data-option-name-handle="{{ option.name | handleize }}"
      >
        <legend class="form__label">
          {{ option.name }}:
          <span data-selected-value>{{ option.selected_value }}</span>
        </legend>
        {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
      </fieldset>

    {%- elsif picker_type == 'button' -%}
      <fieldset
        class="js product-form__input product-form__input--pill"
        data-option-position="{{ option.position }}"
        data-option-name="{{ option.name | escape }}"
        data-option-name-handle="{{ option.name | handleize }}"
      >
        <legend class="form__label">
          {{ option.name }}:
          <span data-selected-value>{{ option.selected_value }}</span>
        </legend>
        {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
      </fieldset>

    {%- else -%}
      <div
        class="product-form__input product-form__input--dropdown"
        data-option-position="{{ option.position }}"
        data-option-name="{{ option.name | escape }}"
        data-option-name-handle="{{ option.name | handleize }}"
      >
        <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
          {{ option.name }}:
          <span data-selected-value>{{ option.selected_value }}</span>
        </label>
        <div class="select">
          {%- if picker_type == 'swatch_dropdown' -%}
            <span class="dropdown-swatch">
              {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
            </span>
          {%- endif -%}
          <select
            id="Option-{{ section.id }}-{{ forloop.index0 }}"
            class="select__select"
            name="options[{{ option.name | escape }}]"
            form="{{ product_form_id }}"
            data-option-select
            data-option-name="{{ option.name | escape }}"
            data-option-position="{{ option.position }}"
          >
            {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
          </select>
          <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
</variant-selects>

{%- comment -%} ══ 2. Extra panels ══ {%- endcomment -%}
<div class="mm-extra-panels" id="mm-extra-panels-{{ section.id }}">

  <div
    class="mm-size-panel{% if default_size_dims != blank %} mm-is-visible{% endif %}"
    id="mm-size-panel-{{ section.id }}"
    aria-live="polite"
  >
    <p class="mm-extra-panels__label">{{ dim_label }}</p>
    <div class="mm-size-panel__card">
      <span class="mm-size-panel__name" id="mm-size-name-{{ section.id }}">{{ default_size_key }}</span>
      <span class="mm-size-panel__divider" aria-hidden="true">·</span>
      <span class="mm-size-panel__dims" id="mm-size-dims-{{ section.id }}">{{ default_size_dims }}</span>
    </div>
  </div>

  <div
    class="mm-firmness-panel{% if default_firmness_desc != blank %} mm-is-visible{% endif %}"
    id="mm-firmness-panel-{{ section.id }}"
    aria-live="polite"
  >
    <p class="mm-extra-panels__label">{{ firmness_label }}</p>
    <div class="mm-firmness-panel__card">
      <span class="mm-firmness-panel__name" id="mm-firmness-name-{{ section.id }}">{{ default_firmness_key }}</span>
      <span class="mm-firmness-panel__desc" id="mm-firmness-desc-{{ section.id }}">{{ default_firmness_desc }}</span>
    </div>
  </div>

  {%- if show_opt_desc -%}
    <div
      class="mm-opt-desc-panel{% if opt_desc_default_text != blank %} mm-is-visible{% endif %}"
      id="mm-opt-desc-panel-{{ section.id }}"
      aria-live="polite"
    >
      {%- unless opt_desc_label == blank -%}
        <p class="mm-extra-panels__label">{{ opt_desc_label }}</p>
      {%- endunless -%}
      <div class="mm-size-panel__card">
        <span class="mm-opt-desc-name mm-size-panel__name" id="mm-opt-desc-name-{{ section.id }}">
          {%- for opt_val in product.selected_or_first_available_variant.options -%}
            {%- assign ov = opt_val | downcase | strip -%}
            {%- if ov == opt_desc_1_val and opt_desc_1_text != blank -%}{{ opt_val }}{%- endif -%}
            {%- if ov == opt_desc_2_val and opt_desc_2_text != blank -%}{{ opt_val }}{%- endif -%}
          {%- endfor -%}
        </span>
        <span class="mm-size-panel__divider" aria-hidden="true">·</span>
        <span class="mm-opt-desc-text" id="mm-opt-desc-text-{{ section.id }}">{{ opt_desc_default_text }}</span>
      </div>
    </div>
  {%- endif -%}

  <div
    class="mm-fabric-panel{% if lp_selected_on_load %} mm-is-visible{% endif %}"
    id="mm-fabric-panel-{{ section.id }}"
  >
    <p class="mm-extra-panels__label">{{ lp_eyebrow }}</p>
    {%- unless lp_title == blank -%}
      <p class="mm-palette-title">{{ lp_title }}</p>
    {%- endunless -%}

    <div class="mm-fabric-families" id="mm-fabric-families-{{ section.id }}" role="tablist">

      {%- if show_cardi -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'cardi' %} is-active{% endif %}"
          data-family="cardi"
          aria-selected="{% if first_family == 'cardi' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-cardi"
        >Cardi</button>
      {%- endif -%}

      {%- if show_altai -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'altai' %} is-active{% endif %}"
          data-family="altai"
          aria-selected="{% if first_family == 'altai' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-altai"
        >Altai</button>
      {%- endif -%}

      {%- if show_connemara -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'connemara' %} is-active{% endif %}"
          data-family="connemara"
          aria-selected="{% if first_family == 'connemara' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-connemara"
        >Connemara</button>
      {%- endif -%}

      {%- if show_mystic_river -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'mystic-river' %} is-active{% endif %}"
          data-family="mystic-river"
          aria-selected="{% if first_family == 'mystic-river' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-mystic-river"
        >Mystic River</button>
      {%- endif -%}

      {%- if show_wish -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'wish' %} is-active{% endif %}"
          data-family="wish"
          aria-selected="{% if first_family == 'wish' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-wish"
        >Wish</button>
      {%- endif -%}

      {%- if show_paisley -%}
        <button
          type="button" role="tab"
          class="mm-fabric-family{% if first_family == 'paisley' %} is-active{% endif %}"
          data-family="paisley"
          aria-selected="{% if first_family == 'paisley' %}true{% else %}false{% endif %}"
          aria-controls="mm-swatches-{{ section.id }}-paisley"
        >Paisley</button>
      {%- endif -%}

    </div>

    {%- if show_cardi -%}
      <div
