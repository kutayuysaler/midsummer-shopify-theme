{%- comment -%}
  Midsummer Milano — renders one block of an ms-split section.

  @param {object} block - The block
{%- endcomment -%}
{%- case block.type -%}
  {%- when 'eyebrow' -%}
    {%- if block.settings.text != blank -%}
      <p class="ms-eyebrow{% if block.settings.rule %} ms-eyebrow--rule{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
    {%- endif -%}
  {%- when 'heading' -%}
    {%- if block.settings.text != blank -%}
      {%- liquid
        assign tag = block.settings.size
        if tag == 'h4'
          assign tag = 'h3'
        endif
      -%}
      <{{ tag }} class="ms-h ms-h--{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape | newline_to_br }}</{{ tag }}>
    {%- endif -%}
  {%- when 'text' -%}
    {%- if block.settings.text != blank -%}
      <div class="ms-{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
    {%- endif -%}
  {%- when 'buttons' -%}
    {%- if block.settings.label_1 != blank or block.settings.label_2 != blank -%}
      <div class="ms-actions" {{ block.shopify_attributes }}>
        {%- render 'ms-button', label: block.settings.label_1, link: block.settings.link_1, style: block.settings.style_1, open_panel: block.settings.panel_1 -%}
        {%- render 'ms-button', label: block.settings.label_2, link: block.settings.link_2, style: block.settings.style_2, open_panel: block.settings.panel_2 -%}
      </div>
    {%- endif -%}
  {%- when 'rule' -%}
    <hr class="ms-rule" {{ block.shopify_attributes }}>
  {%- when 'newsletter' -%}
    <div {{ block.shopify_attributes }}>
      {%- form 'customer', id: 'ms-newsletter', class: 'ms-signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="ms-body" role="status">{{ block.settings.success }}</p>
        {%- else -%}
          <div class="ms-signup">
            <label class="visually-hidden" for="ms-newsletter-email">{{ block.settings.placeholder }}</label>
            <input id="ms-newsletter-email" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ block.settings.placeholder | escape }}">
            <button type="submit" class="ms-btn ms-btn--link"><span>{{ block.settings.button | escape }}</span></button>
          </div>
          {%- if form.errors -%}
            <p class="ms-small" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
{%- endcase -%}
