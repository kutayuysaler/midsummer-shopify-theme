{%- comment -%}
  The house's social accounts and WhatsApp, as small monochrome marks.
  Links come from Theme settings → Midsummer · Social and WhatsApp; an empty link is left out.
  Telegram and VK appear only on the Russian site (/ru).
  Usage: {% render 'ms-social' %}   {% render 'ms-social', tone: 'light' %} (on dark grounds)
{%- endcomment -%}
{%- liquid
  assign nets = 'instagram,pinterest,linkedin,whatsapp,telegram,vk,facebook,youtube,tiktok' | split: ','
  assign names = 'Instagram,Pinterest,LinkedIn,WhatsApp,Telegram,VK,Facebook,YouTube,TikTok' | split: ','
  assign ms_lang = request.locale.iso_code | slice: 0, 2
-%}
<ul class="ms-social{% if tone == 'light' %} is-light{% endif %}" role="list">
  {%- for n in nets -%}
    {%- assign key = 'ms_social_' | append: n -%}
    {%- assign url = settings[key] -%}
    {%- if url == blank -%}{%- continue -%}{%- endif -%}
    {%- if n == 'telegram' or n == 'vk' -%}{%- if ms_lang != 'ru' -%}{%- continue -%}{%- endif -%}{%- endif -%}
    <li>
      <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ names[forloop.index0] }}" title="{{ names[forloop.index0] }}"{% if n == 'whatsapp' %} data-ms-whatsapp{% endif %}>
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
          {%- case n -%}
            {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><path d="M16.9 7.1h.01" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
            {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.8" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 9.1c.9-1.5 4.2-1.7 4.8.6c.6 2.2-1.1 4.9-3.2 4.6c-1.2-.2-1.5-1.3-1.2-2.1M11.8 11.5l-2.2 9" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
            {%- when 'linkedin' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 10.4v6.2M8 7.6v.1M11.3 16.6v-6.2M11.3 13.1c0-1.7 1-2.8 2.4-2.8c1.3 0 2.2.9 2.2 2.6v3.7" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
            {%- when 'whatsapp' -%}<path d="M12 3.3a8.7 8.7 0 0 0-7.5 13.1l-1.2 4.4l4.6-1.2A8.7 8.7 0 1 0 12 3.3z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.2 8.4c.2-.4.5-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5c.6 1 1.5 1.8 2.5 2.3c.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5v.4c0 .5-.4 1.2-1.4 1.4c-1 .2-2.4-.2-4.1-1.6c-1.9-1.6-2.6-3.3-2.6-4.3c0-.8.4-1.5.6-1.9z" fill="currentColor"/>
            {%- when 'telegram' -%}<path d="M20.6 4.2L3.6 10.8c-.8.3-.8 1.4 0 1.6l4.2 1.3l1.6 5c.2.7 1.1.9 1.6.4l2.4-2.3l4.3 3.2c.6.4 1.4.1 1.6-.6l2.6-14c.2-.8-.6-1.4-1.3-1.2z" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/><path d="M7.8 13.7l9.4-6.2l-7.2 7.6" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
            {%- when 'vk' -%}<path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.391 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.862-.523-2.049-1.714-1.033-1-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.491.593-.491h1.744c.44 0 .61.203.78.677.863 2.49 2.303 4.675 2.896 4.675.22 0 .322-.102.322-.66V9.721c-.068-1.186-.695-1.287-.695-1.71 0-.204.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.271.508.22 0 .407-.136.813-.542 1.254-1.406 2.151-3.574 2.151-3.574.119-.254.322-.491.763-.491h1.744c.525 0 .644.27.525.643-.22 1.017-2.354 4.031-2.354 4.031-.186.305-.254.44 0 .78.186.254.796.779 1.203 1.253.745.847 1.32 1.558 1.473 2.05.17.49-.085.744-.576.744z"/>
            {%- when 'facebook' -%}<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            {%- when 'youtube' -%}<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            {%- when 'tiktok' -%}<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          {%- endcase -%}
        </svg>
      </a>
    </li>
  {%- endfor -%}
</ul>
<style>
  .ms-social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ms-site .ms-social a { display: flex; align-items: center; justify-content: center; width: 38px; height: 38px; border: 1px solid #DDD6C9; border-radius: 50%; color: #6E675C; transition: color .25s ease, border-color .25s ease, background .25s ease; }
  .ms-site .ms-social a:hover { color: #FBF9F5; background: #17140F; border-color: #17140F; }
  .ms-social svg { fill: currentColor; display: block; }
  .ms-site .ms-social.is-light a { border-color: rgba(251, 249, 245, .28); color: rgba(251, 249, 245, .8); }
  .ms-site .ms-social.is-light a:hover { background: #FBF9F5; color: #17140F; border-color: #FBF9F5; }
</style>
