{%- comment -%} The six chapters of Heritage & Craft: title, line and picture. {%- endcomment -%}
{%- liquid
  case k
    when 'story'
      capture t
        render 'ms-t', v: 'Our story'
      endcapture
      capture l
        render 'ms-t', v: 'A house of beds in Milan'
      endcapture
      assign i = 'ms-photo-loft.jpg'
    when 'handmade'
      capture t
        render 'ms-t', v: 'Handmade in Italy'
      endcapture
      capture l
        render 'ms-t', v: 'One bed at a time'
      endcapture
      assign i = 'ms-photo-artisan-portrait.jpg'
    when 'sleep-culture'
      capture t
        render 'ms-t', v: 'Sleep culture'
      endcapture
      capture l
        render 'ms-t', v: 'The art of sleeping well'
      endcapture
      assign i = 'ms-photo-window-chair.jpg'
    when 'materials'
      capture t
        render 'ms-t', v: 'Natural materials'
      endcapture
      capture l
        render 'ms-t', v: 'Wool, horsehair, silk, cashmere'
      endcapture
      assign i = 'ms-photo-cashmere-throw.jpg'
    when 'loro'
      capture t
        render 'ms-t', v: 'Loro Piana Interiors'
      endcapture
      capture l
        render 'ms-t', v: 'The fabrics we upholster in'
      endcapture
      assign i = 'ms-photo-lp-paisley-side.jpg'
    else
      capture t
        render 'ms-t', v: 'Made to last · 15 + 15'
      endcapture
      capture l
        render 'ms-t', v: 'Regenerated at fifteen years'
      endcapture
      assign i = 'ms-photo-drapes-fireplace.jpg'
  endcase
  case f
    when 'title'
      echo t
    when 'line'
      echo l
    else
      echo i
  endcase
-%}
