{%- comment -%}
  A date as the house writes it, in the visitor's language: "3 March 2026" (day: true) or "March 2026".
  Italian "3 marzo 2026" / "marzo 2026"; Russian "3 марта 2026" / "март 2026". cap: true starts the
  month with a capital where the date opens a line. Generated by bin/build_r24.py.
  Usage: {% render 'ms-date', d: article.published_at, day: true %}
{%- endcomment -%}
{%- liquid
  assign ms_dl = request.locale.iso_code | slice: 0, 2
  if ms_dl != 'it' and ms_dl != 'ru'
    if day
      echo d | date: '%-d %B %Y'
    else
      echo d | date: '%B %Y'
    endif
  else
    if ms_dl == 'it'
      if cap and day != true
        assign ms_dm = 'Gennaio,Febbraio,Marzo,Aprile,Maggio,Giugno,Luglio,Agosto,Settembre,Ottobre,Novembre,Dicembre' | split: ','
      else
        assign ms_dm = 'gennaio,febbraio,marzo,aprile,maggio,giugno,luglio,agosto,settembre,ottobre,novembre,dicembre' | split: ','
      endif
    elsif day
      assign ms_dm = 'января,февраля,марта,апреля,мая,июня,июля,августа,сентября,октября,ноября,декабря' | split: ','
    elsif cap
      assign ms_dm = 'Январь,Февраль,Март,Апрель,Май,Июнь,Июль,Август,Сентябрь,Октябрь,Ноябрь,Декабрь' | split: ','
    else
      assign ms_dm = 'январь,февраль,март,апрель,май,июнь,июль,август,сентябрь,октябрь,ноябрь,декабрь' | split: ','
    endif
    assign ms_di = d | date: '%-m' | minus: 1
    assign ms_dy = d | date: '%Y'
    if day
      assign ms_dd = d | date: '%-d'
      echo ms_dd | append: ' ' | append: ms_dm[ms_di] | append: ' ' | append: ms_dy
    else
      echo ms_dm[ms_di] | append: ' ' | append: ms_dy
    endif
  endif
-%}
