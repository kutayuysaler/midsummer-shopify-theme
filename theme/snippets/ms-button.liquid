{%- comment -%}
  Midsummer Milano — a square ruled button or text link.

  @param {string} label - Button text; nothing renders when blank
  @param {string} [link] - URL
  @param {string} [style] - primary, secondary or link
  @param {boolean} [open_panel] - Open the enquire panel instead of following the link
  @param {string} [attributes] - Extra attributes, e.g. shopify_attributes
{%- endcomment -%}
{%- if label != blank -%}
  {%- liquid
    assign btn_style = style | default: 'primary'
    assign href = link
    if href == blank and open_panel
      assign href = '/pages/contact'
    endif
  -%}
  <a
    class="ms-btn ms-btn--{{ btn_style }}"
    href="{{ href | default: '#' }}"
    {% if open_panel %}data-enquire-open aria-haspopup="dialog"{% endif %}
    {{ attributes }}
  >
    {%- if btn_style == 'link' -%}<span>{{ label | escape }}</span>{%- else -%}{{ label | escape }}{%- endif -%}
  </a>
{%- endif -%}
