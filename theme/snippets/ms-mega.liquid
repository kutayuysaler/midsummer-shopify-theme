{%- comment -%}
  The five panels of the bar. Each opens with its number, title and a line, then the places
  as large titles with a line each; hovering one brings its photograph forward on the right.
  A strip along the foot keeps the atelier's address, hours and accounts at hand.
  Every link resolves through snippets/ms-link.liquid, so none leads nowhere.
  Usage: {% render 'ms-mega', ss: section.settings %}
{%- endcomment -%}
{%- liquid
  assign cdn = 'https://midsummer-milano.com/cdn/shop/files/'
  capture u_story
    render 'ms-link', to: 'story'
  endcapture
  capture u_handmade
    render 'ms-link', to: 'handmade'
  endcapture
  capture u_culture
    render 'ms-link', to: 'sleep-culture'
  endcapture
  capture u_materials
    render 'ms-link', to: 'materials'
  endcapture
  capture u_loro
    render 'ms-link', to: 'loro'
  endcapture
  capture u_regen
    render 'ms-link', to: 'regen'
  endcapture
  capture u_quiz
    render 'ms-link', to: 'quiz'
  endcapture
  capture u_pro
    render 'ms-link', to: 'professionals'
  endcapture
  capture u_hosp
    render 'ms-link', to: 'hospitality'
  endcapture
  capture u_atelier
    render 'ms-link', to: 'atelier'
  endcapture
  capture u_agents
    render 'ms-link', to: 'agents'
  endcapture
  capture u_faq
    render 'ms-link', to: 'faq'
  endcapture
  capture u_journal
    render 'ms-link', to: 'journal'
  endcapture
  capture u_compare
    render 'ms-link', to: 'collections'
  endcapture
  capture u_appointment
    render 'ms-link', to: 'enquire', q: 'enquiry=appointment'
  endcapture
  capture u_proposal
    render 'ms-link', to: 'enquire', q: 'enquiry=proposal'
  endcapture
  capture u_partner
    render 'ms-link', to: 'enquire', q: 'enquiry=partner'
  endcapture
  capture u_trade
    render 'ms-link', to: 'enquire', q: 'enquiry=trade'
  endcapture
  capture u_enquire
    render 'ms-link', to: 'enquire'
  endcapture
  capture u_portfolio
    render 'ms-link', to: 'portfolio', strict: true
  endcapture
  capture u_press
    render 'ms-link', to: 'press', strict: true
  endcapture
  capture u_collab
    render 'ms-link', to: 'collaborations', strict: true
  endcapture

  assign ms_blog = nil
  assign ms_blogs = 'news,journal' | split: ','
  for h in ms_blogs
    if blogs[h].articles_count > 0
      assign ms_blog = blogs[h]
      break
    endif
  endfor
-%}

{%- capture foot -%}
  <div class="ms-mg__foot">
    <div class="ms-mg__addr"><span>{{ ss.mg_address }}</span><span>{{ ss.mg_hours }}</span></div>
    <a class="ms-mg__book" href="{{ u_appointment }}#enquire" data-ms-landing>{{ ss.mg_book }}</a>
    <div class="ms-mg__soc">{% render 'ms-social' %}</div>
  </div>
{%- endcapture -%}

{%- comment -%} 01 · Our beds {%- endcomment -%}
<div data-ms-panel="beds" hidden class="ms-mg ms-mg--beds">
  <div class="ms-mg__in">
    <div class="ms-mg__intro">
      <div class="ms-mg__no">01</div>
      <div class="ms-mg__title">{{ ss.t1 }}</div>
      <p class="ms-mg__lede">{{ ss.mg_beds_lede }}</p>
      <ul class="ms-mg__minor" role="list">
        {%- assign types = 'systems,headboards,mattresses,toppers,outdoor,bedding,throws,furniture' | split: ',' -%}
        {%- assign type_names = 'Bed systems,Beds with headboards,Mattresses,Toppers,Outdoor,Duvets and sheets,Blankets and throws,Furniture' | split: ',' -%}
        {%- for t in types -%}
          {%- capture tu -%}{% render 'ms-link', to: t, strict: true %}{%- endcapture -%}
          {%- if tu != blank -%}<li><a href="{{ tu }}">{{ type_names[forloop.index0] }}</a></li>{%- endif -%}
        {%- endfor -%}
        <li><a href="{{ u_compare }}">{{ ss.mg_compare }}</a></li>
        <li><a href="{{ u_quiz }}" data-ms-quiz-link>{{ ss.mg_quiz }}</a></li>
        <li><a href="{{ u_proposal }}#enquire" data-ms-landing>{{ ss.mg_proposal }}</a></li>
      </ul>
    </div>
    <div class="ms-mg__cards">
      {%- for i in (1..3) -%}
        {%- liquid
          case i
            when 1
              assign key = 'essentials'
              assign img = ss.mg_img_essentials
              assign fb = 'ms-graded-bougainvillea.jpg' | asset_url
              assign name = 'Essentials'
              assign note = ss.mg_essentials
              assign rn = 'I'
            when 2
              assign key = 'signature'
              assign img = ss.mg_img_signature
              assign fb = 'ms-graded-ochre-room.jpg' | asset_url
              assign name = 'Signature'
              assign note = ss.mg_signature
              assign rn = 'II'
            else
              assign key = 'icons'
              assign img = ss.mg_img_icons
              assign fb = 'ms-graded-arches.jpg' | asset_url
              assign name = 'Icons'
              assign note = ss.mg_icons
              assign rn = 'III'
          endcase
        -%}
        <a class="ms-mg__card" href="{% render 'ms-link', to: key %}" style="--i: {{ i }};">
          <span class="ms-mg__cimg"><img src="{% if img != blank %}{{ img | image_url: width: 900 }}{% else %}{{ fb }}{% endif %}" alt="{{ name }}" width="900" height="1080" loading="lazy"></span>
          <span class="ms-mg__crow"><span class="ms-mg__rn">{{ rn }}</span><span class="ms-mg__cname">{{ name }}</span><span class="ms-mg__arrow" aria-hidden="true">→</span></span>
          <span class="ms-mg__cnote">{{ note }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
  {{ foot }}
</div>

{%- comment -%} 02 · Heritage & craft {%- endcomment -%}
{%- capture items -%}
{{ u_story }}|{{ ss.mg_h1 }}|{{ ss.mg_h1_note }}|{{ 'ms-photo-loft.jpg' | asset_url }}|
§{{ u_handmade }}|{{ ss.mg_h2 }}|{{ ss.mg_h2_note }}|{{ 'ms-photo-seamstress.jpg' | asset_url }}|
§{{ u_culture }}|{{ ss.mg_h3 }}|{{ ss.mg_h3_note }}|{{ 'ms-photo-window-chair.jpg' | asset_url }}|
§{{ u_materials }}|{{ ss.mg_h4 }}|{{ ss.mg_h4_note }}|{{ 'ms-photo-shepherd.jpg' | asset_url }}|
§{{ u_loro }}|{{ ss.mg_h5 }}|{{ ss.mg_h5_note }}|{{ 'ms-photo-paisley-throw.jpg' | asset_url }}|
§{{ u_regen }}|{{ ss.mg_h6 }}|{{ ss.mg_h6_note }}|{{ 'ms-photo-drapes-fireplace.jpg' | asset_url }}|
{%- endcapture -%}
{%- render 'ms-mega-panel', key: 'heritage', no: '02', title: ss.t2, lede: ss.mg_heritage_lede, items: items, feature: ss.mg_img_heritage, foot: foot -%}

{%- comment -%} 03 · Professionals {%- endcomment -%}
{%- capture items -%}
{{ u_pro }}|{{ ss.mg_p1 }}|{{ ss.mg_p1_note }}|{{ 'ms-photo-fresco-bed.jpg' | asset_url }}|
§{{ u_hosp }}|{{ ss.mg_p2 }}|{{ ss.mg_p2_note }}|{{ 'ms-photo-glass-house.jpg' | asset_url }}|
§{{ u_portfolio }}|{{ ss.mg_p3 }}|{{ ss.mg_p3_note }}|{{ 'ms-graded-arches.jpg' | asset_url }}|
§{{ u_partner }}#enquire|{{ ss.mg_p4 }}|{{ ss.mg_p4_note }}|{{ 'ms-photo-atelier-pure.jpg' | asset_url }}|landing
§{{ u_trade }}#enquire|{{ ss.mg_p5 }}|{{ ss.mg_p5_note }}|{{ cdn }}Vicuna-mattress.jpg?width=900|landing
{%- endcapture -%}
{%- render 'ms-mega-panel', key: 'pro', no: '03', title: ss.t3, lede: ss.mg_pro_lede, items: items, feature: ss.mg_img_pro, foot: foot, cta1_url: u_agents, cta1_label: ss.mg_pro_cta1 -%}

{%- comment -%} 04 · Journal: the newest notes, then the subjects {%- endcomment -%}
<div data-ms-panel="journal" hidden class="ms-mg ms-mg--journal">
  <div class="ms-mg__in">
    <div class="ms-mg__intro">
      <div class="ms-mg__no">04</div>
      <div class="ms-mg__title">{{ ss.t4 }}</div>
      <p class="ms-mg__lede">{{ ss.mg_journal_lede }}</p>
      <ul class="ms-mg__minor" role="list">
        <li><a href="{{ u_journal }}">{{ ss.mg_all_notes }}</a></li>
        {%- comment -%} the Journal's subjects, the same list and the same filing as the Journal page {%- endcomment -%}
        {%- if ms_blog -%}
          {%- liquid
            assign present = ''
            for a in ms_blog.articles limit: 30
              capture c
                render 'ms-note-cat', a: a
              endcapture
              assign present = present | append: ',' | append: c
            endfor
            capture allcats
              render 'ms-note-cat', list: true
            endcapture
            assign allcats = allcats | split: ','
          -%}
          {%- for k in allcats -%}
            {%- if present contains k -%}<li><a href="{{ u_journal }}?cat={{ k }}">{% render 'ms-note-cat', label: k %}</a></li>{%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if u_press != blank -%}<li><a href="{{ u_press }}">{{ ss.mg_press }}</a></li>{%- endif -%}
        {%- if u_collab != blank -%}<li><a href="{{ u_collab }}">{{ ss.mg_collab }}</a></li>{%- endif -%}
      </ul>
    </div>
    <div class="ms-mg__cards">
      {%- if ms_blog -%}
        {%- for a in ms_blog.articles limit: 3 -%}
          <a class="ms-mg__card ms-mg__card--note" href="{{ a.url }}" style="--i: {{ forloop.index }};">
            <span class="ms-mg__cimg">{%- if a.image -%}<img src="{{ a.image | image_url: width: 900 }}" alt="{{ a.title | escape }}" width="900" height="600" loading="lazy">{%- endif -%}</span>
            {%- capture ac -%}{% render 'ms-note-cat', a: a %}{%- endcapture -%}
            <span class="ms-mg__ctag">{% if ac != '' %}{% render 'ms-note-cat', label: ac %}{% else %}{{ ss.mg_note_label }}{% endif %}</span>
            <span class="ms-mg__cname">{{ a.title }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a class="ms-mg__card ms-mg__card--note" href="{{ u_journal }}" style="--i: 1;">
          <span class="ms-mg__cimg"><img src="{{ cdn }}Vicuna-mattress.jpg?width=900" alt="" width="900" height="600" loading="lazy"></span>
          <span class="ms-mg__ctag">{{ ss.mg_note_label }}</span>
          <span class="ms-mg__cname">{{ ss.mg_all_notes }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
  {{ foot }}
</div>

{%- comment -%} 05 · Contact {%- endcomment -%}
{%- capture items -%}
{{ u_appointment }}#enquire|{{ ss.mg_c1 }}|{{ ss.mg_c1_note }}|{{ 'ms-photo-villa-doorway.jpg' | asset_url }}|landing
§{{ u_agents }}|{{ ss.mg_c2 }}|{{ ss.mg_c2_note }}|{{ 'ms-graded-arches.jpg' | asset_url }}|
§{{ u_atelier }}|{{ ss.mg_c5 }}|{{ ss.mg_c5_note }}|{{ 'ms-photo-atelier-orange-bed.jpg' | asset_url }}|
§{{ u_enquire }}#direct|{{ ss.mg_c3 }}|{{ ss.mg_c3_note }}|{{ 'ms-photo-linen-sheets.jpg' | asset_url }}|landing
{%- if settings.ms_social_whatsapp != blank -%}§{{ settings.ms_social_whatsapp }}|WhatsApp|{{ ss.mg_c4_note }}|{{ 'ms-photo-atelier-sun.jpg' | asset_url }}|external{%- endif -%}
§{{ u_faq }}|{{ ss.mg_c6 }}|{{ ss.mg_c6_note }}|{{ 'ms-graded-dune.jpg' | asset_url }}|
{%- endcapture -%}
{%- capture u_enq_cta -%}{{ u_enquire }}#enquire{%- endcapture -%}
{%- render 'ms-mega-panel', key: 'contact', no: '05', title: ss.t5, lede: ss.mg_contact_lede, items: items, foot: foot, cta1_url: u_enq_cta, cta1_label: ss.mg_contact_cta1, cta1_landing: true, cta2_url: u_agents, cta2_label: ss.mg_contact_cta2 -%}

<style>
  /* the panels drop from the bar; the page behind dims */
  .ms-site .ms-mg { border-top: 1px solid #DDD6C9; background: #FBF9F5; color: #17140F; padding: 0; animation: msMgDrop .55s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes msMgDrop { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes msMgIn { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  body.ms-mega-open main::after { content: ''; position: fixed; inset: 0; z-index: 60; background: rgba(23, 20, 15, .34); animation: msMgFade .45s ease both; pointer-events: none; }
  @keyframes msMgFade { from { opacity: 0; } to { opacity: 1; } }
  .ms-mg__in { display: grid; grid-template-columns: minmax(220px, 3fr) minmax(0, 9fr); gap: clamp(32px, 4.5vw, 88px); max-width: 1560px; margin: 0 auto; padding: clamp(36px, 4.4vw, 68px) clamp(18px, 5vw, 80px) clamp(30px, 3.4vw, 52px); }
  .ms-mg__intro { animation: msMgIn .6s .05s cubic-bezier(.2,.7,.2,1) both; }
  .ms-mg__no { font-family: Newsreader, Georgia, serif; font-size: 14px; color: #7E623B; font-variant-numeric: tabular-nums; }
  .ms-mg__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(34px, 3.3vw, 52px); line-height: 1.02; letter-spacing: -0.03em; margin-top: 14px; }
  .ms-mg__lede { font-size: 13.5px; line-height: 1.8; color: #4A443B; margin-top: 18px; max-width: 30ch; }
  .ms-mg__ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; margin-top: 28px; }
  .ms-site .ms-mg__cta { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 4px; }
  .ms-site .ms-mg__cta--solid { display: inline-flex; align-items: center; min-height: 46px; padding: 0 22px; border: 0; background: #17140F; color: #FBF9F5; }
  .ms-site .ms-mg__cta--solid:hover { background: #3A332A; color: #FBF9F5; }
  .ms-mg__minor { list-style: none; margin: 30px 0 0; padding: 22px 0 0; border-top: 1px solid #DDD6C9; display: grid; gap: 10px; }
  .ms-site .ms-mg__minor a { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #4A443B; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; padding-bottom: 3px; transition: background-size .4s cubic-bezier(.2,.7,.2,1), color .25s ease; }
  .ms-site .ms-mg__minor a:hover { color: #17140F; background-size: 100% 1px; }

  /* places as large titles, the photograph following the hover */
  .ms-mg__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(28px, 4vw, 72px); align-items: start; }
  .ms-mg__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #DDD6C9; }
  .ms-mg__list li { border-bottom: 1px solid #DDD6C9; animation: msMgIn .6s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 45ms + 90ms); }
  .ms-site .ms-mg__item { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; align-items: baseline; gap: 14px; padding: clamp(12px, 1.25vw, 17px) 0; color: #17140F; }
  .ms-mg__n { font-size: 10.5px; letter-spacing: .14em; color: #7E623B; font-variant-numeric: tabular-nums; }
  .ms-mg__t { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(21px, 1.85vw, 29px); line-height: 1.15; letter-spacing: -0.015em; transition: transform .45s cubic-bezier(.2,.7,.2,1), color .3s ease; }
  .ms-mg__d { font-size: 12.5px; line-height: 1.5; color: #6E675C; text-align: right; transition: color .3s ease; }
  .ms-mg__item:hover .ms-mg__t, .ms-mg__item:focus-visible .ms-mg__t { transform: translateX(10px); }
  .ms-mg__list:hover .ms-mg__item:not(:hover) .ms-mg__t { color: #A39C90; }
  .ms-mg__item:hover .ms-mg__d, .ms-mg__item.is-on .ms-mg__d { color: #4A443B; }
  .ms-mg__fig { margin: 0; position: sticky; top: 0; animation: msMgIn .7s .12s cubic-bezier(.2,.7,.2,1) both; }
  .ms-mg__frame { position: relative; aspect-ratio: 4 / 5; max-height: 52vh; overflow: hidden; background: #EFE9DE; }
  .ms-mg__frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity .7s ease, transform 1.4s cubic-bezier(.2,.7,.2,1); }
  .ms-mg__frame img.is-on { opacity: 1; transform: none; }
  .ms-mg__cap { display: flex; justify-content: space-between; gap: 14px; margin-top: 14px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #7E623B; }

  /* collection and journal cards */
  .ms-mg__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.2vw, 36px); align-items: start; }
  .ms-site .ms-mg__card { display: block; color: #17140F; animation: msMgIn .65s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 70ms + 60ms); }
  .ms-mg__cimg { display: block; overflow: hidden; aspect-ratio: 5 / 6; background: #EFE9DE; }
  .ms-mg__card--note .ms-mg__cimg { aspect-ratio: 3 / 2; }
  .ms-mg__cimg img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ms-mg__card:hover .ms-mg__cimg img { transform: scale(1.045); }
  .ms-mg__crow { display: flex; align-items: baseline; gap: 12px; margin-top: 16px; }
  .ms-mg__rn { font-family: Newsreader, Georgia, serif; font-size: 13px; color: #7E623B; min-width: 22px; }
  .ms-mg__cname { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(20px, 1.7vw, 26px); line-height: 1.2; letter-spacing: -0.015em; }
  .ms-mg__card--note .ms-mg__cname { display: block; font-size: clamp(17px, 1.4vw, 21px); margin-top: 8px; }
  .ms-mg__ctag { display: block; margin-top: 14px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #7E623B; }
  .ms-mg__arrow { margin-left: auto; opacity: 0; transform: translateX(-8px); transition: opacity .35s ease, transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-mg__card:hover .ms-mg__arrow { opacity: 1; transform: none; }
  .ms-mg__cnote { display: block; font-size: 13px; line-height: 1.7; color: #6E675C; margin-top: 6px; padding-left: 34px; max-width: 36ch; }

  /* the foot: address, hours, the appointment, the accounts */
  .ms-mg__foot { display: flex; align-items: center; gap: clamp(18px, 3vw, 48px); max-width: 1560px; margin: 0 auto; padding: 16px clamp(18px, 5vw, 80px); border-top: 1px solid #DDD6C9; font-size: 12px; color: #6E675C; animation: msMgIn .6s .25s ease both; }
  .ms-mg__addr { display: flex; flex-wrap: wrap; gap: 6px 26px; }
  .ms-site .ms-mg__book { margin-left: auto; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 3px; white-space: nowrap; }
  .ms-mg__soc .ms-social a { width: 32px; height: 32px; }
  .ms-mg__soc .ms-social svg { width: 14px; height: 14px; }

  /* the bar's titles: a fine rule draws under the open one */
  .ms-site [data-ms-mega] { position: relative; padding: 8px 0 !important; }
  .ms-site [data-ms-mega]::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-site [data-ms-mega]:hover::after, .ms-site [data-ms-mega][aria-expanded="true"]::after { transform: scaleX(1); }
  .ms-site [data-ms-mega][aria-expanded="true"]::after { background: #7E623B; }

  @media (max-width: 1180px) {
    .ms-mg__in { grid-template-columns: minmax(0, 1fr); }
    .ms-mg__minor { grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-site .ms-mg, .ms-mg__intro, .ms-mg__list li, .ms-mg__fig, .ms-site .ms-mg__card, .ms-mg__foot, body.ms-mega-open main::after { animation: none !important; }
  }
</style>
<script>
  (function () {
    /* the photograph follows the place under the pointer (or the keyboard) */
    document.querySelectorAll('[data-ms-mg-list]').forEach(function (list) {
      var fig = list.closest('.ms-mg__body').querySelector('.ms-mg__frame');
      var cap = list.closest('.ms-mg__body').querySelector('[data-ms-mg-cap]');
      var imgs = fig ? fig.querySelectorAll('img') : [];
      function show(i) {
        imgs.forEach(function (im, k) { im.classList.toggle('is-on', k === i); });
        list.querySelectorAll('.ms-mg__item').forEach(function (a, k) { a.classList.toggle('is-on', k === i); });
        var a = list.querySelectorAll('.ms-mg__item')[i];
        if (cap && a) cap.textContent = a.querySelector('.ms-mg__t').textContent;
      }
      list.addEventListener('mouseover', function (e) { var a = e.target.closest('.ms-mg__item'); if (a) show(+a.getAttribute('data-ms-mg-i')); });
      if (fig) { fig.style.cursor = 'pointer'; fig.addEventListener('click', function () { var on = list.querySelector('.ms-mg__item.is-on'); if (on) on.click(); }); }
      list.addEventListener('focusin', function (e) { var a = e.target.closest('.ms-mg__item'); if (a) show(+a.getAttribute('data-ms-mg-i')); });
    });
  })();
</script>
