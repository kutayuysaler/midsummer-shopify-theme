{%- comment -%}
  What a system is made of, for the collection pages: "fibre,fibre~quality quality".
  Found by the product's template (its own fibres), then by its handle. Generated from the
  product templates: a new template's fibres appear here at the next build.
{%- endcomment -%}
{%- liquid
  assign k = key | default: handle
  case k
    when 'amalfi'
      echo '~'
    when 'bellagio'
      echo 'Yak Hair,Cheviot Wool~softness support temperature'
    when 'bellini'
      echo '~'
    when 'brera'
      echo 'Yak Hair~softness temperature'
    when 'capri'
      echo 'Horsehair~breathability support'
    when 'dreamy', 'dreamy-2'
      echo 'Camel Hair,Cheviot Wool~support temperature'
    when 'dreamy-springs'
      echo 'Camel Hair,Horsehair,Cashmere~breathability softness support temperature'
    when 'essenziale'
      echo 'Cheviot Wool~support temperature'
    when 'first-dream'
      echo 'Baby Alpaca,Horsehair~breathability hypoallergenic support temperature'
    when 'flora'
      echo 'Cashmere~softness temperature'
    when 'giotto'
      echo 'Horsehair,Cheviot Wool~breathability support temperature'
    when 'monteverdi'
      echo '~'
    when 'my-dream'
      echo 'Baby Alpaca,Cheviot Wool~hypoallergenic support temperature'
    when 'paisley'
      echo 'Baby Alpaca,Cheviot Wool~hypoallergenic support temperature'
    when 'raffaello'
      echo 'Baby Alpaca~hypoallergenic temperature'
    when 'roma'
      echo 'Horsehair~breathability support'
    when 'storage'
      echo 'Cashmere,Cheviot Wool~softness support temperature'
    when 'top', 'top-2'
      echo 'Baby Alpaca,Cashmere,Horsehair,Mohair,Yak Hair~breathability hypoallergenic softness support temperature'
    when 'topper-roma'
      echo 'Yak Hair~softness temperature'
    when 'ultra-dry'
      echo '~'
    when 'vicuna'
      echo 'Falkland,Vicu\u00f1a~softness support temperature'
    when 'vivaldi', 'vivaldi-2'
      echo 'Camel Hair~temperature'
    when 'vivaldi-plus'
      echo 'Camel Hair,Mongolian Cashmere~softness temperature'
    else
      case handle
      when 'amalfi'
        echo '~'
      when 'bellagio'
        echo 'Yak Hair,Cheviot Wool~softness support temperature'
      when 'bellini'
        echo '~'
      when 'brera'
        echo 'Yak Hair~softness temperature'
      when 'capri'
        echo 'Horsehair~breathability support'
      when 'dreamy', 'dreamy-2'
        echo 'Camel Hair,Cheviot Wool~support temperature'
      when 'dreamy-springs'
        echo 'Camel Hair,Horsehair,Cashmere~breathability softness support temperature'
      when 'essenziale'
        echo 'Cheviot Wool~support temperature'
      when 'first-dream'
        echo 'Baby Alpaca,Horsehair~breathability hypoallergenic support temperature'
      when 'flora'
        echo 'Cashmere~softness temperature'
      when 'giotto'
        echo 'Horsehair,Cheviot Wool~breathability support temperature'
      when 'monteverdi'
        echo '~'
      when 'my-dream'
        echo 'Baby Alpaca,Cheviot Wool~hypoallergenic support temperature'
      when 'paisley'
        echo 'Baby Alpaca,Cheviot Wool~hypoallergenic support temperature'
      when 'raffaello'
        echo 'Baby Alpaca~hypoallergenic temperature'
      when 'roma'
        echo 'Horsehair~breathability support'
      when 'storage'
        echo 'Cashmere,Cheviot Wool~softness support temperature'
      when 'top', 'top-2'
        echo 'Baby Alpaca,Cashmere,Horsehair,Mohair,Yak Hair~breathability hypoallergenic softness support temperature'
      when 'topper-roma'
        echo 'Yak Hair~softness temperature'
      when 'ultra-dry'
        echo '~'
      when 'vicuna'
        echo 'Falkland,Vicu\u00f1a~softness support temperature'
      when 'vivaldi', 'vivaldi-2'
        echo 'Camel Hair~temperature'
      when 'vivaldi-plus'
        echo 'Camel Hair,Mongolian Cashmere~softness temperature'
      endcase
  endcase
-%}
