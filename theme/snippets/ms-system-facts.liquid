    when 'capri'
      echo 'Horsehair,Linen,Cheviot Wool,Silk~breathability support~Horsehair:support breathability|Linen:breathability|Cheviot Wool:support'
    when 'dreamy', 'dreamy-2'
      echo 'Camel Hair,Silk,Cheviot Wool,Horsehair,Linen~softness support temperature~Camel Hair:temperature|Silk:softness|Cheviot Wool:support'
