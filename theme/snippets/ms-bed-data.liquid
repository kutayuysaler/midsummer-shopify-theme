{%- comment -%} A bed with headboard, in words: {% render 'ms-bed-data', key: 'tulip', part: 'line' %}. Generated by bin/build_more.py from bin/beds_data.py. {%- endcomment -%}
{%- liquid
  case key
    when 'cashmere-couture'
      case part
        when 'title'
          echo 'Cashmere Couture'
        when 'line'
          echo 'A headboard of padded folds, parted by a band of pure silk.'
        when 'hb'
          echo 'Padded folds in cashmere, velvet or Nubuck, parted at the centre by a band of pure silk: grey and orange, a flame in the fire.'
        when 'uph'
          echo 'Cashmere, velvet or Nubuck; the band in pure silk'
        when 'width'
          echo 'As wide as the bed; a larger headboard on request'
        when 'base'
          echo 'On a Midsummer boxspring of your choice, Dreamy Springs, Top Dream or My Dream, upholstered to match.'
        when 'legs'
          echo 'Wooden legs'
        when 'quote'
          echo 'Nothing happens unless first we dream.'
        when 'author'
          echo 'Carl Sandburg'
        when 'height'
          echo '137'
      endcase
    when 'silk-flowers'
      case part
        when 'title'
          echo 'Silk Flowers'
        when 'line'
          echo 'A bas-relief of flowers and their leaves, worked by hand.'
        when 'hb'
          echo 'Slim and architectural, its front a bas-relief of flowers among their leaves, made by hand, slowly, for a quiet, modern elegance.'
        when 'uph'
          echo 'Nubuck, leather or a Loro Piana Interiors cloth'
        when 'width'
          echo 'As wide as the bed; 144 cm high for Queen and King, and a low version, 108 cm, on request'
        when 'base'
          echo 'On a Midsummer boxspring of your choice, Dreamy Springs, Top Dream or My Dream, upholstered to match.'
        when 'legs'
          echo 'Wooden legs, in several finishes'
        when 'quote'
          echo 'One of the most attractive things about the flowers is their beautiful reserve.'
        when 'author'
          echo 'Henry David Thoreau'
        when 'height'
          echo '154'
      endcase
    when 'soft-to-the-touch'
      case part
        when 'title'
          echo 'Soft to the Touch'
        when 'line'
          echo 'Soft cushions curled around the headboard, on an inlay of Canaletto walnut.'
        when 'hb'
          echo 'Two rich, soft cushions curled around the headboard, resting on a precious inlay of Canaletto walnut: the detail that makes the bed.'
        when 'uph'
          echo 'Natural cloths, chosen with you'
        when 'width'
          echo 'The padded bed frame runs around the bed, 30 cm longer than the mattress'
        when 'base'
          echo 'On a slim First Dream boxspring, inside a padded bed frame.'
        when 'legs'
          echo 'Beech stained walnut, or metal; Canaletto walnut on request'
        when 'quote'
          echo 'Fashion passes, style remains.'
        when 'author'
          echo 'Coco Chanel'
        when 'height'
          echo '107'
      endcase
    when 'beating-of-wings'
      case part
        when 'title'
          echo 'Beating of Wings'
        when 'line'
          echo 'A sculptural headboard whose wings fold on hidden brass hinges.'
        when 'hb'
          echo 'Solid poplar, upholstered and embroidered ton-sur-ton; its wings fold on hidden brass hinges, to embrace the bed or open the room.'
        when 'uph'
          echo 'Nubuck, leather or a Loro Piana Interiors cloth'
        when 'width'
          echo 'Without wings, 30 cm wider than the bed; with wings, up to 330 cm'
        when 'base'
          echo 'On a Midsummer boxspring of your choice, Dreamy Springs, Top Dream or My Dream, upholstered to match.'
        when 'legs'
          echo 'Wooden legs'
        when 'quote'
          echo 'I must have flowers next to me, always, always!'
        when 'author'
          echo 'Claude Monet'
        when 'height'
          echo '130'
      endcase
    when 'jungle-dreams'
      case part
        when 'title'
          echo 'Jungle Dreams'
        when 'line'
          echo 'A wraparound headboard, quilted with leaves large and small.'
        when 'hb'
          echo 'A wraparound headboard, padded and quilted with leaves that interweave and make way, sprout and grow, repair and protect.'
        when 'uph'
          echo 'Natural cloths and leathers, chosen with you'
        when 'width'
          echo 'Wraps the bed: 48 cm wider than the mattress'
        when 'base'
          echo 'On a Midsummer boxspring of your choice, Dreamy Springs, Top Dream or My Dream, upholstered to match.'
        when 'legs'
          echo 'Wooden legs'
        when 'quote'
          echo 'The lioness has been reunited with her cub, and all is well in the jungle.'
        when 'author'
          echo 'Kill Bill, Vol. 3 (still in our dreams)'
        when 'height'
          echo '103'
      endcase
    when 'tulip'
      case part
        when 'title'
          echo 'Tulip'
        when 'line'
          echo 'Rounded shapes, and a capitonné made with stitches alone, no buttons.'
        when 'hb'
          echo 'The rounded shapes of a classic headboard, tufted as the old upholsterers did, but without buttons: stitches alone soften the lines.'
        when 'uph'
          echo 'Velvet, or a natural cloth chosen with you'
        when 'width'
          echo 'As wide as the bed'
        when 'base'
          echo 'On a slim First Dream boxspring.'
        when 'legs'
          echo 'Slender metal legs'
        when 'quote'
          echo 'Inside a sea of tulips, I would like to go on a wave of wonder.'
        when 'author'
          echo 'Fabrizio Caramagna'
        when 'height'
          echo '105'
      endcase
    when 'pure'
      case part
        when 'title'
          echo 'Pure'
        when 'line'
          echo 'Simple and precious, with room for a discreet embroidery.'
        when 'hb'
          echo 'A plain, precious headboard that can carry a discreet embroidery: simple to look at, and a work that reveals itself over years of living with it.'
        when 'uph'
          echo 'Natural cloths and leathers, chosen with you'
        when 'width'
          echo 'As wide as the bed'
        when 'base'
          echo 'On a Midsummer boxspring of your choice, Dreamy Springs, Top Dream or My Dream, upholstered to match.'
        when 'legs'
          echo 'Wooden legs'
        when 'quote'
          echo 'Black as the devil, hot as hell, pure as an angel, sweet as love.'
        when 'author'
          echo 'Talleyrand, on coffee. We think it fits a bed too'
        when 'height'
          echo '101'
      endcase
    when 'giotto'
      case part
        when 'title'
          echo 'Giotto'
        when 'line'
          echo 'A round bed in Canaletto walnut, beautiful from every side.'
        when 'hb'
          echo 'A curved headboard of Canaletto walnut enclosing a panel of Vienna straw; the beveled frame is walnut too, in a natural matt finish.'
        when 'uph'
          echo 'Canaletto walnut and Vienna straw'
        when 'width'
          echo 'Ø 255 cm, to stand in the middle of the room'
        when 'base'
          echo 'On a slim boxspring, inside the walnut frame.'
        when 'legs'
          echo 'The walnut frame, close to the floor'
        when 'quote'
          echo 'In the circle of a thought, sometimes I rest dreaming.'
        when 'author'
          echo 'Alda Merini'
        when 'height'
          echo '100'
      endcase
  endcase
-%}
