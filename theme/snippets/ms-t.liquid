{%- comment -%}
  A text the house wrote in English, in the visitor's language.
  In Italian or Russian the translation is found in locales/it.json and ru.json under "ms_tx", by
  a fingerprint of the English text (its md5; a text longer than a locale value may be is kept in
  pieces: _2, _3…). A text with no translation, or the English site, shows the text as it is.
  A translation entered in Translate & Adapt changes the setting itself, so it shows unchanged.
  Generated by bin/build_r23.py. Usage: {% render 'ms-t', v: section.settings.heading %}
{%- endcomment -%}
{%- liquid
  assign ms_l = request.locale.iso_code | slice: 0, 2
  if ms_l == 'en' or v == blank
    echo v
  else
    assign ms_k = v | md5 | slice: 0, 16 | prepend: 'ms_tx.k' | append: '_html'
    assign ms_o = ms_k | t
    assign ms_c = ms_o | slice: 0, 19 | downcase
    if ms_c == 'translation missing'
      echo v
    else
      echo ms_o
      assign ms_k = v | md5 | slice: 0, 16 | prepend: 'ms_tx.k'
      for ms_i in (2..9)
        assign ms_kk = ms_k | append: '_' | append: ms_i | append: '_html'
        assign ms_p = ms_kk | t
        assign ms_c = ms_p | slice: 0, 19 | downcase
        if ms_c == 'translation missing'
          break
        endif
        echo ms_p
      endfor
    endif
  endif
-%}
