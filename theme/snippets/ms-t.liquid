{%- comment -%}
  A text the house wrote in English, in the visitor's language.
  In Italian or Russian the translation is found in locales/it.json and ru.json under "ms_tx", by
  a fingerprint of the English text (its md5; a text longer than a locale value may be is kept in
  pieces: _2, _3…). A text with no translation, or the English site, shows the text as it is.
  A translation entered in Translate & Adapt changes the setting itself, so it shows unchanged.
  Generated by bin/build_r23.py. Usage: {% render 'ms-t', v: section.settings.heading %}
  With en: (the setting's id), bid: block.id and sid: section.id, a value that has no translation of
  its own is also looked up by its place (scripts/en_guard.py): a setting that is not language is the
  value the theme was built with (ms-en-map), and a text Translate & Adapt replaced with its own
  translation shows the theme's translation of the English it was built with (ms-tx-map).
{%- endcomment -%}
{%- liquid
  assign ms_l = request.locale.iso_code | slice: 0, 2
  if ms_l == 'en' or v == blank
    echo v
  else
    assign ms_k = v | md5 | slice: 0, 16 | prepend: 'ms_tx.k'
    assign ms_o = ms_k | append: '_html' | t
    assign ms_c = ms_o | slice: 0, 19 | downcase
    if ms_c == 'translation missing' and en != blank and sid != blank
      # not a text the theme knows: Translate & Adapt may have replaced it. Look it up by its place.
      assign ms_sk = sid | split: '__' | last
      if sid contains 'template--'
        assign ms_tk = template.name
        if template.suffix != blank
          assign ms_tk = ms_tk | append: '.' | append: template.suffix
        endif
      else
        assign ms_tk = 'group'
      endif
      assign ms_needle = bid | default: '-' | prepend: '/' | prepend: ms_sk | append: '/' | append: en | append: '=' | prepend: '¦'
      capture ms_map
        render 'ms-en-map', tk: ms_tk
      endcapture
      if ms_map contains ms_needle
        assign v = ms_map | split: ms_needle | last | split: '¦' | first
        assign ms_k = v | md5 | slice: 0, 16 | prepend: 'ms_tx.k'
      else
        capture ms_map
          render 'ms-tx-map', tk: ms_tk
        endcapture
        if ms_map contains ms_needle
          assign ms_k = ms_map | split: ms_needle | last | split: '¦' | first | prepend: 'ms_tx.'
        endif
      endif
      assign ms_o = ms_k | append: '_html' | t
      assign ms_c = ms_o | slice: 0, 19 | downcase
    endif
    if ms_c == 'translation missing'
      echo v
    else
      echo ms_o
      for ms_i in (2..9)
        assign ms_kk = ms_k | append: '_' | append: ms_i | append: '_html'
        assign ms_p = ms_kk | t
        assign ms_c = ms_p | slice: 0, 19 | downcase
        if ms_c == 'translation missing'
          break
        endif
        echo ms_p
      endfor
    endif
  endif
-%}
