{%- comment -%}
  The drawn mark of a natural fibre: the animal or plant it comes from, in one thin line.
  Usage: {% render 'ms-fibre-mark', name: 'Baby Alpaca', size: 40 %}
{%- endcomment -%}
{%- liquid
  assign n = name | downcase | strip
  assign ic = 'thread'
  case n
    when 'vicuña', 'vicuna', 'baby alpaca', 'alpaca', 'alpaca wool', 'llama'
      assign ic = 'camelid'
    when 'cashmere', 'mohair', 'goat'
      assign ic = 'goat'
    when 'cheviot wool', 'cheviot', 'falkland wool', 'falkland', 'merino', 'merino wool', 'wool', 'wool felt', 'lambswool', 'virgin wool'
      assign ic = 'sheep'
    when 'horsehair', 'horse hair', 'horse-hair'
      assign ic = 'horse'
    when 'yak hair', 'yak', 'yak wool'
      assign ic = 'yak'
    when 'camel hair', 'camelhair', 'camel'
      assign ic = 'camel'
    when 'silk', 'mulberry silk', 'silk floss'
      assign ic = 'cocoon'
    when 'linen', 'flax'
      assign ic = 'flax'
    when 'cotton', 'organic cotton', 'cotton fabric'
      assign ic = 'cotton'
    when 'vegetable horsehair', 'coconut', 'coir'
      assign ic = 'palm'
    when 'ingeo', 'ingeo™', 'linen and ingeo™', 'linen and ingeo', 'corn'
      assign ic = 'corn'
    when 'orange fiber', 'orange fibre'
      assign ic = 'orange'
    when 'hemp'
      assign ic = 'hemp'
  endcase
  assign sz = size | default: 40
-%}
<svg class="ms-fm ms-fm--{{ ic }}" viewBox="0 0 40 40" width="{{ sz }}" height="{{ sz }}" fill="currentColor" stroke="none" aria-hidden="true" focusable="false" overflow="visible" shape-rendering="geometricPrecision">{%- case ic -%}{%- when 'sheep' -%}<circle cx="11.6" cy="21.2" r="4.6"/><circle cx="16.4" cy="18.4" r="5"/><circle cx="21.8" cy="18.2" r="5"/><circle cx="26.2" cy="20.6" r="4.4"/><circle cx="13.8" cy="24.2" r="4"/><circle cx="19.2" cy="24.6" r="4.2"/><circle cx="24.4" cy="24.2" r="3.9"/><ellipse cx="31.4" cy="20.6" rx="2.9" ry="4.1" transform="rotate(-28 31.4 20.6)"/><ellipse cx="29.3" cy="18.6" rx="2.3" ry=".95" transform="rotate(-16 29.3 18.6)"/><path d="M13 26.5V33.05 M16.4 27.4V33.05 M23.4 27.4V33.05 M26.6 26.5V33.05" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>{%- when 'goat' -%}<rect x="8.8" y="16.4" width="19.6" height="8.8" rx="4.2"/><path d="M24.2 17.6l4-6.8c.6-1 1.8-1.4 2.8-.9l3.4 1.9c1 .6 1.3 1.9.6 2.8c-.6.8-1.8 1.1-2.7.6l-1.3-.7l-2.2 4.4z"/><path d="M29.2 10.6c-.3-2.6-1.9-4.6-4.6-5.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M32.6 14.6l-.4 3.6l-1.6-3z"/><path d="M9.4 17.4c-.9-.9-1.3-2.1-1.1-3.4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.4 24.4V33.1 M14.4 24.8V33.1 M23.4 24.8V33.1 M26.4 24.4V33.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>{%- when 'camelid' -%}<ellipse cx="17.2" cy="21.4" rx="8.6" ry="4.5"/><path d="M21.6 22.6l1.2-14.4c.1-1.4 1.2-2.4 2.6-2.4h0c1.4 0 2.5 1.2 2.4 2.6l-1.1 14.6z"/><ellipse cx="28.4" cy="7.4" rx="3.6" ry="1.9" transform="rotate(14 28.4 7.4)"/><path d="M24.8 6.4l-.6-3.6l2.3 2.8zM26.6 5.8l.5-3.6l1.3 3.4z"/><path d="M8.8 20.4c-.7-.4-1.1-1.1-1.1-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M11.6 23.6V33.15 M14.6 24.4V33.15 M20.2 24.4V33.15 M23.2