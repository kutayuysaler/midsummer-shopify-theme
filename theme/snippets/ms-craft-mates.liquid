{%- comment -%}
  What completes a product in Inside the bed: for a part it does not include (topper, mattress or
  base), its own companions first, then the store's collection of that kind, else the house's own
  pieces. Output: first link^the collection's link^first image^the list's items. Generated by
  bin/build_more.py from bin/lp_data.py.
{%- endcomment -%}
{%- liquid
  assign own = ''
  case key
    when 'roma'
      if part == 'topper'
        assign own = 'topper-roma,roma-topper'
      endif
    when 'topper-roma'
      if part == 'mattress'
        assign own = 'mystic-river,roma'
      endif
    when 'my-dream'
      if part == 'base'
        assign own = 'my-dream-1'
      endif
    when 'first-dream'
      if part == 'base'
        assign own = 'first-dream-1'
      endif
    when 'dreamy-springs'
      if part == 'base'
        assign own = 'dreamy-springs'
      endif
    when 'base-my-dream'
      if part == 'mattress'
        assign own = 'my-dream'
      endif
    when 'base-first-dream'
      if part == 'mattress'
        assign own = 'first-dream-mattress'
      endif
    when 'base-dreamy-springs'
      if part == 'mattress'
        assign own = 'dreamy-springs-mattress,dreamy-springs-1'
      endif
  endcase
  case part
    when 'topper'
      assign place = 'toppers'
      assign spare = 'topper-roma'
    when 'mattress'
      assign place = 'mattresses'
      assign spare = ''
    when 'base'
      assign place = 'bases'
      assign spare = 'dreamy-springs,top-dream,my-dream-1,first-dream-1,storage-boxspring'
  endcase
  capture chs
    render 'ms-link', to: place, handles: true
  endcapture
  assign col = nil
  assign chl = chs | strip | split: ','
  for ch in chl
    assign cc = collections[ch]
    if cc != blank and cc.products_count > 0
      assign col = cc
      break
    endif
  endfor
  assign seen = ','
  if product != blank
    assign seen = seen | append: product.handle | append: ','
  endif
  assign hs = own
  if col == nil
    assign hs = hs | append: ',' | append: spare
  endif
  assign hs = hs | split: ','
  assign n = 0
  assign first = ''
  assign img = ''
  assign items = ''
  for h in hs
    if h == blank or n >= 3
      continue
    endif
    assign mp = all_products[h]
    if mp == blank or mp.handle == blank
      continue
    endif
    capture mk
      render 'ms-kind', p: mp
    endcapture
    assign mk = mk | split: '|' | first
    if mk == 'other'
      continue
    endif
    assign probe = ',' | append: mp.handle | append: ','
    if seen contains probe
      continue
    endif
    assign seen = seen | append: mp.handle | append: ','
    capture it
      render 'ms-craft-mate', mp: mp
    endcapture
    assign items = items | append: it
    if first == ''
      assign first = mp.url
      if mp.featured_image
        assign img = mp.featured_image | image_url: width: 900
      endif
    endif
    assign n = n | plus: 1
  endfor
  if col != nil
    for mp in col.products limit: 8
      if n >= 3
        break
      endif
      assign probe = ',' | append: mp.handle | append: ','
      if seen contains probe
        continue
      endif
      assign seen = seen | append: mp.handle | append: ','
      capture it
        render 'ms-craft-mate', mp: mp
      endcapture
      assign items = items | append: it
      if first == ''
        assign first = mp.url
        if mp.featured_image
          assign img = mp.featured_image | image_url: width: 900
        endif
      endif
      assign n = n | plus: 1
    endfor
  endif
  assign all = ''
  if col != nil
    assign all = col.url
    if first == ''
      assign first = col.url
    endif
  endif
  echo first | append: '^' | append: all | append: '^' | append: img | append: '^' | append: items
-%}
