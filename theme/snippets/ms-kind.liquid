{%- comment -%}
  What a product is, as 'kind|key|bed': kind is system, headboard, outdoor, boxspring or other;
  key is the sleep system's template (its fibres, cloth and craft), bed the headboard bed's data.
  The template chosen in admin wins; otherwise the store's own handles, then the product type and
  its collections. Generated by bin/build_more.py.
{%- endcomment -%}
{%- liquid
  assign h = p.handle
  assign sfx = p.template_suffix | default: ''
  assign key = ''
  assign bed = ''
  assign kind = 'other'
  assign probe = ',' | append: sfx | append: ','
  if sfx != '' and ',amalfi,bellagio,bellini,brera,capri,dreamy-2,dreamy-springs,essenziale,first-dream,flora,giotto,monteverdi,my-dream,paisley,raffaello,roma,storage,top-2,topper-high,topper-roma,topper-thin,ultra-dry,vicuna,vivaldi-2,vivaldi-plus,' contains probe
    assign key = sfx
  else
    case h
      when 'amalfi'
        assign key = 'amalfi'
      when 'bellagio'
        assign key = 'bellagio'
      when 'bellini'
        assign key = 'bellini'
      when 'brera'
        assign key = 'brera'
      when 'capri'
        assign key = 'capri'
      when 'dreamy', 'dreamy-2'
        assign key = 'dreamy-2'
      when 'dreamy-springs-1', 'dreamy-springs-mattress'
        assign key = 'dreamy-springs'
      when 'essenziale'
        assign key = 'essenziale'
      when 'first-dream-mattress'
        assign key = 'first-dream'
      when 'flora'
        assign key = 'flora'
      when 'giotto-round'
        assign key = 'giotto'
      when 'monteverdi'
        assign key = 'monteverdi'
      when 'my-dream'
        assign key = 'my-dream'
      when 'paisley'
        assign key = 'paisley'
      when 'raffaello'
        assign key = 'raffaello'
      when 'roma', 'mystic-river'
        assign key = 'roma'
      when 'storage'
        assign key = 'storage'
      when 'top', 'top-2'
        assign key = 'top-2'
      when 'topper-roma'
        assign key = 'topper-roma'
      when 'ultra-dry-mattress', 'ultra-dry'
        assign key = 'ultra-dry'
      when 'vicuna-mattress', 'vicuna'
        assign key = 'vicuna'
      when 'vivaldi', 'vivaldi-2'
        assign key = 'vivaldi-2'
      when 'vivaldi-plus'
        assign key = 'vivaldi-plus'
    endcase
  endif
  if key == '' or key == 'topper-roma'
    assign tt = p.title | append: ' ' | append: h | downcase
    if tt contains 'topper'
      unless tt contains 'roma'
        if tt contains 'thin' or tt contains 'sottile'
          assign key = 'topper-thin'
        elsif tt contains 'high' or tt contains 'medium' or tt contains 'alto' or tt contains 'medio'
          assign key = 'topper-high'
        endif
      endunless
    endif
  endif
  case h
    when 'beating-of-wings'
      assign bed = 'beating-of-wings'
    when 'cashmere-couture', 'cashmere-couture-bed'
      assign bed = 'cashmere-couture'
    when 'giotto', 'giotto-bed'
      assign bed = 'giotto'
    when 'jungle-dreams', 'jungle-dream'
      assign bed = 'jungle-dreams'
    when 'pure'
      assign bed = 'pure'
    when 'silk-flowers', 'silk-fowers', 'silk-flower'
      assign bed = 'silk-flowers'
    when 'soft-to-the-touch', 'soft-to-touch'
      assign bed = 'soft-to-the-touch'
    when 'tulip'
      assign bed = 'tulip'
  endcase
  if sfx == 'headboard' and bed == ''
    assign bed = 'pure'
  endif
  assign ty = p.type | downcase
  if key != ''
    assign kind = 'system'
  elsif bed != '' or sfx == 'headboard'
    assign kind = 'headboard'
  elsif h == 'tangram' or sfx == 'tangram' or sfx == 'outdoor' or ty contains 'outdoor'
    assign kind = 'outdoor'
  elsif ty == 'boxspring' or ',dreamy-springs,first-dream-1,my-dream-1,storage-boxspring,top-dream,' contains h
    assign kind = 'boxspring'
  else
    for c in p.collections
      if c.handle == 'beds-with-headboards'
        assign kind = 'headboard'
        break
      elsif c.handle contains 'outdoor'
        assign kind = 'outdoor'
        break
      endif
    endfor
    if kind == 'other' and ty == 'bed'
      assign kind = 'headboard'
    endif
  endif
  echo kind | append: '|' | append: key | append: '|' | append: bed
-%}
