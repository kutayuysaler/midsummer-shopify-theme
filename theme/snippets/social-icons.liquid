  {%- endif -%}
  {%- if settings.social_whatsapp_link != blank -%}
    <li class="list-social__item">
      <a class="list-social__link list-social__link--whatsapp"
        href="{{ settings.social_whatsapp_link }}" target="_blank" rel="noopener"
        aria-label="WhatsApp">
        {% render 'icon-whatsapp' %}
      </a>
    </li>
  {%- endif -%}
  {%- if settings.social_telegram_link != blank and request.locale.iso_code contains 'ru' -%}
    <li class="list-social__item">
      <a class="list-social__link list-social__link--telegram"
        href="{{ settings.social_telegram_link }}" target="_blank" rel="noopener"
