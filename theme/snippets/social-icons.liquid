  {%- endif -%}
  {%- if settings.social_vk_link != blank and request.locale.iso_code contains 'ru' -%}
    <li class="list-social__item">
      <a class="list-social__link list-social__link--vk"
        href="{{ settings.social_vk_link }}" target="_blank" rel="noopener"
        aria-label="VK">
        {% render 'icon-vk' %}
      </a>
    </li>
  {%- endif -%}
</ul>
