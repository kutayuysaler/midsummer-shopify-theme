{%- comment -%} The photograph on each card of Inside the bed (key, part): a system photographed has its own;
  the others the house's photographs of a topper, a mattress, a boxspring. Generated by bin/build_r16.py. {%- endcomment -%}
{%- liquid
  assign tp = 'ms-part-topper-house.jpg'
  assign mp = 'ms-part-mattress-house.jpg'
  assign bp = 'ms-part-base-house.jpg'
  case key
    when 'roma'
      assign tp = 'ms-part-topper-roma.jpg'
      assign mp = 'ms-part-mattress-roma.jpg'
      assign bp = 'ms-part-base-house.jpg'
    when 'topper-roma'
      assign tp = 'ms-part-topper-roma.jpg'
      assign mp = 'ms-part-mattress-roma.jpg'
      assign bp = 'ms-part-base-house.jpg'
    when 'flora'
      assign tp = 'ms-part-topper-flora.jpg'
      assign mp = 'ms-part-mattress-flora.jpg'
      assign bp = 'ms-part-base-flora.jpg'
    when 'paisley'
      assign tp = 'ms-part-topper-paisley.jpg'
      assign mp = 'ms-part-mattress-paisley.jpg'
      assign bp = 'ms-part-base-paisley.jpg'
    when 'first-dream'
      assign tp = 'ms-part-topper-firstdream.jpg'
      assign mp = 'ms-part-mattress-house.jpg'
      assign bp = 'ms-part-base-firstdream.jpg'
    when 'base-first-dream'
      assign tp = 'ms-part-topper-firstdream.jpg'
      assign mp = 'ms-part-mattress-house.jpg'
      assign bp = 'ms-part-base-firstdream.jpg'
    when 'dreamy-2'
      assign tp = 'ms-part-topper-dreamy.jpg'
      assign mp = 'ms-part-mattress-detail.jpg'
      assign bp = 'ms-part-base-dreamy.jpg'
    when 'dreamy-springs'
      assign tp = 'ms-part-topper-dreamy.jpg'
      assign mp = 'ms-part-mattress-detail.jpg'
      assign bp = 'ms-part-base-dreamy.jpg'
    when 'base-dreamy-springs'
      assign tp = 'ms-part-topper-dreamy.jpg'
      assign mp = 'ms-part-mattress-detail.jpg'
      assign bp = 'ms-part-base-dreamy.jpg'
  endcase
  case part
    when 'topper'
      echo tp
    when 'mattress'
      echo mp
    else
      echo bp
  endcase
-%}
