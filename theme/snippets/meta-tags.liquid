{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#FBF9F5"
>

{%- liquid
  # Midsummer Milano: SEO fixes carried over from the live theme (Aug 2026 audit).
  # Policy pages canonicalise to the legal pages the site links to.
  assign ms_canonical = canonical_url
  if request.path contains '/policies/terms-of-service'
    assign ms_canonical = canonical_url | replace: '/policies/terms-of-service', '/pages/terms-and-conditions'
  elsif request.path contains '/policies/privacy-policy'
    assign ms_canonical = canonical_url | replace: '/policies/privacy-policy', '/pages/privacy-and-legal'
  endif

  # one spelling of the house's name, whatever the store is called in admin
  assign ms_brand = 'Midsummer Milano'
  # Meta description, with fallbacks so no page ships without one.
  assign ms_desc = page_description | strip_html | strip
  if ms_desc == blank and request.page_type == 'article'
    assign ms_desc = article.excerpt_or_content | strip_html | strip
  endif
  if request.page_type == 'article' and ms_desc.size < 60
    assign ms_desc = article.title | append: ' — ' | append: blog.title | append: ' on ' | append: ms_brand | append: ', Italian luxury beds and mattresses handmade in natural materials.'
  endif
  # each blog says what it holds: a publication's pieces, the projects, the collaborations, the journal
  if ms_desc == blank and request.page_type == 'blog'
    assign ms_desc_blog = blog.handle | downcase
    if ms_desc_blog contains 'press-'
      assign ms_desc = blog.title | append: ' on ' | append: ms_brand | append: ': the pieces it has written about the house’s handmade beds and mattresses, and where to read them.'
    elsif ms_desc_blog == 'press'
      assign ms_desc = 'The press on ' | append: ms_brand | append: ': magazines, newspapers and awards on the house’s beds and mattresses, made by hand in Italy from natural fibres.'
    elsif ms_desc_blog contains 'project' or ms_desc_blog contains 'progett' or ms_desc_blog contains 'portfolio' or ms_desc_blog contains 'hotel'
      assign ms_desc = 'Projects by ' | append: ms_brand | append: ': handmade beds for homes, hotels, villas, yachts and private jets, specified with the Milan atelier and made to measure in Italy.'
    elsif ms_desc_blog contains 'collab'
      assign ms_desc = 'Collaborations by ' | append: ms_brand | append: ': designers, houses and artisans the atelier has worked with, and the beds made together.'
    else
      assign ms_desc = 'The ' | append: ms_brand | append: ' journal: sleep, natural materials, craft, the bedroom and news from the Milan atelier.'
    endif
  endif
  if ms_desc == blank and request.page_type == 'page'
    assign ms_desc = page.content | strip_html | strip
  endif
  if request.page_type == 'page' and page.handle == 'contact' or request.page_type == 'page' and template.suffix == 'contact'
    assign ms_desc_c = ms_desc | downcase
    if ms_desc == blank or ms_desc_c contains 'please contact' or ms_desc_c contains 'info@'
      assign ms_desc = 'Book an appointment at the Milan atelier, ask for a proposal, or write to ' | append: ms_brand | append: ' about a bed, a project or becoming a partner.'
    endif
  endif
  if ms_desc == blank
    assign ms_desc = shop.description
  endif
  assign ms_desc = ms_desc | replace: '&amp;', '&' | replace: '&#39;', '’' | replace: '&quot;', '"' | replace: '&nbsp;', ' ' | strip | truncate: 158

  comment
    the designed places reached at /collections/all?view=ms-<place> carry their own title and description
  endcomment
  assign ms_view_title = ''
  if template.name == 'collection'
    case template.suffix
      when 'ms-atelier'
        assign ms_view_title = 'The Milano atelier'
        assign ms_desc = 'Visit the Midsummer Milano atelier at Via Andegari 4, Milano: lie on the systems, touch the fibres and Loro Piana Interiors cloths, by appointment Monday to Friday.'
      when 'ms-compare'
        assign ms_view_title = 'Compare the collections'
        assign ms_desc = 'Essentials, Signature and Icons by Midsummer Milano compared: fibres, cloth, how far each is made to measure, and what every handmade bed shares.'
      when 'ms-essentials'
        assign ms_view_title = 'Essentials'
        assign ms_desc = 'Essentials by Midsummer Milano: handmade beds and mattresses in natural fibres, the entry into the house, made to order in Italy.'
      when 'ms-signature'
        assign ms_view_title = 'Signature'
        assign ms_desc = 'Signature by Midsummer Milano: beds of precious natural fibres, in natural linen and cotton or Loro Piana Interiors, handmade to order in Italy.'
      when 'ms-icons'
        assign ms_view_title = 'Icons'
        assign ms_desc = 'Icons by Midsummer Milano: the house’s most important beds, completely bespoke, most of them made in Loro Piana Interiors.'
      when 'ms-story'
        assign ms_view_title = 'Our story'
        assign ms_desc = 'Midsummer Milano, founded in Milan by Chiara Mennini: luxury beds and mattresses made by hand in Italy, one at a time, from natural fibres.'
      when 'ms-handmade'
        assign ms_view_title = 'Handmade in Italy'
        assign ms_desc = 'How a Midsummer bed is made: in Italy, every mattress, topper and boxspring is tufted, stitched and finished by hand, from start to finish.'
      when 'ms-sleep-culture'
        assign ms_view_title = 'Sleep culture'
        assign ms_desc = 'Temperature, seasons and support: how natural fibres and a handmade sleep system change the way you rest, from the Midsummer Milano atelier.'
      when 'ms-materials'
        assign ms_view_title = 'Natural materials'
        assign ms_desc = 'Vicuña, cashmere, baby alpaca, mohair, horsehair and wool: the natural fibres inside every Midsummer Milano bed, and why each one is there.'
      when 'ms-regen'
        assign ms_view_title = 'Made to last · 15 + 15'
        assign ms_desc = 'A Midsummer mattress is built to last and to be regenerated: fifteen years, then fifteen more once our artisans have renewed it by hand.'
      when 'ms-quiz'
        assign ms_view_title = 'Find your Midsummer'
        assign ms_desc = 'Five questions on how you sleep, and the Midsummer Milano system we would make for you: mattress, topper and boxspring.'
      when 'ms-professionals'
        assign ms_view_title = 'Architects & Interior Designers'
        assign ms_desc = 'Made-to-measure beds, mattresses and Loro Piana Interiors fabrics for architects and interior designers, with trade support from the Milan atelier.'
      when 'ms-hospitality'
        assign ms_view_title = 'Hospitality & Contract'
        assign ms_desc = 'Handmade beds and mattresses for hotels, villas, yachts, private jets and residences, specified with the Midsummer Milano atelier and made by hand in Italy.'
      when 'ms-agents'
        assign ms_view_title = 'Agents & Resellers'
        assign ms_desc = 'Find a Midsummer Milano agent or reseller near you, or visit the atelier on Via Andegari in Milan, by appointment.'
      when 'ms-faq'
        assign ms_view_title = 'Questions'
        assign ms_desc = 'Answers on Midsummer Milano beds and mattresses: materials, sizes, delivery, care, regeneration and how a made-to-order system is specified.'
      when 'ms-contact'
        assign ms_view_title = 'Enquire'
        assign ms_desc = 'Book an appointment at the Milan atelier, ask for a quote or write to Midsummer Milano about a bed, a project or becoming a partner.'
      when 'ms-loro'
        assign ms_view_title = 'Loro Piana Interiors'
        assign ms_desc = 'Midsummer Milano beds and headboards upholstered in Loro Piana Interiors fabrics: cashmere, linen and wool, chosen at the Milan atelier.'
      when 'ms-dream'
        assign ms_view_title = 'Download the dream'
        assign ms_desc = 'The Midsummer Milano book: the house, the fibres and the collections. Ask the atelier for your copy.'
    endcase
  endif

  # the Journal's subjects, each a page of its own (?view=sleep …)
  if request.page_type == 'blog' and template.suffix != blank
    assign ms_subj = template.suffix
    case ms_subj
      when 'sleep'
        assign ms_view_title = 'Sleep · ' | append: blog.title
        assign ms_desc = 'Notes on sleep from the Midsummer Milano journal: how we rest, the seasons of the bed, and what natural fibres change at night.'
      when 'materials'
        assign ms_view_title = 'Materials · ' | append: blog.title
        assign ms_desc = 'Notes on natural materials from the Midsummer Milano journal: wool, cashmere, vicuña, horsehair, linen and the other fibres in our beds.'
      when 'craft'
        assign ms_view_title = 'Craft · ' | append: blog.title
        assign ms_desc = 'Notes on craft from the Midsummer Milano journal: how a bed is made by hand in Italy, from the first stitch to the last.'
      when 'design'
        assign ms_view_title = 'The bedroom · ' | append: blog.title
        assign ms_desc = 'Notes on the bedroom from the Midsummer Milano journal: design, colour, light and the rooms we sleep in.'
      when 'italy'
        assign ms_view_title = 'Italian living · ' | append: blog.title
        assign ms_desc = 'Notes on Italian living from the Midsummer Milano journal: places, food, reading and a slower way of life.'
      when 'regen'
        assign ms_view_title = 'Sustainability · ' | append: blog.title
        assign ms_desc = 'Notes on sustainability from the Midsummer Milano journal: beds that last, regeneration at fifteen years, less waste.'
      when 'projects'
        assign ms_view_title = 'Projects · ' | append: blog.title
        assign ms_desc = 'Projects from the Midsummer Milano journal: bedrooms in homes, villas and hotels, made with the Milan atelier.'
      when 'news'
        assign ms_view_title = 'News & press · ' | append: blog.title
        assign ms_desc = 'News and press from the Midsummer Milano journal: the Salone, collaborations, awards and features.'
    endcase
  endif
  assign og_title = page_title | default: ms_brand | replace: '&amp;', '&'
  if request.page_type == 'collection' and collection.title == 'Icon'
    assign og_title = 'Icons | ' | append: ms_brand
  endif
  if ms_view_title != blank
    assign og_title = ms_view_title | append: ' | Midsummer Milano'
  endif
  assign og_url = ms_canonical | default: request.origin
  assign og_type = 'website'
  assign og_description = ms_desc | default: ms_brand

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ ms_brand }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'article' and page_image == blank and article.image != blank -%}
  <meta
    property="og:image"
    content="https:{{ article.image | image_url: width: 1200 }}"
  >
{%- endif -%}

{%- comment -%} No page leaves without a picture to share: the atelier when nothing else is set. {%- endcomment -%}
{%- if page_image == blank -%}
  {%- unless request.page_type == 'article' and article.image != blank -%}
  <meta
    property="og:image"
    content="https:{{ 'ms-photo-atelier-blue-gold.jpg' | asset_url }}"
  >
  <meta
    property="og:image:alt"
    content="The Midsummer Milano atelier in Milan"
  >
  {%- endunless -%}
{%- endif -%}

{%- comment -%} Price tags only when prices are shown (Theme settings → Enquiry-led commerce). {%- endcomment -%}
{%- if request.page_type == 'product' and settings.ms_show_prices != false -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  assign ms_title = page_title | replace: '&amp;', '&' | strip | remove_last: ' | midsummer-milano' | remove_last: ' | Midsummer-Milano' | remove_last: ' | Midsummer Milano' | strip
  # the Icons collection, even where the store still calls it Icon
  assign ms_coll_icon = ms_title | downcase | strip
  if request.page_type == 'collection' and ms_coll_icon == 'icon'
    assign ms_title = 'Icons'
  endif
  if ms_view_title != blank
    assign ms_title = ms_view_title
  endif

-%}
<title>
  {{ ms_title | escape }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless ms_title contains ms_brand or ms_title contains shop.name %} | {{ ms_brand }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ ms_canonical }}"
>

{% if ms_desc != blank %}
  <meta
    name="description"
    content="{{ ms_desc | escape }}"
  >
{% endif %}

{%- comment -%} Keep utility and app pages, and the catch-all collection, out of search results. {%- endcomment -%}
{%- liquid
  assign ms_noindex = false
  if request.page_type == 'page'
    case page.handle
      when 'search-results-page', 'request-for-quote', 'quotes-history', 'joy-subscription'
        assign ms_noindex = true
    endcase
  endif
  if request.page_type == 'collection' and collection.handle == 'all'
    assign ms_noindex = true
  endif
  if current_tags != blank
    assign ms_noindex = true
  endif
-%}
{%- if ms_noindex -%}
  <meta name="robots" content="noindex,follow">
{%- endif -%}
