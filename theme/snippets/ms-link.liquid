{%- comment -%}
  The address of a place on the site. In order:
    1. a link chosen under Theme settings → Midsummer · Where links go;
    2. the store's own page, collection or blog, by the handles it is published under
       (the store's real handles come first: about-midsummer-milano, italian-craftsmen-
       luxury-mattresses, natural-luxury-materials, sleep-wise-faq, agents-and-resellers …).
       A page with a design of its own opens in that design (?view=<template>) with its
       own title and words, whatever template admin assigned it;
    3. for the three collections, any published collection whose title or handle names it;
    4. the place's designed page, which always exists: /collections/all?view=ms-<place>
       (templates/collection.ms-*.json). Creating the page later moves the link to it.
       A page hidden in admin is skipped: its address would be a 404.

  Usage:
    href="{% render 'ms-link', to: 'materials' %}"
    {% render 'ms-link', to: 'enquire', q: 'enquiry=trade' %}#enquire → query joined with ? or &
    {% render 'ms-link', to: 'mattresses', strict: true %} → empty when the store has no such place
    {% render 'ms-link', to: 'journal-tag', tag: 'sleep' %} → the journal's subject, empty when unused
    {% render 'ms-link', to: 'faq', handles: true %} → the page handles this place answers to
{%- endcomment -%}
{%- liquid
  assign p = ''
  assign c = ''
  assign b = ''
  assign kw = ''
  assign view = ''
  assign fb = ''
  assign tpl = ''
  case to
    when 'story'
      assign tpl = 'story'
      assign p = 'about-midsummer-milano,our-story,about-us,about,chi-siamo'
      assign view = 'story'
    when 'handmade'
      assign tpl = 'handmade-in-italy'
      assign p = 'italian-craftsmen-luxury-mattresses,handmade-in-italy,handmade,made-in-italy,italian-craftsmen'
      assign view = 'handmade'
    when 'sleep-culture'
      assign tpl = 'sleep-culture'
      assign p = 'sleep-culture,the-culture-of-sleep,culture-of-sleep'
      assign view = 'sleep-culture'
    when 'materials'
      assign tpl = 'natural-materials'
      assign p = 'natural-luxury-materials,natural-materials,materials'
      assign view = 'materials'
    when 'regen', 'sustain'
      assign tpl = 'regeneration'
      assign p = 'midsummer-milanos-regeneration-service,regeneration-service,15-15-refurbishment,regeneration,15-15,our-eco-friendly-approach,sustainability'
      assign view = 'regen'
    when 'ergonomics'
      assign p = 'ergonomic-mattresses-benefits,ergonomics'
    when 'loro'
      assign tpl = 'loro-piana-interiors'
      assign p = 'loro-piana-interiors,loro-piana'
      assign view = 'loro'
    when 'dream'
      assign tpl = 'download-the-dream'
      assign p = 'download-dream-art-of-rest,download-the-dream,the-dream'
      assign view = 'dream'
    when 'quiz'
      assign tpl = 'find-your-midsummer'
      assign p = 'find-your-midsummer,sleep-assessment,sleep-assesment,sleep-style-quiz,sleep-quiz'
      assign view = 'quiz'
    when 'professionals'
      assign tpl = 'professionals'
      assign p = 'professionals,architects-and-interior-designers,architects-interior-designers,for-architects,trade'
      assign view = 'professionals'
    when 'hospitality'
      assign tpl = 'hospitality'
      assign p = 'hospitality,hospitality-and-contract,contract,hotels'
      assign view = 'hospitality'
    when 'atelier'
      assign tpl = 'atelier'
      assign p = 'atelier,the-atelier,milano-atelier,the-milano-atelier,showroom,visit-the-atelier'
      assign view = 'atelier'
    when 'facts'
      assign tpl = 'facts'
      assign p = 'midsummer-milano-at-a-glance,at-a-glance,facts,key-facts'
      assign view = 'facts'
    when 'agents'
      assign tpl = 'agents-and-resellers'
      assign p = 'agents-and-resellers,agents-resellers,store-locator,stockists,where-to-find-us'
      assign view = 'agents'
    when 'faq'
      assign tpl = 'faq'
      assign p = 'sleep-wise-faq,faq,questions,frequently-asked-questions'
      assign view = 'faq'
    when 'care'
      assign p = 'customer-assistance,customer-care'
      assign view = 'faq'
    when 'contact', 'enquire'
      assign tpl = 'contact'
      assign p = 'contact,contact-us,contacts,contatti'
      assign view = 'contact'
    when 'terms'
      assign p = 'terms-and-conditions,terms'
      assign fb = '/policies/terms-of-service'
    when 'privacy'
      assign p = 'privacy-and-legal,privacy'
      assign fb = '/policies/privacy-policy'
    when 'journal', 'journal-tag'
      assign b = 'news,journal'
      assign fb = '/blogs/news'
    when 'press'
      assign b = 'press'
    when 'portfolio'
      assign b = 'projects,portfolio'
    when 'collaborations'
      assign b = 'collaborations'
    when 'collections', 'compare'
      assign tpl = 'compare'
      assign p = 'sleep-collections,compare-the-collections,compare-collections'
      assign view = 'compare'
    when 'essentials', 'signature', 'icons'
      assign c = to | append: ',' | append: to | append: '-collection,the-' | append: to
      if to == 'icons'
        assign c = 'icons,icon,icons-collection,the-icons'
      endif
      assign kw = to
      assign view = to
    when 'mattresses'
      assign c = 'mattresses,mattress'
    when 'toppers'
      assign c = 'mattress-toppers,toppers,topper'
    when 'bases'
      assign c = 'bed-bases,bases,box-springs,boxsprings'
    when 'headboards'
      assign c = 'beds-with-headboards,gallery-beds,headboards'
    when 'systems'
      assign c = 'designer-beds,bed-systems,sleep-systems'
    when 'outdoor'
      assign c = 'outdoor-1,outdoor,outdoor-collection'
    when 'bedding'
      assign c = 'duvets,bed-sheets,bedding,bed-linen'
    when 'throws'
      assign c = 'gallery-blankets-and-throws,blankets-and-throws,throws'
    when 'cushions'
      assign c = 'cushions-and-screens,cushions'
    when 'lamps'
      assign c = 'gallery-lamps,lamps'
    when 'wallcoverings'
      assign c = 'wallcovering-and-fabrics,wallcoverings'
    when 'treasures'
      assign c = 'midsummer-treasures,treasures'
    when 'furniture'
      assign c = 'gallery-furniture,furniture'
    when 'home'
      assign fb = routes.root_url
    when 'search'
      assign fb = routes.search_url
  endcase

  if handles
    echo p
  else
    assign out = ''
    assign key = 'ms_link_' | append: to | replace: '-', '_'
    if to != 'journal-tag' and settings[key] != blank
      assign out = settings[key]
    endif
    if out == '' and p != ''
      assign list = p | split: ','
      for h in list
        comment
          a page hidden in admin still answers here, but its address is a 404 for visitors:
          only a published page is linked
        endcomment
        if pages[h].url != blank and pages[h].published_at != blank
          assign out = pages[h].url
          comment
            the page opens in its designed template, with its own title and words, even if
            admin gave it another one
          endcomment
          if tpl != '' and pages[h].template_suffix != tpl
            assign out = out | append: '?view=' | append: tpl
          endif
          break
        endif
      endfor
    endif
    if out == '' and c != ''
      assign list = c | split: ','
      for col in collections
        if list contains col.handle and col.products_count > 0
          assign out = col.url
          break
        endif
      endfor
      if out == '' and kw != ''
        for col in collections
          if col.products_count > 0
            assign ct = col.title | downcase
            if ct contains kw
              assign out = col.url
              break
            endif
          endif
        endfor
      endif
    endif
    if out == '' and b != ''
      assign list = b | split: ','
      for h in list
        if blogs[h].url != blank
          if to == 'journal-tag'
            assign want = tag | downcase
            for t in blogs[h].all_tags
              assign tt = t | downcase
              if tt == want
                assign th = t | handleize
                assign out = blogs[h].url | append: '/tagged/' | append: th
                break
              endif
            endfor
          else
            assign out = blogs[h].url
          endif
          break
        endif
      endfor
    endif
    if out == '' and view != ''
      assign out = routes.all_products_collection_url | append: '?view=ms-' | append: view
    endif
    if out == '' and strict != true and to != 'journal-tag'
      assign out = fb
    endif
    if q != blank and out != ''
      if out contains '?'
        assign out = out | append: '&' | append: q
      else
        assign out = out | append: '?' | append: q
      endif
    endif
    echo out
  endif
-%}
