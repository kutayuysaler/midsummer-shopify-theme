    "qa": {
      "type": "ms-qa",
      "settings": {
        "tone": "sand",
        "eyebrow": "Contract questions",
        "heading": "Before you open.",
        "link_label": "Start a hotel project",
        "link_place": "enquire"
      },
      "blocks": {
        "qa_01": {
          "type": "qa",
          "settings": {
            "q": "Can you make beds for a whole hotel?",
            "a": "<p>Yes. We make volume programmes to the room, by hand in Italy, with phased production aligned to your floor handovers and the same fibres across every key.</p>"
          }
        },
        "qa_02": {
          "type": "qa",
          "settings": {
            "q": "Are the beds suitable for contract use?",
            "a": "<p>Fire-retardancy and contract certification are prepared for each market and documented for your file.</p>"
          }
        },
        "qa_03": {
          "type": "qa",
          "settings": {
            "q": "How are the beds maintained?",
            "a": "<p>Each system comes with its housekeeping protocol, and we offer on-site rotation and care training for your team.</p>"
          }
        },
        "qa_04": {
          "type": "qa",
          "settings": {
            "q": "What happens at fifteen years?",
            "a": "<p>The 15 + 15 service can be written into the agreement: the beds return to the atelier to be opened, cleaned and rebuilt, rather than replaced.</p>"
          }
        }
      },
      "block_order": [
        "qa_01",
        "qa_02",
        "qa_03",
        "qa_04"
      ]
    },
