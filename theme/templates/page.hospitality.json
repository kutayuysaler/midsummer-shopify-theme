        },
        "a_1": {
          "type": "text",
          "settings": {
            "text": "<p>Midsummer supplies hotels, branded residences and yachts with the same hand-built natural-fibre systems we make for private clients — specified for contract life, delivered in phases, and regenerated rather than replaced.</p>",
            "style": "body",
            "column": "first"
          }
        }
      },
