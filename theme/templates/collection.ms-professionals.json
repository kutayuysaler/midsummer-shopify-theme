    "projects": {
      "type": "ms-article-rail",
      "settings": {
        "blog_handle": "projects",
        "eyebrow": "Projects",
        "heading": "Where our beds went.",
        "link_label": "All projects",
        "limit": 4
      }
    },
    "qa": {
      "type": "ms-qa",
      "settings": {
        "tone": "sand",
        "eyebrow": "Trade questions",
        "heading": "Before you specify.",
        "link_label": "Open a project file",
        "link_place": "enquire"
      },
      "blocks": {
        "qa_01": {
          "type": "qa",
          "settings": {
            "q": "Do you work from our drawings?",
            "a": "<p>Yes. Dimensions, heights and radii, round beds included, are worked to your drawing, with no tooling charge.</p>"
          }
        },
        "qa_02": {
          "type": "qa",
          "settings": {
            "q": "Can we specify our own fabric?",
            "a": "<p>Yes. The full Loro Piana Interiors palette is available, and your own cloth (COM) on request.</p>"
          }
        },
        "qa_03": {
          "type": "qa",
          "settings": {
            "q": "What do you send for a specification?",
            "a": "<p>Drawings, sections and material schedules for your set, fabric references from Loro Piana Interiors and samples of the natural fibres.</p>"
          }
        },
        "qa_04": {
          "type": "qa",
          "settings": {
            "q": "Who follows the project?",
            "a": "<p>One person at the atelier, from the first specification to delivery and installation.</p>"
          }
        },
        "qa_05": {
          "type": "qa",
          "settings": {
            "q": "Where can our clients see the beds?",
            "a": "<p>At the atelier in Milan, by appointment, or at our agents and resellers in Europe, the Americas and Asia.</p>"
          }
        }
      },
      "block_order": [
        "qa_01",
        "qa_02",
        "qa_03",
        "qa_04",
        "qa_05"
      ]
    },
    "spec": {
      "type": "ms-spec",
      "settings": {}
    },
    "steps": {
      "type": "ms-steps",
      "settings": {},
      "blocks": {
        "step_0": {
          "type": "step",
          "settings": {
            "title": "The drawing",
            "text": "Send us the room: the plan, the elevations and the bed's place in it."
          }
        },
        "step_1": {
          "type": "step",
          "settings": {
            "title": "The specification",
            "text": "Dimensions, firmness, fibres and cloth, set with one person at the atelier."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "The samples",
            "text": "Cloths and fibres sent to your studio, to be chosen against the room."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "title": "The making",
            "text": "By hand in Italy, by two artisans, from start to finish."
          }
        },
        "step_4": {
          "type": "step",
          "settings": {
            "title": "The delivery",
            "text": "By our own team: brought into the room, assembled and dressed."
          }
        }
      },
      "block_order": [
        "step_0",
        "step_1",
        "step_2",
        "step_3",
        "step_4"
      ]
