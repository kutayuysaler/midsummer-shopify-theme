        "heading": "Everything you will need, in one house.",
        "text": "The pages architects and interior designers use most when they specify a Midsummer system."
      },
      "blocks": {
        "card_01": {
          "type": "card",
          "settings": {
            "place": "collections",
            "title": "The three collections",
