/*
 * Midsummer Milano — built on the live Dawn theme.
 * Design sections: ms-hero, ms-split, ms-cards and the ms-* specialist sections.
 */
{
  "sections": {
    "ms_head": {
      "type": "ms-split",
      "settings": {
        "tone": "ivory",
        "text_align": "left",
        "first_width": 50,
        "image_position": "right",
        "image_ratio": "natural",
        "image_caption": "",
        "image_link": "",
        "padding_top": 120,
        "padding_bottom": 0
      },
      "blocks": {
        "a_0": {
          "type": "eyebrow",
          "settings": {
            "text": "Journal",
            "rule": false,
            "column": "first"
          }
        },
        "a_1": {
          "type": "text",
          "settings": {
            "text": "<p>Notes on sleep, fibre and the making of a bed, written from the atelier on Via Andegari.</p>",
            "style": "body",
            "column": "first"
          }
        },
        "a_2": {
          "type": "rule",
          "settings": {
            "column": "first"
          }
        }
      },
      "block_order": [
        "a_0",
        "a_1",
        "a_2"
      ]
    },
    "main": {
      "type": "main-blog",
      "settings": {
        "layout": "grid",
        "show_image": true,
        "image_height": "large",
        "show_date": false,
        "show_author": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "ms_atelier": {
      "type": "ms-split",
      "name": "Book an appointment",
      "settings": {
        "tone": "dark",
        "text_align": "left",
        "first_width": 50,
        "image_position": "right",
        "image_ratio": "natural",
        "image_caption": "",
        "image_link": "",
        "padding_top": 120,
        "padding_bottom": 120
      },
      "blocks": {
        "a_0": {
          "type": "eyebrow",
          "settings": {
            "text": "The atelier",
            "rule": false,
            "column": "first"
          }
        },
        "a_1": {
          "type": "heading",
          "settings": {
            "text": "Reading is not lying down.",
            "size": "h2",
            "column": "first"
          }
        },
        "b_2": {
          "type": "text",
          "settings": {
            "text": "<p>The systems in these notes can be lain on at Via Andegari 4. Appointments Monday to Friday, confirmed by email within one working day.</p>",
            "style": "body",
            "column": "second"
          }
        },
        "b_btn3": {
          "type": "buttons",
          "settings": {
            "column": "second",
            "label_1": "Book a private appointment",
            "link_1": "/pages/contact",
            "style_1": "primary",
            "panel_1": true,
            "label_2": ""
          }
        }
      },
      "block_order": [
        "a_0",
        "a_1",
        "b_2",
        "b_btn3"
      ]
    }
  },
  "order": [
    "ms_head",
    "main",
    "ms_atelier"
  ]
}
