    "why": {
      "type": "ms-why",
      "settings": {},
      "blocks": {
        "row_01": {
          "type": "row",
          "settings": {
            "label": "Who makes it",
            "ours": "Two artisans, start to finish, in our Milan atelier.",
            "theirs": "A production line, with many hands and no one answerable for the whole."
          }
        },
        "row_02": {
          "type": "row",
          "settings": {
            "label": "What is inside",
            "ours": "Only natural fibres: wool, horsehair, silk, cashmere and linen, laid by hand over pocket springs.",
            "theirs": "Foams, latex and synthetic fillings, glued in layers."
          }
        },
        "row_03": {
          "type": "row",
          "settings": {
            "label": "Through the year",
            "ours": "A winter side and a summer side, turned with the season.",
            "theirs": "One side, all year."
          }
        },
        "row_04": {
          "type": "row",
          "settings": {
            "label": "Size and shape",
            "ours": "Any size, round included, with no tooling charge.",
            "theirs": "A catalogue of standard sizes."
          }
        },
        "row_05": {
          "type": "row",
          "settings": {
            "label": "What it is dressed in",
            "ours": "Loro Piana Interiors fabrics, chosen for the room.",
            "theirs": "The house ticking."
          }
        },
        "row_06": {
          "type": "row",
          "settings": {
            "label": "After fifteen years",
            "ours": "Opened, cleaned and rebuilt by the artisans who made it, for fifteen more.",
            "theirs": "Replaced, and sent to landfill."
          }
        }
      },
      "block_order": [
        "row_01",
        "row_02",
        "row_03",
        "row_04",
        "row_05",
        "row_06"
      ]
    },
    "build": {
      "type": "ms-product-build",
      "settings": {
        "eyebrow": "Inside a Midsummer bed",
        "heading": "[count] layers. Not one of them synthetic.",
        "intro": "This is the Top System, from the topper down to the frame, as the atelier builds it. Move along the drawing to read what each layer does.",
        "padding": "<p><strong>Mattress, winter</strong> Cashmere, baby alpaca, mohair, horsehair and Cheviot wool</p><p><strong>Mattress, summer</strong> Linen, silk, Cheviot wool and horsehair</p><p><strong>Topper, winter</strong> Yak and Cheviot wool</p><p><strong>Topper, summer</strong> Cheviot wool and linen</p>",
        "link_label": "The Icons collection",
        "link_place": "icons"
      },
      "blocks": {
        "layer_01": {
          "type": "layer",
          "settings": {
            "name": "Loro Piana Interiors fabric",
            "group": "Topper",
            "depth": "fine",
            "texture": "cloth",
            "note": "The upholstery, in a Loro Piana Interiors cloth chosen at consultation. It can be changed without touching anything beneath."
          }
        },
        "layer_02": {
          "type": "layer",
          "settings": {
            "name": "Yak",
            "group": "Topper",
            "depth": "fine",
            "texture": "alpaca",
            "note": "Yak down, as warm as cashmere and more resilient, for the winter side."
          }
        },
        "layer_03": {
          "type": "layer",
          "settings": {
            "name": "Cheviot wool",
            "group": "Topper",
            "depth": "light",
            "texture": "wool",
            "note": "Cheviot wool, springy and breathing: it carries moisture away and keeps the temperature even."
          }
        },
        "layer_04": {
          "type": "layer",
          "settings": {
            "name": "Wool felt",
            "group": "Topper",
            "depth": "fine",
            "texture": "felt",
            "note": "A wool felt that keeps the padding apart from the springs, so neither wears the other."
          }
        },
        "layer_05": {
          "type": "layer",
          "settings": {
            "name": "Micro springs",
            "group": "Topper",
            "depth": "light",
            "texture": "micro",
            "note": "A fine layer of micro springs that reads the body at a smaller scale, so the surface feels continuous."
          }
        },
