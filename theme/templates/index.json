    "ms_house": {
      "type": "ms-split",
      "name": "The house",
      "settings": {
        "tone": "ivory",
        "text_align": "left",
        "first_width": 50,
        "image_position": "right",
        "image_ratio": "natural",
        "image_caption": "",
