        "numeral": "05",
        "eyebrow": "Made to last · 15 + 15",
        "heading": "Fifteen years. Then fifteen more.",
        "text": "At fifteen years your mattress comes back to the artisans who made it. They open it, wash and re-card the fibres, renew what the years have worn and close it again, for fifteen more.",
        "link_label": "The 15 + 15 service",
        "link_place": "regen"
      }
