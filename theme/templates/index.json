          "settings": {
            "name": "Cheviot wool",
            "group": "Topper",
            "depth": "light",
            "texture": "wool",
            "note": "Cheviot wool, springy and breathing: it carries moisture away and keeps the temperature even."
          }
        },
        "layer_04": {
