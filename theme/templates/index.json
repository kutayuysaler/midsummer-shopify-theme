        "image_fallback": "ms-photo-seamstress-portrait.jpg",
        "numeral": "01",
        "eyebrow": "Handmade in Milan",
        "heading": "Two artisans. One bed.",
        "text": "No production line. The same two hands open the spring core and sew the final seam, in our atelier on Via Andegari. That is why a change of size, height or fabric is a decision, never an exception.",
        "stat1_value": "2",
        "stat1_label": "Artisans build each system, start to finish",
        "stat2_value": "24",
        "stat2_label": "Systems across three collections",
        "stat3_value": "100%",
        "stat3_label": "Natural fibres, nothing synthetic",
        "link_label": "Handmade in Italy",
        "link_place": "handmade"
      }
    },
    "build": {
      "type": "ms-craft",
      "settings": {
        "eyebrow": "02 · Inside a Midsummer bed"
      }
    },
    "ch3": {
      "type": "ms-hp-chapter",
      "settings": {
        "layout": "split",
        "side": "right",
        "tone": "sand",
        "image_fallback": "ms-photo-teal-throw.jpg",
        "numeral": "03",
        "eyebrow": "Natural fibres · Loro Piana Interiors",
        "heading": "Only what nature makes. Dressed in Loro Piana Interiors.",
        "text": "Wool, cashmere, silk, horsehair, linen and Ingeo, chosen because they breathe, last and age well, are laid by hand where each does its work. Every Signature and Icons system is then upholstered in Loro Piana Interiors, the cloth chosen for the room.",
        "link_label": "Natural materials",
        "link_place": "materials"
      }
    },
    "why": {
      "type": "ms-why",
      "settings": {
        "eyebrow": "04 · Why Midsummer"
      },
      "blocks": {
        "row_01": {
          "type": "row",
          "settings": {
            "label": "Who makes it",
            "ours": "Two artisans, start to finish, in our Milan atelier.",
            "theirs": "A production line, with many hands and no one answerable for the whole."
          }
        },
        "row_02": {
          "type": "row",
          "settings": {
            "label": "What is inside",
            "ours": "Only natural fibres: wool, horsehair, silk, cashmere and linen, laid by hand.",
            "theirs": "Foams, latex and synthetic fillings, glued in layers."
          }
        },
        "row_03": {
          "type": "row",
          "settings": {
            "label": "Through the year",
            "ours": "A winter side and a summer side, turned with the season.",
            "theirs": "One side, all year."
          }
        },
        "row_04": {
          "type": "row",
          "settings": {
            "label": "Size and shape",
            "ours": "Any size, round included, with no tooling charge.",
            "theirs": "A catalogue of standard sizes."
          }
        },
        "row_05": {
          "type": "row",
          "settings": {
            "label": "What it is dressed in",
            "ours": "Loro Piana Interiors fabrics, chosen for the room.",
            "theirs": "The house ticking."
          }
        },
        "row_06": {
          "type": "row",
          "settings": {
            "label": "After fifteen years",
            "ours": "Opened, cleaned and rebuilt by the artisans who made it, for fifteen more.",
            "theirs": "Replaced, and sent to landfill."
          }
        }
      },
      "block_order": [
