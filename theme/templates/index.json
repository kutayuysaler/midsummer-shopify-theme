        "eyebrow": "II · Inside a Midsummer bed",
        "heading": "[count] layers. Not one of them synthetic.",
        "intro": "The Top System, from the topper down to the frame, as the atelier builds it. Move along the drawing to read what each layer does.",
        "padding": "<p><strong>Mattress, winter</strong> Cashmere, baby alpaca, mohair, horsehair and Cheviot wool</p><p><strong>Mattress, summer</strong> Linen, silk, Cheviot wool and horsehair</p><p><strong>Topper, winter</strong> Yak and Cheviot wool</p><p><strong>Topper, summer</strong> Cheviot wool and linen</p>",
        "link_label": "The Icons collection",
        "link_place": "icons"
      },
      "blocks": {
        "layer_01": {
          "type": "layer",
          "settings": {
            "name": "Loro Piana Interiors fabric",
            "group": "Topper",
            "depth": "fine",
            "texture": "cloth",
            "note": "The upholstery, in a Loro Piana Interiors cloth chosen at consultation. It can be changed without touching anything beneath."
          }
        },
        "layer_02": {
          "type": "layer",
          "settings": {
            "name": "Yak",
            "group": "Topper",
            "depth": "fine",
            "texture": "alpaca",
            "note": "Yak down, as warm as cashmere and more resilient, for the winter side."
          }
        },
