      "settings": {
        "eyebrow": "The making",
        "heading": "Five stages, all by hand.",
        "text": "<p>The order in which a Midsummer bed comes together, from the springs up.</p>",
        "ground": "#FBF9F5"
      },
      "blocks": {
        "step_01": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-graded-ochre-room.jpg",
            "title": "The springs",
            "text": "<p>The pocketed spring core is assembled by hand, row by row, so each spring can move on its own.</p>"
          }
        },
        "step_02": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Paisleydettaglio.jpg",
            "image_fallback": "https://midsummer-milano.com/cdn/shop/files/Paisleydettaglio.jpg?width=1400",
            "title": "The fibres",
            "text": "<p>Wool, horsehair, cashmere and silk are opened, carded and laid in layers by hand, each where it does its work.</p>"
          }
        },
        "step_03": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-graded-arches.jpg",
            "title": "The tufting",
            "text": "<p>The layers are tufted through by hand so they keep their place for decades, not seasons.</p>"
          }
        },
        "step_04": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-graded-paisley-red.jpg",
            "title": "The border",
            "text": "<p>The sides are stitched by hand, which gives the edge its shape and lets it carry weight without sagging.</p>"
          }
        },
        "step_05": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-graded-bougainvillea.jpg",
            "title": "The cloth",
            "text": "<p>Upholstered in Loro Piana Interiors fabrics, chosen for the room at consultation, and turned with the seasons.</p>"
          }
        }
