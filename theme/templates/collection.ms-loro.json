    "s04": {
      "type": "ms-statement",
      "settings": {
        "tone": "stone",
        "eyebrow": "Seasonal upholstery",
        "heading": "Dressed for both seasons.",
        "text": "<p>On Flora and Top, wool and cashmere dress the winter face and linen the summer face, so the bed is turned when the season changes, not replaced.</p>"
      }
    },
