      "settings": {
        "image_fallback": "ms-photo-paisley-throw.jpg",
        "eyebrow": "Upholstery",
        "use_page_title": false,
        "heading": "Loro Piana Interiors",
        "height": "tall",
        "text": "The cloths our systems are made in, colour by colour."
      }
    },
    "s02": {
      "type": "ms-statement",
      "settings": {
        "eyebrow": "Loro Piana Interiors",
        "use_content": false,
        "heading": "Where a system calls for it, we make it in Loro Piana Interiors: linen for summer, wool and cashmere for winter.",
        "text": "<p>Mystic River, Connemara, Altai, Wish, Cardi, Ely’s Harbour, Bangor and Shadan: each chosen for the system it dresses, each in its own colours. The others are covered in natural linen and cotton.</p>"
      }
    },
    "s03": {
      "type": "ms-lp-fabrics",
      "settings": {
        "eyebrow": "The cloths",
        "heading": "The cloths our systems are made in.",
        "text": "<p>Every cloth here is on one of our systems, with the colours we make it in. Choose a colour to see it larger, and ask for it: the atelier on Via Andegari holds the cards, and sends samples by post.</p>",
        "footnote": "Colours on screen are indicative: the Mystic River colours are photographed, the others taken from the Loro Piana Interiors cards at the atelier. Other Loro Piana Interiors cloths, and your own, on request."
      },
