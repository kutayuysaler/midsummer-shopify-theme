    "s04": {
      "type": "ms-statement",
      "settings": {
        "tone": "stone",
        "eyebrow": "Seasonal upholstery",
        "heading": "Dressed twice a year, without anything being replaced.",
        "text": "<p>Loro Piana Interiors on one face, linen and silk on the other. The upholstery is turned when the season changes, so the same bed is dressed for winter and for summer.</p>"
      }
    },
