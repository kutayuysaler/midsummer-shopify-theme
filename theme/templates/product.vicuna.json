    "s03": {
      "type": "ms-craft",
      "settings": {
        "link_label": "The fibres inside",
        "link_place": "materials",
        "text": "[name] is the mattress alone, the heart of the bed. A topper and a Midsummer boxspring complete it, and are shown here in outline.",
        "fibres_label": "Its fibres",
        "part1_lead": "A vicuña topper on request: vicuña, silk and wool.",
        "part1_text": "A vicuña topper on request: vicuña, silk and wool.",
        "part1_points": "To bring the same fibre to the surface of the bed.",
        "part1_fibres": "Vicuña, Silk, Wool",
        "part2_lead": "Vicuña, cashmere, Falkland wool and horsehair for winter; linen, silk, Ingeo, Falkland wool and horsehair for summer.",
        "part2_text": "Vicuña, cashmere, Falkland wool and horsehair for winter; linen, silk, Ingeo, Falkland wool and horsehair for summer.",
        "part2_points": "Vicuña is finer than the finest cashmere, from a small wild camelid of the Andes.\nCovered in raw linen and cotton, edged with a vicuña-coloured ribbon and tufted by hand; or in a Loro Piana Interiors linen.",
        "part2_fibres": "Vicuña, Cashmere, Falkland Wool, Horsehair, Silk, Linen, Ingeo",
        "part3_lead": "Not part of [name]: it rests on a Midsummer boxspring.",
        "part3_text": "Not part of [name]: it rests on a Midsummer boxspring.",
        "part3_points": "Made by hand in Italy, to the size of the mattress.\nDressed in natural cloth, with a headboard drawn with you if you wish.",
        "part3_fibres": "Cheviot Wool"
      }
    },
    "s04": {
      "type": "ms-qa",
      "settings": {
        "anchor": "questions",
        "eyebrow": "Questions",
        "heading": "Before you order.",
        "link_label": "All questions",
        "link_place": "faq"
      },
      "blocks": {
        "qa_01": {
          "type": "qa",
          "settings": {
            "q": "What is [product] made of?",
            "a": "<p>[product] is made by hand in Italy from natural fibres: vicuña, cashmere, Falkland wool, horsehair, silk, linen and Ingeo. It is covered in raw linen and cotton, or in a Loro Piana Interiors cloth chosen with you. It is made to order, by hand, one at a time.</p>"
          }
        },
        "qa_03": {
          "type": "qa",
          "settings": {
            "q": "How is the comfort chosen?",
            "a": "<p>It depends on how you sleep. On your side, hips and shoulders need to sink a little; on your back, the lumbar curve needs support; on your front, a flatter, firmer surface keeps the neck neutral. The five questions of Find your Midsummer suggest a system, and the comfort is then set with you, at the atelier or by video.</p>"
          }
        },
        "qa_04": {
          "type": "qa",
          "settings": {
            "q": "Can I try [product] before ordering?",
            "a": "<p>[product] is not on display at our atelier in Milano. Write to us and we will direct you to the nearest of our resellers who may have it on display. We can also take you through it by video.</p>"
          }
        },
        "qa_05": {
          "type": "qa",
          "settings": {
            "q": "How long does it take to make?",
            "a": "<p>Production and delivery windows are confirmed on enquiry, because each system is made to order. Delivery is white-glove: the bed is brought into the room, assembled and dressed by our own team.</p>"
          }
        },
        "qa_06": {
          "type": "qa",
          "settings": {
            "q": "Why is the price on request?",
            "when_hidden": true,
            "a": "<p>Because every system is made to order, and the price follows the specification: dimensions, height, fibres, fabric and comfort level. We quote after the consultation.</p>"
          }
        }
      },
