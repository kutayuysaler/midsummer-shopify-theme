/*
 * ------------------------------------------------------------
 * Midsummer Milano — customised for the Atelier theme.
 * Generated from the approved UX preview. Safe to replace the
 * matching file in the theme export before upload.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "section": {
      "type": "main-blog-post",
      "blocks": {
        "blog-post-eyebrow": {
          "type": "text",
          "name": "Category",
          "settings": {
            "text": "<p>{{ article.tags.first }}</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h6",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "uppercase",
            "wrap": "pretty",
            "text_color": "{{ settings.color_palette.color1 }}",
            "background": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-title": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ article.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h1",
            "line_height": "tight",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "padding-block-start": 16,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-details": {
          "type": "_blog-post-info-text",
          "name": "t:names.details",
          "settings": {
            "show_date": true,
            "show_author": false,
            "alignment": "left",
            "show_alignment": true,
            "padding-block-start": 18,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "blog-post-image": {
          "type": "image",
          "name": "t:names.featured_image",
          "settings": {
            "image": "{{ article.image }}",
            "image_ratio": "adapt",
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 48,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-content": {
          "type": "_blog-post-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "blog-post-eyebrow",
        "blog-post-title",
        "blog-post-details",
        "blog-post-image",
        "blog-post-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 96,
        "padding-block-end": 96
      }
    },
    "ms_back": {
      "type": "section",
      "name": "Journal footer",
      "blocks": {
        "rule": {
          "type": "_divider",
          "name": "t:names.divider",
          "settings": {
            "thickness": 1,
            "divider_color": "{{ settings.color_palette.color2 }}",
            "corner_radius": "square",
            "width_percent": 100,
            "padding-block-start": 0,
            "padding-block-end": 26
          },
          "blocks": {}
        },
        "row": {
          "type": "group",
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "center",
            "align_baseline": false,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "flex-start",
            "gap": 24,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "toggle_overlay": false,
            "overlay_color": "#00000026",
            "overlay_style": "solid",
            "gradient_direction": "to top",
            "open_in_new_tab": false,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "back": {
              "type": "button",
              "settings": {
                "label": "All notes",
                "link": "/blogs/news",
                "open_in_new_tab": false,
                "style_class": "button-unstyled",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            },
            "enquire": {
              "type": "button",
              "settings": {
                "label": "Book a private appointment",
                "link": "/pages/contact",
                "open_in_new_tab": false,
                "style_class": "button-secondary",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            }
          },
          "block_order": [
            "back",
            "enquire"
          ]
        }
      },
      "block_order": [
        "rule",
        "row"
      ],
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "flex-start",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "flex-start",
        "vertical_alignment_flex_direction_column": "flex-start",
        "gap": 0,
        "section_width": "page-width",
        "section_height_custom": 50,
        "background_media": "none",
        "background_color": "{{ settings.color_palette.background }}",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 0,
        "padding-block-end": 96
      }
    }
  },
  "order": [
    "section",
    "ms_back"
  ]
}
