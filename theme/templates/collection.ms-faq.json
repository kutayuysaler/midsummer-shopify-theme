        "eyebrow": "Care",
        "heading": "Looking after a natural bed.",
        "text": "A Midsummer system is made to last thirty years. A few habits keep it as it was made.",
        "note": "At fifteen years, the artisans who made it take it back for fifteen more."
      },
      "blocks": {
        "point_01": {
          "type": "point",
          "settings": {
            "title": "Turn it",
            "text": "Head to foot every three months in the first year, then twice a year."
          }
        },
        "point_02": {
          "type": "point",
          "settings": {
            "title": "With the season",
            "text": "Where the system has a winter and a summer side, turn it when the season changes."
          }
        },
        "point_03": {
          "type": "point",
          "settings": {
            "title": "Let it breathe",
            "text": "Air the bed whenever you change the linen. Natural fibres give back what they take in."
          }
        },
        "point_04": {
          "type": "point",
          "settings": {
            "title": "The cloth",
            "text": "Loro Piana Interiors upholstery is dry-cleaned by a specialist only; the atelier can arrange it."
          }
        }
      },
