            "text": "Handmade Italian beds, mattresses and toppers.",
            "size": "h1",
            "column": "first"
          }
        },
        "a_2": {
          "type": "text",
          "settings": {
            "text": "<p>Twenty-four systems in three collections. What changes between them is the fabric, the depth of the spring architecture and how far the bespoke can go. What never changes is that two artisans build the whole thing by hand.</p>",
            "style": "body",
            "column": "first"
          }
        }
      },
      "block_order": [
        "a_0",
        "a_1",
        "a_2"
      ]
