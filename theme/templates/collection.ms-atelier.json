        "heading": "The Milano atelier",
        "height": "tall",
        "text": "Where the beds can be lain on. By appointment, Monday to Friday."
      }
    },
    "s02": {
      "type": "ms-statement",
      "settings": {
        "eyebrow": "Visiting",
        "use_content": false,
        "heading": "Lie on the systems, touch the fibres, and leave with a proposal drawn for your room.",
        "text": "<p>The atelier is at Via Andegari 4, 20121 Milano, a few steps from La Scala. It opens by appointment, Monday to Friday, 09:00–12:00 and 13:00–18:00, and every appointment is confirmed by email within one working day.</p><p>Wherever you are, the same conversation can happen by video: we send the fibres and the cloths ahead, and specify the system with you on screen.</p>"
      }
    },
    "s03": {
      "type": "ms-process",
      "settings": {
        "eyebrow": "Your visit",
        "heading": "Four steps, at your pace.",
        "ground": "#F4EFE5"
      },
      "blocks": {
        "step_01": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-photo-atelier-blue-gold.jpg",
            "title": "Book",
            "text": "<p>Choose a morning or an afternoon, at the atelier or by video. A person replies within one working day.</p>"
          }
        },
        "step_02": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-photo-atelier-pure.jpg",
            "title": "Lie down",
            "text": "<p>Essentials, Signature and Icons, made up as they would be at home. Take your time on each.</p>"
          }
        },
        "step_03": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-photo-fabric-weave.jpg",
            "title": "Touch",
            "text": "<p>The natural fibres before they are laid, and the Loro Piana Interiors cloths against the bed.</p>"
          }
        },
        "step_04": {
          "type": "step",
          "settings": {
            "image_fallback": "ms-photo-atelier-orange-bed.jpg",
            "title": "Specify",
            "text": "<p>Size, firmness, fibres and cloth, written down with you. The proposal follows, drawn for your room.</p>"
          }
        }
      },
      "block_order": [
        "step_01",
        "step_02",
        "step_03",
        "step_04"
      ]
    },
