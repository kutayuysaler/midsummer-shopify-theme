    "s05": {
      "type": "ms-qa",
      "settings": {
        "eyebrow": "Before you come",
        "heading": "Visiting the atelier.",
        "link_label": "Book a private appointment",
        "link_place": "enquire"
      },
      "blocks": {
        "qa_01": {
          "type": "qa",
          "settings": {
            "q": "Do I need an appointment?",
            "a": "<p>Yes. The atelier receives by appointment, Monday to Friday, 09:00–12:00 and 13:00–18:00, so that each visit has the rooms and the artisans’ attention to itself.</p>"
          }
        },
        "qa_02": {
          "type": "qa",
          "settings": {
            "q": "Can we meet by video instead?",
            "a": "<p>Yes. We send the fibres and cloth samples ahead and specify the system with you on screen, wherever you are.</p>"
          }
        },
        "qa_03": {
          "type": "qa",
          "settings": {
            "q": "What should I bring?",
            "a": "<p>The measurements of the room and of the bed you have in mind, a few photographs, and any fabric or colour references. Architects are welcome to bring drawings.</p>"
          }
        },
        "qa_04": {
          "type": "qa",
          "settings": {
            "q": "Can I see the Loro Piana Interiors fabrics?",
            "a": "<p>Yes. The range is at the atelier, to be chosen against the bed itself.</p>"
          }
        },
        "qa_05": {
          "type": "qa",
          "settings": {
            "q": "Is there somewhere nearer to me?",
            "a": "<p>Midsummer beds can also be seen at showrooms, agents and resellers in Europe, the Americas and Asia. See Agents &amp; Resellers for the map.</p>"
          }
        }
      },
