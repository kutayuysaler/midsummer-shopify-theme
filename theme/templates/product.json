    "ms_build": {
      "type": "ms-build",
      "name": "The build, in section",
      "blocks": {
        "layer_1": {
          "type": "layer",
          "settings": {
            "name": "Seasonal upholstery",
            "depth": "1",
            "group": "Topper",
            "note": "Loro Piana Interiors on one face, linen and silk on the other. Turned when the season changes, so the bed is dressed twice a year without anything being replaced."
          }
        },
        "layer_2": {
          "type": "layer",
          "settings": {
            "name": "Baby alpaca and silk",
            "depth": "5",
            "group": "Topper",
            "note": "The topper proper. Carded and laid by hand, it is the layer the body meets first and the one that is renewed most often."
          }
        },
        "layer_3": {
          "type": "layer",
          "settings": {
            "name": "Cashmere and mohair",
            "depth": "4",
            "group": "Mattress",
            "note": "Above the springs, where body heat reaches it first. Warmth without weight — the quality clients describe as the bed disappearing."
          }
        },
        "layer_4": {
          "type": "layer",
          "settings": {
            "name": "Micro springs",
            "depth": "3",
            "group": "Mattress",
            "note": "A fine spring layer laid over the pocket core. It reads the body at a smaller scale than the core beneath can, which is what makes the surface feel continuous."
          }
        },
        "layer_5": {
          "type": "layer",
          "settings": {
            "name": "Pocket spring core",
            "depth": "11",
            "group": "Mattress",
            "note": "The architecture of the mattress. In an Icons system this is built over six layers of springs, each pocket sewn so it can work independently of its neighbour."
          }
        },
        "layer_6": {
          "type": "layer",
          "settings": {
            "name": "Horsehair and Cheviot wool",
            "depth": "6",
            "group": "Mattress",
            "note": "Beneath the core, horsehair for resilience and Cheviot wool for temperature. Both can be opened, washed and laid again at the fifteen-year regeneration."
          }
        },
        "layer_7": {
          "type": "layer",
          "settings": {
            "name": "Boxspring",
            "depth": "18",
            "group": "Base",
            "note": "A slender fir-wood frame that defines the geometry of the bed. Built to your height, and in sections where a staircase requires it."
          }
        }
      },
      "block_order": [
        "layer_1",
        "layer_2",
        "layer_3",
        "layer_4",
        "layer_5",
        "layer_6",
        "layer_7"
      ],
      "settings": {
