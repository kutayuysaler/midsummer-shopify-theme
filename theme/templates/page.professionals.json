      },
      "blocks": {
        "qa_01": {
          "type": "qa",
          "settings": {
            "q": "Do you work from our drawings?",
            "a": "<p>Yes. Dimensions, heights and radii, round beds included, are worked to your drawing.</p>"
          }
        },
        "qa_02": {
          "type": "qa",
          "settings": {
            "q": "Can we specify our own fabric?",
            "a": "<p>Yes. The full Loro Piana Interiors palette is available, and your own cloth (COM) on request.</p>"
          }
        },
        "qa_03": {
          "type": "qa",
          "settings": {
            "q": "What do you send for a specification?",
            "a": "<p>Drawings, sections and material schedules for your set, fabric references from Loro Piana Interiors and samples of the natural fibres.</p>"
          }
        },
        "qa_04": {
          "type": "qa",
          "settings": {
            "q": "Who follows the project?",
            "a": "<p>One person at the atelier, from the first specification to delivery and installation.</p>"
          }
        },
        "qa_05": {
          "type": "qa",
          "settings": {
            "q": "Where can our clients see the beds?",
            "a": "<p>At the atelier in Milan, by appointment, or at our agents and resellers in Europe, the Americas and Asia.</p>"
          }
        }
      },
      "block_order": [
        "qa_01",
        "qa_02",
        "qa_03",
        "qa_04",
        "qa_05"
