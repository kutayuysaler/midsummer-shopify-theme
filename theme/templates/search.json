/*
 * Midsummer Milano — built on the live Dawn theme.
 * Design sections: ms-hero, ms-split, ms-cards and the ms-* specialist sections.
 */
{
  "sections": {
    "main": {
      "type": "main-search",
      "settings": {
        "columns_desktop": 4,
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "enable_filtering": true,
        "filter_type": "horizontal",
        "enable_sorting": true,
        "article_show_date": true,
        "article_show_author": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "ms_atelier": {
      "type": "ms-split",
      "name": "Book an appointment",
      "settings": {
        "tone": "dark",
        "text_align": "left",
        "first_width": 50,
        "image_position": "right",
        "image_ratio": "natural",
        "image_caption": "",
        "image_link": "",
        "padding_top": 120,
        "padding_bottom": 120
      },
      "blocks": {
        "a_0": {
          "type": "eyebrow",
          "settings": {
            "text": "The atelier",
            "rule": false,
            "column": "first"
          }
        },
        "a_1": {
          "type": "heading",
          "settings": {
            "text": "Tell us instead.",
            "size": "h2",
            "column": "first"
          }
        },
        "b_2": {
          "type": "text",
          "settings": {
            "text": "<p>If it is a dimension, a fibre or a fabric you cannot find here, the atelier will answer directly.</p>",
            "style": "body",
            "column": "second"
          }
        },
        "b_btn3": {
          "type": "buttons",
          "settings": {
            "column": "second",
            "label_1": "Book a private appointment",
            "link_1": "/pages/contact",
            "style_1": "primary",
            "panel_1": true,
            "label_2": ""
          }
        }
      },
      "block_order": [
        "a_0",
        "a_1",
        "b_2",
        "b_btn3"
      ]
    }
  },
  "order": [
    "main",
    "ms_atelier"
  ]
}
