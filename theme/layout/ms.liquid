<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {%- render 'meta-tags' -%}
    {%- comment -%} site verification (Theme settings → Midsummer · Cookies and search): the code, or the whole tag pasted {%- endcomment -%}
    {%- assign vpairs = 'google-site-verification:ms_verify_google,msvalidate.01:ms_verify_bing,p:domain_verify:ms_verify_pinterest' | split: ',' -%}
    {%- for pair in vpairs -%}
      {%- assign kv = pair | split: ':ms_' -%}{%- assign sk = 'ms_' | append: kv[1] -%}{%- assign code = settings[sk] | strip -%}
      {%- if code contains 'content=' -%}{%- assign code = code | split: 'content=' | last | remove: '"' | remove: "'" | split: ' ' | first | remove: '/>' | remove: '>' -%}{%- endif -%}
      {%- if code != blank -%}<meta name="{{ kv[0] }}" content="{{ code | escape }}">{%- endif -%}
    {%- endfor -%}
    <link rel="preload" href="{{ 'ms-newsreader-4.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'ms-red-hat-text-6.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    {%- render 'ms-fonts' -%}
    {{ 'ms-site.css' | asset_url | stylesheet_tag }}
    {%- render 'ms-photo-tone' -%}
    {%- render 'ms-on-white' -%}
    <script src="{{ 'ms-site.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  {%- liquid
    assign ms_overlay = false
    if template.name == 'index' or template.name == 'collection'
      assign ms_overlay = true
    endif
    assign ms_sfx = template.suffix | slice: 0, 3
    if ms_sfx == 'ms-'
      assign ms_overlay = false
    endif
  -%}
  <body class="ms-site{% if ms_overlay %} ms-overlay{% endif %}" data-template="{{ template.name }}" data-view="{{ template.suffix }}">
    <a class="ms-visually-hidden" href="#MainContent">Skip to content</a>
    <div id="ms-header-wrap">
      {% sections 'header-group' %}
    </div>
    <main id="MainContent" role="main">
      <div aria-hidden="true" data-ms-sentinel style="width: 100%; height: 1px;"></div>
      {{ content_for_layout }}
      {%- if template.name == 'product' and product != blank -%}
        {%- assign ms_body = content_for_layout | strip_html | strip -%}
        {%- if ms_body == blank -%}{%- render 'ms-product-fallback' -%}{%- endif -%}
      {%- endif -%}
    </main>
    {% sections 'footer-group' %}
    {% section 'ms-enquiry-drawer' %}
    {% section 'ms-quiz-dialog' %}
    {% section 'ms-seo' %}
    {% section 'ms-tracking' %}
    {% render 'ms-whatsapp' %}
  </body>
</html>
