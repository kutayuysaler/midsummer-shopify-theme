    "kcd176ae152141f65_html": "Drawn to your room, not to a catalogue.",
    "k62d68e21f058cd52_html": "Dreamy in Mystic River; Brera in Connemara, edged in Altai.",
    "k17b0db459b1a2eb8_html": "Dressed for both seasons.",
    "k5879fe969b2191d0_html": "Dressed for your room.",
