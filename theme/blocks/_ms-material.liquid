{%- comment -%}
  Midsummer Milano — one fibre in the "Precious materials" row.
  Child of blocks/ms-materials.liquid.
{%- endcomment -%}

<li class="ms-materials__item" {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
  {%- if block.settings.icon != blank -%}
    <span class="ms-materials__icon">
      {{
        block.settings.icon
        | image_url: width: 160
        | image_tag: loading: 'lazy', alt: block.settings.label, class: 'ms-materials__img'
      }}
    </span>
  {%- elsif request.design_mode -%}
    {%- comment -%} The empty square only shows in the theme editor, as a prompt to pick the icon. {%- endcomment -%}
    <span class="ms-materials__icon">
      <span class="ms-materials__placeholder" aria-hidden="true"></span>
    </span>
  {%- endif -%}
  <span class="ms-materials__label">{{ block.settings.label }}</span>
  {%- if block.settings.link != blank -%}</a>{%- endif -%}
</li>

{% schema %}
{
  "name": "Material",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon",
      "info": "Line drawing on a transparent background, about 120px tall."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Name",
      "default": "Baby Alpaca"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Material"
    }
  ]
}
{% endschema %}
