{%- comment -%}
  The Loro Piana Interiors palette as a fabric book: every cloth as a photographed square, sorted by
  weave and by tone, with one large specimen that follows the visitor's choice. Ask about a cloth and
  the enquiry opens with its name already written.
{%- endcomment -%}
{%- liquid
  assign total = section.blocks.size
  assign n_plain = 0
  assign n_woven = 0
  assign n_named = 0
  for b in section.blocks
    case b.settings.family
      when 'woven'
        assign n_woven = n_woven | plus: 1
      when 'named'
        assign n_named = n_named | plus: 1
      else
        assign n_plain = n_plain | plus: 1
    endcase
  endfor
  assign first = section.blocks.first
-%}
<section class="ms-sw" id="palette" data-ms-sw>
  <div class="ms-sw__in">
    <div class="ms-sw__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="ms-sw__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-sw__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.text != blank -%}<div class="ms-sw__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    {%- if total > 0 -%}
    <div class="ms-sw__bar">
      <div class="ms-sw__filters" role="group" aria-label="{{ section.settings.weave_label | escape }}">
        <button type="button" class="ms-sw__f is-on" data-f-fam="all" aria-pressed="true">{{ section.settings.all_label }} <sup>{{ total }}</sup></button>
        {%- if n_plain > 0 -%}<button type="button" class="ms-sw__f" data-f-fam="plain" aria-pressed="false">{{ section.settings.plain_label }} <sup>{{ n_plain }}</sup></button>{%- endif -%}
        {%- if n_woven > 0 -%}<button type="button" class="ms-sw__f" data-f-fam="woven" aria-pressed="false">{{ section.settings.woven_label }} <sup>{{ n_woven }}</sup></button>{%- endif -%}
        {%- if n_named > 0 -%}<button type="button" class="ms-sw__f" data-f-fam="named" aria-pressed="false">{{ section.settings.named_label }} <sup>{{ n_named }}</sup></button>{%- endif -%}
      </div>
      <div class="ms-sw__tones" role="group" aria-label="{{ section.settings.tone_label | escape }}">
        <span class="ms-sw__tl">{{ section.settings.tone_label }}</span>
        {%- assign tones = 'neutral,earth,green,red,blue' | split: ',' -%}
        {%- assign tone_names = 'Neutrals,Earth,Greens,Reds,Blues & greys' | split: ',' -%}
        {%- assign tone_dots = '#D9CDBE,#9A6E4C,#5E6B4F,#8E2A23,#2E3A55' | split: ',' -%}
        {%- for t in tones -%}
          {%- assign has = false -%}
          {%- for b in section.blocks -%}{%- if b.settings.tone == t -%}{%- assign has = true -%}{%- endif -%}{%- endfor -%}
          {%- if has -%}
            <button type="button" class="ms-sw__t" data-f-tone="{{ t }}" aria-pressed="false" title="{{ tone_names[forloop.index0] }}"><i style="background: {{ tone_dots[forloop.index0] }}"></i><span>{{ tone_names[forloop.index0] }}</span></button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="ms-sw__book">
      <figure class="ms-sw__view" aria-live="polite">
        <div class="ms-sw__big" data-sw-big style="background-color: {{ first.settings.color }};{% if first.settings.image != blank %} background-image: url({{ first.settings.image | image_url: width: 900 }});{% elsif first.settings.image_fallback != blank %} background-image: url({{ first.settings.image_fallback | asset_url }});{% endif %}"></div>
        <figcaption class="ms-sw__cap">
          <span class="ms-sw__no" data-sw-no>No. 01</span>
          <span class="ms-sw__bigname" data-sw-name>{{ first.settings.name }}</span>
          <span class="ms-sw__meta" data-sw-meta></span>
          {%- if section.settings.ask_label != blank -%}
            <a class="ms-sw__ask" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-cta="palette-cloth" data-sw-ask data-ms-note="{{ section.settings.ask_note | replace: '[cloth]', first.settings.name | escape }}">{{ section.settings.ask_label }}</a>
          {%- endif -%}
        </figcaption>
      </figure>

      <ul class="ms-sw__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign fam = block.settings.family | default: 'plain'
            case fam
              when 'woven'
                assign fam_name = section.settings.woven_label
              when 'named'
                assign fam_name = section.settings.named_label
              else
                assign fam_name = section.settings.plain_label
            endcase
            assign tone_name = ''
            for t in tones
              if t == block.settings.tone
                assign tone_name = tone_names[forloop.index0]
              endif
            endfor
            if block.settings.image != blank
              assign img = block.settings.image | image_url: width: 900
              assign thumb = block.settings.image | image_url: width: 300
            elsif block.settings.image_fallback != blank
              assign img = block.settings.image_fallback | asset_url
              assign thumb = img
            else
              assign img = ''
              assign thumb = ''
            endif
          -%}
          <li class="ms-sw__item" data-fam="{{ fam }}" data-tone="{{ block.settings.tone }}" {{ block.shopify_attributes }}>
            <button type="button" class="ms-sw__chip{% if forloop.first %} is-sel{% endif %}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-no="{{ forloop.index | prepend: '0' | slice: -2, 2 }}" data-name="{{ block.settings.name | escape }}" data-meta="{{ fam_name | escape }}{% if tone_name != '' %} · {{ tone_name | escape }}{% endif %}{% if block.settings.note != blank %} · {{ block.settings.note | escape }}{% endif %}"
              data-img="{{ img }}" data-color="{{ block.settings.color }}"
              style="background-color: {{ block.settings.color }};{% if thumb != '' %} background-image: url({{ thumb }});{% endif %}">
              <span class="ms-sw__name">{{ block.settings.name }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <p class="ms-sw__empty" data-sw-empty hidden>{{ section.settings.empty_label }}</p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}<p class="ms-sw__foot">{{ section.settings.footnote }}</p>{%- endif -%}
  </div>
</section>
<style>
  .ms-sw { background: #F4EFE5; padding: clamp(72px, 10vw, 160px) clamp(16px, 5vw, 80px); }
  .ms-sw__in { max-width: 1560px; margin: 0 auto; }
  .ms-sw__head { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: clamp(24px, 5vw, 96px); align-items: end; }
  .ms-sw__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-sw__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.6vw, 52px); line-height: 1.08; letter-spacing: -.025em; font-weight: 200; margin-top: 18px; max-width: 18ch; }
  .ms-sw__text { font-size: 15px; line-height: 1.95; color: #4A443B; max-width: 52ch; }
  .ms-sw__text p { margin: 0; }
  .ms-sw__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 18px 32px; margin-top: clamp(40px, 5vw, 64px); padding: 18px 0; border-top: 1px solid rgba(23, 20, 15, .14); border-bottom: 1px solid rgba(23, 20, 15, .14); }
  .ms-sw__filters, .ms-sw__tones { display: flex; flex-wrap: wrap; gap: 6px 8px; align-items: center; }
  .ms-sw__f { font: inherit; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #4A443B; background: none; border: 1px solid rgba(23, 20, 15, .18); padding: 10px 16px; cursor: pointer; transition: background .3s, color .3s, border-color .3s; }
  .ms-sw__f sup { font-size: 9px; letter-spacing: .05em; margin-left: 3px; color: inherit; opacity: .7; }
  .ms-sw__f:hover { border-color: #17140F; }
  .ms-sw__f.is-on { background: #17140F; color: #FBF9F5; border-color: #17140F; }
  .ms-sw__tl { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; margin-right: 6px; }
  .ms-sw__t { display: inline-flex; align-items: center; gap: 8px; font: inherit; font-size: 13px; color: #4A443B; background: none; border: 1px solid transparent; border-radius: 999px; padding: 6px 12px 6px 6px; cursor: pointer; transition: border-color .3s, background .3s; }
  .ms-sw__t i { width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px rgba(23, 20, 15, .15); }
  .ms-sw__t:hover { border-color: rgba(23, 20, 15, .2); }
  .ms-sw__t.is-on { border-color: #17140F; background: #FBF9F5; }
  .ms-sw__book { display: grid; grid-template-columns: minmax(260px, 420px) 1fr; gap: clamp(28px, 4vw, 72px); margin-top: clamp(28px, 4vw, 48px); align-items: start; }
  .ms-sw__view { position: sticky; top: 110px; margin: 0; }
  .ms-sw__big { aspect-ratio: 1; background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgba(23, 20, 15, .1); transition: background-color .5s; image-rendering: auto; }
  .ms-sw__big.is-swap { animation: msSwIn .55s cubic-bezier(.22, 1, .36, 1); }
  @keyframes msSwIn { from { opacity: .35; transform: scale(.985); } to { opacity: 1; transform: none; } }
  .ms-sw__cap { display: grid; grid-template-columns: auto 1fr; gap: 6px 18px; align-items: baseline; padding-top: 18px; }
  .ms-sw__no { font-size: 11px; letter-spacing: .24em; color: #6E675C; }
  .ms-sw__bigname { font-family: Newsreader, Georgia, serif; font-size: clamp(24px, 2.4vw, 34px); letter-spacing: -.015em; font-weight: 300; }
  .ms-sw__meta { grid-column: 2; font-size: 13px; color: #6E675C; }
  .ms-sw__ask { grid-column: 2; justify-self: start; margin-top: 12px; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #17140F; text-decoration: none; border-bottom: 1px solid #17140F; padding-bottom: 6px; }
  .ms-sw__ask:hover { opacity: .65; }
  .ms-sw__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: clamp(10px, 1.2vw, 16px); }
  .ms-sw__item.is-out { display: none; }
  .ms-sw__chip { position: relative; display: block; width: 100%; aspect-ratio: 1; border: 0; padding: 0; cursor: pointer; background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgba(23, 20, 15, .1); transition: transform .45s cubic-bezier(.22, 1, .36, 1), box-shadow .3s; }
  .ms-sw__chip:hover { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgba(23, 20, 15, .1), 0 12px 24px -14px rgba(23, 20, 15, .45); }
  .ms-sw__chip.is-sel { box-shadow: 0 0 0 2px #F4EFE5, 0 0 0 3px #17140F; }
  .ms-sw__chip:focus-visible { outline: 2px solid #17140F; outline-offset: 3px; }
  .ms-sw__name { position: absolute; left: 0; right: 0; bottom: 0; padding: 18px 8px 7px; font-size: 11px; letter-spacing: .06em; text-align: left; color: #FBF9F5; background: linear-gradient(transparent, rgba(23, 20, 15, .55)); opacity: 0; transition: opacity .3s; }
  .ms-sw__chip:hover .ms-sw__name, .ms-sw__chip:focus-visible .ms-sw__name { opacity: 1; }
  .ms-sw__empty { margin-top: 24px; font-family: Newsreader, Georgia, serif; font-style: italic; color: #6E675C; }
  .ms-sw__foot { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; color: #6E675C; margin-top: clamp(28px, 4vw, 48px); }
  @media (max-width: 860px) {
    .ms-sw__filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; width: calc(100% + 32px); }
    .ms-sw__filters::-webkit-scrollbar { display: none; }
    .ms-sw__f { flex: none; padding: 9px 13px; }
    .ms-sw__book { grid-template-columns: 1fr; }
    .ms-sw__view { position: relative; top: 0; display: grid; grid-template-columns: 42% 1fr; gap: 16px; align-items: end; }
    .ms-sw__cap { grid-template-columns: 1fr; padding-top: 0; }
    .ms-sw__meta, .ms-sw__ask { grid-column: 1; }
    .ms-sw__grid { grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; }
    .ms-sw__name { display: none; }
    .ms-sw__t span { display: none; }
    .ms-sw__t { padding: 6px; }
    .ms-sw__tones { gap: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-sw__big.is-swap { animation: none; } .ms-sw__chip { transition: none; } }
</style>
<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling && document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.matches('[data-ms-sw]')) root = document.querySelector('[data-ms-sw]:not([data-sw-ready])');
    if (!root) return;
    root.setAttribute('data-sw-ready', '');
    var big = root.querySelector('[data-sw-big]'), nm = root.querySelector('[data-sw-name]'), no = root.querySelector('[data-sw-no]'),
        meta = root.querySelector('[data-sw-meta]'), ask = root.querySelector('[data-sw-ask]'), empty = root.querySelector('[data-sw-empty]');
    var noteTpl = {{ section.settings.ask_note | json }};
    var items = [].slice.call(root.querySelectorAll('.ms-sw__item'));
    var fam = 'all', tone = null;
    function show(chip) {
      root.querySelectorAll('.ms-sw__chip.is-sel').forEach(function (c) { c.classList.remove('is-sel'); c.setAttribute('aria-pressed', 'false'); });
      chip.classList.add('is-sel'); chip.setAttribute('aria-pressed', 'true');
      big.style.backgroundColor = chip.getAttribute('data-color');
      var img = chip.getAttribute('data-img');
      big.style.backgroundImage = img ? 'url(' + img + ')' : 'none';
      big.classList.remove('is-swap'); void big.offsetWidth; big.classList.add('is-swap');
      nm.textContent = chip.getAttribute('data-name');
      no.textContent = 'No. ' + chip.getAttribute('data-no');
      meta.textContent = chip.getAttribute('data-meta');
      if (ask && noteTpl) ask.setAttribute('data-ms-note', noteTpl.replace('[cloth]', chip.getAttribute('data-name')));
    }
    var first = root.querySelector('.ms-sw__chip');
    if (first) meta.textContent = first.getAttribute('data-meta');
    function apply() {
      var shown = 0, firstShown = null;
      items.forEach(function (li) {
        var ok = (fam === 'all' || li.getAttribute('data-fam') === fam) && (!tone || li.getAttribute('data-tone') === tone);
        li.classList.toggle('is-out', !ok);
        if (ok) { shown++; if (!firstShown) firstShown = li; }
      });
      if (empty) empty.hidden = shown > 0;
      var sel = root.querySelector('.ms-sw__chip.is-sel');
      if (firstShown && (!sel || sel.closest('.is-out'))) show(firstShown.querySelector('.ms-sw__chip'));
    }
    root.addEventListener('click', function (e) {
      var c = e.target.closest('.ms-sw__chip');
      if (c) { show(c); if (window.matchMedia('(max-width: 860px)').matches) { var v = root.querySelector('.ms-sw__view'); if (v.getBoundingClientRect().top < 0) v.scrollIntoView({ behavior: 'smooth', block: 'start' }); } return; }
      var f = e.target.closest('[data-f-fam]');
      if (f) {
        fam = f.getAttribute('data-f-fam');
        root.querySelectorAll('[data-f-fam]').forEach(function (b) { var on = b === f; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        apply(); return;
      }
      var t = e.target.closest('[data-f-tone]');
      if (t) {
        var v = t.getAttribute('data-f-tone');
        tone = tone === v ? null : v;
        root.querySelectorAll('[data-f-tone]').forEach(function (b) { var on = b.getAttribute('data-f-tone') === tone; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        apply();
      }
    });
    root.addEventListener('keydown', function (e) {
      var c = e.target.closest('.ms-sw__chip');
      if (!c || ['ArrowRight', 'ArrowLeft'].indexOf(e.key) < 0) return;
      var vis = [].slice.call(root.querySelectorAll('.ms-sw__item:not(.is-out) .ms-sw__chip'));
      var i = vis.indexOf(c) + (e.key === 'ArrowRight' ? 1 : -1);
      if (vis[i]) { e.preventDefault(); vis[i].focus(); show(vis[i]); }
    });
  })();
</script>
{% schema %}
{
  "name": "Fabric palette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The palette" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Filters" },
    { "type": "text", "id": "all_label", "label": "All", "default": "All cloths" },
    { "type": "text", "id": "plain_label", "label": "Plain cloths", "default": "Plain cloths" },
    { "type": "text", "id": "woven_label", "label": "Textured weaves", "default": "Textured weaves" },
    { "type": "text", "id": "named_label", "label": "Named shades", "default": "Named shades" },
    { "type": "text", "id": "weave_label", "label": "Weave filter label", "default": "Weave" },
    { "type": "text", "id": "tone_label", "label": "Tone filter label", "default": "Tone" },
    { "type": "text", "id": "empty_label", "label": "When nothing matches", "default": "No cloth in this tone and weave. Clear a filter to see more." },
    { "type": "header", "content": "Enquiry" },
    { "type": "text", "id": "ask_label", "label": "Ask button", "default": "Ask about this cloth" },
    { "type": "text", "id": "ask_note", "label": "Message it starts", "info": "[cloth] becomes the cloth's name.", "default": "I would like to see the cloth [cloth] from the Loro Piana Interiors palette." },
    { "type": "text", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "swatch",
      "name": "Cloth",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Colour" },
        { "type": "color", "id": "color", "label": "Colour", "default": "#C9BCA8" },
        { "type": "image_picker", "id": "image", "label": "Photograph of the cloth" },
        { "type": "text", "id": "image_fallback", "label": "Theme photograph (file name)", "info": "Used when no photograph is chosen." },
        { "type": "select", "id": "family", "label": "Weave", "default": "plain", "options": [
          { "value": "plain", "label": "Plain cloth" }, { "value": "woven", "label": "Textured weave" }, { "value": "named", "label": "Named shade" }
        ] },
        { "type": "select", "id": "tone", "label": "Tone", "default": "neutral", "options": [
          { "value": "neutral", "label": "Neutrals" }, { "value": "earth", "label": "Earth" }, { "value": "green", "label": "Greens" }, { "value": "red", "label": "Reds" }, { "value": "blue", "label": "Blues & greys" }
        ] },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [ { "name": "Fabric palette" } ]
}
{% endschema %}
