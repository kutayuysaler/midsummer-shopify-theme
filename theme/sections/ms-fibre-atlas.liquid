{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,facts,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      if ms_key == 'materials'
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
{%- comment -%}
  The fibres, one at a time. On the left, every fibre in our beds, from animals and from plants,
  read by what matters to the sleeper; choose one and it opens beside the list: its plate, in up to
  three views (the fibre at its source, where we have the photograph; under the glass, in its own
  colour, a touch looking closer; where it comes from, on the map),
  what it does, its figures from the house's catalogue, and the beds made with it, from the store's
  own products. On a phone the list opens in place. #fibre-<name> in the address opens that fibre.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign n_rows = section.blocks.size | plus: 1
  assign grp = ''
  for b in section.blocks
    assign g = b.settings.group | default: 'animal'
    if g != grp
      assign n_rows = n_rows | plus: 1
      assign grp = g
    endif
  endfor
  assign qs = 'temperature,support,softness,breathability,hypoallergenic' | split: ','
  assign beds = ''
-%}
{%- paginate collections.all.products by 250 -%}
  {%- for p in collections.all.products -%}
    {%- capture mk -%}{% render 'ms-kind', p: p %}{%- endcapture -%}
    {%- assign mkp = mk | split: '|' -%}
    {%- if mkp[0] == 'system' and mkp[1] != blank -%}
      {%- capture pk -%}{% render 'ms-sys-data', key: mkp[1], part: 'kind' %}{%- endcapture -%}
      {%- assign pimg = '' -%}
      {%- if p.featured_image -%}{%- assign pimg = p.featured_image | image_url: width: 240 -%}{%- endif -%}
      {%- assign beds = beds | append: mkp[1] | append: '>' | append: p.url | append: '>' | append: p.title | append: '>' | append: pimg | append: '>' | append: pk | append: '^' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}
{%- assign beds = beds | split: '^' -%}
<section class="ms-fa" id="{{ s.anchor | default: 'fibres' }}" data-ms-fa>
  <div class="ms-fa__in">
    <div class="ms-fa__head">
      <div>
        {%- if s.eyebrow != blank -%}<div class="ms-fa__eyebrow">{% render 'ms-t', v: s.eyebrow %}</div>{%- endif -%}
        <h2 class="ms-fa__title">{% render 'ms-t', v: s.heading %}</h2>
      </div>
      {%- if s.text != blank -%}<p class="ms-fa__text">{% render 'ms-t', v: s.text %}</p>{%- endif -%}
    </div>

    <div class="ms-fa__grid" style="--fa-rows: {{ n_rows }};">
      <div class="ms-fa__filter" role="group" aria-label="{% capture ms_t_out %}{% render 'ms-t', v: s.filter_label %}{% endcapture %}{{ ms_t_out | escape }}">
        <span class="ms-fa__fl">{% render 'ms-t', v: s.filter_label %}</span>
        <div class="ms-fa__qs-list">
          <button type="button" class="ms-fa__q is-on" data-fa-q="" aria-pressed="true">{% render 'ms-t', v: s.all_label %}</button>
          {%- for q in qs -%}
            {%- assign ql = 'q_' | append: q -%}
            {%- if s[ql] != blank -%}<button type="button" class="ms-fa__q" data-fa-q="{{ q }}" aria-pressed="false">{% render 'ms-t', v: s[ql] %}</button>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- assign grp = '' -%}
      {%- for b in section.blocks -%}
        {%- liquid
          assign bs = b.settings
          assign g = bs.group | default: 'animal'
          assign slug = bs.fibre | default: 'wool'
          assign id = 'fibre-' | append: slug
          assign num = forloop.index | prepend: '0' | slice: -2, 2
          if g == 'plant'
            capture glabel
              render 'ms-t', v: s.plant_label
            endcapture
          else
            capture glabel
              render 'ms-t', v: s.animal_label
            endcapture
          endif
          assign draw = 'ms-fibre-draw-' | append: slug | append: '.svg' | asset_url
          assign photo = ''
          assign photo_sm = ''
          if bs.image != blank
            assign photo = bs.image | image_url: width: 1400
            assign photo_sm = bs.image | image_url: width: 720
          elsif bs.photo != blank and bs.photo != 'none'
            assign photo = 'ms-fibre-photo-' | append: bs.photo | append: '.jpg' | asset_url
            assign photo_sm = 'ms-fibre-photo-' | append: bs.photo | append: '-sm.jpg' | asset_url
          endif
        -%}
        {%- if g != grp -%}
          {%- assign grp = g -%}
          <p class="ms-fa__g">{{ glabel }}</p>
        {%- endif -%}
        <h3 class="ms-fa__h" data-q="{{ bs.qualities | escape }}">
          <button type="button" class="ms-fa__row{% if forloop.first %} is-on{% endif %}" id="{{ id }}-tab" data-fa-open="{{ id }}" aria-controls="{{ id }}" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="ms-fa__n" aria-hidden="true">{{ num }}</span>
            <span class="ms-fa__mk" aria-hidden="true">{% render 'ms-fibre-mark', name: bs.mark, size: 26 %}</span>
            <span class="ms-fa__nm">{% render 'ms-t', v: bs.name %}</span>
            {%- if bs.quality_label != blank -%}<span class="ms-fa__ql">{% render 'ms-t', v: bs.quality_label %}</span>{%- endif -%}
          </button>
        </h3>
        <div class="ms-fa__p{% if forloop.first %} is-on{% endif %}" id="{{ id }}" role="region" aria-labelledby="{{ id }}-tab" {{ b.shopify_attributes }}{% unless forloop.first %} hidden{% endunless %}>
          {%- liquid
            capture pts
              render 'ms-t', v: bs.points
            endcapture
            assign pts = pts | default: '' | split: ';'
            assign view = 'glass'
            if photo != ''
              assign view = 'source'
            endif
            # the map is centred between the places it shows
            assign cx = 0.0
            assign npt = 0
            for pt in pts
              assign ll = pt | split: ','
              if ll.size == 2
                assign px = ll[1] | strip | plus: 180.0 | times: 100.0 | divided_by: 360.0
                assign cx = cx | plus: px
                assign npt = npt | plus: 1
              endif
            endfor
            if npt > 0
              assign cx = cx | divided_by: npt
            endif
            # under the glass: how fine, beside the human hair drawn behind it (the number once: not where a figure gives it)
            capture um
              render 'ms-t', v: bs.microns
            endcapture
            assign um = um | default: '' | strip
            if bs.f1 contains 'µm' or bs.f2 contains 'µm' or bs.f3 contains 'µm'
              assign um = ''
            endif
            if um != '' and s.fine_line != blank
              capture measure
                render 'ms-t', v: s.fine_line
              endcapture
              assign measure = measure | replace: '[n]', um
            else
              capture measure
                render 'ms-t', v: s.hair_line
              endcapture
            endif
          -%}
          <div class="ms-fa__pl">
          <figure class="ms-fa__plate" data-fa-plate data-view="{{ view }}">
            <div class="ms-fa__views">
              {%- if photo != '' -%}
                <div class="ms-fa__v ms-fa__v--source"><img class="ms-fa__photo" src="{{ photo }}" srcset="{{ photo_sm }} 720w, {{ photo }} 1400w" sizes="(max-width: 860px) 92vw, 28vw" alt="{% capture ms_t_out %}{% render 'ms-t', v: bs.alt %}{% endcapture %}{{ ms_t_out | escape }}" width="1400" height="1400" loading="lazy"></div>
              {%- endif -%}
              <div class="ms-fa__v ms-fa__v--glass">
                <button type="button" class="ms-fa__field" data-fa-field aria-label="{% capture ms_t_out %}{% render 'ms-t', v: s.zoom_label %}{% endcapture %}{{ ms_t_out | escape }}" aria-pressed="false"><img class="ms-fa__draw" src="{{ draw }}" alt="{% capture ms_t_out %}{% render 'ms-t', v: s.draw_alt %}{% endcapture %}{{ ms_t_out | replace: '[fibre]', bs.name | escape }}" width="800" height="1000" loading="lazy"></button>
                <svg class="ms-fa__reticle" viewBox="0 0 200 200" aria-hidden="true"><circle cx="100" cy="100" r="99" fill="none" stroke="currentColor" stroke-width=".6"/>{%- for t in (0..35) -%}{%- assign tl = 3 -%}{%- assign m9 = t | modulo: 9 -%}{%- if m9 == 0 -%}{%- assign tl = 7 -%}{%- endif -%}<path d="M100 1v{{ tl }}" transform="rotate({{ t | times: 10 }} 100 100)" stroke="currentColor" stroke-width=".6"/>{%- endfor -%}</svg>
              </div>
              {%- if npt > 0 -%}
                <div class="ms-fa__v ms-fa__v--map">
                  <div class="ms-fa__mapw" style="--cx: {{ cx | round: 2 }}%;">
                    <img class="ms-fa__world" src="{{ 'ms-fibre-world.svg' | asset_url }}" alt="{% capture ms_d1 %}{% render 'ms-t', v: bs.origin %}{% endcapture %}{% capture ms_t_out %}{% render 'ms-t', v: s.map_label %}{% endcapture %}{{ ms_t_out | append: ': ' | append: ms_d1 | escape }}" width="1000" height="369" loading="lazy">
                    {%- for pt in pts -%}
                      {%- assign ll = pt | split: ',' -%}
                      {%- if ll.size == 2 -%}
                        {%- assign px = ll[1] | strip | plus: 180.0 | times: 100.0 | divided_by: 360.0 -%}
                        {%- assign py = 75.0 | minus: ll[0] | times: 100.0 | divided_by: 133.0 -%}
                        <span class="ms-fa__pin" style="left: {{ px | round: 2 }}%; top: {{ py | round: 2 }}%;" aria-hidden="true"></span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
            <figcaption class="ms-fa__cap">
              <span class="ms-fa__pn">{% render 'ms-t', v: s.plate_label %} {{ num }}</span>
              {%- if photo != '' -%}<span class="ms-fa__cv ms-fa__cv--source">{% render 'ms-t', v: bs.alt %}</span>{%- endif -%}
              <span class="ms-fa__cv ms-fa__cv--glass">{% capture ms_d2 %}{% render 'ms-t', v: s.glass_label %}{% endcapture %}{{ measure | default: ms_d2 }}{%- if s.zoom_hint != blank -%}<em>{% render 'ms-t', v: s.zoom_hint %}</em>{%- endif -%}</span>
              {%- if npt > 0 -%}<span class="ms-fa__cv ms-fa__cv--map">{% render 'ms-t', v: bs.origin %}</span>{%- endif -%}
            </figcaption>
          </figure>
          {%- if photo != '' or npt > 0 -%}
            <div class="ms-fa__tabs" role="group" aria-label="{% capture ms_t_out %}{% render 'ms-t', v: bs.name %}{% endcapture %}{{ ms_t_out | escape }}">
              {%- if photo != '' -%}<button type="button" class="ms-fa__tab" data-fa-view="source" aria-pressed="{% if view == 'source' %}true{% else %}false{% endif %}">{% render 'ms-t', v: s.source_label %}</button>{%- endif -%}
              <button type="button" class="ms-fa__tab" data-fa-view="glass" aria-pressed="{% if view == 'glass' %}true{% else %}false{% endif %}">{% render 'ms-t', v: s.glass_label %}</button>
              {%- if npt > 0 -%}<button type="button" class="ms-fa__tab" data-fa-view="map" aria-pressed="false">{% render 'ms-t', v: s.map_label %}</button>{%- endif -%}
            </div>
          {%- endif -%}
          </div>
          <div class="ms-fa__txt">
            <div class="ms-fa__eb">{{ glabel }}<span>{{ forloop.index }} / {{ forloop.length }}</span></div>
            <div class="ms-fa__name">{% render 'ms-t', v: bs.name %}</div>
            {%- if bs.quality_label != blank -%}<p class="ms-fa__qs">{% render 'ms-t', v: bs.quality_label %}</p>{%- endif -%}
            {%- if bs.lead != blank -%}<p class="ms-fa__lead">{% render 'ms-t', v: bs.lead %}</p>{%- endif -%}
            {%- if bs.glass_note != blank -%}<p class="ms-fa__gl"><span>{% render 'ms-t', v: s.glass_label %}</span>{% render 'ms-t', v: bs.glass_note %}</p>{%- endif -%}
            {%- if bs.f1 != blank or bs.f2 != blank or bs.f3 != blank -%}
              <dl class="ms-fa__figs">
                {%- for i in (1..3) -%}
                  {%- assign fk = 'f' | append: i -%}{%- assign fc = 'f' | append: i | append: '_cap' -%}
                  {%- if bs[fk] != blank -%}<div><dt>{{ bs[fk] }}</dt><dd>{% render 'ms-t', v: bs[fc] %}</dd></div>{%- endif -%}
                {%- endfor -%}
              </dl>
            {%- endif -%}
            {%- if bs.species != blank or bs.origin != blank -%}
              <dl class="ms-fa__meta">
                {%- if bs.origin != blank -%}<div><dt>{% render 'ms-t', v: s.origin_label %}</dt><dd>{% render 'ms-t', v: bs.origin %}</dd></div>{%- endif -%}
                {%- if bs.species != blank -%}<div><dt>{% render 'ms-t', v: s.species_label %}</dt><dd>{% render 'ms-t', v: bs.species %}</dd></div>{%- endif -%}
              </dl>
            {%- endif -%}
            {%- liquid
              capture keys
                render 'ms-fibre-beds', fibre: slug, part: 'keys'
              endcapture
              assign keys = keys | strip
              assign keys = ',' | append: keys | append: ','
              assign shown = 0
              assign more = 0
              assign seen = '^'
              capture links
                for e in beds
                  assign ep = e | split: '>'
                  assign probe = ',' | append: ep[0] | append: ','
                  assign tprobe = '^' | append: ep[2] | append: '^'
                  if keys contains probe
                    unless seen contains tprobe
                      assign seen = seen | append: ep[2] | append: '^'
                      case ep[4]
                        when 'mattress'
                          capture kl
                            render 'ms-t', v: s.kind_mattress
                          endcapture
                        when 'topper'
                          capture kl
                            render 'ms-t', v: s.kind_topper
                          endcapture
                        else
                          capture kl
                            render 'ms-t', v: s.kind_system
                          endcapture
                      endcase
                      # every bed is listed; past the sixth they wait behind 'Show more'
                      if shown < 6
                        echo '<a class="ms-fa__bed" href="' | append: ep[1] | append: '"><span class="ms-fa__bimg">'
                      else
                        echo '<a class="ms-fa__bed is-extra" hidden href="' | append: ep[1] | append: '"><span class="ms-fa__bimg">'
                        assign more = more | plus: 1
                      endif
                      if ep[3] != blank
                        assign bal = ep[2] | escape
                          echo '<img src="' | append: ep[3] | append: '" alt="' | append: bal | append: '" width="120" height="120" loading="lazy">'
                      endif
                      echo '</span><span class="ms-fa__bn">' | append: ep[2] | append: '</span><span class="ms-fa__bk">' | append: kl | append: '</span></a>'
                      assign shown = shown | plus: 1
                    endunless
                  endif
                endfor
              endcapture
              if beds.size == 0
                capture names
                  render 'ms-fibre-beds', fibre: slug, part: 'names'
                endcapture
                assign names = names | strip | split: '|'
                capture links
                  for nm in names
                    if forloop.index <= 6
                      echo '<span class="ms-fa__bed is-plain"><span class="ms-fa__bn">' | append: nm | append: '</span></span>'
                    else
                      echo '<span class="ms-fa__bed is-plain is-extra" hidden><span class="ms-fa__bn">' | append: nm | append: '</span></span>'
                      assign more = more | plus: 1
                    endif
                  endfor
                endcapture
              endif
              assign links = links | strip
            -%}
            {%- if links != blank -%}
              <div class="ms-fa__beds">
                <span class="ms-fa__bl">{% render 'ms-t', v: s.beds_label %}</span>
                <div class="ms-fa__bs" id="fa-{{ section.id }}-{{ slug }}-beds">{{ links }}</div>{%- if more > 0 -%}<button type="button" class="ms-fa__more" data-fa-more aria-expanded="false" aria-controls="fa-{{ section.id }}-{{ slug }}-beds" data-less="{% capture ms_t_out %}{% render 'ms-t', v: s.less_label %}{% endcapture %}{{ ms_t_out | escape }}"><span data-fa-more-l>{% capture ms_t_out %}{% render 'ms-t', v: s.more_label %}{% endcapture %}{{ ms_t_out | replace: '[n]', more }}</span><span class="ms-fa__more-i" aria-hidden="true">+</span></button>{%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
<script>
  (function () {
    var root = document.querySelectorAll('[data-ms-fa]');
    root.forEach(function (fa) {
      if (fa.dataset.ready) return;
      fa.dataset.ready = '1';
      var rows = [].slice.call(fa.querySelectorAll('[data-fa-open]'));
      var phone = window.matchMedia('(max-width: 860px)');
      function panel(b) { return document.getElementById(b.getAttribute('aria-controls')); }
      function open(id, keep) {
        rows.forEach(function (b) {
          var on = b.getAttribute('data-fa-open') === id;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-expanded', on ? 'true' : 'false');
          var p = panel(b);
          if (p) { p.hidden = !on; p.classList.toggle('is-on', on); }
        });
      }
      rows.forEach(function (b, i) {
        b.addEventListener('click', function () {
          var id = b.getAttribute('data-fa-open');
          if (phone.matches && b.getAttribute('aria-expanded') === 'true') { open(''); return; }
          open(id);
          if (phone.matches) b.scrollIntoView({ block: 'start', behavior: 'smooth' });
          if (history.replaceState) history.replaceState(null, '', '#' + id);
        });
        b.addEventListener('keydown', function (e) {
          if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
          e.preventDefault();
          var live = rows.filter(function (r) { return !r.parentNode.classList.contains('is-dim'); });
          var j = live.indexOf(b) + (e.key === 'ArrowDown' ? 1 : -1);
          if (live[j]) { live[j].focus(); live[j].click(); }
        });
      });
      // every bed made with the fibre: the first six shown, the rest a click away
      fa.querySelectorAll('[data-fa-more]').forEach(function (m) {
        var l = m.querySelector('[data-fa-more-l]'), more = l.textContent, less = m.getAttribute('data-less') || more;
        m.addEventListener('click', function () {
          var on = m.getAttribute('aria-expanded') !== 'true';
          m.setAttribute('aria-expanded', on ? 'true' : 'false');
          l.textContent = on ? less : more;
          var list = document.getElementById(m.getAttribute('aria-controls'));
          if (list) list.querySelectorAll('.is-extra').forEach(function (x) { x.hidden = !on; });
        });
      });
      // what matters most: the fibres that answer it stay lit, the others step back
      var qb = [].slice.call(fa.querySelectorAll('[data-fa-q]'));
      qb.forEach(function (q) {
        q.addEventListener('click', function () {
          var want = q.getAttribute('data-fa-q');
          qb.forEach(function (x) { var on = x === q; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
          var first = null, cur = null;
          fa.querySelectorAll('.ms-fa__h').forEach(function (h) {
            var dim = want && (' ' + h.getAttribute('data-q') + ' ').indexOf(' ' + want + ' ') < 0;
            h.classList.toggle('is-dim', !!dim);
            var b = h.querySelector('[data-fa-open]');
            if (!dim && !first) first = b;
            if (b.classList.contains('is-on')) cur = { b: b, dim: dim };
          });
          if (first && (!cur || cur.dim) && !phone.matches) open(first.getAttribute('data-fa-open'));
        });
      });
      // the plate: at the source, under the glass, where it comes from
      fa.querySelectorAll('[data-fa-view]').forEach(function (t) {
        t.addEventListener('click', function () {
          var pl = t.closest('.ms-fa__pl'), plate = pl.querySelector('[data-fa-plate]'), v = t.getAttribute('data-fa-view');
          plate.setAttribute('data-view', v);
          pl.querySelectorAll('[data-fa-view]').forEach(function (x) { x.setAttribute('aria-pressed', x === t ? 'true' : 'false'); });
          var fd = plate.querySelector('[data-fa-field]');
          if (fd && v !== 'glass') { fd.classList.remove('is-zoom'); fd.setAttribute('aria-pressed', 'false'); }
        });
      });
      // under the glass: a touch looks closer, where it touched; the hand then moves the slide
      fa.querySelectorAll('[data-fa-field]').forEach(function (fd) {
        var img = fd.querySelector('img');
        function at(e) {
          var r = fd.getBoundingClientRect();
          var x = e && e.clientX ? (e.clientX - r.left) / r.width * 100 : 50, y = e && e.clientY ? (e.clientY - r.top) / r.height * 100 : 50;
          img.style.transformOrigin = Math.max(10, Math.min(90, x)).toFixed(1) + '% ' + Math.max(10, Math.min(90, y)).toFixed(1) + '%';
        }
        fd.addEventListener('click', function (e) {
          var on = !fd.classList.contains('is-zoom');
          if (on) at(e.detail === 0 ? null : e);
          fd.classList.toggle('is-zoom', on);
          fd.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        fd.addEventListener('pointermove', function (e) { if (fd.classList.contains('is-zoom') && e.pointerType === 'mouse') at(e); });
      });
      function fromHash() {
        var h = (location.hash || '').slice(1);
        if (h.indexOf('fibre-') !== 0) return;
        var b = fa.querySelector('[data-fa-open="' + h + '"]');
        if (!b) return;
        open(h);
        (phone.matches ? b : fa).scrollIntoView({ block: 'start' });
      }
      fromHash();
      window.addEventListener('hashchange', fromHash);
    });
  })();
</script>
<style>
  .ms-fa { background: #FBF9F5; color: #17140F; padding: clamp(64px, 8vw, 128px) clamp(18px, 5vw, 80px) clamp(72px, 9vw, 140px); }
  .ms-fa__in { max-width: 1560px; margin: 0 auto; }
  .ms-fa__head { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 5vw, 96px); align-items: end; margin-bottom: clamp(40px, 5vw, 72px); }
  .ms-fa__eyebrow { font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: #756b5c; margin-bottom: 18px; }
  .ms-fa__title { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(34px, 3.6vw, 54px); line-height: 1.08; letter-spacing: -.01em; margin: 0; }
  .ms-fa__text { font-size: 15px; line-height: 1.75; color: #6E675C; max-width: 62ch; margin: 0; }

  .ms-fa__grid { display: grid; grid-template-columns: minmax(250px, 4fr) minmax(0, 8fr); grid-auto-rows: auto; column-gap: clamp(32px, 5vw, 96px); align-items: start; }
  .ms-fa__filter, .ms-fa__g, .ms-fa__h { grid-column: 1; }
  .ms-fa__filter { padding-bottom: 18px; margin-bottom: 8px; border-bottom: 1px solid #DDD6C9; }
  .ms-fa__fl { display: block; font-family: Newsreader, Georgia, serif; font-size: 15px; color: #6E675C; margin-bottom: 12px; }
  .ms-fa__qs-list { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .ms-site .ms-fa__q { position: relative; background: none; border: 0; padding: 6px 0; font: inherit; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #736b5f; cursor: pointer; transition: color .3s ease; }
  .ms-site .ms-fa__q::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; border-bottom: 1px solid #17140F; transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2, .7, .2, 1); }
  .ms-site .ms-fa__q:hover, .ms-site .ms-fa__q.is-on { color: #17140F; }
  .ms-site .ms-fa__q.is-on::after { transform: none; }
  .ms-fa__g { margin: 30px 0 4px; font-size: 10px; letter-spacing: .26em; text-transform: uppercase; color: #766b59; }
  .ms-fa__h { margin: 0; font: inherit; transition: opacity .45s ease; }
  .ms-fa__h.is-dim { opacity: .3; }
  .ms-site .ms-fa__row { width: 100%; display: grid; grid-template-columns: 30px 30px minmax(0, 1fr) auto; align-items: center; gap: 0 10px; padding: 12px 0; background: none; border: 0; border-top: 1px solid #ECE6DB; text-align: left; font: inherit; color: #6E675C; cursor: pointer; transition: color .3s ease; }
  .ms-fa__n { position: relative; font-family: Newsreader, Georgia, serif; font-size: 12px; color: #B5AA97; }
  .ms-fa__n::after { content: ''; position: absolute; left: 0; top: 50%; width: 22px; border-top: 1px solid #17140F; transform: scaleX(0); transform-origin: left; transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .ms-fa__row.is-on .ms-fa__n { color: transparent; }
  .ms-fa__row.is-on .ms-fa__n::after { transform: none; }
  .ms-fa__mk { display: inline-flex; color: #9A8F7E; opacity: .8; }
  .ms-fa__mk svg { width: 26px; height: 26px; }
  .ms-fa__nm { font-family: Newsreader, Georgia, serif; font-size: 21px; line-height: 1.2; }
  .ms-fa__ql { font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; color: #766b59; white-space: nowrap; }
  .ms-site .ms-fa__row:hover, .ms-site .ms-fa__row.is-on { color: #17140F; }
  .ms-site .ms-fa__row.is-on .ms-fa__mk { color: #17140F; opacity: 1; }
  .ms-site .ms-fa__row:focus-visible { outline: 1px solid #17140F; outline-offset: 2px; }

  .ms-fa__p { grid-column: 2; grid-row: 1 / span var(--fa-rows); position: sticky; top: 112px; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 3vw, 56px); align-items: start; }
  .ms-fa__p[hidden] { display: none; }
  .ms-fa__p.is-on { animation: msFaIn .6s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes msFaIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .ms-fa__pl { min-width: 0; }
  .ms-fa__plate { position: relative; margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: #241D18; }
  .ms-fa__views, .ms-fa__v { position: absolute; inset: 0; }
  .ms-fa__v { opacity: 0; visibility: hidden; transition: opacity .7s ease, visibility 0s .7s; }
  .ms-fa__plate[data-view="source"] .ms-fa__v--source, .ms-fa__plate[data-view="glass"] .ms-fa__v--glass, .ms-fa__plate[data-view="map"] .ms-fa__v--map { opacity: 1; visibility: visible; transition: opacity .7s ease; }
  .ms-fa__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ms-fa__p.is-on .ms-fa__v--source .ms-fa__photo { animation: msFaPhoto 1.4s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes msFaPhoto { from { transform: scale(1.05); } to { transform: none; } }
  /* under the glass: the round field of a microscope, lit from beneath, with its graduated ring */
  .ms-fa__v--glass { background: radial-gradient(circle at 50% 46%, #3A2F27 0%, #241D18 70%); }
  .ms-site .ms-fa__field { position: absolute; left: 50%; top: 46%; width: 86%; aspect-ratio: 1; transform: translate(-50%, -50%); padding: 0; border: 0; border-radius: 50%; overflow: hidden; cursor: zoom-in; background: #EFE5D3; box-shadow: 0 0 0 1px rgba(226, 207, 174, .35), 0 0 60px rgba(0, 0, 0, .45), inset 0 0 40px rgba(60, 40, 20, .35); }
  .ms-fa__field::after { content: ''; position: absolute; inset: 0; border-radius: 50%; box-shadow: inset 0 0 70px 10px rgba(36, 29, 24, .45); pointer-events: none; }
  .ms-fa__draw { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .9s cubic-bezier(.2, .7, .2, 1); }
  .ms-fa__field.is-zoom { cursor: zoom-out; }
  .ms-fa__field.is-zoom .ms-fa__draw { transform: scale(2.4); }
  .ms-site .ms-fa__field:focus-visible { outline: 1px solid #E2CFAE; outline-offset: 6px; }
  .ms-fa__p.is-on .ms-fa__v--glass .ms-fa__draw { animation: msFaFocus 1.3s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes msFaFocus { from { filter: blur(6px); } to { filter: none; } }
  .ms-fa__reticle { position: absolute; left: 50%; top: 46%; width: 92%; aspect-ratio: 1; transform: translate(-50%, -50%); color: rgba(226, 207, 174, .5); pointer-events: none; }
  /* where it comes from: the world in dots, the place marked */
  .ms-fa__v--map { background: radial-gradient(120% 90% at 50% 40%, #F6F1E8 0%, #ECE4D6 100%); overflow: hidden; }
  .ms-fa__mapw { position: absolute; top: 6%; bottom: 14%; left: 50%; aspect-ratio: 1000 / 369; transform: translateX(calc(-1 * var(--cx, 50%))); }
  .ms-fa__world { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .ms-fa__pin { position: absolute; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; background: #9A5B43; box-shadow: 0 0 0 4px rgba(154, 91, 67, .2); }
  .ms-fa__pin::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1px solid #9A5B43; animation: msFaPin 2.6s ease-out infinite; }
  @keyframes msFaPin { from { transform: scale(.6); opacity: .9; } to { transform: scale(3.4); opacity: 0; } }
  .ms-fa__cap { position: absolute; left: 0; right: 0; bottom: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; padding: 30px 18px 14px; font-size: 12px; line-height: 1.45; color: #FBF9F5; background: linear-gradient(transparent, rgba(23, 20, 15, .55)); pointer-events: none; }
  .ms-fa__pn { flex: 0 0 auto; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; opacity: .85; padding-bottom: 2px; }
  .ms-fa__cv { display: none; text-align: right; max-width: 34ch; font-family: Newsreader, Georgia, serif; font-size: 14.5px; }
  .ms-fa__cv em { display: block; margin-top: 4px; font-family: Nunito Sans, system-ui, sans-serif; font-style: normal; font-size: 9.5px; letter-spacing: .2em; text-transform: uppercase; opacity: .78; }
  .ms-fa__plate[data-view="source"] .ms-fa__cv--source, .ms-fa__plate[data-view="glass"] .ms-fa__cv--glass, .ms-fa__plate[data-view="map"] .ms-fa__cv--map { display: block; }
  .ms-fa__plate[data-view="map"] .ms-fa__cap { color: #4A443B; background: linear-gradient(transparent, rgba(246, 241, 232, .95) 50%); }
  .ms-fa__tabs { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 6px; margin-top: 12px; }
  .ms-site .ms-fa__tab { min-height: 40px; padding: 0 8px; white-space: nowrap; background: none; border: 1px solid #DDD6C9; font: inherit; font-size: 9.5px; letter-spacing: .16em; text-transform: uppercase; color: #6E675C; cursor: pointer; transition: background .3s, color .3s, border-color .3s; }
  .ms-site .ms-fa__tab:hover { border-color: #17140F; color: #17140F; }
  .ms-site .ms-fa__tab[aria-pressed="true"] { background: #17140F; border-color: #17140F; color: #FBF9F5; }
  .ms-fa__txt { padding-top: 4px; }
  .ms-fa__eb { display: flex; justify-content: space-between; font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: #766b59; padding-bottom: 14px; border-bottom: 1px solid #ECE6DB; }
  .ms-fa__eb span { font-family: Newsreader, Georgia, serif; font-size: 12px; letter-spacing: 0; }
  .ms-fa__name { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(36px, 3.4vw, 52px); line-height: 1.05; margin: 22px 0 10px; }
  .ms-fa__qs { margin: 0 0 22px; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: #8d6248; }
  .ms-fa__lead { margin: 0; font-size: 15.5px; line-height: 1.75; color: #4A443B; max-width: 52ch; }
  .ms-fa__gl { margin: 22px 0 0; padding-left: 16px; border-left: 1px solid #D9CBB3; font-size: 14px; line-height: 1.7; color: #5C554B; max-width: 52ch; }
  .ms-fa__gl span { display: block; margin-bottom: 4px; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; color: #8C6A4E; }
  .ms-fa__figs { display: grid; grid-template-columns: repeat(auto-fit, minmax(118px, 1fr)); gap: 18px 24px; margin: 28px 0 0; padding: 22px 0 0; border-top: 1px solid #ECE6DB; }
  .ms-fa__figs dt { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 28px; line-height: 1.1; color: #17140F; }
  .ms-fa__figs dd { margin: 8px 0 0; font-size: 12.5px; line-height: 1.55; color: #6E675C; }
  .ms-fa__meta { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 24px 0 0; font-size: 12px; color: #736b5f; }
  .ms-fa__meta div { display: flex; gap: 10px; }
  .ms-fa__meta dt { font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; color: #766b59; padding-top: 2px; }
  .ms-fa__meta dd { margin: 0; }
  .ms-fa__beds { margin-top: 26px; padding-top: 20px; border-top: 1px solid #ECE6DB; }
  .ms-fa__bl { display: block; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; color: #766b59; margin-bottom: 10px; }
  .ms-fa__bs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ms-site a.ms-fa__bed, .ms-fa__bed { display: grid; grid-template-columns: 46px minmax(0, 1fr); grid-template-rows: auto auto; column-gap: 12px; align-items: center; padding: 6px 10px 6px 6px; border: 1px solid #ECE6DB; color: #17140F; text-decoration: none; transition: border-color .3s, background .3s; }
  .ms-site a.ms-fa__bed:hover { border-color: #17140F; background: #F5F1EA; }
  .ms-fa__bed.is-plain { grid-template-columns: minmax(0, 1fr); }
  .ms-fa__bimg { grid-row: 1 / span 2; width: 46px; height: 46px; background: #EFEAE1; overflow: hidden; }
  .ms-fa__bimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ms-fa__bn { font-family: Newsreader, Georgia, serif; font-size: 17px; line-height: 1.2; align-self: end; }
  .ms-fa__bk { font-size: 9px; letter-spacing: .2em; text-transform: uppercase; color: #756b5c; align-self: start; margin-top: 2px; }
  .ms-fa__more { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; font: inherit; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 4px; cursor: pointer; transition: color .25s; }
  .ms-fa__more:hover { color: #17140F; }
  .ms-fa__more-i { display: inline-block; font-size: 13px; line-height: 1; transition: transform .35s cubic-bezier(.22, 1, .36, 1); }
  .ms-fa__more[aria-expanded="true"] .ms-fa__more-i { transform: rotate(45deg); }
  .ms-fa__bed.is-extra:not([hidden]) { animation: ms-fa-in .45s cubic-bezier(.22, 1, .36, 1) both; }
  @keyframes ms-fa-in { from { opacity: 0; transform: translateY(6px); } }
  @media (prefers-reduced-motion: reduce) { .ms-fa__bed.is-extra:not([hidden]) { animation: none; } }
  @media (max-width: 1240px) {
    .ms-fa__ql { display: none; }
    .ms-site .ms-fa__row { grid-template-columns: 30px 30px minmax(0, 1fr); }
  }
  @media (max-width: 1100px) {
    .ms-fa__p { grid-template-columns: minmax(0, 1fr); }
    .ms-fa__plate { aspect-ratio: 16 / 11; }
    .ms-site .ms-fa__field, .ms-fa__reticle { width: auto; height: 84%; }
  }
  @media (max-width: 860px) {
    .ms-fa__head { grid-template-columns: minmax(0, 1fr); }
    .ms-fa__grid { grid-template-columns: minmax(0, 1fr); }
    .ms-fa__p { grid-column: 1; grid-row: auto; position: static; padding: 6px 0 34px; gap: 22px; }
    .ms-fa__plate { aspect-ratio: 1 / 1; }
    .ms-fa__cv { font-size: 13px; }
    .ms-site .ms-fa__tab { padding: 4px; letter-spacing: .1em; white-space: normal; line-height: 1.3; }
    .ms-site .ms-fa__field, .ms-fa__reticle { width: 88%; height: auto; }
    .ms-fa__bs { grid-template-columns: minmax(0, 1fr); }
    .ms-fa__name { font-size: 34px; margin-top: 16px; }
    .ms-fa__eb { display: none; }
    .ms-site .ms-fa__row { padding: 15px 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ms-fa__p.is-on, .ms-fa__p.is-on .ms-fa__draw, .ms-fa__p.is-on .ms-fa__photo, .ms-fa__pin::after { animation: none; }
    .ms-fa__draw, .ms-fa__v { transition: none; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Fibres · Atlas",
  "class": "ms-fa-section",
  "settings": [
    { "type": "paragraph", "content": "Every fibre in our beds, one at a time. Each block is a fibre; its drawing and the beds made with it follow the fibre chosen in the block. A link to #fibre-vicuna (or any fibre) opens that fibre." },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "fibres" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The fibres" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What each fibre does." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our materials come from farms where animals are treated ethically: cashmere only from Mongolia, horsehair from Argentina, where horses live free, and wool from small farms, never merino from extensive ones." },
    { "type": "header", "content": "Reading by what matters" },
    { "type": "text", "id": "filter_label", "label": "Question", "default": "What matters most to you?" },
    { "type": "text", "id": "all_label", "label": "All", "default": "Everything" },
    { "type": "text", "id": "q_temperature", "label": "Temperature", "default": "Temperature" },
    { "type": "text", "id": "q_support", "label": "Support", "default": "Support" },
    { "type": "text", "id": "q_softness", "label": "Softness", "default": "Softness" },
    { "type": "text", "id": "q_breathability", "label": "Breathability", "default": "Breathability" },
    { "type": "text", "id": "q_hypoallergenic", "label": "Hypoallergenic", "default": "Hypoallergenic" },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "animal_label", "label": "From animals", "default": "From animals" },
    { "type": "text", "id": "plant_label", "label": "From plants", "default": "From plants" },
    { "type": "text", "id": "plate_label", "label": "Plate", "default": "Plate" },
    { "type": "text", "id": "source_label", "label": "View: the photograph", "default": "At the source" },
    { "type": "text", "id": "glass_label", "label": "View: under the glass", "default": "Under the glass" },
    { "type": "text", "id": "map_label", "label": "View: the map", "default": "Its origin" },
