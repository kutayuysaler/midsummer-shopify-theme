        ] },
        { "type": "image_picker", "id": "image", "label": "Or a picture from the store" },
        { "type": "text", "id": "alt", "label": "Photograph description" }
      ]
    }
  ],
  "presets": [ { "name": "Fibres · Atlas" } ]
}
