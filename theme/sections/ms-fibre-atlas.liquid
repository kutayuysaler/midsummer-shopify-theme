    { "type": "text", "id": "kind_mattress", "label": "A mattress", "default": "Mattress" },
    { "type": "text", "id": "kind_topper", "label": "A topper", "default": "Topper" }
  ],
  "blocks": [
    {
      "type": "fibre",
      "name": "Fibre",
      "limit": 24,
