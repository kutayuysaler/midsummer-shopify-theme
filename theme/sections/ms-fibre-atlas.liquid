          { "value": "vicuna", "label": "Vicuña" }, { "value": "cashmere", "label": "Cashmere" }, { "value": "camel", "label": "Camel hair" },
          { "value": "yak", "label": "Yak" }, { "value": "alpaca", "label": "Baby alpaca" }, { "value": "mohair", "label": "Mohair" },
