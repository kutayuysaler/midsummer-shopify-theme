    { "type": "text", "id": "hair_line", "label": "Under the glass: without a number", "default": "The pale band is a human hair, about 70 µm, at the same scale." },
    { "type": "text", "id": "origin_label", "label": "Origin", "default": "Origin" },
    { "type": "text", "id": "species_label", "label": "Species", "default": "Species" },
    { "type": "text", "id": "beds_label", "label": "Beds made with it", "default": "In our beds" },
