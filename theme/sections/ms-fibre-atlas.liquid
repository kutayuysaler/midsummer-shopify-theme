        { "type": "text", "id": "f2", "label": "Figure 2" },
        { "type": "text", "id": "f2_cap", "label": "Figure 2, said" },
        { "type": "text", "id": "f3", "label": "Figure 3" },
        { "type": "text", "id": "f3_cap", "label": "Figure 3, said" },
        { "type": "text", "id": "origin", "label": "Origin" },
        { "type": "text", "id": "points", "label": "Origin on the map", "info": "Latitude,longitude, e.g. -15.5,-70.5; several separated by ;. Empty: no map." },
        { "type": "textarea", "id": "glass_note", "label": "Under the glass, said", "info": "What the glass shows, and what it means in a bed. Shown beside the fibre." },
        { "type": "text", "id": "microns", "label": "Across one fibre, in µm", "info": "E.g. 15 or 25–33. Empty: the caption gives the hair alone." },
        { "type": "text", "id": "species", "label": "Species" },
        { "type": "select", "id": "photo", "label": "Photograph at the source", "default": "none", "options": [
          { "value": "none", "label": "None: the drawing alone" }, { "value": "vicuna", "label": "Vicuñas" }, { "value": "yak", "label": "Yak" },
          { "value": "cashmere", "label": "Goats" }, { "value": "wool", "label": "Sheep" }, { "value": "silk", "label": "Silk" },
