{%- comment -%}
  Notes from the journal: the newest articles, or only those on one subject (a tag).
  Hidden when there is nothing to show. On a note, the notes either side are already offered beneath it,
  so they are left out here when there are enough others.
{%- endcomment -%}
{%- liquid
  assign b = section.settings.blog
  assign only = false
  if section.settings.blog_handle != blank
    assign b = blogs[section.settings.blog_handle]
    assign only = true
  endif
  assign current_url = ''
  if template.name == 'article'
    assign current_url = article.url
    if b == blank and only == false
      assign b = blog
    endif
  endif
  if b == blank and only == false
    if blogs.news.articles_count > 0
      assign b = blogs.news
    elsif blogs.journal.articles_count > 0
      assign b = blogs.journal
    endif
  endif
  assign want = section.settings.tag | downcase | strip
  assign shown = 0
  assign max = section.settings.limit
  assign skip = ''
  assign need = max | plus: 3
  if current_url != '' and b != blank and b.articles_count >= need
    assign prev_url = ''
    assign take_next = false
    for n in b.articles limit: 50
      if take_next
        assign skip = skip | append: '|' | append: n.url | append: '|'
        break
      endif
      if n.url == current_url
        if prev_url != ''
          assign skip = skip | append: '|' | append: prev_url | append: '|'
        endif
        assign take_next = true
      endif
      assign prev_url = n.url
    endfor
  endif
-%}
{%- if b != blank and b.articles_count > 0 -%}
{%- capture cards -%}
  {%- for article in b.articles limit: 50 -%}
    {%- if shown >= max -%}{%- break -%}{%- endif -%}
    {%- if current_url != '' and article.url == current_url -%}{%- continue -%}{%- endif -%}
    {%- assign key = '|' | append: article.url | append: '|' -%}{%- if skip contains key -%}{%- continue -%}{%- endif -%}
    {%- if want != blank -%}
      {%- assign hit = false -%}
      {%- for t in article.tags -%}{%- assign tt = t | downcase -%}{%- if tt contains want -%}{%- assign hit = true -%}{%- endif -%}{%- endfor -%}
      {%- capture wc -%}{% render 'ms-note-cat', a: article %}{%- endcapture -%}{%- if wc == want -%}{%- assign hit = true -%}{%- endif -%}
      {%- unless hit -%}{%- continue -%}{%- endunless -%}
    {%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    <a class="ms-ar__card" href="{{ article.url }}">
      <span class="ms-ar__img">{%- if article.image -%}<img src="{{ article.image | image_url: width: 900 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="lazy">{%- endif -%}</span>
      <span class="ms-ar__meta">{%- capture rc -%}{% render 'ms-note-cat', a: article %}{%- endcapture -%}{%- if rc != '' -%}{% render 'ms-note-cat', label: rc %} · {% endif -%}{{ article.published_at | date: '%B %Y' }}</span>
      <span class="ms-ar__title">{{ article.title }}</span>
    </a>
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
<section class="ms-ar">
  <div class="ms-ar__in">
    <header class="ms-ar__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="ms-ar__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-ar__heading">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}<a class="ms-ar__all" href="{{ b.url }}{% if want != blank %}/tagged/{{ want | handleize }}{% endif %}">{{ section.settings.link_label }}</a>{%- endif -%}
    </header>
    <div class="ms-ar__rail{% if shown == 1 %} is-one{% endif %}" data-ms="rail">{{ cards }}</div>
  </div>
</section>
{%- endif -%}
{%- endif -%}
<style>
  .ms-ar { padding: clamp(64px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-ar__in { max-width: 1560px; margin: 0 auto; }
  .ms-ar__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 18px 40px; border-top: 1px solid #DDD6C9; padding-top: 26px; }
  .ms-ar__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-ar__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.4vw, 48px); letter-spacing: -.025em; font-weight: 200; margin-top: 16px; }
  .ms-site .ms-ar__all { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 7px; }
  .ms-ar__rail { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.4vw, 36px); margin-top: clamp(32px, 4vw, 56px); }
  /* one note alone: its picture beside its title, not a picture across the page */
  .ms-ar__rail.is-one { grid-template-columns: minmax(0, 1fr); }
  .ms-site .ms-ar__rail.is-one .ms-ar__card { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); grid-template-rows: 1fr auto auto 1fr; column-gap: clamp(24px, 4vw, 72px); }
  .ms-ar__rail.is-one .ms-ar__img { grid-row: 1 / -1; }
  .ms-ar__rail.is-one .ms-ar__meta { grid-column: 2; grid-row: 2; }
  .ms-ar__rail.is-one .ms-ar__title { grid-column: 2; grid-row: 3; font-size: clamp(24px, 2.6vw, 36px); max-width: 24ch; }
  @media (max-width: 900px) { .ms-ar__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .ms-ar__rail { grid-template-columns: minmax(0, 1fr); }
    .ms-site .ms-ar__rail.is-one .ms-ar__card { display: flex; }
  }
  .ms-site .ms-ar__card { display: flex; flex-direction: column; color: #17140F; }
  .ms-ar__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #F1ECE3; }
  .ms-ar__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .ms-ar__card:hover .ms-ar__img img { transform: scale(1.03); }
  .ms-ar__meta { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #7E623B; margin-top: 16px; }
  .ms-ar__title { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 1.8vw, 23px); line-height: 1.3; margin-top: 8px; }
</style>
{% schema %}
{
  "name": "From the Journal",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Empty: the store's news or journal blog." },
    { "type": "text", "id": "tag", "label": "Only articles tagged", "info": "Optional, e.g. sleep" },
    { "type": "text", "id": "blog_handle", "label": "Only this journal (handle)", "info": "e.g. projects. The section stays hidden when that journal has no notes." },
    { "type": "range", "id": "limit", "label": "Articles", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "From the Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on sleep." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "All notes" }
  ],
  "presets": [ { "name": "From the Journal" } ]
}
{% endschema %}
