{%- comment -%}
  Inside a Midsummer bed, told with discretion. The three parts of a system are drawn as one bed;
  choose a part and it lifts away from the others while the words beside it open on that part: what
  it does for the sleeper, the choices it comes in, the fibres we tend to use. Nothing of the build
  itself: the exact build of each system is shown at the atelier.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow
  if template.name == 'product' and product != blank and s.eyebrow_product != blank
    assign eyebrow = s.eyebrow_product | replace: '[name]', product.title
    assign pt = product.title | downcase
    if pt contains 'topper'
      assign start = 'topper'
    endif
  endif
  assign parts = 'topper,mattress,base' | split: ','
  assign nums = 'I,II,III' | split: ','
-%}
<section class="ms-cr" data-ms-craft{% if start %} data-cr-start="{{ start }}"{% endif %}>
  <div class="ms-cr__in">
    <div class="ms-cr__top">
      <div class="ms-cr__left">
        <div class="ms-cr__intro" data-cr-intro>
          <div class="ms-cr__eyebrow">{{ eyebrow }}</div>
          <h2 class="ms-cr__title">{{ s.heading }}</h2>
          {%- if s.text != blank -%}<p class="ms-cr__text">{{ s.text }}</p>{%- endif -%}
          <div class="ms-cr__pick">
            {%- if s.hint != blank -%}<p class="ms-cr__hint">{{ s.hint }}</p>{%- endif -%}
            <div class="ms-cr__picks" role="group" aria-label="{{ s.heading | escape }}">
              {%- for p in parts -%}
                {%- assign kt = 'part' | append: forloop.index | append: '_title' -%}
                <button type="button" class="ms-cr__pk" data-cr-open="{{ p }}" aria-expanded="false" aria-controls="cr-{{ section.id }}-{{ p }}"><span>{{ nums[forloop.index0] }}</span>{{ s[kt] }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- if s.note != blank -%}<p class="ms-cr__note">{{ s.note }}</p>{%- endif -%}
          <div class="ms-cr__links">
            {%- if s.button != blank -%}<a class="ms-cr__btn" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-enquire>{{ s.button }}</a>{%- endif -%}
            {%- if s.link_label != blank -%}<a class="ms-cr__link" href="{% render 'ms-link', to: s.link_place %}">{{ s.link_label }}<span aria-hidden="true">→</span></a>{%- endif -%}
          </div>
        </div>

        {%- for p in parts -%}
          {%- liquid
            assign i = forloop.index
            assign kt = 'part' | append: i | append: '_title'
            assign kl = 'part' | append: i | append: '_lead'
            assign kp = 'part' | append: i | append: '_points'
            assign kf = 'part' | append: i | append: '_fibres'
            assign kll = 'part' | append: i | append: '_link_label'
            assign places = 'materials,regen,loro' | split: ','
            assign points = s[kp] | newline_to_br | split: '<br />'
            assign fibres = s[kf] | split: ','
          -%}
          <div class="ms-cr__panel" id="cr-{{ section.id }}-{{ p }}" data-cr-panel="{{ p }}" role="region" aria-label="{{ s[kt] | escape }}" hidden>
            <button type="button" class="ms-cr__back" data-cr-close><span aria-hidden="true">←</span> {{ s.back_label }}</button>
            <div class="ms-cr__pnum">{{ nums[forloop.index0] }} <span>/ III</span></div>
            <h3 class="ms-cr__ph">{{ s[kt] }}</h3>
            {%- if s[kl] != blank -%}<p class="ms-cr__lead">{{ s[kl] }}</p>{%- endif -%}
            {%- if s[kp] != blank -%}
              <ul class="ms-cr__pts" role="list">
                {%- for pt in points -%}{%- assign t = pt | strip -%}{%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if s[kf] != blank -%}
              <div class="ms-cr__fl">{{ s.fibres_label }}</div>
              <ul class="ms-cr__fibres" role="list">
                {%- for f in fibres -%}{%- assign fn = f | strip -%}{%- if fn != '' -%}<li><span class="ms-cr__fi">{% render 'ms-fibre-mark', name: fn, size: 28 %}</span>{{ fn }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="ms-cr__pnav">
              {%- if s[kll] != blank -%}<a class="ms-cr__link" href="{% render 'ms-link', to: places[forloop.index0] %}">{{ s[kll] }}<span aria-hidden="true">→</span></a>{%- endif -%}
              {%- unless forloop.last -%}<button type="button" class="ms-cr__next" data-cr-open="{{ parts[forloop.index] }}">{{ s.next_label }} <span aria-hidden="true">↓</span></button>{%- endunless -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="ms-cr__draw">
        <svg class="ms-cr__svg" viewBox="0 0 600 440" role="group" aria-label="{{ s.heading | escape }}"><defs><filter id="cr-{{ section.id }}-blur" x="-20%" y="-200%" width="140%" height="500%"><feGaussianBlur stdDeviation="7"/></filter><linearGradient id="cr-{{ section.id }}-topper-t" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FCF8F3"/><stop offset="1" stop-color="#F2E4D8"/></linearGradient><linearGradient id="cr-{{ section.id }}-topper-f" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F0DFD2"/><stop offset="1" stop-color="#E4CABA"/></linearGradient><linearGradient id="cr-{{ section.id }}-topper-s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#DEC3B2"/><stop offset="1" stop-color="#D2B39F"/></linearGradient><linearGradient id="cr-{{ section.id }}-mattress-t" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#FBF6F1"/><stop offset="1" stop-color="#F0E2D6"/></linearGradient><linearGradient id="cr-{{ section.id }}-mattress-f" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F3E7DD"/><stop offset="1" stop-color="#E6D2C4"/></linearGradient><linearGradient id="cr-{{ section.id }}-mattress-s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#DDC8B9"/><stop offset="1" stop-color="#CFB7A6"/></linearGradient><linearGradient id="cr-{{ section.id }}-base-t" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#DCAE99"/><stop offset="1" stop-color="#CF9A84"/></linearGradient><linearGradient id="cr-{{ section.id }}-base-f" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#CB927A"/><stop offset="1" stop-color="#BA7E66"/></linearGradient><linearGradient id="cr-{{ section.id }}-base-s" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#AA705A"/><stop offset="1" stop-color="#9C6550"/></linearGradient></defs>
<ellipse class="ms-cr__shadow" cx="290" cy="398" rx="250" ry="13" filter="url(#cr-{{ section.id }}-blur)"/>
<g class="ms-cr__slab" data-part="base" tabindex="0" role="button" aria-label="{{ s.part3_title | escape }}" aria-controls="cr-{{ section.id }}-base" aria-expanded="false"><path class="ms-cr__leg" d="M53,379 l2,13 h6 l2,-13 Z"/><path class="ms-cr__leg" d="M373,379 l2,13 h6 l2,-13 Z"/><path class="ms-cr__leg" d="M507,304 l2,13 h6 l2,-13 Z"/><path class="ms-cr__face ms-cr__face--side" fill="url(#cr-{{ section.id }}-base-s)" d="M400,330 L529.9,255 L529.9,305 L400,380 Z"/><path class="ms-cr__face" fill="url(#cr-{{ section.id }}-base-f)" d="M40,330 L400,330 L400,380 Q220,383 40,380 Z"/><path class="ms-cr__face ms-cr__face--top" fill="url(#cr-{{ section.id }}-base-t)" d="M40,330 L400,330 L529.9,255 L169.9,255 Z"/><path class="ms-cr__seam" d="M44,342 L396,342 L525,267"/><path class="ms-cr__pipe ms-cr__pipe--base" d="M40,330 L400,330 L529.9,255"/><circle class="ms-cr__pulse" cx="284.9" cy="292.5" r="5"/><circle class="ms-cr__spot" cx="284.9" cy="292.5" r="3.2"/><line x1="536" y1="268" x2="565" y2="268" class="ms-cr__lead"/><text x="572" y="273" class="ms-cr__num">III</text></g>
<g class="ms-cr__slab" data-part="mattress" tabindex="0" role="button" aria-label="{{ s.part2_title | escape }}" aria-controls="cr-{{ section.id }}-mattress" aria-expanded="false"><path class="ms-cr__face ms-cr__face--side" fill="url(#cr-{{ section.id }}-mattress-s)" d="M400,222 L529.9,147 L529.9,209 L400,284 Z"/><path class="ms-cr__face" fill="url(#cr-{{ section.id }}-mattress-f)" d="M40,222 L400,222 L400,284 Q220,287 40,284 Z"/><path class="ms-cr__face ms-cr__face--top" fill="url(#cr-{{ section.id }}-mattress-t)" d="M40,222 L400,222 L529.9,147 L169.9,147 Z"/><ellipse class="ms-cr__tuft" cx="104.6" cy="205.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M101.9,202.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="169.4" cy="205.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M166.7,202.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="234.2" cy="205.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M231.5,202.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="299" cy="205.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M296.3,202.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="363.8" cy="205.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M361.1,202.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="173.4" cy="184.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M170.7,181.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="238.1" cy="184.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M235.4,181.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="303" cy="184.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M300.3,181.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="367.8" cy="184.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M365.1,181.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="432.6" cy="184.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M429.9,181.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="177.3" cy="163.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M174.6,160.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="242.1" cy="163.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M239.4,160.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="306.9" cy="163.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M304.2,160.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="371.7" cy="163.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M369,160.9 q2.6,-1.6 5.4,0"/><ellipse class="ms-cr__tuft" cx="436.5" cy="163.5" rx="2.6" ry="1.5"/><path class="ms-cr__dimple" d="M433.8,160.9 q2.6,-1.6 5.4,0"/><path class="ms-cr__stitch" d="M44,231 L396,231 L525,156"/><path class="ms-cr__stitch" d="M44,275 L396,275 L525,200"/><path class="ms-cr__pipe" d="M40,222 L400,222 L529.9,147"/><circle class="ms-cr__pulse" cx="284.9" cy="184.5" r="5"/><circle class="ms-cr__spot" cx="284.9" cy="184.5" r="3.2"/><line x1="536" y1="160" x2="565" y2="160" class="ms-cr__lead"/><text x="572" y="165" class="ms-cr__num">II</text></g>
<g class="ms-cr__slab" data-part="topper" tabindex="0" role="button" aria-label="{{ s.part1_title | escape }}" aria-controls="cr-{{ section.id }}-topper" aria-expanded="false"><path class="ms-cr__face ms-cr__face--side" fill="url(#cr-{{ section.id }}-topper-s)" d="M400,128 L529.9,53 L529.9,75 L400,150 Z"/><path class="ms-cr__face" fill="url(#cr-{{ section.id }}-topper-f)" d="M40,128 L400,128 L400,150 Q220,153 40,150 Z"/><path class="ms-cr__face ms-cr__face--top" fill="url(#cr-{{ section.id }}-topper-t)" d="M40,128 L400,128 L529.9,53 L169.9,53 Z"/><clipPath id="cr-{{ section.id }}-qc"><path d="M40,128 L400,128 L529.9,53 L169.9,53 Z"/></clipPath><path class="ms-cr__quilt" clip-path="url(#cr-{{ section.id }}-qc)" d="M-122,128 L159.1,53 M-122,128 L-143.3,53 M-89.6,128 L191.5,53 M-89.6,128 L-110.9,53 M-57.2,128 L223.9,53 M-57.2,128 L-78.5,53 M-24.8,128 L256.3,53 M-24.8,128 L-46.1,53 M7.6,128 L288.7,53 M7.6,128 L-13.7,53 M40,128 L321.1,53 M40,128 L18.7,53 M72.4,128 L353.5,53 M72.4,128 L51.1,53 M104.8,128 L385.9,53 M104.8,128 L83.5,53 M137.2,128 L418.3,53 M137.2,128 L115.9,53 M169.6,128 L450.7,53 M169.6,128 L148.3,53 M202,128 L483.1,53 M202,128 L180.7,53 M234.4,128 L515.5,53 M234.4,128 L213.1,53 M266.8,128 L547.9,53 M266.8,128 L245.5,53 M299.2,128 L580.3,53 M299.2,128 L277.9,53 M331.6,128 L612.7,53 M331.6,128 L310.3,53 M364,128 L645.1,53 M364,128 L342.7,53 M396.4,128 L677.5,53 M396.4,128 L375.1,53 M428.8,128 L709.9,53 M428.8,128 L407.5,53 M461.2,128 L742.3,53 M461.2,128 L439.9,53 M493.6,128 L774.7,53 M493.6,128 L472.3,53 M526,128 L807.1,53 M526,128 L504.7,53"/><path class="ms-cr__stitch" d="M44,139 L396,139 L525,64"/><circle class="ms-cr__pulse" cx="284.9" cy="90.5" r="5"/><circle class="ms-cr__spot" cx="284.9" cy="90.5" r="3.2"/><line x1="536" y1="66" x2="565" y2="66" class="ms-cr__lead"/><text x="572" y="71" class="ms-cr__num">I</text></g></svg>
      </div>
    </div>

    <div class="ms-cr__parts">
      {%- for p in parts -%}
        {%- liquid
          assign i = forloop.index
          assign kt = 'part' | append: i | append: '_title'
          assign kx = 'part' | append: i | append: '_text'
          assign ki = 'part' | append: i | append: '_image'
          assign kf = 'part' | append: i | append: '_fallback'
        -%}
        <button type="button" class="ms-cr__part" data-part="{{ p }}" data-cr-open="{{ p }}" aria-controls="cr-{{ section.id }}-{{ p }}">
          <span class="ms-cr__img"><img src="{% render 'ms-img', image: s[ki], fallback: s[kf], width: 1000 %}" alt="{{ s[kt] | escape }}" width="1000" height="1250" loading="lazy"></span>
          <span class="ms-cr__cnum">{{ nums[forloop.index0] }}</span>
          <span class="ms-cr__ptitle">{{ s[kt] }}</span>
          <span class="ms-cr__ptext">{{ s[kx] }}</span>
          <span class="ms-cr__more">{{ s.open_label }} <span aria-hidden="true">↑</span></span>
        </button>
      {%- endfor -%}
    </div>
    <ul class="ms-cr__marks">
      {%- for i in (1..3) -%}
        {%- assign km = 'mark' | append: i -%}
        {%- if s[km] != blank -%}<li><span class="ms-cr__mk" aria-hidden="true"></span>{{ s[km] }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
  .ms-cr { background: linear-gradient(165deg, #F2D9CC 0%, #E8C7B7 50%, #DEB6A3 100%); color: #2A1F19; padding: clamp(80px, 10vw, 160px) clamp(16px, 5vw, 80px); }
  .ms-cr__in { max-width: 1560px; margin: 0 auto; }
  .ms-cr__top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 120px); align-items: center; }
  .ms-cr__left { display: grid; }
  .ms-cr__left > * { grid-area: 1 / 1; }
  .ms-cr__intro, .ms-cr__panel { transition: opacity .5s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__intro.is-away { opacity: 0; transform: translateY(-12px); pointer-events: none; visibility: hidden; transition: opacity .35s ease, transform .5s ease, visibility 0s .35s; }
  .ms-cr__panel[hidden] { display: block; opacity: 0; transform: translateY(14px); pointer-events: none; visibility: hidden; }
  .ms-cr__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #9A5B43; }
  .ms-cr__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4.4vw, 68px); line-height: 1.03; letter-spacing: -0.035em; margin-top: clamp(18px, 2vw, 28px); }
  .ms-site .ms-cr__text { font-size: 15.5px; line-height: 1.95; color: rgba(42, 31, 25, .76); margin-top: clamp(20px, 2.4vw, 30px); max-width: 48ch; }
  .ms-cr__pick { margin-top: clamp(26px, 3vw, 38px); }
  .ms-site .ms-cr__hint { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .55); }
  .ms-cr__picks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .ms-cr__pk { display: inline-flex; align-items: baseline; gap: 10px; font: inherit; font-family: Newsreader, Georgia, serif; font-size: 18px; color: #2A1F19; background: rgba(42, 31, 25, .04); border: 1px solid rgba(42, 31, 25, .22); padding: 11px 18px; cursor: pointer; transition: border-color .3s, background .3s; }
  .ms-cr__pk span { font-size: 13px; color: #9A5B43; }
  .ms-cr__pk:hover, .ms-cr__pk:focus-visible { border-color: #7A4532; background: rgba(154, 91, 67, .1); outline: none; }
  .ms-site .ms-cr__note { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.6; color: #7A4532; margin-top: 26px; max-width: 44ch; }
  .ms-cr__links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: clamp(26px, 3vw, 38px); }
  .ms-site a.ms-cr__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #2A1F19; color: #FAF3EC; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-site a.ms-cr__link { display: inline-flex; gap: 12px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #2A1F19; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-cr__back { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__back:hover { color: #2A1F19; }
  .ms-cr__pnum { font-family: Newsreader, Georgia, serif; font-size: 18px; color: #9A5B43; margin-top: clamp(22px, 3vw, 36px); }
  .ms-cr__pnum span { color: rgba(154, 91, 67, .5); font-size: 14px; }
  .ms-cr__ph { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4vw, 60px); line-height: 1.03; letter-spacing: -0.03em; margin-top: 8px; }
  .ms-site .ms-cr__lead { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 1.6vw, 23px); line-height: 1.45; color: #7A4532; margin-top: 18px; max-width: 34ch; }
  .ms-cr__pts { list-style: none; margin: 22px 0 0; padding: 0; max-width: 52ch; }
  .ms-cr__pts li { position: relative; padding: 12px 0 12px 26px; border-top: 1px solid rgba(42, 31, 25, .12); font-size: 14.5px; line-height: 1.75; color: rgba(42, 31, 25, .8); }
  .ms-cr__pts li::before { content: ''; position: absolute; left: 0; top: 24px; width: 12px; height: 1px; background: #9A5B43; }
  .ms-cr__fl { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .55); margin-top: 24px; }
  .ms-cr__fibres { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .ms-cr__fibres li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px 6px 12px; border: 1px solid rgba(42, 31, 25, .16); border-radius: 999px; font-size: 13px; color: rgba(42, 31, 25, .86); }
  .ms-cr__fi { color: #9A5B43; display: flex; }
  .ms-cr__pnav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: 28px; }
  .ms-cr__next { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__next:hover { color: #2A1F19; }
  .ms-cr__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ms-cr__slab { cursor: pointer; outline: none; transition: transform .8s cubic-bezier(.2, .8, .2, 1), opacity .5s ease; }
  .ms-cr__face { stroke: rgba(90, 50, 35, .3); stroke-width: 1; stroke-linejoin: round; transition: stroke .45s ease; }
  .ms-cr__seam { fill: none; stroke: rgba(255, 238, 228, .55); stroke-width: .8; stroke-dasharray: 2 4; }
  .ms-cr__lead { stroke: rgba(154, 91, 67, .55); stroke-width: 1; }
  .ms-cr__num { fill: #9A5B43; font-family: Newsreader, Georgia, serif; font-size: 18px; }
  .ms-cr__spot { fill: #9A5B43; transition: opacity .3s; }
  .ms-cr__pulse { fill: none; stroke: #9A5B43; transform-box: fill-box; transform-origin: center; animation: msCrPulse 2.4s ease-out infinite; }
  .ms-cr__slab[data-part="mattress"] .ms-cr__pulse { animation-delay: .8s; }
  .ms-cr__slab[data-part="base"] .ms-cr__pulse { animation-delay: 1.6s; }
  @keyframes msCrPulse { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(3.2); opacity: 0; } }
  .ms-cr__slab:hover .ms-cr__face, .ms-cr__slab:focus-visible .ms-cr__face { stroke: #7A4532; }
  /* a part chosen: the bed opens, the part lifts away and the others step back */
  .ms-cr[data-open] .ms-cr__pulse, .ms-cr[data-open] .ms-cr__spot { opacity: 0; animation: none; }
  .ms-cr[data-open] .ms-cr__slab { opacity: .42; }
  .ms-cr[data-open] .ms-cr__slab.is-on { opacity: 1; }
  .ms-cr[data-open] .ms-cr__slab[data-part="topper"] { transform: translateY(-22px); }
  .ms-cr[data-open] .ms-cr__slab[data-part="base"] { transform: translateY(22px); }
  .ms-cr[data-open="topper"] .ms-cr__slab[data-part="topper"] { transform: translate(-26px, -58px); }
  .ms-cr[data-open="mattress"] .ms-cr__slab[data-part="mattress"] { transform: translate(-40px, -6px); }
  .ms-cr[data-open="base"] .ms-cr__slab[data-part="base"] { transform: translate(-26px, 50px); }
  .ms-cr__slab.is-on .ms-cr__face { stroke: #7A4532; }
  .ms-cr__slab.is-on { filter: drop-shadow(0 12px 18px rgba(110, 60, 40, .22)); }
  .ms-cr__parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.6vw, 44px); margin-top: clamp(56px, 7vw, 110px); }
  .ms-cr__part { display: block; text-align: left; font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: rgba(42, 31, 25, .05); }
  .ms-cr__img img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .94; transition: opacity .6s ease, transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__part.is-on .ms-cr__img img, .ms-cr__part:hover .ms-cr__img img { opacity: 1; transform: scale(1.03); }
  .ms-cr__part:focus-visible { outline: 1px solid #7A4532; outline-offset: 6px; }
  .ms-cr__cnum { display: block; font-family: Newsreader, Georgia, serif; font-size: 15px; color: #9A5B43; margin-top: 22px; }
  .ms-cr__ptitle { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; margin-top: 6px; }
  .ms-cr__ptext { display: block; font-size: 14.5px; line-height: 1.85; color: rgba(42, 31, 25, .72); margin-top: 12px; max-width: 40ch; }
  .ms-cr__more { display: inline-block; margin-top: 16px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #7A4532; border-bottom: 1px solid rgba(226, 207, 174, .5); padding-bottom: 5px; }
  .ms-cr__marks { list-style: none; margin: clamp(48px, 6vw, 88px) 0 0; padding: 26px 0 0; border-top: 1px solid rgba(42, 31, 25, .18); display: flex; flex-wrap: wrap; gap: 14px clamp(24px, 3.4vw, 56px); }
  .ms-cr__marks li { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .82); }
  .ms-cr__mk { width: 18px; height: 1px; background: #9A5B43; display: inline-block; }
  @media (max-width: 900px) {
    .ms-cr__top { grid-template-columns: minmax(0, 1fr); }
    .ms-cr__draw { max-width: 460px; width: 100%; margin: 0 auto; order: -1; }
    .ms-cr__parts { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-right: calc(-1 * clamp(16px, 5vw, 80px)); padding-right: clamp(16px, 5vw, 80px); }
    .ms-cr__parts::-webkit-scrollbar { display: none; }
    .ms-cr__part { flex: 0 0 78%; scroll-snap-align: start; }
    .ms-cr__marks { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-cr__pulse { animation: none; } .ms-cr__slab, .ms-cr__intro, .ms-cr__panel { transition: none; } }
  /* the bed's fabric: quilting, tufts, hand stitching, piping, feet and its shadow */
  .ms-cr__quilt { fill: none; stroke: rgba(150, 96, 74, .22); stroke-width: .7; }
  .ms-cr__stitch { fill: none; stroke: rgba(122, 69, 50, .42); stroke-width: .8; stroke-dasharray: 2 3; }
  .ms-cr__tuft { fill: #C99B87; }
  .ms-cr__dimple { fill: none; stroke: rgba(122, 69, 50, .22); stroke-width: .6; }
  .ms-cr__pipe { fill: none; stroke: #C98E76; stroke-width: 1.6; stroke-linecap: round; }
  .ms-cr__pipe--base { stroke: #EBC9B7; }
  .ms-cr__leg { fill: #7A5238; }
  .ms-cr__shadow { fill: rgba(110, 60, 40, .3); }
  .ms-cr__slab:hover .ms-cr__face, .ms-cr__slab:focus-visible .ms-cr__face { stroke: #7A4532; }
  .ms-cr__part.is-on .ms-cr__ptitle { color: #7A4532; }
</style>
<script>
(function () {
  document.querySelectorAll('[data-ms-craft]:not([data-ms-craft-on])').forEach(function (root) {
    root.setAttribute('data-ms-craft-on', '');
    var intro = root.querySelector('[data-cr-intro]');
    var top = root.querySelector('.ms-cr__top');
    function open(part, focus, still) {
      if (part) root.setAttribute('data-open', part); else root.removeAttribute('data-open');
      intro.classList.toggle('is-away', !!part);
      root.querySelectorAll('[data-cr-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-cr-panel') !== part; });
      root.querySelectorAll('.ms-cr__slab, .ms-cr__part').forEach(function (el) { var on = el.getAttribute('data-part') === part; el.classList.toggle('is-on', on); if (el.hasAttribute('aria-expanded')) el.setAttribute('aria-expanded', on ? 'true' : 'false'); });
      root.querySelectorAll('.ms-cr__pk').forEach(function (b) { b.setAttribute('aria-expanded', b.getAttribute('data-cr-open') === part ? 'true' : 'false'); });
      if (still) return;
      var r = top.getBoundingClientRect();
      if (r.top < -r.height * .35 || r.top > window.innerHeight * .55) top.scrollIntoView({ behavior: 'smooth', block: window.innerWidth > 900 ? 'center' : 'start' });
      if (focus) { var t = part ? root.querySelector('[data-cr-panel="' + part + '"] .ms-cr__back') : root.querySelector('.ms-cr__pk'); if (t) setTimeout(function () { t.focus({ preventScroll: true }); }, 60); }
    }
    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-cr-close]')) { open(null, true); return; }
      var o = e.target.closest('[data-cr-open]');
      if (o) { open(o.getAttribute('data-cr-open'), e.detail === 0); return; }
      var g = e.target.closest('.ms-cr__slab');
      if (g) { var p = g.getAttribute('data-part'); open(root.getAttribute('data-open') === p ? null : p, false); }
    });
    root.addEventListener('keydown', function (e) {
      var g = e.target.closest('.ms-cr__slab');
      if (g && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(g.getAttribute('data-part'), true); }
      if (e.key === 'Escape' && root.hasAttribute('data-open')) open(null, true);
    });
    // a topper's own page opens on the topper
    if (root.getAttribute('data-cr-start')) open(root.getAttribute('data-cr-start'), false, true);
  });
})();
</script>

