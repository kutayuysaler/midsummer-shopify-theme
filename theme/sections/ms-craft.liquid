{%- comment -%}
  Inside a Midsummer bed, told with discretion. The three parts of a system are drawn as one bed;
  choose a part and it lifts away from the others while the words beside it open on that part: what
  it does for the sleeper, the choices it comes in, the fibres we tend to use. Nothing of the build
  itself: the exact build of each system is shown at the atelier.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign eyebrow = s.eyebrow
  if template.name == 'product' and product != blank and s.eyebrow_product != blank
    assign eyebrow = s.eyebrow_product | replace: '[name]', product.title
  endif
  assign parts = 'topper,mattress,base' | split: ','
  assign nums = 'I,II,III' | split: ','
-%}
<section class="ms-cr" data-ms-craft>
  <div class="ms-cr__in">
    <div class="ms-cr__top">
      <div class="ms-cr__left">
        <div class="ms-cr__intro" data-cr-intro>
          <div class="ms-cr__eyebrow">{{ eyebrow }}</div>
          <h2 class="ms-cr__title">{{ s.heading }}</h2>
          {%- if s.text != blank -%}<p class="ms-cr__text">{{ s.text }}</p>{%- endif -%}
          <div class="ms-cr__pick">
            {%- if s.hint != blank -%}<p class="ms-cr__hint">{{ s.hint }}</p>{%- endif -%}
            <div class="ms-cr__picks" role="group" aria-label="{{ s.heading | escape }}">
              {%- for p in parts -%}
                {%- assign kt = 'part' | append: forloop.index | append: '_title' -%}
                <button type="button" class="ms-cr__pk" data-cr-open="{{ p }}" aria-expanded="false" aria-controls="cr-{{ section.id }}-{{ p }}"><span>{{ nums[forloop.index0] }}</span>{{ s[kt] }}</button>
              {%- endfor -%}
            </div>
          </div>
          {%- if s.note != blank -%}<p class="ms-cr__note">{{ s.note }}</p>{%- endif -%}
          <div class="ms-cr__links">
            {%- if s.button != blank -%}<a class="ms-cr__btn" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-enquire>{{ s.button }}</a>{%- endif -%}
            {%- if s.link_label != blank -%}<a class="ms-cr__link" href="{% render 'ms-link', to: s.link_place %}">{{ s.link_label }}<span aria-hidden="true">→</span></a>{%- endif -%}
          </div>
        </div>

        {%- for p in parts -%}
          {%- liquid
            assign i = forloop.index
            assign kt = 'part' | append: i | append: '_title'
            assign kl = 'part' | append: i | append: '_lead'
            assign kp = 'part' | append: i | append: '_points'
            assign kf = 'part' | append: i | append: '_fibres'
            assign kll = 'part' | append: i | append: '_link_label'
            assign places = 'materials,regen,loro' | split: ','
            assign points = s[kp] | newline_to_br | split: '<br />'
            assign fibres = s[kf] | split: ','
          -%}
          <div class="ms-cr__panel" id="cr-{{ section.id }}-{{ p }}" data-cr-panel="{{ p }}" role="region" aria-label="{{ s[kt] | escape }}" hidden>
            <button type="button" class="ms-cr__back" data-cr-close><span aria-hidden="true">←</span> {{ s.back_label }}</button>
            <div class="ms-cr__pnum">{{ nums[forloop.index0] }} <span>/ III</span></div>
            <h3 class="ms-cr__ph">{{ s[kt] }}</h3>
            {%- if s[kl] != blank -%}<p class="ms-cr__lead">{{ s[kl] }}</p>{%- endif -%}
            {%- if s[kp] != blank -%}
              <ul class="ms-cr__pts" role="list">
                {%- for pt in points -%}{%- assign t = pt | strip -%}{%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if s[kf] != blank -%}
              <div class="ms-cr__fl">{{ s.fibres_label }}</div>
              <ul class="ms-cr__fibres" role="list">
                {%- for f in fibres -%}{%- assign fn = f | strip -%}{%- if fn != '' -%}<li><span class="ms-cr__fi">{% render 'ms-fibre-mark', name: fn, size: 34 %}</span>{{ fn }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="ms-cr__pnav">
              {%- if s[kll] != blank -%}<a class="ms-cr__link" href="{% render 'ms-link', to: places[forloop.index0] %}">{{ s[kll] }}<span aria-hidden="true">→</span></a>{%- endif -%}
              {%- unless forloop.last -%}<button type="button" class="ms-cr__next" data-cr-open="{{ parts[forloop.index] }}">{{ s.next_label }} <span aria-hidden="true">↓</span></button>{%- endunless -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="ms-cr__draw">
        <svg class="ms-cr__svg" viewBox="0 0 600 440" role="group" aria-label="{{ s.heading | escape }}">
          {%- for p in parts -%}
            {%- assign kt = 'part' | append: forloop.index | append: '_title' -%}
            {%- case p -%}
              {%- when 'topper' -%}{%- assign y = 128 -%}{%- assign h = 22 -%}
              {%- when 'mattress' -%}{%- assign y = 222 -%}{%- assign h = 62 -%}
              {%- else -%}{%- assign y = 330 -%}{%- assign h = 50 -%}
            {%- endcase -%}
            {%- assign yb = y | plus: h -%}{%- assign yt = y | minus: 75 -%}{%- assign ytb = yt | plus: h -%}{%- assign ym = y | minus: 37 -%}{%- assign yl = yt | plus: 13 -%}
            <g class="ms-cr__slab" data-part="{{ p }}" tabindex="0" role="button" aria-label="{{ s[kt] | escape }}" aria-controls="cr-{{ section.id }}-{{ p }}" aria-expanded="false">
              <path class="ms-cr__face ms-cr__face--top" d="M40,{{ y }} L400,{{ y }} L529.9,{{ yt }} L169.9,{{ yt }} Z"/>
              <path class="ms-cr__face" d="M40,{{ y }} L400,{{ y }} L400,{{ yb }} L40,{{ yb }} Z"/>
              <path class="ms-cr__face ms-cr__face--side" d="M400,{{ y }} L529.9,{{ yt }} L529.9,{{ ytb }} L400,{{ yb }} Z"/>
              {%- if p == 'topper' -%}{%- for d in (0..5) -%}{%- assign dx = d | times: 60 | plus: 143 -%}<circle cx="{{ dx }}" cy="{{ ym }}" r="1.3" class="ms-cr__dot"/>{%- endfor -%}{%- endif -%}
              {%- if p == 'mattress' -%}<path class="ms-cr__seam" d="M40,{{ y | plus: 31 }} L400,{{ y | plus: 31 }} L529.9,{{ yt | plus: 31 }}"/>{%- endif -%}
              <circle class="ms-cr__pulse" cx="285" cy="{{ ym }}" r="5"/>
              <circle class="ms-cr__spot" cx="285" cy="{{ ym }}" r="3"/>
              <line x1="533.9" y1="{{ yl }}" x2="565" y2="{{ yl }}" class="ms-cr__lead"/>
              <text x="572" y="{{ yl | plus: 5 }}" class="ms-cr__num">{{ nums[forloop.index0] }}</text>
            </g>
          {%- endfor -%}
        </svg>
      </div>
    </div>

    <div class="ms-cr__parts">
      {%- for p in parts -%}
        {%- liquid
          assign i = forloop.index
          assign kt = 'part' | append: i | append: '_title'
          assign kx = 'part' | append: i | append: '_text'
          assign ki = 'part' | append: i | append: '_image'
          assign kf = 'part' | append: i | append: '_fallback'
        -%}
        <button type="button" class="ms-cr__part" data-part="{{ p }}" data-cr-open="{{ p }}" aria-controls="cr-{{ section.id }}-{{ p }}">
          <span class="ms-cr__img"><img src="{% render 'ms-img', image: s[ki], fallback: s[kf], width: 1000 %}" alt="{{ s[kt] | escape }}" width="1000" height="1250" loading="lazy"></span>
          <span class="ms-cr__cnum">{{ nums[forloop.index0] }}</span>
          <span class="ms-cr__ptitle">{{ s[kt] }}</span>
          <span class="ms-cr__ptext">{{ s[kx] }}</span>
          <span class="ms-cr__more">{{ s.open_label }} <span aria-hidden="true">↑</span></span>
        </button>
      {%- endfor -%}
    </div>
    <ul class="ms-cr__marks">
      {%- for i in (1..3) -%}
        {%- assign km = 'mark' | append: i -%}
        {%- if s[km] != blank -%}<li><span class="ms-cr__mk" aria-hidden="true"></span>{{ s[km] }}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
<style>
  .ms-cr { background: #17140F; color: #FBF9F5; padding: clamp(80px, 10vw, 160px) clamp(16px, 5vw, 80px); }
  .ms-cr__in { max-width: 1560px; margin: 0 auto; }
  .ms-cr__top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 120px); align-items: center; }
  .ms-cr__left { display: grid; }
  .ms-cr__left > * { grid-area: 1 / 1; }
  .ms-cr__intro, .ms-cr__panel { transition: opacity .5s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__intro.is-away { opacity: 0; transform: translateY(-12px); pointer-events: none; visibility: hidden; transition: opacity .35s ease, transform .5s ease, visibility 0s .35s; }
  .ms-cr__panel[hidden] { display: block; opacity: 0; transform: translateY(14px); pointer-events: none; visibility: hidden; }
  .ms-cr__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #C9A97A; }
  .ms-cr__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4.4vw, 68px); line-height: 1.03; letter-spacing: -0.035em; margin-top: clamp(18px, 2vw, 28px); }
  .ms-site .ms-cr__text { font-size: 15.5px; line-height: 1.95; color: rgba(251, 249, 245, .76); margin-top: clamp(20px, 2.4vw, 30px); max-width: 48ch; }
  .ms-cr__pick { margin-top: clamp(26px, 3vw, 38px); }
  .ms-site .ms-cr__hint { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(251, 249, 245, .55); }
  .ms-cr__picks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .ms-cr__pk { display: inline-flex; align-items: baseline; gap: 10px; font: inherit; font-family: Newsreader, Georgia, serif; font-size: 18px; color: #FBF9F5; background: rgba(251, 249, 245, .04); border: 1px solid rgba(251, 249, 245, .22); padding: 11px 18px; cursor: pointer; transition: border-color .3s, background .3s; }
  .ms-cr__pk span { font-size: 13px; color: #C9A97A; }
  .ms-cr__pk:hover, .ms-cr__pk:focus-visible { border-color: #E2CFAE; background: rgba(201, 169, 122, .1); outline: none; }
  .ms-site .ms-cr__note { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.6; color: #E2CFAE; margin-top: 26px; max-width: 44ch; }
  .ms-cr__links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: clamp(26px, 3vw, 38px); }
  .ms-site a.ms-cr__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #FBF9F5; color: #17140F; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-site a.ms-cr__link { display: inline-flex; gap: 12px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #FBF9F5; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-cr__back { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(251, 249, 245, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__back:hover { color: #FBF9F5; }
  .ms-cr__pnum { font-family: Newsreader, Georgia, serif; font-size: 18px; color: #C9A97A; margin-top: clamp(22px, 3vw, 36px); }
  .ms-cr__pnum span { color: rgba(201, 169, 122, .5); font-size: 14px; }
  .ms-cr__ph { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4vw, 60px); line-height: 1.03; letter-spacing: -0.03em; margin-top: 8px; }
  .ms-site .ms-cr__lead { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 1.6vw, 23px); line-height: 1.45; color: #E2CFAE; margin-top: 18px; max-width: 34ch; }
  .ms-cr__pts { list-style: none; margin: 22px 0 0; padding: 0; max-width: 52ch; }
  .ms-cr__pts li { position: relative; padding: 12px 0 12px 26px; border-top: 1px solid rgba(251, 249, 245, .12); font-size: 14.5px; line-height: 1.75; color: rgba(251, 249, 245, .8); }
  .ms-cr__pts li::before { content: ''; position: absolute; left: 0; top: 24px; width: 12px; height: 1px; background: #C9A97A; }
  .ms-cr__fl { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(251, 249, 245, .55); margin-top: 24px; }
  .ms-cr__fibres { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .ms-cr__fibres li { display: inline-flex; align-items: center; gap: 8px; padding: 4px 14px 4px 6px; border: 1px solid rgba(251, 249, 245, .16); border-radius: 999px; font-size: 13px; color: rgba(251, 249, 245, .86); }
  .ms-cr__fi { color: #C9A97A; display: flex; }
  .ms-cr__pnav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: 28px; }
  .ms-cr__next { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(251, 249, 245, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__next:hover { color: #FBF9F5; }
  .ms-cr__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ms-cr__slab { cursor: pointer; outline: none; transition: transform .8s cubic-bezier(.2, .8, .2, 1), opacity .5s ease; }
  .ms-cr__face { fill: rgba(251, 249, 245, .03); stroke: rgba(251, 249, 245, .5); stroke-width: 1; transition: fill .45s ease, stroke .45s ease; }
  .ms-cr__face--top { fill: rgba(251, 249, 245, .06); }
  .ms-cr__face--side { fill: rgba(251, 249, 245, .015); }
  .ms-cr__dot { fill: rgba(251, 249, 245, .45); }
  .ms-cr__seam { fill: none; stroke: rgba(251, 249, 245, .25); stroke-dasharray: 2 4; }
  .ms-cr__lead { stroke: rgba(201, 169, 122, .55); stroke-width: 1; }
  .ms-cr__num { fill: #C9A97A; font-family: Newsreader, Georgia, serif; font-size: 18px; }
  .ms-cr__spot { fill: #C9A97A; transition: opacity .3s; }
  .ms-cr__pulse { fill: none; stroke: #C9A97A; transform-box: fill-box; transform-origin: center; animation: msCrPulse 2.4s ease-out infinite; }
  .ms-cr__slab[data-part="mattress"] .ms-cr__pulse { animation-delay: .8s; }
  .ms-cr__slab[data-part="base"] .ms-cr__pulse { animation-delay: 1.6s; }
  @keyframes msCrPulse { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(3.2); opacity: 0; } }
  .ms-cr__slab:hover .ms-cr__face, .ms-cr__slab:focus-visible .ms-cr__face { stroke: #E2CFAE; }
  /* a part chosen: the bed opens, the part lifts away and the others step back */
  .ms-cr[data-open] .ms-cr__pulse, .ms-cr[data-open] .ms-cr__spot { opacity: 0; animation: none; }
  .ms-cr[data-open] .ms-cr__slab { opacity: .32; }
  .ms-cr[data-open] .ms-cr__slab.is-on { opacity: 1; }
  .ms-cr[data-open] .ms-cr__slab[data-part="topper"] { transform: translateY(-22px); }
  .ms-cr[data-open] .ms-cr__slab[data-part="base"] { transform: translateY(22px); }
  .ms-cr[data-open="topper"] .ms-cr__slab[data-part="topper"] { transform: translate(-26px, -58px); }
  .ms-cr[data-open="mattress"] .ms-cr__slab[data-part="mattress"] { transform: translate(-40px, -6px); }
  .ms-cr[data-open="base"] .ms-cr__slab[data-part="base"] { transform: translate(-26px, 50px); }
  .ms-cr__slab.is-on .ms-cr__face { stroke: #E2CFAE; fill: rgba(201, 169, 122, .12); }
  .ms-cr__slab.is-on .ms-cr__face--top { fill: rgba(201, 169, 122, .22); }
  .ms-cr__parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.6vw, 44px); margin-top: clamp(56px, 7vw, 110px); }
  .ms-cr__part { display: block; text-align: left; font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: rgba(251, 249, 245, .05); }
  .ms-cr__img img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .82; transition: opacity .6s ease, transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__part.is-on .ms-cr__img img, .ms-cr__part:hover .ms-cr__img img { opacity: 1; transform: scale(1.03); }
  .ms-cr__part:focus-visible { outline: 1px solid #E2CFAE; outline-offset: 6px; }
  .ms-cr__cnum { display: block; font-family: Newsreader, Georgia, serif; font-size: 15px; color: #C9A97A; margin-top: 22px; }
  .ms-cr__ptitle { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; margin-top: 6px; }
  .ms-cr__ptext { display: block; font-size: 14.5px; line-height: 1.85; color: rgba(251, 249, 245, .72); margin-top: 12px; max-width: 40ch; }
  .ms-cr__more { display: inline-block; margin-top: 16px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #E2CFAE; border-bottom: 1px solid rgba(226, 207, 174, .5); padding-bottom: 5px; }
  .ms-cr__marks { list-style: none; margin: clamp(48px, 6vw, 88px) 0 0; padding: 26px 0 0; border-top: 1px solid rgba(251, 249, 245, .18); display: flex; flex-wrap: wrap; gap: 14px clamp(24px, 3.4vw, 56px); }
  .ms-cr__marks li { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(251, 249, 245, .82); }
  .ms-cr__mk { width: 18px; height: 1px; background: #C9A97A; display: inline-block; }
  @media (max-width: 900px) {
    .ms-cr__top { grid-template-columns: minmax(0, 1fr); }
    .ms-cr__draw { max-width: 460px; width: 100%; margin: 0 auto; order: -1; }
    .ms-cr__parts { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-right: calc(-1 * clamp(16px, 5vw, 80px)); padding-right: clamp(16px, 5vw, 80px); }
    .ms-cr__parts::-webkit-scrollbar { display: none; }
    .ms-cr__part { flex: 0 0 78%; scroll-snap-align: start; }
    .ms-cr__marks { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-cr__pulse { animation: none; } .ms-cr__slab, .ms-cr__intro, .ms-cr__panel { transition: none; } }
</style>
<script>
(function () {
  document.querySelectorAll('[data-ms-craft]:not([data-ms-craft-on])').forEach(function (root) {
    root.setAttribute('data-ms-craft-on', '');
    var intro = root.querySelector('[data-cr-intro]');
    var top = root.querySelector('.ms-cr__top');
    function open(part, focus) {
      if (part) root.setAttribute('data-open', part); else root.removeAttribute('data-open');
      intro.classList.toggle('is-away', !!part);
      root.querySelectorAll('[data-cr-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-cr-panel') !== part; });
      root.querySelectorAll('.ms-cr__slab, .ms-cr__part').forEach(function (el) { var on = el.getAttribute('data-part') === part; el.classList.toggle('is-on', on); if (el.hasAttribute('aria-expanded')) el.setAttribute('aria-expanded', on ? 'true' : 'false'); });
      root.querySelectorAll('.ms-cr__pk').forEach(function (b) { b.setAttribute('aria-expanded', b.getAttribute('data-cr-open') === part ? 'true' : 'false'); });
      var r = top.getBoundingClientRect();
      if (r.top < -r.height * .35 || r.top > window.innerHeight * .55) top.scrollIntoView({ behavior: 'smooth', block: window.innerWidth > 900 ? 'center' : 'start' });
      if (focus) { var t = part ? root.querySelector('[data-cr-panel="' + part + '"] .ms-cr__back') : root.querySelector('.ms-cr__pk'); if (t) setTimeout(function () { t.focus({ preventScroll: true }); }, 60); }
    }
    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-cr-close]')) { open(null, true); return; }
      var o = e.target.closest('[data-cr-open]');
      if (o) { open(o.getAttribute('data-cr-open'), e.detail === 0); return; }
      var g = e.target.closest('.ms-cr__slab');
      if (g) { var p = g.getAttribute('data-part'); open(root.getAttribute('data-open') === p ? null : p, false); }
    });
    root.addEventListener('keydown', function (e) {
      var g = e.target.closest('.ms-cr__slab');
      if (g && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(g.getAttribute('data-part'), true); }
      if (e.key === 'Escape' && root.hasAttribute('data-open')) open(null, true);
    });
  });
})();
</script>

{% schema %}
{
  "name": "Inside the bed",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "default": "Inside a Midsummer bed"
    },
    {
      "type": "text",
      "id": "eyebrow_product",
      "label": "Label on a product page",
      "default": "Inside [name]",
      "info": "[name] becomes the product's name."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three parts, made as one."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every system is a topper, a mattress and a base, built together by the same two artisans and specified with you: size, firmness, fibres and cloth."
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint",
      "default": "Open a part of the bed"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "The exact build of each system is shown at the atelier, with the fibres in your hands."
    },
    {
      "type": "text",
      "id": "button",
      "label": "Button",
      "default": "See it at the atelier"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link",
      "default": "Natural materials"
    },
    {
      "type": "select",
      "id": "link_place",
      "label": "Link to",
      "default": "materials",
      "options": [
        {
          "value": "materials",
          "label": "Natural materials"
        },
        {
          "value": "handmade",
          "label": "Handmade in Italy"
        },
