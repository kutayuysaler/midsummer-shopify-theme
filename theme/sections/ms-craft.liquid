{%- comment -%}
  Inside a Midsummer bed, told with discretion. The three parts of a system are drawn as one bed;
  choose a part and it lifts away from the others while the words beside it open on that part: what
  it does for the sleeper, the choices it comes in, the fibres we tend to use. Nothing of the build
  itself: the exact build of each system is shown at the atelier.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  # the words around the drawing live here rather than in the editor: Shopify takes a section
  # of at most forty settings, and Inside the bed is on the homepage and every product page
  capture tx_heading_mattress
    render 'ms-t', v: 'The mattress, and what completes it.'
  endcapture
  capture tx_heading_topper
    render 'ms-t', v: 'The topper, and the bed beneath it.'
  endcapture
  capture tx_heading_base
    render 'ms-t', v: 'The boxspring, and the bed above it.'
  endcapture
  assign tx_legend_in = '[name]'
  capture tx_legend_out
    render 'ms-t', v: 'Not included, to complete the bed'
  endcapture
  capture tx_winter_label
    render 'ms-t', v: 'Winter face'
  endcapture
  capture tx_summer_label
    render 'ms-t', v: 'Summer face'
  endcapture
  capture tx_absent_label
    render 'ms-t', v: 'Not included'
  endcapture
  capture tx_absent_with
    render 'ms-t', v: 'Not included with [name]'
  endcapture
  capture tx_own_label
    render 'ms-t', v: 'This is [name]'
  endcapture
  capture tx_mates_label
    render 'ms-t', v: 'To complete it'
  endcapture
  capture tx_mates_ask
    render 'ms-t', v: 'Specify it with [name]'
  endcapture
  capture tx_cap_system
    render 'ms-t', v: 'Topper, mattress and boxspring, made as one'
  endcapture
  capture tx_heading_two
    render 'ms-t', v: 'Two parts, made as one.'
  endcapture
  capture tx_cap_opt
    render 'ms-t', v: 'Mattress and boxspring, made as one; a topper if you wish'
  endcapture
  capture tx_cap_two
    render 'ms-t', v: 'Made as one, in two parts'
  endcapture
  capture tx_one_base_title
    render 'ms-t', v: 'Mattress and boxspring, in one'
  endcapture
  capture tx_one_mattress_title
    render 'ms-t', v: 'Mattress and topper, in one'
  endcapture
  capture tx_opt_label
    render 'ms-t', v: 'Optional'
  endcapture
  capture tx_opt_with
    render 'ms-t', v: 'Optional with [name]'
  endcapture
  capture tx_cap_mattress
    render 'ms-t', v: 'The mattress; what completes it, in outline'
  endcapture
  capture tx_cap_topper
    render 'ms-t', v: 'The topper; what lies beneath it, in outline'
  endcapture
  capture tx_cap_base
    render 'ms-t', v: 'The boxspring; what lies above it, in outline'
  endcapture
  capture tx_all
    render 'ms-t', v: 'All toppers|All mattresses|All boxsprings'
  endcapture
  assign tx_all = tx_all | split: '|'
  capture eyebrow
    render 'ms-t', v: s.eyebrow
  endcapture
  assign pname = ''
  if template.name == 'product' and product != blank
    assign pname = product.title
    if s.eyebrow_product != blank
      capture eyebrow
        render 'ms-t', v: s.eyebrow_product
      endcapture
      assign eyebrow = eyebrow | replace: '[name]', product.title
    endif
  endif
  # on a product page: a sleep system has a topper, a mattress and a base; a mattress, a topper or a
  # boxspring is that part alone, the rest drawn in outline and leading to where it can be found
  # (beds with headboards and the Tangram have sections of their own: snippets/ms-kind)
  assign cr_show = true
  assign cr_kind = 'system'
  assign ms_key = template.suffix
  if template.name == 'product' and product != blank
    capture mk
      render 'ms-kind', p: product
    endcapture
    assign mkp = mk | split: '|'
    assign ms_key = mkp[1]
    if mkp[0] == 'boxspring'
      case product.handle
        when 'dreamy-springs'
          assign ms_key = 'base-dreamy-springs'
        when 'my-dream-1'
          assign ms_key = 'base-my-dream'
        when 'first-dream-1'
          assign ms_key = 'base-first-dream'
        when 'top-dream'
          assign ms_key = 'base-top-dream'
        when 'storage-boxspring'
          assign ms_key = 'base-storage'
        else
          assign ms_key = 'base'
      endcase
    elsif mkp[0] != 'system'
      assign cr_show = false
    endif
    capture ck
      render 'ms-sys-data', key: ms_key, part: 'kind'
    endcapture
    assign ck = ck | strip
    if ck != blank
      assign cr_kind = ck
    endif
  endif
  # a system on another's template (the Medium & High and the Thin topper are given the Roma
  # topper's), or on the store's default one, is told from its own data: snippets/ms-sys-data
  assign sd = false
  if template.name == 'product' and product != blank and ms_key != '' and ms_key != product.template_suffix
    assign sd = true
  endif
  capture cr_heading
    render 'ms-t', v: s.heading
  endcapture
  case cr_kind
    when 'mattress'
      capture ms_d1
        render 'ms-t', v: s.heading
      endcapture
      assign cr_heading = tx_heading_mattress | default: ms_d1
    when 'topper'
      capture ms_d2
        render 'ms-t', v: s.heading
      endcapture
      assign cr_heading = tx_heading_topper | default: ms_d2
    when 'base'
      capture ms_d3
        render 'ms-t', v: s.heading
      endcapture
      assign cr_heading = tx_heading_base | default: ms_d3
  endcase
  capture cr_text
    render 'ms-t', v: s.text
  endcapture
  if sd
    capture cr_text
      render 'ms-sys-data', key: ms_key, part: 'text'
    endcapture
    capture ms_d4
      render 'ms-t', v: s.text
    endcapture
    assign cr_text = cr_text | strip | default: ms_d4
  endif
  # on a system's page, Loro Piana Interiors is named only if the system is made in it
  assign lp_free = false
  assign lp_anchor = ''
  if template.name == 'product'
    capture lp_has
      render 'ms-product-cloth', key: ms_key, handle: '', part: 'lp'
    endcapture
    capture lp_anchor
      render 'ms-product-cloth', key: ms_key, handle: '', part: 'anchor'
    endcapture
    if lp_has == blank
      assign lp_free = true
    endif
  endif
  # the parts a system is made of (snippets/ms-sys-data 'parts'): most have three; Capri and Giotto
  # Round are a topper and one piece that is mattress and boxspring; Brera one slim piece that is
  # mattress and topper, on its boxspring. 'opt': a part it takes only if you wish (Storage, Amalfi)
  capture cr_parts
    render 'ms-sys-data', key: ms_key, part: 'parts'
  endcapture
  assign cr_parts = cr_parts | strip
  if cr_parts == blank
    assign cr_parts = 'topper,mattress,base'
  endif
  capture cr_opt
    render 'ms-sys-data', key: ms_key, part: 'opt'
  endcapture
  assign cr_opt = cr_opt | strip
  assign parts = cr_parts | split: ','
  assign nums = 'I,II,III' | split: ','
  assign n_last = parts.size | minus: 1
  capture t2
    render 'ms-t', v: s.part2_title
  endcapture
  capture t3
    render 'ms-t', v: s.part3_title
  endcapture
  if parts.size == 2
    if cr_parts contains 'topper'
      capture ms_d5
        render 'ms-t', v: s.part3_title
      endcapture
      assign t3 = tx_one_base_title | default: ms_d5
    else
      capture ms_d6
        render 'ms-t', v: s.part2_title
      endcapture
      assign t2 = tx_one_mattress_title | default: ms_d6
    endif
  endif
  assign absent_with = tx_absent_with | replace: '[name]', pname
  assign opt_with = tx_opt_with | replace: '[name]', pname
  if cr_kind == 'system'
    if parts.size == 2 or cr_opt != blank
      assign cr_heading = tx_heading_two | default: cr_heading
    endif
  endif
-%}
{%- if cr_show -%}
{%- capture cr_tint -%}{% render 'ms-craft-tint', key: ms_key %}{%- endcapture -%}
{%- liquid
  # what completes it: for each part the product does not include, the pieces that do (first link^collection^image^items)
  assign mate_data = ''
  for p in parts
    assign mine = false
    if cr_kind == 'system' or cr_kind == p
      assign mine = true
    endif
    if cr_opt contains p
      assign mine = false
    endif
    assign md = '-'
    unless mine
      capture md
        render 'ms-craft-mates', key: ms_key, part: p, product: product
      endcapture
      assign md = md | strip | replace: '|', '¦'
    endunless
    assign mate_data = mate_data | append: md | append: '|'
  endfor
  assign mates = mate_data | split: '|'
-%}
<section class="ms-cr ms-cr--{{ cr_kind }}" data-ms-craft data-cr-kind="{{ cr_kind }}"{% if cr_tint != blank %} style="{{ cr_tint | strip }}"{% endif %}>
  <div class="ms-cr__in">
    <div class="ms-cr__top">
      <div class="ms-cr__left">
        <div class="ms-cr__intro" data-cr-intro>
          <div class="ms-cr__eyebrow">{{ eyebrow }}</div>
          <h2 class="ms-cr__title">{{ cr_heading }}</h2>
          {%- if cr_text != blank -%}<p class="ms-cr__text">{% if pname != '' %}{{ cr_text | replace: '[name]', pname }}{% else %}{{ cr_text }}{% endif %}</p>{%- endif -%}
          <div class="ms-cr__pick">
            {%- if s.hint != blank -%}<p class="ms-cr__hint">{% render 'ms-t', v: s.hint %}</p>{%- endif -%}
            <div class="ms-cr__picks" role="group" aria-label="{{ cr_heading | escape }}">
              {%- for p in parts -%}
                {%- liquid
                  assign mine = false
                  if cr_kind == 'system' or cr_kind == p
                    assign mine = true
                  endif
                  assign isopt = false
                  if cr_opt contains p
                    assign mine = false
                    assign isopt = true
                  endif
                  case p
                    when 'topper'
                      capture c_title
                        render 'ms-t', v: s.part1_title
                      endcapture
                    when 'mattress'
                      assign c_title = t2
                    else
                      assign c_title = t3
                  endcase
                -%}
                <button type="button" class="ms-cr__pk{% unless mine %} is-absent{% endunless %}{% if isopt %} is-opt{% endif %}" data-cr-open="{{ p }}" aria-expanded="false" aria-controls="cr-{{ section.id }}-{{ p }}"><span>{{ nums[forloop.index0] }}</span>{{ c_title }}{%- unless mine -%}<em class="ms-cr__pk-out">{% if isopt %}{{ tx_opt_label }}{% else %}{{ tx_absent_label }}{% endif %}</em>{%- endunless -%}</button>
              {%- endfor -%}
            </div>
            {%- if cr_kind != 'system' -%}
              <p class="ms-cr__legend"><span class="ms-cr__lg"><i class="ms-cr__lg-in" aria-hidden="true"></i>{{ tx_legend_in | replace: '[name]', pname }}</span><span class="ms-cr__lg"><i class="ms-cr__lg-out" aria-hidden="true"></i>{{ tx_legend_out }}</span></p>
            {%- endif -%}
          </div>
          {%- if s.note != blank -%}<p class="ms-cr__note">{% render 'ms-t', v: s.note %}</p>{%- endif -%}
          <div class="ms-cr__links">
            {%- if s.button != blank -%}<a class="ms-cr__btn" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-enquire>{% render 'ms-t', v: s.button %}</a>{%- endif -%}
            {%- if s.link_label != blank -%}<a class="ms-cr__link" href="{% render 'ms-link', to: s.link_place %}">{% render 'ms-t', v: s.link_label %}<span aria-hidden="true">→</span></a>{%- endif -%}
          </div>
        </div>

        {%- for p in parts -%}
          {%- liquid
            case p
              when 'topper'
                assign i = 1
              when 'mattress'
                assign i = 2
              else
                assign i = 3
            endcase
            assign kl = 'part' | append: i | append: '_lead'
            assign kp = 'part' | append: i | append: '_points'
            assign kf = 'part' | append: i | append: '_fibres'
            assign kll = 'part' | append: i | append: '_link_label'
            assign ai = i | minus: 1
            assign infos = 'materials,regen,loro' | split: ','
            capture c_lead
              render 'ms-t', v: s[kl]
            endcapture
            capture c_points
              render 'ms-t', v: s[kp]
            endcapture
            capture c_fibres
              render 'ms-t', v: s[kf]
            endcapture
            assign sk = 'p' | append: i
            capture c_winter
              render 'ms-sys-data', key: ms_key, part: sk, f: 'winter'
            endcapture
            capture c_summer
              render 'ms-sys-data', key: ms_key, part: sk, f: 'summer'
            endcapture
            if sd
              assign sk = 'p' | append: i
              capture c_lead
                render 'ms-sys-data', key: ms_key, part: sk, f: 'lead'
              endcapture
              capture c_points
                render 'ms-sys-data', key: ms_key, part: sk, f: 'points'
              endcapture
              capture c_fibres
                render 'ms-sys-data', key: ms_key, part: sk, f: 'fibres'
              endcapture
              assign c_lead = c_lead | strip
              assign c_points = c_points | strip
              assign c_fibres = c_fibres | strip
              assign c_winter = c_winter | strip
              assign c_summer = c_summer | strip
            endif
            assign c_winter = c_winter | strip
            assign c_summer = c_summer | strip
            assign c_lead = c_lead | replace: '[name]', pname
            assign points = c_points | newline_to_br | split: '<br />'
            assign fibres = c_fibres | split: ','
            assign mine = false
            if cr_kind == 'system' or cr_kind == p
              assign mine = true
            endif
            assign isopt = false
            if cr_opt contains p
              assign mine = false
              assign isopt = true
            endif
            case p
              when 'topper'
                capture c_title
                  render 'ms-t', v: s.part1_title
                endcapture
              when 'mattress'
                assign c_title = t2
              else
                assign c_title = t3
            endcase
            assign mt = mates[forloop.index0] | split: '^'
          -%}
          <div class="ms-cr__panel{% unless mine %} is-absent{% endunless %}" id="cr-{{ section.id }}-{{ p }}" data-cr-panel="{{ p }}" role="region" aria-label="{{ c_title | escape }}" hidden>
            <button type="button" class="ms-cr__back" data-cr-close><span aria-hidden="true">←</span> {% render 'ms-t', v: s.back_label %}</button>
            <div class="ms-cr__pnum">{{ nums[forloop.index0] }} <span>/ {{ nums[n_last] }}</span></div>
            {%- if cr_kind != 'system' -%}
              {%- if mine -%}<p class="ms-cr__badge"><i aria-hidden="true"></i>{{ tx_own_label | replace: '[name]', pname }}</p>{%- elsif isopt -%}<p class="ms-cr__badge is-out"><i aria-hidden="true"></i>{{ opt_with }}</p>{%- else -%}<p class="ms-cr__badge is-out"><i aria-hidden="true"></i>{{ absent_with }}</p>{%- endif -%}
            {%- endif -%}
            <h3 class="ms-cr__ph">{{ c_title }}</h3>
            {%- if c_lead != blank -%}<p class="ms-cr__lead">{{ c_lead }}</p>{%- endif -%}
            {%- if c_points != blank -%}
              <ul class="ms-cr__pts" role="list">
                {%- for pt in points -%}
                  {%- assign t = pt | strip -%}
                  {%- if lp_free -%}{%- assign t = t | replace: 'Loro Piana Interiors, or in ', '' -%}{%- if t contains 'Loro Piana' -%}{%- assign t = '' -%}{%- endif -%}{%- endif -%}
                  {%- if t contains '[[' -%}
                    {%- assign segs = t | split: '[[' -%}
                    {%- capture t -%}{{ segs[0] }}{%- for sg in segs offset: 1 -%}{%- assign sp = sg | split: ']]' -%}{%- assign hl = sp[0] | split: '|' -%}{%- assign lpp = all_products[hl[0]] -%}{%- if lpp.url != blank -%}<a href="{{ lpp.url }}">{{ hl[1] }}</a>{%- else -%}{{ hl[1] }}{%- endif -%}{{ sp[1] }}{%- endfor -%}{%- endcapture -%}
                  {%- endif -%}
                  {%- if t != '' -%}<li>{{ t }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if c_winter != blank and c_summer != blank -%}
              <div class="ms-cr__fl">{% render 'ms-t', v: s.fibres_label %}</div>
              <div class="ms-cr__faces">
                {%- for side in (1..2) -%}
                  {%- if side == 1 -%}{%- assign fl = c_winter | split: ',' -%}{%- assign fh = tx_winter_label -%}{%- else -%}{%- assign fl = c_summer | split: ',' -%}{%- assign fh = tx_summer_label -%}{%- endif -%}
                  <div class="ms-cr__fc">
                    <div class="ms-cr__fh">{%- if side == 1 -%}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 1.5v13M2.4 4.75l11.2 6.5M2.4 11.25l11.2-6.5M6.3 2.6 8 4.3l1.7-1.7M6.3 13.4 8 11.7l1.7 1.7" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>{%- else -%}<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>{%- endif -%}{{ fh }}</div>
                    <ul class="ms-cr__fibres" role="list">
                      {%- for f in fl -%}{%- assign fn = f | strip -%}{%- if fn != '' -%}<li><span class="ms-cr__fi">{% render 'ms-fibre-mark', name: fn, size: 24 %}</span>{{ fn }}</li>{%- endif -%}{%- endfor -%}
                    </ul>
                  </div>
                {%- endfor -%}
              </div>
            {%- elsif c_fibres != blank -%}
              <div class="ms-cr__fl">{% render 'ms-t', v: s.fibres_label %}</div>
              <ul class="ms-cr__fibres" role="list">
                {%- for f in fibres -%}{%- assign fn = f | strip -%}{%- if lp_free and fn contains 'Loro Piana' -%}{%- assign fn = '' -%}{%- endif -%}{%- if fn != '' -%}<li><span class="ms-cr__fi">{% render 'ms-fibre-mark', name: fn, size: 28 %}</span>{{ fn }}</li>{%- endif -%}{%- endfor -%}
              </ul>
            {%- endif -%}
            {%- unless mine -%}
              {%- assign m_items = mt[3] | replace: '¦', '|' -%}
              <div class="ms-cr__mates">
                <div class="ms-cr__fl">{{ tx_mates_label }}</div>
                {%- if m_items != blank -%}<ul class="ms-cr__mlist" role="list">{{ m_items }}</ul>{%- endif -%}
                <div class="ms-cr__mlinks">
                  {%- if mt[1] != blank -%}<a class="ms-cr__link" href="{{ mt[1] }}">{{ tx_all[ai] }}<span aria-hidden="true">→</span></a>{%- endif -%}
                  <a class="ms-cr__link ms-cr__link--soft" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-enquire>{{ tx_mates_ask | replace: '[name]', pname }}<span aria-hidden="true">→</span></a>
                </div>
              </div>
            {%- endunless -%}
            <div class="ms-cr__pnav">
              {%- liquid
                assign ii = i | minus: 1
                assign info = infos[ii]
                assign show_link = mine
                if info == 'loro' and lp_free
                  assign show_link = false
                endif
                assign hash = ''
                if info == 'loro' and lp_anchor != blank
                  assign hash = '#' | append: lp_anchor
                endif
              -%}
              {%- if s[kll] != blank and show_link -%}<a class="ms-cr__link" href="{% render 'ms-link', to: info %}{{ hash }}">{% render 'ms-t', v: s[kll] %}<span aria-hidden="true">→</span></a>{%- endif -%}
              {%- unless forloop.last -%}<button type="button" class="ms-cr__next" data-cr-open="{{ parts[forloop.index] }}">{% render 'ms-t', v: s.next_label %} <span aria-hidden="true">↓</span></button>{%- endunless -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      <figure class="ms-cr__draw">
        {%- liquid
          assign cr_award = false
          if pname != ''
            assign ms_tt = product.title | downcase | strip
            assign ms_aw = product.metafields.custom.award.value | append: ''
            if ms_key == 'top-2' or product.handle == 'top' or product.handle == 'top-2' or ms_tt == 'top' or ms_tt contains 'top sleeping system' or ms_tt contains 'top bed system' or ms_tt contains 'top system' or ms_tt contains 'sistema top' or ms_tt contains 'sistema letto top' or ms_aw contains 'Green Product Award'
              unless ms_tt contains 'dream'
                assign cr_award = true
              endunless
            endif
          endif
        -%}
        {%- if cr_award -%}
          <a class="ms-cr__award" href="https://www.gp-award.com/en/produkte/top-bed-system" target="_blank" rel="noopener" aria-label="{% capture ms_t_out %}{% render 'ms-t', v: 'Green Product Award 2025' %}{% endcapture %}{{ ms_t_out | strip | escape }}">
            <span class="ms-cr__award-mk" aria-hidden="true"><img src="{{ 'ms-press-green-product-award.svg' | asset_url }}" alt="" width="137" height="32" loading="lazy"></span>
            <span class="ms-cr__award-t" aria-hidden="true"><span class="ms-cr__award-n">{% render 'ms-t', v: 'Green Product Award' %}</span><span class="ms-cr__award-y">{% render 'ms-t', v: 'Berlin · 2025' %}</span></span>
            <span class="ms-cr__award-go" aria-hidden="true">↗</span>
          </a>
        {%- endif -%}
        {% capture ms_d8 %}{% render 'ms-t', v: s.part1_title %}{% endcapture %}{% render 'ms-craft-svg', key: ms_key, u: section.id, aria: cr_heading, t0: tx_absent_label, to: tx_opt_label, t1: ms_d8, t2: t2, t3: t3 %}
        {%- if pname != '' -%}
          {%- liquid
            case cr_kind
              when 'mattress'
                assign cap = tx_cap_mattress
              when 'topper'
                assign cap = tx_cap_topper
              when 'base'
                assign cap = tx_cap_base
              else
                assign cap = tx_cap_system
                if parts.size == 2
                  assign cap = tx_cap_two | default: tx_cap_system
                elsif cr_opt != blank
                  assign cap = tx_cap_opt | default: tx_cap_system
                endif
            endcase
          -%}
          {%- if cap != blank -%}<figcaption class="ms-cr__cap"><em>{{ pname }}</em><span>{{ cap }}</span></figcaption>{%- endif -%}
        {%- endif -%}
      </figure>
    </div>

    <div class="ms-cr__parts">
      {%- for p in parts -%}
        {%- liquid
          case p
            when 'topper'
              assign i = 1
            when 'mattress'
              assign i = 2
            else
              assign i = 3
          endcase
          assign kx = 'part' | append: i | append: '_text'
          assign ki = 'part' | append: i | append: '_image'
          assign ai = i | minus: 1
          capture c_text
            render 'ms-t', v: s[kx]
          endcapture
          if sd
            assign sk = 'p' | append: i
            capture c_text
              render 'ms-sys-data', key: ms_key, part: sk, f: 'lead'
            endcapture
            capture ms_d7
              render 'ms-t', v: s[kx]
            endcapture
            assign c_text = c_text | strip | default: ms_d7
          endif
          assign c_text = c_text | replace: '[name]', pname
          assign mine = false
          if cr_kind == 'system' or cr_kind == p
            assign mine = true
          endif
          assign isopt = false
          if cr_opt contains p
            assign mine = false
            assign isopt = true
          endif
          case p
            when 'topper'
              capture c_title
                render 'ms-t', v: s.part1_title
              endcapture
            when 'mattress'
              assign c_title = t2
            else
              assign c_title = t3
          endcase
          assign mt = mates[forloop.index0] | split: '^'
          # each card a photograph of its own part: the system's own where it was photographed,
          # else the house's studio photographs of a topper, a mattress, a boxspring
          capture cphoto
            render 'ms-craft-photo', key: ms_key, part: p
          endcapture
          assign cphoto = cphoto | strip
        -%}
        {%- if mine or mt[0] == blank -%}
        <button type="button" class="ms-cr__part{% unless mine %} is-absent{% endunless %}" data-part="{{ p }}" data-cr-open="{{ p }}" aria-controls="cr-{{ section.id }}-{{ p }}">
        {%- else -%}
        <a class="ms-cr__part is-absent" data-part="{{ p }}" href="{{ mt[0] }}">
        {%- endif -%}
          <span class="ms-cr__img">{%- if s[ki] != blank -%}<img src="{{ s[ki] | image_url: width: 1000 }}" srcset="{{ s[ki] | image_url: width: 600 }} 600w, {{ s[ki] | image_url: width: 1000 }} 1000w" sizes="(max-width: 760px) 90vw, 30vw" alt="{{ s[ki].alt | default: c_title | escape }}" width="1000" height="1250" loading="lazy">{%- elsif mine == false and mt[2] != blank -%}<img src="{{ mt[2] }}" alt="{{ c_title | escape }}" width="900" height="1125" loading="lazy">{%- else -%}<img src="{{ cphoto | asset_url }}" {% render 'ms-srcset', fallback: cphoto, width: 1600, sizes: '(max-width: 1080px) 70vw, 29vw' %} alt="{{ c_title | escape }}{% if pname != '' and mine %}, {{ pname | escape }}{% endif %}" width="720" height="900" loading="lazy">{%- endif -%}{%- unless mine -%}<span class="ms-cr__out">{% if isopt %}{{ tx_opt_label }}{% else %}{{ tx_absent_label }}{% endif %}</span>{%- endunless -%}</span>
          <span class="ms-cr__cnum">{{ nums[forloop.index0] }}</span>
          <span class="ms-cr__ptitle">{{ c_title }}</span>
          <span class="ms-cr__ptext">{% if lp_free %}{{ c_text | replace: ' in Loro Piana Interiors', '' }}{% else %}{{ c_text }}{% endif %}</span>
          {%- if mine or mt[0] == blank -%}
          <span class="ms-cr__more">{% render 'ms-t', v: s.open_label %} <span aria-hidden="true">↑</span></span>
        </button>
          {%- else -%}
          <span class="ms-cr__more">{{ tx_all[ai] }} <span aria-hidden="true">→</span></span>
        </a>
          {%- endif -%}
      {%- endfor -%}
    </div>
    {%- comment -%} the house's marks speak of the mattress and topper; a boxspring alone goes without {%- endcomment -%}
    {%- if cr_kind != 'base' -%}
    <ul class="ms-cr__marks">
      {%- for i in (1..3) -%}
        {%- assign km = 'mark' | append: i -%}
        {%- if s[km] != blank -%}<li><span class="ms-cr__mk" aria-hidden="true"></span>{% render 'ms-t', v: s[km] %}</li>{%- endif -%}
      {%- endfor -%}
    </ul>
    {%- endif -%}
  </div>
</section>
<style>
  .ms-cr { background: linear-gradient(165deg, var(--cr-g1, #E4D3C8) 0%, var(--cr-g2, #DCC7BA) 55%, var(--cr-g3, #D2BAAA) 100%); color: #2A1F19; padding: clamp(80px, 10vw, 160px) clamp(16px, 5vw, 80px); }
  .ms-cr__in { max-width: 1560px; margin: 0 auto; }
  .ms-cr__top { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 120px); align-items: center; }
  .ms-cr__left { display: grid; }
  .ms-cr__left > * { grid-area: 1 / 1; }
  .ms-cr__intro, .ms-cr__panel { transition: opacity .5s ease, transform .6s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__intro.is-away { opacity: 0; transform: translateY(-12px); pointer-events: none; visibility: hidden; transition: opacity .35s ease, transform .5s ease, visibility 0s .35s; }
  .ms-cr__panel[hidden] { display: block; opacity: 0; transform: translateY(14px); pointer-events: none; visibility: hidden; }
  .ms-cr__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7A4532; }
  .ms-cr__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4.4vw, 68px); line-height: 1.03; letter-spacing: -0.035em; margin-top: clamp(18px, 2vw, 28px); }
  .ms-site .ms-cr__text { font-size: 15.5px; line-height: 1.95; color: rgba(42, 31, 25, .76); margin-top: clamp(20px, 2.4vw, 30px); max-width: 48ch; }
  .ms-cr__pick { margin-top: clamp(26px, 3vw, 38px); }
  .ms-site .ms-cr__hint { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .72); }
  .ms-cr__picks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .ms-cr__pk { display: inline-flex; align-items: baseline; gap: 10px; font: inherit; font-family: Newsreader, Georgia, serif; font-size: 18px; color: #2A1F19; background: rgba(42, 31, 25, .04); border: 1px solid rgba(42, 31, 25, .22); padding: 11px 18px; cursor: pointer; transition: border-color .3s, background .3s; }
  .ms-cr__pk span { font-size: 13px; color: #7A4532; }
  .ms-cr__pk:hover, .ms-cr__pk:focus-visible { border-color: #7A4532; background: rgba(154, 91, 67, .1); outline: none; }
  .ms-site .ms-cr__note { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.6; color: #7A4532; margin-top: 26px; max-width: 44ch; }
  .ms-cr__links { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: clamp(26px, 3vw, 38px); }
  .ms-site a.ms-cr__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #2A1F19; color: #FAF3EC; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-site a.ms-cr__link { display: inline-flex; gap: 12px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #2A1F19; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-cr__back { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__back:hover { color: #2A1F19; }
  .ms-cr__pnum { font-family: Newsreader, Georgia, serif; font-size: 18px; color: #7A4532; margin-top: clamp(22px, 3vw, 36px); }
  .ms-cr__pnum span { color: rgba(122, 69, 50, .6); font-size: 14px; }
  .ms-cr__ph { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 4vw, 60px); line-height: 1.03; letter-spacing: -0.03em; margin-top: 8px; }
  .ms-site .ms-cr__lead { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 1.6vw, 23px); line-height: 1.45; color: #7A4532; margin-top: 18px; max-width: 34ch; }
  .ms-cr__pts { list-style: none; margin: 22px 0 0; padding: 0; max-width: 52ch; }
  .ms-cr__pts li { position: relative; padding: 12px 0 12px 26px; border-top: 1px solid rgba(42, 31, 25, .12); font-size: 14.5px; line-height: 1.75; color: rgba(42, 31, 25, .8); }
  .ms-cr__pts li::before { content: ''; position: absolute; left: 0; top: 24px; width: 12px; height: 1px; background: #9A5B43; }
  .ms-cr__fl { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .72); margin-top: 24px; }
  .ms-cr__fibres { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .ms-cr__fibres li { display: inline-flex; align-items: center; gap: 8px; padding: 6px 16px 6px 12px; border: 1px solid rgba(42, 31, 25, .16); border-radius: 999px; font-size: 13px; color: rgba(42, 31, 25, .86); }
  .ms-cr__fi { color: #7A4532; display: flex; }
  .ms-cr__pnav { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 30px; margin-top: 28px; }
  .ms-cr__next { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .7); background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__next:hover { color: #2A1F19; }
  .ms-cr__svg { width: 100%; height: auto; display: block; overflow: visible; }
  .ms-cr__slab { cursor: pointer; outline: none; transition: transform 1.2s cubic-bezier(.2, .7, .2, 1) var(--cr-delay, 0s), opacity .5s ease; }
  /* until the section is seen the bed is whole; then it opens, base first, into its three parts */
  .ms-cr:not(.is-seen) .ms-cr__slab { transform: translateY(var(--cr-c, 0px)); }
  .ms-cr__depth { transform: translate(calc(var(--px, 0) * var(--d, 1) * 1px), calc(var(--py, 0) * var(--d, 1) * 1px)); transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__guide { opacity: 0; transition: opacity .8s ease .9s; }
  .ms-cr.is-seen .ms-cr__guide { opacity: 1; }
  .ms-cr__cast { fill: #2A1F19; opacity: 0; transition: opacity 1s ease .5s; }
  .ms-cr.is-seen .ms-cr__cast { opacity: .05; }
  .ms-cr__lbl { opacity: 0; transition: opacity .8s ease calc(var(--cr-delay, 0s) + .6s); }
  .ms-cr.is-seen .ms-cr__lbl { opacity: 1; }
  .ms-cr__lead { fill: none; stroke: rgba(122, 69, 50, .5); stroke-width: .7; vector-effect: non-scaling-stroke; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 1.1s cubic-bezier(.2, .7, .2, 1) calc(var(--cr-delay, 0s) + .5s); }
  .ms-cr.is-seen .ms-cr__lead { stroke-dashoffset: 0; }
  .ms-cr__dot { fill: #9A5B43; }
  .ms-cr__nm { fill: #2A1F19; font-family: Newsreader, Georgia, serif; font-size: 16px; opacity: .62; transition: opacity .4s ease; }
  .ms-cr__slab:hover .ms-cr__nm, .ms-cr__slab:focus-visible .ms-cr__nm, .ms-cr__slab.is-on .ms-cr__nm { opacity: 1; }
  /* the hand over a part: it lifts a little, the others step back */
  .ms-cr:not([data-open]).is-seen .ms-cr__slab:hover, .ms-cr:not([data-open]).is-seen .ms-cr__slab:focus-visible { transform: translateY(-7px); transition-delay: 0s; }
  .ms-cr:not([data-open]) .ms-cr__svg:has(.ms-cr__slab:hover) .ms-cr__slab:not(:hover) { opacity: .5; }
  @media (max-width: 600px) { .ms-cr__nm { display: none; } }
  /* a part the product does not include: drawn as a light outline, still there to explain */
  .ms-cr__slab.is-ghost .ms-cr__face { fill: rgba(251, 249, 245, .2) !important; stroke: rgba(122, 69, 50, .5); stroke-dasharray: 3 4; }
  .ms-cr__slab.is-ghost:hover .ms-cr__face, .ms-cr__slab.is-ghost.is-on .ms-cr__face { fill: rgba(251, 249, 245, .42) !important; stroke: #9A5B43; }
  .ms-cr__slab.is-ghost .ms-cr__nm { font-style: italic; }
  .ms-cr__slab.is-ghost .ms-cr__pulse, .ms-cr__slab.is-ghost .ms-cr__spot { opacity: .45; }
  .ms-cr__face { stroke: rgba(58, 40, 30, .34); stroke-width: .7; vector-effect: non-scaling-stroke; stroke-linejoin: round; transition: stroke .45s ease; }
  .ms-cr__seam { fill: none; stroke: rgba(255, 238, 228, .55); stroke-width: .8; stroke-dasharray: 2 4; }
  .ms-cr__num { fill: #9A5B43; font-family: Newsreader, Georgia, serif; font-size: 17px; }
  .ms-cr__spot { fill: #9A5B43; transition: opacity .3s; }
  .ms-cr__pulse { fill: none; stroke: #9A5B43; transform-box: fill-box; transform-origin: center; animation: msCrPulse 2.4s ease-out infinite; }
  .ms-cr__slab[data-part="mattress"] .ms-cr__pulse { animation-delay: .8s; }
  .ms-cr__slab[data-part="base"] .ms-cr__pulse { animation-delay: 1.6s; }
  @keyframes msCrPulse { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(3.2); opacity: 0; } }
  .ms-cr__slab:hover .ms-cr__face, .ms-cr__slab:focus-visible .ms-cr__face { stroke: rgba(122, 69, 50, .7); }
  /* a part chosen: the bed opens, the part lifts away and the others step back */
  .ms-cr[data-open] .ms-cr__pulse, .ms-cr[data-open] .ms-cr__spot { opacity: 0; animation: none; }
  .ms-cr[data-open] .ms-cr__slab { opacity: .42; }
  .ms-cr[data-open] .ms-cr__slab.is-on { opacity: 1; }
  .ms-cr[data-open] .ms-cr__slab[data-part="topper"] { transform: translateY(-22px); }
  .ms-cr[data-open] .ms-cr__slab[data-part="base"] { transform: translateY(22px); }
  .ms-cr[data-open="topper"] .ms-cr__slab[data-part="topper"] { transform: translate(-26px, -58px); }
  .ms-cr[data-open="mattress"] .ms-cr__slab[data-part="mattress"] { transform: translate(-40px, -6px); }
  .ms-cr[data-open="base"] .ms-cr__slab[data-part="base"] { transform: translate(-26px, 50px); }
  .ms-cr__slab.is-on .ms-cr__face { stroke: rgba(122, 69, 50, .7); }
  .ms-cr__slab.is-on { filter: drop-shadow(0 14px 22px rgba(110, 60, 40, .18)); }
  .ms-cr__parts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(18px, 2.6vw, 44px); margin-top: clamp(56px, 7vw, 110px); align-items: start; }
  .ms-cr__part { display: block; text-align: left; font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .ms-cr__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: rgba(42, 31, 25, .05); }
  .ms-cr__img img { width: 100%; height: 100%; object-fit: cover; display: block; opacity: .94; transition: opacity .6s ease, transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .ms-cr__part.is-on .ms-cr__img img, .ms-cr__part:hover .ms-cr__img img { opacity: 1; transform: scale(1.03); }
  .ms-cr__part:focus-visible { outline: 1px solid #7A4532; outline-offset: 6px; }
  .ms-cr__cnum { display: block; font-family: Newsreader, Georgia, serif; font-size: 15px; color: #7A4532; margin-top: 22px; }
  .ms-cr__ptitle { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; margin-top: 6px; }
  .ms-cr__ptext { display: block; font-size: 14.5px; line-height: 1.85; color: rgba(42, 31, 25, .72); margin-top: 12px; max-width: 40ch; }
  .ms-cr__more { display: inline-block; margin-top: 16px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #7A4532; border-bottom: 1px solid rgba(226, 207, 174, .5); padding-bottom: 5px; }
  .ms-cr__marks { list-style: none; margin: clamp(48px, 6vw, 88px) 0 0; padding: 26px 0 0; border-top: 1px solid rgba(42, 31, 25, .18); display: flex; flex-wrap: wrap; gap: 14px clamp(24px, 3.4vw, 56px); }
  .ms-cr__marks li { display: flex; align-items: center; gap: 12px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: rgba(42, 31, 25, .82); }
  .ms-cr__mk { width: 18px; height: 1px; background: #9A5B43; display: inline-block; }
  @media (max-width: 900px) {
    .ms-cr__top { grid-template-columns: minmax(0, 1fr); }
    .ms-cr__draw { max-width: 460px; width: 100%; margin: 0 auto; order: -1; }
    .ms-cr__parts { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin-right: calc(-1 * clamp(16px, 5vw, 80px)); padding-right: clamp(16px, 5vw, 80px); }
    .ms-cr__parts::-webkit-scrollbar { display: none; }
    .ms-cr__part { flex: 0 0 78%; scroll-snap-align: start; }
    .ms-cr__marks { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-cr__pulse { animation: none; } .ms-cr__slab, .ms-cr__intro, .ms-cr__panel, .ms-cr__depth, .ms-cr__lead, .ms-cr__lbl { transition: none; } }
  /* the bed's fabric: quilting, tufts, hand stitching, piping, feet and its shadow */
  .ms-cr__quilt { fill: none; stroke: rgba(150, 96, 74, .22); stroke-width: .7; }
  .ms-cr__stitch { fill: none; stroke: rgba(122, 69, 50, .42); stroke-width: .8; stroke-dasharray: 2 3; }
  .ms-cr__tuft { fill: #C99B87; }
  .ms-cr__dimple { fill: none; stroke: rgba(122, 69, 50, .22); stroke-width: .6; }
  .ms-cr__pipe { fill: none; stroke: #C98E76; stroke-width: 1.6; stroke-linecap: round; }
  .ms-cr__pipe--base { stroke: #EBC9B7; }
  .ms-cr__leg { fill: #7A5238; }
  .ms-cr__shadow { fill: rgba(110, 60, 40, .3); }
  .ms-cr__part.is-on .ms-cr__ptitle { color: #7A4532; }

  /* a mattress, a topper or a boxspring: the part it is, and the parts that complete it, in outline */
  .ms-cr__draw { margin: 0; }
  /* Round 27: the Green Product Award, a quiet label above the drawing of Inside Top */
  .ms-cr__draw { position: relative; }
  .ms-site a.ms-cr__award { position: relative; z-index: 1; display: flex; width: max-content; max-width: 100%; align-items: center; gap: 14px; margin: 0 0 -4% 6%; padding: 10px 16px 10px 12px; color: #17140F; text-decoration: none; background: rgba(251, 249, 245, .42); border: 1px solid rgba(126, 98, 59, .24); transition: border-color .4s, background-color .4s; }
  .ms-site a.ms-cr__award:hover, .ms-site a.ms-cr__award:focus-visible { border-color: rgba(126, 98, 59, .58); background: rgba(251, 249, 245, .72); }
  .ms-cr__award-mk { width: 32px; height: 32px; overflow: hidden; flex: 0 0 auto; }
  .ms-site .ms-cr__award-mk img { width: auto; height: 32px; max-width: none; display: block; filter: none !important; }
  .ms-cr__award-t { display: grid; gap: 5px; padding-left: 14px; border-left: 1px solid rgba(126, 98, 59, .28); line-height: 1; }
  .ms-cr__award-n { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 17px; letter-spacing: .005em; }
  .ms-cr__award-y { font-size: 9.5px; letter-spacing: .24em; text-transform: uppercase; color: #7E623B; }
  .ms-cr__award-go { align-self: flex-start; margin-left: 4px; font-size: 11px; line-height: 1; color: #7E623B; opacity: .55; transition: opacity .4s, transform .4s; }
  .ms-site a.ms-cr__award:hover .ms-cr__award-go, .ms-site a.ms-cr__award:focus-visible .ms-cr__award-go { opacity: 1; transform: translate(2px, -2px); }
  @media (max-width: 760px) { .ms-site a.ms-cr__award { gap: 12px; padding: 9px 14px 9px 10px; } .ms-cr__award-t { padding-left: 12px; } .ms-cr__award-n { font-size: 16px; } }
  .ms-cr__pk.is-absent { background: transparent; border-style: dashed; border-color: rgba(42, 31, 25, .3); color: rgba(42, 31, 25, .7); }
  .ms-cr__pk-out { font-family: Nunito Sans, system-ui, sans-serif; font-style: normal; font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; color: rgba(122, 69, 50, .78); margin-left: 2px; }
  .ms-site .ms-cr__legend { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 16px; font-size: 12px; color: rgba(42, 31, 25, .72); }
  .ms-cr__lg { display: inline-flex; align-items: center; gap: 9px; }
  .ms-cr__lg i { display: inline-block; width: 22px; height: 12px; }
  .ms-cr__lg-in { background: rgba(251, 249, 245, .7); border: 1px solid rgba(42, 31, 25, .45); }
  .ms-cr__lg-out { border: 1px dashed rgba(122, 69, 50, .6); }
  .ms-site .ms-cr__badge { display: inline-flex; align-items: center; gap: 10px; margin-top: 14px; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #2A1F19; }
  .ms-cr__badge i { width: 8px; height: 8px; border-radius: 50%; background: #9A5B43; }
  .ms-site .ms-cr__badge.is-out { color: rgba(122, 69, 50, .9); }
  .ms-cr__badge.is-out i { background: none; border: 1px dashed #9A5B43; }
  .ms-cr__panel.is-absent .ms-cr__ph { color: rgba(42, 31, 25, .78); }
  .ms-cr__faces { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 22px; margin-top: 12px; max-width: 560px; }
  .ms-cr__fc { border-top: 1px solid rgba(42, 31, 25, .16); padding-top: 12px; }
  .ms-cr__fh { display: flex; align-items: center; gap: 8px; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 16px; color: #7A4532; }
  .ms-cr__faces .ms-cr__fibres { margin-top: 10px; gap: 6px; }
  .ms-cr__faces .ms-cr__fibres li { padding: 4px 12px 4px 8px; font-size: 12.5px; }
  .ms-cr__mates { margin-top: 26px; padding-top: 4px; }
  .ms-cr__mlist { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 8px; max-width: 460px; }
  .ms-site a.ms-cr__mate { display: grid; grid-template-columns: 52px minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 8px 14px 8px 8px; background: rgba(251, 249, 245, .55); border: 1px solid rgba(42, 31, 25, .12); color: #2A1F19; transition: background .3s, border-color .3s; }
  .ms-site a.ms-cr__mate:hover, .ms-site a.ms-cr__mate:focus-visible { background: rgba(251, 249, 245, .9); border-color: rgba(122, 69, 50, .5); }
  .ms-cr__mimg { width: 52px; height: 52px; background: rgba(42, 31, 25, .06); overflow: hidden; }
  .ms-cr__mimg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ms-cr__mname { font-family: Newsreader, Georgia, serif; font-size: 19px; line-height: 1.2; }
  .ms-cr__marr { color: #7A4532; transition: transform .3s; }
  .ms-cr__mate:hover .ms-cr__marr { transform: translateX(4px); }
  .ms-cr__mlinks { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 28px; margin-top: 18px; }
  .ms-site a.ms-cr__link--soft { color: rgba(42, 31, 25, .72); border-bottom-color: rgba(42, 31, 25, .3); }
  .ms-cr__cap { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 4px 14px; margin-top: 6px; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: rgba(42, 31, 25, .62); text-align: center; }
  .ms-cr__cap em { font-family: Newsreader, Georgia, serif; font-size: 17px; letter-spacing: 0; text-transform: none; color: #7A4532; }
  .ms-cr__abs { fill: #9A5B43; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 12.5px; opacity: .85; }
  .ms-cr__part.is-absent .ms-cr__img { position: relative; outline: 1px dashed rgba(122, 69, 50, .45); outline-offset: -1px; }
  .ms-cr__part.is-absent .ms-cr__img img { filter: grayscale(.55) sepia(.18); opacity: .72; }
  .ms-cr__part.is-absent:hover .ms-cr__img img { filter: none; opacity: 1; }
  .ms-cr__out { position: absolute; left: 14px; top: 14px; padding: 6px 12px; background: rgba(251, 249, 245, .88); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: #7A4532; }
  .ms-site a.ms-cr__part { color: inherit; }
  .ms-cr__part.is-absent .ms-cr__ptitle { color: rgba(42, 31, 25, .72); }
  @media (max-width: 600px) { .ms-cr__abs { display: none; } .ms-cr__faces { grid-template-columns: minmax(0, 1fr); } .ms-cr__cap em { font-size: 16px; } }
</style>
<script>
(function () {
  document.querySelectorAll('[data-ms-craft]:not([data-ms-craft-on])').forEach(function (root) {
    root.setAttribute('data-ms-craft-on', '');
    var intro = root.querySelector('[data-cr-intro]');
    var top = root.querySelector('.ms-cr__top');
    function open(part, focus, still) {
      if (part) root.setAttribute('data-open', part); else root.removeAttribute('data-open');
      intro.classList.toggle('is-away', !!part);
      root.querySelectorAll('[data-cr-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-cr-panel') !== part; });
      root.querySelectorAll('.ms-cr__slab, .ms-cr__part').forEach(function (el) { var on = el.getAttribute('data-part') === part; el.classList.toggle('is-on', on); if (el.hasAttribute('aria-expanded')) el.setAttribute('aria-expanded', on ? 'true' : 'false'); });
      root.querySelectorAll('.ms-cr__pk').forEach(function (b) { b.setAttribute('aria-expanded', b.getAttribute('data-cr-open') === part ? 'true' : 'false'); });
      if (still) return;
      var r = top.getBoundingClientRect();
      if (r.top < -r.height * .35 || r.top > window.innerHeight * .55) top.scrollIntoView({ behavior: 'smooth', block: window.innerWidth > 900 ? 'center' : 'start' });
      if (focus) { var t = part ? root.querySelector('[data-cr-panel="' + part + '"] .ms-cr__back') : root.querySelector('.ms-cr__pk'); if (t) setTimeout(function () { t.focus({ preventScroll: true }); }, 60); }
    }
    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-cr-close]')) { open(null, true); return; }
      var o = e.target.closest('[data-cr-open]');
      if (o) { open(o.getAttribute('data-cr-open'), e.detail === 0); return; }
      var g = e.target.closest('.ms-cr__slab');
      if (g) { var p = g.getAttribute('data-part'); open(root.getAttribute('data-open') === p ? null : p, false); }
    });
    root.addEventListener('keydown', function (e) {
      var g = e.target.closest('.ms-cr__slab');
      if (g && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(g.getAttribute('data-part'), true); }
      if (e.key === 'Escape' && root.hasAttribute('data-open')) open(null, true);
    });
    // the bed opens into its parts when it comes into view
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var draw = root.querySelector('.ms-cr__draw');
    if (still || !('IntersectionObserver' in window) || !draw) { root.classList.add('is-seen'); }
    else {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (en) { if (en.isIntersecting) { root.classList.add('is-seen'); io.disconnect(); } });
      }, { threshold: .35 });
      io.observe(draw);
    }
    // and its parts sit at their own depths, moving a little with the hand
    var svg = root.querySelector('.ms-cr__svg');
    // on a phone the parts' names give way to their numerals: the drawing takes the room they left
    if (svg) {
      var narrowMq = window.matchMedia('(max-width: 600px)');
      var frame = function () { svg.setAttribute('viewBox', narrowMq.matches ? '0 0 612 440' : '0 0 700 440'); };
      frame();
      if (narrowMq.addEventListener) narrowMq.addEventListener('change', frame);
    }
    if (svg && draw && !still && window.matchMedia('(hover: hover)').matches) {
      draw.addEventListener('pointermove', function (e) {
        var r = draw.getBoundingClientRect();
        svg.style.setProperty('--px', (((e.clientX - r.left) / r.width - .5) * -4).toFixed(2));
        svg.style.setProperty('--py', (((e.clientY - r.top) / r.height - .5) * -3).toFixed(2));
      });
      draw.addEventListener('pointerleave', function () { svg.style.setProperty('--px', 0); svg.style.setProperty('--py', 0); });
    }
  });
})();
</script>
