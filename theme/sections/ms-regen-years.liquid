{%- comment -%}
  Thirty years, side by side: on one line of years, an industrial mattress replaced every few
  years, and one Midsummer mattress, renewed once by hand at fifteen. The bars draw themselves
  once, as the section comes into view; without script, or with reduced motion, they are simply
  there.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign every = s.industrial_years | default: 9
  assign total = 30
  assign n_ind = total | plus: every | minus: 1 | divided_by: every | floor
  assign n_gone = n_ind | minus: 1
-%}
<section class="ms-ly" id="ms-ly-{{ section.id }}" aria-labelledby="ms-ly-h-{{ section.id }}">
  <div class="ms-ly__head">
    {%- if s.eyebrow != blank -%}<div class="ms-ly__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="ms-ly__h" id="ms-ly-h-{{ section.id }}">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="ms-ly__text">{{ s.text }}</p>{%- endif -%}
  </div>

  <figure class="ms-ly__chart" aria-describedby="ms-ly-d-{{ section.id }}">
    <div class="ms-ly__row ms-ly__row--axis" aria-hidden="true">
      <div class="ms-ly__lab">{{ s.years_label }}</div>
      <div class="ms-ly__ticks">
        {%- for y in (0..6) -%}
          {%- assign yr = y | times: 5 -%}
          <span style="left: {{ yr | times: 100.0 | divided_by: total }}%">{{ yr }}</span>
        {%- endfor -%}
      </div>
      <div></div>
    </div>

    <div class="ms-ly__row ms-ly__row--them">
      <div class="ms-ly__lab">{{ s.label_industrial }}</div>
      <div class="ms-ly__track" aria-hidden="true">
        {%- for i in (1..n_ind) -%}
          {%- assign a = i | minus: 1 | times: every -%}
          {%- assign b = i | times: every | at_most: total -%}
          {%- assign w = b | minus: a -%}
          <span class="ms-ly__seg" style="left: {{ a | times: 100.0 | divided_by: total }}%; width: {{ w | times: 100.0 | divided_by: total }}%; --d: {{ i | times: 140 }}ms"></span>
        {%- endfor -%}
      </div>
      <div class="ms-ly__n"><b>{{ n_ind }}</b> {{ s.mattresses_label }}</div>
    </div>

    <div class="ms-ly__row ms-ly__row--ours">
      <div class="ms-ly__lab">{{ s.label_ours }}</div>
      <div class="ms-ly__track" aria-hidden="true">
        <span class="ms-ly__bar"></span>
        <span class="ms-ly__mark" style="left: 50%"><i></i><span>{{ s.regen_label }}</span></span>
      </div>
      <div class="ms-ly__n"><b>1</b> {{ s.mattress_label }}</div>
    </div>

    <figcaption class="ms-ly__note" id="ms-ly-d-{{ section.id }}">
      {{ s.footnote | replace: '[n]', n_gone }}
    </figcaption>
  </figure>
</section>
<style>
  .ms-ly { border-top: 1px solid #DDD6C9; padding: clamp(56px, 8vw, 120px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0 auto; }
  .ms-ly__head { max-width: 62ch; }
  .ms-ly__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-ly__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3.6vw, 52px); line-height: 1.06; letter-spacing: -0.03em; margin-top: 16px; }
  .ms-ly__text { font-size: 15.5px; line-height: 1.9; color: #4A443B; margin-top: 18px; }
  .ms-ly__chart { margin: clamp(40px, 5vw, 72px) 0 0; }
  .ms-ly__row { display: grid; grid-template-columns: minmax(150px, 2.2fr) minmax(0, 7fr) minmax(110px, 1fr); column-gap: clamp(16px, 2.4vw, 40px); align-items: center; }
  .ms-ly__row--axis { padding: 0 0 10px; border-bottom: 1px solid #17140F; }
  .ms-ly__row--axis .ms-ly__lab { font-family: inherit; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #9A8F7E; }
  .ms-ly__ticks { position: relative; height: 16px; }
  .ms-ly__ticks span { position: absolute; top: 0; transform: translateX(-50%); font-size: 11px; letter-spacing: .1em; color: #6E675C; font-variant-numeric: tabular-nums; }
  .ms-ly__row { padding: 26px 0; border-bottom: 1px solid #ECE6DB; }
  .ms-ly__lab { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(18px, 1.6vw, 22px); line-height: 1.25; color: #17140F; }
  .ms-ly__row--them .ms-ly__lab { color: #6E675C; }
  .ms-ly__track { position: relative; height: 18px; }
  .ms-ly__seg { position: absolute; top: 3px; height: 12px; border: 1px solid #B5AA97; border-right-width: 0; background: repeating-linear-gradient(90deg, transparent 0 6px, rgba(181, 170, 151, .28) 6px 7px); transform-origin: left center; }
  .ms-ly__seg::after { content: ''; position: absolute; right: 0; top: -5px; bottom: -5px; border-right: 1px solid #9A8F7E; }
  .ms-ly__bar { position: absolute; left: 0; right: 0; top: 2px; height: 14px; background: #7E623B; transform-origin: left center; }
  .ms-ly__mark { position: absolute; top: -34px; bottom: -6px; width: 0; }
  .ms-ly__mark i { position: absolute; left: -.5px; top: 22px; bottom: 0; border-left: 1px solid #17140F; }
  .ms-ly__mark i::after { content: ''; position: absolute; left: -4px; bottom: 8px; width: 7px; height: 7px; border-radius: 50%; background: #FBF9F5; border: 1px solid #17140F; }
  .ms-ly__mark span { position: absolute; left: 0; top: 0; transform: translateX(-50%); white-space: nowrap; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #17140F; background: #FBF9F5; padding: 0 8px; }
  .ms-ly__n { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; text-align: right; }
  .ms-ly__n b { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 28px; letter-spacing: 0; color: #17140F; margin-right: 6px; text-transform: none; }
  .ms-ly__row--them .ms-ly__n b { color: #6E675C; }
  .ms-ly__note { font-size: 13px; line-height: 1.75; color: #6E675C; margin-top: 18px; max-width: 72ch; }
  /* drawn once, as it comes into view */
  .ms-ly.is-ready .ms-ly__seg, .ms-ly.is-ready .ms-ly__bar { transform: scaleX(0); }
  .ms-ly.is-ready .ms-ly__mark { opacity: 0; }
  .ms-ly.is-in .ms-ly__seg { transform: none; transition: transform .9s cubic-bezier(.3, .7, .2, 1) var(--d); }
  .ms-ly.is-in .ms-ly__bar { transform: none; transition: transform 2.2s cubic-bezier(.3, .6, .2, 1) .5s; }
  .ms-ly.is-in .ms-ly__mark { opacity: 1; transition: opacity .8s ease 1.6s; }
  @media (max-width: 760px) {
    .ms-ly__row { grid-template-columns: 1fr auto; row-gap: 14px; padding: 22px 0 18px; }
    .ms-ly__track { grid-column: 1 / -1; grid-row: 2; }
    .ms-ly__row--ours .ms-ly__track { margin-top: 40px; }
    .ms-ly__row--axis { grid-template-columns: 1fr; }
    .ms-ly__row--axis .ms-ly__lab, .ms-ly__row--axis > div:last-child { display: none; }
    .ms-ly__ticks { grid-column: 1 / -1; grid-row: auto; }
    .ms-ly__mark span { font-size: 9.5px; letter-spacing: .14em; white-space: normal; width: 210px; text-align: center; line-height: 1.5; top: -14px; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-ly.is-ready .ms-ly__seg, .ms-ly.is-ready .ms-ly__bar { transform: none; } .ms-ly.is-ready .ms-ly__mark { opacity: 1; } }
</style>
<script>
  (function () {
    var root = document.getElementById('ms-ly-{{ section.id }}');
    if (!root || root.dataset.msReady) return;
    root.dataset.msReady = '1';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('is-ready');
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { root.classList.add('is-in'); io.disconnect(); } }); }, { threshold: .35 });
    io.observe(root.querySelector('.ms-ly__chart'));
    // never left undrawn
    setTimeout(function () { if (!root.classList.contains('is-in') && root.getBoundingClientRect().top < innerHeight) root.classList.add('is-in'); }, 4000);
  })();
</script>

{% schema %}
{
  "name": "Thirty years",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Thirty years" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One mattress, thirty years." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Most industrial mattresses are replaced every eight to ten years. A Midsummer mattress goes back to the artisans who made it at fifteen, and comes home for fifteen more." },
    { "type": "range", "id": "industrial_years", "label": "An industrial mattress lasts (years)", "min": 5, "max": 15, "step": 1, "default": 9, "info": "Most industrial mattresses end up in landfill after eight or ten years." },
    { "type": "text", "id": "label_industrial", "label": "First line", "default": "An industrial mattress" },
    { "type": "text", "id": "label_ours", "label": "Second line", "default": "A Midsummer mattress" },
    { "type": "text", "id": "regen_label", "label": "Mark at year fifteen", "default": "Year 15 · renewed by hand in Italy" },
    { "type": "text", "id": "years_label", "label": "Axis label", "default": "Years" },
    { "type": "text", "id": "mattresses_label", "label": "Count: mattresses", "default": "mattresses" },
    { "type": "text", "id": "mattress_label", "label": "Count: mattress", "default": "mattress" },
    { "type": "textarea", "id": "footnote", "label": "Note", "info": "[n] is replaced by how many industrial mattresses are thrown away in thirty years.", "default": "In thirty years, [n] industrial mattresses are thrown away, against none of ours. An illustration from the usual life of an industrial mattress, not a forecast." }
  ],
  "presets": [ { "name": "Thirty years" } ]
}
{% endschema %}
