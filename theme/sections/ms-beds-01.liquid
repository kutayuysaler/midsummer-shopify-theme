<section data-dc-tpl="667" data-ms-centred="" style="padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px) clamp(40px, 5vw, 80px); max-width: 1560px; margin: 0px auto;"><div style="max-width: calc(1120px - 2 * clamp(18px, 5vw, 80px));">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{% render 'ms-t', v: section.settings.t1 %}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(38px, 6vw, 84px); line-height: 1; letter-spacing: -0.035em; margin-top: 22px;">{% render 'ms-t', v: section.settings.t2 %}</h1>
<p style="font-size: 16px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 28px; max-width: 58ch;">{% render 'ms-t', v: section.settings.t3 %}</p>
</div></section>
{% schema %}
{
  "name": "Our Beds 01 · Collections",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Collections",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Handmade Italian beds, mattresses …",
      "default": "Handmade Italian beds, mattresses and toppers."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Three collections…",
      "default": "Three collections of systems. What changes between them is the cloth, the fibres and how far the bespoke goes."
    }
  ]
}
{% endschema %}
