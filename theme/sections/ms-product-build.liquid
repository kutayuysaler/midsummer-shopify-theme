    { "type": "text", "id": "l7_group", "label": "Group", "default": "Base" },
    { "type": "select", "id": "l7_texture", "label": "Texture", "default": "wood", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l7_note", "label": "Note", "default": "A slender fir-wood frame that defines the geometry of the bed. Built to your height, and in sections where a staircase requires it." }
  ]
}
{% endschema %}
