</div>
</div>
</section>
<script type="application/json" data-ms-build-data>[{"group": {{ section.settings.l1_group | json }}, "note": {{ section.settings.l1_note | json }}}, {"group": {{ section.settings.l2_group | json }}, "note": {{ section.settings.l2_note | json }}}, {"group": {{ section.settings.l3_group | json }}, "note": {{ section.settings.l3_note | json }}}, {"group": {{ section.settings.l4_group | json }}, "note": {{ section.settings.l4_note | json }}}, {"group": {{ section.settings.l5_group | json }}, "note": {{ section.settings.l5_note | json }}}, {"group": {{ section.settings.l6_group | json }}, "note": {{ section.settings.l6_note | json }}}, {"group": {{ section.settings.l7_group | json }}, "note": {{ section.settings.l7_note | json }}}]</script>
<script>
(function () {
  var root = document.currentScript.previousElementSibling.previousElementSibling;
  var data = JSON.parse(document.currentScript.previousElementSibling.textContent);
  var stack = root.querySelector('[data-ms="buildstack"]');
  if (!stack) return;
  var bands = stack.querySelectorAll('button[aria-label][data-ms-layer]');
  var labels = stack.querySelectorAll('[data-ms="layerlabel"]');
  var n = bands.length;
  function pick(i) {
    bands.forEach(function (b, k) {
      var on = k === i;
      b.style.background = on ? '#17140F' : (k % 2 ? '#E8E0D1' : '#F1EADD');
      b.style.borderTopColor = on ? '#17140F' : '#DED5C4';
      if (k === n - 1) b.style.borderBottomColor = on ? '#17140F' : '#DED5C4';
    });
    labels.forEach(function (l, k) {
      var on = k === i;
      l.style.color = on ? '#17140F' : '#6E675C';
      var sp = l.querySelectorAll('span');
      if (sp[0]) sp[0].style.background = on ? '#17140F' : '#DED5C4';
      if (sp[2]) sp[2].style.color = on ? '#7E623B' : '#6E675C';
    });
    var d = data[i] || {};
    var lab = labels[i] && labels[i].querySelectorAll('span')[1];
    var g = root.querySelector('[data-ms-layer-group]'); if (g) g.textContent = d.group || '';
    var nm = root.querySelector('[data-ms-layer-name]'); if (nm && lab) nm.textContent = lab.textContent;
    var nt = root.querySelector('[data-ms-layer-note]'); if (nt) nt.textContent = d.note || '';
  }
  stack.addEventListener('click', function (e) { var b = e.target.closest('[data-ms-layer]'); if (b) pick(+b.getAttribute('data-ms-layer')); });
  stack.addEventListener('mouseover', function (e) { var b = e.target.closest('[data-ms-layer]'); if (b) pick(+b.getAttribute('data-ms-layer')); });
})();
</script>
