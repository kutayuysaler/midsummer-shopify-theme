{%- comment -%}
  The build, in section: each product's own layers, from the top of the bed down, as
  set out in the Models & Layers book. Every layer is a block (name, part of the bed,
  depth by feel, texture, note); a new part (topper, mattress, boxspring) starts a new
  piece in the drawing. Depths are drawn by feel, never given in figures. With no
  layers the section is not shown.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{%- liquid
  assign words = section.settings.count_words | split: ','
  assign n = section.blocks.size
  assign nw = n
  if n <= words.size
    assign wi = n | minus: 1
    assign nw = words[wi] | strip
  endif
  assign heading = section.settings.heading | replace: '[count]', nw
  assign part_list = ''
  for block in section.blocks
    assign g = block.settings.group | strip | append: '§'
    unless part_list contains g
      assign part_list = part_list | append: g
    endunless
  endfor
  assign part_names = part_list | split: '§'
  assign parts = part_names.size
-%}
<section class="ms-bd" data-ms-bd>
  <div class="ms-bd__in">
    <header class="ms-bd__head">
      <div class="ms-bd__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="ms-bd__title">{{ heading }}</h2>
      {%- if section.settings.intro != blank -%}<p class="ms-bd__intro">{{ section.settings.intro }}</p>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        {%- if section.settings.link != blank -%}
          <a class="ms-bd__link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- elsif section.settings.link_place != blank -%}
          <a class="ms-bd__link" href="{% render 'ms-link', to: section.settings.link_place %}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      {%- endif -%}
    </header>

    <div class="ms-bd__grid">
      <div class="ms-bd__drawing">
        <div class="ms-bd__rule"><span>{{ section.settings.drawing_label }}</span><span>{{ section.settings.scale_label }}</span></div>
        <div class="ms-bd__stack">
          {%- if parts == 0 -%}{%- assign part_names = 'x' | split: ',' -%}{%- endif -%}
          {%- for part in part_names -%}
            <div class="ms-bd__part">
              {%- if parts > 0 -%}<div class="ms-bd__pname">{{ part }}</div>{%- endif -%}
              {%- for block in section.blocks -%}
                {%- assign g = block.settings.group | strip -%}
                {%- if parts > 0 and g != part -%}{%- continue -%}{%- endif -%}
                {%- liquid
                  case block.settings.depth
                    when 'fine'
                      assign h = 22
                      assign depth = section.settings.word_1
                    when 'light'
                      assign h = 30
                      assign depth = section.settings.word_2
                    when 'generous'
                      assign h = 42
                      assign depth = section.settings.word_3
                    when 'deep'
                      assign h = 56
                      assign depth = section.settings.word_4
                    else
                      assign h = 72
                      assign depth = section.settings.word_5
                  endcase
                  assign num = forloop.index
                  if num < 10
                    assign num = '0' | append: num
                  endif
                -%}
                <button type="button" class="ms-bd__layer tex-{{ block.settings.texture }}" data-ms-bd-layer="{{ forloop.index0 }}" style="--h: {{ h }}px;" aria-label="{{ block.settings.name | escape }}, {{ depth | downcase | escape }}" data-depth="{{ depth | escape }}" {{ block.shopify_attributes }}>
                  <span class="ms-bd__band"></span>
                  <span class="ms-bd__label">
                    <span class="ms-bd__lead"></span>
                    <span class="ms-bd__num">{{ num }}</span>
                    <span class="ms-bd__name">{{ block.settings.name }}</span>
                    <span class="ms-bd__cm">{{ depth }}</span>
                  </span>
                </button>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="ms-bd__note">
        <div aria-live="polite">
          <div class="ms-bd__count"><span data-ms-bd-n>01</span> / {% if n < 10 %}0{% endif %}{{ n }}</div>
          <div class="ms-bd__group" data-ms-bd-group></div>
          <h3 class="ms-bd__lname" data-ms-bd-name></h3>
          <div class="ms-bd__depth" data-ms-bd-depth></div>
          <p class="ms-bd__text" data-ms-bd-text></p>
        </div>
        <div class="ms-bd__steps">
          <button type="button" data-ms-bd-step="-1" aria-label="Layer above">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 10 8 5l5 5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
          </button>
          <button type="button" data-ms-bd-step="1" aria-label="Layer below">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
          </button>
        </div>
        {%- if section.settings.padding != blank -%}
          <div class="ms-bd__pad">
            <div class="ms-bd__padlabel">{{ section.settings.padding_label }}</div>
            <div class="ms-bd__padtext">{{ section.settings.padding }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
  <script type="application/json" data-ms-bd-data>[
    {%- for block in section.blocks -%}
      { "name": {{ block.settings.name | json }}, "group": {{ block.settings.group | json }}, "note": {{ block.settings.note | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
</section>

<style>
  .ms-bd { background: #17140F; color: #FBF9F5; padding: clamp(64px, 9vw, 150px) clamp(18px, 5vw, 80px); }
  .ms-bd__in { max-width: 1560px; margin: 0 auto; }
  .ms-bd__head { max-width: 760px; }
  .ms-bd__eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; }
  .ms-bd__title { font-family: Newsreader, Georgia, serif; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.06; letter-spacing: -0.03em; font-weight: 200; margin-top: clamp(20px, 2vw, 28px); }
  .ms-bd__intro { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, .72); margin-top: 20px; max-width: 56ch; }
  .ms-site .ms-bd__link { display: inline-block; margin-top: 26px; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #FBF9F5; border-bottom: 1px solid #B89A6E; padding-bottom: 6px; }
  .ms-bd__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr); gap: clamp(36px, 6vw, 110px); align-items: start; margin-top: clamp(40px, 5vw, 80px); }
  .ms-bd__rule { display: flex; justify-content: space-between; gap: 16px; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(251, 249, 245, .55); border-bottom: 1px solid rgba(251, 249, 245, .18); padding-bottom: 13px; }
  .ms-bd__stack { margin-top: 26px; }
  /* each part of the bed is its own piece: topper, mattress, boxspring */
  .ms-bd__part + .ms-bd__part { margin-top: 26px; }
  .ms-bd__pname { font-size: 10.5px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; margin-bottom: 10px; }
  .ms-bd__layer { position: relative; display: grid; grid-template-columns: min(46%, 340px) minmax(0, 1fr); align-items: center; width: 100%; height: var(--h); padding: 0; margin: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit; text-align: left; }
  .ms-bd__band { align-self: stretch; border-top: 1px solid rgba(23, 20, 15, .55); transition: filter .35s ease, box-shadow .35s ease, opacity .35s ease; opacity: .74; }
  .ms-bd__layer:first-of-type .ms-bd__band { border-radius: 3px 3px 0 0; }
  .ms-bd__layer:last-child .ms-bd__band { border-radius: 0 0 3px 3px; }
  .ms-bd__layer.is-on .ms-bd__band { opacity: 1; box-shadow: 0 0 0 1px #B89A6E, 0 18px 40px rgba(0, 0, 0, .45); position: relative; z-index: 1; filter: brightness(1.06); }
  .ms-bd__label { display: flex; align-items: baseline; gap: 12px; min-width: 0; color: rgba(251, 249, 245, .55); transition: color .3s ease; }
  .ms-bd__lead { flex: 0 0 auto; align-self: center; width: clamp(16px, 3vw, 40px); height: 1px; background: rgba(251, 249, 245, .22); transition: background .3s ease; }
  .ms-bd__num { font-size: 10px; letter-spacing: .14em; color: #B89A6E; font-variant-numeric: tabular-nums; }
  .ms-bd__name { font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.3vw, 17px); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
  .ms-bd__cm { margin-left: auto; padding-left: 10px; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; white-space: nowrap; }
  .ms-bd__layer:hover .ms-bd__label, .ms-bd__layer.is-on .ms-bd__label { color: #FBF9F5; }
  .ms-bd__layer.is-on .ms-bd__lead { background: #B89A6E; }
  .ms-bd__layer:focus-visible { outline: 1px solid #B89A6E; outline-offset: 2px; }

  /* the materials, drawn */
  .tex-cloth .ms-bd__band { background: repeating-linear-gradient(90deg, rgba(150, 128, 98, .28) 0 1px, transparent 1px 3px), repeating-linear-gradient(0deg, rgba(150, 128, 98, .22) 0 1px, transparent 1px 3px), #E6DCC9; }
  .tex-silk .ms-bd__band { background: linear-gradient(100deg, #E2D6C0 0%, #F3ECDE 38%, #DCCFB8 62%, #EEE5D4 100%); }
  .tex-alpaca .ms-bd__band { background: radial-gradient(circle at 3px 3px, #CDBFA6 1.3px, transparent 1.6px) 0 0 / 7px 7px, #EDE4D3; }
  .tex-wool .ms-bd__band { background: repeating-linear-gradient(135deg, #D9CBB2 0 1px, transparent 1px 6px), repeating-linear-gradient(45deg, #D9CBB2 0 1px, transparent 1px 6px), #E8DDC9; }
  .tex-felt .ms-bd__band { background: radial-gradient(circle at 2px 2px, rgba(110, 94, 69, .22) .8px, transparent 1px) 0 0 / 4px 4px, #C9BBA1; }
  .tex-micro .ms-bd__band { background: radial-gradient(circle at 50% 50%, transparent 2.2px, #9C8B6E 2.4px 3px, transparent 3.2px) 0 0 / 9px 9px, #E2D6C0; }
  .tex-springs .ms-bd__band { background: repeating-linear-gradient(90deg, transparent 0 17px, rgba(120, 102, 74, .35) 17px 18px), repeating-linear-gradient(0deg, transparent 0 5px, rgba(120, 102, 74, .22) 5px 6px), linear-gradient(#DCCFB6, #D0C1A5); }
  .tex-horsehair .ms-bd__band { background: repeating-linear-gradient(170deg, #6E5E45 0 1px, transparent 1px 5px), repeating-linear-gradient(10deg, #7C6A4E 0 1px, transparent 1px 7px), #CBB995; }
  .tex-wood .ms-bd__band { background: repeating-linear-gradient(0deg, #A4855C 0 2px, #B8976A 2px 9px, #AE8D61 9px 11px, #BF9E71 11px 19px); }
  .tex-plain .ms-bd__band { background: #E8E0D1; }

  .ms-bd__note { position: sticky; top: 130px; border-top: 1px solid #B89A6E; padding-top: 22px; }
  .ms-bd__count { font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgba(251, 249, 245, .55); font-variant-numeric: tabular-nums; }
  .ms-bd__count span { color: #FBF9F5; }
  .ms-bd__group { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; margin-top: 28px; min-height: 1.2em; }
  .ms-bd__lname { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.2vw, 46px); line-height: 1.1; letter-spacing: -0.03em; font-weight: 200; margin-top: 16px; }
  .ms-bd__depth { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(18px, 1.8vw, 22px); color: rgba(251, 249, 245, .72); margin-top: 10px; }
  .ms-bd__text { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, .78); margin-top: 20px; max-width: 46ch; min-height: 5.9em; }
  .ms-bd__steps { display: flex; gap: 8px; margin-top: 24px; }
  .ms-bd__steps button { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: none; border: 1px solid rgba(251, 249, 245, .28); color: #FBF9F5; cursor: pointer; transition: border-color .2s ease; }
  .ms-bd__steps button:hover { border-color: #FBF9F5; }
  .ms-bd__pad { margin-top: 40px; border-top: 1px solid rgba(251, 249, 245, .18); padding-top: 20px; }
  .ms-bd__padlabel { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; }
  .ms-bd__padtext { font-size: 14px; line-height: 1.85; color: rgba(251, 249, 245, .72); margin-top: 12px; max-width: 46ch; }
  .ms-bd__padtext p { margin: 0 0 8px; }
  .ms-bd__padtext strong { font-weight: 400; color: #FBF9F5; }

  @media (max-width: 900px) {
    .ms-bd__grid { grid-template-columns: minmax(0, 1fr); }
    .ms-bd__layer { grid-template-columns: 34% minmax(0, 1fr); }
    .ms-bd__note { position: static; }
    .ms-bd__text { min-height: 0; }
  }
  @media (max-width: 520px) {
    .ms-bd__cm { display: none; }
    .ms-bd__num { display: none; }
    .ms-bd__lead { width: 12px; }
  }
</style>

<script>
  (function () {
    var root = document.currentScript.parentElement.querySelector('[data-ms-bd]');
    if (!root) return;
    var data = JSON.parse(root.querySelector('[data-ms-bd-data]').textContent);
    var layers = root.querySelectorAll('[data-ms-bd-layer]');
    if (!layers.length) return;
    // open on the first spring layer: the heart of the build
    var first = root.querySelector('.tex-springs, .tex-micro');
    var at = first ? +first.getAttribute('data-ms-bd-layer') : 0;
    function pick(i) {
      at = (i + layers.length) % layers.length;
      var el = layers[0];
      layers.forEach(function (l) { var on = +l.getAttribute('data-ms-bd-layer') === at; if (on) el = l; l.classList.toggle('is-on', on); l.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      var d = data[at] || {};
      root.querySelector('[data-ms-bd-n]').textContent = (at + 1 < 10 ? '0' : '') + (at + 1);
      root.querySelector('[data-ms-bd-group]').textContent = d.group || '';
      root.querySelector('[data-ms-bd-name]').textContent = d.name || '';
      root.querySelector('[data-ms-bd-depth]').textContent = el.getAttribute('data-depth') || '';
      root.querySelector('[data-ms-bd-text]').textContent = d.note || '';
    }
    root.addEventListener('click', function (e) {
      var l = e.target.closest('[data-ms-bd-layer]');
      if (l) { pick(+l.getAttribute('data-ms-bd-layer')); return; }
      var s = e.target.closest('[data-ms-bd-step]');
      if (s) pick(at + +s.getAttribute('data-ms-bd-step'));
    });
    root.addEventListener('mouseover', function (e) {
      var l = e.target.closest('[data-ms-bd-layer]');
      if (l && window.matchMedia('(hover: hover)').matches) pick(+l.getAttribute('data-ms-bd-layer'));
    });
    pick(at);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product · The build",
  "settings": [
    { "type": "paragraph", "content": "Add one Layer block per layer, from the top of the bed down. A new Part name (Topper, Mattress, Boxspring) starts a new piece in the drawing. With no layers the section is not shown." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The build, in section" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[count] becomes the number of layers, in words.", "default": "[count] layers, laid by hand." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Every layer is laid by hand, in the order shown, each in the natural material it is named for. Move along the drawing to read what each one does." },
    { "type": "text", "id": "link_label", "label": "Link (optional)" },
    { "type": "url", "id": "link", "label": "Link address" },
    { "type": "select", "id": "link_place", "label": "Or link to", "default": "", "options": [{"value":"","label":"Nothing"},{"value":"essentials","label":"Essentials"},{"value":"signature","label":"Signature"},{"value":"icons","label":"Icons"},{"value":"materials","label":"Natural materials"}] },
    { "type": "text", "id": "drawing_label", "label": "Drawing label", "default": "From the top down" },
    { "type": "text", "id": "scale_label", "label": "Scale note", "default": "Indicative, not to scale" },
    { "type": "textarea", "id": "count_words", "label": "Numbers in words", "default": "One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten,Eleven,Twelve,Thirteen,Fourteen,Fifteen,Sixteen,Seventeen,Eighteen,Nineteen,Twenty,Twenty-one,Twenty-two,Twenty-three,Twenty-four,Twenty-five,Twenty-six,Twenty-seven,Twenty-eight,Twenty-nine,Thirty,Thirty-one,Thirty-two,Thirty-three,Thirty-four,Thirty-five,Thirty-six,Thirty-seven,Thirty-eight,Thirty-nine,Forty" },
    { "type": "header", "content": "Depth words" },
    { "type": "paragraph", "content": "Depths are never shown in figures; each layer's depth is drawn by feel, with one of these words beside it." },
    { "type": "text", "id": "word_1", "label": "Fine", "default": "Fine" },
    { "type": "text", "id": "word_2", "label": "Light", "default": "Light" },
    { "type": "text", "id": "word_3", "label": "Generous", "default": "Generous" },
    { "type": "text", "id": "word_4", "label": "Deep", "default": "Deep" },
    { "type": "text", "id": "word_5", "label": "Foundation", "default": "Foundation" },
    { "type": "header", "content": "Padding by season" },
    { "type": "text", "id": "padding_label", "label": "Label", "default": "The padding, by season" },
    { "type": "richtext", "id": "padding", "label": "Composition (optional)" }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Cheviot wool" },
        { "type": "text", "id": "group", "label": "Part of the bed", "default": "Mattress" },
        { "type": "select", "id": "depth", "label": "Depth, drawn by feel", "default": "light", "options": [{"value":"fine","label":"Fine"},{"value":"light","label":"Light"},{"value":"generous","label":"Generous"},{"value":"deep","label":"Deep"},{"value":"foundation","label":"Foundation"}] },
        { "type": "select", "id": "texture", "label": "Texture", "default": "wool", "options": [{"value":"cloth","label":"Cloth"},{"value":"silk","label":"Silk"},{"value":"alpaca","label":"Fine hair"},{"value":"wool","label":"Wool"},{"value":"felt","label":"Felt"},{"value":"horsehair","label":"Horsehair"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
        { "type": "textarea", "id": "note", "label": "Note" }
      ]
    }
  ]
}
{% endschema %}
