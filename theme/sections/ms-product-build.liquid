    { "type": "text", "id": "l6_group", "label": "Group", "default": "Mattress" },
    { "type": "select", "id": "l6_texture", "label": "Texture", "default": "horsehair", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l6_note", "label": "Note", "default": "Beneath the core, horsehair for resilience and Cheviot wool for temperature. Both can be opened, washed and laid again at the fifteen-year regeneration." },
    { "type": "header", "content": "Layer 7" },
    { "type": "text", "id": "l7_name", "label": "Name", "default": "Boxspring" },
    { "type": "number", "id": "l7_cm", "label": "Depth (cm), not shown", "default": 18 },
    { "type": "text", "id": "l7_group", "label": "Group", "default": "Base" },
    { "type": "select", "id": "l7_texture", "label": "Texture", "default": "wood", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l7_note", "label": "Note", "default": "A slender fir-wood frame that defines the geometry of the bed. Built to your height, and in sections where a staircase requires it." }
  ]
}
{% endschema %}
