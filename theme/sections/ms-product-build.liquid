{%- comment -%}
  The build, in section: every layer in its order, each with the texture of what it is
  made of. Depths are drawn by feel, not to scale, and never given in figures. Hover or
  tap a layer; the note on the right follows.
{%- endcomment -%}
{%- liquid
  assign total = 0
  for i in (1..7)
    assign k = 'l' | append: i | append: '_cm'
    assign cm = section.settings[k]
    if cm <= 2
      assign total = total | plus: 26
    elsif cm <= 5
      assign total = total | plus: 58
    elsif cm <= 9
      assign total = total | plus: 90
    elsif cm <= 14
      assign total = total | plus: 136
    else
      assign total = total | plus: 172
    endif
  endfor
  assign ticks = total | divided_by: 12
-%}
<section class="ms-bd" data-ms-bd>
  <div class="ms-bd__in">
    <header class="ms-bd__head">
      <div class="ms-bd__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="ms-bd__title">{{ section.settings.heading }}</h2>
      <p class="ms-bd__intro">{{ section.settings.intro }}</p>
    </header>

    <div class="ms-bd__grid">
      <div class="ms-bd__drawing">
        <div class="ms-bd__rule"><span>{{ section.settings.drawing_label }}</span><span>{{ section.settings.scale_label }}</span></div>
        <div class="ms-bd__stack" style="--h: {{ total }}px;">
          <div class="ms-bd__ruler" aria-hidden="true">
            {%- for t in (0..ticks) -%}{%- assign m = t | modulo: 4 -%}
              <span{% if m == 0 %} class="is-major"{% endif %} style="top: {{ t | times: 12 }}px;"></span>
            {%- endfor -%}
          </div>
          {%- assign top = 0 -%}
          {%- for i in (1..7) -%}
            {%- liquid
              assign kn = 'l' | append: i | append: '_name'
              assign kc = 'l' | append: i | append: '_cm'
              assign kt = 'l' | append: i | append: '_texture'
              assign cm = section.settings[kc]
              if cm <= 2
                assign h = 26
                assign depth = section.settings.word_1
              elsif cm <= 5
                assign h = 58
                assign depth = section.settings.word_2
              elsif cm <= 9
                assign h = 90
                assign depth = section.settings.word_3
              elsif cm <= 14
                assign h = 136
                assign depth = section.settings.word_4
              else
                assign h = 172
                assign depth = section.settings.word_5
              endif
            -%}
            <button type="button" class="ms-bd__layer tex-{{ section.settings[kt] }}{% if forloop.index == 5 %} is-on{% endif %}" data-ms-bd-layer="{{ forloop.index0 }}" style="top: {{ top }}px; height: {{ h }}px;" aria-label="{{ section.settings[kn] | escape }}, {{ depth | downcase | escape }}" data-depth="{{ depth | escape }}">
              <span class="ms-bd__band"></span>
              <span class="ms-bd__label" style="--mid: {{ h | divided_by: 2.0 }}px;">
                <span class="ms-bd__lead"></span>
                <span class="ms-bd__num">{{ forloop.index | prepend: '0' }}</span>
                <span class="ms-bd__name">{{ section.settings[kn] }}</span>
                <span class="ms-bd__cm">{{ depth }}</span>
              </span>
            </button>
            {%- assign top = top | plus: h -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="ms-bd__note" aria-live="polite">
        <div class="ms-bd__count"><span data-ms-bd-n>05</span> / 07</div>
        <div class="ms-bd__group" data-ms-bd-group></div>
        <h3 class="ms-bd__lname" data-ms-bd-name></h3>
        <div class="ms-bd__depth" data-ms-bd-depth></div>
        <p class="ms-bd__text" data-ms-bd-text></p>
        <div class="ms-bd__steps">
          <button type="button" data-ms-bd-step="-1" aria-label="Layer above">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 10 8 5l5 5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
          </button>
          <button type="button" data-ms-bd-step="1" aria-label="Layer below">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" data-ms-bd-data>[
    {%- for i in (1..7) -%}
      {%- assign kn = 'l' | append: i | append: '_name' -%}{%- assign kg = 'l' | append: i | append: '_group' -%}{%- assign kx = 'l' | append: i | append: '_note' -%}
      { "name": {{ section.settings[kn] | json }}, "group": {{ section.settings[kg] | json }}, "note": {{ section.settings[kx] | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
</section>

<style>
  .ms-bd { background: #17140F; color: #FBF9F5; padding: clamp(64px, 9vw, 150px) clamp(18px, 5vw, 80px); }
  .ms-bd__in { max-width: 1560px; margin: 0 auto; }
  .ms-bd__head { max-width: 760px; }
  .ms-bd__eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; }
  .ms-bd__title { font-family: Newsreader, Georgia, serif; font-size: clamp(32px, 4.4vw, 64px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 200; margin-top: 18px; }
  .ms-bd__intro { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, .72); margin-top: 20px; max-width: 56ch; }
  .ms-bd__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(280px, 5fr); gap: clamp(36px, 6vw, 110px); align-items: start; margin-top: clamp(40px, 5vw, 80px); }
  .ms-bd__rule { display: flex; justify-content: space-between; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(251, 249, 245, .55); border-bottom: 1px solid rgba(251, 249, 245, .18); padding: 0 0 13px 44px; }
  .ms-bd__stack { position: relative; height: var(--h); margin-top: 10px; margin-left: 44px; }
  .ms-bd__ruler { position: absolute; left: -44px; top: 0; bottom: 0; width: 30px; border-right: 1px solid rgba(251, 249, 245, .22); }
  .ms-bd__ruler span { position: absolute; right: 0; width: 5px; height: 1px; background: rgba(251, 249, 245, .22); }
  .ms-bd__ruler span.is-major { width: 11px; background: rgba(251, 249, 245, .45); }
    .ms-bd__layer { position: absolute; left: 0; right: 0; display: block; padding: 0; margin: 0; border: 0; background: none; cursor: pointer; color: inherit; font: inherit; text-align: left; }
  .ms-bd__band { position: absolute; left: 0; top: 0; bottom: 0; width: min(46%, 340px); border-top: 1px solid rgba(23, 20, 15, .55); transition: filter .35s ease, box-shadow .35s ease, opacity .35s ease; opacity: .78; }
  .ms-bd__layer.is-on .ms-bd__band { opacity: 1; box-shadow: 0 0 0 1px #B89A6E, 0 18px 40px rgba(0, 0, 0, .45); z-index: 1; filter: brightness(1.06); }
  .ms-bd__label { position: absolute; left: min(46%, 340px); right: 0; top: var(--mid); transform: translateY(-50%); display: flex; align-items: baseline; gap: 12px; color: rgba(251, 249, 245, .55); transition: color .3s ease; }
  .ms-bd__lead { flex: 0 0 auto; align-self: center; width: clamp(16px, 3vw, 40px); height: 1px; background: rgba(251, 249, 245, .22); transition: background .3s ease; }
  .ms-bd__num { font-size: 10px; letter-spacing: .14em; color: #B89A6E; font-variant-numeric: tabular-nums; }
  .ms-bd__name { font-family: Newsreader, Georgia, serif; font-size: clamp(15px, 1.5vw, 19px); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ms-bd__cm { margin-left: auto; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; white-space: nowrap; }
  .ms-bd__layer:hover .ms-bd__label, .ms-bd__layer.is-on .ms-bd__label { color: #FBF9F5; }
  .ms-bd__layer.is-on .ms-bd__lead { background: #B89A6E; }
  .ms-bd__layer:focus-visible { outline: 1px solid #B89A6E; outline-offset: 2px; }

  /* the materials, drawn */
  .tex-silk .ms-bd__band { background: repeating-linear-gradient(90deg, #E9DFCC 0 2px, #DCCFB8 2px 4px); }
  .tex-alpaca .ms-bd__band { background: radial-gradient(circle at 3px 3px, #CDBFA6 1.3px, transparent 1.6px) 0 0 / 7px 7px, #EDE4D3; }
  .tex-wool .ms-bd__band { background: repeating-linear-gradient(135deg, #D9CBB2 0 1px, transparent 1px 6px), repeating-linear-gradient(45deg, #D9CBB2 0 1px, transparent 1px 6px), #E8DDC9; }
  .tex-micro .ms-bd__band { background: radial-gradient(circle at 50% 50%, transparent 2.2px, #9C8B6E 2.4px 3px, transparent 3.2px) 0 0 / 9px 9px, #E2D6C0; }
  .tex-springs .ms-bd__band { background: repeating-linear-gradient(90deg, transparent 0 17px, rgba(120, 102, 74, .35) 17px 18px), repeating-linear-gradient(0deg, transparent 0 5px, rgba(120, 102, 74, .22) 5px 6px), linear-gradient(#DCCFB6, #D0C1A5); }
  .tex-horsehair .ms-bd__band { background: repeating-linear-gradient(170deg, #6E5E45 0 1px, transparent 1px 5px), repeating-linear-gradient(10deg, #7C6A4E 0 1px, transparent 1px 7px), #CBB995; }
  .tex-wood .ms-bd__band { background: repeating-linear-gradient(0deg, #A4855C 0 2px, #B8976A 2px 9px, #AE8D61 9px 11px, #BF9E71 11px 19px); }
  .tex-plain .ms-bd__band { background: #E8E0D1; }

  .ms-bd__note { position: sticky; top: 130px; border-top: 1px solid #B89A6E; padding-top: 22px; }
  .ms-bd__count { font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgba(251, 249, 245, .55); font-variant-numeric: tabular-nums; }
  .ms-bd__count span { color: #FBF9F5; }
  .ms-bd__group { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #B89A6E; margin-top: 28px; }
  .ms-bd__lname { font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 3.6vw, 52px); line-height: 1.05; letter-spacing: -0.03em; font-weight: 200; margin-top: 12px; }
  .ms-bd__depth { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(18px, 1.8vw, 22px); color: rgba(251, 249, 245, .72); margin-top: 10px; }
  .ms-bd__text { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, .78); margin-top: 20px; max-width: 46ch; min-height: 7.8em; }
  .ms-bd__steps { display: flex; gap: 8px; margin-top: 28px; }
  .ms-bd__steps button { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: none; border: 1px solid rgba(251, 249, 245, .28); color: #FBF9F5; cursor: pointer; transition: border-color .2s ease; }
  .ms-bd__steps button:hover { border-color: #FBF9F5; }

  @media (max-width: 900px) {
    .ms-bd__grid { grid-template-columns: minmax(0, 1fr); }
    .ms-bd__band { width: 38%; }
    .ms-bd__label { left: 38%; }
    .ms-bd__note { position: static; }
    .ms-bd__text { min-height: 0; }
  }
  @media (max-width: 520px) {
    .ms-bd__cm { display: none; }
    .ms-bd__num { display: none; }
  }
</style>

<script>
  (function () {
    var root = document.currentScript.parentElement.querySelector('[data-ms-bd]');
    if (!root) return;
    var data = JSON.parse(root.querySelector('[data-ms-bd-data]').textContent);
    var layers = root.querySelectorAll('[data-ms-bd-layer]');
    var at = 4;
    function pick(i) {
      at = (i + layers.length) % layers.length;
      layers.forEach(function (l, k) { l.classList.toggle('is-on', k === at); l.setAttribute('aria-pressed', k === at ? 'true' : 'false'); });
      var d = data[at] || {};
      root.querySelector('[data-ms-bd-n]').textContent = (at + 1 < 10 ? '0' : '') + (at + 1);
      root.querySelector('[data-ms-bd-group]').textContent = d.group || '';
      root.querySelector('[data-ms-bd-name]').textContent = d.name || '';
      root.querySelector('[data-ms-bd-depth]').textContent = layers[at].getAttribute('data-depth') || '';
      root.querySelector('[data-ms-bd-text]').textContent = d.note || '';
    }
    root.addEventListener('click', function (e) {
      var l = e.target.closest('[data-ms-bd-layer]');
      if (l) { pick(+l.getAttribute('data-ms-bd-layer')); return; }
      var s = e.target.closest('[data-ms-bd-step]');
      if (s) pick(at + +s.getAttribute('data-ms-bd-step'));
    });
    root.addEventListener('mouseover', function (e) {
      var l = e.target.closest('[data-ms-bd-layer]');
      if (l && window.matchMedia('(hover: hover)').matches) pick(+l.getAttribute('data-ms-bd-layer'));
    });
    pick(at);
  })();
</script>

{% schema %}
{
  "name": "Product · The build",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The build, in section" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seven layers, laid by hand." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Every layer is laid by hand, in the order shown, each in the natural material it is named for. Move along the drawing to read what each one does." },
    { "type": "text", "id": "drawing_label", "label": "Drawing label", "default": "Section" },
    { "type": "text", "id": "scale_label", "label": "Scale note", "default": "Indicative, not to scale" },
    { "type": "paragraph", "content": "Depths are never shown in figures. Each layer's depth in cm only chooses how it is drawn and the word beside it:" },
    { "type": "text", "id": "word_1", "label": "Up to 2 cm", "default": "Fine" },
    { "type": "text", "id": "word_2", "label": "Up to 5 cm", "default": "Light" },
    { "type": "text", "id": "word_3", "label": "Up to 9 cm", "default": "Generous" },
    { "type": "text", "id": "word_4", "label": "Up to 14 cm", "default": "Deep" },
    { "type": "text", "id": "word_5", "label": "Deeper", "default": "Foundation" },
    { "type": "header", "content": "Layer 1" },
    { "type": "text", "id": "l1_name", "label": "Name", "default": "Seasonal upholstery" },
    { "type": "number", "id": "l1_cm", "label": "Depth (cm), not shown", "default": 1 },
    { "type": "text", "id": "l1_group", "label": "Group", "default": "Topper" },
    { "type": "select", "id": "l1_texture", "label": "Texture", "default": "silk", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l1_note", "label": "Note", "default": "Loro Piana Interiors on one face, linen and silk on the other. Turned when the season changes, so the bed is dressed twice a year without anything being replaced." },
    { "type": "header", "content": "Layer 2" },
    { "type": "text", "id": "l2_name", "label": "Name", "default": "Baby alpaca and silk" },
    { "type": "number", "id": "l2_cm", "label": "Depth (cm), not shown", "default": 5 },
    { "type": "text", "id": "l2_group", "label": "Group", "default": "Topper" },
    { "type": "select", "id": "l2_texture", "label": "Texture", "default": "alpaca", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l2_note", "label": "Note", "default": "The topper proper. Carded and laid by hand, it is the layer the body meets first and the one that is renewed most often." },
    { "type": "header", "content": "Layer 3" },
    { "type": "text", "id": "l3_name", "label": "Name", "default": "Cashmere and mohair" },
    { "type": "number", "id": "l3_cm", "label": "Depth (cm), not shown", "default": 4 },
    { "type": "text", "id": "l3_group", "label": "Group", "default": "Mattress" },
    { "type": "select", "id": "l3_texture", "label": "Texture", "default": "wool", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l3_note", "label": "Note", "default": "Above the springs, where body heat reaches it first. Warmth without weight — the quality clients describe as the bed disappearing." },
    { "type": "header", "content": "Layer 4" },
    { "type": "text", "id": "l4_name", "label": "Name", "default": "Micro springs" },
    { "type": "number", "id": "l4_cm", "label": "Depth (cm), not shown", "default": 3 },
    { "type": "text", "id": "l4_group", "label": "Group", "default": "Mattress" },
    { "type": "select", "id": "l4_texture", "label": "Texture", "default": "micro", "options": [{"value":"silk","label":"Fabric"},{"value":"alpaca","label":"Fleece"},{"value":"wool","label":"Wool"},{"value":"micro","label":"Micro springs"},{"value":"springs","label":"Pocket springs"},{"value":"horsehair","label":"Horsehair"},{"value":"wood","label":"Wood"},{"value":"plain","label":"Plain"}] },
    { "type": "textarea", "id": "l4_note", "label": "Note", "default": "A fine spring layer laid over the pocket core. It reads the body at a smaller scale than the core beneath can, which is what makes the surface feel continuous." },
