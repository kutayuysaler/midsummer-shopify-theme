{%- comment -%}
  A press page: each publication is its own blog (press-elle-decor, press-vanity-fair …)
  using the template blog.press. The publication's mark and name head the page, its
  clippings follow, and every other publication sits beneath, so a reader can move from
  one magazine to the next.
{%- endcomment -%}
{%- liquid
  assign here = nil
  for block in section.blocks
    assign h = block.settings.link | split: '/' | last
    if h == blog.handle
      assign here = block
    endif
  endfor
  assign pub = blog.title | remove: 'Press - ' | remove: 'Press – ' | remove: 'Press — ' | remove: 'Press: ' | remove: 'Press ' | strip
  if here
    assign pub = here.settings.name
  endif
-%}
<section class="ms-pb">
  <header class="ms-pb__head">
    <div class="ms-pb__eyebrow">{{ section.settings.eyebrow }}</div>
    {%- if here and here.settings.logo_file != blank -%}
      <img class="ms-pb__logo" src="{{ here.settings.logo_file | asset_url }}" alt="{{ pub | escape }}" width="320" height="80">
    {%- endif -%}
    <h1 class="ms-pb__title">{{ pub }}</h1>
    {%- if blog.articles_count > 0 -%}<p class="ms-pb__count">{{ blog.articles_count }} {% if blog.articles_count == 1 %}{{ section.settings.one_piece }}{% else %}{{ section.settings.pieces }}{% endif %}</p>{%- endif -%}
  </header>

  {%- paginate blog.articles by 12 -%}
  <div class="ms-pb__grid">
    {%- for article in blog.articles -%}
      <a class="ms-pb__piece" href="{{ article.url }}">
        <span class="ms-pb__img">
          {%- if article.image -%}
            <img src="{{ article.image | image_url: width: 1200 }}" srcset="{{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 1200 }} 1200w" sizes="(max-width: 760px) 92vw, 30vw" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="{% if forloop.index > 3 %}lazy{% else %}eager{% endif %}">
          {%- else -%}
            <span class="ms-pb__noimg">{{ pub }}</span>
          {%- endif -%}
        </span>
        <span class="ms-pb__meta">{{ article.published_at | date: '%B %Y' }}</span>
        <span class="ms-pb__ptitle">{{ article.title }}</span>
        {%- if article.excerpt != blank -%}<span class="ms-pb__excerpt">{{ article.excerpt | strip_html | truncatewords: 26 }}</span>{%- endif -%}
        <span class="ms-pb__read">{{ section.settings.read_label }}</span>
      </a>
    {%- else -%}
      <p class="ms-pb__empty">{{ section.settings.empty }}</p>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}
    <nav class="ms-pb__pages" aria-label="Pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ section.settings.prev_label }}</a>{%- endif -%}
      <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ section.settings.next_label }}</a>{%- endif -%}
    </nav>
  {%- endif -%}
  {%- endpaginate -%}

  {%- if section.blocks.size > 1 -%}
  <div class="ms-pb__others">
    <div class="ms-pb__label">{{ section.settings.others_label }}</div>
    <ul class="ms-pb__logos" role="list">
      {%- for block in section.blocks -%}
        {%- assign h = block.settings.link | split: '/' | last -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link }}"{% if h == blog.handle %} aria-current="page"{% endif %} title="{{ block.settings.name | escape }}">
            {%- if block.settings.logo_file != blank -%}
              <img src="{{ block.settings.logo_file | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="160" height="40">
            {%- else -%}{{ block.settings.name }}{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- endif -%}
</section>
<style>
  .ms-pb { --gut: clamp(18px, 5vw, 80px); }
  .ms-pb__head { max-width: 1560px; margin: 0 auto; padding: clamp(48px, 7vw, 120px) var(--gut) clamp(36px, 4vw, 64px); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .ms-pb__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-site img.ms-pb__logo { height: clamp(34px, 4vw, 56px); width: auto; max-width: min(420px, 80vw); margin-top: clamp(26px, 3vw, 40px); filter: grayscale(100%) brightness(.2) !important; }
  .ms-pb__title { font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 5vw, 72px); line-height: 1.02; letter-spacing: -.035em; font-weight: 200; margin-top: clamp(18px, 2vw, 28px); }
  .ms-pb__logo + .ms-pb__title { margin-top: clamp(20px, 2.2vw, 30px); font-size: clamp(20px, 2vw, 26px); letter-spacing: -.01em; font-style: italic; color: #6E675C; }
  .ms-pb__count { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #7E623B; margin-top: 18px; }
  .ms-pb__grid { max-width: 1560px; margin: 0 auto; padding: 0 var(--gut); display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: clamp(36px, 4vw, 64px) clamp(18px, 2.4vw, 40px); border-top: 1px solid #DDD6C9; padding-top: clamp(36px, 4vw, 64px); }
  .ms-site .ms-pb__piece { display: flex; flex-direction: column; color: #17140F; }
  .ms-pb__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #F1ECE3; }
  .ms-pb__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .ms-pb__piece:hover .ms-pb__img img { transform: scale(1.025); }
  .ms-pb__noimg { display: flex; align-items: center; justify-content: center; height: 100%; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 26px; color: #7E623B; }
  .ms-pb__meta { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #7E623B; margin-top: 18px; }
  .ms-pb__ptitle { font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 1.9vw, 25px); line-height: 1.25; letter-spacing: -.015em; margin-top: 10px; }
  .ms-pb__excerpt { font-size: 14px; line-height: 1.8; color: #4A443B; margin-top: 10px; }
  .ms-pb__read { font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; margin-top: 16px; border-bottom: 1px solid #17140F; padding-bottom: 5px; align-self: flex-start; }
  .ms-pb__empty { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 19px; color: #6E675C; grid-column: 1 / -1; text-align: center; padding: 30px 0; }
  .ms-pb__pages { display: flex; justify-content: center; gap: 28px; padding: 48px var(--gut) 0; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; }
  .ms-site .ms-pb__pages a { color: #17140F; border-bottom: 1px solid currentColor; }
  .ms-pb__others { max-width: 1560px; margin: clamp(64px, 8vw, 128px) auto 0; padding: clamp(40px, 5vw, 72px) var(--gut) clamp(64px, 8vw, 120px); border-top: 1px solid #DDD6C9; text-align: center; }
  .ms-pb__label { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-pb__logos { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 26px 44px; }
  .ms-site .ms-pb__logos a { display: flex; align-items: center; height: 40px; font-family: Newsreader, Georgia, serif; font-size: 16px; color: #6E675C; }
  .ms-site .ms-pb__logos img { height: 24px; width: auto; max-width: 150px; filter: grayscale(100%) opacity(.5) brightness(.8) !important; transition: filter .3s ease; }
  .ms-site .ms-pb__logos a:hover img, .ms-site .ms-pb__logos a[aria-current] img { filter: grayscale(100%) brightness(.15) !important; }
</style>
{% schema %}
{
  "name": "Press · Publication",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "In the press" },
    { "type": "text", "id": "pieces", "label": "Pieces", "default": "pieces" },
    { "type": "text", "id": "one_piece", "label": "One piece", "default": "piece" },
    { "type": "text", "id": "read_label", "label": "Read link", "default": "Read the piece" },
    { "type": "text", "id": "empty", "label": "No pieces yet", "default": "The pieces from this publication will appear here." },
    { "type": "text", "id": "prev_label", "label": "Previous", "default": "Previous" },
    { "type": "text", "id": "next_label", "label": "Next", "default": "Next" },
    { "type": "text", "id": "others_label", "label": "Other publications label", "default": "Also in" }
  ],
  "blocks": [
    {
      "type": "publication",
      "name": "Publication",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Publication" },
        { "type": "text", "id": "link", "label": "Its press blog", "info": "e.g. /blogs/press-elle-decor", "default": "/blogs/press" },
        { "type": "text", "id": "logo_file", "label": "Logo file in the theme", "info": "e.g. ms-press-elle-decor.svg" }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [ { "name": "Press · Publication" } ]
}
{% endschema %}
