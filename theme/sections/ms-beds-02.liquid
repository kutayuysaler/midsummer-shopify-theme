<section data-dc-tpl="671" style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 150px); display: flex; flex-direction: column; gap: clamp(48px, 7vw, 120px);">
<a href="{% render 'ms-link', to: 'essentials' %}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(24px, 5vw, 80px); align-items: center;">
<img width="1200" height="1500" alt="Essentials" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-bougainvillea.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/>
<div>
<div style="display: flex; align-items: baseline; gap: 16px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgb(126, 98, 59);">{{ section.settings.t1 }}</span><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.8vw, 52px); letter-spacing: -0.02em;">{{ section.settings.t2 }}</h2></div>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 20px; max-width: 50ch;">{{ section.settings.t3 }}</p>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; margin-top: 26px; color: rgb(110, 103, 92);">{{ section.settings.t4 }}</div>
</div>
</a>
<a href="{% render 'ms-link', to: 'signature' %}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(24px, 5vw, 80px); align-items: center;">
<div style="order: 2;"><img width="1200" height="1500" alt="Signature" loading="lazy" src="{% if section.settings.img2 != blank %}{{ section.settings.img2 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-ochre-room.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/></div>
<div style="order: 1;">
<div style="display: flex; align-items: baseline; gap: 16px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgb(126, 98, 59);">{{ section.settings.t5 }}</span><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.8vw, 52px); letter-spacing: -0.02em;">{{ section.settings.t6 }}</h2></div>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 20px; max-width: 50ch;">{{ section.settings.t7 }}</p>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; margin-top: 26px; color: rgb(110, 103, 92);">{{ section.settings.t8 }}</div>
</div>
</a>
<a href="{% render 'ms-link', to: 'icons' %}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(24px, 5vw, 80px); align-items: center;">
<img width="1200" height="1500" alt="Icons" loading="lazy" src="{% if section.settings.img3 != blank %}{{ section.settings.img3 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-arches.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/>
<div>
<div style="display: flex; align-items: baseline; gap: 16px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 15px; color: rgb(126, 98, 59);">{{ section.settings.t9 }}</span><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.8vw, 52px); letter-spacing: -0.02em;">{{ section.settings.t10 }}</h2></div>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 20px; max-width: 50ch;">{{ section.settings.t11 }}</p>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; margin-top: 26px; color: rgb(110, 103, 92);">{{ section.settings.t12 }}</div>
</div>
</a>
</section>
{% schema %}
{
  "name": "Our Beds 02 · I Essential",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: Essentials"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image: Signature"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Image: Icons"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "I",
      "default": "I"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Essentials",
      "default": "Essentials"
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "The entry point into the Midsummer…",
      "default": "The entry point into the Midsummer world. Natural fibres, authentic artisan construction, clean lines. Simplicity that gives up nothing: baby alpaca in the Raffaello, coloured linen in the Amalfi. The quality that defines us, in every detail."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Five systems — Essenziale, Raffael…",
      "default": "Five systems — Essenziale, Raffaello, Amalfi, Capri, Thin Topper"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "II",
      "default": "II"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "Signature",
      "default": "Signature"
    },
    {
      "type": "textarea",
      "id": "t7",
      "label": "The heart of the collection. Loro …",
      "default": "The heart of the collection. Loro Piana Interiors fabrics, exclusive blends of precious natural fibres: Yak, camel hair, silk, cashmere over spring architectures designed for the highest comfort. Sleep systems that can be specified like any architectural element, for demanding projects."
    },
    {
      "type": "text",
      "id": "t8",
      "label": "Seven systems — Bellagio, Vivaldi,…",
      "default": "Seven systems — Bellagio, Vivaldi, Monteverdi, Ultra Dry, Dreamy, Brera, Topper"
    },
    {
      "type": "text",
      "id": "t9",
      "label": "III",
      "default": "III"
    },
    {
      "type": "text",
      "id": "t10",
      "label": "Icons",
      "default": "Icons"
    },
    {
      "type": "textarea",
      "id": "t11",
      "label": "The most important pieces we make.…",
      "default": "The most important pieces we make. Six layers of springs, vicuña, cashmere, fully upholstered in Loro Piana Interiors. Completely bespoke, with no equivalent on the market. For projects where no detail is overlooked."
    },
    {
      "type": "text",
      "id": "t12",
      "label": "Twelve systems — Paisley, Top, Vic…",
      "default": "Twelve systems — Paisley, Top, Vicuña, Giotto Round and more"
    }
  ]
}
{% endschema %}
