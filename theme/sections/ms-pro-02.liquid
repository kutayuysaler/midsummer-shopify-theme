{%- liquid
  assign ms_show = true
  if template.suffix == blank
    capture ms_here
      render 'ms-link', to: 'professionals'
    endcapture
    if ms_here != page.url
      assign ms_show = false
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="867" style="padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(32px, 6vw, 110px);">
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(24px, 3.2vw, 42px); line-height: 1.3; letter-spacing: -0.015em;">{{ section.settings.t1 }}</p>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); max-width: 56ch; padding-top: clamp(0px, 2vw, 34px);">{{ section.settings.t2 }}</p>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Professionals 02 · We wor",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "We work the way you work: to a dra…",
      "default": "We work the way you work: to a drawing, to a fabric reference, to a date."
    },
    {
      "type": "textarea",
      "id": "t2",
      "label": "Every Midsummer system is made to …",
      "default": "Every Midsummer system is made to order by two artisans, which means dimensions, heights, fabrics and comfort levels are specification decisions rather than exceptions. Send us the plan and the fabric direction; we return a technical proposal, a sample set and a delivery window."
    }
  ]
}
{% endschema %}
