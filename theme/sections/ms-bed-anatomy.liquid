{%- comment -%}
  A bed with headboard, part by part: the bed drawn from its foot (its own headboard, cloth and
  legs, to scale), and beside it what each part is. Click the headboard, the mattress or the
  boxspring, in the drawing or in the list. Shown only on beds with headboards (snippets/ms-kind):
  on every other product it renders nothing, so it can sit in the default product template.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign show = false
  if template.name == 'product' and product != blank
    capture k
      render 'ms-kind', p: product
    endcapture
    assign kp = k | split: '|'
    if kp[0] == 'headboard'
      assign show = true
      assign bed = kp[2] | default: 'pure'
    endif
  elsif request.design_mode
    assign show = true
    assign bed = 'cashmere-couture'
  endif
-%}
{%- if show -%}
{%- liquid
  assign title = product.title | default: 'Cashmere Couture'
  capture line
    render 'ms-bed-data', key: bed, part: 'line'
  endcapture
  capture height
    render 'ms-bed-data', key: bed, part: 'height'
  endcapture
-%}
<section class="ms-ba" data-ms-ba data-bed="{{ bed }}" aria-labelledby="ba-{{ section.id }}">
  <div class="ms-ba__in">
    <div class="ms-ba__left">
      <div class="ms-ba__eyebrow">{{ s.eyebrow | replace: '[name]', title }}</div>
      <h2 class="ms-ba__title" id="ba-{{ section.id }}">{{ s.heading | replace: '[name]', title }}</h2>
      <p class="ms-ba__line">{{ line }}</p>
      <div class="ms-ba__picks" role="group" aria-label="{{ s.heading | replace: '[name]', title | escape }}">
        {%- assign parts = 'headboard,mattress,base' | split: ',' -%}
        {%- assign nums = 'I,II,III' | split: ',' -%}
        {%- for p in parts -%}
          {%- assign kt = p | append: '_title' -%}
          <button type="button" class="ms-ba__pk{% if forloop.first %} is-on{% endif %}" data-ba-open="{{ p }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"><span>{{ nums[forloop.index0] }}</span>{{ s[kt] }}</button>
        {%- endfor -%}
      </div>
      {%- for p in parts -%}
        {%- assign kt = p | append: '_title' -%}
        <div class="ms-ba__panel" data-ba-panel="{{ p }}"{% unless forloop.first %} hidden{% endunless %}>
          {%- case p -%}
            {%- when 'headboard' -%}
              <p class="ms-ba__lead">{% render 'ms-bed-data', key: bed, part: 'hb' %}</p>
              <dl class="ms-ba__rows">
                <div><dt>{{ s.uph_label }}</dt><dd>{% render 'ms-bed-data', key: bed, part: 'uph' %}</dd></div>
                <div><dt>{{ s.height_label }}</dt><dd>{{ height }} cm</dd></div>
                <div><dt>{{ s.width_label }}</dt><dd>{% render 'ms-bed-data', key: bed, part: 'width' %}</dd></div>
              </dl>
              {%- if bed == 'beating-of-wings' -%}<button type="button" class="ms-ba__flap" data-ba-flap>{{ s.wings_label }}</button>{%- endif -%}
            {%- when 'mattress' -%}
              <p class="ms-ba__lead">{{ s.mattress_text }}</p>
              <dl class="ms-ba__rows">
                <div><dt>{{ s.sizes_label }}</dt><dd>{{ s.sizes_value }}</dd></div>
              </dl>
              {%- if s.mattress_link != blank -%}<a class="ms-ba__link" href="{% render 'ms-link', to: 'mattresses' %}">{{ s.mattress_link }}<span aria-hidden="true">→</span></a>{%- endif -%}
            {%- else -%}
              <p class="ms-ba__lead">{% render 'ms-bed-data', key: bed, part: 'base' %}</p>
              <dl class="ms-ba__rows">
                <div><dt>{{ s.legs_label }}</dt><dd>{% render 'ms-bed-data', key: bed, part: 'legs' %}</dd></div>
              </dl>
          {%- endcase -%}
        </div>
      {%- endfor -%}
      <figure class="ms-ba__quote">
        <blockquote>{% render 'ms-bed-data', key: bed, part: 'quote' %}</blockquote>
        <figcaption>{% render 'ms-bed-data', key: bed, part: 'author' %}</figcaption>
      </figure>
      <div class="ms-ba__links">
        {%- if s.button != blank -%}<a class="ms-ba__btn" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-enquire>{{ s.button }}</a>{%- endif -%}
        {%- capture hbl -%}{% render 'ms-link', to: 'headboards', strict: true %}{%- endcapture -%}
        {%- if s.all_label != blank and hbl != blank -%}<a class="ms-ba__link" href="{{ hbl }}">{{ s.all_label }}<span aria-hidden="true">→</span></a>{%- endif -%}
      </div>
    </div>
    <div class="ms-ba__draw">
      {% render 'ms-bed-drawing', key: bed, u: section.id, crop: true, l_aria: title, l_headboard: s.headboard_title, l_mattress: s.mattress_title, l_base: s.base_title %}
      {%- if s.hint != blank -%}<p class="ms-ba__hint">{{ s.hint }}</p>{%- endif -%}
    </div>
  </div>
</section>

<style>
  .ms-ba { background: linear-gradient(170deg, #EFE9DF 0%, #E8E0D3 100%); padding: clamp(64px, 8vw, 128px) clamp(18px, 5vw, 80px); color: #17140F; }
  .ms-ba__in { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: center; }
  .ms-ba__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7A4532; }
  .ms-ba__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(32px, 3.6vw, 52px); line-height: 1.06; letter-spacing: -0.03em; margin-top: 16px; }
  .ms-ba__line { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(17px, 1.5vw, 20px); line-height: 1.55; color: #4A443B; margin-top: 16px; max-width: 40ch; }
  .ms-ba__picks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 28px; }
  .ms-ba__pk { display: inline-flex; align-items: center; gap: 9px; min-height: 40px; padding: 0 14px; border: 1px solid rgba(23, 20, 15, .22); background: transparent; font: inherit; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #4A443B; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .ms-ba__pk span { font-family: Newsreader, Georgia, serif; font-size: 13px; letter-spacing: 0; color: #7A4532; }
  .ms-ba__pk:hover { border-color: #17140F; color: #17140F; }
  .ms-ba__pk.is-on { background: #17140F; color: #FBF9F5; border-color: #17140F; }
  .ms-ba__pk.is-on span { color: #E5C9A8; }
  .ms-ba__panel { margin-top: 22px; min-height: 172px; animation: msBaIn .35s ease both; }
  @keyframes msBaIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .ms-ba__lead { font-size: 15px; line-height: 1.85; color: #2F2B25; max-width: 46ch; }
  .ms-ba__rows { margin: 16px 0 0; }
  .ms-ba__rows div { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 14px; padding: 10px 0; border-top: 1px solid rgba(23, 20, 15, .12); font-size: 13.5px; line-height: 1.6; }
  .ms-ba__rows dt { font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; padding-top: 2px; }
  .ms-ba__rows dd { margin: 0; color: #2F2B25; }
  .ms-ba__flap { margin-top: 14px; background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 4px; font: inherit; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: #7A4532; cursor: pointer; }
  .ms-ba__quote { margin: 28px 0 0; padding-left: 18px; border-left: 1px solid #C9A98A; }
  .ms-ba__quote blockquote { margin: 0; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.55; color: #4A443B; }
  .ms-ba__quote figcaption { margin-top: 6px; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; }
  .ms-ba__links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 30px; }
  .ms-site a.ms-ba__btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 26px; background: #17140F; color: #FBF9F5; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; }
  .ms-site a.ms-ba__link { display: inline-flex; gap: 8px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 4px; margin-top: 14px; }
  .ms-ba__links a.ms-ba__link { margin-top: 0; }
  .ms-ba__draw { position: relative; }
  .ms-ba__svg { display: block; width: 100%; height: auto; overflow: visible; }
  .ms-ba__part { cursor: pointer; outline: none; transition: opacity .3s ease, filter .3s ease; }
  .ms-ba[data-open] .ms-ba__part { opacity: .55; }
  .ms-ba[data-open="headboard"] .ms-ba__part[data-part="headboard"], .ms-ba[data-open="mattress"] .ms-ba__part[data-part="mattress"], .ms-ba[data-open="base"] .ms-ba__part[data-part="base"] { opacity: 1; filter: drop-shadow(0 6px 14px rgba(23, 20, 15, .18)); }
  .ms-ba__part:focus-visible { filter: drop-shadow(0 0 3px #7A4532); }
  .ms-ba__dim path { fill: none; stroke: #7A4532; stroke-width: .9; }
  .ms-ba__dim text { font-family: "Red Hat Text", system-ui, sans-serif; font-size: 11px; letter-spacing: .1em; fill: #7A4532; }
  .ms-ba__dim { transition: opacity .3s ease; }
  .ms-ba[data-open]:not([data-open="headboard"]) .ms-ba__dim { opacity: .25; }
  .ms-ba__wing { transition: transform 1.1s cubic-bezier(.3, .7, .2, 1); }
  .ms-ba.is-folded .ms-ba__wing { transform: scaleX(.18); }
  .ms-ba__hint { margin-top: 10px; text-align: center; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #6E675C; }
  @media (max-width: 900px) {
    .ms-ba__in { grid-template-columns: minmax(0, 1fr); }
    .ms-ba__draw { order: -1; }
    .ms-ba__panel { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-ba__wing, .ms-ba__panel { transition: none; animation: none; } }
</style>
<script>
(function () {
  function init(root) {
    if (!root || root.__ba) return; root.__ba = true;
    function open(p, focusPanel) {
      root.setAttribute('data-open', p);
      root.querySelectorAll('[data-ba-open]').forEach(function (b) { var on = b.getAttribute('data-ba-open') === p; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      root.querySelectorAll('[data-ba-panel]').forEach(function (el) { el.hidden = el.getAttribute('data-ba-panel') !== p; });
      root.querySelectorAll('.ms-ba__part').forEach(function (g) { g.setAttribute('aria-pressed', g.getAttribute('data-part') === p ? 'true' : 'false'); });
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-ba-open]'); if (b) { open(b.getAttribute('data-ba-open')); return; }
      var f = e.target.closest('[data-ba-flap]'); if (f) { root.classList.toggle('is-folded'); return; }
      var g = e.target.closest('.ms-ba__part'); if (g) {
        var p = g.getAttribute('data-part');
        // the wings beat when the headboard is chosen twice
        if (p === 'headboard' && root.getAttribute('data-open') === 'headboard' && root.getAttribute('data-bed') === 'beating-of-wings') root.classList.toggle('is-folded');
        open(p);
      }
    });
    root.addEventListener('keydown', function (e) { var g = e.target.closest('.ms-ba__part'); if (g && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); open(g.getAttribute('data-part')); } });
    open('headboard');
  }
  document.querySelectorAll('[data-ms-ba]').forEach(init);
  document.addEventListener('shopify:section:load', function (e) { init(e.target.querySelector('[data-ms-ba]')); });
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Bed with headboard",
  "class": "ms-section-ba",
  "settings": [
    { "type": "paragraph", "content": "Shown on beds with headboards only: the bed drawn from its foot, and what each part is. The bed's own words come from the theme (snippets/ms-bed-data)." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "[name], part by part", "info": "[name] is the product's name." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One headboard, one boxspring, one mattress." },
    { "type": "text", "id": "headboard_title", "label": "Part I", "default": "The headboard" },
    { "type": "text", "id": "mattress_title", "label": "Part II", "default": "The mattress" },
    { "type": "text", "id": "base_title", "label": "Part III", "default": "The boxspring" },
    { "type": "text", "id": "uph_label", "label": "Upholstery label", "default": "Upholstery" },
    { "type": "text", "id": "height_label", "label": "Height label", "default": "Height" },
    { "type": "text", "id": "width_label", "label": "Width label", "default": "Width" },
    { "type": "text", "id": "legs_label", "label": "Legs label", "default": "Legs" },
    { "type": "text", "id": "sizes_label", "label": "Sizes label", "default": "Sizes" },
    { "type": "text", "id": "sizes_value", "label": "Sizes", "default": "Single to King, and made to measure" },
    { "type": "textarea", "id": "mattress_text", "label": "The mattress", "default": "Any Midsummer mattress, chosen for the way you sleep: from the Raffaello in baby alpaca to the Vicuña, the rarest fibre of all." },
    { "type": "text", "id": "mattress_link", "label": "Mattresses link", "default": "The mattresses" },
    { "type": "text", "id": "wings_label", "label": "Beating of Wings: wings button", "default": "Fold the wings" },
    { "type": "text", "id": "button", "label": "Button", "default": "See it at the atelier" },
    { "type": "text", "id": "all_label", "label": "Link to every bed with headboard", "default": "Every bed with headboard" },
    { "type": "text", "id": "hint", "label": "Hint under the drawing", "default": "Choose a part of the bed" }
  ]
}
{% endschema %}
