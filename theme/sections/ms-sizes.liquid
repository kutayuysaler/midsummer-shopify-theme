{%- comment -%}
  The systems, measured: for architects and hotels, each bed system's overall height, its
  standard sizes and its cloth, from the 2026 catalogue, in one table. A system the store sells
  links to its page. Other sizes, round included, are made on request.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-sz" aria-labelledby="ms-sz-h-{{ section.id }}">
  <div class="ms-sz__in">
    <div class="ms-sz__head">
      <div>
        {%- if s.eyebrow != blank -%}<div class="ms-sz__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-sz__h" id="ms-sz-h-{{ section.id }}">{{ s.heading }}</h2>
      </div>
      {%- if s.text != blank -%}<p class="ms-sz__text">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="ms-sz__scroll">
      <table class="ms-sz__t">
        <thead>
          <tr><th scope="col">{{ s.col_system }}</th><th scope="col">{{ s.col_collection }}</th><th scope="col">{{ s.col_height }}</th><th scope="col">{{ s.col_sizes }}</th><th scope="col">{{ s.col_cloth }}</th></tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- assign bp = all_products[b.handle] -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{%- if bp.url != blank -%}<a href="{{ bp.url }}">{{ b.name }}</a>{%- else -%}{{ b.name }}{%- endif -%}</th>
              <td data-l="{{ s.col_collection | escape }}">{{ b.collection }}</td>
              <td data-l="{{ s.col_height | escape }}">{{ b.height }}</td>
              <td data-l="{{ s.col_sizes | escape }}">{{ b.sizes }}</td>
              <td data-l="{{ s.col_cloth | escape }}">{{ b.cloth }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if s.note != blank -%}<p class="ms-sz__note">{{ s.note }}</p>{%- endif -%}
    {%- if s.link_label != blank -%}<a class="ms-sz__link" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=project' %}#enquire" data-ms-enquire>{{ s.link_label }} <span aria-hidden="true">→</span></a>{%- endif -%}
  </div>
</section>
<style>
  .ms-sz { background: #FBF9F5; color: #17140F; padding: clamp(64px, 8vw, 128px) clamp(18px, 5vw, 80px); border-top: 1px solid #E6DFD2; }
  .ms-sz__in { max-width: 1560px; margin: 0 auto; }
  .ms-sz__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 5fr); gap: clamp(20px, 5vw, 96px); align-items: end; margin-bottom: clamp(28px, 3.5vw, 52px); }
  .ms-sz__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-sz__h { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(32px, 3.6vw, 52px); line-height: 1.08; letter-spacing: -0.02em; margin: 14px 0 0; }
  .ms-sz__text { font-size: 15px; line-height: 1.9; color: #4A443B; max-width: 52ch; margin: 0; }
  .ms-sz__t { width: 100%; border-collapse: collapse; }
  .ms-sz__t thead th { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #736b5f; font-weight: 400; text-align: left; padding: 0 18px 14px 0; border-bottom: 1px solid #17140F; }
  .ms-sz__t tbody th, .ms-sz__t td { text-align: left; vertical-align: top; padding: 18px 18px 18px 0; border-bottom: 1px solid #DDD6C9; font-size: 14px; line-height: 1.6; color: #4A443B; }
  .ms-sz__t tbody th { font-family: Newsreader, Georgia, serif; font-weight: 400; font-size: 21px; line-height: 1.25; color: #17140F; white-space: nowrap; }
  .ms-site .ms-sz__t tbody th a { color: inherit; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .5s ease; }
  .ms-site .ms-sz__t tbody th a:hover { background-size: 100% 1px; }
  .ms-sz__t td:nth-child(3) { font-family: Newsreader, Georgia, serif; font-size: 19px; color: #17140F; white-space: nowrap; }
  .ms-sz__t td:nth-child(2) { white-space: nowrap; }
  .ms-sz__note { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 15px; color: #6E675C; margin: 22px 0 0; max-width: 70ch; }
  .ms-site .ms-sz__link { display: inline-block; margin-top: 26px; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid #17140F; padding-bottom: 7px; }
  @media (max-width: 860px) {
    .ms-sz__head { grid-template-columns: minmax(0, 1fr); }
    .ms-sz__t thead { display: none; }
    .ms-sz__t, .ms-sz__t tbody, .ms-sz__t tr { display: block; }
    .ms-sz__t tr { padding: 18px 0; border-bottom: 1px solid #DDD6C9; }
    .ms-sz__t tbody th { display: block; padding: 0 0 8px; border: 0; }
    .ms-sz__t td { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 4px 0; border: 0; white-space: normal !important; font-size: 13.5px; }
    .ms-sz__t td::before { content: attr(data-l); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: #736b5f; padding-top: 3px; }
    .ms-sz__t td:nth-child(3) { font-family: inherit; font-size: 13.5px; }
  }
</style>
{% schema %}
{
  "name": "Systems, measured",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Systems, measured" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heights, sizes and cloths, system by system." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The figures a drawing needs, from the 2026 catalogue. Every one of them is a starting point: width, length, height and cloth are set to the room." },
    { "type": "text", "id": "col_system", "label": "Column: system", "default": "System" },
    { "type": "text", "id": "col_collection", "label": "Column: collection", "default": "Collection" },
    { "type": "text", "id": "col_height", "label": "Column: height", "default": "Overall height" },
    { "type": "text", "id": "col_sizes", "label": "Column: sizes", "default": "Standard sizes (cm)" },
    { "type": "text", "id": "col_cloth", "label": "Column: cloth", "default": "Cloth" },
    { "type": "text", "id": "note", "label": "Note", "default": "Other sizes, heights and shapes are made on request." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Ask for a specification" }
  ],
  "blocks": [
    {
      "type": "system",
      "name": "System",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "handle", "label": "Product handle", "info": "Links the name to the product page, when the store has it." },
        { "type": "text", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "height", "label": "Overall height" },
        { "type": "text", "id": "sizes", "label": "Standard sizes" },
        { "type": "text", "id": "cloth", "label": "Cloth" }
      ]
    }
  ],
  "presets": [ { "name": "Systems, measured" } ]
}
{% endschema %}
