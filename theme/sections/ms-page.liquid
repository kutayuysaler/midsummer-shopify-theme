{%- comment -%}
  Any page without a design of its own: the title, then the page's content set as an
  editorial column, centred, with its photographs allowed a wider measure.
{%- endcomment -%}
{%- liquid
  assign ms_show = true
  if template.name == 'page'
    capture ms_key
      render 'ms-page-key'
    endcapture
    if ms_key != blank
      assign ms_show = false
    endif
  endif
-%}
{%- if ms_show -%}
<section class="ms-pg">
  <header class="ms-pg__head">
    {%- if section.settings.eyebrow != blank -%}<div class="ms-pg__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1 class="ms-pg__title">{{ page.title }}</h1>
  </header>
  <div class="ms-pg__body rte">{{ page.content }}</div>
  {%- if section.settings.show_cta -%}
  <div class="ms-pg__cta">
    <a data-ms="cta" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire>{{ section.settings.cta }}</a>
  </div>
  {%- endif -%}
</section>
<style>
  .ms-pg { padding: clamp(64px, 9vw, 150px) clamp(18px, 5vw, 80px) clamp(72px, 10vw, 160px); max-width: 1180px; margin: 0 auto; }
  .ms-pg__head { max-width: 680px; margin: 0 auto; }
  .ms-pg__eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #6E675C; }
  .ms-pg__title { font-family: Newsreader, Georgia, serif; font-size: clamp(40px, 6vw, 88px); line-height: 1; letter-spacing: -0.035em; margin-top: 20px; font-weight: 200; }
  /* one centred reading column; photographs take a wider band, always centred, whatever the editor wrapped them in */
  .ms-pg__body { display: grid; grid-template-columns: [wide-start] minmax(0, 1fr) [text-start] minmax(0, 680px) [text-end] minmax(0, 1fr) [wide-end]; max-width: 1100px; margin: clamp(40px, 5vw, 72px) auto 0; font-size: 16px; line-height: 1.95; color: #4A443B; }
  .ms-pg__body > * { grid-column: text; min-width: 0; }
  .ms-pg__body > figure, .ms-pg__body > p:has(img), .ms-pg__body > div:has(img), .ms-pg__body > img { grid-column: wide; text-align: center; margin-top: 2.2em; margin-bottom: 1.2em; }
  .ms-pg__body > * + * { margin-top: 1.1em; }
  .ms-pg__body p { margin: 0; }
  .ms-pg__body p + p { margin-top: 1.1em; }
  .ms-pg__body h2, .ms-pg__body h3, .ms-pg__body h4 { font-family: Newsreader, Georgia, serif; font-weight: 200; color: #17140F; line-height: 1.15; letter-spacing: -0.02em; margin-top: 1.8em; margin-bottom: .7em; }
  .ms-pg__body h2 { font-size: clamp(26px, 3vw, 38px); }
  .ms-pg__body h3 { font-size: clamp(21px, 2.3vw, 28px); }
  .ms-pg__body h4 { font-size: 20px; }
  .ms-pg__body > h2:first-child, .ms-pg__body > h3:first-child { margin-top: 0; }
  .ms-site .ms-pg__body img { display: block; float: none !important; width: auto !important; max-width: 100%; height: auto !important; max-height: 80vh; margin: 0 auto !important; }
  .ms-pg__body figcaption { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 15px; color: #6E675C; margin-top: 12px; }
  .ms-pg__body a { color: #17140F; border-bottom: 1px solid currentColor; }
  .ms-pg__body ul, .ms-pg__body ol { padding-left: 1.2em; }
  .ms-pg__body li + li { margin-top: .4em; }
  .ms-pg__body blockquote { margin: 2em 0; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.5; color: #17140F; border-left: 1px solid #7E623B; padding-left: 24px; }
  .ms-pg__body hr { border: 0; border-top: 1px solid #DDD6C9; margin: 2.4em 0; }
  .ms-pg__body table { border-collapse: collapse; width: 100%; font-size: 14px; }
  .ms-pg__body td, .ms-pg__body th { border-top: 1px solid #DDD6C9; padding: 10px 12px 10px 0; text-align: left; vertical-align: top; }
  .ms-pg__cta { max-width: 680px; margin: clamp(40px, 5vw, 64px) auto 0; border-top: 1px solid #DDD6C9; padding-top: 24px; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; }
  .ms-pg__cta a { border-bottom: 1px solid #17140F; padding-bottom: 7px; }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Midsummer Milano" },
    { "type": "checkbox", "id": "show_cta", "label": "Show the appointment link", "default": true },
    { "type": "text", "id": "cta", "label": "Appointment link", "default": "Book a private appointment" }
  ]
}
{% endschema %}
