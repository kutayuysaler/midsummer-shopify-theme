{%- comment -%} A film, full width, playing silently in a loop; a caption beneath. {%- endcomment -%}
{%- liquid
  assign src = section.settings.video_url
  if section.settings.video != blank
    assign src = section.settings.video.sources | where: 'format', 'mp4' | map: 'url' | first
  endif
-%}
{%- if src != blank -%}
<section class="ms-vb">
  <div class="ms-vb__in">
    <video class="ms-vb__video" autoplay muted loop playsinline preload="metadata"
      {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 2400 }}"{% elsif section.settings.video != blank %}poster="{{ section.settings.video.preview_image | image_url: width: 2400 }}"{% endif %}
      src="{{ src }}"></video>
    {%- if section.settings.caption != blank -%}<p class="ms-vb__cap">{{ section.settings.caption }}</p>{%- endif -%}
  </div>
</section>
<style>
  .ms-vb { padding: clamp(24px, 4vw, 64px) clamp(18px, 5vw, 80px) 0; }
  .ms-vb.is-bleed { padding: 0; }
  .ms-vb__in { max-width: 1560px; margin: 0 auto; }
  .ms-vb__video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #17140F; }
  .ms-vb__cap { font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: #6E675C; margin-top: 14px; }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Film",
  "settings": [
    { "type": "video", "id": "video", "label": "Film" },
    { "type": "text", "id": "video_url", "label": "Film address" },
    { "type": "image_picker", "id": "poster", "label": "Poster frame" },
    { "type": "text", "id": "caption", "label": "Caption" }
  ],
  "presets": [ { "name": "Film" } ]
}
{% endschema %}
