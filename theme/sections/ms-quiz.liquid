{%- liquid
  assign ms_show = true
  if template.suffix == blank
    assign ms_show = false
    capture ms_here
      render 'ms-link', to: 'quiz'
    endcapture
    if ms_here == page.url
      assign ms_show = true
    endif
  endif
-%}
{%- if ms_show -%}
{%- render 'ms-quiz', label: section.settings.label, result_label: section.settings.result_label -%}
{%- endif -%}
{% schema %}
{
  "name": "Find your Midsummer",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Find your Midsummer" },
    { "type": "text", "id": "result_label", "label": "Result label", "default": "We would build you the" }
  ]
}
{% endschema %}
