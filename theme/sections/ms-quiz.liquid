{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'quiz' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
{%- liquid
  assign qtag = 'h1'
  if template.name == 'article' or template.name == 'product' or template.name == 'index' or template.name == 'blog'
    assign qtag = 'p'
  endif
-%}
{%- render 'ms-quiz', tag: qtag, label: section.settings.label, result_label: section.settings.result_label -%}
{%- endif -%}
{% schema %}
{
  "name": "Find your Midsummer",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Find your Midsummer" },
    { "type": "text", "id": "result_label", "label": "Result label", "default": "We would build you the" }
  ]
}
{% endschema %}
