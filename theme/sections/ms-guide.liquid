{%- comment -%}
  A short guide in numbered points (care, sizes): what to do, in the house's voice. With
  sizes, each point can carry a width and length in cm, drawn to scale and given in inches.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-gd{% if s.tone == 'sand' %} ms-gd--sand{% endif %}" id="{{ s.anchor }}">
  <div class="ms-gd__in">
    <div class="ms-gd__head">
      <div class="ms-gd__eyebrow">{{ s.eyebrow }}</div>
      <h2 class="ms-gd__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ms-gd__text">{{ s.text }}</p>{%- endif -%}
    </div>
    <ol class="ms-gd__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="ms-gd__item" {{ block.shopify_attributes }}>
          {%- if b.w != blank and b.l != blank -%}
            {%- liquid
              assign w = b.w | times: 1.0
              assign l = b.l | times: 1.0
              assign wi = w | divided_by: 2.54 | round
              assign li = l | divided_by: 2.54 | round
              # the bed seen from above, to one scale for every size: headboard, pillows, a turned-down cover
              assign vw = w | plus: 16
              assign vh = l | plus: 30
              assign pw = w | divided_by: 2.0 | minus: 10
              assign two = true
              if w < 130
                assign pw = w | minus: 22
                assign two = false
              endif
              assign p2x = w | divided_by: 2.0 | plus: 4
              assign fy = l | times: 0.36
              assign fh = l | minus: fy
              assign w1 = w | plus: 2
              assign w3 = w | times: 0.3
              assign w7 = w | times: 0.7
              assign wm = w | minus: 8
              assign c1 = w | times: 0.25
              assign c2 = w | times: 0.5
              assign c3 = w | times: 0.75
              assign sw = vw | times: 0.62 | round
              assign sh = vh | times: 0.62 | round
            -%}
            <span class="ms-gd__draw" aria-hidden="true">
              <svg viewBox="-8 -22 {{ vw }} {{ vh }}" width="{{ sw }}" height="{{ sh }}">
                <rect class="ms-gd__shade" x="3" y="5" width="{{ w }}" height="{{ l }}" rx="14"/>
                <rect class="ms-gd__hb" x="-5" y="-19" width="{{ w | plus: 10 }}" height="16" rx="8"/>
                <path class="ms-gd__ch" d="M{{ c1 }},-16v10M{{ c2 }},-16v10M{{ c3 }},-16v10"/>
                <rect class="ms-gd__mat" x="0" y="0" width="{{ w }}" height="{{ l }}" rx="12"/>
                <rect class="ms-gd__pil" x="7" y="7" width="{{ pw }}" height="27" rx="13"/>
                {%- if two -%}<rect class="ms-gd__pil" x="{{ p2x }}" y="7" width="{{ pw }}" height="27" rx="13"/>{%- endif -%}
                <path class="ms-gd__cover" d="M-2,{{ fy | plus: 10 }} C{{ w3 }},{{ fy | plus: 4 }} {{ w7 }},{{ fy | plus: 14 }} {{ w1 }},{{ fy | plus: 8 }} L{{ w1 }},{{ l | minus: 10 }} Q{{ w1 }},{{ l | plus: 2 }} {{ wm }},{{ l | plus: 2 }} L8,{{ l | plus: 2 }} Q-2,{{ l | plus: 2 }} -2,{{ l | minus: 10 }} Z"/>
                <path class="ms-gd__fold" d="M-2,{{ fy | plus: 4 }} Q-2,{{ fy | minus: 2 }} 8,{{ fy | minus: 2 }} L{{ wm }},{{ fy | minus: 2 }} Q{{ w1 }},{{ fy | minus: 2 }} {{ w1 }},{{ fy | plus: 4 }} L{{ w1 }},{{ fy | plus: 8 }} C{{ w7 }},{{ fy | plus: 14 }} {{ w3 }},{{ fy | plus: 4 }} -2,{{ fy | plus: 10 }} Z"/>
              </svg>
            </span>
            <span class="ms-gd__name">{{ b.title }}</span>
            <span class="ms-gd__dims">{{ b.w }} × {{ b.l }} cm</span>
            <span class="ms-gd__in2">{{ wi }} × {{ li }} in</span>
          {%- else -%}
            <span class="ms-gd__num">{{ forloop.index | prepend: '0' }}</span>
            <span class="ms-gd__name">{{ b.title }}</span>
            <span class="ms-gd__body">{{ b.text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.note != blank -%}<p class="ms-gd__note">{{ s.note }}</p>{%- endif -%}
  </div>
</section>
<style>
  .ms-gd { background: #FBF9F5; color: #17140F; padding: clamp(64px, 8vw, 120px) clamp(18px, 5vw, 80px); }
  .ms-gd--sand { background: #F3EEE5; }
  .ms-gd__in { max-width: 1560px; margin: 0 auto; }
  .ms-gd__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-gd__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(32px, 3.6vw, 54px); line-height: 1.05; letter-spacing: -0.03em; margin-top: 18px; max-width: 20ch; }
  .ms-site .ms-gd__text { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 18px; max-width: 56ch; }
  .ms-gd__list { list-style: none; padding: 0; margin: clamp(36px, 4.4vw, 64px) 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: clamp(20px, 2.6vw, 44px); }
  .ms-gd__item { display: flex; flex-direction: column; gap: 8px; border-top: 1px solid #DDD6C9; padding-top: 20px; }
  .ms-gd__num { font-family: Newsreader, Georgia, serif; font-size: 15px; color: #7E623B; }
  .ms-gd__name { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(21px, 1.8vw, 26px); letter-spacing: -0.01em; }
  .ms-gd__body { font-size: 14.5px; line-height: 1.85; color: #4A443B; }
  .ms-gd__dims { font-size: 14px; color: #2F2B25; }
  .ms-gd__in2 { font-size: 12px; color: #6E675C; letter-spacing: .04em; }
  .ms-gd__list:has(.ms-gd__draw) { grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); }
  .ms-gd__draw { height: 160px; display: flex; align-items: flex-end; margin-bottom: 10px; }
  .ms-gd__draw svg { display: block; overflow: visible; }
  .ms-gd__shade { fill: rgba(110, 60, 40, .1); }
  .ms-gd__hb { fill: #C98E76; }
  .ms-gd__ch { fill: none; stroke: rgba(255, 236, 226, .55); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ms-gd__mat { fill: #FAF3EC; stroke: rgba(122, 69, 50, .35); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ms-gd__pil { fill: #FFFFFF; stroke: rgba(122, 69, 50, .3); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ms-gd__cover { fill: #E8C7B7; stroke: rgba(122, 69, 50, .3); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ms-gd__fold { fill: #F2DCD0; stroke: rgba(122, 69, 50, .3); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ms-gd__item:hover .ms-gd__cover { fill: #DFB6A2; }
  .ms-gd__cover, .ms-gd__hb { transition: fill .4s ease; }
  .ms-site .ms-gd__note { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 18px; color: #4A443B; margin-top: clamp(28px, 3vw, 44px); }
</style>

{% schema %}
{
  "name": "Guide in points",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links to this part)" },
    { "type": "select", "id": "tone", "label": "Ground", "default": "ivory", "options": [{"value":"ivory","label":"Ivory"},{"value":"sand","label":"Sand"}] },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Looking after a natural bed." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "note", "label": "Closing note" }
  ],
  "blocks": [
    { "type": "point", "name": "Point", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Text" },
      { "type": "text", "id": "w", "label": "Width in cm (sizes only)" },
      { "type": "text", "id": "l", "label": "Length in cm (sizes only)" }
    ] }
  ],
  "presets": [{ "name": "Guide in points" }]
}
{% endschema %}
