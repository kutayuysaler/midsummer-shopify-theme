{%- assign _heading = section.settings.heading | default: t_heading_default -%}

<section
  id="msm-stores-{{ sid }}"
  class="msm-stores color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="msm-heading-{{ sid }}"
  data-t-directions="{{ t_directions | escape }}"
  data-t-call="{{ t_call | escape }}"
  data-t-email="{{ t_email_lbl | escape }}"
  data-t-website="{{ t_website_lbl | escape }}"
  data-t-worldwide="{{ t_worldwide | escape }}"
  data-t-showing="{{ t_showing | escape }}"
  data-t-of="{{ t_of | escape }}"
  data-t-locations="{{ t_locations | escape }}"
  data-t-no-results="{{ t_no_results | escape }}"
  data-t-map-fallback="{{ t_map_fallback | escape }}"
  data-t-showroom="{{ t_showroom | escape }}"
  data-t-boutique="{{ t_boutique | escape }}"
  data-t-agent="{{ t_agent | escape }}"
  data-basemap="{{ section.settings.basemap | default: 'esri_gray' }}"
  data-sort="{{ section.settings.sort_order | default: 'name' }}"
  data-dedupe="{{ section.settings.dedupe | default: 'merge' }}"
  data-locale="{{ request.locale.iso_code }}"
>
  <div class="page-width">

    <header class="msm-stores__header">
      <h2 id="msm-heading-{{ sid }}" class="msm-stores__title {{ section.settings.heading_size }}">
        {{- _heading -}}
      </h2>
      <p class="msm-stores__meta" id="msm-meta-{{ sid }}"></p>
    </header>

    <div class="msm-stores__filters">
      <div class="msm-search-wrap">
        <svg class="msm-search-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="m13 13 3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          id="msm-search-{{ sid }}"
          class="msm-input"
          type="search"
          placeholder="{{ t_search_ph }}"
          autocomplete="off"
          spellcheck="false"
          aria-label="{{ t_search_ph }}"
        >
      </div>
      <select id="msm-country-{{ sid }}" class="msm-select" aria-label="{{ t_all_countries }}">
        <option value="">{{ t_all_countries }}</option>
      </select>
      <select id="msm-type-{{ sid }}" class="msm-select" aria-label="{{ t_all_types }}">
        <option value="">{{ t_all_types }}</option>
        <option value="showroom">{{ t_showroom }}</option>
        <option value="boutique">{{ t_boutique }}</option>
        <option value="agent">{{ t_agent }}</option>
      </select>
    </div>

    <div class="msm-stores__wrap">
      <aside class="msm-stores__panel" aria-label="{{ t_subheading }}">
        <p class="msm-panel-label">{{ t_subheading }}</p>
        <ul class="msm-stores__list" id="msm-list-{{ sid }}" aria-live="polite"></ul>
        <p class="msm-no-results" id="msm-noresults-{{ sid }}" hidden>{{ t_no_results }}</p>
      </aside>

      <div class="msm-map-wrap">
        <div id="msm-map-{{ sid }}" class="msm-map" role="region" aria-label="Store map"></div>
        <p class="msm-map-fallback" id="msm-fallback-{{ sid }}" hidden>{{ t_map_fallback }}</p>
      </div>
    </div>
  </div>

