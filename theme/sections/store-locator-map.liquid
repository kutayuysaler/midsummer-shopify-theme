<script>
(function () {
  'use strict';

  var ROOT = document.getElementById('msm-stores-{{ sid }}');
  if (!ROOT) return;

  function t(key) { return ROOT.getAttribute('data-t-' + key) || ''; }

  function readJSON(id) {
    var el = document.getElementById(id);
    if (!el) return [];
    try { return JSON.parse(el.textContent || '[]'); } catch(e) { return []; }
  }

  var builtins = readJSON('msm-builtin-{{ sid }}');
  var blocks   = readJSON('msm-blocks-{{ sid }}');

  /* numeric coercion that keeps 0 (Greenwich / equator) as a valid value */
  function num(v) {
    var n = (typeof v === 'number') ? v : parseFloat(v);
    return isFinite(n) ? n : null;
  }
  /* collapse stray/duplicated comma-space runs left by data entry */
  function tidyAddr(a) {
    return String(a || '').replace(/\s+/g, ' ')
      .replace(/\s*,\s*/g, ', ').replace(/(?:,\s*){2,}/g, ', ')
      .replace(/^[,\s]+|[,\s]+$/g, '');
  }
  function norm(s) {
    return Object.assign({}, s, {
      lat: num(s.lat), lng: num(s.lng), address: tidyAddr(s.address)
    });
  }
  function hasCoords(s) { return s.lat !== null && s.lng !== null; }

  /*
   * ─── DE-DUPLICATION ───
   * The 13 built-ins are hard-coded here while extra stores are added as
   * theme-editor blocks, so the same shop can be entered twice. Two tests
   * must BOTH pass before two records are treated as one shop.
   *
   * 1. Identity — is it the same business?
   *      email / website host / one title a prefix of the other (same country)
   *
   * 2. Address — is it the same PREMISES? A chain shares one mailbox and one
   *      domain across every branch, so identity alone would swallow branches.
   *      (In Made Ltd really does have a Kowloon office and a Central office
   *      on one email.) Confirmed by, in order:
   *        <250m apart          -> same building
   *        street/postal numbers -> survives transliteration, where the RU and
   *                                 IT catalogues spell the same street
   *                                 differently ("Via Manzoni"/"Виа Мандзони")
   *        word overlap          -> last resort when an address has no digits
   *      No address on either side => never merge.
   *
   * Distance alone is not usable in either direction: two different Milan
   * showrooms sit 830m apart, while one shop's two records are 7.7km apart
   * because a coordinate was mistyped.
   *
   * Later records (theme-editor blocks) win on every non-empty field, so
   * editing a store in the admin overrides the built-in copy.
   * Set "Duplicate handling" to "Show every entry" to switch this off.
   */
  function keyify(v) {
    return String(v || '').toLowerCase().normalize ?
      String(v || '').toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9\u0400-\u04ff]/g, '') :
      String(v || '').toLowerCase().replace(/[^a-z0-9]/g, '');
  }
  function emailKey(s) { return String(s.email || '').trim().toLowerCase(); }
  function hostKey(s) {
    var w = String(s.website || '').trim().toLowerCase();
    if (!w) return '';
    return w.replace(/^https?:\/\//, '').replace(/^www\./, '').split(/[/?#]/)[0] || '';
  }
  function identity(a, b) {
    var ea = emailKey(a), eb = emailKey(b);
    if (ea && ea === eb) return 'email';
    var ha = hostKey(a), hb = hostKey(b);
    if (ha && ha === hb) return 'website';
    var ta = keyify(a.title), tb = keyify(b.title);
    if (ta && tb && keyify(a.country) === keyify(b.country) &&
        (ta.indexOf(tb) === 0 || tb.indexOf(ta) === 0)) return 'name';
    return null;
  }

  /* words too generic to count as evidence that two addresses match */
  var ADDR_STOP = { suite:1, ste:1, unit:1, floor:1, apt:1, street:1, road:1,
                    via:1, viale:1, corso:1, piazza:1, chem:1, and:1, the:1 };

  function addrWords(a) {
    return String(a || '').toLowerCase().split(/[^0-9a-z\u00c0-\u024f\u0400-\u04ff]+/)
      .filter(function (t) { return t.length > 1 && !ADDR_STOP[t]; });
  }
  function addrNums(a) {
    return String(a || '').split(/[^0-9]+/).filter(function (t) { return t.length > 0; });
  }
  function dice(A, B) {
    if (!A.length || !B.length) return 0;
    var seen = {}, hits = 0, ua = 0, ub = 0, i;
    for (i = 0; i < A.length; i++) if (!seen[A[i]]) { seen[A[i]] = 1; ua++; }
    var seenB = {};
    for (i = 0; i < B.length; i++) if (!seenB[B[i]]) { seenB[B[i]] = 1; ub++; if (seen[B[i]]) hits++; }
    return (2 * hits) / (ua + ub);
  }
  function metresApart(a, b) {
    if (!hasCoords(a) || !hasCoords(b)) return null;
    var R = 6371000, r = Math.PI / 180;
    var p1 = a.lat * r, p2 = b.lat * r;
    var dp = (b.lat - a.lat) * r, dl = (b.lng - a.lng) * r;
    var x = Math.sin(dp / 2) * Math.sin(dp / 2) +
            Math.cos(p1) * Math.cos(p2) * Math.sin(dl / 2) * Math.sin(dl / 2);
    return 2 * R * Math.asin(Math.sqrt(x));
  }

  function addressAgrees(a, b) {
    var d = metresApart(a, b);
    if (d !== null && d < 250) return 'same spot';
    var na = addrNums(a.address), nb = addrNums(b.address);
    if (na.length && nb.length) return dice(na, nb) >= 0.6 ? 'street numbers' : false;
    var wa = addrWords(a.address), wb = addrWords(b.address);
    if (wa.length && wb.length) return dice(wa, wb) >= 0.5 ? 'address text' : false;
    return false;
  }

  function sameStore(a, b) {
    var who = identity(a, b);
    if (!who) return null;
    var where = addressAgrees(a, b);
    if (!where) return null;
    return who + ' + ' + where;
  }

  function dedupe(list) {
    var out = [], notes = [];
    list.forEach(function (s) {
      var reason = null, hit = null;
      for (var i = 0; i < out.length; i++) {
        reason = sameStore(out[i], s);
        if (reason) { hit = out[i]; break; }
      }
      if (!hit) { out.push(Object.assign({}, s)); return; }
      notes.push(hit.title + '  +  ' + s.title + '  (same ' + reason + ')');
      Object.keys(s).forEach(function (k) {
        if (s[k] !== '' && s[k] !== null && s[k] !== undefined) hit[k] = s[k];
      });
    });
    if (notes.length && window.console && console.info) {
      console.info('[store-locator] merged ' + notes.length +
        ' duplicate record(s):\n  ' + notes.join('\n  '));
    }
    return out;
  }

  var allRecords = builtins.concat(blocks).map(norm);
  var stores = ROOT.getAttribute('data-dedupe') === 'off' ? allRecords : dedupe(allRecords);
  if (!stores.length) return;

  /*
   * ─── SORTING ───
   * Built-ins and theme-editor blocks arrive in insertion order, which reads
   * as random. Sort with a locale-aware collator so the IT and RU catalogues
   * (accents, Cyrillic) order correctly rather than by raw code point.
   */
  var LOCALE = ROOT.getAttribute('data-locale') || undefined;
  var collator = null;
  try { collator = new Intl.Collator(LOCALE, { sensitivity: 'base', numeric: true }); } catch(e) {}

  function cmp(a, b) {
    a = String(a || ''); b = String(b || '');
    return collator ? collator.compare(a, b) : a.toLowerCase().localeCompare(b.toLowerCase());
  }

  var SORT = ROOT.getAttribute('data-sort') || 'name';
  stores.sort(function (x, y) {
    if (SORT === 'country') {
      var byCountry = cmp(x.country, y.country);
      if (byCountry !== 0) return byCountry;
      var byCity = cmp(x.city, y.city);
      if (byCity !== 0) return byCity;
    }
    return cmp(x.title, y.title);
  });

  var listEl      = document.getElementById('msm-list-{{ sid }}');
  var searchEl    = document.getElementById('msm-search-{{ sid }}');
  var countryEl   = document.getElementById('msm-country-{{ sid }}');
  var typeEl      = document.getElementById('msm-type-{{ sid }}');
  var metaEl      = document.getElementById('msm-meta-{{ sid }}');
  var noResultsEl = document.getElementById('msm-noresults-{{ sid }}');
  var fallbackEl  = document.getElementById('msm-fallback-{{ sid }}');
  var mapEl       = document.getElementById('msm-map-{{ sid }}');

  function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function catLabel(c) {
    return ({showroom: t('showroom')||'Showroom', boutique: t('boutique')||'Boutique', agent: t('agent')||'Agent'})[c] || c || '';
  }

  /* country dropdown */
  (function(){
    var seen = {};
    stores.forEach(function(s){ if(s.country) seen[s.country]=true; });
    Object.keys(seen).sort(cmp).forEach(function(c){
      var o = document.createElement('option');
      o.value = c; o.textContent = c;
      countryEl.appendChild(o);
    });
  })();

  /* render card */
  function cardHTML(s, delay) {
    var p = [];
    if(s.category) p.push('<div class="store-tag">'+esc(catLabel(s.category))+'</div>');
    p.push('<h3>'+esc(s.title||'')+'</h3>');
    if(s.contact) p.push('<div class="store-meta store-meta--contact">'+esc(s.contact)+'</div>');
    var loc = [s.city,s.country].filter(Boolean).join(', ');
    if(loc)       p.push('<div class="store-meta">'+esc(loc)+'</div>');
    if(s.address) p.push('<div class="store-meta">'+esc(s.address)+'</div>');

    p.push(chipsHTML(s));

    return '<li class="store-card" data-id="'+esc(s.id)+'" data-country="'+esc(s.country)+'" data-category="'+esc(s.category)+'" style="animation-delay:'+delay+'ms">'+p.join('')+'</li>';
  }

  /* chips are shared by the list card and the map popup */
  function chipsHTML(s) {
    var chips=[];
    if(hasCoords(s)) chips.push('<a class="chip" href="https://www.google.com/maps/dir/?api=1&destination='+s.lat+','+s.lng+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 2.5a4.5 4.5 0 110 9 4.5 4.5 0 010-9z"/></svg>'+esc(t('directions'))+'</a>');
    if(s.phone)      chips.push('<a class="chip" href="tel:'+esc(s.phone.replace(/[\s()\-]/g,''))+'"><svg viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>'+esc(t('call'))+'</a>');
    if(s.email)      chips.push('<a class="chip" href="mailto:'+esc(s.email)+'"><svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 7 10-7"/></svg>'+esc(t('email'))+'</a>');
    if(s.website)    chips.push('<a class="chip" href="'+esc(s.website)+'" target="_blank" rel="noopener"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M2.5 9h19M2.5 15h19M12 2.5c-2.5 3-3.7 6-3.7 9.5S9.5 18.5 12 21.5c2.5-3 3.7-6 3.7-9.5S14.5 5.5 12 2.5z"/></svg>'+esc(t('website'))+'</a>');
    return chips.length ? '<div class="store-actions">'+chips.join('')+'</div>' : '';
  }

  var html='';
  stores.forEach(function(s,i){ html+=cardHTML(s,i*30); });
  listEl.innerHTML=html;

  var cards = Array.prototype.slice.call(listEl.querySelectorAll('.store-card'));

  /* filter */
  var timer;
  function tl(s){ return String(s||'').trim().toLowerCase(); }

  function applyFilters(){
    var q=tl(searchEl?searchEl.value:''), country=countryEl?countryEl.value:'', type=typeEl?typeEl.value:'', vis=0;
    cards.forEach(function(card,i){
      var s=stores[i];
      var hay=tl((s.title||'')+' '+(s.city||'')+' '+(s.country||'')+' '+(s.address||'')+' '+(s.contact||''));
      var ok=true;
      if(q&&hay.indexOf(q)===-1)ok=false;
      if(country&&s.country!==country)ok=false;
      if(type&&s.category!==type)ok=false;
      card.classList.toggle('store-card--hidden',!ok);
      if(ok)vis++;
    });
    if(noResultsEl) noResultsEl.hidden=vis>0;
    if(metaEl){
      var tot=stores.length;
      metaEl.textContent=(!q&&!country&&!type)
        ? tot+' '+t('worldwide')
        : t('showing')+' '+vis+' '+t('of')+' '+tot+' '+t('locations');
    }
    if(typeof rebuildMarkers==='function') rebuildMarkers();
  }

  applyFilters();
  if(searchEl) searchEl.addEventListener('input',function(){ clearTimeout(timer); timer=setTimeout(applyFilters,220); });
  if(countryEl) countryEl.addEventListener('change',applyFilters);
  if(typeEl)    typeEl.addEventListener('change',applyFilters);

  /* popup mirrors the list card: tag, name, contact, place, address, actions */
  function popupHTML(s) {
    var p = ['<div class="msm-pop">'];
    if(s.category) p.push('<div class="msm-pop__tag">'+esc(catLabel(s.category))+'</div>');
    p.push('<strong class="msm-pop__title">'+esc(s.title||'')+'</strong>');
    if(s.contact) p.push('<div class="msm-pop__contact">'+esc(s.contact)+'</div>');
    var loc=[s.city,s.country].filter(Boolean).join(', ');
    if(loc)       p.push('<div class="msm-pop__loc">'+esc(loc)+'</div>');
    if(s.address) p.push('<div class="msm-pop__addr">'+esc(s.address)+'</div>');
    var chips = chipsHTML(s);
    if(chips)     p.push(chips.replace('store-actions','store-actions msm-pop__actions'));
    p.push('</div>');
    return p.join('');
  }

  /* ─── MAP ─── */
  var map, markersData=[], rebuildMarkers;

  /*
   * ─── BASEMAPS ───
   * CARTO's basemaps.cartocdn.com no longer serves anonymous tiles: every
   * tile comes back stamped "API KEY REQUIRED". These providers need no key
   * and no account. They are tried in order; if a layer throws repeated tile
   * errors we fall through to the next one automatically.
   *
   * Esri Light Gray Canvas — pale, minimal, closest match to the old look.
   *   Native tiles stop at z16, so maxNativeZoom upscales beyond that.
   * OSM Standard — always available, more colourful, hard fallback.
   */
  var BASEMAPS = {
    esri_gray: {
      url: 'https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Light_Gray_Base/MapServer/tile/{z}/{y}/{x}',
      opts: {
        maxZoom: 19, maxNativeZoom: 16,
        attribution: 'Tiles &copy; Esri &mdash; Esri, DeLorme, NAVTEQ'
      }
    },
    osm: {
      url: 'https://tile.openstreetmap.org/{z}/{x}/{y}.png',
      opts: {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }
    }
  };

  /* preferred first, then the rest as fallbacks */
  var preferred = ROOT.getAttribute('data-basemap') || 'esri_gray';
  var CHAIN = [];
  if (BASEMAPS[preferred]) CHAIN.push(BASEMAPS[preferred]);
  Object.keys(BASEMAPS).forEach(function(k){
    if (k !== preferred) CHAIN.push(BASEMAPS[k]);
  });

  function loadLeaflet(cb){
    if(window.L&&typeof window.L.map==='function'){ cb(); return; }
    if(!document.getElementById('leaflet-css')){
      var css=document.createElement('link');
      css.id='leaflet-css'; css.rel='stylesheet';
      css.href='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(css);
    }
    var ex=document.getElementById('leaflet-js');
    if(ex){ if(window.L){cb();}else{ex.addEventListener('load',cb,{once:true});} return; }
    var s=document.createElement('script');
    s.id='leaflet-js'; s.src='https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js';
    s.onload=cb; s.onerror=function(){ if(fallbackEl)fallbackEl.hidden=false; };
    document.head.appendChild(s);
  }

  /* attach a basemap, degrading to the next provider on repeated tile errors */
  function attachBasemap(idx){
    if(idx>=CHAIN.length){ if(fallbackEl)fallbackEl.hidden=false; return; }
    var cfg = CHAIN[idx];
    var layer = L.tileLayer(cfg.url, cfg.opts);
    var errors = 0, swapped = false;

    layer.on('tileerror', function(){
      errors++;
      if(!swapped && errors >= 4){
        swapped = true;
        map.removeLayer(layer);
        layer.off();
        attachBasemap(idx + 1);
      }
    });

    layer.addTo(map);
  }

  function initMap(){
    if(!window.L||!mapEl){ if(fallbackEl)fallbackEl.hidden=false; return; }
    if(!stores.some(hasCoords)) return;

    map=L.map(mapEl,{zoomControl:false, worldCopyJump:true});
    L.control.zoom({position:'bottomright'}).addTo(map);
    map.setView([30,10],2); /* sane initial view before fitBounds runs */

    attachBasemap(0);

    function makePin(active){
      var c=active?'#5e4839':'#8a6a56', d=active?16:12;
      return L.divIcon({
        className:'',
        html:'<span style="display:block;width:'+d+'px;height:'+d+'px;border-radius:50%;background:'+c+';border:2px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.28)"></span>',
        iconSize:[d,d], iconAnchor:[d/2,d/2],
        popupAnchor:[0,-(d/2)-6]
      });
    }

    rebuildMarkers=function(){
      markersData.forEach(function(m){ map.removeLayer(m.marker); });
      markersData=[];
      var lls=[];
      stores.forEach(function(s,i){
        if(!hasCoords(s)) return;
        if(cards[i]&&cards[i].classList.contains('store-card--hidden')) return;
        var marker=L.marker([s.lat,s.lng],{icon:makePin(false)}).addTo(map);
        marker.bindPopup(popupHTML(s),
          /* generous autoPanPadding ensures popup is always fully in view */
          {autoPan:true, autoPanPadding:[80,110], closeButton:true, minWidth:220, maxWidth:300}
        );
        markersData.push({id:s.id,marker:marker});
        lls.push([s.lat,s.lng]);
      });
      if(lls.length===1){ map.setView(lls[0],10); }
      else if(lls.length>1){ try{ map.fitBounds(lls,{padding:[48,48]}); }catch(e){} }
    };

    setTimeout(function(){ map.invalidateSize(); rebuildMarkers(); },200);

    /* card click → fly to marker then open popup */
    listEl.addEventListener('click',function(ev){
      if(ev.target.closest&&ev.target.closest('.chip')) return;
      var li=ev.target.closest?ev.target.closest('.store-card'):null;
      if(!li||li.classList.contains('store-card--hidden')) return;

      var id=li.getAttribute('data-id');
      cards.forEach(function(c){ c.classList.remove('store-card--active'); });
      li.classList.add('store-card--active');
      if(li.scrollIntoView) li.scrollIntoView({behavior:'smooth',block:'nearest'});

      markersData.forEach(function(obj){
        if(obj.id===id){
          obj.marker.setIcon(makePin(true));
          var ll=obj.marker.getLatLng();
          var zoom=Math.max(map.getZoom(),12);

          /*
           * flyTo centres map exactly on the coordinate.
           * We listen for 'moveend' so the popup opens only
           * after the animation settles — Leaflet's autoPan
           * then shifts the view the small amount needed to
           * keep the popup fully inside the map bounds.
           */
          map.once('moveend',function(){ obj.marker.openPopup(); });
          map.flyTo(ll,zoom,{animate:true,duration:0.5});
        } else {
          obj.marker.setIcon(makePin(false));
          obj.marker.closePopup();
        }
      });
    });
  }

  loadLeaflet(initMap);
})();
</script>

