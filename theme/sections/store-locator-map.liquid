        { "value": "country", "label": "Country, then city, then name" }
      ],
      "default": "name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
