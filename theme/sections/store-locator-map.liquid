      "options": [
        { "value": "merge", "label": "Merge identical entries (recommended)" },
        { "value": "off",   "label": "Show every entry" }
      ],
      "default": "merge"
    },
    {
      "type": "select",
      "id": "sort_order",
      "label": "List order",
