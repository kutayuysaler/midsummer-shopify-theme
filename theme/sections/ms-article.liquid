<style>
  .ms-article-body > * { margin: 0; }
  .ms-article-body > p:first-child { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 2.2vw, 26px); line-height: 1.5; color: rgb(23, 20, 15); }
  .ms-article-body h2, .ms-article-body h3 { font-family: Newsreader, Georgia, serif; font-weight: 200; color: #17140F; line-height: 1.2; letter-spacing: -0.02em; }
  .ms-article-body h2 { font-size: clamp(24px, 2.8vw, 34px); margin-top: 18px; }
  .ms-article-body h3 { font-size: clamp(20px, 2.2vw, 26px); margin-top: 12px; }
  .ms-article-body a { border-bottom: 1px solid currentColor; }
