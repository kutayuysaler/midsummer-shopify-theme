{%- capture cat -%}{% render 'ms-note-cat', a: article %}{%- endcapture -%}{%- capture kicker -%}{% render 'ms-note-cat', label: cat %}{%- endcapture -%}{%- if kicker == blank -%}{%- assign kicker = blog.title -%}{%- endif -%}
{%- assign words = article.content | strip_html | split: ' ' | size -%}
{%- assign minutes = words | plus: 199 | divided_by: 200 | floor | at_least: 1 -%}
{%- liquid
  assign ms_pub = article.published_at | date: '%s' | plus: 0
  assign ms_upd = article.updated_at | date: '%s' | plus: 0
  assign ms_gap = ms_upd | minus: ms_pub
  assign dek = article.excerpt | strip_html | strip | truncate: 260
-%}
<section class="ms-art-hero{% unless article.image %} is-plain{% endunless %}">
  <div class="ms-art-hero__txt">
    <a class="ms-art-back" href="{{ blog.url }}"><span aria-hidden="true">←</span> {{ section.settings.all }}</a>
    <div class="ms-art-kicker"><svg aria-hidden="true" height="20" viewBox="0 0 24 24" width="20"><path d="M4 20 C4 11 11 4 20 4 C20 13 13 20 4 20 Z" fill="none" stroke="currentColor" stroke-width="1.1"></path><path d="M4 20 L14 10" fill="none" stroke="currentColor" stroke-width="1.1"></path></svg>{{ kicker }}</div>
    <h1 class="ms-art-title">{{ article.title }}</h1>
    {%- if dek != blank -%}<p class="ms-art-dek">{{ dek }}</p>{%- endif -%}
    <div class="ms-art-meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>{%- if ms_gap > 604800 %}<span>{{ section.settings.updated | default: 'Updated' }} <time datetime="{{ article.updated_at | date: '%Y-%m-%d' }}">{{ article.updated_at | date: '%-d %B %Y' }}</time></span>{%- endif %}<span>{{ minutes }} {{ section.settings.minutes }}</span></div>
  </div>
  {%- if article.image -%}
  <figure class="ms-art-hero__img">
    <img alt="{{ article.image.alt | default: article.title | escape }}" src="{{ article.image | image_url: width: 1800 }}" srcset="{{ article.image | image_url: width: 900 }} 900w, {{ article.image | image_url: width: 1400 }} 1400w, {{ article.image | image_url: width: 2000 }} 2000w" sizes="(max-width: 1000px) 100vw, 56vw" width="1800" height="2250" fetchpriority="high">
  </figure>
  {%- endif -%}
</section>
<div class="ms-art-layout">
  <aside class="ms-art-aside">
    <div class="ms-art-aside__in">
      <nav class="ms-art-toc" data-ms-toc hidden aria-label="{{ section.settings.toc | default: 'In this note' | escape }}"><span>{{ section.settings.toc | default: 'In this note' }}</span><ol></ol></nav>
      <div class="ms-art-share" aria-label="Share">
        <span>{{ section.settings.share | default: 'Share' }}</span>
        <a href="https://wa.me/?text={{ article.title | url_encode }}%20{{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 3.2a8.7 8.7 0 0 0-7.5 13.1L3.3 20.8l4.6-1.2A8.7 8.7 0 1 0 12 3.2Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M9.2 8.3c.2-.4.5-.4.7-.4h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.2-.1.4 0 .5.6 1 1.5 1.8 2.5 2.3.2.1.4.1.5-.1l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5v.4c0 .5-.4 1.2-1.4 1.4-1 .2-2.4-.2-4.1-1.6-1.9-1.6-2.6-3.3-2.6-4.3 0-.8.4-1.5.6-1.9Z" fill="currentColor"/></svg>WhatsApp</a>
        <a href="https://www.linkedin.com/sharing/share-offsite/?url={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M8 10.3v6.2M8 7.6v.1M11.2 16.5v-6.2M11.2 13c0-1.7 1-2.8 2.4-2.8 1.3 0 2.2.9 2.2 2.6v3.7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>LinkedIn</a>
        <a href="https://pinterest.com/pin/create/button/?url={{ shop.url | append: article.url | url_encode }}{% if article.image %}&media={{ article.image | image_url: width: 1600 | prepend: 'https:' | url_encode }}{% endif %}&description={{ article.title | url_encode }}" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="12" cy="12" r="8.7" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M11.2 9.2c.8-1.4 3.8-1.6 4.3.5.5 2-1 4.4-2.8 4.1-1.1-.2-1.3-1.2-1.1-1.9M11.9 11.4l-2 8.4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>Pinterest</a>
        <a href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url | append: article.url | url_encode }}"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M4 6.5l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>Email</a>
        <button type="button" data-ms-copy="{{ shop.url | append: article.url }}"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M10.3 13.7a3.6 3.6 0 0 0 5.1 0l3.1-3.1a3.6 3.6 0 0 0-5.1-5.1l-1.2 1.2M13.7 10.3a3.6 3.6 0 0 0-5.1 0l-3.1 3.1a3.6 3.6 0 0 0 5.1 5.1l1.2-1.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg><span>{{ section.settings.copy | default: 'Copy link' }}</span></button>
      </div>
    </div>
  </aside>
  <div class="ms-article-body">
{{ article.content }}
  </div>
<script>
  /* the note, put in order before it is read: nothing of its words is changed */
  (function () {
    var body = document.currentScript.previousElementSibling;
    if (!body || !body.classList.contains('ms-article-body')) return;
    var blank = function (el) { return !el.querySelector('img, iframe, video, svg, picture, table, hr') && !(el.textContent || '').replace(/[\s ​]+/g, ''); };
    body.querySelectorAll('meta, link, style, o\\:p').forEach(function (el) { el.remove(); });
    body.querySelectorAll('[style]').forEach(function (el) { if (!/^(IMG|IFRAME|VIDEO)$/.test(el.tagName)) el.removeAttribute('style'); });
    body.querySelectorAll('[data-mce-fragment], [data-mce-style]').forEach(function (el) { el.removeAttribute('data-mce-fragment'); el.removeAttribute('data-mce-style'); });
    // wrappers around whole blocks (a div from another editor, a pasted bold or span) are taken away
    var BLOCK = 'p, h1, h2, h3, h4, h5, h6, ul, ol, blockquote, figure, table, div, section';
    for (var pass = 0; pass < 6; pass++) {
      var wraps = Array.prototype.filter.call(body.querySelectorAll('div, section, article, main, header, footer, b, strong, span, font'), function (w) {
        return w.querySelector(BLOCK) && !w.querySelector('iframe, video') && !w.closest('li, table, blockquote');
      });
      if (!wraps.length) break;
      wraps.forEach(function (w) { if (!w.parentNode) return; while (w.firstChild) w.parentNode.insertBefore(w.firstChild, w); w.remove(); });
    }
    body.querySelectorAll('span, font').forEach(function (el) { if (!el.attributes.length || el.tagName === 'FONT' || /^s\d+$/.test(el.className)) { while (el.firstChild) el.parentNode.insertBefore(el.firstChild, el); el.remove(); } });
    // a div holding only words is a paragraph
    body.querySelectorAll('div').forEach(function (d) { if (!d.querySelector('div, p, ul, ol, table, figure, img, iframe, h1, h2, h3, h4, h5, h6')) { var p = document.createElement('p'); while (d.firstChild) p.appendChild(d.firstChild); d.replaceWith(p); } });
    // two line breaks are a new paragraph
    Array.prototype.slice.call(body.querySelectorAll('p')).forEach(function (p) {
      var kids = Array.prototype.slice.call(p.childNodes), parts = [[]], last = null;
      kids.forEach(function (n) {
        var isBr = n.nodeName === 'BR', ws = n.nodeType === 3 && !n.textContent.trim();
        if (isBr && last === 'br') { parts.push([]); last = 'split'; return; }
        if (isBr && last === 'split') return;
        if (ws) { parts[parts.length - 1].push(n); return; }
        if (isBr) { parts[parts.length - 1].push(n); last = 'br'; return; }
        last = null; parts[parts.length - 1].push(n);
      });
      if (parts.length < 2) return;
      parts.forEach(function (ns) {
        while (ns.length && (ns[ns.length - 1].nodeName === 'BR' || (ns[ns.length - 1].nodeType === 3 && !ns[ns.length - 1].textContent.trim()))) ns.pop();
        if (!ns.length) return;
        var q = document.createElement('p'); ns.forEach(function (n) { q.appendChild(n); }); p.parentNode.insertBefore(q, p);
      });
      p.remove();
    });
    // a paragraph of several long lines (each a sentence, or a bold label and its words) becomes
    // one line each, with a little air between, so a wrapped line is not mistaken for the next
    Array.prototype.slice.call(body.querySelectorAll(':scope > p')).forEach(function (p) {
      var lines = [[]];
      Array.prototype.slice.call(p.childNodes).forEach(function (n) { if (n.nodeName === 'BR') lines.push([]); else lines[lines.length - 1].push(n); });
      lines = lines.filter(function (ns) { return ns.some(function (n) { return (n.textContent || '').trim(); }); });
      if (lines.length < 2) return;
      var len = lines.map(function (ns) { return ns.map(function (n) { return n.textContent || ''; }).join('').trim().length; });
      var long = len.filter(function (l) { return l >= 38; }).length;
      if (long < lines.length - 1) return;
      var labelled = lines.every(function (ns) { var f = ns.filter(function (n) { return !(n.nodeType === 3 && !n.textContent.trim()); })[0]; return f && /^(B|STRONG)$/.test(f.nodeName); });
      lines.forEach(function (ns) { var q = document.createElement('p'); q.className = 'ms-art-line' + (labelled ? ' ms-art-line--item' : ''); ns.forEach(function (n) { q.appendChild(n); }); p.parentNode.insertBefore(q, p); });
      p.remove();
    });
    // in a list item that opens with a bold question, the break after it is the bold's own
    body.querySelectorAll('li').forEach(function (li) { var k = Array.prototype.filter.call(li.childNodes, function (n) { return !(n.nodeType === 3 && !n.textContent.trim()); }); if (k.length > 1 && /^(B|STRONG)$/.test(k[0].nodeName) && k[1].nodeName === 'BR') k[1].remove(); });
    // stray breaks at the end of a paragraph, and paragraphs with nothing in them
    body.querySelectorAll('p, li').forEach(function (p) { var n = p.lastChild; while (n && (n.nodeName === 'BR' || (n.nodeType === 3 && !n.textContent.trim()))) { var prev = n.previousSibling; n.remove(); n = prev; } });
    body.querySelectorAll('p, div, h1, h2, h3, h4, h5, h6, li').forEach(function (el) { if (blank(el)) el.remove(); });
    // one level of headings in the note: a bold line on its own is one too
    body.querySelectorAll('h1').forEach(function (h) { var n = document.createElement('h2'); n.innerHTML = h.innerHTML; h.replaceWith(n); });
    body.querySelectorAll('h4, h5, h6').forEach(function (h) { var n = document.createElement('h3'); n.innerHTML = h.innerHTML; h.replaceWith(n); });
    // empty inline wrappers and breaks at the edge of bold text say nothing
    body.querySelectorAll('i, em, b, strong, u').forEach(function (el) { if (blank(el)) el.remove(); });
    body.querySelectorAll('b, strong').forEach(function (el) { var n = el.lastChild; while (n && n.nodeName === 'BR') { el.parentNode.insertBefore(n, el.nextSibling); n = el.lastChild; } });
    // a bold line followed by a break, at the head of a paragraph, is that paragraph's heading
    Array.prototype.slice.call(body.querySelectorAll(':scope > p')).forEach(function (p) {
      var k = Array.prototype.filter.call(p.childNodes, function (n) { return !(n.nodeType === 3 && !n.textContent.trim()); });
      if (k.length > 2 && /^(B|STRONG)$/.test(k[0].nodeName) && k[1].nodeName === 'BR') {
        var t = k[0].textContent.trim();
        if (t.length > 2 && t.length < 110 && !/[.,;:]$/.test(t)) { var h = document.createElement('h3'); h.textContent = t; p.parentNode.insertBefore(h, p); k[0].remove(); k[1].remove(); }
      }
    });
    body.querySelectorAll('p').forEach(function (p) {
      var els = Array.prototype.filter.call(p.childNodes, function (n) { return !(n.nodeType === 3 && !n.textContent.trim()) && n.nodeName !== 'BR'; });
      var t = p.textContent.trim();
      if (els.length === 1 && /^(B|STRONG)$/.test(els[0].nodeName) && t.length > 2 && t.length < 110 && !/[.,;]$/.test(t)) { var h = document.createElement('h3'); h.textContent = t; p.replaceWith(h); }
    });
    // the first paragraph opens the note; a short last line from the team signs it
    var ps = body.querySelectorAll(':scope > p');
    if (ps.length) { ps[0].classList.add('ms-art-lede'); var l = ps[ps.length - 1], lt = l.textContent.trim(); if (ps.length > 2 && lt.length < 70 && /(team|midsummer|chiara|atelier)/i.test(lt) && !/[.?!]$/.test(lt)) l.classList.add('ms-art-sign'); }
    // a paragraph that is only a link is an invitation
    body.querySelectorAll(':scope > p').forEach(function (p) { var k = Array.prototype.filter.call(p.childNodes, function (n) { return !(n.nodeType === 3 && !n.textContent.trim()); }); if (k.length === 1 && k[0].nodeName === 'A' && k[0].textContent.trim().length < 80) p.classList.add('ms-art-cta'); });
    body.querySelectorAll(':scope > p').forEach(function (p) { if (p.querySelector('img') && !p.textContent.trim()) p.classList.add('ms-art-pic'); });
    body.classList.add('is-tidy');
  })();
</script>
</div>
{%- unless section.settings.end_after -%}{% render 'ms-article-end', s: section.settings, art: article, b: blog %}{%- endunless -%}
{%- liquid
  assign ld_img = article.image | default: blog.image
  assign ld_desc = article.excerpt_or_content | strip_html | strip_newlines | truncate: 300
  if article.metafields.global.description_tag != blank
    assign ld_desc = article.metafields.global.description_tag
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": "{{ shop.url }}{{ article.url }}#article",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ shop.url }}{{ article.url }}" },
  "headline": {{ article.title | strip_html | truncate: 110 | json }},
  "description": {{ ld_desc | json }},
  {%- if ld_img %}
  "image": [{{ ld_img | image_url: width: 1600 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "inLanguage": {{ request.locale.iso_code | json }},
  {%- if article.author != blank %}
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  {%- else %}
  "author": { "@id": "{{ shop.url }}/#organization" },
  {%- endif %}
  "publisher": { "@id": "{{ shop.url }}/#organization" },
  "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "url": "{{ shop.url }}{{ blog.url }}" },
  {%- if kicker != blank %}
  "articleSection": {{ kicker | strip | json }},
  {%- endif %}
  "keywords": {{ article.tags | join: ', ' | json }},
  "wordCount": {{ words | json }}
}
</script>
<div class="ms-read" aria-hidden="true"><span data-ms-read></span></div>
<script>
  (function () {
    var bar = document.querySelector('[data-ms-read]'), body = document.querySelector('.ms-article-body');
    if (!bar || !body) return;
    var tick = null;
    function update() {
      tick = null;
      var r = body.getBoundingClientRect(), h = r.height - window.innerHeight * .6;
      var p = Math.min(1, Math.max(0, -r.top / Math.max(1, h)));
      bar.style.transform = 'scaleX(' + p.toFixed(4) + ')';
    }
    window.addEventListener('scroll', function () { if (!tick) tick = requestAnimationFrame(update); }, { passive: true });
    update();
    document.querySelectorAll('[data-ms-copy]').forEach(function (b) { b.addEventListener('click', function () { var s = b.querySelector('span') || b, t = s.textContent; (navigator.clipboard ? navigator.clipboard.writeText(b.getAttribute('data-ms-copy')) : Promise.reject()).then(function () { s.textContent = '✓'; setTimeout(function () { s.textContent = t; }, 1600); }, function () {}); }); });
  })();
</script>
<style>

  /* reading: a book's measure, a lede, quiet headings, pictures to the edge of the text */
  .ms-site a.ms-art-back { display: inline-flex; gap: 10px; align-items: center; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; margin-bottom: clamp(26px, 3vw, 40px); }
  .ms-site a.ms-art-back:hover { color: #17140F; }
  .ms-site .ms-article-body { font-size: 17px !important; line-height: 1.9 !important; color: #2F2B25 !important; max-width: 760px !important; }
  .ms-site .ms-article-body > p:first-of-type { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(21px, 2vw, 25px); line-height: 1.55; color: #17140F; }
  .ms-site .ms-article-body h2, .ms-site .ms-article-body h3 { font-family: Newsreader, Georgia, serif; font-weight: 300; letter-spacing: -0.015em; color: #17140F; margin-top: 18px; }
  .ms-site .ms-article-body h2 { font-size: clamp(26px, 2.6vw, 34px); line-height: 1.2; }
  .ms-site .ms-article-body h3 { font-size: clamp(21px, 2vw, 25px); line-height: 1.3; }
  .ms-site .ms-article-body a { color: #17140F; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .ms-site .ms-article-body blockquote { margin: 12px 0; padding: 4px 0 4px 26px; border-left: 1px solid #7E623B; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(21px, 2vw, 26px); line-height: 1.5; color: #17140F; }
  .ms-site .ms-article-body img { width: 100%; height: auto; margin: 10px 0; }
  .ms-site .ms-article-body ul, .ms-site .ms-article-body ol { padding-left: 1.2em; display: grid; gap: 8px; }
  .ms-art-share { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 18px; padding-top: 22px; border-top: 1px solid #DDD6C9; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-art-share span { color: #7E623B; }
  .ms-site .ms-art-share a, .ms-site .ms-art-share button { color: #4A443B; background: none; border: 0; padding: 6px 0; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer; text-decoration: none !important; }
  .ms-site .ms-art-share a:hover, .ms-site .ms-art-share button:hover { color: #17140F; }

  .ms-site .ms-art-share a, .ms-site .ms-art-share button { border-bottom: 0 !important; }
  .ms-art-end { background: #F4EFE5; padding: clamp(64px, 8vw, 120px) clamp(16px, 5vw, 80px); }
  .ms-art-end__in { max-width: 760px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; align-items: center; }
  .ms-art-end__leaf { color: #7E623B; }
  .ms-art-end__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; margin-top: 18px; }
  .ms-site .ms-art-end__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(28px, 3.4vw, 46px); line-height: 1.1; letter-spacing: -0.025em; color: #17140F; margin-top: 16px; max-width: 22ch; }
  .ms-site .ms-art-end__t { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 18px; max-width: 54ch; }
  .ms-art-end__links { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 30px; margin-top: clamp(26px, 3vw, 36px); }
  .ms-site a.ms-art-end__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #17140F; color: #FBF9F5; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; text-decoration: none; }
  .ms-site a.ms-art-end__btn:hover { background: #2F2A22; }
  .ms-site a.ms-art-end__all { display: inline-flex; gap: 10px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #4A443B; text-decoration: none; border-bottom: 1px solid rgba(23, 20, 15, .3); padding-bottom: 5px; }
  .ms-site a.ms-art-end__all:hover { color: #17140F; border-color: #17140F; }
  .ms-art-nav { max-width: 1120px; margin: 0 auto; padding: clamp(48px, 6vw, 88px) clamp(16px, 5vw, 80px) 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); }
  .ms-art-nav.is-solo { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
  .ms-site a.ms-art-nav__a { display: grid; grid-template-columns: 38% 1fr; align-items: stretch; border: 1px solid #DDD6C9; color: #17140F; text-decoration: none; transition: border-color .3s ease, background .3s ease; overflow: hidden; }
  .ms-site a.ms-art-nav__a:hover { border-color: #17140F; background: #F4EFE5; }
  .ms-site a.ms-art-nav__a.is-next { grid-template-columns: 1fr 38%; text-align: right; }
  .ms-art-nav__a.is-next .ms-art-nav__img { order: 2; }
  .ms-art-nav__img { display: flex; align-items: center; justify-content: center; background: #EDE6D9; min-height: 150px; overflow: hidden; }
  .ms-art-nav__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1s cubic-bezier(.2, .7, .2, 1); }
  .ms-art-nav__a:hover .ms-art-nav__img img { transform: scale(1.04); }
  .ms-art-nav__txt { display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: clamp(18px, 2.4vw, 30px); }
  .ms-art-nav__lab { font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: #7E623B; }
  .ms-art-nav__a em { font-family: Newsreader, Georgia, serif; font-style: normal; font-size: clamp(19px, 1.8vw, 24px); line-height: 1.3; }
  .ms-art-nav__meta { font-size: 12px; letter-spacing: .06em; color: #6E675C; }
  @media (max-width: 700px) {
    .ms-art-nav { grid-template-columns: minmax(0, 1fr); }
