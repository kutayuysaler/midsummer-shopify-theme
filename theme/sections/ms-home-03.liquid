<section data-dc-tpl="218" style="padding: 0px clamp(18px, 5vw, 80px) clamp(80px, 12vw, 190px); max-width: 1560px; margin: 0px auto;">
<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 24px; border-top: 1px solid rgb(221, 214, 201); padding-top: 26px; margin-bottom: clamp(36px, 5vw, 72px);">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.6vw, 50px); line-height: 1.06; letter-spacing: -0.02em;">{{ section.settings.t1 }}</h2>
<a data-ms="cta" href="/collections" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t2 }}</a>
</div>
<div data-ms="rail" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(18px, 3vw, 48px);">
<a href="/collections/essentials" style="display: block;">
<img alt="Essentials" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-bougainvillea.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover;"/>
<div style="display: flex; align-items: baseline; gap: 12px; margin-top: 22px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t3 }}</span><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 2.4vw, 30px);">{{ section.settings.t4 }}</h3></div>
<p style="font-size: 14px; line-height: 1.85; color: rgb(74, 68, 59); margin-top: 12px; max-width: 40ch;">{{ section.settings.t5 }}</p>
</a>
<a href="/collections/signature" style="display: block;">
<img alt="Signature" loading="lazy" src="{% if section.settings.img2 != blank %}{{ section.settings.img2 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-ochre-room.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover;"/>
<div style="display: flex; align-items: baseline; gap: 12px; margin-top: 22px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t6 }}</span><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 2.4vw, 30px);">{{ section.settings.t7 }}</h3></div>
<p style="font-size: 14px; line-height: 1.85; color: rgb(74, 68, 59); margin-top: 12px; max-width: 40ch;">{{ section.settings.t8 }}</p>
</a>
<a href="/collections/icons" style="display: block;">
<img alt="Icons" loading="lazy" src="{% if section.settings.img3 != blank %}{{ section.settings.img3 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-arches.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 3 / 4; object-fit: cover;"/>
<div style="display: flex; align-items: baseline; gap: 12px; margin-top: 22px;"><span style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t9 }}</span><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 2.4vw, 30px);">{{ section.settings.t10 }}</h3></div>
<p style="font-size: 14px; line-height: 1.85; color: rgb(74, 68, 59); margin-top: 12px; max-width: 40ch;">{{ section.settings.t11 }}</p>
</a>
</div>
</section>
{% schema %}
{
  "name": "Home 03 · Three collectio",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: Essentials"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image: Signature"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Image: Icons"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Three collections",
      "default": "Three collections"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "All twenty-four →",
      "default": "All twenty-four →"
    },
    {
      "type": "text",
      "id": "t3",
      "label": "I",
      "default": "I"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Essentials",
      "default": "Essentials"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "The entry point into the Midsummer…",
      "default": "The entry point into the Midsummer world. Natural fibres, authentic artisan construction, clean lines."
    },
    {
      "type": "text",
      "id": "t6",
      "label": "II",
      "default": "II"
    },
    {
      "type": "text",
      "id": "t7",
      "label": "Signature",
      "default": "Signature"
    },
    {
      "type": "textarea",
      "id": "t8",
      "label": "The heart of the collection. Loro …",
      "default": "The heart of the collection. Loro Piana Interiors fabrics over spring architectures designed for the highest comfort."
    },
    {
      "type": "text",
      "id": "t9",
      "label": "III",
      "default": "III"
    },
    {
      "type": "text",
      "id": "t10",
      "label": "Icons",
      "default": "Icons"
    },
    {
      "type": "text",
      "id": "t11",
      "label": "The most important pieces we make.…",
      "default": "The most important pieces we make. Completely bespoke, with no equivalent on the market."
    }
  ]
}
{% endschema %}
