{%- comment -%}
  Recognition: the award in one sentence, then the publications that have written about
  the house, as a quiet grid of their marks. Each mark leads to its press page.
{%- endcomment -%}
<section class="ms-pr">
  <div class="ms-pr__in">
    <div class="ms-pr__eyebrow">{{ section.settings.eyebrow }}</div>
    <p class="ms-pr__award">{{ section.settings.award }}</p>
    <div class="ms-pr__by">{{ section.settings.award_by }}</div>
    {%- if section.blocks.size > 0 -%}
      <div class="ms-pr__label"><span></span>{{ section.settings.press_label }}<span></span></div>
      <ul class="ms-pr__grid" role="list">
        {%- for block in section.blocks limit: section.settings.limit -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.name | escape }}">
              {%- if block.settings.logo != blank -%}<img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.name | escape }}" width="150" height="40" loading="lazy">
              {%- elsif block.settings.logo_file != blank -%}<img src="{{ block.settings.logo_file | asset_url }}" alt="{{ block.settings.name | escape }}" width="150" height="40" loading="lazy">
              {%- else -%}<span>{{ block.settings.name }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- capture press -%}{% render 'ms-link', to: 'press', strict: true %}{%- endcapture -%}
      {%- if press != blank and section.settings.all_label != blank -%}<a class="ms-pr__all" href="{{ press }}">{{ section.settings.all_label }}</a>{%- endif -%}
    {%- endif -%}
  </div>
</section>
<style>
  .ms-pr { background: #FBF9F5; color: #17140F; padding: clamp(96px, 12vw, 200px) clamp(18px, 5vw, 80px); text-align: center; border-top: 1px solid #ECE6DB; }
  .ms-pr__in { max-width: 1240px; margin: 0 auto; }
  .ms-pr__eyebrow { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: #9A7B4F; }
  .ms-pr__award { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(28px, 3.4vw, 50px); line-height: 1.2; letter-spacing: -0.025em; max-width: 26ch; margin: clamp(24px, 3vw, 38px) auto 0; text-wrap: balance; }
  .ms-pr__by { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; margin-top: 22px; }
  .ms-pr__label { display: flex; align-items: center; justify-content: center; gap: 20px; margin-top: clamp(72px, 8vw, 130px); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: #6E675C; }
  .ms-pr__label span { width: clamp(28px, 6vw, 72px); height: 1px; background: #DDD6C9; }
  .ms-pr__grid { list-style: none; margin: clamp(30px, 3.4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); border-top: 1px solid #ECE6DB; border-left: 1px solid #ECE6DB; }
  .ms-pr__grid li { border-right: 1px solid #ECE6DB; border-bottom: 1px solid #ECE6DB; }
  .ms-pr__grid a { display: flex; align-items: center; justify-content: center; height: clamp(84px, 8vw, 112px); padding: 0 clamp(14px, 1.8vw, 26px); }
  .ms-site .ms-pr__grid img { max-width: 100%; max-height: 34px; width: auto; height: auto; object-fit: contain; filter: grayscale(1) contrast(1.1); opacity: .62; transition: opacity .35s ease; }
  .ms-pr__grid a:hover img { opacity: 1; }
  .ms-pr__grid span { font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #8C8579; }
  .ms-site .ms-pr__all { display: inline-block; margin-top: clamp(32px, 3.6vw, 50px); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  @media (max-width: 1000px) { .ms-pr__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ms-pr__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .ms-pr__grid li:nth-child(n+13) { display: none; } }
</style>

{% schema %}
{
  "name": "Home · Recognition",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Recognition" },
    { "type": "textarea", "id": "award", "label": "Award", "default": "The Top System was awarded the Green Product Award 2025, in Berlin, for its plant-based materials and seasonal construction." },
    { "type": "text", "id": "award_by", "label": "Award line", "default": "Green Product Award · Berlin, 2025" },
    { "type": "text", "id": "press_label", "label": "Press label", "default": "As featured in" },
    { "type": "range", "id": "limit", "label": "Publications shown", "min": 6, "max": 30, "step": 6, "default": 18 },
    { "type": "text", "id": "all_label", "label": "Link to the press page", "default": "All the press" }
  ],
  "blocks": [
    {
      "type": "publication",
      "name": "Publication",
      "settings": [
        { "type": "text", "id": "name", "label": "Publication", "default": "Publication" },
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "logo_file", "label": "Logo file in the theme" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "row", "label": "Row", "options": [{"value":"1","label":"First"},{"value":"2","label":"Second"}], "default": "1" }
      ]
    }
  ],
  "presets": [{ "name": "Home · Recognition" }]
}
{% endschema %}
