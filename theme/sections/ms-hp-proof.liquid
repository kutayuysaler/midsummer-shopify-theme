{%- comment -%}
  Recognition and press. One publication at a time: its mark, the headline of its piece
  (taken live from that publication's press blog, or the line set in the block), and a
  link to read it. The award opens the sequence. Beneath, every publication's mark, one still
  line at a time: those with a piece first (hover or tap one to bring its piece forward), then
  the others. The arrows beneath turn to the next line; nothing moves on its own.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign n = 1
  if s.show_award == false
    assign n = 0
  endif
  capture items
    if s.show_award
    echo '<figure class="ms-pr__item is-on" data-ms-pr-item="0" aria-hidden="false">'
    if s.award_logo != blank
      assign alogo = s.award_logo
      unless alogo contains '/'
        assign alogo = alogo | asset_url
      endunless
      capture eby0
        render 'ms-t', v: s.award_by
      endcapture
      assign eby0 = eby0 | escape
      echo '<div class="ms-pr__mark"><img src="' | append: alogo | append: '" alt="' | append: eby0 | append: '" width="200" height="56"></div>'
    endif
    capture ms_d1
      render 'ms-t', v: s.award
    endcapture
    echo '<p class="ms-pr__line">' | append: ms_d1 | append: '</p>'
    capture ms_d2
      render 'ms-t', v: s.award_by
    endcapture
    echo '<figcaption class="ms-pr__cap"><span>' | append: ms_d2 | append: '</span>'
    if s.award_link != blank
      capture ms_d3
        render 'ms-t', v: s.award_link_label
      endcapture
      echo '<a href="' | append: s.award_link | append: '" target="_blank" rel="noopener">' | append: ms_d3 | append: ' <span aria-hidden="true">→</span></a>'
    endif
    echo '</figcaption></figure>'
    endif
  endcapture
  # every publication with a piece behind it (an article in its press blog, or a headline set in
  # its block); a mark with nothing to read is not shown. Most recent first, as many as set; the
  # rest are on the press page.
  assign recs = ''
  assign rest = ''
  for block in section.blocks
    assign handle = block.settings.link | split: '/blogs/' | last | split: '/' | first
    if handle contains 'green-product-award'
      continue
    endif
    assign line = ''
    assign href = block.settings.link
    capture when
      render 'ms-t', v: block.settings.when
    endcapture
    if handle != blank and blogs[handle].articles_count > 0
      assign art = blogs[handle].articles.first
      assign line = art.title | replace: 'Midsummer-Milano', 'Midsummer Milano' | escape
      assign href = art.url
      # the year of the piece: the one its title names (a piece filed later keeps its own year),
      # else the year it was published here
      assign when = art.published_at | date: '%Y'
      assign tws = art.title | replace: '-', ' ' | replace: ',', ' ' | replace: '(', ' ' | replace: ')', ' ' | replace: '.', ' ' | split: ' '
      for tw in tws
        if tw.size == 4
          assign tn = tw | plus: 0
          if tn > 1990 and tn < 2100
            assign when = tw
          endif
        endif
      endfor
    elsif block.settings.line != blank
      capture line
        render 'ms-t', v: block.settings.line
      endcapture
      if href contains '/blogs/'
        assign href = ''
      endif
    endif
    if block.settings.logo != blank
      assign src = block.settings.logo | image_url: width: 300
    elsif block.settings.logo_file != blank
      assign src = block.settings.logo_file | asset_url
    else
      assign src = ''
    endif
    if line == blank
      # nothing to read: the mark is still shown, among the others on the line
      if src != blank
        capture ms_d4
          render 'ms-t', v: block.settings.name
        endcapture
        assign rest = rest | append: src | append: '¤' | append: ms_d4 | append: '¦'
      endif
      continue
    endif
    assign yk = when | default: '0000' | slice: 0, 4
    assign ik = 99 | minus: forloop.index | prepend: '0' | slice: -2, 2
    capture ms_d5
      render 'ms-t', v: block.settings.name
    endcapture
    assign rec = yk | append: '~' | append: ik | append: '¤' | append: line | append: '¤' | append: href | append: '¤' | append: when | append: '¤' | append: src | append: '¤' | append: ms_d5 | append: '¤' | append: block.shopify_attributes
    assign recs = recs | append: rec | append: '¦'
  endfor
  assign recs = recs | split: '¦' | sort | reverse
  assign max = s.max_logos | default: 8
  capture strip
    if s.show_award and s.award_logo != blank
      capture eby
        render 'ms-t', v: s.award_by
      endcapture
      assign eby = eby | escape
      echo '<li class="ms-pr__logo has-piece"><button type="button" data-ms-pr-to="0" aria-label="' | append: eby | append: '"><img src="' | append: alogo | append: '" alt="' | append: eby | append: '" width="150" height="40"></button></li>'
    endif
    for r in recs limit: max
      assign f = r | split: '¤'
      assign line = f[1]
      assign href = f[2]
      assign when = f[3]
      assign src = f[4]
      assign name = f[5]
      assign ename = name | escape
      assign mark = ''
      if src != blank
        assign mark = '<div class="ms-pr__mark"><img src="' | append: src | append: '" alt="' | append: ename | append: '" width="200" height="56"></div>'
      endif
      capture one
        if n == 0
          echo '<figure class="ms-pr__item is-on" data-ms-pr-item="0" aria-hidden="false">' | append: mark
        else
          echo '<figure class="ms-pr__item" data-ms-pr-item="' | append: n | append: '" aria-hidden="true">' | append: mark
        endif
        echo '<p class="ms-pr__line">' | append: line | append: '</p>'
        echo '<figcaption class="ms-pr__cap"><span>' | append: name
        if when != blank
          echo ' · ' | append: when
        endif
        echo '</span>'
        if href != blank
          capture ms_d6
            render 'ms-t', v: s.read_label
          endcapture
          echo '<a href="' | append: href | append: '">' | append: ms_d6 | append: ' <span aria-hidden="true">→</span></a>'
        endif
        echo '</figcaption></figure>'
      endcapture
      assign items = items | append: one
      echo '<li class="ms-pr__logo has-piece" ' | append: f[6] | append: '><button type="button" data-ms-pr-to="' | append: n | append: '" aria-label="' | append: ename | append: '">'
      if src != blank
        echo '<img src="' | append: src | append: '" alt="' | append: ename | append: '" width="150" height="40">'
      else
        echo '<span>' | append: name | append: '</span>'
      endif
      echo '</button></li>'
      assign n = n | plus: 1
    endfor
    # the rest of the press: the pieces beyond those shown, then every other publication
    for r in recs offset: max
      assign f = r | split: '¤'
      if f[4] != blank
        assign ename = f[5] | escape
        echo '<li class="ms-pr__logo is-plain"><span class="ms-pr__pm"><img src="' | append: f[4] | append: '" alt="' | append: ename | append: '" width="150" height="40" loading="lazy"></span></li>'
      endif
    endfor
    assign rl = rest | split: '¦'
    for r in rl
      assign f = r | split: '¤'
      assign ename = f[1] | escape
      echo '<li class="ms-pr__logo is-plain"><span class="ms-pr__pm"><img src="' | append: f[0] | append: '" alt="' | append: ename | append: '" width="150" height="40" loading="lazy"></span></li>'
    endfor
  endcapture
  capture press_url
    render 'ms-link', to: 'press', strict: true
  endcapture
-%}
<section class="ms-pr" data-ms-pr data-interval="{{ s.interval | times: 1000 }}">
  <div class="ms-pr__in">
    <div class="ms-pr__top">
      <span class="ms-pr__eyebrow">{% render 'ms-t', v: s.eyebrow %}</span>
      <span class="ms-pr__count"><span data-ms-pr-n>01</span> / {% if n < 10 %}0{% endif %}{{ n }}</span>
    </div>
    <div class="ms-pr__stage" aria-live="polite">{{ items }}</div>
    <div class="ms-pr__bar" role="tablist" aria-label="{% capture ms_t_out %}{% render 'ms-t', v: s.eyebrow %}{% endcapture %}{{ ms_t_out | escape }}">
      {%- for i in (1..n) -%}
        <button type="button" class="ms-pr__seg{% if forloop.first %} is-on{% endif %}" data-ms-pr-to="{{ forloop.index0 }}" aria-label="{{ forloop.index }}"><span></span></button>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="ms-pr__strip">
      <div class="ms-pr__label">{% render 'ms-t', v: s.press_label %}</div>
      <div class="ms-pr__rail" data-ms-pr-rail data-drift="{% if s.drift == false %}0{% else %}1{% endif %}">
        <ul class="ms-pr__run" role="list" data-ms="pressrow">{{ strip }}</ul>
        <span class="ms-pr__cursor" aria-hidden="true"><span><svg viewBox="0 0 10 10"><path d="M6.5 2 3.5 5l3 3" fill="none" stroke="currentColor" stroke-width="1"/></svg>{% render 'ms-t', v: 'Drag' %}<svg viewBox="0 0 10 10"><path d="m3.5 2 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1"/></svg></span></span>
      </div>
      {%- if press_url != blank and s.all_label != blank -%}<a class="ms-pr__all" href="{{ press_url }}">{% render 'ms-t', v: s.all_label %} <span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
  {%- endif -%}
</section>
<style>
  .ms-pr { background: #FBF9F5; color: #17140F; padding: clamp(88px, 10vw, 160px) 0 0; border-top: 1px solid #ECE6DB; }
  .ms-pr__in { max-width: 1120px; margin: 0 auto; padding: 0 clamp(18px, 5vw, 80px); text-align: center; }
  .ms-pr__top { display: flex; justify-content: space-between; align-items: baseline; font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: #7E623B; border-bottom: 1px solid #ECE6DB; padding-bottom: 16px; }
  .ms-pr__count { font-family: Newsreader, Georgia, serif; font-size: 14px; letter-spacing: 0; color: #6E675C; font-variant-numeric: tabular-nums; }
  .ms-pr__count span { color: #17140F; }
  .ms-pr__stage { position: relative; display: grid; min-height: clamp(300px, 30vw, 380px); margin-top: clamp(40px, 5vw, 64px); }
  .ms-pr__item { grid-area: 1 / 1; margin: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0; transform: translateY(14px); transition: opacity .8s ease, transform 1s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  .ms-pr__item.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .ms-pr__mark { height: 44px; display: flex; align-items: center; justify-content: center; }
  .ms-site .ms-pr .ms-pr__mark img { height: 40px; max-width: 240px; width: auto; object-fit: contain; filter: grayscale(1) contrast(1.1) !important; opacity: .85; }
  .ms-pr__line { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(26px, 3.1vw, 46px); line-height: 1.22; letter-spacing: -0.025em; max-width: 24ch; margin: clamp(26px, 3vw, 38px) auto 0; text-wrap: balance; }
  .ms-pr__cap { display: flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 10px 28px; margin-top: clamp(22px, 2.6vw, 32px); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; }
  .ms-site .ms-pr__cap a { color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 4px; }
  .ms-pr__bar { display: flex; gap: 6px; justify-content: center; margin-top: clamp(30px, 3.4vw, 46px); }
  .ms-pr__seg { width: clamp(22px, 3vw, 40px); height: 20px; padding: 0; background: none; border: 0; cursor: pointer; display: flex; align-items: center; }
  .ms-pr__seg span { display: block; width: 100%; height: 1px; background: #DDD6C9; position: relative; overflow: hidden; }
  .ms-pr__seg span::after { content: ''; position: absolute; inset: 0; background: #17140F; transform: scaleX(0); transform-origin: left; }
  .ms-pr__seg.is-on span::after { animation: msPrFill var(--t, 6s) linear forwards; }
  .ms-pr.is-paused .ms-pr__seg.is-on span::after { animation-play-state: paused; }
  .ms-pr__seg.is-done span::after { transform: none; }
  @keyframes msPrFill { to { transform: none; } }

  /* every publication, in one slow line */
  .ms-pr__strip { margin-top: clamp(64px, 7vw, 104px); border-top: 1px solid #ECE6DB; border-bottom: 1px solid #ECE6DB; padding: 22px 0 26px; text-align: center; }
  .ms-pr__label { font-size: 10.5px; letter-spacing: .3em; text-transform: uppercase; color: #6E675C; }
  .ms-pr__rail { display: flex; overflow: hidden; margin-top: 18px; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .ms-pr__run { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; flex: 0 0 auto; animation: msPrRun 90s linear infinite; }
  .ms-pr__rail:hover .ms-pr__run, .ms-pr__rail:focus-within .ms-pr__run { animation-play-state: paused; }
  @keyframes msPrRun { to { transform: translateX(-100%); } }
  .ms-pr__logo > * { display: flex; align-items: center; justify-content: center; width: clamp(130px, 12vw, 170px); height: 56px; padding: 0 clamp(16px, 2vw, 28px); background: none; border: 0; cursor: pointer; }
  .ms-site .ms-pr .ms-pr__logo img { height: 28px; max-width: 100%; width: auto; object-fit: contain; filter: grayscale(1) !important; opacity: .45; transition: opacity .35s ease, transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-pr__logo span { font-size: 10.5px; letter-spacing: .16em; text-transform: uppercase; color: #6E675C; }
  .ms-pr__logo > *:hover img, .ms-pr__logo > *:focus-visible img, .ms-pr__logo.is-on img { opacity: 1; transform: scale(1.04); }
  .ms-site .ms-pr__all { display: inline-block; margin-top: 18px; font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 4px; }
  @media (prefers-reduced-motion: reduce) {
    .ms-pr__run { animation: none; }
    .ms-pr__rail { overflow-x: auto; }
    .ms-pr__item { transition: none; }
  }

  /* quiet by design: no rotation, no moving line; a mark brings its piece forward when pointed at */
  .ms-pr { padding-top: clamp(56px, 6vw, 96px); }
  .ms-pr__count, .ms-pr__bar { display: none; }
  .ms-pr__stage { min-height: clamp(150px, 13vw, 190px); margin-top: clamp(26px, 3vw, 40px); }
  .ms-pr__mark { height: 30px; }
  .ms-site .ms-pr .ms-pr__mark img { height: 26px; }
  .ms-pr__line { font-size: clamp(20px, 1.9vw, 27px); line-height: 1.35; max-width: 34ch; margin-top: 16px; }
  .ms-pr__cap { margin-top: 14px; }
  .ms-pr__strip { margin-top: clamp(32px, 3.4vw, 48px); padding: 18px clamp(18px, 5vw, 80px) 22px; }
  .ms-pr__rail { mask-image: none; -webkit-mask-image: none; justify-content: center; margin-top: 12px; }
  .ms-pr__run { animation: none; flex: 1 1 auto; flex-wrap: wrap; justify-content: center; max-width: 1180px; }
  .ms-pr__logo > * { width: auto; height: 48px; padding: 0 clamp(12px, 1.6vw, 22px); }
  .ms-pr__run { flex-wrap: nowrap; overflow: hidden; }
  /* Round 26: one endless line of every publication's mark, drifting slowly, held and moved by hand */
  .ms-pr__rail { position: relative; display: block; margin: 14px 0 0; overflow: hidden; touch-action: pan-y; -webkit-mask-image: none; mask-image: none; user-select: none; -webkit-user-select: none; }
  .ms-pr__rail::before, .ms-pr__rail::after { content: ''; position: absolute; top: 0; bottom: 0; z-index: 1; width: clamp(40px, 9vw, 160px); pointer-events: none; }
  .ms-pr__rail::before { left: 0; background: linear-gradient(90deg, #FBF9F5, rgba(251, 249, 245, 0)); }
  .ms-pr__rail::after { right: 0; background: linear-gradient(270deg, #FBF9F5, rgba(251, 249, 245, 0)); }
  .ms-site .ms-pr .ms-pr__run { display: flex; flex-wrap: nowrap; justify-content: flex-start; width: max-content; max-width: none; margin: 0; overflow: visible; animation: none; will-change: transform; }
  .ms-pr__run > li, .ms-pr__run > li:nth-child(n) { display: flex; flex: 0 0 auto; }
  .ms-pr__logo > * { width: clamp(136px, 12vw, 176px); height: 76px; padding: 0 clamp(14px, 1.6vw, 26px); }
  .ms-site .ms-pr .ms-pr__logo img { height: 24px; width: auto; max-width: 100%; max-height: 30px; opacity: .58; pointer-events: none; -webkit-user-drag: none; transition: opacity .35s ease; }
  .ms-site .ms-pr .ms-pr__logo > button:hover img, .ms-site .ms-pr .ms-pr__logo > button:focus-visible img, .ms-site .ms-pr .ms-pr__logo.is-on img { opacity: 1; }
  .ms-pr__logo.is-plain > * { cursor: inherit; }
  .ms-pr__rail.is-dragging .ms-pr__logo > * { cursor: inherit; }
  .ms-pr__cursor { position: absolute; left: 0; top: 0; z-index: 2; width: 0; height: 0; pointer-events: none; }
  .ms-pr__cursor > span { position: absolute; left: -42px; top: -42px; width: 84px; height: 84px; border-radius: 50%; display: flex; align-items: center; justify-content: center; gap: 3px; background: rgba(23, 20, 15, .9); color: #FBF9F5; font-size: 9px; letter-spacing: .16em; text-transform: uppercase; opacity: 0; transform: scale(.4); transition: opacity .3s ease, transform .45s cubic-bezier(.2, .7, .2, 1); }
  .ms-pr__cursor svg { width: 7px; height: 7px; flex: 0 0 auto; }
  .ms-pr__cursor.is-tight svg { display: none; }
  .ms-pr__rail.is-cursor .ms-pr__cursor > span { opacity: 1; transform: scale(1); }
  .ms-pr__rail.is-cursor.is-dragging .ms-pr__cursor > span { transform: scale(.82); }
  @media (hover: hover) and (pointer: fine) { .ms-pr__rail, .ms-pr__rail * { cursor: none !important; } }
  @media (hover: none), (pointer: coarse) { .ms-pr__cursor { display: none; } }
  @media (max-width: 760px) {
    .ms-pr__logo > * { width: 124px; height: 64px; padding: 0 12px; }
    .ms-site .ms-pr .ms-pr__logo img { height: 20px; max-height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-pr__rail { overflow: hidden; } }
</style>
<script>
  (function () {
    var root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.hasAttribute('data-ms-pr')) root = document.querySelector('[data-ms-pr]');
    if (!root) return;
    var items = root.querySelectorAll('[data-ms-pr-item]');
    var segs = root.querySelectorAll('.ms-pr__seg');
    var num = root.querySelector('[data-ms-pr-n]');
    var wait = +root.getAttribute('data-interval') || 6000;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var at = 0, timer = null, paused = false;
    root.style.setProperty('--t', wait + 'ms');
    function show(i) {
      at = (i + items.length) % items.length;
      items.forEach(function (it, k) { it.classList.toggle('is-on', k === at); it.setAttribute('aria-hidden', k === at ? 'false' : 'true'); });
      segs.forEach(function (sg, k) {
        sg.classList.remove('is-on'); sg.classList.toggle('is-done', k < at);
        if (k === at) { void sg.offsetWidth; sg.classList.add('is-on'); }
      });
      root.querySelectorAll('.ms-pr__logo').forEach(function (l) {
        var b = l.querySelector('[data-ms-pr-to]');
        l.classList.toggle('is-on', !!b && +b.getAttribute('data-ms-pr-to') === at);
      });
      if (num) num.textContent = (at + 1 < 10 ? '0' : '') + (at + 1);
      schedule();
    }
    function schedule() {
      clearTimeout(timer);
      return; // no rotation: a piece changes only when its mark is pointed at or chosen
      timer = setTimeout(function () { show(at + 1); }, wait);
    }
    root.addEventListener('click', function (e) {
      var b = e.target.closest('[data-ms-pr-to]');
      if (b) { e.preventDefault(); show(+b.getAttribute('data-ms-pr-to')); }
    });
    root.addEventListener('mouseover', function (e) {
      var b = e.target.closest('.ms-pr__logo [data-ms-pr-to]');
      if (b && !root.classList.contains('is-pr-dragging') && +b.getAttribute('data-ms-pr-to') !== at) show(+b.getAttribute('data-ms-pr-to'));
    });
    var stage = root.querySelector('.ms-pr__in');
    function pause(v) { paused = v; root.classList.toggle('is-paused', v); if (!v) schedule(); else clearTimeout(timer); }
    [stage, root.querySelector('[data-ms-pr-rail]')].forEach(function (el) {
      if (!el) return;
      el.addEventListener('mouseenter', function () { pause(true); });
      el.addEventListener('mouseleave', function () { pause(false); });
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (es) { es.forEach(function (en) { if (en.isIntersecting) { if (!paused) show(at); } else clearTimeout(timer); }); }, { threshold: 0.3 }).observe(root);
    } else { schedule(); }

    // Round 26: one endless line of every mark: it drifts slowly, stops under the cursor, and is moved by hand
    var rail = root.querySelector('[data-ms-pr-rail]'), run = root.querySelector('.ms-pr__run'), cur = root.querySelector('.ms-pr__cursor');
    if (!rail || !run) return;
    var marks = [].slice.call(run.children), narrow = window.matchMedia('(max-width: 760px)'), fine = window.matchMedia('(hover: hover) and (pointer: fine)');
    var setW = 0, x = 0, v = 0, drag = null, held = false, focus = false, moved = 0, rest = 0, t0 = 0, raf = 0, seen = true, quiet = 0;
    var drift = rail.getAttribute('data-drift') !== '0' && !reduce;
    function weigh(img) {
      // one optical weight for marks of every shape: a long wordmark is drawn lower than a compact one
      var ar = img.naturalWidth / img.naturalHeight;
      if (!ar || !isFinite(ar)) return;
      var k = narrow.matches ? .84 : 1, wmax = narrow.matches ? 100 : 136;
      var h = Math.max(12, Math.min(30, 24 * Math.pow(4 / ar, .42))) * k;
      if (h * ar > wmax) h = Math.max(9, wmax / ar);
      img.style.height = h.toFixed(1) + 'px'; img.style.width = 'auto'; img.style.maxHeight = 'none';
    }
    function weighAll() {
      run.querySelectorAll('img').forEach(function (i) {
        if (i.complete && i.naturalWidth) weigh(i); else i.addEventListener('load', function () { weigh(i); }, { once: true });
      });
    }
    function build() {
      // as many copies of the line as fill the width twice over, so that it never shows an end
      run.querySelectorAll('[data-ms-pr-copy]').forEach(function (c) { c.remove(); });
      setW = marks.reduce(function (s, m) { return s + m.offsetWidth; }, 0);
      if (!setW) return;
      var copies = Math.max(1, Math.ceil(rail.clientWidth * 2 / setW));
      for (var k = 0; k < copies; k++) marks.forEach(function (m) {
        var c = m.cloneNode(true);
        c.setAttribute('data-ms-pr-copy', ''); c.setAttribute('aria-hidden', 'true'); c.removeAttribute('data-shopify-editor-block');
        c.querySelectorAll('button, a').forEach(function (b) { b.tabIndex = -1; });
        c.querySelectorAll('img').forEach(function (i) { i.loading = 'eager'; });
        run.appendChild(c);
      });
      weighAll();
    }
    function paint() {
