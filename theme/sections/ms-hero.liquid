{%- comment -%}
  Midsummer Milano — full-bleed photograph or film with the words laid over it.
{%- endcomment -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
  assign heading_tag = 'h2'
  if section.settings.heading_size == 'h1'
    assign heading_tag = 'h1'
  endif
-%}

<div
  class="ms ms--dark ms-hero ms-hero--{{ section.settings.height }} ms-hero--{{ section.settings.align }} ms-hero--{{ section.settings.position }}"
  id="ms-hero-{{ section.id }}"
>
  <div class="ms-hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          image_size: '2400x',
          class: 'ms-hero__video'
      }}
    {%- elsif section.settings.video_src != blank -%}
      <video
        class="ms-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1920 }}"{% endif %}
      >
        <source src="{{ section.settings.video_src | escape }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        {{
          section.settings.image_mobile
          | image_url: width: 1200
          | image_tag:
            class: 'ms-hero__img ms-hero__img--mobile',
            widths: '480, 750, 1000, 1200',
            sizes: '100vw',
            alt: section.settings.image_mobile.alt,
            loading: section.settings.loading
        }}
      {%- endif -%}
      {{
        section.settings.image
        | image_url: width: 3000
        | image_tag:
          class: 'ms-hero__img ms-hero__img--desktop',
          widths: '750, 1100, 1500, 1920, 2400, 3000',
          sizes: '100vw',
          alt: section.settings.image.alt,
          loading: section.settings.loading,
          fetchpriority: section.settings.fetchpriority
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg ms-hero__img' }}
    {%- endif -%}
  </div>
  <div class="ms-hero__veil" aria-hidden="true"></div>

  <div class="ms__wrap ms-hero__content{{ reveal }}">
    <div class="ms-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ms-eyebrow ms-eyebrow--rule">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <{{ heading_tag }} class="ms-h ms-h--{{ section.settings.heading_size }}">{{ section.settings.heading | escape | newline_to_br }}</{{ heading_tag }}>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="ms-lead">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="ms-actions">
          {%- render 'ms-button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style, open_panel: section.settings.button_panel -%}
          {%- render 'ms-button', label: section.settings.button_2_label, link: section.settings.button_2_link, style: 'link', open_panel: section.settings.button_2_panel -%}
        </div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="ms-small ms-hero__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  #ms-hero-{{ section.id }} .ms-hero__veil { opacity: {{ section.settings.veil | divided_by: 100.0 }}; }
{% endstyle %}

{% stylesheet %}
  .ms-hero { position: relative; display: flex; overflow: hidden; isolation: isolate; }
  .ms-hero--full { min-height: 100svh; }
  .ms-hero--large { min-height: 88svh; }
  .ms-hero--medium { min-height: 72svh; }
  .ms-hero--small { min-height: 52svh; }
  .ms-hero__media { position: absolute; inset: 0; z-index: -2; }
  .ms-hero__img, .ms-hero__video, .ms-hero__media .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ms-hero__img--mobile { display: none; }
  .ms-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgba(10, 8, 6, 0.95), rgba(10, 8, 6, 0.35) 55%, rgba(10, 8, 6, 0.15));
  }
  .ms-hero--left .ms-hero__veil { background: linear-gradient(to right, rgba(10, 8, 6, 0.9), rgba(10, 8, 6, 0.25) 70%); }
  .ms-hero__content {
    position: relative;
    display: flex;
    width: 100%;
    padding-top: clamp(96px, 12vw, 160px);
    padding-bottom: clamp(48px, 7vw, 110px);
  }
  .ms-hero--bottom .ms-hero__content { align-items: flex-end; }
  .ms-hero--middle .ms-hero__content { align-items: center; }
  .ms-hero--center .ms-hero__content { justify-content: center; text-align: center; }
  .ms-hero__inner { display: flex; flex-direction: column; gap: 22px; max-width: 46rem; }
  .ms-hero--center .ms-hero__inner { align-items: center; }
  .ms-hero .ms-h { color: #FBF9F5; }
  .ms-hero .ms-actions { margin-top: 8px; }
  .ms-hero--center .ms-actions { justify-content: center; }
  .ms-hero .ms-btn--primary { background: #FBF9F5; border-color: #FBF9F5; color: #17140F; }
  .ms-hero .ms-btn--primary:hover { background: transparent; color: #FBF9F5; }
  .ms-hero .ms-btn--secondary { border-color: #FBF9F5; color: #FBF9F5; }
  .ms-hero__note { margin: 0; }
  @media screen and (max-width: 749px) {
    .ms-hero__img--mobile { display: block; }
    .ms-hero__img--mobile + .ms-hero__img--desktop { display: none; }
    .ms-hero--full { min-height: 92svh; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · Hero",
  "tag": "section",
  "class": "ms-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "image_picker", "id": "image_mobile", "label": "Photograph on phones", "info": "Optional. A portrait crop for small screens." },
    { "type": "video", "id": "video", "label": "Film", "info": "Plays muted and looping in place of the photograph." },
    { "type": "text", "id": "video_src", "label": "Film file URL", "info": "Alternative to the picker: paste a video URL from Content → Files. The photograph becomes its poster frame." },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Text position",
      "options": [
        { "value": "bottom", "label": "Bottom" },
        { "value": "middle", "label": "Middle" }
      ],
      "default": "bottom"
    },
    { "type": "range", "id": "veil", "label": "Shade over the photograph", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },
    {
      "type": "select",
      "id": "loading",
      "label": "Image loading",
      "options": [
        { "value": "eager", "label": "Immediately (first section on the page)" },
        { "value": "lazy", "label": "When scrolled to" }
      ],
      "default": "lazy"
    },
    {
      "type": "select",
      "id": "fetchpriority",
      "label": "Image priority",
      "options": [
        { "value": "high", "label": "High (first section on the page)" },
        { "value": "auto", "label": "Normal" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Handmade luxury beds and mattresses, built one by one." },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Display (page title)" },
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Solid ivory" },
        { "value": "secondary", "label": "Outline" },
        { "value": "link", "label": "Text link" }
      ],
      "default": "primary"
    },
    { "type": "checkbox", "id": "button_panel", "label": "Button opens the enquire panel", "default": false },
    { "type": "text", "id": "button_2_label", "label": "Second link" },
    { "type": "url", "id": "button_2_link", "label": "Second link URL" },
    { "type": "checkbox", "id": "button_2_panel", "label": "Second link opens the enquire panel", "default": false },
    { "type": "text", "id": "note", "label": "Note under the button" }
  ],
  "presets": [
    { "name": "MS · Hero" }
  ]
}
{% endschema %}
