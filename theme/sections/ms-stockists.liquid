  .ms-sl__band .ms-sl__label { color: #B89A6E; }
  .ms-sl__bandin { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 6vw, 110px); align-items: end; }
  .ms-sl__bandtitle { font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -.03em; font-weight: 200; margin-top: 18px; }
  .ms-sl__bandcol p { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, .78); max-width: 48ch; }
  .ms-sl__band .ms-sl__ruled { color: var(--ivory); margin-top: 24px; }
  .ms-sl__partner { max-width: 60ch; margin: 0 auto; padding: clamp(44px, 5vw, 72px) var(--gut); text-align: center; font-size: 13.5px; line-height: 1.9; color: var(--muted); }
  .ms-site .ms-sl__partner a { color: var(--ink); border-bottom: 1px solid currentColor; }

  @media (max-width: 1080px) {
