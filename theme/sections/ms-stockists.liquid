{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,facts,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'agents' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
{%- comment -%}
  Showrooms, agents and resellers: where to find Midsummer Milano.
  The list and the map sit side by side at the same height. Choosing a place opens its
  details in the list and flies the map to it; places close together gather into a
  numbered cluster that opens as you zoom in. Every place is a block (latitude and
  longitude in decimal degrees; a decimal comma works too). d3 and the world geometry
  ship with the theme: the coarse map loads first, the fine one only once you zoom in.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign countries = ''
  for block in section.blocks
    assign countries = countries | append: block.settings.country | append: '|'
  endfor
  assign n_countries = countries | split: '|' | uniq | size
  assign regions = 'Europe,Middle East,Americas,Asia Pacific' | split: ','
-%}
<section class="ms-sl" data-ms-sl>
  <header class="ms-sl__intro">
    <div class="ms-sl__eyebrow">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 4.5 A7.5 7.5 0 1 0 12 19.5 A7.5 7.5 0 1 0 12 4.5" fill="none" stroke="#7E623B" stroke-width="1.2"/><path d="M4.5 12 H19.5" fill="none" stroke="#7E623B" stroke-width="1.2"/><path d="M12 4.5 C8.5 8 8.5 16 12 19.5 C15.5 16 15.5 8 12 4.5" fill="none" stroke="#7E623B" stroke-width="1.2"/></svg>
      <span>{{ s.eyebrow }}</span>
    </div>
    <h1 class="ms-sl__title">{{ s.heading }}</h1>
    <div class="ms-sl__introrow">
      <p class="ms-sl__lede">{{ s.lede }}</p>
      <p class="ms-sl__tally"><span>{{ section.blocks.size }}</span> {{ s.tally_places }} <span>{{ n_countries }}</span> {{ s.tally_countries }}</p>
    </div>
  </header>

  <div class="ms-sl__flag" id="atelier">
    <div class="ms-sl__flagin">
      <div>
        <div class="ms-sl__label">{{ s.atelier_label }}</div>
        <h2 class="ms-sl__flagtitle">{{ s.atelier_city }}</h2>
      </div>
      <div class="ms-sl__flagcol">
        <p class="ms-sl__addrbig">{{ s.atelier_address | newline_to_br }}</p>
        <div class="ms-sl__flaglinks">
          <a class="ms-sl__ruled" href="{{ s.atelier_directions }}" target="_blank" rel="noopener">{{ s.directions_label }}</a>
          <button type="button" class="ms-sl__ruled" data-ms-sl-atelier>{{ s.show_on_map }}</button>
        </div>
      </div>
      <div class="ms-sl__flagcol">
        <p class="ms-sl__meta">{{ s.atelier_hours | newline_to_br }}</p>
        <a class="ms-sl__ruled" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-enquiry="appointment">{{ s.book_label }}</a>
      </div>
    </div>
  </div>

  <div class="ms-sl__atlas" data-ms-sl-atlas>
    <aside class="ms-sl__panel" aria-label="{{ s.list_label | escape }}">
      <div class="ms-sl__tools">
        <label class="ms-sl__search">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.1"/></svg>
          <input type="search" placeholder="{{ s.search_placeholder | escape }}" aria-label="{{ s.search_placeholder | escape }}" data-ms-sl-q autocomplete="off">
        </label>
        <div class="ms-sl__types" role="group" aria-label="{{ s.type_label | escape }}">
          <button type="button" data-ms-sl-type="" aria-pressed="true">{{ s.all_label }} <span data-n></span></button>
          <button type="button" data-ms-sl-type="showroom" aria-pressed="false"><i class="ms-sl__mark is-showroom"></i>{{ s.showrooms_label }} <span data-n></span></button>
          <button type="button" data-ms-sl-type="boutique" aria-pressed="false"><i class="ms-sl__mark is-boutique"></i>{{ s.boutiques_label }} <span data-n></span></button>
          <button type="button" data-ms-sl-type="agent" aria-pressed="false"><i class="ms-sl__mark is-agent"></i>{{ s.agents_label }} <span data-n></span></button>
        </div>
        <p class="ms-sl__count" data-ms-sl-count aria-live="polite"></p>
      </div>

      <div class="ms-sl__list" data-ms-sl-list>
        {%- for region in regions -%}
          {%- assign in_region = 0 -%}
          {%- for block in section.blocks -%}{%- if block.settings.region == region -%}{%- assign in_region = in_region | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if in_region > 0 -%}
          <div class="ms-sl__region" data-ms-sl-region="{{ region }}">
            <h3 class="ms-sl__rhead">{{ region }}</h3>
            {%- assign last_country = '' -%}
            {%- for block in section.blocks -%}
              {%- if block.settings.region != region -%}{%- continue -%}{%- endif -%}
              {%- assign b = block.settings -%}
              {%- if b.country != last_country -%}
                <div class="ms-sl__country" data-ms-sl-country>{{ b.country }}</div>
                {%- assign last_country = b.country -%}
              {%- endif -%}
              {%- liquid
                case b.kind
                  when 'atelier'
                    assign kind_label = s.atelier_kind
                  when 'boutique'
                    assign kind_label = s.boutique_kind
                  when 'agent'
                    assign kind_label = s.agent_kind
                  else
                    assign kind_label = s.showroom_kind
                endcase
                assign search = b.name | append: ' ' | append: b.city | append: ' ' | append: b.country | append: ' ' | append: b.address | downcase | escape
                assign dir = b.name | append: ', ' | append: b.address | append: ', ' | append: b.country | url_encode
              -%}
              <article class="ms-sl__item" data-ms-sl-item="{{ block.id }}" data-kind="{{ b.kind }}" data-search="{{ search }}" {{ block.shopify_attributes }}>
                <button type="button" class="ms-sl__row" aria-expanded="false" aria-controls="ms-sl-{{ block.id }}">
                  <i class="ms-sl__mark is-{{ b.kind }}" aria-hidden="true"></i>
                  <span class="ms-sl__name">{{ b.name }}</span>
                  <span class="ms-sl__kind">{{ kind_label }}</span>
                  <span class="ms-sl__place">{{ b.city }}</span>
                  <svg class="ms-sl__chev" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
                </button>
                <div class="ms-sl__more" id="ms-sl-{{ block.id }}" hidden>
                  {%- if b.contact != blank -%}<p class="ms-sl__who">{{ b.contact }}</p>{%- endif -%}
                  {%- if b.address != blank -%}<p class="ms-sl__addr">{{ b.address | newline_to_br }}</p>{%- endif -%}
                  {%- if b.note != blank -%}<p class="ms-sl__note">{{ b.note }}</p>{%- endif -%}
                  <div class="ms-sl__reach">
                    {%- if b.phone != blank -%}<a href="tel:{{ b.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}"><span>{{ s.tel_label }}</span>{{ b.phone }}</a>{%- endif -%}
                    {%- if b.email != blank -%}<a href="mailto:{{ b.email }}"><span>{{ s.mail_label }}</span>{{ b.email }}</a>{%- endif -%}
                    {%- if b.website != blank -%}<a href="{{ b.website }}" target="_blank" rel="noopener"><span>{{ s.web_label }}</span>{{ b.website | remove: 'https://' | remove: 'http://' | remove: 'www.' | remove_last: '/' }}</a>{%- endif -%}
                  </div>
                  <div class="ms-sl__acts">
                    <a class="ms-sl__ruled" href="https://www.google.com/maps/dir/?api=1&destination={{ dir }}" target="_blank" rel="noopener">{{ s.directions_label }}</a>
                    {%- if b.kind == 'atelier' -%}
                      <a class="ms-sl__ruled" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-enquiry="appointment">{{ s.book_label }}</a>
                    {%- else -%}
                      <a class="ms-sl__ruled" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-enquiry="message" data-ms-note="{{ s.intro_note | replace: '[name]', b.name | replace: '[city]', b.city | escape }}">{{ s.intro_label }}</a>
                    {%- endif -%}
                    <button type="button" class="ms-sl__ruled ms-sl__tomap" data-ms-sl-tomap>{{ s.show_on_map }}</button>
                  </div>
                </div>
              </article>
            {%- endfor -%}
          </div>
          {%- endif -%}
        {%- endfor -%}
        <p class="ms-sl__none" data-ms-sl-none hidden>{{ s.no_results }}</p>
      </div>
    </aside>

    <div class="ms-sl__map" data-ms-sl-map role="region" aria-label="{{ s.map_label | escape }}">
      <div class="ms-sl__tiles" data-ms-sl-tiles aria-hidden="true"></div>
      <svg class="ms-sl__svg" data-ms-sl-svg aria-hidden="true"><g data-ms-sl-world><path class="ms-sl__grat" data-ms-sl-grat></path><path class="ms-sl__land" data-ms-sl-land></path><path class="ms-sl__home" data-ms-sl-home></path><path class="ms-sl__lakes" data-ms-sl-lakes></path><path class="ms-sl__rivers" data-ms-sl-rivers></path><path class="ms-sl__borders" data-ms-sl-borders></path></g><g class="ms-sl__labels" data-ms-sl-labels></g></svg>
      <div class="ms-sl__pins" data-ms-sl-pins></div>
      <div class="ms-sl__views" role="group" aria-label="{{ s.views_label | escape }}">
        <button type="button" data-ms-sl-view="" aria-pressed="true">{{ s.world_label }}</button>
        {%- for region in regions -%}
          {%- assign in_region = 0 -%}
          {%- for block in section.blocks -%}{%- if block.settings.region == region -%}{%- assign in_region = in_region | plus: 1 -%}{%- endif -%}{%- endfor -%}
          {%- if in_region > 0 -%}<button type="button" data-ms-sl-view="{{ region }}" aria-pressed="false">{{ region }}</button>{%- endif -%}
        {%- endfor -%}
      </div>
      <div class="ms-sl__zoom">
        <button type="button" data-ms-sl-zoom="in" aria-label="Zoom in"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.1"/></svg></button>
        <button type="button" data-ms-sl-zoom="out" aria-label="Zoom out"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 8h12" stroke="currentColor" stroke-width="1.1"/></svg></button>
        <button type="button" data-ms-sl-zoom="fit" aria-label="Show every place"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" fill="none" stroke="currentColor" stroke-width="1.1"/></svg></button>
      </div>
      <div class="ms-sl__legend" aria-hidden="true">
        <span><i class="ms-sl__mark is-atelier"></i>{{ s.atelier_kind }}</span>
        <span><i class="ms-sl__mark is-showroom"></i>{{ s.showroom_kind }}</span>
        <span data-legend="boutique"><i class="ms-sl__mark is-boutique"></i>{{ s.boutique_kind }}</span>
        <span data-legend="agent"><i class="ms-sl__mark is-agent"></i>{{ s.agent_kind }}</span>
      </div>
      <div class="ms-sl__hint" data-ms-sl-hint aria-hidden="true"></div>
      {%- if s.tiles_url != blank and s.tiles_credit != blank -%}<a class="ms-sl__credit" data-ms-sl-credit href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">{{ s.tiles_credit }}</a>{%- endif -%}
      <div class="ms-sl__pop" data-ms-sl-pop hidden></div>
    </div>
  </div>

  <div class="ms-sl__band">
    <div class="ms-sl__bandin">
      <div>
        <div class="ms-sl__label">{{ s.band_label }}</div>
        <h2 class="ms-sl__bandtitle">{{ s.band_heading }}</h2>
      </div>
      <div class="ms-sl__bandcol">
        <p>{{ s.band_text }}</p>
        <a class="ms-sl__ruled" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-enquiry="appointment">{{ s.band_link }}</a>
      </div>
    </div>
  </div>
  <p class="ms-sl__partner">{{ s.partner_text }} <a href="{% render 'ms-link', to: 'enquire', q: 'enquiry=partner' %}#enquire">{{ s.partner_link }}</a></p>

  <script type="application/json" data-ms-sl-data>[
    {%- for block in section.blocks -%}
      {%- assign lat = block.settings.lat | replace: ',', '.' | strip -%}
      {%- assign lon = block.settings.lon | replace: ',', '.' | strip -%}
      { "id": {{ block.id | json }}, "name": {{ block.settings.name | json }}, "city": {{ block.settings.city | json }}, "country": {{ block.settings.country | json }}, "region": {{ block.settings.region | json }}, "kind": {{ block.settings.kind | json }}, "lat": {{ lat | json }}, "lon": {{ lon | json }} }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>
</section>

<style>
  .ms-sl { --gut: clamp(18px, 5vw, 80px); --rule: #DDD6C9; --muted: #6E675C; --body: #4A443B; --gold: #7E623B; --ink: #17140F; --ivory: #FBF9F5; }
  .ms-sl #atelier { scroll-margin-top: 96px; }
  .ms-sl__label { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); }
  .ms-sl__intro { max-width: 1560px; margin: 0 auto; padding: clamp(40px, 6vw, 96px) var(--gut) clamp(36px, 4vw, 64px); }
  .ms-sl__eyebrow { display: flex; align-items: center; gap: 14px; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); }
  .ms-sl__title { font-family: Newsreader, Georgia, serif; font-size: clamp(46px, 7vw, 112px); line-height: 1; letter-spacing: -.045em; font-weight: 200; margin-top: clamp(20px, 2.4vw, 32px); }
  .ms-sl__introrow { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 60px; margin-top: clamp(22px, 2.6vw, 36px); }
  .ms-sl__lede { font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 1.9vw, 24px); line-height: 1.5; font-weight: 200; color: var(--body); max-width: 44ch; }
  .ms-sl__tally { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--muted); }
  .ms-sl__tally span { font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 3vw, 42px); letter-spacing: -.02em; color: var(--ink); text-transform: none; vertical-align: -4px; margin: 0 4px 0 14px; }
  .ms-sl__tally span:first-child { margin-left: 0; }

  .ms-sl__flag { max-width: 1560px; margin: 0 auto; padding: 0 var(--gut); }
  .ms-sl__flagin { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 4fr); gap: clamp(24px, 4vw, 72px); border-top: 1px solid var(--ink); padding: clamp(22px, 2.6vw, 34px) 0 clamp(36px, 4vw, 56px); }
  .ms-sl__flagtitle { font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 3.6vw, 52px); letter-spacing: -.03em; font-weight: 200; line-height: 1; margin-top: 14px; }
  .ms-sl__flagcol { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
  .ms-sl__addrbig { font-family: Newsreader, Georgia, serif; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; }
  .ms-sl__meta { font-size: 13.5px; line-height: 1.85; color: var(--muted); }
  .ms-sl__flaglinks { display: flex; flex-wrap: wrap; gap: 14px 26px; }
  .ms-site .ms-sl__ruled, .ms-sl__ruled { display: inline-block; width: fit-content; background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 6px; font: inherit; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--ink); cursor: pointer; }

  /* ── the atlas: list and map, one height ── */
  .ms-sl__atlas { max-width: 1560px; margin: 0 auto clamp(64px, 8vw, 120px); padding: 0 var(--gut); display: grid; grid-template-columns: minmax(320px, 400px) minmax(0, 1fr); height: clamp(600px, 82vh, 880px); }
  .ms-sl__panel { display: flex; flex-direction: column; min-height: 0; border: 1px solid var(--rule); border-right: 0; background: var(--ivory); }
  .ms-sl__tools { flex: 0 0 auto; padding: 22px 24px 0; border-bottom: 1px solid var(--rule); }
  .ms-sl__search { display: flex; align-items: center; gap: 12px; border-bottom: 1px solid var(--rule); color: var(--muted); }
  .ms-sl__search:focus-within { border-bottom-color: var(--ink); color: var(--ink); }
  .ms-sl__search input { flex: 1; min-width: 0; border: 0; background: none; padding: 12px 0; font: inherit; font-size: 15px; font-weight: 300; color: var(--ink); outline: none; }
  .ms-sl__search input::-webkit-search-cancel-button { filter: grayscale(1); }
  .ms-sl__types { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .ms-sl__types button { display: inline-flex; align-items: center; gap: 8px; min-height: 34px; padding: 0 12px; border: 1px solid var(--rule); background: none; font: inherit; font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--body); cursor: pointer; transition: background .2s ease, color .2s ease, border-color .2s ease; }
  .ms-sl__types button span { letter-spacing: 0; color: var(--muted); font-variant-numeric: tabular-nums; }
  .ms-sl__types button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--ivory); }
  .ms-sl__types button[aria-pressed="true"] span { color: rgba(251, 249, 245, .6); }
  .ms-sl__types button[aria-pressed="true"] .ms-sl__mark.is-showroom { background: var(--ivory); }
  .ms-sl__types button[aria-pressed="true"] .ms-sl__mark.is-boutique, .ms-sl__types button[aria-pressed="true"] .ms-sl__mark.is-agent { box-shadow: inset 0 0 0 1.4px var(--ivory); }
  .ms-sl__types button[hidden] { display: none; }
  .ms-sl__count { font-size: 12px; color: var(--muted); padding: 14px 0 12px; }

  .ms-sl__list { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; padding: 0 24px 24px; scrollbar-width: thin; scrollbar-color: #CFC6B6 transparent; }
  .ms-sl__rhead { position: sticky; top: 0; z-index: 1; background: var(--ivory); font-family: Newsreader, Georgia, serif; font-size: 22px; letter-spacing: -.01em; font-weight: 200; padding: 20px 0 8px; border-bottom: 1px solid var(--ink); }
  .ms-sl__country { font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); padding: 16px 0 2px; }
  .ms-sl__item { border-bottom: 1px solid var(--rule); }
  .ms-sl__row { display: grid; grid-template-columns: 12px minmax(0, 1fr) auto 14px; grid-template-areas: "mark name kind chev" ". place place ."; gap: 2px 12px; align-items: center; width: 100%; padding: 14px 0; background: none; border: 0; text-align: left; font: inherit; color: inherit; cursor: pointer; }
  .ms-sl__row .ms-sl__mark { grid-area: mark; }
  .ms-sl__name { grid-area: name; font-family: Newsreader, Georgia, serif; font-size: 18px; line-height: 1.25; transition: color .2s ease; }
  .ms-sl__kind { grid-area: kind; font-size: 9.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
  .ms-sl__place { grid-area: place; font-size: 12.5px; color: var(--muted); }
  .ms-sl__chev { grid-area: chev; color: var(--muted); transition: transform .3s ease; }
  .ms-sl__row:hover .ms-sl__name { color: var(--gold); }
  .ms-sl__item.is-open .ms-sl__chev { transform: rotate(180deg); }
  .ms-sl__item.is-open .ms-sl__name { color: var(--ink); }
  .ms-sl__item.is-open { background: linear-gradient(90deg, rgba(154, 123, 79, .07), transparent 70%); }
  .ms-sl__row:focus-visible { outline: 1px solid var(--gold); outline-offset: -1px; }
  .ms-sl__more { padding: 0 0 18px 24px; }
  .ms-sl__who { font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: var(--body); }
  .ms-sl__addr { font-size: 13.5px; line-height: 1.75; color: var(--body); margin-top: 6px; }
  .ms-sl__note { font-size: 13px; line-height: 1.75; color: var(--muted); margin-top: 8px; }
  .ms-sl__reach { display: flex; flex-direction: column; gap: 3px; margin-top: 12px; }
  .ms-site .ms-sl__reach a { font-size: 13px; line-height: 1.6; color: var(--body); word-break: break-word; }
  .ms-site .ms-sl__reach a:hover { color: var(--gold); }
  .ms-sl__reach a span { display: inline-block; width: 46px; font-size: 9.5px; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
  .ms-sl__acts { display: flex; flex-wrap: wrap; gap: 12px 22px; margin-top: 16px; }
  .ms-sl__tomap { display: none !important; }
  .ms-sl__none { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; color: var(--muted); padding: 28px 0; }
  .ms-sl__item[hidden], .ms-sl__region[hidden], .ms-sl__country[hidden], .ms-sl [hidden] { display: none !important; }

  /* markers */
  .ms-sl__mark { display: inline-block; flex: 0 0 auto; width: 10px; height: 10px; border-radius: 50%; }
  .ms-sl__mark.is-atelier { background: var(--gold); box-shadow: 0 0 0 2px var(--ivory), 0 0 0 3px var(--gold); width: 9px; height: 9px; margin: 0 1px; }
  .ms-sl__mark.is-showroom { background: var(--ink); }
  .ms-sl__mark.is-boutique { background: radial-gradient(circle, var(--ink) 0 2.2px, transparent 2.6px); box-shadow: inset 0 0 0 1.4px var(--ink); }
  .ms-sl__mark.is-agent { box-shadow: inset 0 0 0 1.4px var(--ink); }

  /* the map */
  .ms-sl__map { position: relative; overflow: hidden; background: #F3EDE3; border: 1px solid var(--rule); user-select: none; -webkit-user-select: none; }
  .ms-sl__svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-x pan-y; }
  .ms-sl__svg:active { cursor: grabbing; }
  .ms-sl__grat { fill: none; stroke: rgba(23, 20, 15, .06); stroke-width: .6; vector-effect: non-scaling-stroke; }
