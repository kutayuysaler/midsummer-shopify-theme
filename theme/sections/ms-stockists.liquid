{%- comment -%}
  Showrooms, agents and resellers: the preview's Stockists page. Each market is a
  block; the map draws from its latitude and longitude (a decimal comma works too).
  d3 and the world geometry ship with the theme, so the page calls no third party.
{%- endcomment -%}
<style>
.ms-stk {
    --panel-h: clamp(440px, 62vh, 680px);
    --ink: #17140F;
    --ivory: #FBF9F5;
    --muted: #8C8579;
    --body: #4A443B;
    --rule: #DDD6C9;
    --bronze: #9A7B4F;
    --wash: #F4F0E8;
  }
.ms-stk * { box-sizing: border-box; }
.ms-stk {
    margin: 0;
    background: var(--ivory);
    color: var(--ink);
    font-family: 'Red Hat Text', system-ui, sans-serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }
.ms-stk a { color: inherit; text-decoration: none; }
.ms-stk a:hover { color: var(--bronze); }
.ms-stk h1, .ms-stk h2, .ms-stk h3 { font-family: 'Newsreader', Georgia, serif; font-weight: 200; margin: 0; letter-spacing: -0.025em; }
.ms-stk .eyebrow {
    display: flex; align-items: center; gap: 11px;
    font-size: 9.5px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--muted);
  }
.ms-stk .ruled {
    font-size: 9.5px; letter-spacing: 0.19em; text-transform: uppercase;
    border-bottom: 1px solid currentColor; padding-bottom: 5px; white-space: nowrap; flex: 0 0 auto;
  }
.ms-stk .intro {
    padding: clamp(44px, 6vw, 92px) clamp(18px, 5vw, 80px) clamp(26px, 3.4vw, 44px);
    max-width: 1560px; margin: 0 auto;
  }
.ms-stk .intro h1 { font-size: clamp(38px, 6.2vw, 96px); line-height: 0.98; margin-top: 22px; }
.ms-stk .intro .lede {
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(19px, 2.2vw, 28px); line-height: 1.5; color: var(--body);
    margin: 30px 0 0; max-width: 40ch; text-wrap: pretty;
  }
.ms-stk /* the flagship, .ms-stk stated before any map */
  .flagship {
    padding: 0 clamp(18px, 5vw, 80px) clamp(44px, 6vw, 88px);
    max-width: 1560px; margin: 0 auto;
  }
.ms-stk .flagship-in {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 4vw, 72px);
    border-top: 1px solid var(--ink); padding-top: clamp(24px, 3vw, 38px);
    align-items: start;
  }
.ms-stk .flagship h2 { font-size: clamp(26px, 3.2vw, 42px); line-height: 1.08; }
.ms-stk .flagship .addr {
    display: flex; flex-direction: column; gap: 4px;
    font-size: 15px; line-height: 1.85; color: var(--body);
  }
.ms-stk .flagship .meta { font-size: 13px; line-height: 1.9; color: var(--muted); }
.ms-stk .flagship-col { display: flex; flex-direction: column; gap: 16px; }
.ms-stk .atlas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    gap: clamp(28px, 4vw, 72px);
    align-items: start;
    padding: 0 clamp(18px, 5vw, 80px) clamp(44px, 6vw, 88px);
    max-width: 1560px; margin: 0 auto;
  }
@media (max-width: 1080px) {
.ms-stk .atlas { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 36px); }
.ms-stk .mapwrap { height: clamp(320px, 44vh, 460px); }
}

@media (max-width: 700px) {
.ms-stk .mapwrap { height: 320px; }
}
.ms-stk .mapwrap {
    position: relative;
    display: flex; flex-direction: column;
    background: var(--wash); border: 1px solid var(--rule);
    height: var(--panel-h);
  }
.ms-stk .mapwrap svg { display: block; flex: 1; width: 100%; min-height: 0; cursor: grab; touch-action: none; }
.ms-stk .mapwrap svg:active { cursor: grabbing; }
.ms-stk .mapzoom {
    position: absolute; top: 12px; right: 12px; z-index: 2;
    display: flex; flex-direction: column;
  }
.ms-stk .mapzoom button {
    width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    background: var(--ivory); color: var(--ink);
    border: 1px solid var(--rule); border-bottom: 0; border-radius: 0;
    cursor: pointer; font-family: inherit; font-size: 13px; line-height: 1;
  }
.ms-stk .mapzoom button:last-child { border-bottom: 1px solid var(--rule); }
.ms-stk .mapzoom button:hover { color: var(--bronze); }
.ms-stk .land { fill: #E2D9C8; stroke: var(--ivory); stroke-width: 0.6; }
.ms-stk .graticule { fill: none; stroke: #E4DCCD; stroke-width: 0.35; }
.ms-stk .halo { fill: var(--bronze); opacity: 0.16; }
.ms-stk .pin { stroke: var(--ivory); stroke-width: 1; cursor: pointer; transition: r 0.2s ease; }
.ms-stk .pin.type-showroom { fill: var(--ink); }
.ms-stk .pin.type-boutique { fill: var(--bronze); }
.ms-stk .pin.type-agent { fill: none; stroke: var(--bronze); stroke-width: 1.6; }
.ms-stk .pin.is-active { r: 8.5; }
.ms-stk .pin.is-dim { opacity: 0.2; }
.ms-stk .pinlabel {
    font-family: 'Red Hat Text', sans-serif; font-size: 11px; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase; fill: var(--ink);
    pointer-events: none; opacity: 0;
  }
.ms-stk .pinlabel.is-shown { opacity: 1; }
.ms-stk .legend {
    display: flex; flex-wrap: wrap; gap: 18px 28px; align-items: center;
    padding: 16px clamp(14px, 2vw, 22px);
    border-top: 1px solid var(--rule);
    font-size: 11px; letter-spacing: 0.06em; color: var(--muted);
  }
.ms-stk .legend span { display: flex; align-items: center; gap: 9px; }
.ms-stk .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--bronze); flex: 0 0 auto; }
.ms-stk .dot.ink { background: var(--ink); }
.ms-stk .dot.hollow { background: transparent; box-shadow: inset 0 0 0 1.5px var(--bronze); }
.ms-stk .facet { margin-bottom: 22px; }
.ms-stk .facet-label {
    font-size: 9.5px; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--muted); margin-bottom: 11px;
  }
.ms-stk .facet-row { display: flex; flex-wrap: wrap; gap: 9px; }
.ms-stk .facet-row button {
    background: transparent; border: 1px solid var(--rule); border-radius: 0;
    padding: 9px 15px; cursor: pointer;
    font-family: inherit; font-size: 9.5px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted); transition: border-color 0.2s ease, color 0.2s ease;
  }
.ms-stk .facet-row button:hover { color: var(--ink); }
.ms-stk .facet-row button[aria-pressed="true"] { border-color: var(--ink); color: var(--ink); }
.ms-stk .count { font-size: 12px; color: var(--muted); margin: 0 0 18px; }
.ms-stk .list {
    position: relative; /* offsetTop of a row must be measured from the list */
    display: flex; flex-direction: column;
    max-height: var(--panel-h); min-height: 280px;
    overflow-y: auto; overscroll-behavior: contain;
    padding-right: 6px;
    mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 28px), transparent);
  }
.ms-stk .list::-webkit-scrollbar { width: 3px; }
.ms-stk .list::-webkit-scrollbar-thumb { background: var(--rule); }
@media (max-width: 700px) {
.ms-stk .list { max-height: none; overflow: visible; mask-image: none; -webkit-mask-image: none; }
}
.ms-stk .region {
    position: sticky; top: 0; z-index: 1; background: var(--ivory);
    font-size: 9.5px; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--muted); padding: 16px 0 8px;
  }
.ms-stk .row {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline;
    gap: 6px 18px; width: 100%; text-align: left;
    background: transparent; border: 0; border-top: 1px solid var(--rule);
    padding: 11px 0; cursor: pointer; font-family: inherit; color: inherit;
  }
.ms-stk .row:last-child { border-bottom: 1px solid var(--rule); }
.ms-stk .row:hover .city, .ms-stk .row[aria-pressed="true"] .city { color: var(--bronze); }
.ms-stk .city { font-family: 'Newsreader', Georgia, serif; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.25; }
.ms-stk .kind {
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--muted); white-space: nowrap;
  }
.ms-stk .sub { grid-column: 1 / -1; font-size: 12.5px; color: var(--muted); }
.ms-stk .detail {
    border: 1px solid var(--ink); padding: clamp(20px, 2.6vw, 30px); margin-top: 30px;
    display: flex; flex-direction: column; gap: 14px;
  }
.ms-stk .detail h3 { font-size: clamp(21px, 2.3vw, 27px); line-height: 1.2; }
.ms-stk .detail p { margin: 0; font-size: 14px; line-height: 1.9; color: var(--body); }
.ms-stk .detail .kind { color: var(--bronze); white-space: normal; }
.ms-stk .band { background: var(--ink); color: var(--ivory); padding: clamp(60px, 9vw, 140px) clamp(18px, 5vw, 80px); }
.ms-stk .band-in {
    max-width: 1560px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: clamp(32px, 6vw, 96px); align-items: end;
  }
.ms-stk .band h2 { font-size: clamp(28px, 4vw, 54px); line-height: 1.04; margin-top: 20px; }
.ms-stk .band .eyebrow { color: rgba(251, 249, 245, 0.55); }
.ms-stk .band p { font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, 0.78); max-width: 46ch; margin: 0; }
.ms-stk .band .ruled { border-bottom-color: rgba(251, 249, 245, 0.55); width: fit-content; }
.ms-stk .band a:hover { color: var(--ivory); }
.ms-stk .band-col { display: flex; flex-direction: column; gap: 22px; }
.ms-stk .note {
    padding: clamp(28px, 4vw, 56px) clamp(18px, 5vw, 80px);
    margin: 0 auto; max-width: 74ch;
    border-top: 1px solid var(--rule);
    font-size: 12.5px; line-height: 1.9; color: var(--muted);
  }
.ms-stk [hidden] { display: none !important; }
</style>
<div class="ms-stk"><section class="intro" style="padding-top: clamp(36px, 5vw, 72px);">
<div class="eyebrow">
<svg aria-hidden="true" height="22" style="display:block;flex:0 0 auto" viewbox="0 0 24 24" width="22">
<path d="M12 4.5 A7.5 7.5 0 1 0 12 19.5 A7.5 7.5 0 1 0 12 4.5" fill="none" stroke="#9A7B4F" stroke-width="1.2"></path>
<path d="M4.5 12 H19.5" fill="none" stroke="#9A7B4F" stroke-width="1.2"></path>
<path d="M12 4.5 C8.5 8 8.5 16 12 19.5 C15.5 16 15.5 8 12 4.5" fill="none" stroke="#9A7B4F" stroke-width="1.2"></path>
</svg>
<span>{{ section.settings.t1 }}</span>
</div>
<h1>{{ section.settings.t2 }}</h1>
<p class="lede">{{ section.settings.t3 }}</p>
</section>
<section class="flagship">
<div class="flagship-in">
<div>
<div class="eyebrow" style="margin-bottom:14px;">{{ section.settings.t4 }}</div>
<h2>{{ section.settings.t5 }}</h2>
</div>
<div class="flagship-col">
<div class="addr">{{ section.settings.t6 }}</div>
<a class="ruled" href="{{ section.settings.directions }}" rel="noopener" style="width:fit-content" target="_blank">{{ section.settings.t7 }}</a>
</div>
<div class="flagship-col">
<p class="meta">{{ section.settings.t8 }}</p>
<a class="ruled" data-ms-enquire="" href="/pages/contact" style="width:fit-content">{{ section.settings.t9 }}</a>
</div>
</div>
</section>
<div class="atlas">
<div>
<div class="mapwrap">
<div class="mapzoom">
<button aria-label="Zoom in" data-zoom="in" type="button">{{ section.settings.t10 }}</button>
<button aria-label="Zoom out" data-zoom="out" type="button">{{ section.settings.t11 }}</button>
<button aria-label="Reset the view" data-zoom="reset" type="button">{{ section.settings.t12 }}</button>
</div>
<svg aria-label="World map of Midsummer Milano showrooms, agents and resellers" id="map" role="img" viewbox="0 0 960 560"></svg>
<div class="legend">{{ section.settings.t13 }}</div>
</div>
</div>
<div>
<div class="facet">
<div class="facet-label">{{ section.settings.t14 }}</div>
<div class="facet-row" id="types"></div>
</div>
<div class="facet">
<div class="facet-label">{{ section.settings.t15 }}</div>
<div class="facet-row" id="regions"></div>
</div>
<p class="count" id="count"></p>
<div class="list" id="list"></div>
<div class="detail" hidden="" id="detail"></div>
</div>
</div>
<section class="band">
<div class="band-in">
<div>
<div class="eyebrow">{{ section.settings.t16 }}</div>
<h2>{{ section.settings.t17 }}</h2>
</div>
<div class="band-col">
<p>{{ section.settings.t18 }}</p>
<a class="ruled" data-ms-enquire="" href="/pages/contact">{{ section.settings.t19 }}</a>
</div>
</div>
</section>
<p class="note">{{ section.settings.t20 }}</p>
</div>
<script src="{{ 'ms-atlas-vendor.js' | asset_url }}" defer="defer"></script>
<script>
  window.addEventListener('DOMContentLoaded', function () {
  if (!window.d3 || !window.topojson) return;
  var PLACES = [
  {%- for block in section.blocks -%}
    {%- assign lat = block.settings.lat | replace: ',', '.' | times: 1.0 -%}
    {%- assign lon = block.settings.lon | replace: ',', '.' | times: 1.0 -%}
    { city: {{ block.settings.city | json }}, country: {{ block.settings.country | json }}, region: {{ block.settings.region | json }}, type: {{ block.settings.type | json }}, lat: {{ lat | json }}, lon: {{ lon | json }}, note: {{ block.settings.note | json }} }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ];


  var TYPES = ['All types', 'Showroom', 'Boutique', 'Agent'];
  var REGIONS = ['All regions', 'Europe', 'Middle East', 'Americas', 'Asia Pacific'];
  var fType = 'All types';
  var fRegion = 'All regions';
  var active = null;

  var svg = d3.select('#map');
  var W = 960, H = 560;
  var projection = d3.geoNaturalEarth1().scale(205).translate([W / 2, H / 2 + 6]);
  var path = d3.geoPath(projection);

  // one transformed group holds everything, so zoom and pan move as a unit
  var view = svg.append('g');
  view.append('path').attr('class', 'graticule').attr('d', path(d3.geoGraticule10()));
  var landLayer = view.append('g');
  var pinLayer = view.append('g');

  var EASE = 'transform .62s cubic-bezier(.22,1,.36,1)';

  var zoom = d3.zoom()
    .scaleExtent([1, 9])
    .on('start', function (e) {
      // a gesture must track the pointer exactly, so smoothing is off while dragging
      if (e.sourceEvent) view.style('transition', 'none');
    })
    .on('zoom', function (e) {
      var t = e.transform;
      // CSS transform rather than the attribute, so the browser can animate it
      view.style('transform', 'translate(' + t.x + 'px,' + t.y + 'px) scale(' + t.k + ')');
      // markers and rules hold their drawn weight as the map scales,
      // and follow the same easing so they do not snap ahead of the flight
      var ease = e.sourceEvent ? 'none' : EASE;
      pinLayer.selectAll('g')
        .style('transition', ease)
        .style('transform-origin', '0 0')
        .style('transform', function (d) {
          var p = projection([d.lon, d.lat]);
          return 'translate(' + p[0] + 'px,' + p[1] + 'px) scale(' + (1 / t.k) + ')';
        });
      view.selectAll('.land').style('stroke-width', 0.6 / t.k);
      view.select('.graticule').style('stroke-width', 0.35 / t.k);
    });

  view.style('transform-origin', '0 0');
  svg.call(zoom);

  // Programmatic flights are applied in one step and smoothed by CSS — the
  // preview frame throttles requestAnimationFrame, which stalls JS tweens.
  function glide(to) {
    view.style('transition', EASE);
    d3.select('#map').call(zoom.transform, to);
  }

  function flyTo(d, k) {
    var scale = k || 3.4;
    var p = projection([d.lon, d.lat]);
    glide(d3.zoomIdentity.translate(W / 2 - p[0] * scale, H / 2 - p[1] * scale).scale(scale));
  }
  function flyHome() { glide(d3.zoomIdentity); }

  document.querySelectorAll('.mapzoom button').forEach(function (b) {
    b.addEventListener('click', function () {
      var how = b.dataset.zoom;
      if (how === 'reset') { flyHome(); return; }
      var cur = d3.zoomTransform(d3.select('#map').node());
      var k = Math.max(1, Math.min(9, cur.k * (how === 'in' ? 1.7 : 1 / 1.7)));
      var cx = (W / 2 - cur.x) / cur.k, cy = (H / 2 - cur.y) / cur.k;
      glide(d3.zoomIdentity.translate(W / 2 - cx * k, H / 2 - cy * k).scale(k));
    });
  });

  d3.json({{ 'ms-world-110m.json' | asset_url | json }})
    .then(function (topology) {
      var countries = topojson.feature(topology, topology.objects.countries);
      landLayer.selectAll('path').data(countries.features).join('path')
        .attr('class', 'land').attr('d', path);
    })
    .catch(function () { /* markers still render without the land wash */ })
    .finally(drawPins);

  function drawPins() {
    var g = pinLayer.selectAll('g').data(PLACES, function (d) { return d.city; }).join('g')
      .attr('transform', function (d) {
        var p = projection([d.lon, d.lat]);
        return 'translate(' + p[0] + ',' + p[1] + ')';
      });

    g.append('circle').attr('class', 'halo').attr('r', 14);
    g.append('circle')
      .attr('class', function (d) { return 'pin type-' + d.type.toLowerCase(); })
      .attr('r', function (d) { return d.type === 'Showroom' ? 7 : 5.6; })
      .on('click', function (e, d) { e.stopPropagation(); select(d.city); })
      .on('mouseenter', function (e, d) {
        d3.select(this.parentNode).select('.pinlabel').classed('is-shown', true);
      })
      .on('mouseleave', function (e, d) {
        if (active !== d.city) d3.select(this.parentNode).select('.pinlabel').classed('is-shown', false);
      })
      .append('title').text(function (d) { return d.city + ' — ' + d.type; });
    g.append('text').attr('class', 'pinlabel').attr('x', 13).attr('y', 4)
      .text(function (d) { return d.city; });

    paint();
  }

  function shown(d) {
    return (fType === 'All types' || d.type === fType)
      && (fRegion === 'All regions' || d.region === fRegion);
  }

  function paint() {
    pinLayer.selectAll('g').each(function (d) {
      var node = d3.select(this);
      var dim = !shown(d);
      node.select('.pin').classed('is-dim', dim).classed('is-active', active === d.city);
      node.select('.halo').style('opacity', active === d.city ? 0.3 : (dim ? 0.03 : 0.16));
      node.select('.pinlabel').classed('is-shown', active === d.city);
    });

    var visible = PLACES.filter(shown);
    var countEl = document.getElementById('count');
    countEl.textContent = visible.length === 1 ? '1 location' : visible.length + ' locations';

    // filtering to one region frames that region rather than leaving the world wide
    if (fRegion !== 'All regions' && !active && visible.length) {
      var lons = visible.map(function (d) { return d.lon; });
      var lats = visible.map(function (d) { return d.lat; });
      var mid = { lon: (Math.min.apply(null, lons) + Math.max.apply(null, lons)) / 2,
                  lat: (Math.min.apply(null, lats) + Math.max.apply(null, lats)) / 2 };
      var spread = Math.max(Math.max.apply(null, lons) - Math.min.apply(null, lons), 1);
      flyTo(mid, Math.max(1.4, Math.min(3.2, 150 / spread)));
    }

    var byRegion = {};
    visible.forEach(function (d) { (byRegion[d.region] = byRegion[d.region] || []).push(d); });

    var list = document.getElementById('list');
    list.innerHTML = '';
    REGIONS.slice(1).forEach(function (r) {
      if (!byRegion[r]) return;
      var h = document.createElement('div');
      h.className = 'region';
      h.textContent = r;
      list.appendChild(h);
      byRegion[r].forEach(function (d) {
        var row = document.createElement('button');
        row.type = 'button';
        row.className = 'row';
        row.setAttribute('aria-pressed', active === d.city ? 'true' : 'false');
        var city = document.createElement('span');
        city.className = 'city';
        city.textContent = d.city;
        var kind = document.createElement('span');
        kind.className = 'kind';
        kind.textContent = d.type;
        var sub = document.createElement('span');
        sub.className = 'sub';
        sub.textContent = d.country;
        row.appendChild(city);
        row.appendChild(kind);
        row.appendChild(sub);
        row.addEventListener('click', function () { select(d.city, true); });
        list.appendChild(row);
      });
    });

    var detail = document.getElementById('detail');
    var entry = visible.filter(function (d) { return d.city === active; })[0];
    if (!entry) { detail.hidden = true; detail.innerHTML = ''; return; }
    detail.hidden = false;
    detail.innerHTML =
      '<span class="kind">' + entry.type + (entry.city === {{ section.settings.atelier_city | json }} ? ' — the atelier' : '') + '</span>' +
      '<h3>' + entry.city + ', ' + entry.country + '</h3>' +
      '<p>' + entry.note + '</p>' +
      '<a class="ruled" style="width:fit-content;margin-top:6px" href="/pages/contact" data-ms-enquire>' +
      (entry.type === 'Showroom' && entry.city === {{ section.settings.atelier_city | json }} ? {{ section.settings.book_label | json }} : {{ section.settings.intro_label | json }}) + '</a>';
  }

  // selecting a place flies the map to it; deselecting returns to the world,
  // and picking from the list scrolls that row into the middle of the column
  function select(city, fromList) {
    active = active === city ? null : city;
    paint();
    if (!active) { flyHome(); return; }
    var d = PLACES.filter(function (x) { return x.city === active; })[0];
    if (d) flyTo(d);
    if (!fromList) {
      var row = [].slice.call(document.querySelectorAll('#list .row'))
        .filter(function (r) { return r.querySelector('.city').textContent === active; })[0];
      var list = document.getElementById('list');
      if (row && list) list.scrollTop = row.offsetTop - list.clientHeight / 2 + row.clientHeight / 2;
    }
  }

  function facet(holder, values, get, set) {
    values.forEach(function (v) {
      var b = document.createElement('button');
      b.type = 'button';
      b.textContent = v;
      b.setAttribute('aria-pressed', get() === v ? 'true' : 'false');
      b.addEventListener('click', function () {
        set(v);
        var cur = PLACES.filter(function (d) { return d.city === active; })[0];
        if (cur && !shown(cur)) active = null;
        [].forEach.call(holder.children, function (c) {
          c.setAttribute('aria-pressed', c.textContent === get() ? 'true' : 'false');
        });
        paint();
      });
      holder.appendChild(b);
    });
  }

  facet(document.getElementById('types'), TYPES,
    function () { return fType; }, function (v) { fType = v; });
  facet(document.getElementById('regions'), REGIONS,
    function () { return fRegion; }, function (v) { fRegion = v; });

  paint();

  });
</script>
