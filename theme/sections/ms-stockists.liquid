        rt = setTimeout(function () { var w0 = W, h0 = H; size(); if (W !== w0 || Math.abs(H - h0) > 160) { if (state.sel) flyTo(state.sel); else if (!touched) svg.call(zoom.transform, homeView()); else svg.call(zoom.transform, viewFor(stores.filter(shown), 40)); } layout(); }, 120);
      }).observe(mapEl);
    }).catch(function (err) { mapEl.classList.add('is-failed'); if (window.console) console.error('[agents map]', err); });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', msSlInit); else msSlInit();
  document.addEventListener('shopify:section:load', function () { setTimeout(msSlInit, 0); });
  })();
</script>

{%- comment -%} Every place, readable by search engines and AI assistants: where Midsummer beds can be seen. {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ section.settings.heading | strip_html | append: ' · Midsummer Milano' | json }},
  "itemListElement": [
    {%- for block in section.blocks -%}
    {%- assign b = block.settings -%}
    {
      "@type": "ListItem",
      "position": {{ forloop.index }},
      "item": {
        "@type": {% if b.kind == 'atelier' %}"FurnitureStore"{% else %}"LocalBusiness"{% endif %},
        "name": {{ b.name | json }},
        {%- if b.note != blank %}"description": {{ b.note | strip_html | json }},{% endif %}
        "address": { "@type": "PostalAddress", "streetAddress": {{ b.address | default: '' | json }}, "addressLocality": {{ b.city | json }}, "addressCountry": {{ b.country | json }} },
        {%- if b.lat != blank and b.lon != blank %}"geo": { "@type": "GeoCoordinates", "latitude": {{ b.lat | json }}, "longitude": {{ b.lon | json }} },{% endif %}
        {%- if b.phone != blank %}"telephone": {{ b.phone | json }},{% endif %}
        {%- if b.email != blank %}"email": {{ b.email | json }},{% endif %}
        {%- if b.website != blank %}"url": {{ b.website | json }},{% endif %}
        "brand": { "@type": "Brand", "name": "Midsummer Milano" }
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
