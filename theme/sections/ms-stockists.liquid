    .ms-sl__map { order: -1; height: min(56vh, 440px); min-height: 340px; border-left: 0; border-right: 0; }
    .ms-sl__panel { border: 0; }
    .ms-sl__tools { padding: 18px var(--gut) 0; }
    .ms-sl__list { overflow: visible; padding: 0 var(--gut) 12px; }
    .ms-sl__rhead { top: 0; }
    .ms-sl__tomap { display: inline-block !important; }
    .ms-sl__legend { display: none; }
    .ms-sl__views { top: 12px; left: 12px; right: 12px; max-width: none; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .ms-sl__views::-webkit-scrollbar { display: none; }
    .ms-sl__views button { flex: 0 0 auto; }
    .ms-sl__zoom { right: 12px; bottom: 12px; }
    .ms-sl__bandin { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 600px) {
    .ms-sl__flagin { grid-template-columns: minmax(0, 1fr); }
    .ms-sl__views button { padding: 0 10px; font-size: 10px; letter-spacing: .14em; }
  }
