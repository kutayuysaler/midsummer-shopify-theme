{%- comment -%} d3 and the world outline travel inside the page: nothing to fetch, nothing to wait for. {%- endcomment -%}
<script>{% render 'ms-atlas-vendor' %}</script>
<script type="application/json" data-ms-sl-geo>{% render 'ms-world-110m' %}</script>
<script>
  (function () {
  var msSlInit = function () {
    var root = document.querySelector('[data-ms-sl]');
    if (!root || root.__msSl) return;
    root.__msSl = true;
    var URL50 = {{ 'ms-world-50m.json' | asset_url | json }};
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var KINDS = { atelier: {{ section.settings.atelier_kind | json }}, showroom: {{ section.settings.showroom_kind | json }}, boutique: {{ section.settings.boutique_kind | json }}, agent: {{ section.settings.agent_kind | json }} };
    var T = { places: {{ section.settings.count_places | json }}, place: {{ section.settings.count_place | json }}, countries: {{ section.settings.count_countries | json }}, country: {{ section.settings.count_country | json }}, here: {{ section.settings.cluster_label | json }}, wheel: {{ section.settings.hint_wheel | json }}, touch: {{ section.settings.hint_touch | json }} };

    var stores = JSON.parse(root.querySelector('[data-ms-sl-data]').textContent).map(function (p) {
      p.lat = parseFloat(String(p.lat).replace(',', '.')); p.lon = parseFloat(String(p.lon).replace(',', '.'));
      p.item = root.querySelector('[data-ms-sl-item="' + p.id + '"]');
      return p;
    }).filter(function (p) { return isFinite(p.lat) && isFinite(p.lon) && p.item; });
    var byId = {}; stores.forEach(function (p) { byId[p.id] = p; });

    var list = root.querySelector('[data-ms-sl-list]');
    var mapEl = root.querySelector('[data-ms-sl-map]');
    var pinsEl = root.querySelector('[data-ms-sl-pins]');
    var pop = root.querySelector('[data-ms-sl-pop]');
    var hint = root.querySelector('[data-ms-sl-hint]');
    var q = root.querySelector('[data-ms-sl-q]');
    var narrow = function () { return window.matchMedia('(max-width: 900px)').matches; };
    var state = { type: '', text: '', sel: null };

    /* ── the list: filter, count, open one place at a time ── */
    function shown(p) {
      if (state.type && p.kind !== state.type && !(state.type === 'showroom' && p.kind === 'atelier')) return false;
      if (state.text && p.item.getAttribute('data-search').indexOf(state.text) < 0) return false;
      return true;
    }
    function refreshList() {
      var vis = stores.filter(shown);
      stores.forEach(function (p) { p.item.hidden = !shown(p); });
      root.querySelectorAll('[data-ms-sl-region]').forEach(function (r) {
        var any = false;
        var heads = r.querySelectorAll('[data-ms-sl-country]');
        heads.forEach(function (h) {
          var n = h.nextElementSibling, has = false;
          while (n && !n.hasAttribute('data-ms-sl-country')) { if (n.hasAttribute('data-ms-sl-item') && !n.hidden) has = true; n = n.nextElementSibling; }
          h.hidden = !has; any = any || has;
        });
        r.hidden = !any;
      });
      var nc = {}; vis.forEach(function (p) { nc[p.country] = 1; });
      var c = Object.keys(nc).length;
      root.querySelector('[data-ms-sl-count]').textContent = vis.length + ' ' + (vis.length === 1 ? T.place : T.places) + ' · ' + c + ' ' + (c === 1 ? T.country : T.countries);
      root.querySelector('[data-ms-sl-none]').hidden = vis.length > 0;
      if (state.sel && !shown(state.sel)) select(null);
      return vis;
    }
    root.querySelectorAll('[data-ms-sl-type]').forEach(function (b) {
      var k = b.getAttribute('data-ms-sl-type');
      var n = stores.filter(function (p) { return !k || p.kind === k || (k === 'showroom' && p.kind === 'atelier'); }).length;
      b.querySelector('[data-n]').textContent = n;
      if (k && !n) { b.hidden = true; var lg = root.querySelector('[data-legend="' + k + '"]'); if (lg) lg.hidden = true; }
      b.addEventListener('click', function () {
        state.type = k;
        root.querySelectorAll('[data-ms-sl-type]').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        refreshList(); if (map) { map.layout(); map.fit(stores.filter(shown)); }
      });
    });
    var qt;
    q.addEventListener('input', function () {
      clearTimeout(qt);
      qt = setTimeout(function () {
        state.text = q.value.trim().toLowerCase();
        var vis = refreshList();
        if (map) { map.layout(); if (vis.length) map.fit(vis); }
      }, 140);
    });

    function select(p, opts) {
      opts = opts || {};
      if (state.sel && state.sel !== p) {
        state.sel.item.classList.remove('is-open');
        state.sel.item.querySelector('.ms-sl__row').setAttribute('aria-expanded', 'false');
        state.sel.item.querySelector('.ms-sl__more').hidden = true;
      }
      state.sel = p;
      if (map) map.layout();
      if (!p) return;
      p.item.classList.add('is-open');
      p.item.querySelector('.ms-sl__row').setAttribute('aria-expanded', 'true');
      p.item.querySelector('.ms-sl__more').hidden = false;
      if (opts.scrollList !== false) {
        if (!narrow()) {
          var top = p.item.offsetTop - list.offsetTop - 64;
          list.scrollTo({ top: Math.max(0, top), behavior: reduce ? 'auto' : 'smooth' });
        } else if (opts.fromMap) {
          p.item.scrollIntoView({ block: 'start', behavior: reduce ? 'auto' : 'smooth' });
        }
      }
      if (map && opts.fly !== false) map.flyTo(p);
    }
    list.addEventListener('click', function (e) {
      var row = e.target.closest('.ms-sl__row');
      if (row) {
        var p = byId[row.closest('[data-ms-sl-item]').getAttribute('data-ms-sl-item')];
        if (state.sel === p) { select(null); if (map) map.fit(stores.filter(shown)); return; }
        select(p, { scrollList: false });
        return;
      }
      if (e.target.closest('[data-ms-sl-tomap]')) {
        mapEl.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
      }
    });
    root.querySelector('[data-ms-sl-atelier]').addEventListener('click', function () {
      var a = stores.filter(function (p) { return p.kind === 'atelier'; })[0];
      if (!a) return;
      mapEl.scrollIntoView({ block: narrow() ? 'start' : 'center', behavior: reduce ? 'auto' : 'smooth' });
      select(a);
    });
    refreshList();

    /* ── the map ── */
    var map = null;
    if (!window.d3 || !window.topojson) return;
    var d3 = window.d3, topo = window.topojson;
    var svg = d3.select(root.querySelector('[data-ms-sl-svg]'));
    var world = svg.select('[data-ms-sl-world]');
    var W = 0, H = 0, K = 1, proj = d3.geoNaturalEarth1(), path = d3.geoPath(proj);
    var land = null, borders = null, home = null, fine = false, loadingFine = false, t = d3.zoomIdentity;
    var HOME = {}; stores.forEach(function (p) { HOME[p.country === 'United States' ? 'United States of America' : p.country] = 1; });
    var KMAX = 220;
    var zoom = d3.zoom().scaleExtent([1, KMAX]).filter(function (e) {
      if (e.type === 'wheel') { if (e.ctrlKey || e.metaKey) return true; flash(T.wheel); return false; }
      if (e.type === 'touchstart') { if (e.touches && e.touches.length > 1) return true; return false; }
      return !e.button;
    }).on('zoom', function (e) {
      t = e.transform;
      world.attr('transform', t);
      if (!fine && t.k > 2.6) loadFine();
      layout();
    });
    var flashT;
    function flash(msg) { hint.textContent = msg; hint.classList.add('is-on'); clearTimeout(flashT); flashT = setTimeout(function () { hint.classList.remove('is-on'); }, 1300); }
    mapEl.addEventListener('touchstart', function (e) { if (e.touches.length === 1 && !e.target.closest('button')) flash(T.touch); }, { passive: true });

    function draw(topology) {
      var obj = topology.objects.countries;
      var all = topo.feature(topology, obj).features.filter(function (f) { return f.properties.name !== 'Antarctica'; });
      land = { type: 'FeatureCollection', features: all };
      home = { type: 'FeatureCollection', features: all.filter(function (f) { return HOME[f.properties.name]; }) };
      borders = topo.mesh(topology, obj, function (a, b) { return a !== b; });
    }
    function paint() {
      world.select('[data-ms-sl-grat]').attr('d', path(d3.geoGraticule10()));
      world.select('[data-ms-sl-land]').attr('d', path(land));
      world.select('[data-ms-sl-home]').attr('d', path(home));
      world.select('[data-ms-sl-borders]').attr('d', path(borders));
    }
    function size() {
      var r = mapEl.getBoundingClientRect();
      W = Math.max(1, Math.round(r.width)); H = Math.max(1, Math.round(r.height));
      svg.attr('viewBox', '0 0 ' + W + ' ' + H);
      proj.fitExtent([[12, 12], [W - 12, H - 12]], land);
      stores.forEach(function (p) { var xy = proj([p.lon, p.lat]); p.px = xy[0]; p.py = xy[1]; });
      zoom.extent([[0, 0], [W, H]]).translateExtent([[-W * .25, -H * .25], [W * 1.25, H * 1.25]]);
      paint();
    }
    function loadFine() {
      if (loadingFine) return; loadingFine = true;
      d3.json(URL50).then(function (topology) { draw(topology); fine = true; paint(); }).catch(function () {});
    }

    /* pins: one per place, gathered into clusters where they would touch */
    var pinEls = {}, clusterEls = {};
    function pinFor(p) {
      if (pinEls[p.id]) return pinEls[p.id];
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'ms-sl__pin';
      b.setAttribute('aria-label', p.name + ', ' + p.city + ' (' + KINDS[p.kind] + ')');
      b.innerHTML = '<i class="ms-sl__mark is-' + p.kind + '"></i><span class="ms-sl__tag"></span>';
      b.querySelector('.ms-sl__tag').innerHTML = esc(p.name) + '<em>' + esc(p.city) + '</em>';
      b.addEventListener('click', function (e) { e.stopPropagation(); hidePop(); select(p, { fromMap: true }); });
      pinsEl.appendChild(b); pinEls[p.id] = b; return b;
    }
    function esc(s) { return String(s || '').replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }
    function layout() {
      if (!W) return;
      var vis = stores.filter(shown);
      var pts = vis.map(function (p) { return { p: p, x: t.applyX(p.px), y: t.applyY(p.py) }; });
      var R = 30, groups = [], used = {};
      pts.sort(function (a, b) { return (a.p.kind === 'atelier' ? -1 : 0) - (b.p.kind === 'atelier' ? -1 : 0); });
      pts.forEach(function (a) {
        if (used[a.p.id]) return;
        var g = [a]; used[a.p.id] = 1;
        if (a.p !== state.sel) pts.forEach(function (b) {
          if (used[b.p.id] || b.p === state.sel) return;
          if (Math.abs(a.x - b.x) < R && Math.abs(a.y - b.y) < R) { g.push(b); used[b.p.id] = 1; }
        });
        groups.push(g);
      });
      var live = {};
      var off = function (x, y) { return x < -24 || y < -24 || x > W + 24 || y > H + 24; };
      stores.forEach(function (p) { if (pinEls[p.id]) pinEls[p.id].hidden = true; });
      groups.forEach(function (g) {
        if (g.length === 1) {
          if (off(g[0].x, g[0].y)) return;
          var el = pinFor(g[0].p);
          el.hidden = false;
          el.style.transform = 'translate(' + g[0].x.toFixed(1) + 'px,' + g[0].y.toFixed(1) + 'px)';
          el.classList.toggle('is-on', g[0].p === state.sel);
          return;
        }
        var ids = g.map(function (a) { return a.p.id; }).sort().join(',');
        var cx = 0, cy = 0; g.forEach(function (a) { cx += a.x; cy += a.y; }); cx /= g.length; cy /= g.length;
        if (off(cx, cy)) return;
        var c = clusterEls[ids];
        if (!c) {
          c = document.createElement('button'); c.type = 'button'; c.className = 'ms-sl__pin is-cluster';
          c.innerHTML = '<b>' + g.length + '</b><span class="ms-sl__tag"></span>';
          var cities = []; g.forEach(function (a) { if (cities.indexOf(a.p.city) < 0) cities.push(a.p.city); });
          c.querySelector('.ms-sl__tag').innerHTML = esc(cities.slice(0, 3).join(' · ')) + (cities.length > 3 ? ' …' : '') + '<em>' + g.length + ' ' + esc(T.places) + '</em>';
          c.setAttribute('aria-label', g.length + ' ' + T.places + ': ' + g.map(function (a) { return a.p.name; }).join(', '));
          if (g.some(function (a) { return a.p.kind === 'atelier'; })) c.classList.add('has-atelier');
          c._members = g.map(function (a) { return a.p; });
          c.addEventListener('click', function (e) { e.stopPropagation(); openCluster(c); });
          pinsEl.appendChild(c); clusterEls[ids] = c;
        }
        c.hidden = false; c._x = cx; c._y = cy;
        c.style.transform = 'translate(' + cx.toFixed(1) + 'px,' + cy.toFixed(1) + 'px)';
        live[ids] = 1;
      });
      Object.keys(clusterEls).forEach(function (k) { if (!live[k]) clusterEls[k].hidden = true; });
      if (!pop.hidden && pop._cluster && pop._cluster.hidden) hidePop();
    }

    /* views */
    function viewFor(list, maxK, pad) {
      if (!list.length) return d3.zoomIdentity;
      var x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      list.forEach(function (p) { x0 = Math.min(x0, p.px); y0 = Math.min(y0, p.py); x1 = Math.max(x1, p.px); y1 = Math.max(y1, p.py); });
      var padX = pad != null ? pad : (narrow() ? 60 : 110), padY = pad != null ? pad + 20 : (narrow() ? 70 : 110);
      var k = Math.min((W - padX * 2) / Math.max(1, x1 - x0), (H - padY * 2) / Math.max(1, y1 - y0));
      k = Math.max(1, Math.min(maxK || 60, k));
      var cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
      return d3.zoomIdentity.translate(W / 2 - k * cx, H / 2 - k * cy).scale(k);
    }
    function go(tr, ms) {
      var dur = reduce ? 0 : (ms == null ? 1100 : ms);
      if (!dur) svg.call(zoom.transform, tr); else svg.transition().duration(dur).call(zoom.transform, tr);
    }
    function fit(list) { go(viewFor(list && list.length ? list : stores, 40, list && list.length > 3 ? (narrow() ? 28 : 56) : null)); setView(''); }
    function flyTo(p) {
      var k = Math.max(t.k, 48);
      go(d3.zoomIdentity.translate(W / 2 - k * p.px, H / 2 - k * p.py).scale(k));
    }
    function setView(v) { root.querySelectorAll('[data-ms-sl-view]').forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-ms-sl-view') === v ? 'true' : 'false'); }); }
    root.querySelectorAll('[data-ms-sl-view]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-ms-sl-view');
        hidePop();
        var vis = stores.filter(shown).filter(function (p) { return !v || p.region === v; });
        if (!vis.length) vis = stores.filter(function (p) { return !v || p.region === v; });
        go(viewFor(vis, vis.length === 1 ? 14 : 40)); setView(v);
        if (v && !narrow()) { var r = root.querySelector('[data-ms-sl-region="' + v + '"]'); if (r && !r.hidden) list.scrollTo({ top: r.offsetTop - list.offsetTop, behavior: reduce ? 'auto' : 'smooth' }); }
      });
    });
    root.querySelectorAll('[data-ms-sl-zoom]').forEach(function (b) {
      b.addEventListener('click', function () {
        var z = b.getAttribute('data-ms-sl-zoom');
        hidePop();
        if (z === 'fit') { select(null); fit(stores.filter(shown)); return; }
        svg.transition().duration(reduce ? 0 : 450).call(zoom.scaleBy, z === 'in' ? 2 : .5);
      });
    });

    /* clusters: zoom in until they part; places in the same street are listed instead */
    function openCluster(c) {
      var m = c._members;
      var x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
      m.forEach(function (p) { x0 = Math.min(x0, p.px); y0 = Math.min(y0, p.py); x1 = Math.max(x1, p.px); y1 = Math.max(y1, p.py); });
      var spread = Math.max(x1 - x0, y1 - y0);
      if (spread * KMAX < 40 || t.k >= KMAX * .9) { showPop(c); return; }
      hidePop();
      go(viewFor(m, KMAX), 900);
    }
    function showPop(c) {
      var m = c._members;
      pop.innerHTML = '<div class="ms-sl__label"><span>' + esc(m.length + ' ' + T.here) + '</span><button type="button" aria-label="Close" data-x><svg viewBox="0 0 16 16" width="11" height="11"><path d="M1 1 L15 15 M15 1 L1 15" fill="none" stroke="currentColor" stroke-width="1.2"/></svg></button></div><ul></ul>';
      var ul = pop.querySelector('ul');
      m.forEach(function (p) {
        var li = document.createElement('li');
        li.innerHTML = '<button type="button"><i class="ms-sl__mark is-' + p.kind + '"></i><span>' + esc(p.name) + '</span><em>' + esc(KINDS[p.kind]) + '</em></button>';
        li.firstChild.addEventListener('click', function (e) { e.stopPropagation(); hidePop(); select(p, { fromMap: true, fly: false }); });
        ul.appendChild(li);
      });
      pop.querySelector('[data-x]').addEventListener('click', function (e) { e.stopPropagation(); hidePop(); });
      pop.hidden = false; pop._cluster = c;
      var pw = pop.offsetWidth, ph = pop.offsetHeight;
      var x = Math.min(Math.max(12, c._x - pw / 2), W - pw - 12), y = c._y - ph - 26;
      if (y < 60) y = c._y + 28;
      pop.style.left = x + 'px'; pop.style.top = Math.min(y, H - ph - 12) + 'px';
    }
    function hidePop() { pop.hidden = true; pop._cluster = null; }
    mapEl.addEventListener('click', function (e) { if (!e.target.closest('.ms-sl__pop, .ms-sl__pin, button')) hidePop(); });

    map = { layout: layout, fit: fit, flyTo: flyTo };
    var world0 = document.querySelector('script[data-ms-sl-geo]');
    Promise.resolve().then(function () { return JSON.parse(world0.textContent); }).then(function (topology) {
      draw(topology);
      size();
      svg.call(zoom);
      svg.style('touch-action', 'pan-x pan-y');
      var start = viewFor(stores, 40, narrow() ? 28 : 56);
      svg.call(zoom.transform, start);
      layout();
      if (location.hash === '#atelier') { var a = stores.filter(function (p) { return p.kind === 'atelier'; })[0]; if (a) setTimeout(function () { select(a, { scrollList: true }); }, 350); }
      var rt;
      if (window.ResizeObserver) new ResizeObserver(function () {
        clearTimeout(rt);
        rt = setTimeout(function () { var w0 = W, h0 = H; size(); if (W !== w0 || H !== h0) { if (state.sel) flyTo(state.sel); else svg.call(zoom.transform, viewFor(stores.filter(shown), 40)); } layout(); }, 120);
      }).observe(mapEl);
    }).catch(function (err) { mapEl.classList.add('is-failed'); if (window.console) console.error('[agents map]', err); });
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', msSlInit); else msSlInit();
  document.addEventListener('shopify:section:load', function () { setTimeout(msSlInit, 0); });
  })();
</script>
{%- endif -%}
