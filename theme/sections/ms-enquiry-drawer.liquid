{%- comment -%} The enquiry sheet: any link to /pages/contact, or anything marked data-ms-enquire, opens it. {%- endcomment -%}
<div aria-label="Enquiry" aria-modal="true" data-dc-tpl="1335" data-ms-drawer="" hidden="" role="dialog" style="position: fixed; inset: 0px; z-index: 90;">
<div data-ms-drawer-close="" style="position: absolute; inset: 0px; background: rgba(10, 8, 6, 0.65);"></div>
<aside data-ms="sheet" style="position: absolute; top: 0px; bottom: 0px; right: 0px; width: min(560px, 100%); background: rgb(251, 249, 245); color: rgb(23, 20, 15); display: flex; flex-direction: column; animation: 0.45s cubic-bezier(0.4, 0, 0.2, 1) 0s 1 normal both running msSlide; box-shadow: rgba(10, 8, 6, 0.2) -30px 0px 90px;">
<div data-ms="grip" style="display: none; align-items: center; justify-content: center; padding: 14px 0px 4px; cursor: grab; touch-action: none;">
<span style="display: block; width: 46px; height: 3px; background: rgb(221, 214, 201);"></span>
</div>
<header style="display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: clamp(20px, 2.4vw, 28px) clamp(22px, 3.4vw, 48px); border-bottom: 1px solid rgb(221, 214, 201);">
<span style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</span>
<button aria-label="Close" data-ms-drawer-close="" style="background: none; border: 0px; padding: 4px; cursor: pointer; color: rgb(23, 20, 15);" type="button">
<svg aria-hidden="true" height="14" style="display: block;" viewbox="0 0 16 16" width="14"><path d="M1 1 L15 15 M15 1 L1 15" fill="none" stroke="currentColor" stroke-width="1.1"></path></svg>
</button>
</header>
<div style="flex: 1 1 0%; overflow-y: auto; padding: clamp(34px, 4.4vw, 58px) clamp(22px, 3.4vw, 48px) clamp(40px, 5vw, 64px);">{%- form 'contact', id: 'ms-drawer-form' -%}<div data-ms-enq="Book appointment"><input data-ms-enq-mode-field="" name="contact[Enquiry mode]" type="hidden" value="Book appointment"/>{%- if form.posted_successfully? -%}<p role="status" style="font-family: Newsreader, Georgia, serif; font-size: 20px; line-height: 1.5; border-top: 1px solid #DDD6C9; border-bottom: 1px solid #DDD6C9; padding: 18px 0; margin-bottom: 30px;">Thank you. The atelier will reply within one working day.</p>{%- endif -%}{%- if form.errors -%}<div role="alert" style="font-size: 13px; line-height: 1.8; color: #8B3A2B; margin-bottom: 24px;">{{ form.errors | default_errors }}</div>{%- endif -%}
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 40px); font-weight: 200; line-height: 1.1; letter-spacing: -0.02em; max-width: 22ch;">{{ section.settings.t2 }}</h2>
<p data-ms-copy="note" style="margin-top: 20px; font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); max-width: 48ch;">{{ section.settings.t3 }}</p>
<div style="margin-top: clamp(30px, 3.6vw, 46px);">
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-bottom: 6px;">{{ section.settings.t4 }}</div>
<button aria-pressed="false" data-ms-tab="Request brochure" style="display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: transparent; border-width: 1px 0px 0px; border-top-style: solid; border-right-style: initial; border-bottom-style: initial; border-left-style: initial; border-top-color: rgb(221, 214, 201); border-right-color: initial; border-bottom-color: initial; border-left-color: initial; border-image: initial; padding: 16px 0px; cursor: pointer; font-family: inherit; color: inherit;" type="button">{{ section.settings.t5 }}</button>
<button aria-pressed="true" data-ms-tab="Book appointment" style="display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: transparent; border-width: 1px 0px 0px; border-top-style: solid; border-right-style: initial; border-bottom-style: initial; border-left-style: initial; border-top-color: rgb(221, 214, 201); border-right-color: initial; border-bottom-color: initial; border-left-color: initial; border-image: initial; padding: 16px 0px; cursor: pointer; font-family: inherit; color: inherit;" type="button">{{ section.settings.t6 }}</button>
<button aria-pressed="false" data-ms-tab="Request callback" style="display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: transparent; border-width: 1px 0px 0px; border-top-style: solid; border-right-style: initial; border-bottom-style: initial; border-left-style: initial; border-top-color: rgb(221, 214, 201); border-right-color: initial; border-bottom-color: initial; border-left-color: initial; border-image: initial; padding: 16px 0px; cursor: pointer; font-family: inherit; color: inherit;" type="button">{{ section.settings.t7 }}</button>
<button aria-pressed="false" data-ms-tab="Leave a message" style="display: flex; align-items: center; gap: 14px; width: 100%; text-align: left; background: transparent; border-width: 1px 0px; border-top-style: solid; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: rgb(221, 214, 201); border-right-color: initial; border-bottom-color: rgb(221, 214, 201); border-left-color: initial; border-image: initial; padding: 16px 0px; cursor: pointer; font-family: inherit; color: inherit;" type="button">{{ section.settings.t8 }}</button>
</div>
<div data-ms="fieldgrid" style="display: grid; grid-template-columns: repeat(2, minmax(0px, 1fr)); gap: 26px; margin-top: clamp(32px, 3.8vw, 48px); align-items: end;">
<label style="display: flex; flex-direction: column; gap: 9px;">
<span style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t9 }}</span>
<select class="ms-field" name="contact[Title]" required="" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;"><option value=""><span>{{ section.settings.t10 }}</span></option><option><span>{{ section.settings.t11 }}</span></option><option><span>{{ section.settings.t12 }}</span></option><option><span>{{ section.settings.t13 }}</span></option><option><span>{{ section.settings.t14 }}</span></option><option><span>{{ section.settings.t15 }}</span></option></select>
</label>
<label style="display: flex; flex-direction: column; gap: 9px;">
<span style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t16 }}</span>
<input autocomplete="given-name" class="ms-field" name="contact[First name]" required="" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;" type="text"/>
</label>
<label style="display: flex; flex-direction: column; gap: 9px;">
<span style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t17 }}</span>
<input autocomplete="family-name" class="ms-field" name="contact[Last name]" required="" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;" type="text"/>
</label>
<label style="display: flex; flex-direction: column; gap: 9px;">
<span style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t18 }}</span>
<input autocomplete="email" class="ms-field" name="contact[email]" required="" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;" type="email"/>
</label>
<label style="display: flex; flex-direction: column; gap: 9px;">
<span data-ms-copy="five" style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t19 }}</span>
<input class="ms-field" data-ms-field="five" name="contact[Phone]" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;" type="tel"/>
</label>
<label style="display: flex; flex-direction: column; gap: 9px;">
<span data-ms-copy="six" style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t20 }}</span>
<input class="ms-field" data-ms-copy="sixHint" data-ms-field="six" name="contact[Preferred date]" placeholder="Monday to Friday" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px; font-size: 15px;" type="text"/>
</label>
<label style="display: flex; flex-direction: column; gap: 9px; grid-column: 1 / -1;">
<span data-ms-copy="notes" style="font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 26px; display: flex; align-items: flex-end;">{{ section.settings.t21 }}</span>
<textarea class="ms-field" data-ms-field="notes" name="contact[Notes]" rows="1" style="border-bottom: 1px solid rgb(221, 214, 201); padding: 9px 0px 46px; font-size: 15px;"></textarea>
</label>
</div>
<label style="display: flex; align-items: flex-start; gap: 12px; margin-top: 30px; font-size: 12.5px; line-height: 1.8; color: rgb(110, 103, 92);">
<input class="ms-check" name="contact[Consent]" required="" type="checkbox" value="yes"/>
<span>{{ section.settings.t22 }}</span>
</label>
<div style="display: flex; flex-direction: column; gap: 20px; align-items: flex-start; margin-top: 32px;">
<button style="background: rgb(23, 20, 15); color: rgb(251, 249, 245); border: 0px; padding: 20px 44px; cursor: pointer; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase;" type="submit">{{ section.settings.t23 }}</button>
<a data-ms="cta" href="/pages/contact" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t24 }}</a>
</div>
</div>{%- endform -%}</div>
<footer style="flex: 0 0 auto; border-top: 1px solid rgb(221, 214, 201); background: rgb(241, 236, 227); padding: clamp(22px, 2.6vw, 32px) clamp(22px, 3.4vw, 48px); display: flex; flex-wrap: wrap; gap: 22px 44px;">
<div style="display: flex; flex-direction: column; gap: 7px;">{{ section.settings.t25 }}</div>
<div style="display: flex; flex-direction: column; gap: 7px;">{{ section.settings.t26 }}</div>
</footer></aside></div>
