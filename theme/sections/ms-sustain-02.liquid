{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,collections,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'regen' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="1242" style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 140px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(28px, 4vw, 56px);">
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 20px;">
<svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M4 20 C4 11 11 4 20 4 C20 13 13 20 4 20 Z" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M4 20 L16 8" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.2; margin-top: 16px;">{{ section.settings.t1 }}</h2>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 14px;">{{ section.settings.t2 }}</p>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 20px;">
<svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M6 21 V13 C6 9 9 6 12 6 C15 6 18 9 18 13 V21" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M9 6 V3 M15 6 V3" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M6 17 H18" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.2; margin-top: 16px;">{{ section.settings.t3 }}</h2>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 14px;">{{ section.settings.t4 }}</p>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 20px;">
<svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M14 4 L20 10 L16 14 L10 8 Z" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M10 8 L4 14 V20 H10 L16 14" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.2; margin-top: 16px;">{{ section.settings.t5 }}</h2>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 14px;">{{ section.settings.t6 }}</p>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 20px;">
<svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M19.5 12 A7.5 7.5 0 0 0 6.5 6.8" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M4.5 12 A7.5 7.5 0 0 0 17.5 17.2" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M6.5 3.4 V7 H10" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M17.5 20.6 V17 H14" fill="none" stroke="#7E623B" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 27px); line-height: 1.2; margin-top: 16px;">{{ section.settings.t7 }}</h2>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 14px;">{{ section.settings.t8 }}</p>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Sustainability 02 · Natur",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Natural materials",
      "default": "Natural materials"
    },
    {
      "type": "textarea",
      "id": "t2",
      "label": "Baby alpaca, Cheviot wool, horseha…",
      "default": "Baby alpaca, Cheviot wool, horsehair, vegetable horsehair, yak, mohair, cashmere, silk, linen, organic cotton and Orange Fiber. Fibres that were grown rather than extruded, and that can be carded, washed and laid again."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Handmade production",
      "default": "Handmade production"
    },
    {
      "type": "textarea",
      "id": "t4",
      "label": "Two artisans build each system sta…",
      "default": "Two artisans build each system start to finish, in Italy. No line, no tooling to amortise, no minimum run. A bed is made when it is ordered, which is why there is nothing to discount and nothing to clear."
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Repairability",
      "default": "Repairability"
    },
    {
      "type": "textarea",
      "id": "t6",
      "label": "Every layer is reachable. Fibres c…",
      "default": "Every layer is reachable. Fibres can be opened, redistributed and replaced; upholstery can be taken off and remade. A system is a set of serviceable parts, not a sealed unit."
    },
    {
      "type": "text",
      "id": "t7",
      "label": "15 + 15",
      "default": "15 + 15"
    },
    {
      "type": "textarea",
      "id": "t8",
      "label": "At year fifteen the mattress retur…",
      "default": "At year fifteen the mattress returns to the artisans who made it and its comfort, integrity and life are restored for the fifteen years ahead. The alternative — replacement — is the thing this service exists to avoid."
    }
  ]
}
{% endschema %}
