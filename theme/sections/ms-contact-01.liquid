<section data-dc-tpl="1068" data-ms-centred="" style="padding: clamp(60px, 9vw, 140px) clamp(18px, 5vw, 80px) clamp(32px, 4vw, 56px); max-width: 1560px; margin: 0px auto;"><div style="max-width: calc(1000px - 2 * clamp(18px, 5vw, 80px));">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(36px, 5.4vw, 74px); line-height: 1; letter-spacing: -0.035em; margin-top: 20px;">{{ section.settings.t2 }}</h1>
<p style="font-size: 16px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 26px; max-width: 54ch;">{{ section.settings.t3 }}</p>
</div></section>
{% schema %}
{
  "name": "Contact 01 · Enquiries Pl",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Enquiries",
      "default": "Enquiries"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Please proceed with your enquiry.",
      "default": "Please proceed with your enquiry."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Four ways to reach the atelier. Wh…",
      "default": "Four ways to reach the atelier. Whichever you choose, one person follows your enquiry from the first message to installation."
    }
  ]
}
{% endschema %}
