{%- paginate blog.articles by 13 -%}
{%- liquid
  assign featured = nil
  if paginate.current_page == 1
    assign featured = blog.articles.first
  endif
-%}
{%- if featured -%}
{%- assign article = featured -%}
{%- assign kicker = article.tags | first | default: blog.title -%}
<section style="padding: 0px clamp(18px, 5vw, 80px) clamp(48px, 6vw, 96px); max-width: 1560px; margin: 0px auto;">
<a href="{{ article.url }}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(28px, 5vw, 80px); align-items: center; border-top: 1px solid rgb(221, 214, 201); padding-top: clamp(28px, 4vw, 56px);">
{%- if article.image -%}<img alt="{{ article.image.alt | escape }}" src="{{ article.image | image_url: width: 1600 }}" width="1600" height="1200" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover;">{%- else -%}<span style="display: block; width: 100%; aspect-ratio: 4 / 3; background: rgb(241, 236, 227);"></span>{%- endif -%}
<div>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ kicker }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.6vw, 48px); line-height: 1.08; letter-spacing: -0.02em; margin-top: 18px;">{{ article.title }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 18px; max-width: 50ch;">{{ article.excerpt_or_content | strip_html | truncatewords: 34 }}</p>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; margin-top: 24px;">{{ section.settings.read }}</div>
</div>
</a>
</section>
{%- endif -%}
<section style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 150px); max-width: 1560px; margin: 0px auto;">
{%- if blog.articles_count == 0 -%}
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59);">{{ section.settings.empty }}</p>
{%- else -%}
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(24px, 3vw, 56px);">
{%- for article in blog.articles -%}
{%- if featured and forloop.first -%}{%- continue -%}{%- endif -%}
{%- assign kicker = article.tags | first | default: blog.title -%}
<a href="{{ article.url }}" style="display: block;">
{%- if article.image -%}<img alt="{{ article.image.alt | escape }}" src="{{ article.image | image_url: width: 900 }}" loading="lazy" width="900" height="1200" style="width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover;">{%- else -%}<span style="display: block; width: 100%; aspect-ratio: 3 / 4; background: rgb(241, 236, 227);"></span>{%- endif -%}
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ kicker }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.25; margin-top: 10px;">{{ article.title }}</h3>
</a>
{%- endfor -%}
</div>
{%- if paginate.pages > 1 -%}
<nav style="display: flex; gap: 22px; justify-content: center; margin-top: clamp(40px, 5vw, 72px); font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase;">
{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Newer</a>{%- endif -%}
<span style="color: rgb(110, 103, 92);">{{ paginate.current_page }} / {{ paginate.pages }}</span>
{%- if paginate.next -%}<a href="{{ paginate.next.url }}">Older →</a>{%- endif -%}
</nav>
{%- endif -%}
{%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{
  "name": "Journal · Notes",
  "settings": [
    { "type": "text", "id": "read", "label": "Read label", "default": "Read →" },
    { "type": "text", "id": "empty", "label": "When empty", "default": "New notes from the atelier are on their way." }
  ]
}
{% endschema %}
