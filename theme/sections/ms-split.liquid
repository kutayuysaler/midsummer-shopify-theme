{%- comment -%}
  Midsummer Milano — editorial split.
  Text on one side; on the other a photograph with its caption, or a second
  text column. With no photograph and nothing in the second column, the text
  runs as a single measure (a page heading or an introduction).
{%- endcomment -%}

{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
  assign second_count = 0
  for block in section.blocks
    if block.settings.column == 'second'
      assign second_count = second_count | plus: 1
    endif
  endfor
  if has_image or second_count > 0
    assign layout = 'two'
  else
    assign layout = 'one'
  endif
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
-%}

<div
  class="ms ms--{{ section.settings.tone }} ms-split ms-split--{{ layout }} ms-split--image-{{ section.settings.image_position }}"
  id="ms-split-{{ section.id }}"
>
  <div class="ms__wrap ms-split__grid{{ reveal }}">
    {%- capture text_column -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.column != 'second' -%}
          {%- render 'ms-split-block', block: block -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    <div class="ms-split__col ms-split__col--text ms-split__col--{{ section.settings.text_align }}">
      {{ text_column }}
    </div>

    {%- if layout == 'two' -%}
      <div class="ms-split__col ms-split__col--second">
        {%- if has_image -%}
          <figure class="ms-media">
            {%- if section.settings.image_link != blank -%}<a href="{{ section.settings.image_link }}" tabindex="-1">{%- endif -%}
            <div class="ms-media__frame ms-media__frame--{{ section.settings.image_ratio }}">
              {{
                section.settings.image
                | image_url: width: 2000
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 960, 1200, 1600, 2000',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  alt: section.settings.image.alt
              }}
            </div>
            {%- if section.settings.image_link != blank -%}</a>{%- endif -%}
            {%- if section.settings.image_caption != blank -%}
              <figcaption class="ms-caption">{{ section.settings.image_caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'second' -%}
            {%- render 'ms-split-block', block: block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  #ms-split-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    --ms-split-first: {{ section.settings.first_width }}fr;
    --ms-split-second: {{ 100 | minus: section.settings.first_width }}fr;
  }
  @media screen and (min-width: 750px) {
    #ms-split-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .ms-split__grid { display: grid; gap: clamp(36px, 6vw, 110px); align-items: start; }
  .ms-split--two .ms-split__grid { grid-template-columns: 1fr; }
  .ms-split__col { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .ms-split__col--text > .ms-h + .ms-lead,
  .ms-split__col--text > .ms-h + .ms-body { margin-top: 6px; }
  .ms-split__col--center { align-items: center; text-align: center; }
  .ms-split__col--center .ms-eyebrow { justify-content: center; }
  .ms-split--one .ms-split__col--text { max-width: 58rem; }
  .ms-split--one .ms-split__col--center { margin-inline: auto; }
  .ms-split .ms-actions { margin-top: 10px; }
  .ms-split .ms-signup { margin-top: 4px; }
  @media screen and (min-width: 990px) {
    .ms-split--two .ms-split__grid {
      grid-template-columns: minmax(0, var(--ms-split-first)) minmax(0, var(--ms-split-second));
      align-items: center;
    }
    .ms-split--two .ms-split__grid:has(.ms-split__col--second > .ms-lead:first-child),
    .ms-split--two .ms-split__grid:has(.ms-split__col--second > .ms-body:first-child) { align-items: start; }
    .ms-split--image-left .ms-split__col--second { order: -1; }
  }
  @media screen and (max-width: 989px) {
    .ms-split--image-left .ms-split__col--second:has(.ms-media) { order: -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · Editorial split",
  "tag": "section",
  "class": "ms-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "stone", "label": "Stone" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "ivory"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "first_width",
      "label": "Width of the text column",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Photograph"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Frame",
      "options": [
        { "value": "natural", "label": "The photograph's own shape" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "tall", "label": "Portrait 3:4" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 3:2" }
      ],
      "default": "natural"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Caption"
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "The house" },
        { "type": "checkbox", "id": "rule", "label": "Short rule before it", "default": false },
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "first" }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Heading", "info": "A line break here is kept.", "default": "A heading" },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "h1", "label": "Display (page title)" },
            { "value": "h2", "label": "Large" },
            { "value": "h3", "label": "Medium" },
            { "value": "h4", "label": "Small" }
          ],
          "default": "h2"
        },
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "first" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>A paragraph.</p>" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "lead", "label": "Lead (serif)" },
            { "value": "body", "label": "Body" },
            { "value": "small", "label": "Small" },
            { "value": "caption", "label": "Caption (italic serif)" }
          ],
          "default": "body"
        },
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "first" }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "settings": [
        { "type": "text", "id": "label_1", "label": "First button", "default": "Book a private appointment" },
        { "type": "url", "id": "link_1", "label": "Link" },
        { "type": "select", "id": "style_1", "label": "Style", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "link", "label": "Text link" } ], "default": "primary" },
        { "type": "checkbox", "id": "panel_1", "label": "Open the enquire panel", "default": false },
        { "type": "text", "id": "label_2", "label": "Second button" },
        { "type": "url", "id": "link_2", "label": "Link" },
        { "type": "select", "id": "style_2", "label": "Style", "options": [ { "value": "primary", "label": "Solid" }, { "value": "secondary", "label": "Outline" }, { "value": "link", "label": "Text link" } ], "default": "link" },
        { "type": "checkbox", "id": "panel_2", "label": "Open the enquire panel", "default": false },
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "first" }
      ]
    },
    {
      "type": "rule",
      "name": "Rule",
      "settings": [
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "first" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter sign-up",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email address" },
        { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" },
        { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you. You are on the list." },
        { "type": "select", "id": "column", "label": "Column", "options": [ { "value": "first", "label": "Text column" }, { "value": "second", "label": "Second column" } ], "default": "second" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MS · Editorial split",
      "blocks": [
        { "type": "eyebrow" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "buttons" }
      ]
    }
  ]
}
{% endschema %}
