{%- comment -%}
  The fibres, up close: photographs of the raw fibre, one card per
  block, the first one large. A card can use one of the photographs bundled with the theme or a
  picture from the store's files. Clicking a card opens it larger. The closing card is a small
  note in words, with the animals drawn.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign n = 0
-%}
<section class="ms-fg" id="ms-fg-{{ section.id }}" aria-labelledby="ms-fg-h-{{ section.id }}">
  <div class="ms-fg__head">
    {%- if s.eyebrow != blank -%}<div class="ms-fg__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="ms-fg__h" id="ms-fg-h-{{ section.id }}">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<p class="ms-fg__text">{{ s.text }}</p>{%- endif -%}
  </div>
  <div class="ms-fg__grid">
    {%- for b in section.blocks -%}
      {%- liquid
        assign bs = b.settings
        assign big = false
        if forloop.first and s.first_large
          assign big = true
        endif
        assign mark = bs.mark | default: bs.name
      -%}
      {%- if b.type == 'note' -%}
        <div class="ms-fg__note" {{ b.shopify_attributes }}>
          <div class="ms-fg__animals" aria-hidden="true">
            {%- assign animals = 'wool,goat,yak,vicuña,horsehair' | split: ',' -%}
            {%- for a in animals -%}<span>{% render 'ms-fibre-mark', name: a, size: 34 %}</span>{%- endfor -%}
          </div>
          {%- if bs.title != blank -%}<div class="ms-fg__note-t">{{ bs.title }}</div>{%- endif -%}
          {%- if bs.text != blank -%}<p class="ms-fg__note-p">{{ bs.text }}</p>{%- endif -%}
        </div>
      {%- else -%}
        {%- liquid
          if bs.image != blank
            assign src = bs.image | image_url: width: 1600
            assign src_sm = bs.image | image_url: width: 640
          elsif bs.photo != blank and bs.photo != 'none'
            assign f = 'ms-fibre-photo-' | append: bs.photo
            assign src = f | append: '.jpg' | asset_url
            assign src_sm = f | append: '-sm.jpg' | asset_url
          else
            assign src = blank
          endif
          assign n = n | plus: 1
        -%}
        <figure class="ms-fg__card{% if big %} ms-fg__card--big{% endif %}" {{ b.shopify_attributes }}>
          <button type="button" class="ms-fg__open" data-ms-fg-src="{{ src }}" data-ms-fg-cap="{{ bs.name | escape }}{% if bs.line != blank %}: {{ bs.line | escape }}{% endif %}" aria-label="{{ s.enlarge_label | escape }}: {{ bs.name | escape }}">
            <span class="ms-fg__img">
              {%- if src != blank -%}
                <img src="{{ src_sm }}" srcset="{{ src_sm }} 640w, {{ src }} {% if big %}1600w{% else %}1000w{% endif %}" sizes="{% if big %}(min-width: 900px) 50vw, 100vw{% else %}(min-width: 900px) 25vw, 50vw{% endif %}" alt="{{ bs.alt | default: bs.name | escape }}" width="1000" height="750" loading="lazy" decoding="async">
              {%- endif -%}
            </span>
          </button>
          <figcaption class="ms-fg__cap">
            <span class="ms-fg__mark" aria-hidden="true">{% render 'ms-fibre-mark', name: mark, size: 30 %}</span>
            <span class="ms-fg__name">{{ bs.name }}</span>
            {%- if bs.origin != blank -%}<span class="ms-fg__origin">{{ bs.origin }}</span>{%- endif -%}
            {%- if bs.line != blank -%}<span class="ms-fg__line">{{ bs.line }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <dialog class="ms-fg__dlg" aria-label="{{ s.heading | escape }}">
    <form method="dialog"><button class="ms-fg__x" aria-label="{{ s.close_label | escape }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button></form>
    <img class="ms-fg__big" alt="">
    <p class="ms-fg__bigcap"></p>
  </dialog>
</section>
<style>
  .ms-fg { border-top: 1px solid #DDD6C9; padding: clamp(48px, 7vw, 110px) clamp(18px, 5vw, 80px) clamp(56px, 8vw, 130px); max-width: 1560px; margin: 0 auto; }
  .ms-fg__head { max-width: 62ch; margin-bottom: clamp(28px, 4vw, 56px); }
  .ms-fg__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-fg__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3.6vw, 52px); letter-spacing: -0.025em; line-height: 1.05; margin-top: 16px; }
  .ms-fg__text { font-size: 15.5px; line-height: 1.9; color: #4A443B; margin-top: 18px; }
  .ms-fg__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(22px, 2.6vw, 40px) clamp(14px, 1.8vw, 26px); }
  .ms-fg__card { margin: 0; min-width: 0; }
  .ms-fg__card--big { grid-column: span 2; grid-row: span 2; }
  .ms-site .ms-fg__open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; color: inherit; }
  .ms-fg__img { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #EFE9DF; }
  .ms-fg__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .ms-fg__open:hover .ms-fg__img img, .ms-fg__open:focus-visible .ms-fg__img img { transform: scale(1.04); }
  .ms-fg__open:focus-visible { outline: 1px solid #17140F; outline-offset: 4px; }
  .ms-fg__cap { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 12px; align-items: center; margin-top: 14px; }
  .ms-fg__mark { grid-row: span 2; color: #7E623B; display: block; width: 30px; height: 30px; }
  .ms-fg__mark svg { display: block; }
  .ms-fg__name { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.2; }
  .ms-fg__card--big .ms-fg__name { font-size: clamp(22px, 2vw, 28px); }
  .ms-fg__origin { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #6E675C; margin-top: 3px; }
  .ms-fg__line { grid-column: 1 / -1; font-size: 13.5px; line-height: 1.7; color: #6E675C; margin-top: 10px; max-width: 42ch; }
  .ms-fg__note { border: 1px solid #DDD6C9; padding: clamp(20px, 2vw, 28px); display: flex; flex-direction: column; justify-content: center; gap: 12px; background: #F5F0E7; min-height: 100%; }
  .ms-fg__animals { display: flex; flex-wrap: wrap; gap: 6px 10px; color: #7E623B; }
  .ms-fg__animals span { display: block; width: 34px; height: 34px; }
  .ms-fg__animals span:nth-child(2n) { transform: translateY(3px); }
  .ms-fg__note-t { font-family: Newsreader, Georgia, serif; font-style: italic; font-weight: 300; font-size: 20px; line-height: 1.3; }
  .ms-fg__note-p { font-size: 13.5px; line-height: 1.75; color: #4A443B; }
  .ms-fg__dlg { border: 0; padding: 0; background: transparent; max-width: min(1200px, 94vw); width: 100%; overflow: visible; }
  .ms-fg__dlg::backdrop { background: rgba(23, 20, 15, .82); }
  .ms-fg__big { display: block; width: 100%; height: auto; max-height: 80vh; object-fit: contain; background: #EFE9DF; }
  .ms-fg__bigcap { color: #FBF9F5; font-size: 14px; line-height: 1.7; margin-top: 12px; text-align: center; }
  .ms-site .ms-fg__x { position: absolute; top: -44px; right: 0; width: 40px; height: 40px; display: grid; place-items: center; background: none; border: 0; color: #FBF9F5; cursor: pointer; }
  @media (max-width: 899px) {
    .ms-fg__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ms-fg__card--big { grid-row: auto; }
    .ms-fg__line { font-size: 13px; }
    .ms-fg__note { padding: 16px; }
    .ms-fg__note-p { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-fg__img img { transition: none; } }
</style>
<script>
  (function () {
    var root = document.getElementById('ms-fg-{{ section.id }}');
    if (!root || root.dataset.msReady) return;
    root.dataset.msReady = '1';
    var dlg = root.querySelector('.ms-fg__dlg');
    if (!dlg || typeof dlg.showModal !== 'function') return;
    var img = dlg.querySelector('.ms-fg__big'), cap = dlg.querySelector('.ms-fg__bigcap');
    root.querySelectorAll('[data-ms-fg-src]').forEach(function (b) {
      b.addEventListener('click', function () {
        var src = b.getAttribute('data-ms-fg-src');
        if (!src) return;
        img.src = src;
        img.alt = b.querySelector('img') ? b.querySelector('img').alt : '';
        cap.textContent = b.getAttribute('data-ms-fg-cap') || '';
        dlg.showModal();
      });
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
  })();
</script>

{% schema %}
{
  "name": "Fibres, up close",
  "class": "ms-fg-wrap",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Up close" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before it is a bed, it is this." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "The fibres we make our beds from, photographed close up, before anyone has done anything to them. Click any of them to see it larger." },
    { "type": "checkbox", "id": "first_large", "label": "First photograph large", "default": true },
    { "type": "text", "id": "enlarge_label", "label": "Enlarge label (screen readers)", "default": "See larger" },
    { "type": "text", "id": "close_label", "label": "Close label (screen readers)", "default": "Close" }
  ],
  "blocks": [
    {
      "type": "fibre",
      "name": "Fibre",
      "settings": [
        { "type": "select", "id": "photo", "label": "Bundled photograph", "default": "vicuna", "options": [
          { "value": "none", "label": "None" },
          { "value": "vicuna", "label": "Vicuña" },
          { "value": "vicuna-2", "label": "Vicuña, second" },
          { "value": "yak", "label": "Yak" },
          { "value": "cashmere", "label": "Cashmere" },
          { "value": "wool", "label": "Wool" },
          { "value": "silk", "label": "Silk" },
          { "value": "horsehair", "label": "Horsehair" },
          { "value": "cotton", "label": "Cotton" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Or a picture from the store", "info": "Replaces the bundled photograph." },
        { "type": "text", "id": "name", "label": "Fibre", "default": "Vicuña" },
        { "type": "text", "id": "mark", "label": "Drawn mark", "info": "A fibre name for the drawing, e.g. Cashmere or Yak Hair. Empty uses the fibre name." },
        { "type": "text", "id": "origin", "label": "Where it comes from" },
        { "type": "textarea", "id": "line", "label": "Line" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Empty uses the fibre name." }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Not pictured" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The sheep, the goats, the yak, the vicuña and the horses. All were invited; none could make the photo shoot." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fibres, up close",
      "blocks": [
        { "type": "fibre", "settings": { "photo": "vicuna", "name": "Vicuña", "origin": "The Andes, Peru" } },
        { "type": "fibre", "settings": { "photo": "yak", "name": "Yak hair" } },
        { "type": "fibre", "settings": { "photo": "cashmere", "name": "Cashmere" } },
        { "type": "note" }
      ]
    }
  ]
}
{% endschema %}
