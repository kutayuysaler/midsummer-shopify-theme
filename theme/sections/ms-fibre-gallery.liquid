{%- comment -%}
  The fibres, up close: one square photograph of each raw fibre, chosen from an index like the
  plates of a natural history book (number, name, Latin name, where it comes from). Each fibre is
  a block, with a photograph bundled with the theme or one from the store's files. Without
  script, the first photograph shows and the index reads as a list.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-fg" id="ms-fg-{{ section.id }}" aria-labelledby="ms-fg-h-{{ section.id }}">
  <div class="ms-fg__wrap">
    <div class="ms-fg__side">
      {%- if s.eyebrow != blank -%}<div class="ms-fg__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="ms-fg__h" id="ms-fg-h-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ms-fg__text">{{ s.text }}</p>{%- endif -%}
      <ol class="ms-fg__index" role="list">
        {%- for b in section.blocks -%}
          <li {{ b.shopify_attributes }}>
            <button type="button" class="ms-fg__pick{% if forloop.first %} is-on{% endif %}" data-ms-fg-to="{{ forloop.index0 }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="ms-fg__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="ms-fg__nm">{{ b.settings.name }}</span>
              {%- if b.settings.latin != blank -%}<span class="ms-fg__la">{{ b.settings.latin }}</span>{%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <div class="ms-fg__plate">
      <div class="ms-fg__frame">
        {%- for b in section.blocks -%}
          {%- liquid
            assign bs = b.settings
            if bs.image != blank
              assign src = bs.image | image_url: width: 1200
              assign src_sm = bs.image | image_url: width: 640
            elsif bs.photo != blank and bs.photo != 'none'
              assign f = 'ms-fibre-photo-' | append: bs.photo
              assign src = f | append: '.jpg' | asset_url
              assign src_sm = f | append: '-sm.jpg' | asset_url
            else
              assign src = blank
            endif
          -%}
          <figure class="ms-fg__slide{% if forloop.first %} is-on{% endif %}" data-ms-fg-slide="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
            {%- if src != blank -%}
              <img src="{{ src_sm }}" srcset="{{ src_sm }} 720w, {{ src }} 1400w" sizes="(min-width: 900px) 52vw, 100vw" alt="{{ bs.alt | default: bs.name | escape }}" width="1400" height="1400" loading="{% if forloop.first %}lazy{% else %}lazy{% endif %}" decoding="async">
            {%- endif -%}
            <figcaption class="ms-fg__cap">
              <span class="ms-fg__capno">{{ s.plate_label }} {{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="ms-fg__capnm">{{ bs.name }}{%- if bs.latin != blank -%} <i>{{ bs.latin }}</i>{%- endif -%}</span>
              {%- if bs.line != blank -%}<span class="ms-fg__capln">{{ bs.line }}</span>{%- endif -%}
              {%- if bs.origin != blank -%}<span class="ms-fg__capor">{{ bs.origin }}</span>{%- endif -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
<style>
  .ms-fg { border-top: 1px solid #DDD6C9; padding: clamp(56px, 8vw, 120px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0 auto; }
  .ms-fg__wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
  .ms-fg__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-fg__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3.4vw, 48px); letter-spacing: -0.025em; line-height: 1.08; margin-top: 16px; }
  .ms-fg__text { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 18px; max-width: 44ch; }
  .ms-fg__index { list-style: none; margin: clamp(28px, 3.4vw, 48px) 0 0; padding: 0; border-top: 1px solid #DDD6C9; }
  .ms-fg__index li { border-bottom: 1px solid #ECE6DB; }
  .ms-site .ms-fg__pick { display: grid; grid-template-columns: 38px minmax(0, auto) 1fr; align-items: baseline; gap: 0 14px; width: 100%; padding: 15px 0; background: none; border: 0; text-align: left; cursor: pointer; color: #9A8F7E; transition: color .35s; }
  .ms-fg__no { font-family: Newsreader, Georgia, serif; font-size: 13px; font-variant-numeric: tabular-nums; }
  .ms-fg__nm { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(20px, 1.7vw, 24px); letter-spacing: -0.01em; color: inherit; transition: transform .5s cubic-bezier(.2, .7, .2, 1); }
  .ms-fg__la { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 14px; color: #B5AA97; justify-self: end; }
  .ms-site .ms-fg__pick:hover, .ms-site .ms-fg__pick:focus-visible { color: #4A443B; outline: none; }
  .ms-site .ms-fg__pick.is-on { color: #17140F; }
  .ms-fg__pick.is-on .ms-fg__nm { transform: translateX(6px); }
  .ms-fg__pick.is-on .ms-fg__no { color: #7E623B; }
  .ms-fg__pick:focus-visible .ms-fg__nm { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .ms-fg__plate { position: sticky; top: 110px; }
  .ms-fg__frame { position: relative; }
  .ms-fg__slide { margin: 0; display: none; }
  .ms-fg__slide.is-on { display: block; animation: ms-fg-in .9s cubic-bezier(.2, .7, .2, 1); }
  @keyframes ms-fg-in { from { opacity: 0; transform: scale(1.012); } to { opacity: 1; transform: none; } }
  .ms-fg__slide img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; background: #EFE9DF; }
  .ms-fg__cap { display: grid; grid-template-columns: auto 1fr; gap: 6px 22px; align-items: baseline; padding-top: 18px; margin-top: 0; border-top: 0; }
  .ms-fg__capno { grid-row: span 3; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #7E623B; padding-top: 6px; }
  .ms-fg__capnm { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(22px, 2vw, 28px); line-height: 1.15; }
  .ms-fg__capnm i { font-size: .62em; color: #9A8F7E; margin-left: 6px; }
  .ms-fg__capln { font-size: 14px; line-height: 1.75; color: #4A443B; max-width: 52ch; }
  .ms-fg__capor { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #9A8F7E; }
  @media (max-width: 899px) {
    .ms-fg__wrap { grid-template-columns: minmax(0, 1fr); }
    .ms-fg__plate { position: static; order: 2; }
    .ms-fg__index { display: flex; gap: 0 18px; overflow-x: auto; scrollbar-width: none; border-top: 0; margin-inline: calc(-1 * clamp(18px, 5vw, 80px)); padding-inline: clamp(18px, 5vw, 80px); }
    .ms-fg__index li { border: 0; flex: 0 0 auto; }
    .ms-site .ms-fg__pick { display: flex; gap: 6px; padding: 10px 0; border-bottom: 1px solid transparent; }
    .ms-site .ms-fg__pick.is-on { border-bottom-color: #17140F; }
    .ms-fg__la { display: none; }
    .ms-fg__pick.is-on .ms-fg__nm { transform: none; }
    .ms-fg__cap { grid-template-columns: 1fr; }
    .ms-fg__capno { grid-row: auto; padding-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-fg__slide.is-on { animation: none; } .ms-fg__nm { transition: none; } }
</style>
<script>
  (function () {
    var root = document.getElementById('ms-fg-{{ section.id }}');
    if (!root || root.dataset.msReady) return;
    root.dataset.msReady = '1';
    var picks = root.querySelectorAll('[data-ms-fg-to]'), slides = root.querySelectorAll('[data-ms-fg-slide]');
    function show(i) {
      picks.forEach(function (b) { var on = b.getAttribute('data-ms-fg-to') === String(i); b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      slides.forEach(function (sl) { var on = sl.getAttribute('data-ms-fg-slide') === String(i); sl.classList.toggle('is-on', on); if (on) sl.removeAttribute('aria-hidden'); else sl.setAttribute('aria-hidden', 'true'); });
    }
    picks.forEach(function (b, n) {
      b.addEventListener('click', function () { show(b.getAttribute('data-ms-fg-to')); });
      // on a computer, pointing at a name is enough
      b.addEventListener('mouseenter', function () { if (matchMedia('(hover: hover)').matches) show(b.getAttribute('data-ms-fg-to')); });
      b.addEventListener('keydown', function (e) {
        var k = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!k) return; e.preventDefault();
        var t = picks[(n + k + picks.length) % picks.length]; t.focus(); show(t.getAttribute('data-ms-fg-to'));
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fibres, up close",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "At the source" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Where each fibre begins." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Before anything is made, every fibre is chosen by hand. Here are seven of them, and where each one begins." },
    { "type": "text", "id": "plate_label", "label": "Plate label", "default": "Plate" }
  ],
  "blocks": [
    {
      "type": "fibre",
      "name": "Fibre",
      "settings": [
        { "type": "select", "id": "photo", "label": "Bundled photograph", "default": "vicuna", "options": [
          { "value": "none", "label": "None" },
          { "value": "vicuna", "label": "Vicuña" },
          { "value": "yak", "label": "Yak" },
          { "value": "cashmere", "label": "Cashmere" },
          { "value": "wool", "label": "Wool" },
          { "value": "silk", "label": "Silk" },
          { "value": "horsehair", "label": "Horsehair" },
          { "value": "cotton", "label": "Cotton" }
        ] },
        { "type": "image_picker", "id": "image", "label": "Or a picture from the store", "info": "Square works best. Replaces the bundled photograph." },
        { "type": "text", "id": "name", "label": "Fibre", "default": "Vicuña" },
        { "type": "text", "id": "latin", "label": "Latin name", "default": "Vicugna vicugna" },
        { "type": "text", "id": "origin", "label": "Where it comes from" },
        { "type": "textarea", "id": "line", "label": "Line" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Empty uses the fibre name." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fibres, up close",
      "blocks": [
        { "type": "fibre", "settings": { "photo": "vicuna", "name": "Vicuña", "latin": "Vicugna vicugna", "origin": "The Andes, Peru" } },
        { "type": "fibre", "settings": { "photo": "yak", "name": "Yak", "latin": "Bos grunniens" } },
        { "type": "fibre", "settings": { "photo": "cashmere", "name": "Cashmere", "latin": "Capra hircus" } }
      ]
    }
  ]
}
{% endschema %}
