<section data-dc-tpl="923" style="background: rgb(23, 20, 15); color: rgb(251, 249, 245); padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px);">
<div style="max-width: 1560px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(32px, 6vw, 96px); align-items: center;">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgba(251, 249, 245, 0.55);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.8vw, 52px); line-height: 1.06; letter-spacing: -0.02em; margin-top: 18px;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgba(251, 249, 245, 0.75); margin-top: 22px; max-width: 50ch;">{{ section.settings.t3 }}</p>
<div style="margin-top: 32px;"><a data-ms="cta" data-ms-enquire="" href="/pages/contact" style="color: rgb(251, 249, 245); font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgba(251, 249, 245, 0.6); padding-bottom: 7px;">{{ section.settings.t4 }}</a></div>
</div>
<div style="display: flex; flex-direction: column; gap: 22px; border-left: 1px solid rgba(251, 249, 245, 0.2); padding-left: clamp(22px, 3vw, 48px);">
<div><div style="font-family: Newsreader, Georgia, serif; font-size: 23px;">{{ section.settings.t5 }}</div><div style="font-size: 14px; line-height: 1.85; color: rgba(251, 249, 245, 0.7); margin-top: 4px;">{{ section.settings.t6 }}</div></div>
<div><div style="font-family: Newsreader, Georgia, serif; font-size: 23px;">{{ section.settings.t7 }}</div><div style="font-size: 14px; line-height: 1.85; color: rgba(251, 249, 245, 0.7); margin-top: 4px;">{{ section.settings.t8 }}</div></div>
<div><div style="font-family: Newsreader, Georgia, serif; font-size: 23px;">{{ section.settings.t9 }}</div><div style="font-size: 14px; line-height: 1.85; color: rgba(251, 249, 245, 0.7); margin-top: 4px;">{{ section.settings.t10 }}</div></div>
</div>
</div>
</section>
