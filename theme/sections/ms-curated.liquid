{%- comment -%}
  The systems of one collection. Uses the store's collection when it exists, otherwise the
  products the house lists under it (snippets/ms-tier.liquid), so the page is never empty.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign col = collections[s.tier]
  if col == blank or col.products_count == 0
    for c in collections
      assign ct = c.title | downcase
      if ct contains s.tier and c.products_count > 0
        assign col = c
        break
      endif
    endfor
  endif
  assign handles = ''
  if col == blank or col.products_count == 0
    capture handles
      render 'ms-tier', tier: s.tier
    endcapture
  endif
  assign hs = handles | split: ','
-%}
<section class="ms-cu">
  <div class="ms-cu__in">
    <div class="ms-cu__head">
      <div>
        <div class="ms-cu__eyebrow">{{ s.eyebrow }}</div>
        <h2 class="ms-cu__title">{{ s.heading }}</h2>
      </div>
      {%- if s.text != blank -%}<p class="ms-cu__text">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- capture cards -%}
      {%- if col != blank and col.products_count > 0 -%}
        {%- for p in col.products limit: 24 -%}{%- render 'ms-cu-card', p: p -%}{%- endfor -%}
      {%- else -%}
        {%- for h in hs -%}{%- render 'ms-cu-card', p: all_products[h] -%}{%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if cards != blank -%}
      <div class="ms-cu__grid">{{ cards }}</div>
    {%- else -%}
      <p class="ms-cu__empty">{{ s.empty }}</p>
    {%- endif -%}
    <div class="ms-cu__foot">
      <a class="ms-cu__link" href="{% render 'ms-link', to: 'collections' %}">{{ s.compare_label }}<span aria-hidden="true">→</span></a>
      <a class="ms-cu__btn" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=proposal' %}#enquire" data-ms-landing>{{ s.button }}</a>
    </div>
  </div>
</section>
<style>
  .ms-cu { background: #FBF9F5; color: #17140F; padding: clamp(72px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-cu__in { max-width: 1560px; margin: 0 auto; }
  .ms-cu__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(24px, 5vw, 96px); align-items: end; }
  .ms-cu__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-cu__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(34px, 4vw, 60px); line-height: 1.04; letter-spacing: -0.03em; margin-top: 18px; }
  .ms-cu__text { font-size: 15.5px; line-height: 1.9; color: #4A443B; max-width: 52ch; }
  .ms-cu__grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: clamp(28px, 3vw, 48px) clamp(16px, 2vw, 32px); margin-top: clamp(40px, 5vw, 72px); }
  .ms-site .ms-cu__card { display: block; color: inherit; }
  .ms-cu__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #EFE9DE; }
  .ms-cu__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ms-cu__card:hover .ms-cu__img img { transform: scale(1.04); }
  .ms-cu__name { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 22px; letter-spacing: -0.01em; margin-top: 16px; }
  .ms-cu__type { display: block; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #6E675C; margin-top: 6px; }
  .ms-site .ms-cu__empty { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(22px, 2vw, 28px); line-height: 1.4; color: #4A443B; margin-top: clamp(36px, 4vw, 56px); max-width: 40ch; }
  .ms-cu__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px; margin-top: clamp(48px, 6vw, 88px); padding-top: 26px; border-top: 1px solid #DDD6C9; }
  .ms-site .ms-cu__link { display: inline-flex; gap: 12px; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-site .ms-cu__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 30px; background: #17140F; color: #FBF9F5; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  @media (max-width: 800px) { .ms-cu__head { grid-template-columns: minmax(0, 1fr); } .ms-cu__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ms-cu__name { font-size: 18px; } }
</style>

{% schema %}
{
  "name": "Collection · Systems",
  "settings": [
    { "type": "select", "id": "tier", "label": "Collection", "default": "icons", "options": [{"value":"essentials","label":"Essentials"},{"value":"signature","label":"Signature"},{"value":"icons","label":"Icons"}] },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The systems" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every one made to order." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "compare_label", "label": "Compare link", "default": "Compare the three collections" },
    { "type": "text", "id": "button", "label": "Button", "default": "Request a proposal" },
    { "type": "textarea", "id": "empty", "label": "When no system is published", "default": "Every system in this collection is shown at the atelier and made to order. Ask us for the full list, with photographs." }
  ],
  "presets": [{ "name": "Collection · Systems" }]
}
{% endschema %}
