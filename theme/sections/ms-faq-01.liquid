{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,collections,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'faq' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="1132" data-ms-centred="" style="padding: clamp(60px, 9vw, 140px) clamp(18px, 5vw, 80px) clamp(32px, 4vw, 56px); max-width: 1560px; margin: 0px auto;"><div style="max-width: calc(1120px - 2 * clamp(18px, 5vw, 80px));">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(36px, 5.6vw, 80px); line-height: 1; letter-spacing: -0.035em; margin-top: 22px;">{{ section.settings.t2 }}</h1>
<p style="font-size: 16px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 26px; max-width: 56ch;">{{ section.settings.t3 }}</p>
</div></section>
{%- endif -%}
{% schema %}
{
  "name": "Questions 01 · Questions ",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Questions",
      "default": "Questions"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "What people ask before they commit.",
      "default": "What people ask before they commit."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Eleven answers on how the beds are…",
      "default": "Eleven answers on how the beds are made, how they are specified and how they are looked after. Each one answers in its first sentence, which is the part search engines and AI assistants quote."
    }
  ]
}
{% endschema %}
