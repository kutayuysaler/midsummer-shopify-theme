<section data-dc-tpl="210" style="padding: clamp(80px, 12vw, 190px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(32px, 6vw, 110px);">
<div style="display: flex; flex-direction: column; gap: 22px;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(24px, 3.2vw, 42px); line-height: 1.3; letter-spacing: -0.015em;">{{ section.settings.t2 }}</p>
</div>
<div style="display: flex; flex-direction: column; gap: 22px; font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); max-width: 58ch; padding-top: clamp(0px, 2vw, 40px);">
<p>{{ section.settings.t3 }}</p>
<p>{{ section.settings.t4 }}</p>
</div>
</div>
</section>
{% schema %}
{
  "name": "Home 02 · The house There",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "The house",
      "default": "The house"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "There is a way of sleeping that go…",
      "default": "There is a way of sleeping that goes beyond rest. It is beauty, wellbeing and respect for nature."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Midsummer Milano is born from the …",
      "default": "Midsummer Milano is born from the meeting of Italian design, exceptional craftsmanship and the finest natural materials. Every sleep system is built by hand, one by one, by two artisans, start to finish. This artisanal continuity makes true customisation possible: in dimensions, heights, materials, fabrics, and comfort levels. Not an exception, but our standard."
    },
    {
      "type": "textarea",
      "id": "t4",
      "label": "We work with wool, cashmere, silk,…",
      "default": "We work with wool, cashmere, silk, horsehair, linen and Orange Fiber. We upholster our systems in Loro Piana Interiors fabrics, which change with the seasons as our needs do."
    }
  ]
}
{% endschema %}
