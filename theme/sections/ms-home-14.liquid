<section data-dc-tpl="399" style="padding: clamp(80px, 12vw, 180px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 24px; border-top: 1px solid rgb(221, 214, 201); padding-top: 26px; margin-bottom: clamp(32px, 4vw, 60px);">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.6vw, 50px); line-height: 1.06; letter-spacing: -0.02em;">{{ section.settings.t1 }}</h2>
<a data-ms="cta" href="/blogs/news" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t2 }}</a>
</div>
<div data-ms="rail" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(20px, 3vw, 48px);">
<a href="/blogs/news" style="display: block;">
<img alt="" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/files/Vicuna-mattress.jpg?v=1748611838&amp;width=900{% endif %}" style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover;"/>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t3 }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.25; margin-top: 10px; max-width: 30ch;">{{ section.settings.t4 }}</h3>
</a>
<a href="/blogs/news" style="display: block;">
<img alt="" loading="lazy" src="{% if section.settings.img2 != blank %}{{ section.settings.img2 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-horse.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover;"/>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t5 }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.25; margin-top: 10px; max-width: 30ch;">{{ section.settings.t6 }}</h3>
</a>
<a href="/blogs/news" style="display: block;">
<img alt="" loading="lazy" src="{% if section.settings.img3 != blank %}{{ section.settings.img3 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/files/giotto_SANGALGANO.jpg?v=1748612061&amp;width=900{% endif %}" style="width: 100%; aspect-ratio: 4 / 3; object-fit: cover;"/>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t7 }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.25; margin-top: 10px; max-width: 30ch;">{{ section.settings.t8 }}</h3>
</a>
</div>
</section>
{% schema %}
{
  "name": "Home 14 · Journal All not",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "img3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Journal",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "All notes →",
      "default": "All notes →"
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Materials",
      "default": "Materials"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Vicuña, and why it is called the f…",
      "default": "Vicuña, and why it is called the fibre of the gods."
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Sleep",
      "default": "Sleep"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "Sensitive, balanced or structured:…",
      "default": "Sensitive, balanced or structured: how you really sleep."
    },
    {
      "type": "text",
      "id": "t7",
      "label": "Design",
      "default": "Design"
    },
    {
      "type": "text",
      "id": "t8",
      "label": "A round bed for a Tuscan abbey.",
      "default": "A round bed for a Tuscan abbey."
    }
  ]
}
{% endschema %}
