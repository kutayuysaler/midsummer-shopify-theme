{%- comment -%}
  The Loro Piana Interiors cloths our systems are made in, one at a time, as the atelier's colour
  cards show them: the cloth, its article and composition, the systems it dresses, and its colours
  by name. A row of cloths above chooses which one is shown (a link to #mystic-river opens it); without
  script every cloth shows, one after the other. A Fabric block opens a cloth; the Colour blocks
  after it are its palette. Choose a colour and the specimen follows; ask about it and the enquiry
  opens with the cloth and the colour already written.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign n_fab = 0
  for b in section.blocks
    if b.type == 'fabric'
      assign n_fab = n_fab | plus: 1
    endif
  endfor
-%}
<section class="ms-lf" id="{{ s.anchor | default: 'fabrics' }}" data-ms-lf>
  <div class="ms-lf__in">
    <header class="ms-lf__head">
      <div>
        {%- if s.eyebrow != blank -%}<div class="ms-lf__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-lf__heading">{{ s.heading }}</h2>
      </div>
      {%- if s.text != blank -%}<div class="ms-lf__text">{{ s.text }}</div>{%- endif -%}
    </header>

    {%- if n_fab > 1 -%}
      <div class="ms-lf__tabs" role="tablist" aria-label="{{ s.nav_label | escape }}">
        {%- assign tab_n = 0 -%}
        {%- for b in section.blocks -%}
          {%- if b.type == 'fabric' -%}
            {%- liquid
              assign tab_n = tab_n | plus: 1
              assign start = forloop.index
              assign nc = 0
              for c in section.blocks offset: start
                if c.type == 'fabric'
                  break
                endif
                assign nc = nc | plus: 1
              endfor
              assign anchor = b.settings.anchor | default: b.settings.name | handleize
            -%}
            <a class="ms-lf__tab{% if tab_n == 1 %} is-on{% endif %}" role="tab" id="lf-tab-{{ anchor }}" href="#{{ anchor }}" aria-controls="{{ anchor }}" aria-selected="{% if tab_n == 1 %}true{% else %}false{% endif %}">{{ b.settings.name }}{% if nc > 0 %}<sup>{{ nc }}</sup>{% endif %}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign open = false -%}
    {%- assign fab_n = 0 -%}
    {%- for b in section.blocks -%}
      {%- if b.type == 'fabric' -%}
        {%- if open -%}</ul>{% if no_colours %}{{ none_html }}{% endif %}</div></article>{%- endif -%}
        {%- liquid
          assign open = true
          assign fab_n = fab_n | plus: 1
          assign fs = b.settings
          assign cloth = fs.name
          assign anchor = fs.anchor | default: fs.name | handleize
          assign first = section.blocks[forloop.index]
          assign no_colours = true
          if first and first.type == 'colour'
            assign no_colours = false
          endif
          assign big_color = fs.color
          assign big_img = ''
          assign cap = s.no_palette_caption
          if no_colours
            if fs.image != blank
              assign big_img = fs.image | image_url: width: 900
            elsif fs.image_fallback != blank
              assign big_img = fs.image_fallback | asset_url
            endif
          else
            assign big_color = first.settings.color
            assign cap = first.settings.name
            if first.settings.image != blank
              assign big_img = first.settings.image | image_url: width: 900
            elsif first.settings.large_fallback != blank
              assign big_img = first.settings.large_fallback | asset_url
            endif
          endif
          assign note = s.ask_note | replace: '[cloth]', cloth | replace: '[colour]', cap
          if no_colours
            assign note = s.ask_cloth_note | replace: '[cloth]', cloth
          endif
          capture none_html
            echo '<p class="ms-lf__none">' | append: s.no_palette | append: '</p>'
          endcapture
        -%}
        <article class="ms-lf__fab{% if no_colours %} is-plain{% endif %}{% if fab_n == 1 %} is-on{% endif %}" id="{{ anchor }}" role="tabpanel" aria-labelledby="lf-tab-{{ anchor }}" data-lf data-lf-cloth="{{ cloth | escape }}" {{ b.shopify_attributes }}>
          <figure class="ms-lf__view">
            <div class="ms-lf__big ms-lf__big--{{ fs.texture | default: 'linen' }}{% if big_img != '' %} has-img{% endif %}" data-lf-big role="img" aria-label="{{ cloth | escape }}{% unless no_colours %}, {{ cap | escape }}{% endunless %}"
              style="background-color: {{ big_color }};{% if big_img != '' %} background-image: url({{ big_img }});{% endif %}"></div>
            <figcaption class="ms-lf__cap">
              <span class="ms-lf__capn" data-lf-cname>{{ cap }}</span>
              {%- if s.ask_label != blank -%}
                <a class="ms-lf__ask" href="{% render 'ms-link', to: 'contact' %}" data-ms-enquire data-ms-cta="lp-colour" data-lf-ask data-ms-note="{{ note | escape }}">{% if no_colours %}{{ s.ask_cloth_label }}{% else %}{{ s.ask_label }}{% endif %}</a>
              {%- endif -%}
            </figcaption>
          </figure>
          <div class="ms-lf__body">
            <div class="ms-lf__num">{{ fab_n | prepend: '0' | slice: -2, 2 }}</div>
            <h3 class="ms-lf__name">{{ cloth }}</h3>
            <dl class="ms-lf__facts">
              {%- if fs.code != blank -%}<div><dt>{{ s.code_label }}</dt><dd>{{ fs.code }}</dd></div>{%- endif -%}
              {%- if fs.composition != blank -%}<div><dt>{{ s.comp_label }}</dt><dd>{{ fs.composition }}</dd></div>{%- endif -%}
              {%- if fs.systems != blank -%}<div><dt>{{ s.systems_label }}</dt><dd>{{ fs.systems }}</dd></div>{%- endif -%}
            </dl>
            {%- if fs.text != blank -%}<p class="ms-lf__desc">{{ fs.text }}</p>{%- endif -%}
            <ul class="ms-lf__grid" role="list" aria-label="{{ s.palette_label | escape }}: {{ cloth | escape }}">
      {%- elsif b.type == 'colour' and open -%}
        {%- liquid
          assign cs = b.settings
          assign img_l = ''
          if cs.image != blank
            assign thumb = cs.image | image_url: width: 240
            assign img_l = cs.image | image_url: width: 900
          elsif cs.image_fallback != blank
            assign thumb = cs.image_fallback | asset_url
            if cs.large_fallback != blank
              assign img_l = cs.large_fallback | asset_url
            endif
          else
            assign thumb = ''
          endif
          assign is_first = false
          assign prev_i = forloop.index0 | minus: 1
          if section.blocks[prev_i].type == 'fabric'
            assign is_first = true
          endif
        -%}
              <li {{ b.shopify_attributes }}>
                <button type="button" class="ms-lf__chip{% if is_first %} is-sel{% endif %}" aria-pressed="{{ is_first }}"
                  data-name="{{ cs.name | escape }}" data-color="{{ cs.color }}" data-img="{{ img_l }}">
                  <span class="ms-lf__sw" style="background-color: {{ cs.color }};{% if thumb != '' %} background-image: url({{ thumb }});{% endif %}"></span>
                  <span class="ms-lf__cn">{{ cs.name }}</span>
                </button>
              </li>
      {%- endif -%}
    {%- endfor -%}
    {%- if open -%}</ul>{% if no_colours %}{{ none_html }}{% endif %}</div></article>{%- endif -%}

    {%- if s.footnote != blank -%}<p class="ms-lf__foot">{{ s.footnote }}</p>{%- endif -%}
  </div>
</section>
<style>
  .ms-lf { background: #F4EFE5; color: #17140F; padding: clamp(64px, 8vw, 120px) clamp(16px, 5vw, 80px); }
  .ms-lf__in { max-width: 1320px; margin: 0 auto; }
  .ms-lf__head { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: clamp(20px, 4vw, 80px); align-items: end; }
  .ms-lf__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-lf__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.2vw, 46px); line-height: 1.08; letter-spacing: -.025em; font-weight: 200; margin-top: 16px; max-width: 18ch; }
  .ms-lf__text { font-size: 14.5px; line-height: 1.9; color: #4A443B; max-width: 56ch; }
  .ms-lf__text p { margin: 0; }
  .ms-lf__tabs { display: flex; flex-wrap: wrap; gap: 0 clamp(14px, 2.4vw, 34px); margin-top: clamp(28px, 3.5vw, 48px); border-bottom: 1px solid rgba(23, 20, 15, .16); }
  .ms-site a.ms-lf__tab { position: relative; padding: 14px 0 15px; font-family: Newsreader, Georgia, serif; font-size: clamp(16px, 1.45vw, 20px); font-weight: 300; letter-spacing: -.005em; color: #6E675C; text-decoration: none; transition: color .3s; white-space: nowrap; }
  .ms-site a.ms-lf__tab::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; background: #17140F; transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.22, 1, .36, 1); }
  .ms-site a.ms-lf__tab:hover, .ms-site a.ms-lf__tab.is-on { color: #17140F; }
  .ms-site a.ms-lf__tab.is-on::after { transform: none; }
  .ms-lf__tab sup { font-family: inherit; font-size: 10px; margin-left: 3px; color: #7E623B; }
  .ms-lf__tab:focus-visible { outline: 2px solid #17140F; outline-offset: 4px; }
  .ms-lf__fab { display: grid; grid-template-columns: minmax(220px, 380px) minmax(0, 1fr); gap: clamp(24px, 4.5vw, 72px); align-items: start; padding: clamp(32px, 4vw, 56px) 0; border-bottom: 1px solid rgba(23, 20, 15, .12); scroll-margin-top: 110px; }
  .ms-lf.is-tabbed .ms-lf__fab { border-bottom: 0; padding-bottom: 0; }
  .ms-lf.is-tabbed .ms-lf__fab:not(.is-on) { display: none; }
  .ms-lf.is-tabbed .ms-lf__fab.is-on { animation: msLfPanel .5s cubic-bezier(.22, 1, .36, 1); }
  @keyframes msLfPanel { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .ms-lf__view { margin: 0; }
  .ms-lf__big { position: relative; aspect-ratio: 1; background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgba(23, 20, 15, .14); transition: background-color .5s; overflow: hidden; }
  .ms-lf__big::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: url({{ 'ms-lp-weave.jpg' | asset_url }}) center / cover; mix-blend-mode: overlay; opacity: .75; }
  .ms-lf__big.has-img::after { display: none; }
  .ms-lf__big--wool::after { background-image: url({{ 'ms-lp-wool.jpg' | asset_url }}); opacity: .8; }
  .ms-lf__big--boucle::after { background-image: url({{ 'ms-lp-wool.jpg' | asset_url }}); background-size: 55%; background-repeat: repeat; opacity: .9; }
  .ms-lf__big.is-swap { animation: msLfIn .55s cubic-bezier(.22, 1, .36, 1); }
  @keyframes msLfIn { from { opacity: .4; transform: scale(.985); } to { opacity: 1; transform: none; } }
  .ms-lf__cap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 18px; padding-top: 14px; }
  .ms-lf__capn { font-family: Newsreader, Georgia, serif; font-size: clamp(18px, 1.6vw, 22px); font-weight: 300; letter-spacing: -.01em; }
  .ms-site a.ms-lf__ask { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; text-decoration: none; border-bottom: 1px solid #17140F; padding-bottom: 5px; }
  .ms-site a.ms-lf__ask:hover { opacity: .65; }
  .ms-lf__num { font-size: 11px; letter-spacing: .24em; color: #7E623B; }
  .ms-lf__name { font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 3.2vw, 46px); line-height: 1.02; letter-spacing: -.03em; font-weight: 200; margin-top: 8px; }
  .ms-lf__facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px 24px; margin: clamp(16px, 2vw, 24px) 0 0; padding: 14px 0; border-top: 1px solid rgba(23, 20, 15, .16); border-bottom: 1px solid rgba(23, 20, 15, .16); }
  .ms-lf__facts dt { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: #6E675C; }
  .ms-lf__facts dd { margin: 5px 0 0; font-size: 14px; line-height: 1.55; color: #2E2A24; }
  .ms-site .ms-lf__desc { font-size: 14.5px; line-height: 1.8; color: #4A443B; margin-top: 16px; max-width: 60ch; }
  .ms-lf__grid { list-style: none; margin: clamp(20px, 2.4vw, 28px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(78px, 1fr)); gap: 16px 12px; }
  .ms-lf__grid:empty { display: none; }
  .ms-lf__chip { display: block; width: 100%; font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; text-align: left; }
  .ms-lf__sw { --z: 5px; display: block; aspect-ratio: 3 / 2; background-size: cover; background-position: center;
    -webkit-mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) top / var(--z) 51% repeat-x, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / var(--z) 51% repeat-x;
    mask: conic-gradient(from 135deg at top, #0000, #000 1deg 89deg, #0000 90deg) top / var(--z) 51% repeat-x, conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / var(--z) 51% repeat-x;
    transition: transform .45s cubic-bezier(.22, 1, .36, 1), filter .3s; }
  .ms-lf__chip:hover .ms-lf__sw { transform: translateY(-2px); filter: drop-shadow(0 6px 8px rgba(23, 20, 15, .22)); }
  .ms-lf__cn { display: block; margin-top: 7px; font-size: 9.5px; letter-spacing: .12em; text-transform: uppercase; color: #6E675C; line-height: 1.35; }
  .ms-lf__chip.is-sel .ms-lf__cn { color: #17140F; }
  .ms-lf__chip.is-sel .ms-lf__cn::before { content: ''; display: inline-block; width: 5px; height: 5px; border-radius: 50%; background: #17140F; margin-right: 5px; vertical-align: 2px; }
  .ms-lf__chip:focus-visible { outline: 2px solid #17140F; outline-offset: 4px; }
  .ms-lf__none { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; line-height: 1.6; color: #6E675C; margin-top: 18px; max-width: 46ch; }
  .ms-lf__step { display: flex; justify-content: flex-end; margin-top: clamp(20px, 2.4vw, 30px); }
  .ms-lf__next { font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; background: none; border: 0; border-bottom: 1px solid currentColor; padding: 0 0 5px; cursor: pointer; }
  .ms-lf__next:hover { opacity: .65; }
  .ms-lf__foot { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 15px; color: #6E675C; margin-top: clamp(24px, 3vw, 40px); max-width: 80ch; }
  @media (max-width: 860px) {
    .ms-lf__tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-left: -16px; margin-right: -16px; padding: 0 16px; gap: 0 22px; }
    .ms-lf__tabs::-webkit-scrollbar { display: none; }
    .ms-site a.ms-lf__tab { flex: none; font-size: 16px; }
    .ms-lf__fab { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .ms-lf__big { aspect-ratio: 16 / 9; }
    .ms-lf__grid { grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 14px 9px; }
    .ms-lf__cn { font-size: 8.5px; letter-spacing: .08em; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-lf__big.is-swap, .ms-lf.is-tabbed .ms-lf__fab.is-on { animation: none; } .ms-lf__sw { transition: none; } }
</style>
<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling && document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.matches('[data-ms-lf]')) root = document.querySelector('[data-ms-lf]:not([data-lf-ready])');
    if (!root) return;
    root.setAttribute('data-lf-ready', '');
    var tpl = {{ section.settings.ask_note | json }}, nextTpl = {{ section.settings.next_label | json }};
    var tabs = [].slice.call(root.querySelectorAll('.ms-lf__tab')), fabs = [].slice.call(root.querySelectorAll('[data-lf]'));
    /* one cloth at a time: the row above chooses it, a link to #its-name opens it */
    function open(id, focus) {
      var hit = fabs.filter(function (f) { return f.id === id; })[0];
      if (!hit) return false;
      fabs.forEach(function (f) { f.classList.toggle('is-on', f === hit); });
      tabs.forEach(function (t) { var on = t.getAttribute('aria-controls') === id; t.classList.toggle('is-on', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); t.tabIndex = on ? 0 : -1; if (on && focus) t.focus(); if (on && t.scrollIntoView && t.parentNode.scrollWidth > t.parentNode.clientWidth) t.parentNode.scrollLeft = t.offsetLeft - 16; });
      return true;
    }
    if (tabs.length > 1) {
      root.classList.add('is-tabbed');
      fabs.forEach(function (f, i) {
        var nx = fabs[(i + 1) % fabs.length], w = document.createElement('div');
        w.className = 'ms-lf__step';
        w.innerHTML = '<button type="button" class="ms-lf__next"></button>';
        w.firstChild.textContent = (nextTpl || 'Next: [cloth]').replace('[cloth]', nx.getAttribute('data-lf-cloth')) + ' →';
        w.firstChild.addEventListener('click', function () { open(nx.id); history.replaceState(null, '', '#' + nx.id); root.querySelector('.ms-lf__tabs').scrollIntoView({ behavior: 'smooth', block: 'nearest' }); });
        f.querySelector('.ms-lf__body').appendChild(w);
      });
      tabs.forEach(function (t, i) {
        t.tabIndex = t.classList.contains('is-on') ? 0 : -1;
        t.addEventListener('click', function (e) { e.preventDefault(); var id = t.getAttribute('aria-controls'); open(id); history.replaceState(null, '', '#' + id); });
        t.addEventListener('keydown', function (e) {
          var k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
          if (!k) return; e.preventDefault();
          var n = tabs[(i + k + tabs.length) % tabs.length]; open(n.getAttribute('aria-controls'), true);
        });
      });
      var fromHash = function () { var id = decodeURIComponent((location.hash || '').slice(1)); if (id && open(id)) root.scrollIntoView({ block: 'start' }); };
      fromHash();
      window.addEventListener('hashchange', fromHash);
    }
    root.addEventListener('click', function (e) {
      var c = e.target.closest('.ms-lf__chip');
      if (!c) return;
      var fab = c.closest('[data-lf]'), big = fab.querySelector('[data-lf-big]'), nm = fab.querySelector('[data-lf-cname]'), ask = fab.querySelector('[data-lf-ask]');
      fab.querySelectorAll('.ms-lf__chip.is-sel').forEach(function (x) { x.classList.remove('is-sel'); x.setAttribute('aria-pressed', 'false'); });
      c.classList.add('is-sel'); c.setAttribute('aria-pressed', 'true');
      var img = c.getAttribute('data-img'), name = c.getAttribute('data-name');
      big.style.backgroundColor = c.getAttribute('data-color');
      big.style.backgroundImage = img ? 'url(' + img + ')' : 'none';
      big.classList.toggle('has-img', !!img);
      big.setAttribute('aria-label', fab.getAttribute('data-lf-cloth') + ', ' + name);
      big.classList.remove('is-swap'); void big.offsetWidth; big.classList.add('is-swap');
      nm.textContent = name;
      if (ask && tpl) ask.setAttribute('data-ms-note', tpl.replace('[cloth]', fab.getAttribute('data-lf-cloth')).replace('[colour]', name));
      if (window.matchMedia('(max-width: 860px)').matches && big.getBoundingClientRect().top < 0) big.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>
{% schema %}
{
  "name": "Loro Piana cloths",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links to this part)", "default": "fabrics" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "The cloths" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "The cloths our systems are made in." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "nav_label", "label": "Cloth list name (for screen readers)", "default": "The cloths" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "code_label", "label": "Article", "default": "Article" },
    { "type": "text", "id": "comp_label", "label": "Composition", "default": "Composition" },
    { "type": "text", "id": "systems_label", "label": "Systems", "default": "On our systems" },
    { "type": "text", "id": "palette_label", "label": "Palette", "default": "Palette" },
    { "type": "text", "id": "no_palette", "label": "When a cloth has no colours listed", "default": "Its colours are at the atelier, to be chosen against the bed." },
    { "type": "text", "id": "no_palette_caption", "label": "Caption when a cloth has no colours listed", "default": "Colours at the atelier" },
    { "type": "header", "content": "Enquiry" },
    { "type": "text", "id": "ask_label", "label": "Ask about a colour", "default": "Ask about this colour" },
    { "type": "text", "id": "ask_note", "label": "Message it starts", "info": "[cloth] and [colour] become the cloth's and the colour's names.", "default": "I would like to see Loro Piana Interiors [cloth] in [colour]." },
    { "type": "text", "id": "next_label", "label": "Next cloth", "info": "[cloth] becomes the next cloth's name.", "default": "Next: [cloth]" },
    { "type": "text", "id": "ask_cloth_label", "label": "Ask about a cloth without colours", "default": "Ask to see it" },
    { "type": "text", "id": "ask_cloth_note", "label": "Message it starts (cloth)", "info": "[cloth] becomes the cloth's name.", "default": "I would like to see the colours of Loro Piana Interiors [cloth]." },
    { "type": "text", "id": "footnote", "label": "Footnote" }
  ],
  "blocks": [
    {
      "type": "fabric",
      "name": "Cloth",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Cloth" },
        { "type": "text", "id": "anchor", "label": "Anchor", "info": "Product pages link here, as #mystic-river. Empty: made from the name." },
        { "type": "text", "id": "code", "label": "Article" },
        { "type": "text", "id": "composition", "label": "Composition" },
        { "type": "text", "id": "systems", "label": "On our systems" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "select", "id": "texture", "label": "Weave, when only a colour is shown", "default": "linen", "options": [
          { "value": "linen", "label": "Linen" }, { "value": "wool", "label": "Wool" }, { "value": "boucle", "label": "Bouclé" }
        ] },
        { "type": "color", "id": "color", "label": "Colour, when it has no colours listed", "default": "#D9CDBE" },
        { "type": "image_picker", "id": "image", "label": "Photograph, when it has no colours listed" },
        { "type": "text", "id": "image_fallback", "label": "Theme photograph (file name)" }
      ]
    },
    {
      "type": "colour",
      "name": "Colour",
