<style>.ms-card__img { position: relative; display: block; overflow: hidden; } .ms-site img.ms-card__alt { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease, transform 1.4s cubic-bezier(.2,.7,.2,1); transform: scale(1.03); } @media (hover: hover) { a:hover > .ms-card__img img.ms-card__alt { opacity: 1; transform: none; } }</style><section style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 150px); max-width: 1560px; margin: 0px auto;">
<div style="display: flex; gap: 8px; flex-wrap: wrap; border-top: 1px solid rgb(221, 214, 201); padding-top: 22px; margin-bottom: clamp(32px, 4vw, 60px);">
{%- for h in (1..3) -%}
  {%- case h -%}{%- when 1 -%}{%- assign k = 'essentials' -%}{%- assign l = section.settings.tab1 -%}{%- when 2 -%}{%- assign k = 'signature' -%}{%- assign l = section.settings.tab2 -%}{%- else -%}{%- assign k = 'icons' -%}{%- assign l = section.settings.tab3 -%}{%- endcase -%}
  {%- assign kh = collection.handle -%}{%- if kh == 'icon' -%}{%- assign kh = 'icons' -%}{%- endif -%}<a href="{% render 'ms-link', to: k %}" style="{% if kh == k %}padding: 14px 20px; font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer; background: rgb(23, 20, 15); color: rgb(251, 249, 245); border: 1px solid rgb(23, 20, 15); display: inline-block;{% else %}padding: 14px 20px; font-size: 10.5px; letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer; background: transparent; color: rgb(74, 68, 59); border: 1px solid rgb(221, 214, 201); display: inline-block;{% endif %}"{% if collection.handle == k %} aria-current="page"{% endif %}>{{ l }}</a>
{%- endfor -%}
</div>
{%- paginate collection.products by 48 -%}
<div data-ms="prodgrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(20px, 3vw, 56px) clamp(16px, 2.4vw, 36px);">
{%- for product in collection.products -%}
  {%- capture note -%}{% render 'ms-product-note', title: product.title %}{%- endcapture -%}
  {%- assign sub = product.metafields.custom.subtitle.value | default: note -%}
  <a href="{{ product.url }}" style="display: block;">
    {%- if product.featured_media -%}
      <span class="ms-card__img">
      <img alt="{{ product.featured_media.alt | default: product.title | escape }}" src="{{ product.featured_media | image_url: width: 1000 }}" srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 1000 }} 1000w" sizes="(max-width: 760px) 50vw, 33vw" loading="{% if forloop.index > 3 %}lazy{% else %}eager{% endif %}" width="1000" height="1333" style="width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; display: block;">
      {%- assign alt_media = product.media[1] -%}
      {%- if alt_media and alt_media.media_type == 'image' -%}<img class="ms-card__alt" alt="" src="{{ alt_media | image_url: width: 1000 }}" loading="lazy" width="1000" height="1333">{%- endif -%}
      </span>
    {%- else -%}
      <span style="display: block; width: 100%; aspect-ratio: 3 / 4; background: rgb(241, 236, 227);"></span>
    {%- endif -%}
    <h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 26px); margin-top: 18px;">{{ product.title }}</h2>
    {%- if sub != blank -%}<p style="font-size: 13.5px; line-height: 1.8; color: rgb(110, 103, 92); margin-top: 6px; max-width: 36ch;">{{ sub }}</p>{%- endif -%}
    {%- if settings.ms_show_prices -%}<p style="font-size: 12.5px; letter-spacing: 0.08em; color: rgb(110, 103, 92); margin-top: 6px;">{{ product.price | money }}</p>{%- endif -%}
  </a>
{%- else -%}
  <p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59);">{{ section.settings.empty }}</p>
{%- endfor -%}
</div>
{%- if paginate.pages > 1 -%}
<nav style="display: flex; gap: 22px; justify-content: center; margin-top: clamp(40px, 5vw, 72px); font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase;">
  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← Previous</a>{%- endif -%}
  <span style="color: rgb(110, 103, 92);">{{ paginate.current_page }} / {{ paginate.pages }}</span>
  {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
</nav>
{%- endif -%}
{%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Collection · Systems",
  "settings": [
    { "type": "text", "id": "tab1", "label": "First collection", "default": "Essentials" },
    { "type": "text", "id": "tab2", "label": "Second collection", "default": "Signature" },
    { "type": "text", "id": "tab3", "label": "Third collection", "default": "Icons" },
    { "type": "text", "id": "empty", "label": "When empty", "default": "The systems in this collection are shown at the atelier. Ask us for the catalogue." }
  ]
}
{% endschema %}
