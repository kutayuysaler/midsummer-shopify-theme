{%- comment -%}
  A full-bleed opening: a photograph or film with the page's words over it, drawn like
  the home and collection openings of the preview.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if section.settings.use_page_title
    if page.title != blank
      assign heading = page.title
    elsif article.title != blank
      assign heading = article.title
    elsif blog.title != blank
      assign heading = blog.title
    endif
  endif
  case section.settings.height
    when 'full'
      assign h = 'height: 100vh; height: 100svh; min-height: 560px;'
    when 'tall'
      assign h = 'height: min(82vh, 820px); min-height: 520px;'
    else
      assign h = 'height: min(66vh, 640px); min-height: 440px;'
  endcase
  assign href = section.settings.link | default: '#'
  if section.settings.product_handle != blank
    assign ph = section.settings.product_handle | strip
    if all_products[ph].url != blank
      assign href = all_products[ph].url
    endif
  endif
  assign has_video = false
  if section.settings.video != blank or section.settings.video_url != blank
    assign has_video = true
  endif
-%}
<section class="ms-bn ms-bn--{{ section.settings.align }}" style="{{ h }}">
  {%- if has_video -%}
    <video class="ms-bn__media" autoplay muted loop playsinline preload="metadata"
      poster="{% render 'ms-img', image: section.settings.image, fallback: section.settings.image_fallback, width: 2400 %}"
      src="{% if section.settings.video != blank %}{{ section.settings.video.sources | where: 'format', 'mp4' | map: 'url' | first }}{% else %}{{ section.settings.video_url }}{% endif %}"></video>
  {%- else -%}
    <img class="ms-bn__media" src="{% render 'ms-img', image: section.settings.image, fallback: section.settings.image_fallback, width: 2400 %}"
      alt="{{ section.settings.image.alt | default: heading | escape }}" width="2400" height="1350" fetchpriority="high"
      style="object-position: {{ section.settings.focus }};">
  {%- endif -%}
  <div class="ms-bn__veil" style="opacity: {{ section.settings.veil | divided_by: 100.0 }};"></div>
  <div class="ms-bn__copy">
    <div class="ms-bn__in">
      {%- if section.settings.eyebrow != blank -%}<div class="ms-bn__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if heading != blank -%}<h1 class="ms-bn__title">{{ heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="ms-bn__text">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button != blank -%}
        <a class="ms-bn__button"
          href="{% if section.settings.enquire %}{% render 'ms-link', to: 'contact' %}{% else %}{{ href }}{% endif %}"
          {% if section.settings.enquire %}data-ms-enquire{% endif %}
          {% if section.settings.new_tab %}target="_blank" rel="noopener"{% endif %}>
          {{ section.settings.button }}
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.1"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if section.settings.overlay_header -%}
<script>
  (function () {
    var sec = document.currentScript.previousElementSibling;
    var wrap = sec && sec.closest('.shopify-section');
    var main = document.getElementById('MainContent');
    if (!wrap || !main) return;
    var first = main.querySelector('.shopify-section');
    if (first === wrap) document.body.classList.add('ms-overlay');
  })();
</script>
{%- endif -%}
<style>
  .ms-bn { position: relative; overflow: hidden; background: #17140F; color: #FBF9F5; }
  .ms-bn__media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ms-bn__veil { position: absolute; inset: 0; background: linear-gradient(rgba(10, 8, 6, .28) 0%, rgba(10, 8, 6, .04) 34%, rgba(10, 8, 6, .5) 68%, rgba(10, 8, 6, .72) 100%); }
  .ms-bn__copy { position: absolute; inset: 0; display: flex; align-items: flex-end; padding: calc(78px + clamp(26px, 4.5vw, 72px)) clamp(26px, 4.5vw, 72px) clamp(30px, 5vw, 88px); }
  .ms-bn__in { width: 100%; max-width: 1560px; margin: 0 auto; }
  .ms-bn--center .ms-bn__copy { align-items: center; text-align: center; }
  .ms-bn--center .ms-bn__in > * { margin-left: auto; margin-right: auto; }
  .ms-bn__eyebrow { font-size: 11px; line-height: 1.9; letter-spacing: .3em; text-transform: uppercase; opacity: .9; text-shadow: 0 1px 12px rgba(10, 8, 6, .35); }
  .ms-bn__title { font-family: Newsreader, Georgia, serif; font-size: clamp(40px, 6.4vw, 96px); line-height: 1; letter-spacing: -.035em; font-weight: 200; margin-top: clamp(18px, 1.8vw, 26px); max-width: 16ch; }
  .ms-bn__text { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(17px, 1.8vw, 22px); line-height: 1.55; max-width: 44ch; margin-top: 22px; opacity: .95; }
  .ms-site .ms-bn__button { display: inline-flex; align-items: center; gap: 16px; min-height: 54px; padding: 0 28px; margin-top: 30px; background: #FBF9F5; color: #17140F; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; transition: background .25s ease; }
  .ms-site .ms-bn__button:hover { background: #FFFFFF; color: #17140F; }
</style>
{% schema %}
{
  "name": "Opening photograph",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_fallback", "label": "Photograph address", "info": "Used when no photograph is picked: a full address, or a file in the theme's assets." },
    { "type": "video", "id": "video", "label": "Film (optional)" },
    { "type": "text", "id": "video_url", "label": "Film address (optional)" },
    { "type": "select", "id": "focus", "label": "Photograph focus", "default": "center", "options": [ { "value": "center", "label": "Centre" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "select", "id": "height", "label": "Height", "default": "tall", "options": [ { "value": "full", "label": "Full screen" }, { "value": "tall", "label": "Tall" }, { "value": "medium", "label": "Medium" } ] },
    { "type": "range", "id": "veil", "label": "Shade over the photograph", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "overlay_header", "label": "Clear header over the photograph", "info": "When this is the first section on the page.", "default": true },
    { "type": "select", "id": "align", "label": "Words", "default": "left", "options": [ { "value": "left", "label": "Bottom left" }, { "value": "center", "label": "Centred" } ] },
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "checkbox", "id": "use_page_title", "label": "Use the page's title as the heading", "default": false },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Midsummer Milano" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "text", "id": "product_handle", "label": "Or a product's handle", "info": "The button goes to that product when it exists." },
    { "type": "checkbox", "id": "enquire", "label": "Button opens the enquiry", "default": false },
    { "type": "checkbox", "id": "new_tab", "label": "Open the link in a new tab", "default": false }
  ],
  "presets": [ { "name": "Opening photograph" } ]
}
{% endschema %}
