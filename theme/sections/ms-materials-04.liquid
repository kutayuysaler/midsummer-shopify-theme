{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,facts,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'materials' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="960" style="position: relative; overflow: hidden;">
<img width="1600" height="1000" alt="" data-ms="band" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-horse.jpg' | asset_url }}{% endif %}" style="width: 100%; height: min(64vh, 600px); object-fit: cover;"/>
<div style="position: absolute; inset: 0px; background: rgba(10, 8, 6, 0.42);"></div>
<div style="position: absolute; inset: 0px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 22px; padding: clamp(26px, 5vw, 80px); color: rgb(251, 249, 245);">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 4vw, 56px); line-height: 1.06; letter-spacing: -0.025em; max-width: 20ch;">{{ section.settings.t1 }}</h2>
<p style="font-size: 15px; line-height: 1.9; opacity: 0.9; max-width: 50ch;">{{ section.settings.t2 }}</p>
<a data-ms="cta" data-ms-quiz-link="" href="{% render 'ms-link', to: 'quiz' %}" style="color: rgb(251, 249, 245); font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgba(251, 249, 245, 0.5); padding-bottom: 8px;">{{ section.settings.t3 }}</a>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Materials 04 · Not sure w",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Not sure which fibre suits you?",
      "default": "Not sure which fibre suits you?"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Five questions on how and where yo…",
      "default": "Five questions on how and where you sleep, and we will tell you which fibres we would build with."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Find your Midsummer",
      "default": "Find your Midsummer"
    }
  ]
}
{% endschema %}
