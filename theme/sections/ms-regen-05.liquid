{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'regen' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="1017" style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 150px); max-width: 1560px; margin: 0px auto;">
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: clamp(32px, 5vw, 64px); display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(28px, 5vw, 80px);">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 42px); line-height: 1.08; letter-spacing: -0.02em; margin-top: 16px;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 20px; max-width: 50ch;">{{ section.settings.t3 }}</p>
<div style="margin-top: 30px;"><a data-ms="cta" data-ms-enquire="" href="{% render 'ms-link', to: 'contact' %}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 7px;">{{ section.settings.t4 }}</a></div>
</div>
<div style="padding-top: 6px;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(126, 98, 59);">{{ section.settings.t5 }}</div>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 14px; max-width: 46ch;">{{ section.settings.t6 }}</p>
<p style="font-family: Newsreader, Georgia, serif; font-size: 17px; font-style: italic; color: rgb(110, 103, 92); margin-top: 22px;">{{ section.settings.t7 }}</p>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "15 + 15 05 · For our clie",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "For our clients",
      "default": "For our clients"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Bring your mattress home.",
      "default": "Bring your mattress home."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "If you own a Midsummer mattress an…",
      "default": "If you own a Midsummer mattress and fifteen years have passed, please write to us. We will arrange the collection of your mattress and oversee its regeneration with our Italian artisans."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Contact the atelier",
      "default": "Contact the atelier"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Green Product Award 2025",
      "default": "Green Product Award 2025"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "Our commitment to genuine sustaina…",
      "default": "Our commitment to genuine sustainability in luxury mattress making has been recognised internationally."
    },
    {
      "type": "text",
      "id": "t7",
      "label": "Atelier and showroom — Via Andegar…",
      "default": "Atelier and showroom — Via Andegari 4, Milano"
    }
  ]
}
{% endschema %}
