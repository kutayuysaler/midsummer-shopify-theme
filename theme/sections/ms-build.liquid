{%- comment -%}
  Midsummer Milano — the build, drawn in section.
  Each "layer" block is a band whose height is its real depth, so the drawing
  is the specification rather than an illustration. Selecting a band shows its
  note. Works without JavaScript: the first band's note is rendered open.
{%- endcomment -%}

{%- liquid
  assign layers = section.blocks | where: 'type', 'layer'
  assign total = 0
  for l in layers
    assign d = l.settings.depth | times: 1
    assign total = total | plus: d
  endfor
-%}

{%- if layers.size > 0 -%}
<div class="ms-build" id="ms-build-{{ section.id }}" data-ms-build>
  <div class="ms-build__drawing">
    <div class="ms-build__head">
      <span class="ms-build__eyebrow">{{ section.settings.eyebrow }}</span>
      <span class="ms-build__total">{{ total }}{{ section.settings.unit }}</span>
    </div>

    {%- liquid
      assign scale = section.settings.scale
      assign stack_h = total | times: scale
      assign cursor = 0
    -%}
    <div class="ms-build__stack" style="height: {{ stack_h }}px;">
      {%- for l in layers -%}
        {%- liquid
          assign depth = l.settings.depth | times: 1
          assign band_h = depth | times: scale
          assign band_y = cursor | times: scale
          assign mid = band_h | divided_by: 2.0 | plus: band_y
          assign cursor = cursor | plus: depth
        -%}
        <button
          type="button"
          class="ms-build__band{% if forloop.first %} is-on{% endif %}{% if forloop.last %} is-last{% endif %}"
          style="top: {{ band_y }}px; height: {{ band_h }}px;"
          data-ms-band="{{ forloop.index0 }}"
          aria-label="{{ l.settings.name | escape }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
          {{ l.shopify_attributes }}
        ></button>
        <button
          type="button"
          class="ms-build__label{% if forloop.first %} is-on{% endif %}"
          style="top: {{ mid }}px;"
          data-ms-band="{{ forloop.index0 }}"
          tabindex="-1"
        >
          <span class="ms-build__leader" aria-hidden="true"></span>
          <span class="ms-build__name">{{ l.settings.name }}</span>
          <span class="ms-build__depth">{{ l.settings.depth }}{{ section.settings.unit }}</span>
        </button>
      {%- endfor -%}
    </div>

    {%- if section.settings.hint != blank -%}
      <p class="ms-build__hint">{{ section.settings.hint }}</p>
    {%- endif -%}
  </div>

  <div class="ms-build__detail">
    {%- for l in layers -%}
      <div class="ms-build__note{% if forloop.first %} is-on{% endif %}" data-ms-note="{{ forloop.index0 }}">
        {%- if l.settings.group != blank -%}
          <span class="ms-build__group">{{ l.settings.group }}</span>
        {%- endif -%}
        <h3 class="ms-build__title">{{ l.settings.name }}</h3>
        {%- if l.settings.note != blank -%}
          <p class="ms-build__text">{{ l.settings.note }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.querySelector('#ms-build-{{ section.id }}');
    if (!root || root.dataset.msReady) return;
    root.dataset.msReady = '1';

    var bands = root.querySelectorAll('[data-ms-band]');
    var notes = root.querySelectorAll('[data-ms-note]');

    function show(i) {
      bands.forEach(function (b) {
        var on = b.dataset.msBand === i;
        b.classList.toggle('is-on', on);
        if (b.hasAttribute('aria-pressed')) b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      notes.forEach(function (n) { n.classList.toggle('is-on', n.dataset.msNote === i); });
    }

    bands.forEach(function (b) {
      b.addEventListener('click', function () { show(b.dataset.msBand); });
      b.addEventListener('mouseenter', function () { show(b.dataset.msBand); });
    });
  })();
</script>

{% stylesheet %}
  .ms-build {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(34px, 5vw, 96px);
    align-items: start;
    max-width: var(--ms-build-max);
    margin-inline: auto;
    padding-inline: clamp(18px, 5vw, 80px);
  }
  .ms-build__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid var(--ms-build-rule);
    padding-bottom: 13px;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-build-muted);
  }
  .ms-build__total { color: var(--ms-build-faint); }
  /* A drafting section: each band is its true depth, with the names in a
     gutter joined by leader rules, so a 1 cm layer stays 1 cm. */
  .ms-build__stack { position: relative; margin-top: 6px; }
  .ms-build__band {
    position: absolute;
    left: 0;
    width: min(46%, 320px);
    background: var(--ms-build-band);
    border: 0;
    border-top: 1px solid var(--ms-build-band-rule);
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    transition: background 0.25s ease;
  }
  .ms-build__band:nth-of-type(even) { background: var(--ms-build-band-alt); }
  .ms-build__band.is-last { border-bottom: 1px solid var(--ms-build-band-rule); }
  .ms-build__band.is-on {
    background: var(--ms-build-ink);
    border-top-color: var(--ms-build-ink);
  }
  .ms-build__label {
    position: absolute;
    left: min(46%, 320px);
    width: calc(100% - min(46%, 320px));
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    color: var(--ms-build-muted);
    transition: color 0.25s ease;
  }
  .ms-build__label.is-on { color: var(--ms-build-ink); }
  .ms-build__leader {
    flex: 0 0 auto;
    width: clamp(14px, 3vw, 34px);
    height: 1px;
    background: var(--ms-build-band-rule);
    transition: background 0.25s ease;
  }
  .ms-build__label.is-on .ms-build__leader { background: var(--ms-build-ink); }
  .ms-build__name {
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 1.45vw, 17px);
    line-height: 1.2;
    white-space: nowrap;
  }
  /* the depths ARE the specification — they read at rest, not on hover */
  .ms-build__depth {
    margin-left: auto;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    color: var(--ms-build-muted);
  }
  .ms-build__label.is-on .ms-build__depth { color: var(--ms-build-accent); }
  .ms-build__hint {
    margin: 14px 0 0;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-build-muted);
  }
  .ms-build__detail { position: sticky; top: var(--ms-build-sticky); }
  .ms-build__note { display: none; border-top: 1px solid var(--ms-build-ink); padding-top: 20px; }
  .ms-build__note.is-on { display: block; }
  .ms-build__group {
    display: block;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-build-accent);
  }
  .ms-build__title {
    margin: 14px 0 0;
    font-family: var(--font-heading-family);
    font-weight: 200;
    font-size: clamp(25px, 3.2vw, 42px);
    line-height: 1.1;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }
  .ms-build__text {
    margin: 18px 0 0;
    font-size: 15px;
    line-height: 1.95;
    color: var(--ms-build-body);
    max-width: 50ch;
  }
  @media screen and (max-width: 700px) {
    .ms-build { gap: clamp(22px, 4vw, 36px); }
    .ms-build__band { width: 100%; }
    .ms-build__label { display: none; }
    .ms-build__detail { position: static; }
  }
{% endstylesheet %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  }
  #ms-build-{{ section.id }} {
    --ms-build-bg: {{ section.settings.background_color }};
    --ms-build-ink: {{ section.settings.ink_color }};
    --ms-build-body: {{ section.settings.body_color }};
    --ms-build-muted: {{ section.settings.muted_color }};
    --ms-build-faint: {{ section.settings.faint_color }};
    --ms-build-accent: {{ section.settings.accent_color }};
    --ms-build-rule: {{ section.settings.rule_color }};
    --ms-build-band: {{ section.settings.band_color }};
    --ms-build-band-alt: {{ section.settings.band_alt_color }};
    --ms-build-band-rule: {{ section.settings.band_rule_color }};
    --ms-build-max: {{ section.settings.max_width }}px;
    --ms-build-sticky: {{ section.settings.sticky_offset }}px;
  }
{%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "The build, in section",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Each layer is drawn to its real depth. Enter depths as plain numbers in the same unit." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The build, in section" },
    { "type": "text", "id": "unit", "label": "Unit", "default": " cm" },
    { "type": "range", "id": "scale", "label": "Pixels per unit", "info": "How tall one unit of depth is drawn. Raise it if the names crowd each other.", "min": 6, "max": 26, "step": 1, "default": 13 },
    { "type": "text", "id": "hint", "label": "Hint under the drawing", "default": "Drawn to scale. Select a layer." },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1800, "step": 20, "unit": "px", "default": 1560 },
    { "type": "range", "id": "sticky_offset", "label": "Sticky offset", "info": "Clears the header when the note column pins.", "min": 0, "max": 240, "step": 10, "unit": "px", "default": 150 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "ink_color", "label": "Ink", "default": "#17140F" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#4A443B" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6E675C" },
    { "type": "color", "id": "faint_color", "label": "Faint text", "info": "Non-informational marks only — rules and hints.", "default": "#B8AF9E" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#7E623B" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#DDD6C9" },
    { "type": "color", "id": "band_color", "label": "Band", "default": "#F4EFE5" },
    { "type": "color", "id": "band_alt_color", "label": "Band, alternate", "default": "#EFE9DD" },
    { "type": "color", "id": "band_rule_color", "label": "Band rule", "default": "#E2DACA" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "layer",
      "name": "Layer",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Pocket spring core" },
        { "type": "text", "id": "depth", "label": "Depth", "info": "A plain number.", "default": "11" },
        { "type": "text", "id": "group", "label": "Group", "info": "Shown above the name, e.g. Mattress.", "default": "Mattress" },
        { "type": "textarea", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "The build, in section",
      "blocks": [
        { "type": "layer" },
        { "type": "layer" },
        { "type": "layer" }
      ]
    }
  ]
}
{% endschema %}
