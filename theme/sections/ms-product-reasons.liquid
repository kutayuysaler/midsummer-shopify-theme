<script type="application/json" data-ms-sizes-data>[[{{ section.settings.s1_w | json }}, {{ section.settings.s1_l | json }}], [{{ section.settings.s2_w | json }}, {{ section.settings.s2_l | json }}], [{{ section.settings.s3_w | json }}, {{ section.settings.s3_l | json }}], [{{ section.settings.s4_w | json }}, {{ section.settings.s4_l | json }}], [{{ section.settings.s5_w | json }}, {{ section.settings.s5_l | json }}], [{{ section.settings.s6_w | json }}, {{ section.settings.s6_l | json }}]]</script>
<script>
(function () {
  var root = document.currentScript.previousElementSibling.previousElementSibling;
  var dims = JSON.parse(document.currentScript.previousElementSibling.textContent);
  var chips = root.querySelectorAll('[data-ms-size]');
  function pick(i) {
    chips.forEach(function (c, k) { var on = k === i; c.style.borderBottomColor = on ? '#17140F' : 'transparent'; c.style.color = on ? '#17140F' : '#6E675C'; });
    var d = dims[i] || [160, 200];
    var p = root.querySelector('[data-ms-plan]');
    if (p) { p.style.width = Math.round(d[0] * 0.46) + 'px'; p.style.height = Math.round(d[1] * 0.46) + 'px'; }
    var nm = root.querySelector('[data-ms-size-name]'); if (nm && chips[i]) nm.textContent = chips[i].textContent;
    var fg = root.querySelector('[data-ms-size-figure]'); if (fg) fg.textContent = d[0] + ' × ' + d[1] + ' cm';
  }
  chips.forEach(function (c, k) { c.addEventListener('click', function () { pick(k); }); });
  var start = 0; chips.forEach(function (c, k) { if (c.textContent.trim() === 'Small Double') start = k; });
  pick(start);
})();
</script>
<style>
  .ms-plan { position: relative; display: block; flex: 0 0 auto; box-sizing: border-box; border: 1px solid #17140F; background: linear-gradient(#FBF9F5 0 27%, rgba(23, 20, 15, .55) 27% calc(27% + 1px), #EFE7D9 calc(27% + 1px)); transition: width .35s cubic-bezier(.2,.7,.2,1), height .35s cubic-bezier(.2,.7,.2,1); }
  .ms-plan::before, .ms-plan::after { content: ''; position: absolute; top: 6%; height: 14%; width: 36%; border: 1px solid rgba(23, 20, 15, .5); border-radius: 3px; background: #FBF9F5; }
  .ms-plan::before { left: 9%; }
  .ms-plan::after { right: 9%; }
</style>
