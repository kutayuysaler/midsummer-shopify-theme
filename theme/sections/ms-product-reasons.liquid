{%- liquid
  assign rs_show = true
  if template.name == 'product' and product != blank
    capture rk
      render 'ms-kind', p: product
    endcapture
    assign rkp = rk | split: '|'
    if rkp[0] == 'outdoor' or rkp[0] == 'other'
      assign rs_show = false
    endif
  endif
-%}
{%- if rs_show -%}
<section data-dc-tpl="764" style="padding: clamp(40px, 5vw, 84px) clamp(18px, 5vw, 80px) clamp(56px, 6vw, 96px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(32px, 5vw, 88px); align-items: start;">
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 22px;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(126, 98, 59);">{{ section.settings.t1 }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.3vw, 29px); line-height: 1.16; letter-spacing: -0.02em; font-weight: 200; margin-top: 14px; max-width: 20ch;">{{ section.settings.t2 }}</h3>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 16px; max-width: 34ch;">{{ section.settings.t3 }}</p>
<div data-ms="sizes" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; margin-top: 24px;">
<button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t4 }}</button>
<button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t5 }}</button>
<button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t6 }}</button>
<button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t7 }}</button>
<button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t8 }}</button><button data-ms-size="" style="background: none; border-width: 0px 0px 1px; border-top-style: initial; border-right-style: initial; border-bottom-style: solid; border-left-style: initial; border-top-color: initial; border-right-color: initial; border-bottom-color: transparent; border-left-color: initial; border-image: initial; padding: 14px 0px 6px; cursor: pointer; font-family: Newsreader, Georgia, serif; font-size: clamp(14px, 1.4vw, 17px); line-height: 1.3; white-space: nowrap; color: rgb(110, 103, 92); transition: color 0.2s, border-color 0.2s;" type="button">{{ section.settings.t9 }}</button>
</div>
<div class="ms-sz" data-ms-sz>
    <svg class="ms-sz__svg" viewBox="0 0 250 192" aria-hidden="true" focusable="false">
    <defs><pattern id="ms-sz-floor-{{ section.id }}" width="12" height="12" patternUnits="userSpaceOnUse"><path d="M12 0H0V12" fill="none" stroke="rgba(126,98,59,.11)" stroke-width=".6"/></pattern></defs>
    <rect x="0" y="0" width="250" height="192" fill="url(#ms-sz-floor-{{ section.id }})"/>
    <rect class="ms-sz__ref" data-sz-ref x="0" y="0" width="0" height="0"/>
    <g data-sz-bed><rect class="ms-sz__bed" data-sz-rect x="0" y="0" width="0" height="0" rx="2"/><path class="ms-sz__turn" data-sz-turn d=""/><rect class="ms-sz__pil" data-sz-p1 x="0" y="0" width="0" height="0" rx="3"/><rect class="ms-sz__pil" data-sz-p2 x="0" y="0" width="0" height="0" rx="3"/></g>
    <g class="ms-sz__dim"><path data-sz-dw d=""/><path data-sz-dl d=""/><text data-sz-tw x="0" y="0" text-anchor="middle"></text><text data-sz-tl x="0" y="0" text-anchor="middle"></text></g>
    </svg>
    <div class="ms-sz__txt"><span data-ms-size-name class="ms-sz__name"></span><span data-ms-size-figure class="ms-sz__fig"></span></div>
    </div>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 22px;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(126, 98, 59);">{{ section.settings.t11 }}</div>
{%- capture ms_cloth -%}{%- if template.name == 'product' -%}{%- capture mk -%}{% render 'ms-kind', p: product %}{%- endcapture -%}{%- assign mkp = mk | split: '|' -%}{% render 'ms-product-cloth', key: mkp[1], handle: '', part: 'reason' %}{%- endif -%}{%- endcapture -%}
{%- if ms_cloth != blank -%}{{ ms_cloth }}{%- else -%}
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.3vw, 29px); line-height: 1.16; letter-spacing: -0.02em; font-weight: 200; margin-top: 14px; max-width: 20ch;">{{ section.settings.t12 }}</h3>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 16px; max-width: 34ch;">{{ section.settings.t13 }}</p>
{%- endif -%}
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 22px;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(126, 98, 59);">{{ section.settings.t14 }}</div>
<h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.3vw, 29px); line-height: 1.16; letter-spacing: -0.02em; font-weight: 200; margin-top: 14px; max-width: 20ch;">{{ section.settings.t15 }}</h3>
<p style="font-size: 14.5px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 16px; max-width: 34ch;">{{ section.settings.t16 }}</p>
<a data-ms="cta" href="{% render 'ms-link', to: 'regen' %}" style="display: inline-block; margin-top: 24px; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 7px;">{{ section.settings.t17 }}</a>
</div>
</div>
</section>
<script type="application/json" data-ms-sizes-data>[[{{ section.settings.s1_w | json }}, {{ section.settings.s1_l | json }}], [{{ section.settings.s2_w | json }}, {{ section.settings.s2_l | json }}], [{{ section.settings.s3_w | json }}, {{ section.settings.s3_l | json }}], [{{ section.settings.s4_w | json }}, {{ section.settings.s4_l | json }}], [{{ section.settings.s5_w | json }}, {{ section.settings.s5_l | json }}], [{{ section.settings.s6_w | json }}, {{ section.settings.s6_l | json }}]]</script>
<script>
(function () {
  var root = document.currentScript.previousElementSibling.previousElementSibling;
  var dims = JSON.parse(document.currentScript.previousElementSibling.textContent);
  var chips = root.querySelectorAll('[data-ms-size]');
  var sz = root.querySelector('[data-ms-sz]'), cur = null, raf = 0;
      var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
      var big = dims.reduce(function (m, d) { return [Math.max(m[0], +d[0] || 0), Math.max(m[1], +d[1] || 0)]; }, [0, 0]);
      var S = Math.min(150 / (big[0] || 200), 136 / (big[1] || 210)), CX = 110, TOP = 14;
      function q(sel) { return sz.querySelector(sel); }
      function box(el, x, y, w, h) { el.setAttribute('x', x.toFixed(1)); el.setAttribute('y', y.toFixed(1)); el.setAttribute('width', Math.max(0, w).toFixed(1)); el.setAttribute('height', Math.max(0, h).toFixed(1)); }
      function paint(w, l) {
        var W = w * S, L = l * S, x = CX - W / 2, y = TOP;
        box(q('[data-sz-rect]'), x, y, W, L);
        q('[data-sz-turn]').setAttribute('d', 'M' + (x + 3).toFixed(1) + ' ' + (y + L * .3).toFixed(1) + 'H' + (x + W - 3).toFixed(1));
        var two = w >= 120, pw = two ? (W - 16) / 2 : W - 12, ph = Math.min(18, L * .12);
        box(q('[data-sz-p1]'), x + 6, y + 6, pw, ph);
        box(q('[data-sz-p2]'), two ? x + W - 6 - pw : x, y + 6, two ? pw : 0, two ? ph : 0);
        var yb = y + L + 12, xr = x + W + 12;
        q('[data-sz-dw]').setAttribute('d', 'M' + x.toFixed(1) + ' ' + (yb - 4) + 'v8M' + x.toFixed(1) + ' ' + yb + 'H' + (x + W).toFixed(1) + 'M' + (x + W).toFixed(1) + ' ' + (yb - 4) + 'v8');
        q('[data-sz-dl]').setAttribute('d', 'M' + (xr - 4).toFixed(1) + ' ' + y + 'h8M' + xr.toFixed(1) + ' ' + y + 'V' + (y + L).toFixed(1) + 'M' + (xr - 4).toFixed(1) + ' ' + (y + L).toFixed(1) + 'h8');
        var tw = q('[data-sz-tw]'), tl = q('[data-sz-tl]');
        tw.setAttribute('x', CX); tw.setAttribute('y', yb + 14); tw.textContent = Math.round(w);
        tl.setAttribute('x', xr + 13); tl.setAttribute('y', y + L / 2 + 4); tl.textContent = Math.round(l);
      }
      function draw(d) {
        if (!sz) return;
        var to = [+d[0] || 160, +d[1] || 200];
        if (!big[0]) big = to;
        box(q('[data-sz-ref]'), CX - big[0] * S / 2, TOP, big[0] * S, big[1] * S);
        if (!cur || reduce) { cur = to; paint(to[0], to[1]); return; }
        var from = cur.slice(), t0 = null; cancelAnimationFrame(raf);
        (function step(ts) {
          if (t0 === null) t0 = ts;
          var k = Math.min(1, (ts - t0) / 460), e = 1 - Math.pow(1 - k, 3);
          cur = [from[0] + (to[0] - from[0]) * e, from[1] + (to[1] - from[1]) * e];
          paint(cur[0], cur[1]);
          if (k < 1) raf = requestAnimationFrame(step); else cur = to;
        })(performance.now());
      }
      function pick(i) {
    chips.forEach(function (c, k) { var on = k === i; c.style.borderBottomColor = on ? '#17140F' : 'transparent'; c.style.color = on ? '#17140F' : '#6E675C'; });
    var d = dims[i] || [160, 200];
    draw(d);
    var nm = root.querySelector('[data-ms-size-name]'); if (nm && chips[i]) nm.textContent = chips[i].textContent;
    var fg = root.querySelector('[data-ms-size-figure]'); if (fg) fg.textContent = d[0] + ' × ' + d[1] + ' cm';
  }
  chips.forEach(function (c, k) { c.addEventListener('click', function () { pick(k); }); });
  var start = 0; chips.forEach(function (c, k) { if (c.textContent.trim() === 'Small Double') start = k; });
  pick(start);
})();
</script>
<style>
  .ms-sz { display: flex; align-items: center; gap: 18px; margin-top: 18px; }
      .ms-sz__svg { flex: 0 0 auto; width: 250px; max-width: 62%; height: auto; overflow: visible; }
      .ms-sz__ref { fill: none; stroke: rgba(23, 20, 15, .22); stroke-width: .8; stroke-dasharray: 3 3; }
      .ms-sz__bed { fill: #EFE7D9; stroke: #17140F; stroke-width: 1; }
      .ms-sz__turn { fill: none; stroke: rgba(23, 20, 15, .45); stroke-width: .8; }
      .ms-sz__pil { fill: #FBF9F5; stroke: rgba(23, 20, 15, .5); stroke-width: .8; }
      .ms-sz__dim path { fill: none; stroke: #7E623B; stroke-width: .8; }
      .ms-sz__dim text { font-family: "Red Hat Text", system-ui, sans-serif; font-size: 9.5px; letter-spacing: .08em; fill: #7E623B; font-variant-numeric: tabular-nums; }
      .ms-sz__txt { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
      .ms-sz__name { font-family: Newsreader, Georgia, serif; font-size: 17px; line-height: 1.2; }
      .ms-sz__fig { font-size: 12px; letter-spacing: .1em; font-variant-numeric: tabular-nums; color: #6E675C; }
</style>
{%- endif -%}

