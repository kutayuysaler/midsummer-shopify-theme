{%- comment -%}
  Midsummer Milano — dimensions as specification, not as a selector.
  There is no cart on this site, so a size picker has nothing to do: a client
  states a dimension at consultation. This reads as a drawing schedule.
{%- endcomment -%}

{%- liquid
  assign rows = section.blocks | where: 'type', 'size'
-%}

<div class="ms-dim" id="ms-dim-{{ section.id }}">
  <div class="ms-dim__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ms-dim__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ms-dim__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ms-dim__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.layout == 'plans' -%}
      <div class="ms-dim__readout" data-ms-readout>
        <span class="ms-dim__readout-name" data-ms-readout-name></span>
        <span class="ms-dim__readout-figure" data-ms-readout-figure></span>
      </div>
    {%- endif -%}
  </div>

  {%- if rows.size > 0 and section.settings.layout == 'compact' -%}
    {%- liquid
      assign widest = 0
      for row in rows
        assign w = row.settings.width | times: 1
        if w > widest
          assign widest = w
        endif
      endfor
      if widest == 0
        assign widest = 200
      endif
      assign shown = section.settings.default_size | minus: 1
    -%}
    <div class="ms-dim__compact" data-ms-compact>
      <div class="ms-dim__names">
        {%- for row in rows -%}
          <button
            type="button"
            class="ms-dim__name{% if forloop.index0 == shown %} is-on{% endif %}"
            data-ms-compact-pick="{{ forloop.index0 }}"
            data-name="{{ row.settings.name | escape }}"
            data-figure="{{ row.settings.width }} × {{ row.settings.length }}{{ section.settings.unit }}"
            data-w="{{ row.settings.width | times: 1 }}"
            data-l="{{ row.settings.length | times: 1 }}"
            aria-pressed="{% if forloop.index0 == shown %}true{% else %}false{% endif %}"
            {{ row.shopify_attributes }}
          >{{ row.settings.name }}</button>
        {%- endfor -%}
      </div>
      <div class="ms-dim__readout-row">
        <span class="ms-dim__plan-live" data-ms-compact-plan aria-hidden="true"></span>
        <span class="ms-dim__readout-text">
          <span class="ms-dim__readout-name" data-ms-readout-name></span>
          <span class="ms-dim__readout-figure" data-ms-readout-figure></span>
          {%- if section.settings.footnote != blank -%}
            <span class="ms-dim__readout-note">{{ section.settings.footnote | strip_html }}</span>
          {%- endif -%}
        </span>
      </div>
    </div>
  {%- elsif rows.size > 0 and section.settings.layout == 'plans' -%}
    {%- liquid
      assign widest = 0
      for row in rows
        assign w = row.settings.width | times: 1
        if w > widest
          assign widest = w
        endif
      endfor
      if widest == 0
        assign widest = 200
      endif
    -%}
    <div class="ms-dim__plans" data-ms-plans>
      {%- for row in rows -%}
        {%- assign w = row.settings.width | times: 1 -%}
        {%- assign l = row.settings.length | times: 1 -%}
        <button
          type="button"
          class="ms-dim__plan{% if forloop.index == section.settings.default_size %} is-on{% endif %}"
          data-ms-plan="{{ forloop.index0 }}"
          data-name="{{ row.settings.name | escape }}"
          data-figure="{{ row.settings.width }} × {{ row.settings.length }}{{ section.settings.unit }}"
          aria-pressed="{% if forloop.index == section.settings.default_size %}true{% else %}false{% endif %}"
          {{ row.shopify_attributes }}
        >
          <span
            class="ms-dim__plate"
            style="width: {{ w | times: 100 | divided_by: widest }}%; aspect-ratio: {{ w }} / {{ l }};"
            aria-hidden="true"
          ></span>
          <span class="ms-dim__plan-name">{{ row.settings.name }}</span>
          <span class="ms-dim__plan-figure">{{ row.settings.width }} × {{ row.settings.length }}</span>
        </button>
      {%- endfor -%}
    </div>
  {%- elsif rows.size > 0 -%}
    <div class="ms-dim__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="ms-dim__row ms-dim__row--head" role="row">
        <span role="columnheader">{{ section.settings.col_name }}</span>
        <span role="columnheader">{{ section.settings.col_width }}</span>
        <span role="columnheader">{{ section.settings.col_length }}</span>
        <span role="columnheader">{{ section.settings.col_note }}</span>
      </div>
      {%- for row in rows -%}
        <div class="ms-dim__row" role="row" {{ row.shopify_attributes }}>
          <span class="ms-dim__name" role="cell">{{ row.settings.name }}</span>
          <span class="ms-dim__figure" role="cell">
            {{ row.settings.width }}{%- if row.settings.width != blank -%}<i>{{ section.settings.unit }}</i>{%- endif -%}
          </span>
          <span class="ms-dim__figure" role="cell">
            {{ row.settings.length }}{%- if row.settings.length != blank -%}<i>{{ section.settings.unit }}</i>{%- endif -%}
          </span>
          <span class="ms-dim__note" role="cell">{{ row.settings.note }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if section.settings.footnote != blank -%}
    <div class="ms-dim__foot">
      <span class="ms-dim__rule" aria-hidden="true"></span>
      <div class="ms-dim__footnote">{{ section.settings.footnote }}</div>
      {%- if section.settings.link != blank and section.settings.link_label != blank -%}
        <a class="ms-dim__cta" href="{{ section.settings.link }}" {% if section.settings.open_panel %}data-ms-enquiry{% endif %}>
          {{ section.settings.link_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>


<script>
  (function () {
    var root = document.querySelector('#ms-dim-{{ section.id }}');
    if (!root || root.dataset.msPlanReady) return;
    root.dataset.msPlanReady = '1';

    var nameEl = root.querySelector('[data-ms-readout-name]');
    var figEl = root.querySelector('[data-ms-readout-figure]');

    // compact layout: names select, one plan redraws to scale
    var picks = root.querySelectorAll('[data-ms-compact-pick]');
    var live = root.querySelector('[data-ms-compact-plan]');
    if (picks.length) {
      var PX_PER_CM = 0.46;
      var showCompact = function (btn) {
        picks.forEach(function (p) {
          var on = p === btn;
          p.classList.toggle('is-on', on);
          p.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        if (live) {
          live.style.width = Math.round((btn.dataset.w || 0) * PX_PER_CM) + 'px';
          live.style.height = Math.round((btn.dataset.l || 0) * PX_PER_CM) + 'px';
        }
        if (nameEl) nameEl.textContent = btn.dataset.name || '';
        if (figEl) figEl.textContent = btn.dataset.figure || '';
      };
      picks.forEach(function (p) {
        p.addEventListener('click', function () { showCompact(p); });
      });
      showCompact(root.querySelector('[data-ms-compact-pick].is-on') || picks[0]);
      return;
    }

    var plans = root.querySelectorAll('[data-ms-plan]');
    if (!plans.length) return;

    function show(btn) {
      plans.forEach(function (p) {
        var on = p === btn;
        p.classList.toggle('is-on', on);
        p.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (nameEl) nameEl.textContent = btn.dataset.name || '';
      if (figEl) figEl.textContent = btn.dataset.figure || '';
    }

    plans.forEach(function (p) {
      p.addEventListener('click', function () { show(p); });
    });

    var first = root.querySelector('[data-ms-plan].is-on') || plans[0];
    if (first) show(first);
  })();
</script>

{% stylesheet %}
  /* Compact: five numbers do not need five plates across the page. */
  .ms-dim__compact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
    margin-top: clamp(24px, 3vw, 40px);
  }
  .ms-dim__names { display: flex; flex-wrap: wrap; gap: 10px 20px; }
  .ms-dim__name {
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    border-radius: 0;
    padding: 0 0 4px;
    cursor: pointer;
    font-family: var(--font-heading--family);
    font-size: clamp(14px, 1.4vw, 17px);
    line-height: 1.3;
    white-space: nowrap;
    color: var(--ms-dim-muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .ms-dim__name.is-on { color: var(--ms-dim-ink); border-bottom-color: var(--ms-dim-ink); }
  .ms-dim__readout-row {
    display: flex;
    align-items: flex-end;
    gap: clamp(20px, 3vw, 40px);
    border-top: 1px solid var(--ms-dim-rule);
    padding-top: clamp(22px, 2.6vw, 32px);
  }
  .ms-dim__plan-live {
    display: block;
    flex: 0 0 auto;
    background: var(--ms-dim-ink);
    transition: width 0.3s ease, height 0.3s ease;
  }
  .ms-dim__readout-text { display: flex; flex-direction: column; gap: 7px; padding-bottom: 2px; }
  .ms-dim__readout-note {
    margin-top: 6px;
    font-size: 12.5px;
    line-height: 1.85;
    color: var(--ms-dim-muted);
    max-width: 38ch;
  }
  .ms-dim__plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: clamp(14px, 2.4vw, 40px);
    align-items: end;
    margin-top: clamp(30px, 4vw, 56px);
  }
  .ms-dim__plan {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    background: none;
    border: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
  }
  .ms-dim__plate {
    display: block;
    background: transparent;
    border: 1px solid var(--ms-dim-rule);
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .ms-dim__plan.is-on .ms-dim__plate {
    background: var(--ms-dim-ink);
    border-color: var(--ms-dim-ink);
  }
  .ms-dim__plan-name {
    font-family: var(--font-heading--family);
    font-size: clamp(14px, 1.4vw, 17px);
    line-height: 1.25;
    color: var(--ms-dim-muted);
    transition: color 0.25s ease;
  }
  .ms-dim__plan.is-on .ms-dim__plan-name { color: var(--ms-dim-ink); }
  /* the dimensions ARE the specification — they read at rest, not on hover */
  .ms-dim__plan-figure {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--ms-dim-muted);
    transition: color 0.25s ease;
  }
  .ms-dim__plan.is-on .ms-dim__plan-figure { color: var(--ms-dim-accent); }
  .ms-dim__readout { text-align: right; }
  .ms-dim__readout-name {
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(19px, 2.2vw, 27px);
    line-height: 1.2;
  }
  .ms-dim__readout-figure {
    display: block;
    margin-top: 7px;
    font-size: 13px;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    color: var(--ms-dim-muted);
  }
  .ms-dim {
    max-width: var(--ms-dim-max);
    margin-inline: auto;
    padding-inline: clamp(18px, 5vw, 80px);
    display: grid;
    grid-template-columns: var(--ms-dim-cols);
    gap: clamp(28px, 4vw, 80px);
    align-items: start;
  }
  @media screen and (max-width: 900px) {
    .ms-dim { grid-template-columns: minmax(0, 1fr); }
  }
  .ms-dim__head { display: flex; flex-direction: column; }
  .ms-dim__eyebrow {
    margin: 0;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-dim-accent);
  }
  .ms-dim__title {
    margin: 18px 0 0;
    font-family: var(--font-heading--family);
    font-weight: 200;
    font-size: clamp(26px, 3.2vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ms-dim-ink);
    max-width: 18ch;
  }
  .ms-dim__body {
    margin-top: 22px;
    font-size: 14.5px;
    line-height: 1.9;
    color: var(--ms-dim-body);
    max-width: 40ch;
  }
  .ms-dim__body p { margin: 0 0 12px; }
  .ms-dim__body p:last-child { margin-bottom: 0; }

  .ms-dim__table { display: flex; flex-direction: column; }
  .ms-dim__row {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.8fr) minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 16px;
    align-items: baseline;
    border-top: 1px solid var(--ms-dim-rule);
    padding: clamp(14px, 1.8vw, 20px) 0;
  }
  .ms-dim__row:last-child { border-bottom: 1px solid var(--ms-dim-rule); }
  .ms-dim__row--head {
    border-top: 0;
    padding-top: 0;
    padding-bottom: 12px;
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ms-dim-muted);
  }
  .ms-dim__name {
    font-family: var(--font-heading--family);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.3;
    color: var(--ms-dim-ink);
  }
  .ms-dim__figure {
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-family: var(--font-heading--family);
    font-size: clamp(16px, 1.6vw, 20px);
    line-height: 1.3;
    color: var(--ms-dim-ink);
    font-variant-numeric: tabular-nums;
  }
  .ms-dim__figure i {
    font-style: normal;
    font-size: 0.58em;
    color: var(--ms-dim-muted);
  }
  .ms-dim__note {
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--ms-dim-muted);
  }
  @media screen and (max-width: 600px) {
    .ms-dim__row { grid-template-columns: minmax(0, 1fr) auto auto; }
    .ms-dim__row--head span:last-child, .ms-dim__note { display: none; }
  }

  .ms-dim__foot { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 18px; }
  .ms-dim__rule { display: block; width: 100%; height: 1px; background: var(--ms-dim-rule); }
  .ms-dim__footnote {
    font-size: 13.5px;
    line-height: 1.9;
    color: var(--ms-dim-body);
    max-width: 62ch;
  }
  .ms-dim__footnote p { margin: 0; }
  .ms-dim__cta {
    width: fit-content;
    font-size: 9.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ms-dim-ink);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 6px;
  }
{% endstylesheet %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  }
  #ms-dim-{{ section.id }} {
    --ms-dim-ink: {{ section.settings.text_color }};
    --ms-dim-body: {{ section.settings.body_color }};
    --ms-dim-muted: {{ section.settings.muted_color }};
    --ms-dim-accent: {{ section.settings.accent_color }};
    --ms-dim-rule: {{ section.settings.rule_color }};
    --ms-dim-max: {{ section.settings.max_width }}px;
    --ms-dim-cols: minmax(0, {{ section.settings.head_width }}fr) minmax(0, 1.6fr);
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Dimensions",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "paragraph", "content": "Dimensions stated as specification rather than as a selector. There is no cart on this site, so a size picker has nothing to add — a client states a dimension at consultation." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Dimensions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Standard, and everything beyond it." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>These are the dimensions we hold as standard. Any other width, length, height or radius is a specification decision rather than an exception, and carries no tooling charge.</p>" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "info": "Plans draw each size to scale. The table lists them.",
      "options": [
        { "value": "compact", "label": "Compact — names and one plan" },
        { "value": "plans", "label": "Every size drawn to plan" },
        { "value": "table", "label": "Table" }
      ],
      "default": "compact"
    },
    { "type": "range", "id": "default_size", "label": "Size shown first", "min": 1, "max": 8, "step": 1, "default": 3 },
    { "type": "text", "id": "unit", "label": "Unit", "default": "cm" },
    { "type": "header", "content": "Column labels" },
    { "type": "text", "id": "col_name", "label": "Name", "default": "Size" },
    { "type": "text", "id": "col_width", "label": "Width", "default": "Width" },
    { "type": "text", "id": "col_length", "label": "Length", "default": "Length" },
    { "type": "text", "id": "col_note", "label": "Note", "default": "Notes" },
    { "type": "header", "content": "Footnote" },
    { "type": "richtext", "id": "footnote", "label": "Footnote", "default": "<p>Heights are specified to sit correctly with your bedstead or headboard. Non-standard radii, including fully round, are made to your drawing.</p>" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discuss your dimensions" },
    { "type": "checkbox", "id": "open_panel", "label": "Open the enquiry panel instead of the page", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1800, "step": 20, "unit": "px", "default": 1560 },
    { "type": "range", "id": "head_width", "label": "Heading column", "min": 0.4, "max": 1.6, "step": 0.1, "default": 1 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17140F" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#4A443B" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6E675C" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#7E623B" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#DDD6C9" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Matrimoniale" },
        { "type": "text", "id": "width", "label": "Width", "default": "160" },
        { "type": "text", "id": "length", "label": "Length", "default": "200" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dimensions",
      "blocks": [
        { "type": "size" },
        { "type": "size" },
        { "type": "size" },
        { "type": "size" }
      ]
    }
  ]
}
{% endschema %}
