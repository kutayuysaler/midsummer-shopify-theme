<footer data-dc-tpl="1287" data-ms-footer="" style="border-top: 1px solid rgb(221, 214, 201); padding: clamp(52px, 7vw, 110px) clamp(18px, 5vw, 80px) clamp(28px, 3vw, 48px);">
<div style="max-width: 1560px; margin: 0px auto;">
<div data-ms="footgrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: clamp(28px, 4vw, 72px);">
<div>
<img alt="Midsummer Milano" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'midsummer-logotype.svg' | asset_url }}{% endif %}" style="display: block; height: 30px; width: auto;"/>
<p style="font-family: Newsreader, Georgia, serif; font-size: 16px; line-height: 1.85; color: rgb(110, 103, 92); margin-top: 22px;">{{ section.settings.t1 }}</p>
</div>
<div data-ms="footcol" style="display: flex; flex-direction: column; gap: 12px; font-size: 13.5px; color: rgb(74, 68, 59);">
<span style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-bottom: 6px;">{{ section.settings.t2 }}</span>
<a href="{% render 'ms-link', to: 'essentials' %}">{{ section.settings.t3 }}</a><a href="{% render 'ms-link', to: 'signature' %}">{{ section.settings.t4 }}</a><a href="{% render 'ms-link', to: 'icons' %}">{{ section.settings.t5 }}</a><a href="{% render 'ms-link', to: 'collections' %}">{{ section.settings.t6 }}</a><a data-ms-quiz-link="" href="{% render 'ms-link', to: 'quiz' %}">{{ section.settings.t7 }}</a>
</div>
<div data-ms="footcol" style="display: flex; flex-direction: column; gap: 12px; font-size: 13.5px; color: rgb(74, 68, 59);">
<span style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-bottom: 6px;">{{ section.settings.t8 }}</span>
<a href="{% render 'ms-link', to: 'story' %}">{{ section.settings.t9 }}</a>{%- capture ms_u16 -%}{% render 'ms-link', to: 'handmade', strict: true %}{%- endcapture -%}{%- if ms_u16 != blank -%}<a href="{{ ms_u16 }}">{{ section.settings.t10 }}</a>{%- endif -%}<a href="{% render 'ms-link', to: 'materials' %}">{{ section.settings.t11 }}</a><a href="{% render 'ms-link', to: 'regen' %}">Made to last · 15 + 15</a>{%- capture ms_u17 -%}{% render 'ms-link', to: 'sleep-culture', strict: true %}{%- endcapture -%}{%- if ms_u17 != blank -%}<a data-ms-quiz-link="" href="{{ ms_u17 }}">{{ section.settings.t13 }}</a>{%- endif -%}
</div>
<div data-ms="footcol" style="display: flex; flex-direction: column; gap: 12px; font-size: 13.5px; color: rgb(74, 68, 59);">
<span style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-bottom: 6px;">{{ section.settings.t14 }}</span>
{%- capture ms_u18 -%}{% render 'ms-link', to: 'professionals', strict: true %}{%- endcapture -%}{%- if ms_u18 != blank -%}<a href="{{ ms_u18 }}">{{ section.settings.t15 }}</a>{%- endif -%}{%- capture ms_u19 -%}{% render 'ms-link', to: 'hospitality', strict: true %}{%- endcapture -%}{%- if ms_u19 != blank -%}<a href="{{ ms_u19 }}">{{ section.settings.t16 }}</a>{%- endif -%}<a href="{% render 'ms-link', to: 'agents' %}">{{ section.settings.t17 }}</a><a href="{% render 'ms-link', to: 'journal' %}">{{ section.settings.t18 }}</a><a href="{% render 'ms-link', to: 'faq' %}#care">{{ section.settings.t19 }}</a>
</div>
<div data-ms="footcta" style="display: flex; flex-direction: column; gap: 18px;">
<span style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); min-height: 24px; display: flex; align-items: flex-end;">{{ section.settings.t20 }}</span>
<a href="{% render 'ms-link', to: 'enquire' %}#enquire" style="font-family: Newsreader, Georgia, serif; font-size: 26px; font-style: italic;" data-ms-landing="">{{ section.settings.t21 }}</a>
<div data-ms="footsocial" style="margin-top: 6px;">{% render 'ms-social' %}</div>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 22px; justify-content: space-between; border-top: 1px solid rgb(221, 214, 201); margin-top: clamp(36px, 5vw, 80px); padding-top: 24px; font-size: 11px; letter-spacing: 0.04em; color: rgb(110, 103, 92);">
<span>{{ section.settings.t25 }}</span>
<div data-ms="footlegal" style="display: flex; flex-wrap: wrap; gap: 22px;"><a href="{% render 'ms-link', to: 'terms' %}" style="color: rgb(110, 103, 92);">{{ section.settings.t26 }}</a><a href="{% render 'ms-link', to: 'privacy' %}" style="color: rgb(110, 103, 92);">{{ section.settings.t27 }}</a><a href="{% render 'ms-link', to: 'privacy' %}#cookies" style="color: rgb(110, 103, 92);" data-ms-cookies="">{{ section.settings.t28 }}</a><span>{{ section.settings.t29 }}</span></div>
</div>
</div></footer>
