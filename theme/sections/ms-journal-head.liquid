{%- liquid
  assign ms_pj_blogs = settings.ms_projects_blogs | default: 'projects,hotels,progetti,portfolio' | downcase | remove: ' ' | split: ','
  assign ms_pj_skip = false
  if blog and ms_pj_blogs contains blog.handle
    assign ms_pj_skip = true
  endif
-%}
{%- unless ms_pj_skip -%}
<section style="padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px) clamp(32px, 4vw, 56px); max-width: 1560px; margin: 0px auto; display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-end; justify-content: space-between;">
<div data-dc-tpl="1032">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(38px, 5.6vw, 78px); line-height: 1; letter-spacing: -0.035em; margin-top: 20px;">{{ section.settings.t2 }}</h1>
</div>
</section>
{%- endunless -%}
{% schema %}
{
  "name": "Journal · Heading",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Journal",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Notes on sleep, fibre and Milan.",
      "default": "Notes on sleep, fibre and Milan."
    },
    {
      "type": "text",
      "id": "all",
      "label": "All notes label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "Subjects (article tags)",
      "default": "Sleep, Materials, Design"
    }
  ]
}
{% endschema %}
