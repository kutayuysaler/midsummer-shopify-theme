{%- comment -%}
  Midsummer Milano — a row of cards: collections, service steps, doors,
  trade offers, captioned photograph pairs. Each card shows only what is filled.
{%- endcomment -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = ' scroll-trigger animate--slide-in'
  endif
  assign has_head = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank
    assign has_head = true
  endif
-%}

<div class="ms ms--{{ section.settings.tone }} ms-cards" id="ms-cards-{{ section.id }}">
  <div class="ms__wrap{{ reveal }}">
    {%- if has_head -%}
      <div class="ms-cards__head{% if section.settings.head_layout == 'split' %} ms-cards__head--split{% endif %}">
        <div class="ms-cards__head-text">
          {%- if section.settings.head_rule -%}<hr class="ms-rule ms-cards__head-rule">{%- endif -%}
          {%- if section.settings.eyebrow != blank -%}
            <p class="ms-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="ms-h ms-h--{{ section.settings.heading_size }}">{{ section.settings.heading | escape | newline_to_br }}</h2>
          {%- endif -%}
          {%- if section.settings.intro != blank -%}
            <div class="ms-body ms-cards__intro">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        {%- if section.settings.head_link_label != blank -%}
          {%- render 'ms-button', label: section.settings.head_link_label, link: section.settings.head_link, style: 'link' -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ms-cards__grid ms-cards__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings -%}
        <div class="ms-card ms-card--{{ section.settings.card_align }}" {{ block.shopify_attributes }}>
          {%- if section.settings.card_rule -%}<hr class="ms-rule">{%- endif -%}
          {%- if c.image != blank -%}
            <figure class="ms-media">
              {%- if c.link != blank -%}<a href="{{ c.link }}" tabindex="-1" aria-hidden="true">{%- endif -%}
              <div class="ms-media__frame ms-media__frame--{{ section.settings.image_ratio }}">
                {{
                  c.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 960, 1200, 1600',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    alt: c.image.alt
                }}
              </div>
              {%- if c.link != blank -%}</a>{%- endif -%}
            </figure>
          {%- endif -%}
          {%- if c.icon != 'none' -%}{%- render 'ms-icon', icon: c.icon -%}{%- endif -%}
          {%- if c.numeral != blank -%}<p class="ms-numeral">{{ c.numeral }}</p>{%- endif -%}
          {%- if c.eyebrow != blank -%}<p class="ms-eyebrow">{{ c.eyebrow }}</p>{%- endif -%}
          {%- if c.title != blank -%}
            <h3 class="ms-h ms-h--{{ section.settings.title_size }}">
              {%- if c.link != blank -%}<a class="ms-card__title-link" href="{{ c.link }}">{{ c.title | escape }}</a>{%- else -%}{{ c.title | escape }}{%- endif -%}
            </h3>
          {%- endif -%}
          {%- if c.tagline != blank -%}<p class="ms-caption">{{ c.tagline }}</p>{%- endif -%}
          {%- if c.text != blank -%}<div class="ms-{{ c.text_style }}">{{ c.text }}</div>{%- endif -%}
          {%- if c.link_label != blank -%}
            <div class="ms-card__cta">
              {%- render 'ms-button', label: c.link_label, link: c.link, style: 'link', open_panel: c.open_panel -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="ms-actions ms-cards__foot">
        {%- render 'ms-button', label: section.settings.button_label, link: section.settings.button_link, style: 'primary', open_panel: section.settings.button_panel -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  #ms-cards-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px;
  }
  @media screen and (min-width: 750px) {
    #ms-cards-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% stylesheet %}
  .ms-cards__head { display: flex; flex-direction: column; gap: 18px; margin-bottom: clamp(32px, 4vw, 56px); max-width: 60rem; }
  .ms-cards__head-text { display: flex; flex-direction: column; gap: 18px; }
  .ms-cards__head--split { max-width: none; flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 18px 40px; }
  .ms-cards__head-rule { margin-bottom: 8px; }
  .ms-cards__intro { max-width: 46rem; }
  .ms-cards__grid { display: grid; gap: clamp(36px, 4vw, 64px) clamp(20px, 3vw, 44px); grid-template-columns: 1fr; }
  .ms-card { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .ms-card .ms-rule { margin-bottom: 8px; }
  .ms-card .ms-media { margin-bottom: 8px; }
  .ms-card--center { align-items: center; text-align: center; }
  .ms-card--center .ms-eyebrow { justify-content: center; }
  .ms-card__title-link { color: inherit; text-decoration: none; }
  .ms-card__title-link:hover { color: var(--ms-accent); }
  .ms-card__cta { margin-top: auto; padding-top: 6px; }
  .ms-cards__foot { margin-top: clamp(36px, 4vw, 56px); }
  @media screen and (min-width: 750px) {
    .ms-cards__grid--2, .ms-cards__grid--3, .ms-cards__grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media screen and (min-width: 990px) {
    .ms-cards__grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ms-cards__grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · Cards",
  "tag": "section",
  "class": "ms-section",
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "Tone",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "stone", "label": "Stone" },
        { "value": "dark", "label": "Ink" }
      ],
      "default": "ivory"
    },
    { "type": "header", "content": "Heading" },
    { "type": "checkbox", "id": "head_rule", "label": "Rule above the heading", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "textarea", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" }
      ],
      "default": "h2"
    },
    { "type": "richtext", "id": "intro", "label": "Introduction" },
    {
      "type": "select",
      "id": "head_layout",
      "label": "Heading layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "split", "label": "Link on the right" }
      ],
      "default": "stacked"
    },
    { "type": "text", "id": "head_link_label", "label": "Heading link" },
    { "type": "url", "id": "head_link", "label": "Heading link URL" },
    { "type": "header", "content": "Cards" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photograph frame",
      "options": [
        { "value": "natural", "label": "The photograph's own shape" },
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "tall", "label": "Portrait 3:4" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape 3:2" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Card title size",
      "options": [
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h3"
    },
    { "type": "checkbox", "id": "card_rule", "label": "Rule above each card", "default": false },
    {
      "type": "select",
      "id": "card_align",
      "label": "Card alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "header", "content": "Closing button" },
    { "type": "text", "id": "button_label", "label": "Label" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "checkbox", "id": "button_panel", "label": "Open the enquire panel", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "plant", "label": "Plant" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "map_pin", "label": "Map pin" },
            { "value": "leather", "label": "Leather" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "box", "label": "Box" },
            { "value": "check_box", "label": "Check box" },
            { "value": "washing", "label": "Washing" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "heart", "label": "Heart" },
            { "value": "eye", "label": "Eye" },
            { "value": "truck", "label": "Truck" },
            { "value": "bed", "label": "Bed" },
            { "value": "gem", "label": "Gem" },
            { "value": "hand", "label": "Hand" },
            { "value": "wrench", "label": "Wrench" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "numeral", "label": "Numeral", "info": "For example I, II, III or 01, 02." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "text", "id": "tagline", "label": "Tagline", "info": "One italic line under the title." },
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "small", "label": "Small" },
            { "value": "caption", "label": "Caption (italic serif)" }
          ],
          "default": "body"
        },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "checkbox", "id": "open_panel", "label": "Link opens the enquire panel", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "MS · Cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
