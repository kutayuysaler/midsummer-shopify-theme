{%- comment -%}
  A hang of pictures: each work large, captioned like a museum label, opening full screen
  when chosen. Used for The Art of Rest.
{%- endcomment -%}
<section class="ms-ag" data-ms-ag>
  <div class="ms-ag__in">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
    <header class="ms-ag__head">
      {%- if section.settings.eyebrow != blank -%}<div class="ms-ag__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ms-ag__heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a data-ms="cta" class="ms-ag__link" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </header>
    {%- endif -%}
    <div class="ms-ag__grid">
      {%- for block in section.blocks -%}
        {%- capture src -%}{% render 'ms-img', image: block.settings.image, fallback: block.settings.image_fallback, width: 1600 %}{%- endcapture -%}
        {%- capture full -%}{% render 'ms-img', image: block.settings.image, fallback: block.settings.image_fallback, width: 2600 %}{%- endcapture -%}
        <figure class="ms-ag__work{% cycle ' is-wide', '', '', ' is-wide' %}" {{ block.shopify_attributes }}>
          <button type="button" class="ms-ag__frame" data-ms-ag-open="{{ forloop.index0 }}" aria-label="Enlarge: {{ block.settings.artist | escape }}, {{ block.settings.title | strip_html | escape }}">
            {%- if src != blank -%}
              <img src="{{ src }}" data-full="{{ full }}" alt="{{ block.settings.artist | escape }}, {{ block.settings.title | strip_html | escape }}" loading="{% if forloop.index > 2 %}lazy{% else %}eager{% endif %}" width="1600" height="1200">
            {%- else -%}
              <span class="ms-ag__empty"></span>
            {%- endif -%}
          </button>
          <figcaption class="ms-ag__cap">
            <span class="ms-ag__n">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
            <span class="ms-ag__who">{{ block.settings.artist }}</span>
            <span class="ms-ag__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank -%}<span class="ms-ag__text">{{ block.settings.text }}</span>{%- endif -%}
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
  <div class="ms-ag__viewer" data-ms-ag-viewer hidden role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
    <button type="button" class="ms-ag__vbtn is-close" data-ms-ag-close aria-label="Close"><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M1 1 L15 15 M15 1 L1 15" fill="none" stroke="currentColor" stroke-width="1.1"/></svg></button>
    <button type="button" class="ms-ag__vbtn is-prev" data-ms-ag-step="-1" aria-label="Previous"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg></button>
    <figure class="ms-ag__vfig"><img data-ms-ag-full alt="" width="1600" height="1200"><figcaption data-ms-ag-cap></figcaption></figure>
    <button type="button" class="ms-ag__vbtn is-next" data-ms-ag-step="1" aria-label="Next"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path d="M6 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.1"/></svg></button>
  </div>
</section>
<style>
  .ms-ag { padding: clamp(40px, 6vw, 96px) clamp(18px, 5vw, 80px) clamp(72px, 10vw, 160px); }
  .ms-ag__in { max-width: 1560px; margin: 0 auto; }
  .ms-ag__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 18px 40px; border-top: 1px solid #DDD6C9; padding-top: 26px; margin-bottom: clamp(32px, 4vw, 64px); }
  .ms-ag__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; width: 100%; }
  .ms-ag__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 44px); letter-spacing: -.02em; font-weight: 200; }
  .ms-site .ms-ag__link { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 7px; }
  .ms-ag__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 5vw, 88px) clamp(18px, 2.4vw, 40px); align-items: start; }
  .ms-ag__work { margin: 0; }
  .ms-ag__work.is-wide { grid-column: 1 / -1; }
  .ms-ag__frame { display: block; width: 100%; padding: 0; border: 0; background: #F1ECE3; cursor: zoom-in; overflow: hidden; }
  .ms-ag__frame img { display: block; width: 100%; height: auto; transition: transform 1.1s cubic-bezier(.2,.7,.2,1); }
  .ms-ag__frame:hover img { transform: scale(1.018); }
  .ms-ag__work.is-wide .ms-ag__frame img { max-height: 86vh; object-fit: contain; margin: 0 auto; width: auto; max-width: 100%; }
  .ms-ag__empty { display: block; aspect-ratio: 4 / 3; }
  .ms-ag__cap { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 4px 12px; margin-top: 18px; max-width: 62ch; }
  .ms-ag__n { grid-row: span 3; font-family: Newsreader, Georgia, serif; font-size: 14px; color: #9A7B4F; padding-top: 3px; font-variant-numeric: tabular-nums; }
  .ms-ag__who { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; }
  .ms-ag__title { font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2vw, 26px); line-height: 1.25; font-style: italic; }
  .ms-ag__text { font-size: 14.5px; line-height: 1.85; color: #4A443B; margin-top: 6px; }
  .ms-ag__text p { margin: 0; }
  .ms-ag__viewer { position: fixed; inset: 0; z-index: 96; background: rgba(23, 20, 15, .97); color: #FBF9F5; display: flex; align-items: center; justify-content: center; }
  .ms-ag__vfig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; }
  .ms-ag__vfig img { max-width: min(90vw, 1700px); max-height: 82vh; width: auto; height: auto; object-fit: contain; filter: none; }
  .ms-ag__vfig figcaption { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; color: rgba(251, 249, 245, .8); text-align: center; padding: 0 60px; }
  .ms-ag__vbtn { position: absolute; background: none; border: 0; color: #FBF9F5; cursor: pointer; padding: 14px; }
  .ms-ag__vbtn.is-close { top: 14px; right: 14px; }
  .ms-ag__vbtn.is-prev { left: 10px; top: 50%; transform: translateY(-50%); }
  .ms-ag__vbtn.is-next { right: 10px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 760px) {
    .ms-ag__grid { grid-template-columns: minmax(0, 1fr); }
    .ms-ag__work.is-wide .ms-ag__frame img { width: 100%; max-height: none; }
  }
</style>
<script>
  (function () {
    var root = document.currentScript.parentElement.querySelector('[data-ms-ag]');
    if (!root) return;
    var imgs = Array.prototype.slice.call(root.querySelectorAll('[data-ms-ag-open] img'));
    var caps = Array.prototype.slice.call(root.querySelectorAll('.ms-ag__cap'));
    var viewer = root.querySelector('[data-ms-ag-viewer]');
    var full = root.querySelector('[data-ms-ag-full]');
    var cap = root.querySelector('[data-ms-ag-cap]');
    var at = 0, last = null;
    function show(i) {
      if (!imgs.length) return;
      at = (i + imgs.length) % imgs.length;
      full.src = imgs[at].getAttribute('data-full') || imgs[at].src;
      full.alt = imgs[at].alt;
      var c = caps[at];
      cap.textContent = c ? (c.querySelector('.ms-ag__who').textContent + ' · ' + c.querySelector('.ms-ag__title').textContent) : '';
    }
    function close() { viewer.hidden = true; document.body.classList.remove('ms-lock'); if (last) last.focus(); }
    root.addEventListener('click', function (e) {
      var o = e.target.closest('[data-ms-ag-open]');
      if (o && imgs.length) { last = o; show(+o.getAttribute('data-ms-ag-open')); viewer.hidden = false; document.body.classList.add('ms-lock'); viewer.querySelector('[data-ms-ag-close]').focus(); return; }
      if (e.target.closest('[data-ms-ag-close]') || e.target === viewer) { close(); return; }
      var s = e.target.closest('[data-ms-ag-step]');
      if (s) show(at + +s.getAttribute('data-ms-ag-step'));
    });
    document.addEventListener('keydown', function (e) {
      if (viewer.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowRight') show(at + 1);
      if (e.key === 'ArrowLeft') show(at - 1);
    });
  })();
</script>
{% schema %}
{
  "name": "Works of art",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The series" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Link address" }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "Work",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Picture" },
        { "type": "text", "id": "image_fallback", "label": "Picture address" },
        { "type": "text", "id": "artist", "label": "After", "default": "Artist" },
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "richtext", "id": "text", "label": "Note" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [ { "name": "Works of art" } ]
}
{% endschema %}
