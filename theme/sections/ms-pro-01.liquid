{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'professionals' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="861" style="padding: clamp(40px, 6vw, 96px) clamp(18px, 5vw, 80px) clamp(28px, 4vw, 56px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(34px, 6vw, 104px); align-items: end;">
<img alt="A Midsummer bed against a frescoed wall, with a paisley throw" width="1122" height="1402" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-photo-fresco-bed.jpg' | asset_url }}{% endif %}" style="display: block; width: 100%; height: auto; aspect-ratio: 1122 / 1402; object-fit: cover; background: rgb(244, 239, 229);"/>
<div style="padding-bottom: clamp(8px, 2vw, 32px);">
<div style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 5.6vw, 78px); line-height: 1; letter-spacing: -0.03em; font-weight: 200; margin-top: 16px; max-width: 16ch;">{{ section.settings.t2 }}</h1>
{%- if section.settings.lead != blank -%}<p class="ms-hero-lead">{{ section.settings.lead }}</p>{%- endif -%}<div class="ms-hero-ctas"><a class="ms-hero-cta" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=trade' %}#enquire" data-ms-landing>{{ section.settings.cta }}</a><a class="ms-hero-link" href="{% render 'ms-link', to: 'agents' %}">{{ section.settings.cta2 }}</a></div>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Professionals 01 · Trade ",
  "settings": [
    { "type": "textarea", "id": "lead", "label": "Opening line", "default": "Specification support, the full Loro Piana Interiors palette and systems made to your drawing, with one person at the atelier from the first sketch to delivery." },
    { "type": "text", "id": "cta", "label": "Button", "default": "Open a project file" },
    { "type": "text", "id": "cta2", "label": "Second link", "default": "Agents & Resellers" },
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: A Midsummer bed in an uphols"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Trade",
      "default": "Trade"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Architects & Interior Designers",
      "default": "Architects & Interior Designers"
    }
  ]
}
{% endschema %}
