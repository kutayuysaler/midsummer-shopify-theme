{%- comment -%}
  Midsummer Milano — a single pull quote, with optional portrait and source link.
  Used for press and for named clients.
{%- endcomment -%}

<div class="ms-quote" id="ms-quote-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="ms-quote__portrait">
      {{ section.settings.image | image_url: width: 900 | image_tag:
         loading: 'lazy', alt: section.settings.attribution, class: 'ms-quote__img' }}
    </div>
  {%- endif -%}

  <figure class="ms-quote__body">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ms-quote__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <blockquote class="ms-quote__text">{{ section.settings.quote }}</blockquote>

    {%- if section.settings.attribution != blank -%}
      <figcaption class="ms-quote__cite">
        <span class="ms-quote__name">{{ section.settings.attribution }}</span>
        {%- if section.settings.role != blank -%}
          <span class="ms-quote__role">{{ section.settings.role }}</span>
        {%- endif -%}
        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <a class="ms-quote__link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </figcaption>
    {%- endif -%}
  </figure>
</div>

{% stylesheet %}
  .ms-quote {
    display: grid;
    grid-template-columns: var(--ms-q-cols);
    gap: clamp(28px, 5vw, 88px);
    align-items: center;
    max-width: var(--ms-q-max);
    margin-inline: auto;
    padding-inline: clamp(18px, 5vw, 80px);
  }
  @media screen and (max-width: 860px) {
    .ms-quote { grid-template-columns: minmax(0, 1fr); }
  }
  .ms-quote__portrait { overflow: hidden; }
  .ms-quote__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .ms-quote__body { margin: 0; display: flex; flex-direction: column; gap: clamp(20px, 2.4vw, 30px); }
  .ms-quote__eyebrow {
    margin: 0;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-q-muted);
  }
  .ms-quote__text {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 200;
    font-size: var(--ms-q-size);
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--ms-q-ink);
    max-width: 24ch;
    text-wrap: pretty;
  }
  .ms-quote__cite {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: clamp(14px, 1.8vw, 22px);
    border-top: 1px solid var(--ms-q-rule);
    width: fit-content;
    min-width: min(240px, 100%);
  }
  .ms-quote__name {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ms-q-ink);
  }
  .ms-quote__role {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ms-q-muted);
  }
  .ms-quote__link {
    margin-top: 6px;
    width: fit-content;
    font-size: 9.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ms-q-accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
  }
{% endstylesheet %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  }
  #ms-quote-{{ section.id }} {
    --ms-q-ink: {{ section.settings.text_color }};
    --ms-q-muted: {{ section.settings.muted_color }};
    --ms-q-accent: {{ section.settings.accent_color }};
    --ms-q-rule: {{ section.settings.rule_color }};
    --ms-q-max: {{ section.settings.max_width }}px;
    --ms-q-size: {{ section.settings.quote_size }};
    --ms-q-cols: {% if section.settings.image != blank %}minmax(0, {{ section.settings.image_width }}fr) minmax(0, 1fr){% else %}minmax(0, 1fr){% endif %};
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Pull quote",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In the press" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "A bed you specify once and keep for thirty years." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Publication" },
    { "type": "text", "id": "role", "label": "Role or date" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the piece" },
    { "type": "header", "content": "Portrait" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Leave empty for a text-only quote." },
    { "type": "range", "id": "image_width", "label": "Image column", "min": 0.4, "max": 1.4, "step": 0.1, "default": 0.8 },
    { "type": "header", "content": "Type" },
    {
      "type": "select",
      "id": "quote_size",
      "label": "Quote size",
      "options": [
        { "value": "clamp(22px, 2.6vw, 34px)", "label": "Small" },
        { "value": "clamp(26px, 3.4vw, 46px)", "label": "Medium" },
        { "value": "clamp(32px, 4.6vw, 64px)", "label": "Large" }
      ],
      "default": "clamp(26px, 3.4vw, 46px)"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17140F" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6E675C" },
    { "type": "color", "id": "accent_color", "label": "Link", "default": "#7E623B" },
    { "type": "color", "id": "rule_color", "label": "Rule", "default": "#DDD6C9" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "Pull quote" }]
}
{% endschema %}
