{%- comment -%}
  A chapter of the home page. "Split": a tall photograph and the words beside it, with up
  to three figures. "Full": the photograph across the screen, the words over it. Every
  chapter has the same measure and the same space around it, so the page reads as one.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  case s.tone
    when 'sand'
      assign bg = '#F3EEE5'
    when 'dark'
      assign bg = '#17140F'
    else
      assign bg = '#FBF9F5'
  endcase
  if s.link_place != blank
    capture href
      render 'ms-link', to: s.link_place, q: s.link_query
    endcapture
    if s.link_place == 'enquire'
      assign href = href | append: '#enquire'
    endif
  endif
-%}
{%- liquid
  assign inset = false
  if s.layout == 'split'
    if s.image_2 != blank or s.image_2_fallback != blank
      assign inset = true
    endif
  endif
-%}
{%- comment -%} Round 28: on a phone, the upright photograph when there is one {%- endcomment -%}
{%- liquid
  assign ph_set = ''
  if s.image_mobile != blank or s.image_fallback_mobile != blank
    capture ph_set
      render 'ms-srcset', image: s.image_mobile, fallback: s.image_fallback_mobile, width: 1200, sizes: '100vw'
    endcapture
    assign ph_set = ph_set | strip
    if ph_set == ''
      capture ph_set
        echo 'srcset="'
        render 'ms-img', image: s.image_mobile, fallback: s.image_fallback_mobile, width: 1200
        echo '"'
      endcapture
    endif
  endif
-%}
<section class="ms-ch ms-ch--{{ s.layout }} ms-ch--{{ s.tone }}{% if s.side == 'right' %} ms-ch--flip{% endif %}{% if s.shape == 'landscape' %} ms-ch--wide{% endif %}{% if inset %} ms-ch--inset{% endif %}" style="--bg: {{ bg }};">
  <div class="ms-ch__in">
    <div class="ms-ch__figure">
      <div class="ms-ch__media">
        <picture>{%- if ph_set != '' -%}<source media="(max-width: 760px)" {{ ph_set }}>{%- endif -%}<img src="{% render 'ms-img', image: s.image, fallback: s.image_fallback, width: 2000 %}" {% if s.layout == 'full' %}{% render 'ms-srcset', image: s.image, fallback: s.image_fallback, width: 2400, sizes: '(max-width: 760px) 180vh, 100vw' %}{% else %}{% render 'ms-srcset', image: s.image, fallback: s.image_fallback, width: 2000, sizes: '100vw' %}{% endif %} alt="{% capture ms_d1 %}{% render 'ms-t', v: s.heading %}{% endcapture %}{{ s.image.alt | default: ms_d1 | strip_html | escape }}" width="2000" height="{% if s.shape == 'landscape' %}1500{% else %}2500{% endif %}" loading="lazy"></picture>
      </div>
      {%- if inset -%}
        {%- comment -%} a second, closer photograph: the hands at work, set over the corner of the first {%- endcomment -%}
        <div class="ms-ch__inset">
          <img src="{% render 'ms-img', image: s.image_2, fallback: s.image_2_fallback, width: 900 %}" {% render 'ms-srcset', image: s.image_2, fallback: s.image_2_fallback, width: 900, sizes: '(max-width: 760px) 45vw, 24vw' %} alt="{% capture ms_d2 %}{% render 'ms-t', v: s.image_2_caption %}{% endcapture %}{% capture ms_d3 %}{% render 'ms-t', v: s.heading %}{% endcapture %}{{ s.image_2.alt | default: ms_d2 | default: ms_d3 | strip_html | escape }}" width="900" height="1125" loading="lazy">
          {%- if s.image_2_caption != blank -%}<span class="ms-ch__cap">{% render 'ms-t', v: s.image_2_caption %}</span>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="ms-ch__words">
      <div class="ms-ch__mark">{%- if s.numeral != blank -%}<span class="ms-ch__num">{% render 'ms-t', v: s.numeral %}</span>{%- endif -%}<span class="ms-ch__eyebrow">{% render 'ms-t', v: s.eyebrow %}</span></div>
      <h2 class="ms-ch__title">{% render 'ms-t', v: s.heading %}</h2>
      {%- if s.text != blank -%}<p class="ms-ch__text">{% render 'ms-t', v: s.text %}</p>{%- endif -%}
      {%- if s.stat1_value != blank -%}
        <dl class="ms-ch__stats">
          {%- for i in (1..3) -%}
            {%- assign kv = 'stat' | append: i | append: '_value' -%}{%- assign kl = 'stat' | append: i | append: '_label' -%}
            {%- if s[kv] != blank -%}<div><dt data-ms-count>{% render 'ms-t', v: s[kv] %}</dt><dd>{% render 'ms-t', v: s[kl] %}</dd></div>{%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}
      {%- if s.link_label != blank and href != blank -%}
        <a class="ms-ch__link" href="{{ href }}"{% if s.link_place == 'enquire' %} data-ms-landing{% endif %}>{% render 'ms-t', v: s.link_label %}<span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .ms-ch { background: var(--bg); color: #17140F; padding: clamp(96px, 12vw, 200px) clamp(18px, 5vw, 80px); }
  .ms-ch--dark { color: #FBF9F5; }
  .ms-ch__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 7vw, 140px); align-items: center; }
  .ms-ch--flip .ms-ch__figure { order: 2; }
  .ms-ch__figure { position: relative; min-width: 0; }
  .ms-ch__media { overflow: hidden; aspect-ratio: 4 / 5; max-height: 86vh; background: rgba(23, 20, 15, .06); }
  .ms-ch--wide .ms-ch__media { aspect-ratio: 4 / 3; }
  .ms-ch--inset .ms-ch__figure { padding-bottom: clamp(56px, 7vw, 120px); }
  .ms-ch__inset { position: absolute; right: clamp(-56px, -3vw, -24px); bottom: 0; width: 34%; z-index: 1; }
  .ms-ch--flip .ms-ch__inset { right: auto; left: clamp(-56px, -3vw, -24px); }
  .ms-ch__inset img { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; outline: clamp(6px, .8vw, 12px) solid var(--bg); }
  .ms-ch__cap { display: block; margin-top: 12px; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 14px; line-height: 1.45; color: #6E675C; }
  .ms-ch--dark .ms-ch__cap { color: rgba(251, 249, 245, .6); }
  .ms-ch__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ms-ch__media picture { display: contents; }
  .ms-ch__words { max-width: 460px; }
  .ms-ch__mark { display: flex; align-items: baseline; gap: 18px; }
  .ms-ch__num { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: 15px; color: #7E623B; }
  .ms-ch__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-ch__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(38px, 4.6vw, 72px); line-height: 1.02; letter-spacing: -0.035em; margin-top: clamp(22px, 2.4vw, 34px); }
  .ms-ch__text { font-size: 15.5px; line-height: 1.95; color: #4A443B; margin-top: clamp(22px, 2.4vw, 32px); }
  .ms-ch--dark .ms-ch__text { color: rgba(251, 249, 245, .74); }
  .ms-ch--dark .ms-ch__num, .ms-ch--dark .ms-ch__eyebrow { color: #C9A97A; }
  .ms-ch__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: clamp(30px, 3.4vw, 46px) 0 0; padding-top: 24px; border-top: 1px solid rgba(23, 20, 15, .16); }
  .ms-ch--dark .ms-ch__stats { border-top-color: rgba(251, 249, 245, .2); }
  .ms-ch__stats { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1fr); }
  .ms-ch__stats dt { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3vw, 46px); line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .ms-ch__stats dd { margin: 10px 0 0; font-size: 12px; line-height: 1.6; color: #6E675C; }
  .ms-ch--dark .ms-ch__stats dd { color: rgba(251, 249, 245, .6); }
  .ms-site .ms-ch__link { display: inline-flex; gap: 14px; align-items: center; margin-top: clamp(32px, 3.6vw, 50px); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: inherit; border-bottom: 1px solid currentColor; padding-bottom: 7px; }
  .ms-ch__link span { transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-ch__link:hover span { transform: translateX(6px); }

  /* full: the photograph across the screen, the words over it */
  .ms-ch--full { position: relative; padding: 0; color: #FBF9F5; min-height: 100vh; min-height: 100svh; display: flex; align-items: flex-end; overflow: hidden; }
  .ms-ch--full .ms-ch__in { display: block; max-width: none; width: 100%; padding: clamp(96px, 12vw, 200px) clamp(18px, 5vw, 80px) clamp(56px, 7vw, 110px); }
  .ms-ch--full .ms-ch__figure { position: static; }
  .ms-ch--full .ms-ch__media { position: absolute; inset: 0; aspect-ratio: auto; max-height: none; z-index: 0; }
  .ms-ch--full .ms-ch__media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(23, 20, 15, .55), rgba(23, 20, 15, 0) 62%), linear-gradient(180deg, rgba(23, 20, 15, 0) 40%, rgba(23, 20, 15, .55)); }
  .ms-ch--full .ms-ch__words { max-width: 640px; position: relative; z-index: 1; }
  .ms-ch--full .ms-ch__text { color: rgba(251, 249, 245, .82); }
  .ms-ch--full .ms-ch__num, .ms-ch--full .ms-ch__eyebrow { color: #E2CFAE; }
  .ms-ch--full .ms-ch__stats { border-top-color: rgba(251, 249, 245, .28); }
  .ms-ch--full .ms-ch__stats dd { color: rgba(251, 249, 245, .7); }

  @media (max-width: 900px) {
    .ms-ch__in { grid-template-columns: minmax(0, 1fr); }
    .ms-ch--flip .ms-ch__figure { order: 0; }
    .ms-ch__media { max-height: 70vh; }
    .ms-ch__inset, .ms-ch--flip .ms-ch__inset { right: 0; left: auto; width: 38%; }
    .ms-ch--inset .ms-ch__figure { padding-bottom: 26vw; }
    .ms-ch--inset .ms-ch__media { width: 88%; }
    .ms-ch__cap { display: none; }
    .ms-ch--full { min-height: 88svh; }
  }
</style>

{% schema %}
{
  "name": "Home · Chapter",
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "default": "split", "options": [{"value":"split","label":"Photograph beside the words"},{"value":"full","label":"Photograph across the screen"}] },
    { "type": "select", "id": "side", "label": "Photograph on the", "default": "left", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}] },
    { "type": "select", "id": "tone", "label": "Ground", "default": "light", "options": [{"value":"light","label":"Ivory"},{"value":"sand","label":"Sand"},{"value":"dark","label":"Ink"}] },
    { "type": "image_picker", "id": "image", "label": "Photograph" },
    { "type": "text", "id": "image_fallback", "label": "Photograph address", "info": "Used when no photograph is picked." },
    { "type": "image_picker", "id": "image_mobile", "label": "Photograph on a phone (optional)", "info": "An upright photograph for phones; without one, phones crop the photograph above." },
    { "type": "text", "id": "image_fallback_mobile", "label": "Phone photograph address (optional)", "info": "Used when no phone photograph is picked." },
    { "type": "select", "id": "shape", "label": "Photograph shape", "default": "portrait", "options": [{"value":"portrait","label":"Upright"},{"value":"landscape","label":"Wide"}] },
    { "type": "image_picker", "id": "image_2", "label": "Second photograph", "info": "A closer detail, set over the corner of the first." },
    { "type": "text", "id": "image_2_fallback", "label": "Second photograph address" },
    { "type": "text", "id": "image_2_caption", "label": "Second photograph caption" },
    { "type": "text", "id": "numeral", "label": "Chapter number", "default": "I" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Handmade in Italy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "By hand. One bed at a time." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "stat1_value", "label": "Figure 1" }, { "type": "text", "id": "stat1_label", "label": "Figure 1 line" },
    { "type": "text", "id": "stat2_value", "label": "Figure 2" }, { "type": "text", "id": "stat2_label", "label": "Figure 2 line" },
    { "type": "text", "id": "stat3_value", "label": "Figure 3" }, { "type": "text", "id": "stat3_label", "label": "Figure 3 line" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "select", "id": "link_place", "label": "Link to", "default": "", "options": [{"value":"","label":"Nothing"},{"value":"story","label":"Our story"},{"value":"handmade","label":"Handmade in Italy"},{"value":"materials","label":"Natural materials"},{"value":"loro","label":"Loro Piana Interiors"},{"value":"regen","label":"Made to last · 15 + 15"},{"value":"icons","label":"Icons"},{"value":"signature","label":"Signature"},{"value":"essentials","label":"Essentials"},{"value":"collections","label":"Compare the collections"},{"value":"agents","label":"Agents & Resellers"},{"value":"enquire","label":"Enquiry page"}] },
    { "type": "text", "id": "link_query", "label": "Enquiry form", "info": "For the enquiry page: e.g. enquiry=appointment" }
  ],
  "presets": [{ "name": "Home · Chapter" }]
}
{% endschema %}
