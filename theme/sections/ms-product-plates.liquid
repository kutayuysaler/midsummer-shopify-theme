<section data-dc-tpl="798" style="padding: 0px clamp(18px, 5vw, 80px) clamp(56px, 8vw, 140px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(24px, 4vw, 64px); align-items: start;">
<figure style="margin: 0px; display: flex; flex-direction: column; gap: 14px;">
{% assign pm = product.media[1] %}{% if section.settings.img1 == blank and pm and pm.media_type == 'image' %}<img alt="{{ pm.alt | default: product.title | escape }}" src="{{ pm | image_url: width: 1600 }}" width="{{ pm.width }}" height="{{ pm.height }}" loading="lazy" style="display: block; width: 100%; height: auto; aspect-ratio: {{ pm.aspect_ratio }}; object-fit: contain; background: rgb(244, 239, 229);">{% else %}<img alt="Paisley upholstery detail" data-plate="" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/files/Paisleydettaglio.jpg?v=1788246821&amp;width=1200{% endif %}" style="display: block; width: 100%; height: auto; aspect-ratio: 1192 / 1644; object-fit: contain; background: rgb(244, 239, 229);"/>{% endif %}
<figcaption style="font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</figcaption>
</figure>
<figure style="margin: 0px; display: flex; flex-direction: column; gap: 14px;">
{% assign pm = product.media[2] %}{% if section.settings.img2 == blank and pm and pm.media_type == 'image' %}<img alt="{{ pm.alt | default: product.title | escape }}" src="{{ pm | image_url: width: 1600 }}" width="{{ pm.width }}" height="{{ pm.height }}" loading="lazy" style="display: block; width: 100%; height: auto; aspect-ratio: {{ pm.aspect_ratio }}; object-fit: contain; background: rgb(244, 239, 229);">{% else %}<img alt="Paisley headboard" data-plate="" loading="lazy" src="{% if section.settings.img2 != blank %}{{ section.settings.img2 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/files/Paisley_IMG_4918_low_70960abc-6877-49b2-abc8-0bd379994114.jpg?v=1777114994&amp;width=1400{% endif %}" style="display: block; width: 100%; height: auto; aspect-ratio: 1428 / 1904; object-fit: contain; background: rgb(244, 239, 229);"/>{% endif %}
<figcaption style="font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: rgb(110, 103, 92);">{{ section.settings.t2 }}</figcaption>
</figure>
</div>
</section>
{% schema %}
{
  "name": "Product · Plates",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's second and third photographs; pick an image here to override."
    },
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: Paisley upholstery detail"
    },
    {
      "type": "image_picker",
      "id": "img2",
      "label": "Image: Paisley headboard"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Shadan, in silk and linen. The sea…",
      "default": "Shadan, in silk and linen. The seam is sewn by the same hands that opened the core."
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Headboard specified to the client'…",
      "default": "Headboard specified to the client's drawing, without additional tooling."
    }
  ]
}
{% endschema %}
