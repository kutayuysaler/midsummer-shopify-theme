{%- liquid
  assign ms_show = true
  if template.suffix == blank
    capture ms_here
      render 'ms-link', to: 'regen'
    endcapture
    if ms_here != page.url
      assign ms_show = false
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="983" style="background: rgb(241, 236, 227); padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px);">
<div style="max-width: 1560px; margin: 0px auto;">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.4vw, 46px); line-height: 1.06; letter-spacing: -0.02em;">{{ section.settings.t1 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 18px; max-width: 56ch;">{{ section.settings.t2 }}</p>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(26px, 4vw, 72px); margin-top: clamp(40px, 5vw, 80px);">
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><div style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t3 }}</div><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 27px); margin-top: 12px;">{{ section.settings.t4 }}</h3><p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t5 }}</p></div>
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><div style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t6 }}</div><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 27px); margin-top: 12px;">{{ section.settings.t7 }}</h3><p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t8 }}</p></div>
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><div style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t9 }}</div><h3 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 27px); margin-top: 12px;">{{ section.settings.t10 }}</h3><p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t11 }}</p></div>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "15 + 15 03 · What we do a",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "What we do at year fifteen.",
      "default": "What we do at year fifteen."
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Three things. No more. If we built…",
      "default": "Three things. No more. If we built well the first time, very little is needed the second time."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "01",
      "default": "01"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Check the springs.",
      "default": "Check the springs."
    },
    {
      "type": "textarea",
      "id": "t5",
      "label": "Pocket by pocket. The integrity of…",
      "default": "Pocket by pocket. The integrity of the spring core, the resilience of each individual coil and the condition of the wool felt that protects them."
    },
    {
      "type": "text",
      "id": "t6",
      "label": "02",
      "default": "02"
    },
    {
      "type": "text",
      "id": "t7",
      "label": "Recard the wool.",
      "default": "Recard the wool."
    },
    {
      "type": "textarea",
      "id": "t8",
      "label": "The same wool that has been inside…",
      "default": "The same wool that has been inside your mattress all along is opened up and recarded by hand. The fibres regain their loft, their breathability and their springiness."
    },
    {
      "type": "text",
      "id": "t9",
      "label": "03",
      "default": "03"
    },
    {
      "type": "text",
      "id": "t10",
      "label": "Replace the outer plate, only if s…",
      "default": "Replace the outer plate, only if spoiled."
    },
    {
      "type": "textarea",
      "id": "t11",
      "label": "On our white-cover mattresses only…",
      "default": "On our white-cover mattresses only, and only when the plate has been damaged over the years. The Loro Piana Interiors fabric is never replaced."
    }
  ]
}
{% endschema %}
