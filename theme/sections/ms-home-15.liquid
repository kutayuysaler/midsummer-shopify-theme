<section style="border-top: 1px solid rgb(221, 214, 201); padding: clamp(44px, 6vw, 80px) 0px;">
<div data-dc-tpl="417" style="display: flex; align-items: center; justify-content: center; gap: 20px; font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: rgb(110, 103, 92);">
<span style="display: block; width: clamp(28px, 6vw, 72px); height: 1px; background: rgb(221, 214, 201);"></span>
<span>{{ section.settings.t1 }}</span>
<span style="display: block; width: clamp(28px, 6vw, 72px); height: 1px; background: rgb(221, 214, 201);"></span>
</div>
<div style="display: flex; flex-direction: column; gap: 14px; margin-top: clamp(28px, 4vw, 52px);">
<div data-ms="pressrow" style="overflow: hidden; mask-image: linear-gradient(to right, transparent, rgb(0, 0, 0) 7%, rgb(0, 0, 0) 93%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, rgb(0, 0, 0) 7%, rgb(0, 0, 0) 93%, transparent);">
<div style="display: flex; width: max-content; animation: 64s linear 0s infinite normal none running msMarq;">
{%- for i in (1..2) -%}
<div style="display: flex; align-items: center;"{% if i == 2 %} aria-hidden="true"{% endif %}>
{%- for block in section.blocks -%}{%- if block.settings.row == '1' -%}
<a href="{{ block.settings.link | default: '#' }}" style="flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 150px; height: 52px; padding: 0px clamp(16px, 2.2vw, 30px); border-right: 1px solid rgb(221, 214, 201);"{% if i == 1 %} {{ block.shopify_attributes }}{% else %} tabindex="-1"{% endif %}>
{%- if block.settings.logo != blank -%}{{ block.settings.logo | image_url: width: 300 | image_tag: alt: block.settings.name, loading: 'lazy', style: 'display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;' }}
{%- else -%}<span style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border: 1px dashed rgb(227, 220, 206); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(184, 175, 158); text-align: center; line-height: 1.3;">{{ block.settings.name }}</span>{%- endif -%}
</a>
{%- endif -%}{%- endfor -%}
</div>
{%- endfor -%}
</div>
</div>
<div data-ms="pressrow" style="overflow: hidden; mask-image: linear-gradient(to right, transparent, rgb(0, 0, 0) 7%, rgb(0, 0, 0) 93%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, rgb(0, 0, 0) 7%, rgb(0, 0, 0) 93%, transparent);">
<div style="display: flex; width: max-content; animation: 78s linear 0s infinite normal none running msMarq;">
{%- for i in (1..2) -%}
<div style="display: flex; align-items: center;"{% if i == 2 %} aria-hidden="true"{% endif %}>
{%- for block in section.blocks -%}{%- if block.settings.row == '2' -%}
<a href="{{ block.settings.link | default: '#' }}" style="flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 150px; height: 52px; padding: 0px clamp(16px, 2.2vw, 30px); border-right: 1px solid rgb(221, 214, 201);"{% if i == 1 %} {{ block.shopify_attributes }}{% else %} tabindex="-1"{% endif %}>
{%- if block.settings.logo != blank -%}{{ block.settings.logo | image_url: width: 300 | image_tag: alt: block.settings.name, loading: 'lazy', style: 'display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;' }}
{%- else -%}<span style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border: 1px dashed rgb(227, 220, 206); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: rgb(184, 175, 158); text-align: center; line-height: 1.3;">{{ block.settings.name }}</span>{%- endif -%}
</a>
{%- endif -%}{%- endfor -%}
</div>
{%- endfor -%}
</div>
</div>
</div>
</section>
{% schema %}
{
  "name": "Home 15 · As featured in ",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "As featured in",
      "default": "As featured in"
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "publication",
      "name": "Publication",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Publication",
          "default": "Publication"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "row",
          "label": "Row",
          "options": [
            {
              "value": "1",
              "label": "First"
            },
            {
              "value": "2",
              "label": "Second"
            }
          ],
          "default": "1"
        }
      ]
    }
  ]
}
{% endschema %}
