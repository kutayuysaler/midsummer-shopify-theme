<section data-dc-tpl="280" style="padding: 0px clamp(18px, 5vw, 80px) clamp(80px, 12vw, 190px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(32px, 6vw, 110px); align-items: center;">
<div style="display: flex; flex-direction: column; gap: 24px;">
<div style="display: flex; align-items: center; gap: 11px; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);"><svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M19.5 12 A7.5 7.5 0 0 0 6.5 6.8" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M4.5 12 A7.5 7.5 0 0 0 17.5 17.2" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M6.5 3.4 V7 H10" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M17.5 20.6 V17 H14" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg><span>{{ section.settings.t1 }}</span></div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.025em;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); max-width: 50ch;">{{ section.settings.t3 }}</p>
<a data-ms="cta" href="{% render 'ms-link', to: 'regen' %}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 8px; width: fit-content;">{{ section.settings.t4 }}</a>
</div>
<img alt="Regeneration" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-graded-paisley-red.jpg' | asset_url }}{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/>
</div>
</section>
{% schema %}
{
  "name": "Home 07 · Our commitment ",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: Regeneration"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Our commitment to longevity",
      "default": "Our commitment to longevity"
    },
    {
      "type": "html",
      "id": "t2",
      "label": "Fifteen years.Then fifteen more.",
      "default": "Fifteen years.<br/>Then fifteen more."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Our regeneration service brings Mi…",
      "default": "Our regeneration service brings Midsummer mattresses back to the Italian artisans who made them, restoring comfort, integrity and life for the years ahead."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "The 15 + 15 service",
      "default": "The 15 + 15 service"
    }
  ]
}
{% endschema %}
