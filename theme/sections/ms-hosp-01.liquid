{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,collections,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'hospitality' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="900" style="padding: clamp(40px, 6vw, 96px) clamp(18px, 5vw, 80px) clamp(28px, 4vw, 56px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(34px, 6vw, 104px); align-items: end;">
<img alt="A Midsummer bed in a glass house among the trees" width="1122" height="1402" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-photo-glass-house.jpg' | asset_url }}{% endif %}" style="display: block; width: 100%; height: auto; aspect-ratio: 1122 / 1402; object-fit: cover; background: rgb(244, 239, 229);"/>
<div style="padding-bottom: clamp(8px, 2vw, 32px);">
<div style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 5.6vw, 78px); line-height: 1; letter-spacing: -0.03em; font-weight: 200; margin-top: 16px;">{{ section.settings.t2 }}</h1>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Hospitality 01 · Contract",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: A Midsummer system under Moo"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Contract",
      "default": "Contract"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Hotels & Residences",
      "default": "Hotels & Residences"
    }
  ]
}
{% endschema %}
