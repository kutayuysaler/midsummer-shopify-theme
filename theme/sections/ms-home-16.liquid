<section data-dc-tpl="538" style="border-top: 1px solid rgb(221, 214, 201); padding: clamp(60px, 8vw, 120px) clamp(18px, 5vw, 80px);">
<div style="max-width: 1560px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(28px, 5vw, 88px); align-items: end;">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(24px, 3vw, 38px); line-height: 1.1; letter-spacing: -0.02em; margin-top: 16px; max-width: 24ch;">{{ section.settings.t2 }}</h2>
</div>
<div style="display: flex; flex-direction: column; gap: 14px;"><style>#ms-newsletter { display: flex; flex-direction: column; gap: 14px; }</style>{%- form 'customer', id: 'ms-newsletter' -%}<input name="contact[tags]" type="hidden" value="newsletter"/>
<div style="display: flex; align-items: baseline; gap: 18px; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 12px;">
<input aria-label="Your email address" autocomplete="email" name="contact[email]" placeholder="Your email address" required="" style="flex: 1 1 0%; font-family: Newsreader, Georgia, serif; font-size: 19px; font-style: italic; color: #17140F;; background: transparent; border: 0; padding: 0; outline: none; min-width: 0;" type="email"/>
<button style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase;; background: none; border: 0; padding: 0; cursor: pointer; color: inherit;" type="submit">{{ section.settings.t3 }}</button>
</div>
<p style="font-size: 12px; line-height: 1.85; color: rgb(110, 103, 92); max-width: 46ch;">{{ section.settings.t4 }}</p>
{%- if form.posted_successfully? -%}<p role="status" style="font-family: Newsreader, Georgia, serif; font-size: 17px; font-style: italic;">Thank you. You will hear from the atelier.</p>{%- elsif form.errors -%}<p role="alert" style="font-size: 12px; color: #8B3A2B;">{{ form.errors.messages.email | default: 'Please check the address.' }}</p>{%- endif -%}{%- endform -%}</div>
</div>
</section>
{% schema %}
{
  "name": "Home 16 · Correspondence ",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Correspondence",
      "default": "Correspondence"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Occasional notes from the atelier.",
      "default": "Occasional notes from the atelier."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Subscribe",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "New systems, atelier openings and …",
      "default": "New systems, atelier openings and the occasional note on fibre. Never more than monthly."
    }
  ]
}
{% endschema %}
