{%- comment -%}
  The atelier's week, drawn as a timetable: each day a line from morning to evening, the hours it
  is open marked on it, and above, whether it is open at this moment in Milan. The address and
  the way to book sit beside it.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign days = s.days | split: ','
-%}
<section class="ms-hr" id="ms-hr-{{ section.id }}" aria-labelledby="ms-hr-h-{{ section.id }}" data-am="{{ s.am_open }}-{{ s.am_close }}" data-pm="{{ s.pm_open }}-{{ s.pm_close }}" data-days="{{ s.open_days }}">
  <div class="ms-hr__wrap">
    <div class="ms-hr__plate">
      {%- if s.eyebrow != blank -%}<div class="ms-hr__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
      <h2 class="ms-hr__h" id="ms-hr-h-{{ section.id }}">{{ s.heading }}</h2>
      <address class="ms-hr__addr">{{ s.address | newline_to_br }}</address>
      <p class="ms-hr__now" data-ms-hr-now aria-live="polite">{{ s.appointment_note }}</p>
      <div class="ms-hr__links">
        <a class="ms-hr__btn" href="{% render 'ms-link', to: 'enquire' %}">{{ s.book_label }}</a>
        {%- if s.map_url != blank -%}<a class="ms-hr__map" href="{{ s.map_url }}" target="_blank" rel="noopener">{{ s.map_label }}<svg viewBox="0 0 20 10" width="20" height="10" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M0 5h18M14 1l4 4-4 4"/></svg></a>{%- endif -%}
      </div>
    </div>
    <figure class="ms-hr__week">
      <div class="ms-hr__axis" aria-hidden="true"><span></span><div>{%- for h in (8..19) -%}{%- if h == 8 or h == 12 or h == 13 or h == 18 or h == 19 -%}<i data-h="{{ h }}" style="left: {{ h | minus: 8 | times: 100.0 | divided_by: 11 }}%">{{ h }}:00</i>{%- endif -%}{%- endfor -%}</div></div>
      {%- for d in days -%}
        {%- assign open_day = false -%}
        {%- assign idx = forloop.index | append: '' -%}
        {%- if s.open_days contains idx -%}{%- assign open_day = true -%}{%- endif -%}
        <div class="ms-hr__day{% unless open_day %} is-closed{% endunless %}" data-ms-hr-day="{{ forloop.index }}">
          <span class="ms-hr__dn">{{ d | strip }}</span>
          <div class="ms-hr__track">
            {%- if open_day -%}
              {%- assign a0 = s.am_open | minus: 8 | times: 100.0 | divided_by: 11 -%}{%- assign a1 = s.am_close | minus: s.am_open | times: 100.0 | divided_by: 11 -%}
              {%- assign p0 = s.pm_open | minus: 8 | times: 100.0 | divided_by: 11 -%}{%- assign p1 = s.pm_close | minus: s.pm_open | times: 100.0 | divided_by: 11 -%}
              <span class="ms-hr__bar" style="left: {{ a0 }}%; width: {{ a1 }}%"></span>
              <span class="ms-hr__bar" style="left: {{ p0 }}%; width: {{ p1 }}%"></span>
            {%- else -%}
              <span class="ms-hr__off">{{ s.closed_label }}</span>
            {%- endif -%}
            <span class="ms-hr__nowline" hidden></span>
          </div>
        </div>
      {%- endfor -%}
      <figcaption class="ms-hr__fc">{{ s.footnote }}</figcaption>
    </figure>
  </div>
</section>
<style>
  .ms-hr { border-top: 1px solid #DDD6C9; padding: clamp(56px, 8vw, 120px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0 auto; }
  .ms-hr__wrap { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 96px); align-items: start; }
  .ms-hr__plate { border: 1px solid #DDD6C9; background: #F6F1E9; padding: clamp(24px, 3vw, 40px); position: relative; }
  .ms-hr__plate::after { content: ''; position: absolute; inset: 6px; border: 1px solid #E4DBCD; pointer-events: none; }
  .ms-hr__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-hr__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(28px, 3vw, 42px); line-height: 1.08; letter-spacing: -0.02em; margin-top: 14px; }
  .ms-hr__addr { font-style: normal; font-family: Newsreader, Georgia, serif; font-size: 19px; line-height: 1.5; margin-top: 20px; color: #17140F; }
  .ms-hr__now { font-size: 13.5px; line-height: 1.7; color: #4A443B; margin-top: 18px; display: flex; align-items: baseline; gap: 10px; }
  .ms-hr__now b { font-weight: 500; color: #17140F; }
  .ms-hr__now i { width: 8px; height: 8px; border-radius: 50%; background: #B5AA97; flex: 0 0 auto; transform: translateY(-1px); }
  .ms-hr__now i.is-open { background: #6F8A5E; box-shadow: 0 0 0 4px rgba(111, 138, 94, .16); }
  .ms-hr__links { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 26px; position: relative; z-index: 1; }
  .ms-site a.ms-hr__btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; background: #17140F; color: #FBF9F5; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-site a.ms-hr__map { display: inline-flex; align-items: center; gap: 10px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid #17140F; padding-bottom: 4px; }
  .ms-hr__week { margin: 0; }
  .ms-hr__axis, .ms-hr__day { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 18px; align-items: center; }
  .ms-hr__axis > div { position: relative; height: 18px; }
  .ms-hr__axis i { position: absolute; transform: translateX(-50%); font-style: normal; font-size: 10.5px; letter-spacing: .1em; color: #9A8F7E; font-variant-numeric: tabular-nums; }
  .ms-hr__day { padding: 13px 0; border-bottom: 1px solid #ECE6DB; }
  .ms-hr__day:first-of-type { border-top: 1px solid #17140F; }
  .ms-hr__dn { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 18px; color: #17140F; }
  .ms-hr__day.is-closed .ms-hr__dn { color: #9A8F7E; }
  .ms-hr__day.is-today .ms-hr__dn { font-style: italic; }
  .ms-hr__track { position: relative; height: 12px; background: repeating-linear-gradient(90deg, transparent 0 calc(100% / 11 - 1px), #ECE6DB calc(100% / 11 - 1px) calc(100% / 11)); }
  .ms-hr__bar { position: absolute; top: 2px; bottom: 2px; background: #7E623B; border-radius: 1px; }
  .ms-hr__day.is-today .ms-hr__bar { background: #17140F; }
  .ms-hr__off { position: absolute; left: 0; top: 50%; transform: translateY(-50%); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #B5AA97; background: #FBF9F5; padding-right: 10px; }
  .ms-hr__nowline { position: absolute; top: -8px; bottom: -8px; border-left: 1px solid #B23A2E; }
  .ms-hr__nowline::before { content: ''; position: absolute; top: -3px; left: -3.5px; width: 6px; height: 6px; border-radius: 50%; background: #B23A2E; }
  .ms-hr__fc { font-size: 13px; line-height: 1.7; color: #6E675C; margin-top: 16px; }
  @media (max-width: 899px) {
    .ms-hr__wrap { grid-template-columns: minmax(0, 1fr); }
    .ms-hr__axis, .ms-hr__day { grid-template-columns: 74px minmax(0, 1fr); gap: 12px; }
    .ms-hr__dn { font-size: 16px; }
    .ms-hr__axis i[data-h="13"], .ms-hr__axis i[data-h="19"] { display: none; }
  }
</style>
<script>
  (function () {
    var root = document.getElementById('ms-hr-{{ section.id }}');
    if (!root || root.dataset.msReady) return;
    root.dataset.msReady = '1';
    // the time in Milan, whatever the visitor's clock says
    var parts;
    try { parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Rome', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date()); } catch (e) { return; }
    var get = function (t) { var p = parts.filter(function (x) { return x.type === t; })[0]; return p ? p.value : ''; };
    var dayIdx = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].indexOf(get('weekday')) + 1;
    var h = +get('hour') + (+get('minute')) / 60;
    var am = root.getAttribute('data-am').split('-').map(Number), pm = root.getAttribute('data-pm').split('-').map(Number);
    var openDays = root.getAttribute('data-days');
    var isOpenDay = openDays.indexOf(String(dayIdx)) > -1;
    var open = isOpenDay && ((h >= am[0] && h < am[1]) || (h >= pm[0] && h < pm[1]));
    var row = root.querySelector('[data-ms-hr-day="' + dayIdx + '"]');
    if (row) {
      row.classList.add('is-today');
      if (h >= 8 && h <= 19) { var ln = row.querySelector('.ms-hr__nowline'); ln.style.left = ((h - 8) / 11 * 100) + '%'; ln.hidden = false; }
    }
    var now = root.querySelector('[data-ms-hr-now]');
    var hhmm = get('hour') + ':' + get('minute');
    now.innerHTML = '<i class="' + (open ? 'is-open' : '') + '"></i><span><b>' + (open ? {{ s.open_label | json }} : {{ s.closed_now_label | json }}) + '</b> · ' + {{ s.milan_label | json }} + ' ' + hhmm + '. ' + {{ s.appointment_note | json }} + '</span>';
  })();
</script>

{% schema %}
{
  "name": "Atelier hours",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come and lie down." },
    { "type": "textarea", "id": "address", "label": "Address", "default": "Via Andegari 4\n20121 Milano" },
    { "type": "text", "id": "appointment_note", "label": "Note", "default": "By appointment, or by video call." },
    { "type": "text", "id": "book_label", "label": "Book label", "default": "Book a visit" },
    { "type": "url", "id": "map_url", "label": "Directions link" },
    { "type": "text", "id": "map_label", "label": "Directions label", "default": "Directions" },
    { "type": "header", "content": "Hours (24-hour clock, Milan time)" },
    { "type": "text", "id": "days", "label": "Day names, Monday first", "default": "Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday" },
    { "type": "text", "id": "open_days", "label": "Open days (1 = Monday)", "default": "1,2,3,4,5" },
    { "type": "range", "id": "am_open", "label": "Morning from", "min": 8, "max": 12, "step": 1, "default": 9 },
    { "type": "range", "id": "am_close", "label": "Morning until", "min": 10, "max": 14, "step": 1, "default": 12 },
    { "type": "range", "id": "pm_open", "label": "Afternoon from", "min": 12, "max": 16, "step": 1, "default": 13 },
    { "type": "range", "id": "pm_close", "label": "Afternoon until", "min": 15, "max": 19, "step": 1, "default": 18 },
    { "type": "text", "id": "closed_label", "label": "Closed day label", "default": "Closed" },
    { "type": "text", "id": "open_label", "label": "Open now", "default": "Open now" },
    { "type": "text", "id": "closed_now_label", "label": "Closed now", "default": "Closed now" },
    { "type": "text", "id": "milan_label", "label": "Milan time label", "default": "In Milan it is" },
    { "type": "text", "id": "footnote", "label": "Note under the week", "default": "Today is set in italics. Visits are by appointment; a video call can be arranged instead." }
  ],
  "presets": [ { "name": "Atelier hours" } ]
}
{% endschema %}
