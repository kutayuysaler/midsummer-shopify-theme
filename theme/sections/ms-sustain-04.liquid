{%- liquid
  assign ms_show = true
  if template.suffix == blank
    capture ms_here
      render 'ms-link', to: 'sustain'
    endcapture
    if ms_here != page.url
      assign ms_show = false
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="1279" style="padding: clamp(60px, 9vw, 140px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: clamp(32px, 6vw, 96px); align-items: end;">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 4vw, 54px); line-height: 1.04; letter-spacing: -0.025em; margin-top: 20px;">{{ section.settings.t2 }}</h2>
</div>
<div style="display: flex; flex-direction: column; gap: 22px;">
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); max-width: 46ch;">{{ section.settings.t3 }}</p>
<a data-ms="cta" data-ms-enquire="" href="{% render 'ms-link', to: 'contact' %}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 8px; width: fit-content;">{{ section.settings.t4 }}</a>
</div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Sustainability 04 · The a",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "The atelier",
      "default": "The atelier"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Come and lie down.",
      "default": "Come and lie down."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Via Andegari 4, Milano. By appoint…",
      "default": "Via Andegari 4, Milano. By appointment, Monday to Friday, confirmed by email within one working day."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Book a private appointment",
      "default": "Book a private appointment"
    }
  ]
}
{% endschema %}
