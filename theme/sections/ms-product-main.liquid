    { "type": "text", "id": "sizes_label", "label": "Standard sizes label (shown when the product has a Size option)", "default": "Standard sizes" },
    { "type": "text", "id": "height_label", "label": "Height label (shown when the product has metafield custom.height)", "default": "Height" },
