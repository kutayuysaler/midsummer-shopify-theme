    { "type": "paragraph", "content": "The product photographs on one large stage, with a strip of every picture beneath; then the name, the line under it (metafield custom.subtitle) and the enquiry." },
    { "type": "text", "id": "eyebrow", "label": "Label when not in a collection", "default": "Midsummer Milano" },
    { "type": "select", "id": "kind", "label": "What it is (said under the name, part of the page heading)", "default": "auto", "info": "A product metafield custom.kind (single line text) overrides this. Texts follow the store language; edit them under Edit default theme content, Ms.", "options": [
      { "value": "auto", "label": "Automatic: sleep system, or topper when the name says so" },
      { "value": "system", "label": "Natural-fibre sleep system" },
      { "value": "topper", "label": "Mattress topper" },
      { "value": "boxspring", "label": "Boxspring" },
      { "value": "boxspring_mattress", "label": "Boxspring and mattress" },
      { "value": "storage", "label": "Storage boxspring" },
