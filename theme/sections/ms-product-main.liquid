      thumbs.forEach(function (t, k) { var on = +t.getAttribute('data-ms-pm-to') === i; t.classList.toggle('is-on', on); if (on && t.classList.contains('ms-pm__thumb')) t.setAttribute('aria-current', 'true'); else t.removeAttribute('aria-current'); });
      var th = rail && rail.querySelector('.ms-pm__thumb.is-on');
      if (th && rail.scrollHeight > rail.clientHeight) rail.scrollTo({ top: th.offsetTop - rail.clientHeight / 2 + th.clientHeight / 2, behavior: 'smooth' });
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === shots.length - 1;
    }
    function go(i) {
      if (!track || !shots.length) return;
      i = Math.max(0, Math.min(shots.length - 1, i));
      if (phone.matches) track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
      mark(i);
    }
    if (track) {
      var tick = null;
      track.addEventListener('scroll', function () {
        if (!phone.matches || tick) return;
