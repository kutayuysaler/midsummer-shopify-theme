{%- comment -%}
  From drawing to delivery: the steps of a project on one line, numbered, each with a few words.
  A fine line runs through them and fills as the section comes into view. Steps are blocks.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-st" id="ms-st-{{ section.id }}" aria-labelledby="ms-st-h-{{ section.id }}">
  <div class="ms-st__head">
    {%- if s.eyebrow != blank -%}<div class="ms-st__eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="ms-st__h" id="ms-st-h-{{ section.id }}">{{ s.heading }}</h2>
  </div>
  <ol class="ms-st__list" role="list" style="--n: {{ section.blocks.size }}">
    {%- for b in section.blocks -%}
      <li class="ms-st__step" {{ b.shopify_attributes }} style="--i: {{ forloop.index0 }}">
        <span class="ms-st__dot" aria-hidden="true"></span>
        <span class="ms-st__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <span class="ms-st__t">{{ b.settings.title }}</span>
        {%- if b.settings.text != blank -%}<span class="ms-st__x">{{ b.settings.text }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ol>
  {%- if s.link_label != blank -%}
    <a class="ms-st__cta" href="{% render 'ms-link', to: 'enquire' %}">{{ s.link_label }}<svg viewBox="0 0 20 10" width="20" height="10" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M0 5h18M14 1l4 4-4 4"/></svg></a>
  {%- endif -%}
</section>
<style>
  .ms-st { border-top: 1px solid #DDD6C9; padding: clamp(56px, 8vw, 120px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0 auto; }
  .ms-st__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-st__h { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3.4vw, 48px); line-height: 1.08; letter-spacing: -0.025em; margin-top: 16px; max-width: 22ch; }
  .ms-st__list { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 0 clamp(16px, 2vw, 32px); position: relative; }
  .ms-st__list::before { content: ''; position: absolute; left: 0; right: 0; top: 6px; border-top: 1px solid #DDD6C9; }
  .ms-st__list::after { content: ''; position: absolute; left: 0; right: 0; top: 6px; border-top: 1px solid #17140F; transform-origin: left; transform: scaleX(var(--fill, 1)); transition: transform 2.4s cubic-bezier(.3, .6, .2, 1); }
  .ms-st__step { position: relative; display: grid; gap: 8px; align-content: start; padding-top: 30px; }
  .ms-st__dot { position: absolute; top: 0; left: 0; width: 13px; height: 13px; border-radius: 50%; background: #FBF9F5; border: 1px solid #17140F; z-index: 1; }
  .ms-st__no { font-family: Newsreader, Georgia, serif; font-size: 14px; color: #7E623B; font-variant-numeric: tabular-nums; }
  .ms-st__t { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(20px, 1.7vw, 24px); line-height: 1.2; }
  .ms-st__x { font-size: 13.5px; line-height: 1.75; color: #6E675C; max-width: 30ch; }
  .ms-site a.ms-st__cta { display: inline-flex; align-items: center; gap: 12px; margin-top: clamp(36px, 4vw, 56px); font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid #17140F; padding-bottom: 6px; }
  .ms-st.is-ready .ms-st__list { --fill: 0; }
  .ms-st.is-ready .ms-st__step { opacity: 0; transform: translateY(8px); transition: opacity .7s ease, transform .9s cubic-bezier(.2, .7, .2, 1); transition-delay: calc(var(--i) * 260ms + 200ms); }
  .ms-st.is-in .ms-st__list { --fill: 1; }
  .ms-st.is-in .ms-st__step { opacity: 1; transform: none; }
  @media (max-width: 899px) {
    .ms-st__list { grid-template-columns: minmax(0, 1fr); gap: 26px; padding-left: 28px; }
    .ms-st__list::before, .ms-st__list::after { left: 6px; right: auto; top: 0; bottom: 0; border-top: 0; border-left: 1px solid #DDD6C9; transform-origin: top; transform: scaleY(var(--fill, 1)); }
    .ms-st__list::after { border-left-color: #17140F; }
    .ms-st__step { padding-top: 0; }
    .ms-st__dot { left: -28px; top: 4px; }
  }
  @media (prefers-reduced-motion: reduce) { .ms-st.is-ready .ms-st__step { opacity: 1; transform: none; transition: none; } .ms-st.is-ready .ms-st__list { --fill: 1; } }
</style>
<script>
  (function () {
    var root = document.getElementById('ms-st-{{ section.id }}');
    if (!root || root.dataset.msReady || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.dataset.msReady = '1';
    root.classList.add('is-ready');
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { root.classList.add('is-in'); io.disconnect(); } }); }, { threshold: .3 });
    io.observe(root.querySelector('.ms-st__list'));
    setTimeout(function () { if (!root.classList.contains('is-in') && root.getBoundingClientRect().top < innerHeight) root.classList.add('is-in'); }, 4000);
  })();
</script>

{% schema %}
{
  "name": "Steps of a project",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A project, step by step" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From your drawing to the dressed bed." },
    { "type": "text", "id": "link_label", "label": "Link (to the enquiry page)", "default": "Open a project" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "The drawing" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [ { "name": "Steps of a project", "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ] } ]
}
{% endschema %}
