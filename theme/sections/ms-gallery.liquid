{%- comment -%} A run of photographs to scroll through sideways, each at its own proportion. {%- endcomment -%}
<section class="ms-gl">
  <div class="ms-gl__in">
    {%- if section.settings.heading != blank -%}
      <div class="ms-gl__head">
        {%- if section.settings.eyebrow != blank -%}<div class="ms-gl__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-gl__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
  </div>
  <div class="ms-gl__rail" data-ms="rail-x" tabindex="0" aria-label="{{ section.settings.heading | default: 'Photographs' | escape }}">
    {%- for block in section.blocks -%}
      {%- capture src -%}{% render 'ms-img', image: block.settings.image, fallback: block.settings.image_fallback, width: 1600 %}{%- endcapture -%}
      <figure class="ms-gl__fig" {{ block.shopify_attributes }}>
        {%- if src != blank -%}<img src="{{ src }}" alt="{{ block.settings.caption | escape }}" loading="{% if forloop.index > 2 %}lazy{% else %}eager{% endif %}" width="1600" height="1200">{%- endif -%}
        {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endfor -%}
  </div>
</section>
<style>
  .ms-gl { padding: clamp(40px, 6vw, 96px) 0 clamp(56px, 8vw, 120px); }
  .ms-gl__in { max-width: 1560px; margin: 0 auto; padding: 0 clamp(18px, 5vw, 80px); }
  .ms-gl__head { border-top: 1px solid #DDD6C9; padding-top: 26px; margin-bottom: clamp(28px, 4vw, 48px); }
  .ms-gl__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-gl__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 42px); letter-spacing: -.02em; font-weight: 200; margin-top: 12px; }
  .ms-gl__rail { display: flex; gap: clamp(12px, 1.6vw, 24px); overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 max(clamp(18px, 5vw, 80px), calc((100vw - 1560px) / 2 + clamp(18px, 5vw, 80px))); scroll-padding-inline: max(clamp(18px, 5vw, 80px), calc((100vw - 1560px) / 2 + clamp(18px, 5vw, 80px))); scrollbar-width: thin; scrollbar-color: #DDD6C9 transparent; }
  .ms-gl__fig { margin: 0; flex: 0 0 auto; scroll-snap-align: start; display: flex; flex-direction: column; gap: 12px; }
  .ms-gl__fig img { display: block; height: clamp(320px, 56vh, 620px); width: auto; max-width: 86vw; object-fit: cover; background: #F4EFE5; }
  .ms-gl__fig figcaption { font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: #6E675C; }
</style>
{% schema %}
{
  "name": "Photographs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photograph",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        { "type": "text", "id": "image_fallback", "label": "Photograph address" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [ { "name": "Photographs" } ]
}
{% endschema %}
