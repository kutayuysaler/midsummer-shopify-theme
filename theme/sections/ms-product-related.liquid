{%- comment -%}
  The foot of a product page: more from the same collection, four pieces, those of the same kind first
  (another bed system after a bed system, another mattress after a mattress), drawn as on the
  collection page: the photograph, what it is, the name, one line and its fibres.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign tier = nil
  for c in product.collections
    if c.handle == 'essentials' or c.handle == 'signature' or c.handle == 'icons' or c.handle == 'icon'
      assign tier = c
      break
    endif
  endfor
  if tier == nil
    assign tier = product.collections.first
  endif
  assign tname = tier.title
  case tier.handle
    when 'essentials'
      assign tname = 'Essentials'
    when 'signature'
      assign tname = 'Signature'
    when 'icons', 'icon'
      assign tname = 'Icons'
  endcase
  capture mk0
    render 'ms-kind', p: product
  endcapture
  assign k0 = mk0 | split: '|' | first
-%}
{%- if tier and tier.products_count > 1 -%}
<section class="ms-rel">
  <div class="ms-rel__head">
    <div>
      {%- if s.eyebrow != blank -%}<p class="ms-rel__eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2 class="ms-rel__title">{{ tname }}</h2>
    </div>
    {%- if s.link != blank -%}<a class="ms-rel__all" href="{{ tier.url }}">{{ s.link | replace: '[collection]', tname }}<span aria-hidden="true">→</span></a>{%- endif -%}
  </div>
  <div class="ms-rel__grid">
    {%- assign picked = ',' -%}
    {%- assign n = 0 -%}
    {%- for pass in (1..2) -%}
      {%- for p in tier.products -%}
        {%- if n >= 4 -%}{%- break -%}{%- endif -%}
        {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- assign pid = ',' | append: p.id | append: ',' -%}
        {%- if picked contains pid -%}{%- continue -%}{%- endif -%}
        {%- capture mk -%}{% render 'ms-kind', p: p %}{%- endcapture -%}
        {%- assign mkp = mk | split: '|' -%}
        {%- if pass == 1 and mkp[0] != k0 -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign picked = picked | append: p.id | append: ','
          assign n = n | plus: 1
          assign what = mkp[0]
          if what == 'system'
            capture what
              render 'ms-what', key: mkp[1]
            endcapture
            assign what = what | strip | default: 'system'
          endif
          case what
            when 'system'
              assign wl = s.what_system
            when 'mattress'
              assign wl = s.what_mattress
            when 'topper'
              assign wl = s.what_topper
            when 'boxspring'
              assign wl = s.what_boxspring
            when 'headboard'
              assign wl = s.what_headboard
            when 'outdoor'
              assign wl = s.what_outdoor
            else
              assign wl = ''
          endcase
          capture facts
            render 'ms-system-facts', key: mkp[1], handle: '', title: p.title
          endcapture
          assign fparts = facts | split: '~'
          assign fibres = fparts[0] | split: ','
          capture note
            render 'ms-product-note', title: p.title
          endcapture
          if mkp[0] == 'other' or mkp[0] == 'headboard' or mkp[0] == 'outdoor'
            assign note = ''
          endif
          assign sub = p.metafields.custom.subtitle.value | default: note
        -%}
        <a href="{{ p.url }}" class="ms-rel__card">
          <span class="ms-rel__img">
            {%- if p.featured_media -%}
              <img src="{{ p.featured_media | image_url: width: 700 }}" srcset="{{ p.featured_media | image_url: width: 500 }} 500w, {{ p.featured_media | image_url: width: 700 }} 700w, {{ p.featured_media | image_url: width: 1000 }} 1000w" sizes="(max-width: 760px) 50vw, 24vw" alt="{% if p.featured_media.alt != p.title %}{{ p.featured_media.alt | escape }}{% endif %}" width="700" height="875" loading="lazy">
            {%- endif -%}
          </span>
          {%- if wl != blank -%}<span class="ms-rel__what">{% render 'ms-kind-glyph', kind: what %}<span>{{ wl }}</span></span>{%- endif -%}
          <span class="ms-rel__name">{{ p.title }}</span>
          {%- if sub != blank -%}<span class="ms-rel__sub">{{ sub }}</span>{%- endif -%}
          {%- if fibres.size > 0 and fparts[0] != blank -%}
            <span class="ms-rel__marks" title="{{ fibres | join: ' · ' | escape }}">
              {%- for f in fibres -%}{% render 'ms-fibre-mark', name: f, size: 20 %}{%- endfor -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>
<style>
  .ms-rel { max-width: 1560px; margin: 0 auto; padding: clamp(70px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-rel__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; padding-top: 26px; border-top: 1px solid #DDD6C9; margin-bottom: clamp(32px, 4vw, 56px); }
  .ms-rel__eyebrow { font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; color: #7E623B; margin: 0 0 12px; }
  .ms-rel__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(34px, 4vw, 58px); line-height: 1; letter-spacing: -0.03em; margin: 0; }
  .ms-site .ms-rel__all { display: inline-flex; gap: 10px; align-items: center; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 5px; white-space: nowrap; }
  .ms-rel__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(36px, 4vw, 56px) clamp(16px, 2vw, 30px); align-items: start; }
  .ms-site .ms-rel__card { display: block; color: #17140F; }
  .ms-rel__img { display: block; overflow: hidden; background: #F1ECE3; aspect-ratio: 4 / 5; }
  .ms-rel__img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s cubic-bezier(.2, .7, .2, 1); }
  @media (hover: hover) { .ms-rel__card:hover .ms-rel__img img { transform: scale(1.03); } }
  .ms-rel__what { display: flex; align-items: center; gap: 9px; margin-top: 18px; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: #7E623B; }
  .ms-rel__what .ms-kg { width: 28px; height: 18px; color: #7E623B; }
  .ms-rel__name { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(22px, 1.9vw, 27px); line-height: 1.15; letter-spacing: -0.015em; margin-top: 8px; }
  .ms-rel__sub { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; line-height: 1.65; color: #6E675C; margin-top: 6px; }
  .ms-rel__marks { display: flex; flex-wrap: wrap; gap: 4px 6px; margin-top: 12px; padding-top: 10px; border-top: 1px solid #ECE6DB; color: #7E623B; }
  .ms-rel__marks .ms-fm { display: block; width: 20px; height: 20px; overflow: visible; }
  @media (max-width: 1080px) { .ms-rel__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .ms-rel__head { flex-direction: column; align-items: flex-start; }
    .ms-rel__grid { gap: 32px 14px; }
    .ms-rel__name { font-size: 19px; }
    .ms-rel__sub { font-size: 12px; }
    .ms-rel__what { font-size: 9px; letter-spacing: .14em; gap: 6px; }
    .ms-rel__what .ms-kg { width: 22px; height: 14px; }
    .ms-rel__marks .ms-fm { width: 15px; height: 15px; }
  }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Product · Also in",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "More from the collection" },
    { "type": "text", "id": "link", "label": "Link", "default": "All of [collection]", "info": "[collection] is replaced by the collection's name." },
    { "type": "header", "content": "What each piece is" },
    { "type": "text", "id": "what_system", "label": "Bed system", "default": "Bed system" },
    { "type": "text", "id": "what_mattress", "label": "Mattress", "default": "Mattress" },
    { "type": "text", "id": "what_topper", "label": "Topper", "default": "Topper" },
    { "type": "text", "id": "what_boxspring", "label": "Boxspring", "default": "Boxspring" },
    { "type": "text", "id": "what_headboard", "label": "Bed with headboard", "default": "Bed with headboard" },
    { "type": "text", "id": "what_outdoor", "label": "Outdoor", "default": "Outdoor" }
  ]
}
{% endschema %}
