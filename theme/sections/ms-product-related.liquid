{%- liquid
  assign tier = nil
  for c in product.collections
    if c.handle == 'essentials' or c.handle == 'signature' or c.handle == 'icons'
      assign tier = c
      break
    endif
  endfor
  if tier == nil
    assign tier = product.collections.first
  endif
-%}
{%- if tier and tier.products_count > 1 -%}
<section style="padding: clamp(70px, 10vw, 160px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 26px; margin-bottom: clamp(32px, 4vw, 56px); display: flex; justify-content: space-between; align-items: baseline; gap: 24px;">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 42px); letter-spacing: -0.02em;">{{ section.settings.heading }} {{ tier.title }}</h2>
<a data-ms="cta" href="{{ tier.url }}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.link }}</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(16px, 2.4vw, 36px);">
{%- assign shown = 0 -%}
{%- for p in tier.products -%}
{%- if p.id != product.id and shown < 4 -%}
{%- assign shown = shown | plus: 1 -%}
<a href="{{ p.url }}" style="display: block;">{%- if p.featured_media -%}<img alt="{{ p.title | escape }}" src="{{ p.featured_media | image_url: width: 900 }}" loading="lazy" width="900" height="1200" style="width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover;">{%- else -%}<span style="display: block; width: 100%; aspect-ratio: 3 / 4; background: rgb(241, 236, 227);"></span>{%- endif -%}<h3 style="font-family: Newsreader, Georgia, serif; font-size: 21px; margin-top: 16px;">{{ p.title }}</h3></a>
{%- endif -%}
{%- endfor -%}
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Product · Also in",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Also in" },
    { "type": "text", "id": "link", "label": "Link", "default": "The collection →" }
  ]
}
{% endschema %}
