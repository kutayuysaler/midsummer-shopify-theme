{%- liquid
  assign qa_show = true
  if template.name == 'product' and product != blank
    capture qk
      render 'ms-kind', p: product
    endcapture
    assign qkp = qk | split: '|'
    if qkp[0] == 'outdoor' or qkp[0] == 'other'
      assign qa_show = false
    endif
  endif
-%}
{%- if qa_show -%}
{%- comment -%}
  Questions and answers, grouped under a heading, opened one at a time. Marked up for search
  engines and AI assistants as an FAQ (schema.org FAQPage), so the answers can be quoted.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  # on a product page, [product] in a question or answer becomes the product's name
  assign pname = product.title | default: ''
  assign shown = 0
  for block in section.blocks
    if block.settings.when_hidden and settings.ms_show_prices
      continue
    endif
    assign shown = shown | plus: 1
  endfor
-%}
<section class="ms-qa{% if s.tone == 'sand' %} ms-qa--sand{% endif %}" id="{{ s.anchor | default: section.id }}">
  <div class="ms-qa__in">
    <div class="ms-qa__head">
      <div class="ms-qa__eyebrow">{{ s.eyebrow }}</div>
      <h2 class="ms-qa__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ms-qa__text">{{ s.text }}</p>{%- endif -%}
      {%- if s.link_label != blank -%}<a class="ms-qa__link" href="{% render 'ms-link', to: s.link_place %}{% if s.link_place == 'enquire' %}#enquire{% endif %}"{% if s.link_place == 'enquire' %} data-ms-landing{% endif %}>{{ s.link_label }}<span aria-hidden="true">→</span></a>{%- endif -%}
    </div>
    <div class="ms-qa__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.when_hidden and settings.ms_show_prices -%}{%- continue -%}{%- endif -%}
        <details class="ms-qa__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.q | replace: '[product]', pname }}</span><i aria-hidden="true"></i></summary>
          <div class="ms-qa__a">{{ block.settings.a | replace: '[product]', pname }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if shown > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign sep = '' -%}
    {%- for block in section.blocks -%}
    {%- if block.settings.when_hidden and settings.ms_show_prices -%}{%- continue -%}{%- endif -%}
    {{ sep }}{ "@type": "Question", "name": {{ block.settings.q | replace: '[product]', pname | strip_html | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | replace: '[product]', pname | strip_html | json }} } }
    {%- assign sep = ',' -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
<style>
  .ms-qa { background: #FBF9F5; color: #17140F; padding: clamp(64px, 8vw, 130px) clamp(18px, 5vw, 80px); }
  .ms-qa--sand { background: #F3EEE5; }
  .ms-qa__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(28px, 6vw, 120px); align-items: start; }
  .ms-qa__head { position: sticky; top: 120px; }
  .ms-qa__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-qa__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(32px, 3.6vw, 54px); line-height: 1.05; letter-spacing: -0.03em; margin-top: 18px; }
  .ms-site .ms-qa__text { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 20px; max-width: 40ch; }
  .ms-site a.ms-qa__link { display: inline-flex; gap: 12px; margin-top: 28px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-qa__list { border-top: 1px solid #17140F; }
  .ms-qa__item { border-bottom: 1px solid #DDD6C9; }
  .ms-qa__item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: clamp(18px, 2vw, 26px) 0; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(19px, 1.7vw, 24px); line-height: 1.35; }
  .ms-qa__item summary::-webkit-details-marker { display: none; }
  .ms-qa__item summary i { flex: 0 0 auto; width: 14px; height: 14px; position: relative; }
  .ms-qa__item summary i::before, .ms-qa__item summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: currentColor; transition: transform .35s ease; }
  .ms-qa__item summary i::after { transform: rotate(90deg); }
  .ms-qa__item[open] summary i::after { transform: rotate(0); }
  .ms-qa__a { font-size: 15px; line-height: 1.9; color: #4A443B; padding: 0 0 clamp(20px, 2.2vw, 30px); max-width: 66ch; }
  .ms-qa__a p + p { margin-top: 12px; }
  .ms-site .ms-qa__a a { color: #17140F; text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .ms-qa__in { grid-template-columns: minmax(0, 1fr); } .ms-qa__head { position: static; } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Questions & answers",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links to this part)" },
    { "type": "select", "id": "tone", "label": "Ground", "default": "ivory", "options": [{"value":"ivory","label":"Ivory"},{"value":"sand","label":"Sand"}] },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people ask." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "paragraph", "content": "On a product page, [product] in a question or answer is replaced by the product's name." },
    { "type": "select", "id": "link_place", "label": "Link to", "default": "enquire", "options": [{"value":"enquire","label":"Enquiry page"},{"value":"faq","label":"All questions"},{"value":"agents","label":"Agents & Resellers"},{"value":"collections","label":"Compare the collections"},{"value":"regen","label":"Made to last"},{"value":"materials","label":"Natural materials"}] }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "q", "label": "Question" },
      { "type": "richtext", "id": "a", "label": "Answer" },
      { "type": "checkbox", "id": "when_hidden", "label": "Only while prices are hidden", "default": false }
    ] }
  ],
  "presets": [{ "name": "Questions & answers" }]
}
{% endschema %}
