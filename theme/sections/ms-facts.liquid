{%- comment -%}
  The house at a glance: the facts a client, a journalist or an AI assistant looks for first,
  one per row, each with the page that tells it in full. Plain sentences, quotable as they stand.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-fx" id="{{ s.anchor | default: section.id }}">
  <div class="ms-fx__in">
    <header class="ms-fx__head">
      <div class="ms-fx__eyebrow">{{ s.eyebrow }}</div>
      {%- if template.name == 'page' and s.use_page_title -%}
        <h1 class="ms-fx__title">{{ page.title }}</h1>
      {%- else -%}
        <h1 class="ms-fx__title">{{ s.heading }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}<div class="ms-fx__text">{{ s.text }}</div>{%- endif -%}
    </header>
    <dl class="ms-fx__list">
      {%- for block in section.blocks -%}
        <div class="ms-fx__row" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.label }}</dt>
          <dd>
            {{ block.settings.value }}
            {%- if block.settings.link_place != 'none' and block.settings.link_label != blank -%}
              <a class="ms-fx__more" href="{% render 'ms-link', to: block.settings.link_place %}">{{ block.settings.link_label }}<span aria-hidden="true"> →</span></a>
            {%- endif -%}
          </dd>
        </div>
      {%- endfor -%}
      {%- if s.contact_label != blank -%}
        <div class="ms-fx__row">
          <dt>{{ s.contact_label }}</dt>
          <dd>
            <p>{%- if shop.email != blank -%}<a href="mailto:{{ shop.email }}">{{ shop.email }}</a>{%- endif -%}</p>
            <a class="ms-fx__more" href="{% render 'ms-link', to: 'enquire' %}#enquire" data-ms-landing>{{ s.enquire_label }}<span aria-hidden="true"> →</span></a>
          </dd>
        </div>
      {%- endif -%}
    </dl>
  </div>
</section>
{%- if template.name == 'page' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": {{ page.title | json }},
    "url": "{{ shop.url }}{{ page.url }}",
    "inLanguage": "{{ request.locale.iso_code }}",
    "mainEntity": { "@id": "{{ shop.url }}/#organization" }
  }
</script>
{%- endif -%}
<style>
  .ms-fx { background: #FBF9F5; padding: clamp(120px, 12vw, 180px) clamp(18px, 5vw, 80px) clamp(64px, 8vw, 120px); }
  .ms-fx__in { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(36px, 6vw, 110px); align-items: start; }
  .ms-fx__head { position: sticky; top: 120px; }
  .ms-fx__eyebrow { font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: #7E623B; }
  .ms-fx__title { font-family: Newsreader, Georgia, serif; font-size: clamp(38px, 4.6vw, 68px); line-height: 1.02; letter-spacing: -0.035em; font-weight: 200; margin-top: 18px; }
  .ms-fx__text { font-family: Newsreader, Georgia, serif; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; font-weight: 200; color: #4A443B; margin-top: 22px; max-width: 34ch; }
  .ms-fx__text p { margin: 0; }
  .ms-fx__list { margin: 0; border-top: 1px solid #17140F; }
  .ms-fx__row { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 24px; padding: 20px 0; border-bottom: 1px solid #DDD6C9; }
  .ms-fx__row dt { font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; color: #6E675C; padding-top: 4px; }
  .ms-fx__row dd { margin: 0; font-size: 15px; line-height: 1.7; color: #2E2A24; }
  .ms-fx__row dd p { margin: 0; }
  .ms-fx__row dd p + p { margin-top: 8px; }
  .ms-site .ms-fx__row dd a { color: #17140F; text-decoration: underline; text-decoration-color: #C9BFAE; text-underline-offset: 3px; }
  .ms-site .ms-fx__row dd a.ms-fx__more { display: inline-block; margin-top: 8px; font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  @media (max-width: 900px) {
    .ms-fx__in { grid-template-columns: minmax(0, 1fr); }
    .ms-fx__head { position: static; }
  }
  @media (max-width: 560px) {
    .ms-fx__row { grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 18px 0; }
  }
</style>

{% schema %}
{
  "name": "At a glance",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor (for links to this part)" },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "At a glance" },
    { "type": "checkbox", "id": "use_page_title", "label": "Use the page's title as the heading", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Midsummer Milano at a glance" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "contact_label", "label": "Contact row label (empty hides it)", "default": "Contact" },
    { "type": "text", "id": "enquire_label", "label": "Enquiry link", "default": "Write to the atelier" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fact", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "richtext", "id": "value", "label": "Fact" },
      { "type": "select", "id": "link_place", "label": "Read more on", "default": "none", "options": [
        { "value": "none", "label": "No link" },
        { "value": "story", "label": "Our story" },
        { "value": "handmade", "label": "Handmade in Italy" },
        { "value": "materials", "label": "Natural materials" },
        { "value": "regen", "label": "Made to last · 15 + 15" },
        { "value": "loro", "label": "Loro Piana Interiors" },
        { "value": "collections", "label": "Compare the collections" },
        { "value": "quiz", "label": "Find your Midsummer" },
        { "value": "atelier", "label": "The atelier" },
        { "value": "agents", "label": "Agents & Resellers" },
        { "value": "faq", "label": "Questions" },
        { "value": "professionals", "label": "Professionals" },
        { "value": "hospitality", "label": "Hospitality" },
        { "value": "press", "label": "Press" }
      ] },
      { "type": "text", "id": "link_label", "label": "Link" }
    ] }
  ],
  "max_blocks": 30,
  "presets": [{ "name": "At a glance" }]
}
{% endschema %}
