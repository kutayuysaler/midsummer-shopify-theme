{%- comment -%}
  Midsummer Milano — questions and answers.
  Renders an accordion and the matching FAQPage graph, so the answers can be
  quoted by search engines and AI assistants.
{%- endcomment -%}

{%- liquid
  assign rows = section.blocks | where: 'type', 'qa'
-%}

{%- if rows.size > 0 -%}
<div class="ms-faq" id="ms-faq-{{ section.id }}">
  <div class="ms-faq__intro">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ms-faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ms-faq__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ms-faq__body">{{ section.settings.body }}</div>
    {%- endif -%}
  </div>

  <div class="ms-faq__list">
    {%- for row in rows -%}
      <details class="ms-faq__row" {% if row.settings.open %}open{% endif %} {{ row.shopify_attributes }}>
        <summary class="ms-faq__q">
          <span>{{ row.settings.question }}</span>
          <span class="ms-faq__mark" aria-hidden="true"></span>
        </summary>
        <div class="ms-faq__a">{{ row.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{%- if section.settings.enable_schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for row in rows -%}
          {
            "@type": "Question",
            "name": {{ row.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ row.settings.answer | strip_html | strip_newlines | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .ms-faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .ms-faq__eyebrow {
    margin: 0;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-faq-accent);
  }
  .ms-faq__heading {
    margin: 18px 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 3.6vw, 50px);
    font-weight: 200;
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .ms-faq__body {
    margin-top: 22px;
    font-size: 15px;
    line-height: 1.95;
    color: var(--ms-faq-muted);
    max-width: 44ch;
  }
  .ms-faq__row {
    border-top: 1px solid var(--ms-faq-rule);
  }
  .ms-faq__row:last-child { border-bottom: 1px solid var(--ms-faq-rule); }
  .ms-faq__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading--family);
    font-size: clamp(18px, 1.9vw, 23px);
    line-height: 1.3;
  }
  .ms-faq__q::-webkit-details-marker { display: none; }
  .ms-faq__mark {
    position: relative;
    flex: 0 0 auto;
    width: 11px;
    height: 11px;
    margin-top: 6px;
  }
  .ms-faq__mark::before,
  .ms-faq__mark::after {
    content: '';
    position: absolute;
    inset-block-start: 5px;
    inset-inline-start: 0;
    width: 11px;
    height: 1px;
    background: var(--ms-faq-accent);
    transition: transform 0.25s ease;
  }
  .ms-faq__mark::after { transform: rotate(90deg); }
  .ms-faq__row[open] .ms-faq__mark::after { transform: rotate(0deg); }
  .ms-faq__a {
    padding: 0 0 26px;
    font-size: 15px;
    line-height: 1.95;
    max-width: 62ch;
  }
  .ms-faq__a p { margin: 0 0 14px; }
  .ms-faq__a p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) {
    .ms-faq { grid-template-columns: minmax(0, 1fr); }
  }
{% endstylesheet %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  }
  #ms-faq-{{ section.id }} {
    --ms-faq-accent: {{ section.settings.accent_color }};
    --ms-faq-muted: {{ section.settings.muted_color }};
    --ms-faq-rule: {{ section.settings.rule_color }};
    color: {{ section.settings.text_color }};
  }
{%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Questions and answers",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people ask before they commit." },
    { "type": "richtext", "id": "body", "label": "Body" },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQ structured data", "default": true, "info": "Lets search engines and AI assistants quote these answers. Turn on for one page only (the FAQ page): Google asks for repeated FAQ content to be marked up once." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17140F" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#4A443B" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#9A7B4F" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#DDD6C9" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "info": "Answer the question in the first sentence. That sentence is what gets quoted." },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Questions and answers", "blocks": [{ "type": "qa" }, { "type": "qa" }, { "type": "qa" }] }
  ]
}
{% endschema %}
