{%- comment -%}
  Midsummer Milano — the house photographic grade.
  One filter over every photograph in the page body, matched to the images
  graded by hand: warm, matte, blacks lifted, highlights held back.
  Files with "graded" in their filename already carry the grade and are
  skipped, so nothing is graded twice. Upload future hand-graded photographs
  with "graded" in the name and they will be left alone.
{%- endcomment -%}

{%- if section.settings.enabled -%}
  {%- liquid
    assign sep = section.settings.warmth | divided_by: 100.0
    assign sat = section.settings.saturation | divided_by: 100.0
    assign con = section.settings.contrast | divided_by: 100.0
    assign bri = section.settings.brightness | divided_by: 100.0
  -%}
  <style>
    #MainContent img:not([src*="graded"]):not([src*="logo"]):not(.ms-materials__img):not(.ms-marquee__img){% if section.settings.include_video %},
    #MainContent video{% endif %} {
      filter: sepia({{ sep }}) saturate({{ sat }}) contrast({{ con }}) brightness({{ bri }});
    }
    #MainContent [class*="swatch"] img { filter: none; }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Photographic grade",
  "settings": [
    { "type": "paragraph", "content": "One grade over every photograph in the page body. Files with \"graded\" in their filename are skipped, because they were graded by hand." },
    { "type": "checkbox", "id": "enabled", "label": "Apply the grade", "default": true },
    { "type": "range", "id": "warmth", "label": "Warmth", "min": 0, "max": 30, "step": 1, "unit": "%", "default": 10 },
    { "type": "range", "id": "saturation", "label": "Saturation", "min": 70, "max": 110, "step": 1, "unit": "%", "default": 96 },
    { "type": "range", "id": "contrast", "label": "Contrast", "info": "Below 100 lifts the blacks and holds the highlights back.", "min": 80, "max": 105, "step": 1, "unit": "%", "default": 90 },
    { "type": "range", "id": "brightness", "label": "Brightness", "min": 90, "max": 106, "step": 1, "unit": "%", "default": 98 },
    { "type": "checkbox", "id": "include_video", "label": "Grade video too", "default": true }
  ]
}
{% endschema %}
