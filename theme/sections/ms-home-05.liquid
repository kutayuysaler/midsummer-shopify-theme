<section data-dc-tpl="248" style="padding: clamp(80px, 12vw, 190px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(28px, 5vw, 88px); align-items: end;">
<div style="display: flex; flex-direction: column; gap: 24px;">
<div style="display: flex; align-items: center; gap: 11px; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);"><svg aria-hidden="true" height="22" style="display: block; flex: 0 0 auto;" viewbox="0 0 24 24" width="22"><path d="M4 20 C4 11 11 4 20 4 C20 13 13 20 4 20 Z" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path><path d="M4 20 L16 8" fill="none" stroke="#9A7B4F" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"></path></svg><span>{{ section.settings.t1 }}</span></div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 4.4vw, 62px); line-height: 1.04; letter-spacing: -0.025em;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); max-width: 46ch;">{{ section.settings.t3 }}</p>
<a data-ms="cta" href="/pages/midsummer-milanos-regeneration-service" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 8px; width: fit-content;">{{ section.settings.t4 }}</a>
</div>
<figure style="margin: 0px; display: flex; flex-direction: column; gap: 14px;">
<img alt="Hand-sewn detail" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/files/Paisleydettaglio.jpg?v=1788246821&amp;width=1200{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/>
<figcaption style="font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: rgb(110, 103, 92);">{{ section.settings.t5 }}</figcaption>
</figure>
</div>
</section>
{% schema %}
{
  "name": "Home 05 · Handmade in Ita",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: Hand-sewn detail"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Handmade in Italy",
      "default": "Handmade in Italy"
    },
    {
      "type": "html",
      "id": "t2",
      "label": "Two artisans.One bed.",
      "default": "Two artisans.<br/>One bed."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "No production line. The same two h…",
      "default": "No production line. The same two hands that open the spring core sew the final seam, which is why a change of dimension, height or fabric is a decision rather than an exception."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Heritage & craft",
      "default": "Heritage & craft"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Hand-sewn side wall, Paisley. Via …",
      "default": "Hand-sewn side wall, Paisley. Via Andegari 4, Milano."
    }
  ]
}
{% endschema %}
