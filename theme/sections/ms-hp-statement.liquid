{%- comment -%}
  The home page's opening words: one sentence, centred, with room around it.
{%- endcomment -%}
<section class="ms-hs">
  <div class="ms-hs__in">
    <div class="ms-hs__eyebrow">{{ section.settings.eyebrow }}</div>
    <p class="ms-hs__text">{{ section.settings.text }}</p>
    {%- if section.settings.signature != blank -%}<div class="ms-hs__sig">{{ section.settings.signature }}</div>{%- endif -%}
    {%- if section.settings.link_label != blank -%}
      <a class="ms-hs__link" href="{% render 'ms-link', to: section.settings.link_place %}">{{ section.settings.link_label }}</a>
    {%- endif -%}
  </div>
</section>
<style>
  .ms-hs { background: #FBF9F5; color: #17140F; padding: clamp(110px, 15vw, 240px) clamp(18px, 5vw, 80px); text-align: center; }
  .ms-hs__in { max-width: 1080px; margin: 0 auto; }
  .ms-hs__eyebrow { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: #7E623B; }
  .ms-hs__text { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 4.2vw, 62px); line-height: 1.16; letter-spacing: -0.03em; margin: clamp(26px, 3vw, 40px) auto 0; max-width: 24ch; text-wrap: balance; }
  .ms-hs__sig { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 17px; color: #6E675C; margin-top: clamp(26px, 3vw, 40px); }
  .ms-site .ms-hs__link { display: inline-block; margin-top: clamp(34px, 4vw, 56px); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
</style>

{% schema %}
{
  "name": "Home · Opening words",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Midsummer Milano" },
    { "type": "textarea", "id": "text", "label": "Sentence", "default": "There is a way of sleeping that goes beyond rest. It is beauty, wellbeing and respect for nature, made by hand in Milan." },
    { "type": "text", "id": "signature", "label": "Signature", "info": "Optional line under the sentence." },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Our story" },
    { "type": "select", "id": "link_place", "label": "Link to", "default": "story", "options": [{"value":"story","label":"Our story"},{"value":"handmade","label":"Handmade in Italy"},{"value":"materials","label":"Natural materials"},{"value":"collections","label":"Compare the collections"}] }
  ],
  "presets": [{ "name": "Home · Opening words" }]
}
{% endschema %}
