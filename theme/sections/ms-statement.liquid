{%- comment -%}
  A statement and its reasoning: a serif line on the left, the text on the right. The
  text can be the page's own content, so what is written in admin reads in the design.
{%- endcomment -%}
{%- liquid
  case section.settings.tone
    when 'stone'
      assign bg = '#F1ECE3'
      assign fg = '#17140F'
      assign body_c = '#4A443B'
      assign muted = '#6E675C'
      assign rule = '#DDD6C9'
    when 'ink'
      assign bg = '#17140F'
      assign fg = '#FBF9F5'
      assign body_c = 'rgba(251, 249, 245, .78)'
      assign muted = 'rgba(251, 249, 245, .55)'
      assign rule = 'rgba(251, 249, 245, .22)'
    else
      assign bg = '#FBF9F5'
      assign fg = '#17140F'
      assign body_c = '#4A443B'
      assign muted = '#6E675C'
      assign rule = '#DDD6C9'
  endcase
  assign body = section.settings.text
  if section.settings.use_content
    if page.content != blank
      assign body = page.content
    elsif article.content != blank
      assign body = article.content
    endif
  endif
-%}
<section class="ms-st" style="background: {{ bg }}; color: {{ fg }}; --muted: {{ muted }}; --body: {{ body_c }}; --rule: {{ rule }};">
  <div class="ms-st__in{% if section.settings.rule %} has-rule{% endif %}">
    <div class="ms-st__lead">
      {%- if section.settings.eyebrow != blank -%}<div class="ms-st__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="ms-st__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="ms-st__body">
      {%- if body != blank -%}<div class="ms-st__text">{{ body }}</div>{%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a data-ms="cta" class="ms-st__link"
          href="{% if section.settings.enquire %}{% render 'ms-link', to: 'contact' %}{% else %}{{ section.settings.link | default: '#' }}{% endif %}"
          {% if section.settings.enquire %}data-ms-enquire{% endif %}>{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .ms-st { padding: clamp(72px, 10vw, 160px) clamp(18px, 5vw, 80px); }
  .ms-st__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(28px, 6vw, 110px); align-items: start; }
  .ms-st__in.has-rule { border-top: 1px solid var(--rule); padding-top: clamp(28px, 4vw, 56px); }
  .ms-st__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: var(--muted); }
  .ms-st__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.6vw, 52px); line-height: 1.12; letter-spacing: -.025em; font-weight: 200; margin-top: 20px; max-width: 20ch; }
  .ms-st__text { font-size: 15px; line-height: 1.95; color: var(--body); max-width: 60ch; }
  .ms-st__text > * + * { margin-top: 1.1em; }
  .ms-st__text p { margin: 0; }
  .ms-st__text p + p { margin-top: 1.1em; }
  .ms-st__text h2, .ms-st__text h3, .ms-st__text h4 { font-family: Newsreader, Georgia, serif; font-weight: 200; color: inherit; line-height: 1.2; margin-top: 1.6em; }
  .ms-st__text h2 { font-size: clamp(22px, 2.4vw, 30px); }
  .ms-st__text h3, .ms-st__text h4 { font-size: clamp(19px, 2vw, 24px); }
  .ms-st__text img { width: 100%; height: auto; margin: 1.4em 0; }
  .ms-st__text a { color: inherit; border-bottom: 1px solid currentColor; }
  .ms-st__text em { font-family: Newsreader, Georgia, serif; font-size: 1.12em; }
  .ms-site .ms-st__link { display: inline-block; margin-top: 26px; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 7px; color: inherit; }
</style>
{% schema %}
{
  "name": "Statement and text",
  "settings": [
    { "type": "select", "id": "tone", "label": "Ground", "default": "ivory", "options": [ { "value": "ivory", "label": "Ivory" }, { "value": "stone", "label": "Stone" }, { "value": "ink", "label": "Ink" } ] },
    { "type": "checkbox", "id": "rule", "label": "Hairline above", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "textarea", "id": "heading", "label": "Statement", "default": "A statement, in a sentence." },
    { "type": "checkbox", "id": "use_content", "label": "Use the page's own content as the text", "default": false },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>The reasoning behind it, in a paragraph or two.</p>" },
    { "type": "text", "id": "link_label", "label": "Link" },
    { "type": "url", "id": "link", "label": "Link address" },
    { "type": "checkbox", "id": "enquire", "label": "Link opens the enquiry", "default": false }
  ],
  "presets": [ { "name": "Statement and text" } ]
}
{% endschema %}
