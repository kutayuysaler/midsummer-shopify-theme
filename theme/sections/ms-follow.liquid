{%- comment -%}
  Follow the atelier: the house's accounts, large, with a row of photographs that lead to
  Instagram. Accounts come from Theme settings → Midsummer · Social and WhatsApp.
{%- endcomment -%}
{%- liquid
  assign ig = settings.ms_social_instagram
  assign handle = section.settings.handle
  if handle == blank and ig != blank
    assign handle = ig | split: 'instagram.com/' | last | remove: '/' | prepend: '@'
  endif
-%}
<section class="ms-fw">
  <div class="ms-fw__in">
    <div class="ms-fw__head">
      <div>
        <div class="ms-fw__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- if ig != blank -%}
          <a class="ms-fw__handle" href="{{ ig }}" target="_blank" rel="noopener">{{ handle }}</a>
        {%- else -%}
          <div class="ms-fw__handle">{{ section.settings.heading }}</div>
        {%- endif -%}
      </div>
      <div class="ms-fw__side">
        <p class="ms-fw__text">{{ section.settings.text }}</p>
        <div class="ms-fw__icons">{% render 'ms-social' %}</div>
      </div>
    </div>
    {%- assign app_blocks = section.blocks | where: 'type', '@app' -%}
    {%- if app_blocks.size > 0 -%}
      <div class="ms-fw__app">{%- for block in section.blocks -%}{%- if block.type == '@app' -%}{% render block %}{%- endif -%}{%- endfor -%}</div>
    {%- else -%}
    <div class="ms-fw__grid" data-ms-ig="{{ settings.ms_instagram_token | escape }}">
      {%- for i in (1..5) -%}
        {%- liquid
          assign k = 'image_' | append: i
          assign img = section.settings[k]
          case i
            when 1
              assign fb = 'ms-photo-fresco-bed.jpg' | asset_url
            when 2
              assign fb = 'ms-photo-atelier-parrots.jpg' | asset_url
            when 3
              assign fb = 'ms-photo-paisley-throw.jpg' | asset_url
            when 4
              assign fb = 'ms-photo-shepherd.jpg' | asset_url
            else
              assign fb = 'ms-photo-red-throw.jpg' | asset_url
          endcase
        -%}
        <a class="ms-fw__tile" href="{{ ig | default: '#' }}" target="_blank" rel="noopener" aria-label="{{ handle | escape }} on Instagram">
          <img src="{% if img != blank %}{{ img | image_url: width: 700 }}{% else %}{{ fb }}{% endif %}" alt="" width="700" height="700" loading="lazy">
          <span class="ms-fw__glyph" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" fill-rule="evenodd" d="M7 1h10a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H7a6 6 0 0 1-6-6V7a6 6 0 0 1 6-6Zm0 2.1A3.9 3.9 0 0 0 3.1 7v10A3.9 3.9 0 0 0 7 20.9h10a3.9 3.9 0 0 0 3.9-3.9V7A3.9 3.9 0 0 0 17 3.1H7Zm5 3.6a5.3 5.3 0 1 1 0 10.6 5.3 5.3 0 0 1 0-10.6Zm0 2.1a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4Zm5.6-3.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5Z"/></svg></span>
        </a>
      {%- endfor -%}
    </div>
    {%- if settings.ms_instagram_token != blank -%}
    <script>
      /* the latest posts, straight from Instagram; an hour's memory; the photographs above if it cannot answer */
      (function () {
        var g = document.currentScript.previousElementSibling, tok = g && g.getAttribute('data-ms-ig');
        if (!tok) return;
        var KEY = 'ms-ig-v1', now = Date.now(), cached = null;
        try { cached = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) {}
        function paint(items) {
          var tiles = g.querySelectorAll('.ms-fw__tile');
          items.slice(0, tiles.length).forEach(function (it, i) {
            var src = it.media_type === 'VIDEO' ? it.thumbnail_url : it.media_url; if (!src) return;
            var a = tiles[i], img = a.querySelector('img');
            a.href = it.permalink; img.src = src; img.alt = (it.caption || '').split('\n')[0].slice(0, 120); a.classList.add('is-live');
          });
          g.classList.add('is-live');
        }
        if (cached && cached.items && now - cached.t < 36e5) paint(cached.items);
        else fetch('https://graph.instagram.com/me/media?fields=id,caption,media_type,media_url,thumbnail_url,permalink,timestamp&limit=12&access_token=' + encodeURIComponent(tok))
          .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })
          .then(function (j) { var items = (j.data || []).filter(function (x) { return x.media_url || x.thumbnail_url; }); if (!items.length) return; paint(items); try { localStorage.setItem(KEY, JSON.stringify({ t: now, items: items.slice(0, 12) })); } catch (e) {} })
          .catch(function () { if (cached && cached.items) paint(cached.items); });
        // once a week, ask Instagram to extend the token, so it never lapses while the site is visited
        try { var last = +localStorage.getItem('ms-ig-refresh') || 0; if (now - last > 6048e5) { localStorage.setItem('ms-ig-refresh', String(now)); fetch('https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=' + encodeURIComponent(tok)).catch(function () {}); } } catch (e) {}
      })();
    </script>
    {%- endif -%}
    {%- endif -%}
  </div>
</section>
<style>
  .ms-fw { background: #FBF9F5; color: #17140F; padding: clamp(72px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-fw__in { max-width: 1560px; margin: 0 auto; }
  .ms-fw__head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 4fr); gap: clamp(24px, 5vw, 96px); align-items: end; }
  .ms-fw__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-site .ms-fw__handle { display: inline-block; font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(40px, 6.4vw, 104px); line-height: 1; letter-spacing: -0.04em; margin-top: 18px; color: #17140F; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat; transition: background-size .7s cubic-bezier(.2,.7,.2,1); padding-bottom: 6px; }
  .ms-site .ms-fw__handle:hover { background-size: 100% 1px; }
  .ms-fw__text { font-size: 15px; line-height: 1.9; color: #4A443B; max-width: 40ch; }
  .ms-fw__icons { margin-top: 22px; }
  .ms-fw__icons .ms-social { gap: 10px; }
  .ms-site .ms-fw__icons .ms-social a { width: 48px; height: 48px; }
  .ms-fw__icons .ms-social svg { width: 19px; height: 19px; }
  .ms-fw__grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(8px, 1vw, 16px); margin-top: clamp(40px, 5vw, 72px); }
  .ms-site .ms-fw__tile { position: relative; display: block; aspect-ratio: 1; overflow: hidden; background: #EFE9DE; color: #FBF9F5; }
  .ms-fw__tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1), filter .6s ease; }
  .ms-fw__glyph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(23, 20, 15, .38); opacity: 0; transition: opacity .45s ease; }
  .ms-fw__tile:hover img { transform: scale(1.06); }
  .ms-fw__app { margin-top: clamp(40px, 5vw, 72px); }
  .ms-fw__tile:hover .ms-fw__glyph { opacity: 1; }
  @media (max-width: 860px) {
    .ms-fw__head { grid-template-columns: minmax(0, 1fr); }
    .ms-fw__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ms-fw__tile:nth-child(n+4) { display: none; }
  }
</style>

{% schema %}
{
  "name": "Follow the atelier",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Follow the atelier" },
    { "type": "text", "id": "handle", "label": "Handle", "info": "Leave empty to use the Instagram address from Theme settings." },
    { "type": "text", "id": "heading", "label": "Heading without Instagram", "default": "Midsummer Milano" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Beds in the houses they were made for, fibres before they are laid, and the atelier at work. Follow us, or write to us on WhatsApp." },
    { "type": "image_picker", "id": "image_1", "label": "Photograph 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photograph 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photograph 3" },
    { "type": "image_picker", "id": "image_4", "label": "Photograph 4" },
    { "type": "image_picker", "id": "image_5", "label": "Photograph 5" },
    { "type": "paragraph", "content": "The latest posts appear by themselves with an Instagram access token (Theme settings → Midsummer · Social and WhatsApp), or with an Instagram feed app's block added here. The photographs above are shown until then." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Follow the atelier" }]
}
{% endschema %}
