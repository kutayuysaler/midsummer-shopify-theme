<section class="ms-hero" data-dc-tpl="196" style="position: relative; height: 100vh; height: 100svh; min-height: 560px; overflow: hidden; background: rgb(23, 20, 15);">
{%- comment -%}
  The film. Chosen under Film (from Files), Shopify's own web copies are used: the adaptive stream
  where the browser plays it (Safari, iPhone), else an MP4 of at most 720 lines on a phone and
  1080 on a computer. The film address (the original upload, at full size) is only the fallback.
  Nothing is downloaded until the page itself is up; the poster shows meanwhile: the Poster frame
  if one is chosen, else the film's cover image in Files. On a data-saving or very slow connection
  the poster stays.
{%- endcomment -%}
{%- liquid
  assign film = section.settings.video
  assign f_hls = ''
  assign f_sm = ''
  assign f_lg = ''
  assign h_sm = 0
  assign h_lg = 0
  if film != blank
    for fsrc in film.sources
      if fsrc.format == 'm3u8'
        assign f_hls = fsrc.url
      elsif fsrc.format == 'mp4'
        assign fh = fsrc.height | plus: 0
        if fh <= 720 and fh > h_sm
          assign f_sm = fsrc.url
          assign h_sm = fh
        endif
        if fh <= 1080 and fh > h_lg
          assign f_lg = fsrc.url
          assign h_lg = fh
        endif
      endif
    endfor
  endif
  if f_lg == ''
    assign f_lg = f_sm
  endif
  if f_lg == ''
    capture f_lg
      render 'ms-en', v: section.settings.video_url, id: 'video_url', sid: section.id
    endcapture
  endif
  if f_sm == ''
    assign f_sm = f_lg
  endif
  assign f_poster = section.settings.poster
  if f_poster == blank and film != blank
    assign f_poster = film.preview_image
  endif
-%}
{%- if request.design_mode and film == blank -%}
<p class="ms-hero__note" style="position: absolute; z-index: 3; top: 96px; left: 16px; right: 16px; max-width: 560px; margin: 0 auto; padding: 12px 16px; background: rgba(251, 249, 245, .95); color: rgb(23, 20, 15); border: 1px dashed #B23A2E; font: 13px/1.5 system-ui, sans-serif;">Seen only in the editor: no film is chosen under <strong>Film (from Files)</strong>, so the page plays the film address, which is the original upload at full size and slow to start. Choose the film there and Shopify's smaller web copies play instead, in every language.</p>
{%- endif -%}
<video class="ms-hero__film" autoplay="" loop="" muted="" playsinline="" {% if f_poster != blank %}poster="{{ f_poster | image_url: width: 1600 }}"{% endif %} preload="none" data-hls="{{ f_hls }}" data-sm="{{ f_sm }}" data-lg="{{ f_lg }}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
</video>
<div class="ms-hero__shade" style="position: absolute; inset: 0px; background: linear-gradient(rgba(10, 8, 6, 0.28) 0%, rgba(10, 8, 6, 0.04) 40%, rgba(10, 8, 6, 0.5) 100%);"></div>
<div class="ms-hero__words" style="position: absolute; inset: 0px; display: flex; flex-direction: column; justify-content: space-between; gap: clamp(28px, 5vh, 48px); padding: calc(78px + clamp(26px, 4.5vw, 72px)) clamp(26px, 4.5vw, 72px) clamp(26px, 4.5vw, 72px); color: rgb(251, 249, 245);">
<div aria-hidden="true"></div>
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px;">
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(38px, 5.4vw, 80px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 200; max-width: 15ch; text-shadow: 0 2px 30px rgba(10, 8, 6, .35);">{% liquid
  capture ms_l45
  render 'ms-t', v: 'Handmade luxury beds and mattresses, built one by one.'
  endcapture
  render 'ms-tr', value: section.settings.t1, default: ms_l45, key: 'ms.home.h1', en: 't1', sid: section.id
%}</h1>
<div style="max-width: 380px; display: flex; flex-direction: column; gap: 20px;">
<p class="ms-hero-words" style="font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(16px, 1.8vw, 21px); line-height: 1.55; opacity: 1; text-shadow: 0 1px 18px rgba(10, 8, 6, .55), 0 0 2px rgba(10, 8, 6, .35);">{% liquid
  capture ms_l46
  render 'ms-t', v: 'We design dreams. Every bed is made by hand in Italy, to order, one at a time.'
  endcapture
  render 'ms-tr', value: section.settings.t2, default: ms_l46, key: 'ms.home.lede', en: 't2', sid: section.id
%}</p>
<div style="display: flex; flex-direction: column; align-items: flex-start; gap: 12px;"><a class="scp1" data-ms-enquire="" href="{% render 'ms-link', to: 'contact' %}" style="display: inline-flex; align-items: center; gap: 16px; min-height: 54px; padding: 0px 28px; background: rgb(251, 249, 245); color: rgb(23, 20, 15); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;"><span>{% liquid
  capture ms_l47
  render 'ms-t', v: 'Book a private appointment'
  endcapture
  render 'ms-tr', value: section.settings.t3, default: ms_l47, key: 'ms.home.cta', en: 't3', sid: section.id
%}</span><svg aria-hidden="true" height="13" style="display: block;" viewbox="0 0 16 16" width="13"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.1"></path></svg></a><span style="font-size: 12.5px; line-height: 1.5; opacity: 0.88;">{% liquid
  capture ms_l48
  render 'ms-t', v: 'At our Milan atelier, or by video call'
  endcapture
  render 'ms-tr', value: section.settings.t4, default: ms_l48, key: 'ms.home.cta_note', en: 't4', sid: section.id
%}</span></div>
</div>
</div>
</div>
</section>
<style>
  @media (max-width: 700px) {
    .ms-site .ms-hero { height: auto !important; min-height: 0 !important; display: flex; flex-direction: column; padding-top: 84px; }
    .ms-site .ms-hero .ms-hero__film { position: relative !important; inset: auto !important; display: block; width: 100%; height: auto !important; aspect-ratio: var(--ms-film-ar, 16 / 9); object-fit: cover; }
    .ms-site .ms-hero .ms-hero__shade { display: none; }
    .ms-site .ms-hero .ms-hero__words { position: relative !important; inset: auto !important; padding: 30px 22px 38px !important; gap: 0 !important; }
    .ms-site .ms-hero .ms-hero__words > div[aria-hidden] { display: none; }
    .ms-site .ms-hero h1 { font-size: clamp(32px, 9vw, 40px) !important; }
  }
</style>
<script>
  (function () {
    var v = document.currentScript && document.currentScript.previousElementSibling;
    while (v && !(v.classList && v.classList.contains('ms-hero'))) v = v.previousElementSibling;
    var f = v && v.querySelector('.ms-hero__film');
    if (!f) return;
    function ar() { if (f.videoWidth && f.videoHeight) v.style.setProperty('--ms-film-ar', f.videoWidth + ' / ' + f.videoHeight); }
    f.addEventListener('loadedmetadata', ar);
    var c = navigator.connection || {};
    if (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')) return;
    function start() {
      if (f.getAttribute('data-go')) return;
      f.setAttribute('data-go', '1');
      var hls = f.getAttribute('data-hls');
      var url = hls && f.canPlayType('application/vnd.apple.mpegurl') ? hls : (window.innerWidth > 1024 ? f.getAttribute('data-lg') : f.getAttribute('data-sm'));
      if (!url) return;
      if (url === hls) {
        // a browser that offers the stream but cannot play it falls back to the MP4
        f.addEventListener('error', function () {
          var mp4 = window.innerWidth > 1024 ? f.getAttribute('data-lg') : f.getAttribute('data-sm');
          if (mp4 && f.getAttribute('src') !== mp4) { f.src = mp4; var q = f.play(); if (q && q.catch) q.catch(function () {}); }
        }, { once: true });
      }
      f.src = url;
      f.preload = 'auto';
      var p = f.play();
      if (p && p.catch) p.catch(function () {});
    }
    function soon() { if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 }); else setTimeout(start, 300); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', soon); else soon();
  })();
</script>
{% schema %}
{
  "name": "Home 01 · Handmade luxury",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Film (from Files)",
      "info": "Choose the film here: Shopify then plays its smaller web copies, not the original upload."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Film address",
      "default": "https://cdn.shopify.com/videos/c/o/v/430183abbe91494d9da5e69fc7ad5c51.mp4"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster frame",
      "info": "Shown until the film plays. Left empty, the film's cover image in Files is used."
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Handmade luxury beds and mattresse…",
      "default": "Handmade luxury beds and mattresses, built one by one."
    },
    {
      "type": "text",
      "id": "t2",
      "label": "We design dreams. Every bed is mad…",
      "default": "We design dreams. Every bed is made by hand in Italy, to order, one at a time."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Book a private appointment",
      "default": "Book a private appointment"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "At our Milan atelier, or by video …",
      "default": "At our Milan atelier, or by video call"
    }
  ]
}
{% endschema %}
