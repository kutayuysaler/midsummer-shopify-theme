<section data-dc-tpl="196" style="position: relative; height: min(88vh, 860px); min-height: 560px; overflow: hidden; background: rgb(23, 20, 15);">
<video autoplay="" loop="" muted="" playsinline="" poster="{% if section.settings.poster != blank %}{{ section.settings.poster | image_url: width: 2400 }}{% else %}https://midsummer-milano.com/cdn/shop/files/Untitled_Project_5_b49a7740-07fa-45f1-8b4f-464d951b0772.jpg?v=1683816726&amp;width=1600{% endif %}" preload="metadata" src="{% if section.settings.video != blank %}{{ section.settings.video.sources | where: 'format', 'mp4' | map: 'url' | first | default: section.settings.video_url }}{% else %}{{ section.settings.video_url }}{% endif %}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;">
</video>
<div style="position: absolute; inset: 0px; background: linear-gradient(rgba(10, 8, 6, 0.28) 0%, rgba(10, 8, 6, 0.04) 40%, rgba(10, 8, 6, 0.5) 100%);"></div>
<div style="position: absolute; inset: 0px; display: flex; flex-direction: column; justify-content: space-between; gap: clamp(28px, 5vh, 48px); padding: calc(78px + clamp(26px, 4.5vw, 72px)) clamp(26px, 4.5vw, 72px) clamp(26px, 4.5vw, 72px); color: rgb(251, 249, 245);">
<div aria-hidden="true"></div>
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 28px;">
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(38px, 5.4vw, 80px); line-height: 1.02; letter-spacing: -0.03em; font-weight: 200; max-width: 15ch;">{{ section.settings.t1 }}</h1>
<div style="max-width: 380px; display: flex; flex-direction: column; gap: 20px;">
<p style="font-family: Newsreader, Georgia, serif; font-style: italic; font-size: clamp(16px, 1.8vw, 21px); line-height: 1.55; opacity: 0.95;">{{ section.settings.t2 }}</p>
<div style="display: flex; flex-direction: column; align-items: flex-start; gap: 12px;"><a class="scp1" data-ms-enquire="" href="/pages/contact" style="display: inline-flex; align-items: center; gap: 16px; min-height: 54px; padding: 0px 28px; background: rgb(251, 249, 245); color: rgb(23, 20, 15); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;"><span>{{ section.settings.t3 }}</span><svg aria-hidden="true" height="13" style="display: block;" viewbox="0 0 16 16" width="13"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.1"></path></svg></a><span style="font-size: 12.5px; line-height: 1.5; opacity: 0.88;">{{ section.settings.t4 }}</span></div>
</div>
</div>
</div>
</section>
{% schema %}
{
  "name": "Home 01 · Handmade luxury",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Film (from Files)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Film address",
      "default": "https://cdn.shopify.com/videos/c/o/v/6402710ddfa4466385db6859abb41d96.mov"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster frame"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Handmade luxury beds and mattresse…",
      "default": "Handmade luxury beds and mattresses, built one by one."
    },
    {
      "type": "text",
      "id": "t2",
      "label": "We design dreams. Every bed is mad…",
      "default": "We design dreams. Every bed is made by two artisans, start to finish."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Book a private appointment",
      "default": "Book a private appointment"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "At our Milan atelier, or by video …",
      "default": "At our Milan atelier, or by video call"
    }
  ]
}
{% endschema %}
