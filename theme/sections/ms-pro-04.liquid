{%- liquid
  assign ms_show = true
  if template.suffix == blank
    assign ms_show = false
    capture ms_here
      render 'ms-link', to: 'professionals'
    endcapture
    if ms_here == page.url
      assign ms_show = true
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="888" style="background: rgb(241, 236, 227); padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px);">
<div style="max-width: 1560px; margin: 0px auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(32px, 6vw, 96px); align-items: center;">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.8vw, 52px); line-height: 1.06; letter-spacing: -0.02em; margin-top: 18px;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 22px; max-width: 50ch;">{{ section.settings.t3 }}</p>
<div style="display: flex; flex-wrap: wrap; gap: 28px; align-items: center; margin-top: 32px;">
<a data-ms-enquire="" href="{% render 'ms-link', to: 'contact' %}" style="display: inline-block; background: rgb(23, 20, 15); color: rgb(251, 249, 245); border: 0px; padding: 20px 40px; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; cursor: pointer;">{{ section.settings.t4 }}</a>
<a data-ms="cta" data-ms-enquire="" href="{% render 'ms-link', to: 'contact' %}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 7px;">{{ section.settings.t5 }}</a>
</div>
</div>
<img alt="A Midsummer bed dressed in Loro Piana Interiors fabric" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}https://midsummer-milano.com/cdn/shop/products/LOROPIANA_IMG_9595.jpg?v=1748612004&amp;width=1400{% endif %}" style="width: 100%; aspect-ratio: 4 / 5; object-fit: cover;"/>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Professionals 04 · Projec",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: A Midsummer bed dressed in L"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Project desk",
      "default": "Project desk"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Open a project file.",
      "default": "Open a project file."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "One contact at the atelier for the…",
      "default": "One contact at the atelier for the life of the project, from first specification to installation and the fifteen-year check-up."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Open a project",
      "default": "Open a project"
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Request the trade brochure",
      "default": "Request the trade brochure"
    }
  ]
}
{% endschema %}
