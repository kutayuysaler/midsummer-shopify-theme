<div style="font-size: 14px; line-height: 1.6; max-width: 24ch;">{{ section.settings.t3 }}</div>
<div style="font-size: 12.5px; line-height: 1.8; color: rgb(110, 103, 92); max-width: 30ch;">{{ section.settings.t4 }}</div>
