{%- comment -%}
  Clients, in their own words. Hidden until at least one quote is added in the theme editor:
  only real words from real clients, with their permission.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="ms-vo">
  <div class="ms-vo__in">
    <div class="ms-vo__eyebrow">{{ section.settings.eyebrow }}</div>
    <div class="ms-vo__list">
      {%- for block in section.blocks -%}
        <figure class="ms-vo__item" {{ block.shopify_attributes }}>
          <blockquote>“{{ block.settings.quote }}”</blockquote>
          <figcaption><span>{{ block.settings.name }}</span>{%- if block.settings.place != blank -%}<em>{{ block.settings.place }}</em>{%- endif -%}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ms-vo { background: #FBF9F5; color: #17140F; padding: clamp(72px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-vo__in { max-width: 1560px; margin: 0 auto; }
  .ms-vo__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; text-align: center; }
  .ms-vo__list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: clamp(32px, 5vw, 88px); margin-top: clamp(36px, 4.4vw, 64px); }
  .ms-vo__item { margin: 0; }
  .ms-vo__item blockquote { margin: 0; font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(22px, 2.2vw, 32px); line-height: 1.32; letter-spacing: -0.015em; }
  .ms-vo__item figcaption { margin-top: 20px; display: flex; flex-direction: column; gap: 4px; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-vo__item figcaption em { font-style: normal; color: #6E675C; }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Clients' words",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "In their words" },
    { "type": "paragraph", "content": "Hidden until a quote is added. Use only real clients' words, with their permission." }
  ],
  "blocks": [
    { "type": "quote", "name": "Quote", "settings": [
      { "type": "textarea", "id": "quote", "label": "Words" },
      { "type": "text", "id": "name", "label": "Name or initials" },
      { "type": "text", "id": "place", "label": "Place or project" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Clients' words" }]
}
{% endschema %}
