{%- comment -%}
  Places to go next, as pictures: each card names a page of the house and says why it matters
  here. Internal links that read as part of the page.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-lc{% if s.tone == 'sand' %} ms-lc--sand{% endif %}">
  <div class="ms-lc__in">
    <div class="ms-lc__head">
      <div class="ms-lc__eyebrow">{{ s.eyebrow }}</div>
      <h2 class="ms-lc__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ms-lc__text">{{ s.text }}</p>{%- endif -%}
    </div>
    <div class="ms-lc__grid" data-n="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="ms-lc__card" href="{% render 'ms-link', to: b.place %}{% if b.place == 'enquire' %}#enquire{% endif %}"{% if b.place == 'enquire' %} data-ms-landing{% endif %} {{ block.shopify_attributes }}>
          <span class="ms-lc__img"><img src="{% render 'ms-img', image: b.image, fallback: b.image_fallback, width: 900 %}" alt="" width="900" height="1125" loading="lazy"></span>
          <span class="ms-lc__name">{{ b.title }}</span>
          <span class="ms-lc__line">{{ b.text }}</span>
          <span class="ms-lc__go" aria-hidden="true">→</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ms-lc { background: #FBF9F5; color: #17140F; padding: clamp(64px, 8vw, 130px) clamp(18px, 5vw, 80px); }
  .ms-lc--sand { background: #F3EEE5; }
  .ms-lc__in { max-width: 1560px; margin: 0 auto; }
  .ms-lc__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-lc__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(32px, 3.8vw, 58px); line-height: 1.05; letter-spacing: -0.03em; margin-top: 18px; max-width: 18ch; }
  .ms-site .ms-lc__text { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 18px; max-width: 54ch; }
  .ms-lc__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: clamp(18px, 2.2vw, 36px); margin-top: clamp(36px, 4.4vw, 64px); }
  .ms-site .ms-lc__card { position: relative; display: flex; flex-direction: column; color: inherit; }
  .ms-lc__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #EFE9DE; }
  .ms-lc__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ms-lc__card:hover .ms-lc__img img { transform: scale(1.04); }
  .ms-lc__name { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(21px, 1.8vw, 26px); letter-spacing: -0.01em; margin-top: 18px; padding-right: 28px; }
  .ms-lc__line { font-size: 13.5px; line-height: 1.75; color: #4A443B; margin-top: 8px; }
  .ms-lc__go { align-self: flex-start; margin-top: 12px; font-size: 16px; color: #7E623B; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .ms-lc__card:hover .ms-lc__go { transform: translateX(6px); }
</style>

{% schema %}
{
  "name": "Places to go next",
  "settings": [
    { "type": "select", "id": "tone", "label": "Ground", "default": "ivory", "options": [{"value":"ivory","label":"Ivory"},{"value":"sand","label":"Sand"}] },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "For your project" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything you will need, in one house." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    { "type": "card", "name": "Card", "settings": [
      { "type": "select", "id": "place", "label": "Goes to", "default": "collections", "options": [{"value":"collections","label":"Compare the collections"},{"value":"essentials","label":"Essentials"},{"value":"signature","label":"Signature"},{"value":"icons","label":"Icons"},{"value":"loro","label":"Loro Piana Interiors"},{"value":"materials","label":"Natural materials"},{"value":"handmade","label":"Handmade in Italy"},{"value":"regen","label":"Made to last · 15 + 15"},{"value":"sleep-culture","label":"Sleep culture"},{"value":"story","label":"Our story"},{"value":"professionals","label":"Architects & Interior Designers"},{"value":"hospitality","label":"Hospitality & Contract"},{"value":"agents","label":"Agents & Resellers"},{"value":"atelier","label":"The Milano atelier"},{"value":"faq","label":"Questions & care"},{"value":"journal","label":"Journal"},{"value":"press","label":"Press"},{"value":"quiz","label":"Find your Midsummer"},{"value":"enquire","label":"Enquiry page"}] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "textarea", "id": "text", "label": "Line" },
      { "type": "image_picker", "id": "image", "label": "Photograph" },
      { "type": "text", "id": "image_fallback", "label": "Photograph address" }
    ] }
  ],
  "presets": [{ "name": "Places to go next" }]
}
{% endschema %}
