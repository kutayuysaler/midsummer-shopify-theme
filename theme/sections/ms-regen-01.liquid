{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,collections,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'regen' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="969" style="position: relative; height: min(78vh, 760px); min-height: 360px; overflow: hidden;">
<img alt="" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}https://cdn.shopify.com/s/files/1/0697/8829/files/Untitled_Project_4_copia.jpg?v=1775117113&amp;width=2400{% endif %}" style="position: absolute; inset: 0px; width: 100%; height: 100%; object-fit: cover;"/>
<div style="position: absolute; inset: 0px; background: linear-gradient(rgba(10, 8, 6, 0.25), rgba(10, 8, 6, 0.55));"></div>
<div style="position: absolute; inset: 0px; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(26px, 5vw, 88px); color: rgb(251, 249, 245);">
<div style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; opacity: 0.8;">{{ section.settings.t1 }}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(34px, 5.8vw, 82px); line-height: 1; letter-spacing: -0.035em; margin-top: 18px; max-width: 18ch;">{{ section.settings.t2 }}</h1>
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(17px, 2vw, 24px); font-style: italic; margin-top: 18px; opacity: 0.9;">{{ section.settings.t3 }}</p>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "15 + 15 01 · Midsummer Mi",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Midsummer Milano × Sustainability",
      "default": "Midsummer Milano × Sustainability"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "The 15 + 15 mattress regeneration …",
      "default": "The 15 + 15 mattress regeneration service."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Built so well, fifteen years later…",
      "default": "Built so well, fifteen years later it barely needs anything."
    }
  ]
}
{% endschema %}
