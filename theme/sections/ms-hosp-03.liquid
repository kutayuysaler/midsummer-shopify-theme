      "type": "text",
      "id": "t1",
      "label": "Volume programmes",
      "default": "Volume programmes"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "Phased production aligned to floor…",
      "default": "Phased production aligned to floor handovers, with consistent fibres across every key."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Standards",
      "default": "Standards"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Fire-retardancy and contract certi…",
      "default": "Fire-retardancy and contract certification prepared per market, documented for your file."
    },
    {
      "type": "text",
      "id": "t5",
      "label": "Maintenance",
      "default": "Maintenance"
    },
    {
      "type": "text",
      "id": "t6",
      "label": "Housekeeping protocols per system,…",
