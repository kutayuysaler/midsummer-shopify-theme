{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,atelier,collections,compare,contact,download-the-dream,facts,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'hospitality' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="909" style="padding: 0px clamp(18px, 5vw, 80px) clamp(60px, 9vw, 150px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: clamp(26px, 4vw, 64px);">
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 26px);">{{ section.settings.t1 }}</h2><p style="font-size: 14px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t2 }}</p></div>
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 26px);">{{ section.settings.t3 }}</h2><p style="font-size: 14px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t4 }}</p></div>
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 26px);">{{ section.settings.t5 }}</h2><p style="font-size: 14px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t6 }}</p></div>
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: 24px;"><h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2.2vw, 26px);">{{ section.settings.t7 }}</h2><p style="font-size: 14px; line-height: 1.9; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t8 }}</p></div>
</div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Hospitality 03 · Volume p",
  "settings": [
