{%- liquid
  assign tier_key = ''
  for c in product.collections
    if c.handle == 'essentials' or c.handle == 'signature' or c.handle == 'icons'
      assign tier_key = c.handle
      assign tier_title = c.title
      break
    endif
  endfor
  case tier_key
    when 'essentials'
      assign numeral = 'I'
    when 'signature'
      assign numeral = 'II'
    when 'icons'
      assign numeral = 'III'
  endcase
  capture note
    render 'ms-product-note', title: product.title
  endcapture
  if product.handle contains 'paisley'
    assign note = 'Loro Piana Interiors, over six layers of springs. The fabric leads; the springwork does the rest.'
  endif
  assign tagline = product.metafields.custom.subtitle.value | default: note
  if tagline == blank
    assign tagline = product.description | strip_html | truncatewords: 22
  endif
  assign media = product.featured_media
-%}
<section style="padding: clamp(40px, 6vw, 96px) clamp(18px, 5vw, 80px) clamp(52px, 8vw, 120px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: clamp(34px, 6vw, 104px); align-items: center;">
{%- if media -%}
<img alt="{{ media.alt | default: product.title | escape }}" src="{{ media | image_url: width: 1800 }}" srcset="{{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1400 }} 1400w, {{ media | image_url: width: 1800 }} 1800w" sizes="(max-width: 760px) 100vw, 50vw" width="{{ media.width }}" height="{{ media.height }}" style="display: block; width: 100%; height: auto; aspect-ratio: {{ media.aspect_ratio | default: 0.8 }}; object-fit: contain; background: rgb(244, 239, 229);">
{%- else -%}
<span style="display: block; width: 100%; aspect-ratio: 4 / 5; background: rgb(244, 239, 229);"></span>
{%- endif -%}
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{% if tier_key != blank %}{{ tier_title }} · {{ numeral }}{% else %}{{ product.type | default: product.vendor }}{% endif %}</div>
<h1 style="font-family: Newsreader, Georgia, serif; font-size: clamp(46px, 7vw, 112px); line-height: 0.9; letter-spacing: -0.045em; font-weight: 200; margin-top: clamp(12px, 1.6vw, 22px);">{{ product.title }}</h1>
{%- if tagline != blank -%}
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 2.2vw, 28px); line-height: 1.42; letter-spacing: -0.015em; font-weight: 200; color: rgb(74, 68, 59); margin-top: clamp(20px, 2.6vw, 34px); max-width: 28ch; text-wrap: pretty;">{{ tagline }}</p>
{%- endif -%}
{%- if settings.ms_show_prices -%}
<p style="font-size: 13px; letter-spacing: 0.12em; color: rgb(110, 103, 92); margin-top: 22px;">{{ product.price | money }}</p>
{%- endif -%}
</div>
</div>
</section>
{% schema %}
{ "name": "Product · Opening", "settings": [ { "type": "paragraph", "content": "The product's first photograph, collection, title and subtitle (metafield custom.subtitle)." } ] }
{% endschema %}
