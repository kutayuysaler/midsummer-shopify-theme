{%- liquid
  assign ms_show = true
  if template.name == 'page'
    assign ms_show = false
    assign ms_ours = 'agents-and-resellers,agents-resellers,collections,contact,download-the-dream,faq,find-your-midsummer,handmade-in-italy,hospitality,loro-piana-interiors,natural-materials,professionals,regeneration,salone-2026,sleep-assesment,sleep-culture,story,sustainability' | split: ','
    if ms_ours contains template.suffix
      assign ms_show = true
    else
      capture ms_key
        render 'ms-page-key'
      endcapture
      assign ms_want = 'regen' | split: ','
      if ms_want contains ms_key
        assign ms_show = true
      endif
    endif
  endif
-%}
{%- if ms_show -%}
<section data-dc-tpl="1000" style="padding: clamp(60px, 9vw, 150px) clamp(18px, 5vw, 80px); max-width: 1560px; margin: 0px auto;">
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 4.2vw, 58px); line-height: 1.04; letter-spacing: -0.025em; margin-top: 18px; max-width: 22ch;">{{ section.settings.t2 }}</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: clamp(26px, 4vw, 64px); margin-top: clamp(48px, 6vw, 96px); align-items: start;">
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 24px;">
<div style="font-family: Newsreader, Georgia, serif; font-size: clamp(56px, 8vw, 110px); line-height: 0.9; font-weight: 200; letter-spacing: -0.04em;">{{ section.settings.t3 }}</div>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t4 }}</div>
<p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t5 }}</p>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 24px;">
<div style="font-family: Newsreader, Georgia, serif; font-size: clamp(56px, 8vw, 110px); line-height: 0.9; font-weight: 200; letter-spacing: -0.04em; color: rgb(154, 123, 79);">{{ section.settings.t6 }}</div>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t7 }}</div>
<p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t8 }}</p>
</div>
<div style="border-top: 1px solid rgb(23, 20, 15); padding-top: 24px;">
<div style="font-family: Newsreader, Georgia, serif; font-size: clamp(56px, 8vw, 110px); line-height: 0.9; font-weight: 200; letter-spacing: -0.04em;">{{ section.settings.t9 }}</div>
<div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); margin-top: 18px;">{{ section.settings.t10 }}</div>
<p style="font-size: 14px; line-height: 1.95; color: rgb(74, 68, 59); margin-top: 12px;">{{ section.settings.t11 }}</p>
</div>
</div>
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 3vw, 38px); line-height: 1.42; margin-top: clamp(56px, 7vw, 120px); max-width: 32ch; font-style: italic; color: rgb(74, 68, 59);">{{ section.settings.t12 }}</p>
</section>
{%- endif -%}
