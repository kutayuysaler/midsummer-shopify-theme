{%- comment -%}
  Letters from the atelier: the newsletter. Subscribers are saved as customers in Shopify,
  tagged "newsletter" and opted in to email marketing.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="ms-lt">
  <div class="ms-lt__in">
    <div>
      <div class="ms-lt__eyebrow">{{ s.eyebrow }}</div>
      <h2 class="ms-lt__title">{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="ms-lt__text">{{ s.text }}</p>{%- endif -%}
    </div>
    {%- form 'customer', id: 'ms-letters', class: 'ms-lt__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="ms-lt__ok" role="status">{{ s.thanks }}</p>
      {%- else -%}
        <div class="ms-lt__field">
          <label class="ms-visually-hidden" for="ms-letters-email">{{ s.placeholder }}</label>
          <input id="ms-letters-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ s.placeholder | escape }}">
          <button type="submit">{{ s.button }}</button>
        </div>
        {%- if form.errors -%}<p class="ms-lt__err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        <p class="ms-lt__fine">{{ s.fine }} <a href="{% render 'ms-link', to: 'privacy' %}">{{ s.privacy }}</a></p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
<style>
  .ms-lt { background: #F3EEE5; color: #17140F; padding: clamp(56px, 7vw, 110px) clamp(18px, 5vw, 80px); }
  .ms-lt__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(28px, 6vw, 120px); align-items: end; }
  .ms-lt__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-lt__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(30px, 3.4vw, 52px); line-height: 1.06; letter-spacing: -0.03em; margin-top: 16px; }
  .ms-site .ms-lt__text { font-size: 15px; line-height: 1.9; color: #4A443B; margin-top: 16px; max-width: 46ch; }
  .ms-lt__field { display: flex; border-bottom: 1px solid #17140F; }
  .ms-lt__field input { flex: 1 1 auto; min-width: 0; background: transparent; border: 0; padding: 16px 0; font-size: 17px; font-family: Newsreader, Georgia, serif; color: #17140F; outline: none; }
  .ms-lt__field input::placeholder { color: #8A8275; }
  .ms-lt__field button { flex: 0 0 auto; background: none; border: 0; padding: 0 0 0 20px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #17140F; cursor: pointer; min-height: 48px; }
  .ms-site .ms-lt__fine { font-size: 12px; line-height: 1.7; color: #6E675C; margin-top: 14px; }
  .ms-site .ms-lt__fine a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .ms-site .ms-lt__ok { font-family: Newsreader, Georgia, serif; font-size: 22px; }
  .ms-site .ms-lt__err { font-size: 13px; color: #8A2E1E; margin-top: 10px; }
  @media (max-width: 860px) { .ms-lt__in { grid-template-columns: minmax(0, 1fr); } }
</style>

{% schema %}
{
  "name": "Letters from the atelier",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Letters from the atelier" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Letters from the atelier, in your inbox." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New systems before they are shown, notes from the Journal, and the dates the atelier opens for the Salone." },
    { "type": "text", "id": "placeholder", "label": "Field", "default": "Your email" },
    { "type": "text", "id": "button", "label": "Button", "default": "Subscribe" },
    { "type": "text", "id": "fine", "label": "Small print", "default": "You can unsubscribe from any letter." },
    { "type": "text", "id": "privacy", "label": "Privacy link", "default": "Privacy" },
    { "type": "text", "id": "thanks", "label": "Thank-you line", "default": "Thank you. The next letter will find you." }
  ],
  "presets": [{ "name": "Letters from the atelier" }]
}
{% endschema %}
