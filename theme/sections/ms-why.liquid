{%- comment -%}
  Why Midsummer: what a Midsummer bed is, set beside what a luxury bed usually is. One row
  per point; the house's answer in the type of the page, the usual answer quieter beside it.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="ms-why">
  <div class="ms-why__in">
    <header class="ms-why__head">
      <div class="ms-why__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="ms-why__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.intro != blank -%}<p class="ms-why__intro">{{ section.settings.intro }}</p>{%- endif -%}
    </header>
    <div class="ms-why__table" role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="ms-why__row ms-why__row--head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="ms-why__us">{{ section.settings.us_label }}</span>
        <span role="columnheader" class="ms-why__them">{{ section.settings.them_label }}</span>
      </div>
      {%- for block in section.blocks -%}
        <div class="ms-why__row" role="row" {{ block.shopify_attributes }}>
          <span role="rowheader" class="ms-why__label"><span class="ms-why__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ block.settings.label }}</span>
          <p role="cell" class="ms-why__ours">{{ block.settings.ours }}</p>
          <p role="cell" class="ms-why__theirs"><span class="ms-why__mlabel">{{ section.settings.them_label }}</span>{{ block.settings.theirs }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="ms-why__cta">
      {%- if section.settings.button != blank -%}
        <a class="ms-why__primary" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-landing>{{ section.settings.button }}</a>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="ms-why__secondary" href="{% render 'ms-link', to: 'collections' %}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .ms-why { background: #F3EEE5; color: #17140F; padding: clamp(72px, 10vw, 160px) clamp(18px, 5vw, 80px); }
  .ms-why__in { max-width: 1560px; margin: 0 auto; }
  .ms-why__head { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); gap: clamp(24px, 5vw, 96px); align-items: end; }
  .ms-why__eyebrow { grid-column: 1 / -1; font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-why__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(36px, 5vw, 76px); line-height: 1.02; letter-spacing: -0.035em; }
  .ms-why__intro { font-size: 15px; line-height: 1.95; color: #4A443B; max-width: 46ch; }
  .ms-why__table { margin-top: clamp(44px, 6vw, 96px); border-top: 1px solid #17140F; }
  .ms-why__row { display: grid; grid-template-columns: minmax(150px, 3fr) minmax(0, 5fr) minmax(0, 4fr); gap: clamp(18px, 3.4vw, 64px); align-items: baseline; padding: clamp(20px, 2.2vw, 32px) 0; border-bottom: 1px solid #DDD6C9; transition: background .4s ease; }
  .ms-why__row:not(.ms-why__row--head):hover { background: linear-gradient(90deg, rgba(154, 123, 79, .07), transparent 70%); }
  .ms-why__row--head { padding: 14px 0; border-bottom-color: #DDD6C9; font-size: 10.5px; letter-spacing: .26em; text-transform: uppercase; }
  .ms-why__us { color: #17140F; }
  .ms-why__them { color: #6E675C; }
  .ms-why__label { display: flex; gap: 16px; align-items: baseline; font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; }
  .ms-why__n { font-family: Newsreader, Georgia, serif; font-size: 13px; letter-spacing: 0; color: #7E623B; }
  .ms-why__ours { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(20px, 1.9vw, 28px); line-height: 1.3; letter-spacing: -0.01em; margin: 0; }
  .ms-why__mlabel { display: none; }
  .ms-why__theirs { font-size: 14px; line-height: 1.8; color: #6E675C; margin: 0; }
  .ms-why__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 36px; margin-top: clamp(40px, 5vw, 72px); }
  .ms-site .ms-why__primary { display: inline-flex; align-items: center; min-height: 56px; padding: 0 36px; background: #17140F; color: #FBF9F5; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; transition: background .3s ease; }
  .ms-site .ms-why__primary:hover { background: #3A332A; color: #FBF9F5; }
  .ms-site .ms-why__secondary { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  @media (max-width: 860px) {
    .ms-why__head { grid-template-columns: minmax(0, 1fr); }
    .ms-why__row { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .ms-why__row--head { display: none; }
    .ms-why__mlabel { display: block; font-size: 10px; letter-spacing: .24em; text-transform: uppercase; margin-bottom: 4px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Why Midsummer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Why Midsummer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What a bed should be, and rarely is." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Most luxury beds are sold on a name. Ours are sold on what is inside them, who makes them, and what happens to them fifteen years later." },
    { "type": "text", "id": "us_label", "label": "Our column", "default": "A Midsummer bed" },
    { "type": "text", "id": "them_label", "label": "The other column", "default": "The usual luxury bed" },
    { "type": "text", "id": "button", "label": "Button", "default": "Lie on one in Milan" },
    { "type": "text", "id": "link_label", "label": "Link", "default": "Compare the collections" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "label", "label": "Point", "default": "Who makes it" },
        { "type": "textarea", "id": "ours", "label": "A Midsummer bed", "default": "Two artisans, start to finish, in our Milan atelier." },
        { "type": "textarea", "id": "theirs", "label": "The usual answer", "default": "A production line, with many hands and no one responsible." }
      ]
    }
  ],
  "presets": [{ "name": "Why Midsummer", "blocks": [{ "type": "row" }] }]
}
{% endschema %}
