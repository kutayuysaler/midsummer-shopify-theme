      "id": "price_request_text",
      "label": "Price on request text",
      "default": "Price on request. Each system is made to order and quoted after specification."
    },
    {
      "type": "text",
      "id": "country_of_origin",
      "label": "Country of origin",
      "default": "Italy"
    },
    {
      "type": "text",
      "id": "made_label",
      "label": "Property 1 name",
      "default": "Made by"
    },
    {
      "type": "text",
      "id": "made_value",
      "label": "Property 1 value",
      "default": "By hand, start to finish, in Italy"
    },
    {
      "type": "text",
      "id": "customisation_label",
      "label": "Property 2 name",
      "default": "Customisation"
    },
    {
      "type": "text",
      "id": "customisation_value",
      "label": "Property 2 value",
      "default": "Dimensions, heights, fibres, fabric and comfort level made to measure"
