{%- comment -%}
  Midsummer Milano — structured data.
  Lives in the header group so it emits on every page. Each graph can be
  switched off if another app or the theme already outputs it.
{%- endcomment -%}

{%- liquid
  assign shop_name = section.settings.legal_name | default: shop.name
  assign logo = section.settings.logo
-%}

{%- if section.settings.enable_organization -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "FurnitureStore"],
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop_name | json }},
      "alternateName": {{ section.settings.alternate_name | json }},
      "url": "{{ shop.url }}",
      {%- if logo != blank %}
      "logo": {
        "@type": "ImageObject",
        "url": "{{ logo | image_url: width: 600 }}",
        "width": {{ logo.width | json }},
        "height": {{ logo.height | json }}
      },
      "image": "{{ logo | image_url: width: 1200 }}",
      {%- endif %}
      "description": {{ section.settings.description | json }},
      "slogan": {{ section.settings.slogan | json }},
      "email": {{ section.settings.email | json }},
      "telephone": {{ section.settings.telephone | json }},
      "priceRange": {{ section.settings.price_range | json }},
      "currenciesAccepted": {{ section.settings.currencies | json }},
      "areaServed": {{ section.settings.area_served | json }},
      "knowsAbout": [
        {%- assign topics = section.settings.knows_about | split: ',' -%}
        {%- for topic in topics -%}
          {{ topic | strip | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ section.settings.street | json }},
        "addressLocality": {{ section.settings.city | json }},
        "postalCode": {{ section.settings.postal_code | json }},
        "addressCountry": {{ section.settings.country_code | json }}
      },
      {%- if section.settings.latitude != blank and section.settings.longitude != blank %}
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ section.settings.latitude | json }},
        "longitude": {{ section.settings.longitude | json }}
      },
      {%- endif %}
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": {{ section.settings.opens_morning | json }},
          "closes": {{ section.settings.closes_morning | json }}
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": {{ section.settings.opens_afternoon | json }},
          "closes": {{ section.settings.closes_afternoon | json }}
        }
      ],
      "makesOffer": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": {{ section.settings.service_name | json }},
          "description": {{ section.settings.service_description | json }}
        }
      },
      "sameAs": [
        {%- assign profiles = section.settings.same_as | split: ',' -%}
        {%- for profile in profiles -%}
          {{ profile | strip | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- if section.settings.enable_website -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "name": {{ shop_name | json }},
      "url": "{{ shop.url }}",
      "inLanguage": "{{ request.locale.iso_code }}",
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if section.settings.enable_breadcrumbs -%}
  {%- liquid
    assign crumbs = ''
    case template.name
      when 'product'
        assign crumbs = 'product'
      when 'collection'
        assign crumbs = 'collection'
      when 'page'
        assign crumbs = 'page'
      when 'article'
        assign crumbs = 'article'
    endcase
  -%}
  {%- if crumbs != '' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ section.settings.home_label | json }},
            "item": "{{ shop.url }}"
          },
          {%- if crumbs == 'product' -%}
            {%- if collection != blank -%}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": "{{ shop.url }}{{ collection.url }}"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": "{{ shop.url }}{{ product.url }}"
              }
            {%- else -%}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": "{{ shop.url }}{{ product.url }}"
              }
            {%- endif -%}
          {%- elsif crumbs == 'collection' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": "{{ shop.url }}{{ collection.url }}"
            }
          {%- elsif crumbs == 'page' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": "{{ shop.url }}{{ page.url }}"
            }
          {%- elsif crumbs == 'article' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": "{{ shop.url }}{{ blog.url }}"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": "{{ shop.url }}{{ article.url }}"
            }
          {%- endif -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{%- if section.settings.enable_product and template.name == 'product' and product != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "url": "{{ shop.url }}{{ product.url }}",
      "description": {{ product.description | strip_html | truncate: 600 | json }},
      {%- if product.featured_media -%}
      "image": [
        {%- for media in product.media limit: 4 -%}
          "{{ media | image_url: width: 1600 }}"{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      {%- endif -%}
      "brand": { "@type": "Brand", "name": {{ shop_name | json }} },
      "manufacturer": { "@id": "{{ shop.url }}/#organization" },
      "category": {{ product.type | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- if product.metafields.custom.materials != blank -%}
      "material": {{ product.metafields.custom.materials | metafield_text | strip_html | truncate: 200 | json }},
      {%- endif -%}
      "countryOfOrigin": { "@type": "Country", "name": {{ section.settings.country_of_origin | json }} },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": {{ section.settings.made_label | json }},
          "value": {{ section.settings.made_value | json }}
        },
        {
          "@type": "PropertyValue",
          "name": {{ section.settings.customisation_label | json }},
          "value": {{ section.settings.customisation_value | json }}
        }
      ],
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "availability": "https://schema.org/InStock",
        "itemCondition": "https://schema.org/NewCondition",
        "businessFunction": "http://purl.org/goodrelations/v1#Sell",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        {%- if section.settings.price_on_request or settings.ms_show_prices == false or product.price == 0 -%}
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "{{ cart.currency.iso_code }}",
          "valueAddedTaxIncluded": true,
          "description": {{ section.settings.price_request_text | json }}
        },
        {%- else -%}
        "price": "{{ product.price | divided_by: 100.0 }}",
        {%- endif -%}
        "seller": { "@id": "{{ shop.url }}/#organization" }
      }
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Structured data",
  "settings": [
    { "type": "paragraph", "content": "Emits JSON-LD on every page: organisation and shop-front details, site search, breadcrumbs and product data. Switch any graph off if an app already outputs it." },
    { "type": "checkbox", "id": "enable_organization", "label": "Organisation and shop front", "default": true },
    { "type": "checkbox", "id": "enable_website", "label": "Website and site search", "default": true },
    { "type": "checkbox", "id": "enable_breadcrumbs", "label": "Breadcrumbs", "default": true },
    { "type": "checkbox", "id": "enable_product", "label": "Product", "default": true },
    { "type": "header", "content": "Identity" },
    { "type": "text", "id": "legal_name", "label": "Name", "default": "Midsummer Milano" },
    { "type": "text", "id": "alternate_name", "label": "Alternate name", "default": "Midsummer" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Handmade luxury beds, mattresses and toppers, built one by one by two artisans in Italy from natural fibres and Loro Piana Interiors fabrics." },
    { "type": "text", "id": "slogan", "label": "Slogan", "default": "We design dreams." },
    { "type": "text", "id": "knows_about", "label": "Topics", "info": "Comma separated. Helps AI search understand what the house is authoritative about.", "default": "handmade mattresses, natural fibre bedding, vicuña, baby alpaca, cashmere, horsehair, mohair, yak hair, Cheviot wool, Loro Piana Interiors fabrics, boxsprings, made-to-measure beds, mattress regeneration, Italian furniture craftsmanship, sleep systems" },
    { "type": "header", "content": "Atelier" },
    { "type": "text", "id": "street", "label": "Street", "default": "Via Andegari 4" },
    { "type": "text", "id": "city", "label": "City", "default": "Milano" },
    { "type": "text", "id": "postal_code", "label": "Postal code", "default": "20121" },
    { "type": "text", "id": "country_code", "label": "Country code", "default": "IT" },
    { "type": "text", "id": "latitude", "label": "Latitude", "default": "45.4700" },
    { "type": "text", "id": "longitude", "label": "Longitude", "default": "9.1877" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@midsummer-milano.com" },
    { "type": "text", "id": "telephone", "label": "Telephone" },
    { "type": "text", "id": "price_range", "label": "Price range", "default": "On request" },
    { "type": "text", "id": "currencies", "label": "Currencies accepted", "default": "EUR" },
    { "type": "text", "id": "area_served", "label": "Area served", "default": "Worldwide" },
    { "type": "text", "id": "opens_morning", "label": "Opens (morning)", "default": "09:00" },
    { "type": "text", "id": "closes_morning", "label": "Closes (morning)", "default": "12:00" },
    { "type": "text", "id": "opens_afternoon", "label": "Opens (afternoon)", "default": "13:00" },
    { "type": "text", "id": "closes_afternoon", "label": "Closes (afternoon)", "default": "18:00" },
    { "type": "text", "id": "same_as", "label": "Social profiles", "info": "Comma separated URLs." },
    { "type": "header", "content": "Service" },
    { "type": "text", "id": "service_name", "label": "Service name", "default": "Bespoke sleep system consultation" },
    { "type": "textarea", "id": "service_description", "label": "Service description", "default": "A consultation at the atelier on Via Andegari, or by video, after which dimensions, heights, fibres, fabric and comfort level are specified and the system is built by hand." },
    { "type": "header", "content": "Product defaults" },
    { "type": "checkbox", "id": "price_on_request", "label": "Describe price as on request", "default": true },
    { "type": "text", "id": "price_request_text", "label": "Price on request text", "default": "Price on request. Each system is made to order and quoted after specification." },
    { "type": "text", "id": "country_of_origin", "label": "Country of origin", "default": "Italy" },
    { "type": "text", "id": "made_label", "label": "Property 1 name", "default": "Made by" },
    { "type": "text", "id": "made_value", "label": "Property 1 value", "default": "Two artisans, by hand, start to finish, in Italy" },
    { "type": "text", "id": "customisation_label", "label": "Property 2 name", "default": "Customisation" },
    { "type": "text", "id": "customisation_value", "label": "Property 2 value", "default": "Dimensions, heights, fibres, fabric and comfort level made to measure" },
    { "type": "header", "content": "Breadcrumbs" },
    { "type": "text", "id": "home_label", "label": "Home label", "default": "Midsummer Milano" }
  ]
}
{% endschema %}
