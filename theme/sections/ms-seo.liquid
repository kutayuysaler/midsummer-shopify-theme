{%- comment -%}
  Midsummer Milano — structured data.
  Lives in the header group so it emits on every page. Each graph can be
  switched off if another app or the theme already outputs it.
{%- endcomment -%}

{%- liquid
  capture shop_name
    render 'ms-t', v: section.settings.legal_name
  endcapture
  assign shop_name = shop_name | default: shop.name
  assign logo = section.settings.logo
-%}

{%- if section.settings.enable_organization -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "FurnitureStore"],
      "@id": "{{ shop.url }}/#organization",
      "name": {{ shop_name | json }},
      "alternateName": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.alternate_name %}{% endcapture %}{{ ms_t_out | json }},
      "url": "{{ shop.url }}",
      {%- if logo != blank %}
      "logo": {
        "@type": "ImageObject",
        "url": "https:{{ logo | image_url: width: 600 }}",
        "width": {{ logo.width | json }},
        "height": {{ logo.height | json }}
      },
      {%- else %}
      "logo": "https:{{ 'midsummer-logotype.svg' | asset_url }}",
      {%- endif %}
      "image": "https:{{ 'ms-photo-atelier-blue-gold.jpg' | asset_url }}",
      "foundingLocation": { "@type": "Place", "name": "Milan, Italy" },
      {%- if section.settings.founding_date != blank %}
      "foundingDate": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.founding_date %}{% endcapture %}{{ ms_t_out | json }},
      {%- endif %}
      {%- if section.settings.award != blank %}
      "award": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.award %}{% endcapture %}{{ ms_t_out | json }},
      {%- endif %}
      {%- if section.settings.vat_id != blank %}
      "vatID": {{ section.settings.vat_id | json }},
      {%- endif %}
      "hasMap": "https://www.google.com/maps/search/?api=1&query={% capture ms_d1 %}{% render 'ms-t', v: section.settings.city %}{% endcapture %}{% capture ms_t_out %}{% render 'ms-t', v: section.settings.street %}{% endcapture %}{{ ms_t_out | append: ', ' | append: section.settings.postal_code | append: ' ' | append: ms_d1 | url_encode }}",
      {%- if section.settings.founder != blank %}
      "founder": { "@type": "Person", "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.founder %}{% endcapture %}{{ ms_t_out | json }}, "jobTitle": "Founder" },
      {%- endif %}
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "email": {{ section.settings.email | json }},
        {%- if section.settings.telephone != blank %}"telephone": {{ section.settings.telephone | json }},{%- endif %}
        "availableLanguage": ["Italian", "English", "Russian"]
      },
      "description": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.description %}{% endcapture %}{{ ms_t_out | json }},
      "slogan": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.slogan %}{% endcapture %}{{ ms_t_out | json }},
      "email": {{ section.settings.email | json }},
      {%- if section.settings.telephone != blank %}
      "telephone": {{ section.settings.telephone | json }},
      {%- endif %}
      "priceRange": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.price_range %}{% endcapture %}{{ ms_t_out | json }},
      "currenciesAccepted": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.currencies %}{% endcapture %}{{ ms_t_out | json }},
      "areaServed": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.area_served %}{% endcapture %}{{ ms_t_out | json }},
      "knowsAbout": [
        {%- capture topics %}{% render 'ms-t', v: section.settings.knows_about %}{% endcapture -%}{%- assign topics = topics | split: ',' -%}
        {%- for topic in topics -%}
          {{ topic | strip | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.street %}{% endcapture %}{{ ms_t_out | json }},
        "addressLocality": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.city %}{% endcapture %}{{ ms_t_out | json }},
        "postalCode": {{ section.settings.postal_code | json }},
        "addressCountry": {{ section.settings.country_code | json }}
      },
      {%- if section.settings.latitude != blank and section.settings.longitude != blank %}
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.latitude %}{% endcapture %}{{ ms_t_out | json }},
        "longitude": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.longitude %}{% endcapture %}{{ ms_t_out | json }}
      },
      {%- endif %}
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.opens_morning %}{% endcapture %}{{ ms_t_out | json }},
          "closes": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.closes_morning %}{% endcapture %}{{ ms_t_out | json }}
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.opens_afternoon %}{% endcapture %}{{ ms_t_out | json }},
          "closes": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.closes_afternoon %}{% endcapture %}{{ ms_t_out | json }}
        }
      ],
      "makesOffer": {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.service_name %}{% endcapture %}{{ ms_t_out | json }},
          "description": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.service_description %}{% endcapture %}{{ ms_t_out | json }}
        }
      },
      {%- liquid
        capture profiles
          render 'ms-t', v: section.settings.same_as
        endcapture
        assign profiles = profiles | append: ',' | append: settings.ms_social_instagram | append: ',' | append: settings.ms_social_facebook | append: ',' | append: settings.ms_social_pinterest | append: ',' | append: settings.ms_social_linkedin | append: ',' | append: settings.ms_social_youtube | append: ',' | append: settings.ms_social_tiktok | append: ',' | append: settings.ms_social_telegram | append: ',' | append: settings.ms_social_vk
        assign profiles = profiles | split: ',' | compact | uniq
        assign sep = ''
      -%}
      "sameAs": [
        {%- for profile in profiles -%}
          {%- assign pr = profile | strip -%}
          {%- if pr contains 'http' -%}{%- unless pr contains 'wa.me' -%}{{ sep }}{{ pr | json }}{%- assign sep = ',' -%}{%- endunless -%}{%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{%- if section.settings.enable_website -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "name": {{ shop_name | json }},
      "url": "{{ shop.url }}",
      "inLanguage": "{{ request.locale.iso_code }}",
      "publisher": { "@id": "{{ shop.url }}/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}

{%- if section.settings.enable_breadcrumbs -%}
  {%- liquid
    assign crumbs = ''
    case template.name
      when 'product'
        assign crumbs = 'product'
      when 'collection'
        assign crumbs = 'collection'
      when 'page'
        assign crumbs = 'page'
      when 'article'
        assign crumbs = 'article'
    endcase
  -%}
  {%- if crumbs != '' -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.home_label %}{% endcapture %}{{ ms_t_out | json }},
            "item": "{{ shop.url }}"
          },
          {%- if crumbs == 'product' -%}
            {%- if collection != blank -%}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": "{{ shop.url }}{{ collection.url }}"
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": "{{ shop.url }}{{ product.url }}"
              }
            {%- else -%}
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": "{{ shop.url }}{{ product.url }}"
              }
            {%- endif -%}
          {%- elsif crumbs == 'collection' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ collection.title | json }},
              "item": "{{ shop.url }}{{ collection.url }}"
            }
          {%- elsif crumbs == 'page' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ page.title | json }},
              "item": "{{ shop.url }}{{ page.url }}"
            }
          {%- elsif crumbs == 'article' -%}
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ blog.title | json }},
              "item": "{{ shop.url }}{{ blog.url }}"
            },
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ article.title | json }},
              "item": "{{ shop.url }}{{ article.url }}"
            }
          {%- endif -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Product pages built on "Product · The system" describe the product themselves, from their
  fibres and specification. This one covers the booking product, on Atelier's own page.
{%- endcomment -%}
{%- if section.settings.enable_product and template.name == 'product' and template.suffix == 'appointment' and product != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": "{{ shop.url }}{{ product.url }}#product",
      "name": {{ product.title | json }},
      "url": "{{ shop.url }}{{ product.url }}",
      "description": {{ product.description | newline_to_br | replace: '<br />', ' ' | replace: '</p>', ' </p>' | replace: '</h4>', ' </h4>' | replace: '</li>', ' </li>' | strip_html | split: ' ' | join: ' ' | truncate: 600 | json }},
      {%- if product.featured_media -%}
      "image": [
        {%- for media in product.media limit: 4 -%}
          "https:{{ media | image_url: width: 1600 }}"{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      {%- endif -%}
      "brand": { "@type": "Brand", "name": {{ shop_name | json }} },
      "manufacturer": { "@id": "{{ shop.url }}/#organization" },
      "category": {{ product.type | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- if product.metafields.custom.materials != blank -%}
      "material": {{ product.metafields.custom.materials | metafield_text | strip_html | truncate: 200 | json }},
      {%- endif -%}
      "countryOfOrigin": { "@type": "Country", "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.country_of_origin %}{% endcapture %}{{ ms_t_out | json }} },
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.made_label %}{% endcapture %}{{ ms_t_out | json }},
          "value": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.made_value %}{% endcapture %}{{ ms_t_out | json }}
        },
        {
          "@type": "PropertyValue",
          "name": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.customisation_label %}{% endcapture %}{{ ms_t_out | json }},
          "value": {% capture ms_t_out %}{% render 'ms-t', v: section.settings.customisation_value %}{% endcapture %}{{ ms_t_out | json }}
        }
      ]
      {%- if settings.ms_show_prices and section.settings.price_on_request == false and product.price > 0 -%},
      "offers": {
        "@type": "Offer",
        "url": "{{ shop.url }}{{ product.url }}",
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        "priceCurrency": "{{ cart.currency.iso_code }}",
        "price": "{{ product.price | divided_by: 100.0 }}",
        "seller": { "@id": "{{ shop.url }}/#organization" }
      }
      {%- endif %}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Structured data",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_organization",
      "label": "Organisation and shop front",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_website",
      "label": "Website and site search",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_breadcrumbs",
      "label": "Breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_product",
      "label": "Product",
      "default": true
    },
    {
      "type": "header",
      "content": "Identity"
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Name",
      "default": "Midsummer Milano"
    },
    {
      "type": "text",
      "id": "alternate_name",
      "label": "Alternate name",
      "default": "Midsummer"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "founder",
      "label": "Founder",
      "default": "Chiara Mennini"
    },
    {
      "type": "text",
      "id": "founding_date",
      "label": "Founding year",
      "info": "Year the house was founded, e.g. 2014. Leave empty to omit.",
      "default": "2014"
    },
    {
      "type": "text",
      "id": "award",
      "label": "Award",
      "info": "A third-party recognition search engines can cite.",
      "default": "Green Product Award 2025, Top bed system"
    },
    {
      "type": "text",
      "id": "vat_id",
      "label": "VAT number",
      "default": "IT02282810999"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Handmade luxury beds, mattresses and toppers, built one by one, by hand, in Italy from natural fibres and Loro Piana Interiors fabrics, for private homes, hotels, yachts and private jets. Atelier at Via Andegari 4, Milan, open by appointment."
    },
    {
      "type": "text",
      "id": "slogan",
      "label": "Slogan",
      "default": "We design dreams."
    },
    {
      "type": "text",
      "id": "knows_about",
      "label": "Topics",
      "info": "Comma separated. Helps AI search understand what the house is authoritative about.",
      "default": "handmade mattresses, natural fibre bedding, vicuña, baby alpaca, cashmere, horsehair, mohair, yak hair, Cheviot wool, Loro Piana Interiors fabrics, boxsprings, made-to-measure beds, mattress regeneration, Italian furniture craftsmanship, sleep systems, hotel beds, yacht beds, private jet beds"
    },
    {
      "type": "header",
      "content": "Atelier"
    },
    {
      "type": "text",
      "id": "street",
      "label": "Street",
      "default": "Via Andegari 4"
    },
    {
      "type": "text",
      "id": "city",
      "label": "City",
      "default": "Milano"
    },
    {
      "type": "text",
      "id": "postal_code",
      "label": "Postal code",
      "default": "20121"
    },
    {
      "type": "text",
      "id": "country_code",
      "label": "Country code",
      "default": "IT"
    },
    {
      "type": "text",
      "id": "latitude",
      "label": "Latitude",
      "default": "45.4700"
    },
    {
      "type": "text",
      "id": "longitude",
      "label": "Longitude",
      "default": "9.1877"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@midsummer-milano.com"
    },
    {
      "type": "text",
      "id": "telephone",
      "label": "Telephone"
    },
    {
      "type": "text",
      "id": "price_range",
      "label": "Price range",
      "default": "On request"
    },
    {
      "type": "text",
      "id": "currencies",
      "label": "Currencies accepted",
      "default": "EUR"
    },
    {
      "type": "text",
      "id": "area_served",
      "label": "Area served",
      "default": "Worldwide"
    },
    {
      "type": "text",
      "id": "opens_morning",
      "label": "Opens (morning)",
      "default": "09:00"
    },
    {
      "type": "text",
      "id": "closes_morning",
      "label": "Closes (morning)",
      "default": "12:00"
    },
    {
      "type": "text",
      "id": "opens_afternoon",
      "label": "Opens (afternoon)",
