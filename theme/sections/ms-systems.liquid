{%- comment -%}
  The systems of a collection, chosen by what matters to the sleeper. A row of needs
  (temperature, support, softness, breathability, hypoallergenic) narrows the list and says, in
  one line, which fibres answer it; a second view sets the systems side by side, fibre by fibre.
  What each system is made of comes from its own product template (snippets/ms-system-facts),
  and the qualities are those the Natural materials page gives each fibre.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign kh = collection.handle
  if kh == 'icon'
    assign kh = 'icons'
  endif
  assign is_tier = false
  if kh == 'essentials' or kh == 'signature' or kh == 'icons'
    assign is_tier = true
  endif
  # the fibre filters only where sleep systems are listed (snippets/ms-kind); and what each
  # product is (bed system, mattress, topper, boxspring, bed with headboard, outdoor), counted
  # so a collection that holds more than one kind can be narrowed to one
  assign n_sys = 0
  assign kinds_seen = ''
  for p in collection.products limit: 48
    capture mk
      render 'ms-kind', p: p
    endcapture
    assign mkp = mk | split: '|'
    if mkp[0] == 'system'
      assign n_sys = n_sys | plus: 1
    endif
    assign w = mkp[0]
    if w == 'system'
      capture w
        render 'ms-what', key: mkp[1]
      endcapture
      assign w = w | strip | default: 'system'
    endif
    assign kinds_seen = kinds_seen | append: w | append: ','
  endfor
  assign kind_order = 'system,mattress,topper,boxspring,headboard,outdoor' | split: ','
  assign kinds_list = kinds_seen | split: ','
  assign n_kinds = 0
  for k in kind_order
    if kinds_list contains k
      assign n_kinds = n_kinds | plus: 1
    endif
  endfor
-%}
<section class="ms-sy" data-ms-sy>
  <div class="ms-sy__tabs">
    {%- if is_tier or n_sys > 1 -%}
    {%- for h in (1..3) -%}
      {%- case h -%}
        {%- when 1 -%}{%- assign k = 'essentials' -%}{%- assign l = s.tab1 -%}
        {%- when 2 -%}{%- assign k = 'signature' -%}{%- assign l = s.tab2 -%}
        {%- else -%}{%- assign k = 'icons' -%}{%- assign l = s.tab3 -%}
      {%- endcase -%}
      <a href="{% render 'ms-link', to: k %}" class="ms-sy__tab{% if kh == k %} is-on{% endif %}"{% if kh == k %} aria-current="page"{% endif %}>{{ l }}</a>
    {%- endfor -%}
    {%- else -%}
    {%- comment -%} the house's other beds, each where the store has it {%- endcomment -%}
    {%- assign fam = 'systems,headboards,mattresses,toppers,outdoor' | split: ',' -%}
    {%- for k in fam -%}
      {%- capture u -%}{% render 'ms-link', to: k, strict: true %}{%- endcapture -%}
      {%- assign kl = 'fam_' | append: k -%}
      {%- if u != blank and s[kl] != blank -%}<a href="{{ u }}" class="ms-sy__tab{% if u == collection.url %} is-on{% endif %}"{% if u == collection.url %} aria-current="page"{% endif %}>{{ s[kl] }}</a>{%- endif -%}
    {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if n_kinds > 1 -%}
  <div class="ms-sy__kinds" role="group" aria-label="{{ s.kind_label | escape }}">
    <button type="button" class="is-on" data-kind="" aria-pressed="true">{{ s.all_kinds_label }} <span>{{ kinds_list.size }}</span></button>
    {%- for k in kind_order -%}
      {%- if kinds_list contains k -%}
        {%- assign kc = 0 -%}{%- for x in kinds_list -%}{%- if x == k -%}{%- assign kc = kc | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- assign kp = 'kinds_' | append: k -%}
        <button type="button" data-kind="{{ k }}" aria-pressed="false">{% render 'ms-kind-glyph', kind: k %}{{ s[kp] }} <span>{{ kc }}</span></button>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}

  {%- if n_sys > 1 -%}
  <div class="ms-sy__bar">
    <div class="ms-sy__needs" role="group" aria-label="{{ s.need_label | escape }}">
      <span class="ms-sy__ask">{{ s.need_label }}</span>
      <button type="button" class="is-on" data-need="" aria-pressed="true">{{ s.all_label }}</button>
      <button type="button" data-need="temperature" aria-pressed="false">{{ s.temperature_label }}</button>
      <button type="button" data-need="support" aria-pressed="false">{{ s.support_label }}</button>
      <button type="button" data-need="softness" aria-pressed="false">{{ s.softness_label }}</button>
      <button type="button" data-need="breathability" aria-pressed="false">{{ s.breathability_label }}</button>
      <button type="button" data-need="hypoallergenic" aria-pressed="false">{{ s.hypoallergenic_label }}</button>
    </div>
    <div class="ms-sy__views" role="group" aria-label="{{ s.view_label | escape }}">
      <button type="button" class="is-on" data-sy-view="grid" aria-pressed="true">{{ s.grid_label }}</button>
      <button type="button" data-sy-view="table" aria-pressed="false">{{ s.compare_label }}</button>
    </div>
  </div>
  <p class="ms-sy__hint" data-sy-hint aria-live="polite">{{ s.hint_all }}</p>
  <template data-sy-hints>
    <span data-k="">{{ s.hint_all }}</span>
    <span data-k="temperature">{{ s.hint_temperature }}</span>
    <span data-k="support">{{ s.hint_support }}</span>
    <span data-k="softness">{{ s.hint_softness }}</span>
    <span data-k="breathability">{{ s.hint_breathability }}</span>
    <span data-k="hypoallergenic">{{ s.hint_hypoallergenic }}</span>
  </template>
  {%- endif -%}

  {%- paginate collection.products by 48 -%}
  <div class="ms-sy__grid" data-sy-panel="grid">
    {%- for product in collection.products -%}
      {%- capture mk -%}{% render 'ms-kind', p: product %}{%- endcapture -%}{%- assign mkp = mk | split: '|' -%}{%- capture facts -%}{% render 'ms-system-facts', key: mkp[1], handle: '', title: product.title %}{%- endcapture -%}
      {%- assign fparts = facts | split: '~' -%}
      {%- assign fibres = fparts[0] | split: ',' -%}
      {%- assign quals = fparts[1] | strip -%}
      {%- capture note -%}{% render 'ms-product-note', title: product.title %}{%- endcapture -%}
      {%- assign sub = product.metafields.custom.subtitle.value | default: note -%}
      {%- assign spec = '' -%}
      {%- if mkp[0] == 'headboard' and mkp[2] != blank -%}
        {%- capture bl -%}{% render 'ms-bed-data', key: mkp[2], part: 'line' %}{%- endcapture -%}
        {%- capture bh -%}{% render 'ms-bed-data', key: mkp[2], part: 'height' %}{%- endcapture -%}
        {%- assign sub = product.metafields.custom.subtitle.value | default: bl -%}
        {%- assign spec = s.headboard_label | append: ' ' | append: bh | append: ' cm' -%}
      {%- elsif mkp[0] == 'outdoor' -%}
        {%- assign sub = product.metafields.custom.subtitle.value | default: s.outdoor_line -%}
      {%- endif -%}
      {%- liquid
        assign what = mkp[0]
        if what == 'system'
          capture what
            render 'ms-what', key: mkp[1]
          endcapture
          assign what = what | strip | default: 'system'
        endif
        assign wl = 'what_' | append: what
        assign what_label = s[wl]
        assign tier = ''
        unless is_tier
          for c in product.collections
            case c.handle
              when 'essentials'
                assign tier = s.tab1
              when 'signature'
                assign tier = s.tab2
              when 'icons', 'icon'
                assign tier = s.tab3
            endcase
            if tier != ''
              break
            endif
          endfor
        endunless
        assign wi = 'with_' | append: what
      -%}
      <a href="{{ product.url }}" class="ms-sy__card" data-q="{{ quals }}" data-kind="{{ what }}">
        {%- if product.featured_media -%}
          <span class="ms-card__img">
            <img alt="{{ product.featured_media.alt | default: product.title | escape }}" src="{{ product.featured_media | image_url: width: 900 }}" srcset="{{ product.featured_media | image_url: width: 600 }} 600w, {{ product.featured_media | image_url: width: 900 }} 900w" sizes="(max-width: 760px) 50vw, 25vw" loading="{% if forloop.index > 4 %}lazy{% else %}eager{% endif %}" width="900" height="1125">
            {%- assign alt_media = product.media[1] -%}
            {%- if alt_media and alt_media.media_type == 'image' -%}<img class="ms-card__alt" alt="" src="{{ alt_media | image_url: width: 900 }}" loading="lazy" width="900" height="1125">{%- endif -%}
          </span>
        {%- else -%}
          <span class="ms-card__img ms-sy__blank"></span>
        {%- endif -%}
        {%- if what_label != blank -%}
          <p class="ms-sy__what">{% render 'ms-kind-glyph', kind: what %}<span>{{ what_label }}</span>{%- if tier != '' -%}<span class="ms-sy__tier">{{ tier }}</span>{%- endif -%}</p>
        {%- endif -%}
        <h2 class="ms-sy__name">{{ product.title }}<svg class="ms-sy__go" viewBox="0 0 20 10" width="20" height="10" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M0 5h18M14 1l4 4-4 4"/></svg></h2>
        {%- if s[wi] != blank -%}<p class="ms-sy__with">{{ s[wi] }}</p>{%- endif -%}
        {%- if sub != blank -%}<p class="ms-sy__sub">{{ sub }}</p>{%- endif -%}
        {%- if spec != blank -%}<p class="ms-sy__spec">{{ spec }}</p>{%- endif -%}
        {%- if fibres.size > 0 and fparts[0] != blank -%}
          <div class="ms-sy__fibres">
            <ul class="ms-sy__marks" role="list">
              {%- for f in fibres -%}<li title="{{ f | escape }}">{% render 'ms-fibre-mark', name: f, size: 26 %}<span class="ms-sy__vh">{{ f }}</span></li>{%- endfor -%}
            </ul>
            <p class="ms-sy__fnames" aria-hidden="true">{{ fibres | join: ' · ' }}</p>
          </div>
        {%- endif -%}
        {%- if settings.ms_show_prices -%}<p class="ms-sy__price">{% if product.price_varies %}{%- assign from_price = product.price_min | money -%}{{ 'ms.product.price_from' | t: price: from_price }}{% else %}{{ product.price | money }}{% endif %}</p>{%- endif -%}{%- if settings.ms_show_prices == false and settings.ms_price_from and product.price_min > 0 -%}{%- assign from_price = product.price_min | money -%}<p class="ms-sy__price">{{ 'ms.product.price_from' | t: price: from_price }}</p>{%- endif -%}
      </a>
    {%- else -%}
      <p class="ms-sy__empty">{{ s.empty }}</p>
    {%- endfor -%}
  </div>

  {%- if collection.products.size > 0 and n_sys > 1 -%}
  <div class="ms-sy__tablewrap" data-sy-panel="table" hidden>
    <table class="ms-sy__table">
      <thead>
        <tr>
          <th scope="col">{{ s.col_system }}</th>
          <th scope="col">{{ s.col_fibres }}</th>
          <th scope="col" data-col="temperature">{{ s.temperature_label }}</th>
          <th scope="col" data-col="support">{{ s.support_label }}</th>
          <th scope="col" data-col="softness">{{ s.softness_label }}</th>
          <th scope="col" data-col="breathability">{{ s.breathability_label }}</th>
          <th scope="col" data-col="hypoallergenic">{{ s.hypoallergenic_label }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for product in collection.products -%}
          {%- capture mk -%}{% render 'ms-kind', p: product %}{%- endcapture -%}{%- assign mkp = mk | split: '|' -%}{%- capture facts -%}{% render 'ms-system-facts', key: mkp[1], handle: '', title: product.title %}{%- endcapture -%}
          {%- assign fparts = facts | split: '~' -%}
          {%- assign quals = fparts[1] | strip -%}
          <tr data-q="{{ quals }}">
            <th scope="row">
              <a href="{{ product.url }}">
                {%- if product.featured_media -%}<img src="{{ product.featured_media | image_url: width: 160 }}" alt="" width="64" height="80" loading="lazy">{%- endif -%}
                <span>{{ product.title }}</span>
              </a>
            </th>
            <td class="ms-sy__tf">{{ fparts[0] | replace: ',', ', ' | default: '–' }}</td>
            {%- assign needs = 'temperature,support,softness,breathability,hypoallergenic' | split: ',' -%}
            {%- for n in needs -%}
              <td data-col="{{ n }}">{%- if quals contains n -%}<i class="ms-sy__dot" aria-label="{{ s.yes_label | escape }}"></i>{%- else -%}<span class="ms-sy__no" aria-hidden="true"></span>{%- endif -%}</td>
            {%- endfor -%}
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    <p class="ms-sy__note">{{ s.table_note }}</p>
  </div>
  {%- endif -%}

  {%- if paginate.pages > 1 -%}
    <nav class="ms-sy__pages">
      {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">← {{ s.prev_label }}</a>{%- endif -%}
      <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
      {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ s.next_label }} →</a>{%- endif -%}
    </nav>
  {%- endif -%}
  {%- endpaginate -%}

  <div class="ms-sy__help">
    <p>{{ s.help_text }}</p>
    <a href="{% render 'ms-link', to: 'quiz' %}" data-ms-quiz-link>{{ s.quiz_label }}<span aria-hidden="true"> →</span></a>
    <a href="{% render 'ms-link', to: 'compare' %}">{{ s.compare_collections_label }}<span aria-hidden="true"> →</span></a>
  </div>
</section>

<style>
  .ms-card__img { position: relative; display: block; overflow: hidden; }
  .ms-site img.ms-card__alt { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .7s ease, transform 1.4s cubic-bezier(.2,.7,.2,1); transform: scale(1.03); }
  @media (hover: hover) { a:hover > .ms-card__img img.ms-card__alt { opacity: 1; transform: none; } }
  .ms-sy { padding: 0 clamp(18px, 5vw, 80px) clamp(60px, 9vw, 140px); max-width: 1560px; margin: 0 auto; }
  .ms-sy__tabs { display: flex; gap: 8px; flex-wrap: wrap; border-top: 1px solid #DDD6C9; padding-top: 22px; }
  .ms-site .ms-sy__tab { padding: 13px 20px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; border: 1px solid #DDD6C9; color: #4A443B; }
  .ms-site .ms-sy__tab.is-on, .ms-site .ms-sy__tab:hover { background: #17140F; border-color: #17140F; color: #FBF9F5; }
  .ms-sy__bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px 28px; margin-top: clamp(28px, 3.4vw, 48px); padding-bottom: 18px; border-bottom: 1px solid #DDD6C9; }
  .ms-sy__needs { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 4px; }
  .ms-sy__ask { font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 18px; color: #17140F; margin-right: 14px; }
  .ms-sy__needs button, .ms-sy__views button { background: none; border: 0; border-bottom: 1px solid transparent; padding: 8px 10px; font: inherit; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #6E675C; cursor: pointer; }
  .ms-sy__needs button:hover, .ms-sy__views button:hover { color: #17140F; }
  .ms-sy__needs button.is-on, .ms-sy__views button.is-on { color: #17140F; border-bottom-color: #17140F; }
  .ms-sy__views { display: flex; gap: 2px; }
  .ms-sy__hint { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(18px, 1.7vw, 22px); line-height: 1.5; color: #4A443B; max-width: 62ch; margin: 22px 0 clamp(30px, 3.6vw, 52px); min-height: 3em; }
  .ms-sy__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(44px, 5vw, 80px) clamp(18px, 2.6vw, 40px); }
  .ms-sy__kinds { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(24px, 3vw, 40px); }
  .ms-sy__kinds button { display: inline-flex; align-items: center; gap: 10px; background: none; border: 1px solid #DDD6C9; padding: 10px 16px 10px 12px; font: inherit; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #4A443B; cursor: pointer; transition: border-color .3s, color .3s, background .3s; }
  .ms-sy__kinds button span { font-family: Newsreader, Georgia, serif; font-size: 13px; letter-spacing: 0; color: #9A8F7E; }
  .ms-sy__kinds button:hover { border-color: #17140F; color: #17140F; }
  .ms-sy__kinds button.is-on { background: #17140F; border-color: #17140F; color: #FBF9F5; }
  .ms-sy__kinds button.is-on span { color: #C9BBA3; }
  .ms-sy__kinds button:first-child { padding-left: 16px; }
  .ms-kg { display: block; width: 32px; height: 20px; flex: 0 0 auto; overflow: visible; }
  .ms-sy__what { display: flex; align-items: center; gap: 10px; margin-top: 20px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #7E623B; }
  .ms-sy__what .ms-kg { color: #7E623B; }
  .ms-sy__tier { color: #9A8F7E; }
  .ms-sy__tier::before { content: '·'; margin-right: 10px; color: #C9BBA3; }
  .ms-sy__with { font-size: 12px; letter-spacing: .04em; color: #9A8F7E; margin-top: 4px; }
  .ms-sy__go { display: inline-block; margin-left: 12px; vertical-align: middle; opacity: 0; transform: translateX(-6px); transition: opacity .4s, transform .5s cubic-bezier(.2,.7,.2,1); }
  @media (hover: hover) { .ms-sy__card:hover .ms-sy__go { opacity: 1; transform: none; } }
  .ms-site .ms-sy__card { display: block; color: inherit; transition: opacity .45s ease; }
  .ms-sy__card[hidden] { display: none; }
  .ms-sy__card .ms-card__img img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; background: #F1ECE3; transition: transform 1.4s cubic-bezier(.2,.7,.2,1); }
  @media (hover: hover) { .ms-sy__card:hover .ms-card__img img:first-child { transform: scale(1.025); } }
  .ms-sy__blank { aspect-ratio: 4 / 5; background: #F1ECE3; }
  .ms-sy__name { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(24px, 2.3vw, 32px); line-height: 1.12; letter-spacing: -0.02em; margin-top: 8px; }
  .ms-sy__sub { font-size: 13.5px; line-height: 1.7; color: #6E675C; margin-top: 6px; max-width: 36ch; }
  /* every fibre of the system, none left out: the marks in a row, their names beneath */
  .ms-sy__fibres { margin: 14px 0 0; padding: 12px 0 0; border-top: 1px solid #ECE6DB; }
  .ms-sy__marks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 6px; }
  .ms-sy__marks li { display: flex; align-items: center; justify-content: center; width: 30px; height: 30px; color: #7E623B; }
  .ms-sy__marks .ms-fm { display: block; overflow: visible; }
  .ms-sy__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ms-sy__fnames { font-size: 11.5px; line-height: 1.6; color: #6E675C; margin-top: 6px; }
  .ms-sy__spec { font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #7E623B; margin-top: 10px; }
  .ms-sy__price { font-size: 12.5px; letter-spacing: .08em; color: #6E675C; margin-top: 10px; }
  .ms-sy__empty { font-size: 15px; line-height: 1.9; color: #4A443B; }
  .ms-sy__tablewrap { overflow-x: auto; }
  .ms-sy__table { width: 100%; border-collapse: collapse; min-width: 760px; }
  .ms-sy__table th, .ms-sy__table td { text-align: left; padding: 14px 12px; border-bottom: 1px solid #ECE6DB; vertical-align: middle; }
  .ms-sy__table thead th { font-weight: 400; font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; color: #6E675C; border-bottom-color: #17140F; }
  .ms-sy__table thead th[data-col], .ms-sy__table td[data-col] { text-align: center; width: 10%; }
  .ms-sy__table thead th.is-need, .ms-sy__table td.is-need { background: #F4EFE5; color: #17140F; }
  .ms-sy__table tbody th a { display: flex; align-items: center; gap: 14px; color: #17140F; }
  .ms-sy__table tbody th img { width: 48px; height: 60px; object-fit: cover; background: #F1ECE3; flex: 0 0 auto; }
  .ms-sy__table tbody th span { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: 19px; }
  .ms-sy__table tr[hidden] { display: none; }
  .ms-sy__tf { font-size: 13px; line-height: 1.6; color: #4A443B; max-width: 30ch; }
  .ms-sy__dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #7E623B; }
  .ms-sy__no { display: inline-block; width: 12px; height: 1px; background: #DDD6C9; vertical-align: middle; }
  .ms-sy__note { font-size: 12.5px; line-height: 1.7; color: #6E675C; margin-top: 16px; max-width: 70ch; }
  .ms-sy__pages { display: flex; gap: 22px; justify-content: center; margin-top: clamp(40px, 5vw, 72px); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; }
  .ms-sy__help { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 28px; margin-top: clamp(48px, 6vw, 88px); padding-top: 24px; border-top: 1px solid #DDD6C9; }
  .ms-sy__help p { font-family: Newsreader, Georgia, serif; font-size: 19px; font-weight: 300; color: #17140F; margin: 0 auto 0 0; }
  .ms-site .ms-sy__help a { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  @media (max-width: 1080px) and (min-width: 761px) { .ms-sy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .ms-sy__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 14px; }
    .ms-sy__what { gap: 6px; font-size: 9.5px; letter-spacing: .16em; margin-top: 14px; flex-wrap: wrap; }
    .ms-sy__what .ms-kg { width: 26px; height: 16px; }
    .ms-sy__tier::before { margin-right: 6px; }
    .ms-sy__with { font-size: 11px; }
    .ms-sy__kinds { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * clamp(18px, 5vw, 80px)); padding-inline: clamp(18px, 5vw, 80px); }
    .ms-sy__kinds button { flex: 0 0 auto; }
    .ms-sy__ask { flex: 1 0 100%; margin: 0 0 4px; }
    .ms-sy__needs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * clamp(18px, 5vw, 80px)); padding-inline: clamp(18px, 5vw, 80px); flex-wrap: wrap; }
    .ms-sy__name { font-size: 20px; margin-top: 6px; }
    .ms-sy__sub { font-size: 12.5px; }
    .ms-sy__marks li { width: 26px; height: 26px; }
    .ms-sy__fnames { font-size: 11px; }
    .ms-sy__help p { flex: 1 0 100%; }
  }
</style>
<script>
  (function () {
    var root = document.currentScript.previousElementSibling.previousElementSibling;
    if (!root || !root.hasAttribute('data-ms-sy')) root = document.querySelector('[data-ms-sy]');
    if (!root) return;
    var hint = root.querySelector('[data-sy-hint]');
    var hints = {};
    var tpl = root.querySelector('[data-sy-hints]');
    if (tpl) Array.prototype.forEach.call(tpl.content.querySelectorAll('[data-k]'), function (n) { hints[n.getAttribute('data-k')] = n.textContent; });
    var need = '', kind = '';
    function apply() {
      root.querySelectorAll('[data-q]').forEach(function (el) {
        var q = ' ' + el.getAttribute('data-q') + ' ', k = el.getAttribute('data-kind');
        el.hidden = (!!need && q.indexOf(' ' + need + ' ') < 0) || (!!kind && k !== null && k !== kind);
      });
      root.querySelectorAll('[data-col]').forEach(function (c) { c.classList.toggle('is-need', !!need && c.getAttribute('data-col') === need); });
      if (hint) hint.textContent = hints[need] || hints[''] || '';
    }
    root.querySelectorAll('[data-need]').forEach(function (b) {
      b.addEventListener('click', function () {
        need = b.getAttribute('data-need');
        root.querySelectorAll('[data-need]').forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        apply();
      });
    });
    root.querySelectorAll('[data-kind]').forEach(function (b) {
      if (b.tagName !== 'BUTTON') return;
      b.addEventListener('click', function () {
        kind = b.getAttribute('data-kind');
        root.querySelectorAll('button[data-kind]').forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        apply();
      });
    });
    root.querySelectorAll('[data-sy-view]').forEach(function (b) {
      b.addEventListener('click', function () {
        var v = b.getAttribute('data-sy-view');
        root.querySelectorAll('[data-sy-view]').forEach(function (x) { var on = x === b; x.classList.toggle('is-on', on); x.setAttribute('aria-pressed', on ? 'true' : 'false'); });
        root.querySelectorAll('[data-sy-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-sy-panel') !== v; });
      });
    });
  })();
</script>

