<section data-dc-tpl="790" style="padding: 0px clamp(18px, 5vw, 80px) clamp(56px, 8vw, 140px); max-width: 1560px; margin: 0px auto;">
<div style="border-top: 1px solid rgb(221, 214, 201); padding-top: clamp(28px, 3.4vw, 44px); display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: clamp(24px, 4vw, 56px);">
<div>
<div style="font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div>
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(22px, 2.8vw, 38px); line-height: 1.24; letter-spacing: -0.02em; font-weight: 200; margin-top: 14px; max-width: 26ch;">{{ section.settings.t2 }}</p>
</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 24px;">
<a data-ms-enquire="" href="/pages/contact" style="display: inline-block; background: rgb(23, 20, 15); color: rgb(251, 249, 245); border: 0px; padding: 21px 44px; font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; cursor: pointer;">{{ section.settings.t3 }}</a>
<a data-ms="cta" data-ms-enquire="" href="/pages/contact" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgb(23, 20, 15); padding-bottom: 7px;">{{ section.settings.t4 }}</a>
</div>
</div>
</section>
{% schema %}
{
  "name": "Product · Price",
  "settings": [
    {
      "type": "text",
      "id": "t1",
      "label": "Price",
      "default": "Price"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "On request. The specification sets…",
      "default": "On request. The specification sets it."
    },
    {
      "type": "text",
      "id": "t3",
      "label": "Request a proposal",
      "default": "Request a proposal"
    },
    {
      "type": "text",
      "id": "t4",
      "label": "Book a private appointment",
      "default": "Book a private appointment"
    }
  ]
}
{% endschema %}
