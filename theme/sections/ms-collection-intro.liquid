{%- liquid
  case collection.handle
    when 'essentials'
      assign desc = 'The entry point into the Midsummer world. Natural fibres, authentic artisan construction, clean lines. Simplicity that gives up nothing: baby alpaca in the Raffaello, coloured linen in the Amalfi. The quality that defines us, in every detail.'
      assign count = 'Five'
    when 'signature'
      assign desc = 'The heart of the collection. Loro Piana Interiors fabrics, exclusive blends of precious natural fibres: Yak, camel hair, silk, cashmere over spring architectures designed for the highest comfort. Sleep systems that can be specified like any architectural element, for demanding projects.'
      assign count = 'Seven'
    when 'icons'
      assign desc = 'The most important pieces we make. Vicuña, cashmere, fully upholstered in Loro Piana Interiors. Completely bespoke, with no equivalent on the market. For projects where no detail is overlooked.'
      assign count = 'Twelve'
    else
      assign desc = ''
      assign count = collection.products_count
  endcase
  assign own = collection.description | strip_html | strip
  if own != blank
    assign desc = own
  endif
-%}
<section style="padding: clamp(48px, 7vw, 120px) clamp(18px, 5vw, 80px) clamp(36px, 5vw, 72px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(28px, 6vw, 110px);">
<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 2.3vw, 27px); line-height: 1.55; font-style: italic; color: rgb(74, 68, 59);">{{ desc }}</p>
<div style="display: flex; flex-wrap: wrap; gap: clamp(24px, 4vw, 56px); align-content: flex-start; padding-top: 6px;">
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t1 }}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{{ count }}</div></div>
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t2 }}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{{ section.settings.t3 }}</div></div>
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t4 }}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{{ section.settings.t5 }}</div></div>
</div>
</div>
</section>
{% schema %}
{
  "name": "Collection · Introduction",
  "settings": [
    { "type": "paragraph", "content": "The introduction is the collection's description in admin. Essentials, Signature and Icons fall back to the preview's words." },
    { "type": "text", "id": "t1", "label": "First label", "default": "Systems" },
    { "type": "text", "id": "t2", "label": "Second label", "default": "Lead time" },
    { "type": "text", "id": "t3", "label": "Second value", "default": "On request" },
    { "type": "text", "id": "t4", "label": "Third label", "default": "Made" },
    { "type": "text", "id": "t5", "label": "Third value", "default": "By hand, in Milan" }
  ]
}
{% endschema %}
