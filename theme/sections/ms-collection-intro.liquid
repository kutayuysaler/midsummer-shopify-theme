{%- liquid
  case collection.handle
    when 'essentials'
      capture desc
        render 'ms-t', v: 'The entry point into the Midsummer world. Natural fibres, authentic artisan construction, clean lines. Simplicity that gives up nothing: baby alpaca in the Raffaello, coloured linen in the Amalfi. The quality that defines us, in every detail.'
      endcapture
      capture count
        render 'ms-t', v: 'Five'
      endcapture
    when 'signature'
      capture desc
        render 'ms-t', v: 'The heart of the collection. Exclusive blends of precious natural fibres: yak, camel hair, silk, cashmere, in natural linen and cotton or in Loro Piana Interiors, designed for the highest comfort. Sleep systems that can be specified like any architectural element, for demanding projects.'
      endcapture
      capture count
        render 'ms-t', v: 'Seven'
      endcapture
    when 'icons', 'icon'
      capture desc
        render 'ms-t', v: 'The most important pieces we make. Vicuña, cashmere, most of them made in Loro Piana Interiors. Completely bespoke, with no equivalent on the market. For projects where no detail is overlooked.'
      endcapture
      capture count
        render 'ms-t', v: 'Twelve'
      endcapture
    else
      assign desc = ''
      assign count = collection.products_count
  endcase
  capture ms_count_label
    render 'ms-t', v: section.settings.t1
  endcapture
  case collection.handle
    when 'essentials', 'signature', 'icons', 'icon', 'designer-beds', 'letti-di-design', 'dizajnerskie-krovati'
      capture ms_count_label
        render 'ms-t', v: section.settings.t1
      endcapture
    when 'beds-with-headboards', 'letti-con-testiera', 'krovati-s-izgolovem'
      capture ms_count_label
        render 'ms-t', v: 'Beds'
      endcapture
    when 'mattresses'
      capture ms_count_label
        render 'ms-t', v: 'Mattresses'
      endcapture
    when 'mattress-toppers'
      capture ms_count_label
        render 'ms-t', v: 'Toppers'
      endcapture
    else
      if collection.handle contains 'outdoor'
        capture ms_count_label
          render 'ms-t', v: 'Pieces'
        endcapture
      elsif collection.handle != 'all'
        capture ms_count_label
          render 'ms-t', v: 'Pieces'
        endcapture
      endif
  endcase
  assign own = collection.description | strip_html | strip
  if own != blank
    assign desc = own
  endif
-%}
<section style="padding: clamp(48px, 7vw, 120px) clamp(18px, 5vw, 80px) clamp(36px, 5vw, 72px); max-width: 1560px; margin: 0px auto;">
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: clamp(28px, 6vw, 110px);">
{%- if desc != blank -%}<p style="font-family: Newsreader, Georgia, serif; font-size: clamp(19px, 2.3vw, 27px); line-height: 1.55; font-style: italic; color: rgb(74, 68, 59);">{{ desc }}</p>{%- endif -%}
<div style="display: flex; flex-wrap: wrap; gap: clamp(24px, 4vw, 56px); align-content: flex-start; padding-top: 6px;">
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ ms_count_label }}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{{ count }}</div></div>
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{% render 'ms-t', v: section.settings.t2 %}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{% render 'ms-t', v: section.settings.t3 %}</div></div>
<div><div style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{% render 'ms-t', v: section.settings.t4 %}</div><div style="font-family: Newsreader, Georgia, serif; font-size: 26px; margin-top: 8px;">{% render 'ms-t', v: section.settings.t5 %}</div></div>
</div>
</div>
</section>
{% schema %}
{
  "name": "Collection · Introduction",
  "settings": [
    { "type": "paragraph", "content": "The introduction is the collection's description in admin. Essentials, Signature and Icons fall back to the preview's words." },
    { "type": "text", "id": "t1", "label": "First label", "default": "Systems" },
    { "type": "text", "id": "t2", "label": "Second label", "default": "Lead time" },
    { "type": "text", "id": "t3", "label": "Second value", "default": "On request" },
    { "type": "text", "id": "t4", "label": "Third label", "default": "Made" },
    { "type": "text", "id": "t5", "label": "Third value", "default": "By hand, in Italy" }
  ]
}
{% endschema %}
