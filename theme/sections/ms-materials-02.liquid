<script>
(function () {
  var sec = document.currentScript.parentElement;
  var chips = sec.querySelectorAll('[data-ms-benefit]');
  var cards = sec.querySelectorAll('[data-ms-tags]');
  function pick(b) {
    chips.forEach(function (c) {
      var on = c.getAttribute('data-ms-benefit') === b;
      c.style.background = on ? '#17140F' : 'transparent'; c.style.color = on ? '#FBF9F5' : '#4A443B'; c.style.borderColor = on ? '#17140F' : '#DDD6C9';
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    cards.forEach(function (d) { d.style.display = (b === 'All' || d.getAttribute('data-ms-tags').indexOf(b) >= 0) ? '' : 'none'; });
  }
  chips.forEach(function (c) { c.addEventListener('click', function () { pick(c.getAttribute('data-ms-benefit')); }); });
})();
</script></div>
