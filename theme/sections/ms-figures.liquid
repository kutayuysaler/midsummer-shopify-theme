{%- comment -%}
  Midsummer Milano — quiet numeric strip.
  Hard facts stated once, without adjectives. One "figure" block each.
{%- endcomment -%}

{%- liquid
  assign items = section.blocks | where: 'type', 'figure'
-%}

{%- if items.size > 0 -%}
  <div class="ms-figures" id="ms-figures-{{ section.id }}">
    {%- if section.settings.heading != blank -%}
      <p class="ms-figures__heading">{{ section.settings.heading }}</p>
    {%- endif -%}
    <dl class="ms-figures__list">
      {%- for item in items -%}
        <div class="ms-figures__item" {{ item.shopify_attributes }}>
          <dt class="ms-figures__value">
            {%- if item.settings.prefix != blank -%}<span class="ms-figures__affix">{{ item.settings.prefix }}</span>{%- endif -%}
            {{ item.settings.value }}
            {%- if item.settings.suffix != blank -%}<span class="ms-figures__affix">{{ item.settings.suffix }}</span>{%- endif -%}
          </dt>
          <dd class="ms-figures__label">{{ item.settings.label }}</dd>
          {%- if item.settings.note != blank -%}
            <dd class="ms-figures__note">{{ item.settings.note }}</dd>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </dl>
  </div>
{%- endif -%}

{% stylesheet %}
  .ms-figures { max-width: var(--ms-fig-max); margin-inline: auto; padding-inline: clamp(18px, 5vw, 80px); }
  .ms-figures__heading {
    margin: 0 0 clamp(28px, 4vw, 52px);
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--ms-fig-muted);
  }
  .ms-figures__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(var(--ms-fig-min), 1fr));
    gap: clamp(28px, 4vw, 64px);
    margin: 0;
  }
  .ms-figures__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    border-top: 1px solid var(--ms-fig-rule);
    padding-top: clamp(18px, 2.2vw, 26px);
  }
  .ms-figures__value {
    display: flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-heading-family);
    font-weight: 200;
    font-size: var(--ms-fig-size);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--ms-fig-ink);
  }
  .ms-figures__affix {
    font-size: 0.42em;
    letter-spacing: -0.01em;
    color: var(--ms-fig-accent);
  }
  .ms-figures__label {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ms-fig-ink);
    max-width: 24ch;
  }
  .ms-figures__note {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--ms-fig-muted);
    max-width: 30ch;
  }
  @media screen and (max-width: 700px) {
    .ms-figures__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 22px; }
    .ms-figures__value { font-size: clamp(32px, 11vw, 48px); }
    .ms-figures__label { font-size: 13px; }
    .ms-figures__note { display: none; }
  }
{% endstylesheet %}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding-block-start }}px;
    padding-bottom: {{ section.settings.padding-block-end }}px;
  }
  #ms-figures-{{ section.id }} {
    --ms-fig-ink: {{ section.settings.text_color }};
    --ms-fig-muted: {{ section.settings.muted_color }};
    --ms-fig-accent: {{ section.settings.accent_color }};
    --ms-fig-rule: {{ section.settings.rule_color }};
    --ms-fig-max: {{ section.settings.max_width }}px;
    --ms-fig-min: {{ section.settings.column_min }}px;
    --ms-fig-size: {{ section.settings.figure_size }};
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Figures",
  "tag": "section",
  "class": "section-wrapper",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to hide." },
    { "type": "range", "id": "max_width", "label": "Maximum width", "min": 960, "max": 1800, "step": 20, "unit": "px", "default": 1560 },
    { "type": "range", "id": "column_min", "label": "Minimum column width", "min": 160, "max": 360, "step": 10, "unit": "px", "default": 210 },
    {
      "type": "select",
      "id": "figure_size",
      "label": "Figure size",
      "options": [
        { "value": "clamp(34px, 4vw, 54px)", "label": "Small" },
        { "value": "clamp(42px, 5.4vw, 76px)", "label": "Medium" },
        { "value": "clamp(52px, 7vw, 104px)", "label": "Large" }
      ],
      "default": "clamp(42px, 5.4vw, 76px)"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#17140F" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6E675C" },
    { "type": "color", "id": "accent_color", "label": "Prefix and suffix", "default": "#7E623B" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#DDD6C9" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "figure",
      "name": "Figure",
      "settings": [
        { "type": "text", "id": "prefix", "label": "Prefix", "info": "Shown small, before the figure." },
        { "type": "text", "id": "value", "label": "Figure", "default": "120" },
        { "type": "text", "id": "suffix", "label": "Suffix", "info": "Shown small, after the figure." },
        { "type": "text", "id": "label", "label": "Label", "default": "Hours of handwork in a single system" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Figures",
      "blocks": [
        { "type": "figure" },
        { "type": "figure" },
        { "type": "figure" },
        { "type": "figure" }
      ]
    }
  ]
}
{% endschema %}
