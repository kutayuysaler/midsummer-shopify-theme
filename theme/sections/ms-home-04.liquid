<section data-dc-tpl="241" style="background: rgb(23, 20, 15); color: rgb(251, 249, 245); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); align-items: center;">
<img width="1200" height="1500" alt="The Paisley bed in Loro Piana Interiors Shadan silk and linen" src="{% if section.settings.img1 != blank %}{{ section.settings.img1 | image_url: width: 2000 }}{% else %}{{ 'ms-photo-atelier-pure.jpg' | asset_url }}{% endif %}" style="display: block; width: 100%; aspect-ratio: 4 / 5; max-height: min(92vh, 860px); object-fit: cover;"/>
<div style="display: flex; flex-direction: column; gap: 24px; padding: clamp(44px, 6vw, 110px) clamp(22px, 5vw, 96px); max-width: 680px;">
<div style="font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; opacity: 0.8;">{{ section.settings.t1 }}</div>
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(30px, 4.6vw, 64px); line-height: 1.04; letter-spacing: -0.025em;">{{ section.settings.t2 }}</h2>
<p style="font-size: 15px; line-height: 1.9; opacity: 0.9; max-width: 46ch;">{{ section.settings.t3 }}</p>
<a data-ms="cta" href="{{ all_products['paisley'].url | default: routes.collections_url }}" style="color: rgb(251, 249, 245); font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; border-bottom: 1px solid rgba(251, 249, 245, 0.5); padding-bottom: 8px; width: fit-content;">{{ section.settings.t4 }}</a>
</div>
</section>
{% schema %}
{
  "name": "Home 04 · Icons · Paisley",
  "settings": [
    {
      "type": "image_picker",
      "id": "img1",
      "label": "Image: The Paisley bed in Loro Pian"
    },
    {
      "type": "text",
      "id": "t1",
      "label": "Icons · Paisley",
      "default": "Icons · Paisley"
    },
    {
      "type": "text",
      "id": "t2",
      "label": "An extraordinary fabric, met by a …",
      "default": "An extraordinary fabric, met by a precise design vision."
    },
    {
      "type": "textarea",
      "id": "t3",
      "label": "Loro Piana Interiors Shadan in sil…",
      "default": "Loro Piana Interiors Shadan in silk and linen, over a micro spring layer of baby alpaca, wool and linen. Warm in winter, breathable in summer."
    },
    {
      "type": "text",
      "id": "t4",
      "label": "See the system",
      "default": "See the system"
    }
  ]
}
{% endschema %}
