{%- comment -%}
  Midsummer Milano — Find Your Midsummer.
  Questions are "question" blocks; the recommendation matrix is "result" blocks,
  matched on the feel value + the ambition value. All copy is editable here.
{%- endcomment -%}

{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
  assign results = section.blocks | where: 'type', 'result'
-%}

<div class="ms-quiz" id="ms-quiz-{{ section.id }}" data-ms-quiz>
  <div class="ms-quiz__panel">
    <div class="ms-quiz__inner">

      <div class="ms-quiz__ask" data-ms-ask>
        <div class="ms-quiz__meta">
          <span class="ms-quiz__eyebrow">{{ section.settings.eyebrow }}</span>
          <span class="ms-quiz__step" data-ms-step></span>
        </div>
        <h2 class="ms-quiz__question" data-ms-question></h2>
        <div class="ms-quiz__options" data-ms-options></div>
        <div class="ms-quiz__nav">
          <button type="button" data-ms-back>&larr; Back</button>
          <button type="button" data-ms-reset>Start again</button>
        </div>
      </div>

      <div class="ms-quiz__result" data-ms-result hidden>
        <span class="ms-quiz__eyebrow">{{ section.settings.result_eyebrow }}</span>
        <h2 class="ms-quiz__name" data-ms-name></h2>
        <p class="ms-quiz__tagline" data-ms-tagline></p>
        <p class="ms-quiz__why" data-ms-why></p>
        <dl class="ms-quiz__spec">
          <div>
            <dt>{{ section.settings.label_comfort }}</dt>
            <dd data-ms-comfort></dd>
          </div>
          <div>
            <dt>{{ section.settings.label_size }}</dt>
            <dd data-ms-size></dd>
          </div>
          <div>
            <dt>{{ section.settings.label_fibres }}</dt>
            <dd data-ms-fibres></dd>
          </div>
        </dl>
        <div class="ms-quiz__actions">
          <a class="ms-quiz__cta" href="{{ section.settings.primary_url | default: '/pages/contact' }}">{{ section.settings.primary_label }}</a>
          <a class="ms-quiz__link" href="#" data-ms-system>{{ section.settings.secondary_label }}</a>
          <button type="button" data-ms-reset>Start again</button>
        </div>
      </div>

    </div>
  </div>

  <div class="ms-quiz__media">
    {%- if section.settings.result_image != blank -%}
      <img data-ms-result-image
        src="{{ section.settings.result_image | image_url: width: 1600 }}"
        alt=""
        width="{{ section.settings.result_image.width }}"
        height="{{ section.settings.result_image.height }}"
        hidden>
    {%- endif -%}
    {%- assign first_image = questions.first.settings.image -%}
    {%- if first_image != blank -%}
      <img data-ms-image
        src="{{ first_image | image_url: width: 1600 }}"
        alt=""
        width="{{ first_image.width }}"
        height="{{ first_image.height }}"
        loading="lazy">
    {%- else -%}
      <img data-ms-image alt="" width="1600" height="2000" loading="lazy" hidden>
    {%- endif -%}
  </div>
</div>

<script type="application/json" data-ms-quiz-data>
{
  "questions": [
    {%- for block in questions -%}
      {
        "role": {{ block.settings.role | json }},
        "question": {{ block.settings.question | json }},
        "image": {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 | json }}{% else %}null{% endif %},
        "options": [
          {%- comment -%} Blank options are skipped, so the separator is tracked rather than read from forloop.last. {%- endcomment -%}
          {%- assign sep = '' -%}
          {%- for i in (1..4) -%}
            {%- assign lk = 'opt' | append: i | append: '_label' -%}
            {%- assign hk = 'opt' | append: i | append: '_hint' -%}
            {%- assign vk = 'opt' | append: i | append: '_value' -%}
            {%- assign pk = 'opt' | append: i | append: '_phrase' -%}
            {%- assign label = block.settings[lk] -%}
            {%- if label != blank -%}
              {{- sep -}}
              {
                "label": {{ label | json }},
                "hint": {{ block.settings[hk] | json }},
                "value": {{ block.settings[vk] | default: label | json }},
                "phrase": {{ block.settings[pk] | default: label | json }}
              }
              {%- assign sep = ',' -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "results": [
    {%- for block in results -%}
      {
        "feel": {{ block.settings.feel | json }},
        "ambition": {{ block.settings.ambition | json }},
        "name": {{ block.settings.name | json }},
        "collection": {{ block.settings.collection | json }},
        "tagline": {{ block.settings.tagline | json }},
        "url": {{ block.settings.link | default: '' | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ],
  "fibres": {
    "warm": {{ section.settings.fibre_warm | json }},
    "temperate": {{ section.settings.fibre_temperate | json }},
    "cold": {{ section.settings.fibre_cold | json }}
  },
  "whyTemplate": {{ section.settings.why_template | json }}
}
</script>

<script>
  (function () {
    var roots = document.querySelectorAll('[data-ms-quiz]');
    Array.prototype.forEach.call(roots, function (root) {
      if (root.dataset.msReady) return;
      root.dataset.msReady = '1';

      var holder = root.parentNode.querySelector('[data-ms-quiz-data]')
        || root.closest('.shopify-section').querySelector('[data-ms-quiz-data]');
      if (!holder) return;

      var data;
      try { data = JSON.parse(holder.textContent); } catch (e) { return; }
      var qs = (data.questions || []).filter(function (q) { return q.options && q.options.length; });
      if (!qs.length) return;

      var ask = root.querySelector('[data-ms-ask]');
      var panel = root.querySelector('[data-ms-result]');
      var stepEl = root.querySelector('[data-ms-step]');
      var questionEl = root.querySelector('[data-ms-question]');
      var optionsEl = root.querySelector('[data-ms-options]');
      var imageEl = root.querySelector('[data-ms-image]');
      var resultImage = root.querySelector('[data-ms-result-image]');
      var backBtn = root.querySelector('[data-ms-back]');
      var resetBtns = root.querySelectorAll('[data-ms-reset]');

      var answers = [];
      var index = 0;

      function pick(role) {
        for (var i = 0; i < qs.length; i++) {
          if (qs[i].role === role && answers[i]) return answers[i];
        }
        return null;
      }

      function findResult(feel, ambition) {
        var list = data.results || [];
        var i;
        for (i = 0; i < list.length; i++) {
          if (list[i].feel === feel && list[i].ambition === ambition) return list[i];
        }
        for (i = 0; i < list.length; i++) {
          if (list[i].ambition === ambition) return list[i];
        }
        return list[0] || null;
      }

      function render() {
        if (index >= qs.length) return renderResult();

        ask.hidden = false;
        panel.hidden = true;
        if (resultImage) resultImage.hidden = true;
        if (imageEl) imageEl.hidden = false;

        var q = qs[index];
        stepEl.textContent = (index + 1) + ' / ' + qs.length;
        questionEl.textContent = q.question || '';
        if (imageEl && q.image) { imageEl.src = q.image; imageEl.hidden = false; }

        optionsEl.innerHTML = '';
        q.options.forEach(function (opt) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'ms-quiz__option';
          var label = document.createElement('span');
          label.className = 'ms-quiz__option-label';
          label.textContent = opt.label;
          btn.appendChild(label);
          if (opt.hint) {
            var hint = document.createElement('span');
            hint.className = 'ms-quiz__option-hint';
            hint.textContent = opt.hint;
            btn.appendChild(hint);
          }
          btn.addEventListener('click', function () {
            answers[index] = opt;
            index += 1;
            render();
          });
          optionsEl.appendChild(btn);
        });

        backBtn.hidden = index === 0;
      }

      function renderResult() {
        var feel = pick('feel');
        var climate = pick('climate');
        var ambition = pick('ambition');
        var posture = pick('posture');
        var size = pick('size');

        var r = findResult(feel ? feel.value : '', ambition ? ambition.value : '');
        if (!r) return;

        var comfort = feel && feel.value === 'Soft' ? 'Soft'
          : feel && feel.value === 'Firm' ? 'Firm' : 'Medium';
        var climateKey = climate ? String(climate.value).toLowerCase() : 'temperate';
        var fibres = (data.fibres && data.fibres[climateKey]) || (data.fibres && data.fibres.temperate) || '';

        var why = (data.whyTemplate || '')
          .split('[posture]').join(posture ? posture.phrase : '')
          .split('[feel]').join(feel ? String(feel.label).toLowerCase() : '')
          .split('[name]').join(r.name || '')
          .split('[collection]').join(r.collection || '')
          .split('[comfort]').join(comfort.toLowerCase())
          .split('[size]').join(size ? size.phrase : '');

        root.querySelector('[data-ms-name]').textContent = r.name || '';
        root.querySelector('[data-ms-tagline]').textContent = r.tagline || '';
        root.querySelector('[data-ms-why]').textContent = why;
        root.querySelector('[data-ms-comfort]').textContent = comfort;
        root.querySelector('[data-ms-size]').textContent = size ? size.label : '';
        root.querySelector('[data-ms-fibres]').textContent = fibres;

        var systemLink = root.querySelector('[data-ms-system]');
        if (systemLink) {
          if (r.url) {
            systemLink.href = r.url;
            systemLink.hidden = false;
          } else {
            systemLink.hidden = true;
          }
        }

        ask.hidden = true;
        panel.hidden = false;
        if (resultImage) {
          if (imageEl) imageEl.hidden = true;
          resultImage.hidden = false;
        }

        // ms-tracking turns this into the ms_quiz_complete dataLayer event.
        document.dispatchEvent(new CustomEvent('ms:quiz-complete', {
          detail: {
            product: r.name || '',
            profile: [feel && feel.label, posture && posture.label].filter(Boolean).join(' / ')
          }
        }));
      }

      backBtn.addEventListener('click', function () {
        index = Math.max(0, index - 1);
        render();
      });
      Array.prototype.forEach.call(resetBtns, function (btn) {
        btn.addEventListener('click', function () {
          answers = [];
          index = 0;
          render();
        });
      });

      render();
    });
  })();
</script>

{% stylesheet %}
  .ms-quiz {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 78vh;
  }
  .ms-quiz__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 6vw, 110px) clamp(20px, 5vw, 80px);
  }
  .ms-quiz__inner { max-width: 580px; width: 100%; }
  .ms-quiz__meta {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .ms-quiz__eyebrow,
  .ms-quiz__step {
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }
  .ms-quiz__step { color: var(--ms-accent); }
  .ms-quiz__question {
    margin: 34px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(28px, 4vw, 54px);
    font-weight: 200;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .ms-quiz__options {
    display: flex;
    flex-direction: column;
    margin-top: clamp(28px, 4vw, 48px);
  }
  .ms-quiz__option {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    border-top: 1px solid var(--ms-rule);
    padding: 22px 0;
    cursor: pointer;
    transition: padding-inline-start 0.25s ease;
  }
  .ms-quiz__option:last-child { border-bottom: 1px solid var(--ms-rule); }
  .ms-quiz__option:hover { padding-inline-start: 12px; }
  .ms-quiz__option-label {
    font-family: var(--font-heading-family);
    font-size: clamp(19px, 2vw, 24px);
    line-height: 1.2;
  }
  .ms-quiz__option-hint {
    font-size: 13.5px;
    line-height: 1.8;
    color: var(--ms-muted);
  }
  .ms-quiz__nav,
  .ms-quiz__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 26px;
    margin-top: 34px;
  }
  .ms-quiz__nav button,
  .ms-quiz__actions button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-size: 9.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ms-muted);
  }
  .ms-quiz__name {
    margin: 16px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(38px, 5.4vw, 76px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .ms-quiz__tagline {
    margin: 16px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(18px, 2.1vw, 24px);
    font-style: italic;
    line-height: 1.5;
    color: var(--ms-muted);
  }
  .ms-quiz__why {
    margin: 26px 0 0;
    font-size: 15px;
    line-height: 1.95;
  }
  .ms-quiz__spec {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin: 36px 0 0;
    border-top: 1px solid var(--ms-rule);
    padding-top: 24px;
  }
  .ms-quiz__spec div { max-width: 24ch; }
  .ms-quiz__spec dt {
    font-size: 9.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--ms-muted);
  }
  .ms-quiz__spec dd {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.8;
  }
  .ms-quiz__cta {
    display: inline-block;
    background: var(--ms-ink);
    color: var(--ms-paper);
    padding: 20px 40px;
    font-size: 9.5px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .ms-quiz__link {
    font-size: 9.5px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 7px;
  }
  .ms-quiz__media {
    position: relative;
    overflow: hidden;
    min-height: 360px;
  }
  .ms-quiz__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media screen and (max-width: 749px) {
    .ms-quiz { grid-template-columns: 1fr; }
    .ms-quiz__media { order: -1; min-height: 260px; height: 42vh; }
  }
{% endstylesheet %}

{%- style -%}
  #ms-quiz-{{ section.id }} {
    --ms-rule: {{ section.settings.rule_color }};
    --ms-muted: {{ section.settings.muted_color }};
    --ms-accent: {{ section.settings.accent_color }};
    --ms-ink: {{ section.settings.button_background }};
    --ms-paper: {{ section.settings.button_text }};
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }
  #ms-quiz-{{ section.id }} .ms-quiz__media { background-color: {{ section.settings.media_background }}; }
{%- endstyle -%}

{% schema %}
{
  "name": "Find Your Midsummer",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Five questions" },
    { "type": "header", "content": "Result" },
    { "type": "text", "id": "result_eyebrow", "label": "Result eyebrow", "default": "We would build you the" },
    { "type": "image_picker", "id": "result_image", "label": "Result image" },
    { "type": "textarea", "id": "why_template", "label": "Recommendation sentence", "info": "Tokens: [posture] [feel] [name] [collection] [comfort] [size]", "default": "You sleep [posture], and you want a surface that feels [feel]. We would build the [name] from the [collection] collection at [comfort] comfort, in [size]." },
    { "type": "text", "id": "label_comfort", "label": "Comfort label", "default": "Comfort" },
    { "type": "text", "id": "label_size", "label": "Size label", "default": "Size" },
    { "type": "text", "id": "label_fibres", "label": "Fibres label", "default": "Fibres" },
    { "type": "text", "id": "fibre_warm", "label": "Fibres — warm room", "default": "Linen, organic cotton and silk — breathable, for warm rooms" },
    { "type": "text", "id": "fibre_temperate", "label": "Fibres — temperate room", "default": "Cheviot wool, horsehair and linen — warm in winter, fresh in summer" },
    { "type": "text", "id": "fibre_cold", "label": "Fibres — cold room", "default": "Baby alpaca, yak and Cheviot wool — warmth without weight" },
    { "type": "header", "content": "Actions" },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Request this system" },
    { "type": "url", "id": "primary_url", "label": "Primary link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary link", "default": "See the system" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBF9F5" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4A443B" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#6E675C" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#7E623B" },
    { "type": "color", "id": "rule_color", "label": "Rules", "default": "#DDD6C9" },
    { "type": "color", "id": "media_background", "label": "Media background", "default": "#F1ECE3" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#17140F" },
    { "type": "color", "id": "button_text", "label": "Button text", "default": "#FBF9F5" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "role",
          "label": "Drives",
          "options": [
            { "value": "posture", "label": "Posture (sentence)" },
            { "value": "feel", "label": "Feel (result + comfort)" },
            { "value": "climate", "label": "Climate (fibres)" },
            { "value": "size", "label": "Size (sentence)" },
            { "value": "ambition", "label": "Ambition (result)" }
          ],
          "default": "posture"
        },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "header", "content": "Option 1" },
        { "type": "text", "id": "opt1_label", "label": "Label" },
        { "type": "text", "id": "opt1_hint", "label": "Hint" },
        { "type": "text", "id": "opt1_value", "label": "Logic value", "info": "Feel: Soft / Medium / Firm. Climate: warm / temperate / cold. Ambition: must match a result." },
        { "type": "text", "id": "opt1_phrase", "label": "Sentence phrase" },
        { "type": "header", "content": "Option 2" },
        { "type": "text", "id": "opt2_label", "label": "Label" },
        { "type": "text", "id": "opt2_hint", "label": "Hint" },
        { "type": "text", "id": "opt2_value", "label": "Logic value" },
        { "type": "text", "id": "opt2_phrase", "label": "Sentence phrase" },
        { "type": "header", "content": "Option 3" },
        { "type": "text", "id": "opt3_label", "label": "Label" },
        { "type": "text", "id": "opt3_hint", "label": "Hint" },
        { "type": "text", "id": "opt3_value", "label": "Logic value" },
        { "type": "text", "id": "opt3_phrase", "label": "Sentence phrase" },
        { "type": "header", "content": "Option 4" },
        { "type": "text", "id": "opt4_label", "label": "Label" },
        { "type": "text", "id": "opt4_hint", "label": "Hint" },
        { "type": "text", "id": "opt4_value", "label": "Logic value" },
        { "type": "text", "id": "opt4_phrase", "label": "Sentence phrase" }
      ]
    },
    {
      "type": "result",
      "name": "Result",
      "settings": [
        { "type": "text", "id": "feel", "label": "Feel value", "info": "Soft, Medium or Firm" },
        { "type": "text", "id": "ambition", "label": "Ambition value" },
        { "type": "text", "id": "name", "label": "System name" },
        { "type": "text", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "url", "id": "link", "label": "Link to the system" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Your Midsummer",
      "blocks": [
        { "type": "question" },
        { "type": "result" }
      ]
    }
  ]
}
{% endschema %}
