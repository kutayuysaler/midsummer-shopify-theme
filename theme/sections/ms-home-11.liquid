<section data-dc-tpl="328" style="background: rgb(241, 236, 227); padding: clamp(80px, 12vw, 180px) clamp(18px, 5vw, 80px);">
<div style="max-width: 1560px; margin: 0px auto;">
<div style="display: flex; align-items: baseline; justify-content: space-between; gap: 24px; border-top: 1px solid rgb(221, 214, 201); padding-top: 26px;">
<h2 style="font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.6vw, 50px); line-height: 1.06; letter-spacing: -0.02em;">{{ section.settings.t1 }}</h2>
<a data-ms="cta" href="{% render 'ms-link', to: 'collections' %}" style="font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92);">{{ section.settings.t2 }}</a>
</div>
<table data-ms="comparetable" style="width: 100%; border-collapse: collapse; margin-top: clamp(36px, 5vw, 72px); text-align: left;">
<thead>
<tr>
<th style="width: 22%; padding: 0px 24px 20px 0px; font-size: 11px; letter-spacing: 0.26em; text-transform: uppercase; color: rgb(110, 103, 92); font-weight: 400; vertical-align: bottom;"></th>
<th style="padding: 0px 24px 20px 0px; vertical-align: bottom;"><span style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t3 }}</span><div style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 28px); font-weight: 200; margin-top: 6px;">{{ section.settings.t4 }}</div></th>
<th style="padding: 0px 24px 20px 0px; vertical-align: bottom;"><span style="font-family: Newsreader, Georgia, serif; font-size: 13px; color: rgb(126, 98, 59);">{{ section.settings.t5 }}</span><div style="font-family: Newsreader, Georgia, serif; font-size: clamp(20px, 2.2vw, 28px); font-weight: 200; margin-top: 6px;">{{ section.settings.t6 }}</div></th>
