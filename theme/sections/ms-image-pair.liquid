{%- comment -%} Two photographs side by side, each with an italic caption, as the preview's product plates. {%- endcomment -%}
<section class="ms-ip">
  <div class="ms-ip__in">
    {%- if section.settings.heading != blank -%}
      <div class="ms-ip__head">
        {%- if section.settings.eyebrow != blank -%}<div class="ms-ip__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
        <h2 class="ms-ip__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="ms-ip__grid">
      {%- for i in (1..2) -%}
        {%- liquid
          assign ki = 'image_' | append: i
          assign kf = 'fallback_' | append: i
          assign kc = 'caption_' | append: i
        -%}
        <figure class="ms-ip__fig">
          <img src="{% render 'ms-img', image: section.settings[ki], fallback: section.settings[kf], width: 1600 %}" alt="{{ section.settings[kc] | strip_html | escape }}" loading="lazy" width="1600" height="2000">
          {%- if section.settings[kc] != blank -%}<figcaption>{{ section.settings[kc] }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .ms-ip { padding: clamp(40px, 6vw, 96px) clamp(18px, 5vw, 80px) clamp(64px, 9vw, 140px); }
  .ms-ip__in { max-width: 1560px; margin: 0 auto; }
  .ms-ip__head { border-top: 1px solid #DDD6C9; padding-top: 26px; margin-bottom: clamp(28px, 4vw, 56px); }
  .ms-ip__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-ip__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(26px, 3.2vw, 42px); letter-spacing: -.02em; font-weight: 200; margin-top: 12px; }
  .ms-ip__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: clamp(24px, 4vw, 64px); align-items: start; }
  .ms-ip__fig { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .ms-ip__fig img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; background: #F4EFE5; }
  .ms-ip__fig figcaption { font-family: Newsreader, Georgia, serif; font-size: 15px; font-style: italic; color: #6E675C; }
</style>
{% schema %}
{
  "name": "Two photographs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "image_picker", "id": "image_1", "label": "First photograph" },
    { "type": "text", "id": "fallback_1", "label": "First photograph address" },
    { "type": "text", "id": "caption_1", "label": "First caption" },
    { "type": "image_picker", "id": "image_2", "label": "Second photograph" },
    { "type": "text", "id": "fallback_2", "label": "Second photograph address" },
    { "type": "text", "id": "caption_2", "label": "Second caption" }
  ],
  "presets": [ { "name": "Two photographs" } ]
}
{% endschema %}
