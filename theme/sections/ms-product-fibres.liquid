{%- comment -%}
  What this system is made of: its natural fibres, each with its drawing, and any
  specification particular to it. Filled in per product template.
{%- endcomment -%}
{%- if section.blocks.size > 0 or section.settings.specs != blank -%}
<section class="ms-pf">
  <div class="ms-pf__in">
    <div class="ms-pf__lead">
      <div class="ms-pf__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="ms-pf__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a data-ms="cta" class="ms-pf__link" href="{% render 'ms-link', to: 'materials' %}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="ms-pf__body">
      {%- if section.blocks.size > 0 -%}
      <ul class="ms-pf__list" role="list">
        {%- for block in section.blocks -%}
          <li class="ms-pf__fibre" {{ block.shopify_attributes }}>
            <span class="ms-pf__icon">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M4 20 C4 11 11 4 20 4 C20 13 13 20 4 20 Z" fill="none" stroke="#9A7B4F" stroke-width="1.1"/><path d="M4 20 L16 8" fill="none" stroke="#9A7B4F" stroke-width="1.1"/></svg>
              {%- endif -%}
            </span>
            <span class="ms-pf__name">{{ block.settings.name }}</span>
            {%- if block.settings.note != blank -%}<span class="ms-pf__note">{{ block.settings.note }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
      {%- if section.settings.specs != blank -%}
        <div class="ms-pf__specs">
          <div class="ms-pf__eyebrow">{{ section.settings.specs_label }}</div>
          <div class="ms-pf__spectext">{{ section.settings.specs }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  .ms-pf { background: #F4EFE5; padding: clamp(64px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-pf__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 110px); align-items: start; }
  .ms-pf__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #6E675C; }
  .ms-pf__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(28px, 3.4vw, 48px); line-height: 1.08; letter-spacing: -.025em; font-weight: 200; margin-top: 16px; max-width: 16ch; }
  .ms-site .ms-pf__link { display: inline-block; margin-top: 24px; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 7px; }
  .ms-pf__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; }
  .ms-pf__fibre { flex: 0 1 230px; min-width: 170px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; padding: 26px 24px 28px; border: 1px solid #DDD6C9; margin: 0 -1px -1px 0; }
  /* the drawings arrive on white: multiplied onto the ground, the white falls away and only the ink line stays */
  .ms-pf__icon { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: #F4EFE5; isolation: isolate; }
  .ms-site .ms-pf__icon img { width: 64px; height: 64px; object-fit: contain; mix-blend-mode: multiply; filter: grayscale(1) contrast(1.35) brightness(1.06) !important; opacity: .82; }
  .ms-pf__name { font-family: Newsreader, Georgia, serif; font-size: 21px; line-height: 1.2; margin-top: 6px; }
  .ms-pf__note { font-size: 13px; line-height: 1.7; color: #6E675C; }
  .ms-pf__specs { margin-top: clamp(28px, 3.4vw, 44px); border-top: 1px solid #DDD6C9; padding-top: 22px; }
  .ms-pf__spectext { margin-top: 14px; font-size: 15px; line-height: 1.9; color: #4A443B; columns: 2 220px; column-gap: 40px; }
  .ms-pf__spectext p, .ms-pf__spectext h4, .ms-pf__spectext h5 { margin: 0 0 .4em; font-size: 15px; font-weight: 300; font-family: inherit; break-inside: avoid; }
  .ms-pf__spectext strong { font-weight: 400; color: #17140F; }
  @media (max-width: 900px) { .ms-pf__in { grid-template-columns: minmax(0, 1fr); } }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Product · Fibres",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Natural fibres" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "What this system is made of." },
    { "type": "text", "id": "link_label", "label": "Link to Natural Materials", "default": "All the fibres we use" },
    { "type": "text", "id": "specs_label", "label": "Specification label", "default": "Specification" },
    { "type": "richtext", "id": "specs", "label": "Specification" }
  ],
  "blocks": [
    {
      "type": "fibre",
      "name": "Fibre",
      "settings": [
        { "type": "text", "id": "name", "label": "Fibre", "default": "Cheviot Wool" },
        { "type": "image_picker", "id": "icon", "label": "Drawing" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Product · Fibres" } ]
}
{% endschema %}
