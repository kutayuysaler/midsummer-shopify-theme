{%- comment -%}
  What this system is made of: its natural fibres, each with its drawing, and any
  specification particular to it. Filled in per product template.
{%- endcomment -%}
{%- if section.blocks.size > 0 or section.settings.specs != blank -%}
<section class="ms-pf">
  <div class="ms-pf__in">
    <div class="ms-pf__lead">
      <div class="ms-pf__eyebrow">{{ section.settings.eyebrow }}</div>
      <h2 class="ms-pf__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a data-ms="cta" class="ms-pf__link" href="{% render 'ms-link', to: 'materials' %}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>
    <div class="ms-pf__body">
      {%- if section.blocks.size > 0 -%}
      <ul class="ms-pf__list" role="list">
        {%- for block in section.blocks -%}
          <li class="ms-pf__fibre" {{ block.shopify_attributes }}>
            <span class="ms-pf__icon">
              {%- if block.settings.icon != blank -%}
                <img src="{{ block.settings.icon | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
              {%- else -%}
                <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M4 20 C4 11 11 4 20 4 C20 13 13 20 4 20 Z" fill="none" stroke="#7E623B" stroke-width="1.1"/><path d="M4 20 L16 8" fill="none" stroke="#7E623B" stroke-width="1.1"/></svg>
              {%- endif -%}
            </span>
            <span class="ms-pf__name">{{ block.settings.name }}</span>
            {%- if block.settings.note != blank -%}<span class="ms-pf__note">{{ block.settings.note }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- endif -%}
      {%- if section.settings.specs != blank -%}
        <div class="ms-pf__specs">
          <div class="ms-pf__eyebrow">{{ section.settings.specs_label }}</div>
          <div class="ms-pf__spectext">{{ section.settings.specs }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
<style>
  /* part of the size & fabric band above it: a compact row, not a section of its own */
  .ms-pf { background: #FBF9F5; padding: 0 clamp(18px, 5vw, 80px) clamp(56px, 6vw, 96px); margin-top: calc(-1 * clamp(24px, 3vw, 48px)); }
  .ms-pf__in { max-width: 1560px; margin: 0 auto; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(24px, 4vw, 72px); align-items: center; border-top: 1px solid #DDD6C9; padding-top: clamp(26px, 3vw, 40px); }
  .ms-pf__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-pf__heading { font-family: Newsreader, Georgia, serif; font-size: clamp(21px, 2vw, 27px); line-height: 1.2; letter-spacing: -.015em; font-weight: 200; margin-top: 10px; max-width: 22ch; }
  .ms-site .ms-pf__link { display: inline-block; margin-top: 14px; font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; border-bottom: 1px solid #17140F; padding-bottom: 5px; }
  .ms-pf__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 14px clamp(22px, 3vw, 44px); }
  .ms-pf__fibre { display: grid; grid-template-columns: 52px auto; grid-template-rows: auto auto; column-gap: 14px; align-items: center; }
  .ms-pf__icon { grid-row: span 2; width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; background: #FBF9F5; isolation: isolate; }
  .ms-site .ms-pf__icon img { width: 52px; height: 52px; object-fit: contain; mix-blend-mode: multiply; filter: grayscale(1) contrast(1.35) brightness(1.06) !important; opacity: .82; }
  .ms-pf__name { font-family: Newsreader, Georgia, serif; font-size: 18px; line-height: 1.2; align-self: end; }
  .ms-pf__note { font-size: 12px; line-height: 1.6; color: #6E675C; align-self: start; }
  .ms-pf__specs { grid-column: 2; margin-top: 4px; }
  .ms-pf__spectext { margin-top: 10px; font-size: 14px; line-height: 1.9; color: #4A443B; columns: 3 200px; column-gap: 32px; }
  .ms-pf__spectext p, .ms-pf__spectext h4, .ms-pf__spectext h5 { margin: 0 0 .3em; font-size: 14px; font-weight: 300; font-family: inherit; break-inside: avoid; }
  .ms-pf__spectext strong { font-weight: 400; color: #17140F; }
  @media (max-width: 900px) { .ms-pf__in { grid-template-columns: minmax(0, 1fr); } .ms-pf__specs { grid-column: auto; } }
</style>
{%- endif -%}
{% schema %}
{
  "name": "Product · Fibres",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Natural fibres" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "What this system is made of." },
    { "type": "text", "id": "link_label", "label": "Link to Natural Materials", "default": "All the fibres we use" },
    { "type": "text", "id": "specs_label", "label": "Specification label", "default": "Specification" },
    { "type": "richtext", "id": "specs", "label": "Specification" }
  ],
  "blocks": [
    {
      "type": "fibre",
      "name": "Fibre",
      "settings": [
        { "type": "text", "id": "name", "label": "Fibre", "default": "Cheviot Wool" },
        { "type": "image_picker", "id": "icon", "label": "Drawing" },
        { "type": "text", "id": "note", "label": "Note" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Product · Fibres" } ]
}
{% endschema %}
