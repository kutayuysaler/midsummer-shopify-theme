{%- comment -%}
  The three collections side by side: what each is for, its fibres and cloth, how far it is
  made to measure, and what every Midsummer bed shares. A value of "yes" shows the house mark,
  "-" a quiet dash. Each column links to its collection.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture u1
    render 'ms-link', to: 'essentials'
  endcapture
  capture u2
    render 'ms-link', to: 'signature'
  endcapture
  capture u3
    render 'ms-link', to: 'icons'
  endcapture
-%}
<section class="ms-cmp">
  <div class="ms-cmp__in">
    <header class="ms-cmp__head">
      <div class="ms-cmp__eyebrow">{{ s.eyebrow }}</div>
      {%- if s.h1 -%}<h1 class="ms-cmp__title">{{ s.heading }}</h1>{%- else -%}<h2 class="ms-cmp__title">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="ms-cmp__text">{{ s.text }}</p>{%- endif -%}
    </header>

    <div class="ms-cmp__table" role="table" aria-label="{{ s.heading | strip_html | escape }}">
      <div class="ms-cmp__row ms-cmp__row--cols" role="row">
        <div class="ms-cmp__label" role="columnheader"><span class="ms-visually-hidden">{{ s.eyebrow }}</span></div>
        {%- for i in (1..3) -%}
          {%- liquid
            assign kn = 'col' | append: i | append: '_name'
            assign kl = 'col' | append: i | append: '_line'
            assign ki = 'col' | append: i | append: '_image'
            assign kf = 'col' | append: i | append: '_fallback'
            case i
              when 1
                assign u = u1
                assign num = 'I'
              when 2
                assign u = u2
                assign num = 'II'
              else
                assign u = u3
                assign num = 'III'
            endcase
          -%}
          <a class="ms-cmp__col" href="{{ u }}" role="columnheader">
            <span class="ms-cmp__img"><img src="{% render 'ms-img', image: s[ki], fallback: s[kf], width: 900 %}" alt="{{ s[kn] | escape }}" width="900" height="1125" loading="lazy"></span>
            <span class="ms-cmp__num">{{ num }}</span>
            <span class="ms-cmp__name">{{ s[kn] }}</span>
            <span class="ms-cmp__line">{{ s[kl] }}</span>
          </a>
        {%- endfor -%}
      </div>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="ms-cmp__row{% if b.shared %} is-shared{% endif %}" role="row" {{ block.shopify_attributes }}>
          <div class="ms-cmp__label" role="rowheader">{{ b.label }}</div>
          {%- for i in (1..3) -%}
            {%- assign kv = 'v' | append: i -%}{%- assign kn = 'col' | append: i | append: '_name' -%}
            {%- assign v = b[kv] | strip -%}
            {%- assign vl = v | downcase -%}
            <div class="ms-cmp__cell" role="cell" data-col="{{ i }}">
              <span class="ms-cmp__mlabel" aria-hidden="true">{{ s[kn] }}</span>
              {%- if vl == 'yes' -%}<span class="ms-cmp__yes" aria-label="Yes"></span>{%- elsif v == '-' or v == '' -%}<span class="ms-cmp__no" aria-label="No">—</span>{%- else -%}{{ v }}{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
      <div class="ms-cmp__row ms-cmp__row--go" role="row">
        <div class="ms-cmp__label" role="rowheader"></div>
        <div role="cell"><a class="ms-cmp__go" href="{{ u1 }}">{{ s.go_label }} {{ s.col1_name }}<span aria-hidden="true">→</span></a></div>
        <div role="cell"><a class="ms-cmp__go" href="{{ u2 }}">{{ s.go_label }} {{ s.col2_name }}<span aria-hidden="true">→</span></a></div>
        <div role="cell"><a class="ms-cmp__go" href="{{ u3 }}">{{ s.go_label }} {{ s.col3_name }}<span aria-hidden="true">→</span></a></div>
      </div>
    </div>

    <div class="ms-cmp__help">
      <div>
        <div class="ms-cmp__eyebrow">{{ s.help_eyebrow }}</div>
        <p class="ms-cmp__htitle">{{ s.help_heading }}</p>
      </div>
      <div class="ms-cmp__hlinks">
        <a class="ms-cmp__btn" href="{% render 'ms-link', to: 'quiz' %}">{{ s.quiz_label }}</a>
        <a class="ms-cmp__link" href="{% render 'ms-link', to: 'enquire', q: 'enquiry=appointment' %}#enquire" data-ms-landing>{{ s.book_label }}</a>
      </div>
    </div>

    {%- liquid
      capture ux1
        render 'ms-link', to: 'mattresses', strict: true
      endcapture
      capture ux2
        render 'ms-link', to: 'toppers', strict: true
      endcapture
      capture ux3
        render 'ms-link', to: 'bases', strict: true
      endcapture
      capture ux4
        render 'ms-link', to: 'headboards', strict: true
      endcapture
      capture ux5
        render 'ms-link', to: 'bedding', strict: true
      endcapture
    -%}
    <nav class="ms-cmp__more" aria-label="{{ s.more_label | escape }}">
      <span>{{ s.more_label }}</span>
      {%- if ux1 != blank -%}<a href="{{ ux1 }}">Mattresses</a>{%- endif -%}
      {%- if ux2 != blank -%}<a href="{{ ux2 }}">Toppers</a>{%- endif -%}
      {%- if ux3 != blank -%}<a href="{{ ux3 }}">Bases</a>{%- endif -%}
      {%- if ux4 != blank -%}<a href="{{ ux4 }}">Beds with headboards</a>{%- endif -%}
      {%- if ux5 != blank -%}<a href="{{ ux5 }}">Bedding</a>{%- endif -%}
      <a href="{{ routes.collections_url }}">{{ s.everything_label }}</a>
    </nav>
  </div>
</section>
<style>
  .ms-cmp { background: #FBF9F5; color: #17140F; padding: clamp(64px, 9vw, 140px) clamp(18px, 5vw, 80px); }
  .ms-cmp__in { max-width: 1560px; margin: 0 auto; }
  .ms-cmp__head { max-width: 900px; }
  .ms-cmp__eyebrow { font-size: 11px; letter-spacing: .28em; text-transform: uppercase; color: #7E623B; }
  .ms-cmp__title { font-family: Newsreader, Georgia, serif; font-weight: 200; font-size: clamp(40px, 5.6vw, 84px); line-height: 1; letter-spacing: -0.035em; margin-top: 20px; }
  .ms-site .ms-cmp__text { font-size: 16px; line-height: 1.9; color: #4A443B; margin-top: 24px; max-width: 58ch; }
  .ms-cmp__table { margin-top: clamp(48px, 6vw, 96px); }
  .ms-cmp__row { display: grid; grid-template-columns: minmax(150px, 2fr) repeat(3, minmax(0, 3fr)); gap: clamp(14px, 2.4vw, 40px); padding: clamp(16px, 1.8vw, 24px) 0; border-bottom: 1px solid #DDD6C9; align-items: baseline; position: relative; }
  .ms-cmp__row:not(.ms-cmp__row--cols):not(.ms-cmp__row--go)::before { content: ''; position: absolute; inset: 0 calc(-1 * clamp(10px, 1.2vw, 20px)); background: rgba(126, 98, 59, .06); opacity: 0; transition: opacity .35s ease; pointer-events: none; }
  .ms-cmp__row:hover::before { opacity: 1; }
  .ms-cmp__row > * { position: relative; }
  .ms-cmp__row--cols { align-items: end; border-bottom-color: #17140F; padding-bottom: 26px; }
  .ms-site .ms-cmp__col { display: block; color: inherit; }
  .ms-cmp__img { display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #EFE9DE; }
  .ms-cmp__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
  .ms-cmp__col:hover .ms-cmp__img img { transform: scale(1.04); }
  .ms-cmp__num { display: block; font-family: Newsreader, Georgia, serif; color: #7E623B; font-size: 15px; margin-top: 18px; }
  .ms-cmp__name { display: block; font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(26px, 2.6vw, 38px); letter-spacing: -0.02em; margin-top: 4px; }
  .ms-cmp__line { display: block; font-size: 13.5px; line-height: 1.7; color: #4A443B; margin-top: 8px; max-width: 34ch; }
  .ms-cmp__label { font-size: 10.5px; letter-spacing: .24em; text-transform: uppercase; color: #6E675C; }
  .ms-cmp__cell { font-size: 15px; line-height: 1.7; color: #2F2B25; }
  .ms-cmp__row.is-shared .ms-cmp__cell { color: #4A443B; }
  .ms-cmp__yes { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: #7E623B; vertical-align: middle; }
  .ms-cmp__no { color: #A8A094; }
  .ms-cmp__mlabel { display: none; }
  .ms-cmp__row--go { border-bottom: 0; padding-top: 26px; }
  .ms-site a.ms-cmp__go { display: inline-flex; gap: 10px; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-cmp__help { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px 48px; margin-top: clamp(56px, 7vw, 110px); padding: clamp(28px, 3.4vw, 48px); background: #F3EEE5; }
  .ms-cmp__htitle { font-family: Newsreader, Georgia, serif; font-weight: 300; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.2; margin-top: 10px; max-width: 30ch; }
  .ms-cmp__hlinks { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .ms-site a.ms-cmp__btn { display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #17140F; color: #FBF9F5; font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-site a.ms-cmp__link { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: #17140F; border-bottom: 1px solid currentColor; padding-bottom: 6px; }
  .ms-cmp__more { display: flex; flex-wrap: wrap; gap: 10px 28px; align-items: center; margin-top: clamp(36px, 4vw, 56px); font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; }
  .ms-cmp__more span { color: #7E623B; }
  .ms-site .ms-cmp__more a { color: #4A443B; padding: 8px 0; }
  .ms-site .ms-cmp__more a:hover { color: #17140F; }
  @media (max-width: 860px) {
    .ms-cmp__row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px 14px; }
    .ms-cmp__label { grid-column: 1 / -1; }
    .ms-cmp__row--cols .ms-cmp__label, .ms-cmp__row--go .ms-cmp__label { display: none; }
    .ms-cmp__name { font-size: 20px; }
    .ms-cmp__line { display: none; }
    .ms-cmp__cell { font-size: 13.5px; }
    .ms-site a.ms-cmp__go { font-size: 9.5px; letter-spacing: .14em; }
  }
</style>

{% schema %}
{
  "name": "Compare the collections",
  "settings": [
    { "type": "checkbox", "id": "h1", "label": "Heading is the page title", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Our beds, compared" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three collections. One way of making." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Every Midsummer bed is made by hand in Italy, by the same two artisans, from natural fibres only. What changes from one collection to the next is the cloth, the rarity of the fibres and how far the bespoke goes." },
    { "type": "text", "id": "col1_name", "label": "Collection I", "default": "Essentials" },
    { "type": "text", "id": "col1_line", "label": "Collection I line", "default": "The entry into the house: natural fibres, honest construction, clean lines." },
    { "type": "image_picker", "id": "col1_image", "label": "Collection I photograph" },
    { "type": "text", "id": "col1_fallback", "label": "Collection I photograph address", "default": "ms-graded-bougainvillea.jpg" },
    { "type": "text", "id": "col2_name", "label": "Collection II", "default": "Signature" },
    { "type": "text", "id": "col2_line", "label": "Collection II line", "default": "Loro Piana Interiors over precious blends of natural fibres." },
    { "type": "image_picker", "id": "col2_image", "label": "Collection II photograph" },
    { "type": "text", "id": "col2_fallback", "label": "Collection II photograph address", "default": "ms-graded-ochre-room.jpg" },
    { "type": "text", "id": "col3_name", "label": "Collection III", "default": "Icons" },
    { "type": "text", "id": "col3_line", "label": "Collection III line", "default": "The most important pieces we make, entirely bespoke." },
    { "type": "image_picker", "id": "col3_image", "label": "Collection III photograph" },
    { "type": "text", "id": "col3_fallback", "label": "Collection III photograph address", "default": "ms-graded-arches.jpg" },
    { "type": "text", "id": "go_label", "label": "Column link", "default": "See" },
    { "type": "text", "id": "help_eyebrow", "label": "Help label", "default": "Not sure yet?" },
    { "type": "text", "id": "help_heading", "label": "Help heading", "default": "Five questions, and the system the atelier would build for you." },
    { "type": "text", "id": "quiz_label", "label": "Quiz button", "default": "Find your Midsummer" },
    { "type": "text", "id": "book_label", "label": "Appointment link", "default": "Or lie on all three in Milan" },
    { "type": "text", "id": "more_label", "label": "More label", "default": "Also" },
    { "type": "text", "id": "everything_label", "label": "Everything link", "default": "Everything we make" }
  ],
  "blocks": [
    { "type": "row", "name": "Row", "settings": [
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "text", "id": "v1", "label": "Collection I", "info": "yes shows a mark, - a dash" },
      { "type": "text", "id": "v2", "label": "Collection II" },
      { "type": "text", "id": "v3", "label": "Collection III" },
      { "type": "checkbox", "id": "shared", "label": "Shared by all", "default": false }
    ] }
  ],
  "presets": [{ "name": "Compare the collections" }]
}
{% endschema %}
